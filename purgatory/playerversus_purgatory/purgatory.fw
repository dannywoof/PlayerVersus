function rig() returns puppet.Rig
    var have = rig_ref
    if have != null do
        return have as puppet.Rig
    end
    return puppet.make_rig()
end

function say(string words, ap.Color color = ap.WHITE, int length = 180)
    hint = words
    hint_ticks = length
    hint_color = color
end

function forward_of(double heading) returns ap.Vec3
    var a = heading * math.PI / 180
    return ap.Vec3(math.sin(a), 0, math.cos(a))
end
function heading_of(ap.Vec3 v) returns double
    return math.atan2(v.x, v.z) * 180 / math.PI
end
function wrap(double angle) returns double
    var a = angle
    while a > 180 do
        a -= 360
    end
    while a < -180 do
        a += 360
    end
    return a
end
function flat(ap.Vec3 v) returns ap.Vec3
    return ap.Vec3(v.x, 0, v.z)
end
function flat_distance(ap.Vec3 a, ap.Vec3 b) returns double
    return flat(a - b).length()
end
function unit(ap.Vec3 v) returns ap.Vec3
    var l = v.length()
    return v * (1 / l) if l > 0.0001 else ap.Vec3(0, 0, 1)
end
function chest_of(Actor a) returns ap.Vec3
    return a.body.position + ap.Vec3(0, 1.1 * a.look.tall + a.lift, 0)
end

# --- Looks -------------------------------------------------------------------------------------

function scarf_look() returns roster.Look
    var l = roster.Look()
    l.skin = ap.Color(206, 172, 150)
    l.body = ap.Color(44, 46, 58)
    l.legs = ap.Color(30, 30, 38)
    l.trim = ap.Color(160, 34, 44)
    l.accent = ap.Color(240, 70, 80)
    l.metal = ap.Color(150, 150, 160)
    l.eyes = ap.Color(30, 24, 28)
    l.head = roster.HEAD_SCARF
    l.weapon = roster.WEAPON_HANDS
    l.stance = roster.STANCE_GUARD
    l.bulk = 0.94
    return l
end

# The dead of each level wear its owner's colors (and in the nursery, they are dolls).
function enemy_look(int kind, Level level) returns roster.Look
    var l = base_enemy_look(kind, level)
    if level.index < 0 or level.index >= cast.length or kind == A_DECOY do
        return l
    end
    var kit = cast[level.index]
    var own = kit.look
    var h = level.index * 7 + kind * 3
    if kind == A_ZOMBIE or kind == A_GHOUL do
        l.body = own.body.lerp(ap.Color(60, 54, 50), 0.45)
        l.legs = own.legs.lerp(ap.Color(40, 38, 44), 0.4)
        l.trim = own.trim.lerp(ap.Color(80, 60, 50), 0.3)
        l.skin = l.skin.lerp(level.glow, 0.15)
        l.eyes = level.glow.lerp(ap.WHITE, 0.2)
        # Some levels' dead keep their headgear.
        if h % 3 == 0 and not puppet.faceless(own.head) do
            l.head = own.head
        end
    else if kind == A_WRAITH do
        l.cape_color = own.body.lerp(ap.Color(20, 18, 28), 0.7)
        l.body = l.cape_color
        l.accent = own.accent
        l.eyes = own.accent.lerp(ap.WHITE, 0.3)
    else do
        l.trim = own.trim.lerp(ap.Color(90, 70, 50), 0.4)
        l.metal = own.metal.lerp(l.metal, 0.4)
        l.eyes = own.accent.lerp(ap.Color(120, 200, 255), 0.3)
        l.skin = l.skin.lerp(level.floor_color, 0.15)
        l.body = l.skin
        if h % 2 == 0 do
            l.legs = own.legs.lerp(l.legs, 0.4)
        end
    end
    if level.style == STYLE_TOY do
        # Stuffed toys with button eyes.
        l.skin = [ap.Color(240, 170, 190), ap.Color(170, 210, 240), ap.Color(250, 220, 140), ap.Color(180, 230, 170)][(h + kind) % 4]
        l.body = l.skin.lerp(ap.WHITE, 0.2)
        l.legs = l.skin.lerp(ap.BLACK, 0.15)
        l.eyes = ap.Color(30, 20, 30)
        l.glowing_eyes = false
        l.head = roster.HEAD_CAT if kind == A_GHOUL else (roster.HEAD_STITCHED if kind == A_ZOMBIE else l.head)
    else if level.style == STYLE_LAB and kind == A_ZOMBIE do
        l.body = ap.Color(220, 220, 200)
        l.head = roster.HEAD_HAZMAT if h % 2 == 0 else l.head
    end
    return l
end

function base_enemy_look(int kind, Level level) returns roster.Look
    var l = roster.Look()
    if kind == A_ZOMBIE or kind == A_GHOUL do
        l.skin = ap.Color(120, 150, 110) if kind == A_ZOMBIE else ap.Color(150, 140, 130)
        l.body = ap.Color(70, 60, 54)
        l.legs = ap.Color(48, 44, 50)
        l.trim = ap.Color(90, 70, 50)
        l.metal = ap.Color(160, 150, 140)
        l.eyes = ap.Color(230, 240, 120) if kind == A_ZOMBIE else ap.Color(255, 90, 60)
        l.glowing_eyes = true
        l.head = roster.HEAD_STITCHED
        l.weapon = roster.WEAPON_CLAWS if kind == A_GHOUL else roster.WEAPON_HANDS
        l.stance = roster.STANCE_PROWL
        l.bulk = 1.08 if kind == A_ZOMBIE else 0.86
        l.tall = 1.0 if kind == A_ZOMBIE else 0.9
    else if kind == A_WRAITH do
        l.skin = ap.Color(30, 28, 40)
        l.body = ap.Color(30, 28, 40)
        l.legs = ap.Color(22, 20, 30)
        l.cape_color = ap.Color(26, 24, 34)
        l.trim = ap.Color(40, 36, 52)
        l.accent = level.glow
        l.eyes = level.glow.lerp(ap.WHITE, 0.3)
        l.glowing_eyes = true
        l.head = roster.HEAD_HOOD
        l.weapon = roster.WEAPON_HANDS
        l.cape = true
        l.hover = 0.35
    else do
        l.skin = ap.Color(214, 206, 186)
        l.body = ap.Color(214, 206, 186)
        l.legs = ap.Color(196, 188, 168)
        l.trim = ap.Color(90, 70, 50)
        l.metal = ap.Color(130, 120, 110)
        l.eyes = level.glow.lerp(ap.Color(120, 200, 255), 0.5)
        l.head = roster.HEAD_SKULL
        l.weapon = roster.WEAPON_CROSSBOW if kind == A_ARCHER else roster.WEAPON_CUTLASS
        l.bulk = 0.8
        l.stance = roster.STANCE_GUARD
    end
    return l
end

# A level's boss fighter (or HELL's last, which is no fighter of the Arena).
roster.Character? satan_ref = null
function kit_of(Actor b) returns roster.Character
    if b.boss_index >= 0 and b.boss_index < cast.length do
        return cast[b.boss_index]
    end
    return satan()
end

function enemy_scale(Level level) returns double
    return 1 + 0.05 * double(math.max(level.index, 0))
end

function spawn_enemy(int kind, ap.Vec3 at) returns Actor
    var e = Actor()
    e.kind = kind
    e.look = enemy_look(kind, lv)
    e.body = ap.Body(at)
    e.body.radius = 0.32
    e.body.height = 1.7
    e.heading = ap.random(0, 360)
    var grow = enemy_scale(lv) * DIFF_ENEMY_HEALTH[data.difficulty]
    var hp = [0.0, 34.0, 24.0, 18.0, 26.0, 15.0, 0.0, 12.0][kind]
    e.hp = hp * grow
    e.hp_max = e.hp
    e.speed = [0.0, 1.5, 2.5, 2.0, 1.8, 3.6, 0.0, 3.4][kind]
    e.power = (1 + 0.035 * double(math.max(lv.index, 0))) * DIFF_ENEMY_DAMAGE[data.difficulty]
    e.home = at
    e.wander = at
    e.think = int(ap.random(20, 120))
    e.hovering = kind == A_WRAITH
    return e
end

function enemy_attack(Actor e) returns roster.Attack
    if e.kind == A_DECOY do
        return strike("Glass Cut", 5, 16, 20, 1.8, 100, 0.6, 0, 2, roster.ANIM_SWING)
    end
    if e.kind == A_ZOMBIE do
        return strike("Maul", 8, 30, 26, 1.5, 90, 0.4, 0, 2, roster.ANIM_SLAM)
    else if e.kind == A_SKELETON do
        return strike("Slash", 6, 20, 22, 1.8, 100, 0.5, 0, 2, roster.ANIM_SWING)
    else if e.kind == A_GHOUL do
        return strike("Rake", 4, 12, 18, 1.4, 90, 0.8, 0, 1, roster.ANIM_SWING)
    else if e.kind == A_ARCHER do
        return shot("Bolt", 6, 34, 24, 15, roster.ANIM_SHOOT)
    end
    var orb = shot("Cold Fire", 8, 36, 30, 7, roster.ANIM_CAST)
    orb.homing = 70
    return orb
end

# Where the dead stand when a level begins: a few in every plain room, more further in.
function populate(Level level)
    foes = []
    if level.index < 0 do
        return
    end
    var d = Dice(level.index * 31 + 7)
    d.next()
    var k = 0
    for r in level.rooms do
        if r.kind == ROOM_PLAIN do
            var n = 2 + d.range(0, 2) + level.index // 9 + (1 if data.difficulty >= DIFF_HARD else 0) + (1 if level.layout == LAYOUT_OPEN else 0)
            for i in 0..<n do
                var roll = d.next()
                var kind = A_ZOMBIE
                if level.index >= 3 and roll < 0.25 do
                    kind = A_ARCHER
                else if level.index >= 8 and roll < 0.4 do
                    kind = A_WRAITH
                else if level.index >= 5 and roll < 0.55 do
                    kind = A_GHOUL
                else if roll < 0.7 do
                    kind = A_SKELETON
                end
                var at = free_spot(level, r, d)
                if at.y < 0 do
                    continue
                end
                foes.push(spawn_enemy(kind, at))
                if kind == A_GHOUL do
                    # Ghouls come in threes (each where there is room).
                    for off in [ap.Vec3(0.9, 0, 0.4), ap.Vec3(-0.6, 0, 0.9)] do
                        if standable(level, at + off) do
                            foes.push(spawn_enemy(A_GHOUL, at + off))
                        end
                    end
                end
                k += 1
            end
        end
    end
end

# Whether a body can stand here: on floor, clear of walls, and of every pillar, rock and crate.
function standable(Level level, ap.Vec3 at) returns bool
    var c = cell_of(at)
    var k = cell_at(level, c[0], c[1])
    if k != CELL_FLOOR and k != CELL_DARK do
        return false
    end
    # No wall within a body's width.
    for dy in -1..<2 do
        for dx in -1..<2 do
            var n = cell_at(level, c[0] + dx, c[1] + dy)
            if n == CELL_WALL or n == CELL_VOID do
                var near = cell_center(c[0] + dx, c[1] + dy)
                if math.abs(near.x - at.x) < TILE / 2 + 0.45 and math.abs(near.z - at.z) < TILE / 2 + 0.45 do
                    return false
                end
            end
        end
    end
    for pr in level.props do
        if pr.kind != PROP_LAMP and pr.kind != PROP_CRATER do
            var half = 0.45 * pr.size + 0.45
            if math.abs(pr.at.x - at.x) < half and math.abs(pr.at.z - at.z) < half do
                return false
            end
        end
    end
    return true
end
# A random spot in a room where something can stand (y below 0: none found).
function free_spot(Level level, Room r, Dice d) returns ap.Vec3
    for tries in 0..<24 do
        var at = ap.Vec3((double(r.x) + 1 + d.next() * double(r.w - 2)) * TILE, 0, (double(r.y) + 1 + d.next() * double(r.h - 2)) * TILE)
        if standable(level, at) do
            return at
        end
    end
    return ap.Vec3(0, -1, 0)
end
# The nearest spot to `at` where something can stand.
function stand_near(Level level, ap.Vec3 at) returns ap.Vec3
    if standable(level, at) do
        return at
    end
    for ring in 1..<8 do
        for k in 0..<12 do
            var a = double(k) / 12 * 2 * math.PI
            var p = at + ap.Vec3(math.sin(a), 0, math.cos(a)) * (double(ring) * 0.6)
            if standable(level, p) do
                return p
            end
        end
    end
    return at
end

# The level's owner, as its boss: stronger the further in, and with the difficulty.
function make_boss(int index) returns Actor
    var kit = cast[index]
    var b = Actor()
    b.kind = A_BOSS
    b.boss_index = index
    b.look = kit.look
    var room = lv.rooms[lv.boss_room]
    b.body = ap.Body(stand_near(lv, room.center() + ap.Vec3(1.5, 0, 1.5)))
    b.body.radius = 0.4 * kit.look.bulk
    b.body.height = 1.8 * kit.look.tall
    b.hp = kit.health * BOSS_HEALTH[data.difficulty] * (1 + double(index) / 30)
    b.hp_max = b.hp
    b.speed = kit.speed * BOSS_SPEED[data.difficulty]
    b.tempo = BOSS_TEMPO[data.difficulty]
    b.power = BOSS_POWER[data.difficulty] * (1 + 0.015 * double(index))
    b.damage_taken = kit.armor
    for a in kit.basics do
        b.basics.push(a)
    end
    for a in kit.skills do
        if boss_can_use(a) do
            b.skills.push(a)
            b.skill_cool.push(int(ap.random(60, 240)))
        end
    end
    if b.basics.length == 0 do
        b.basics.push(strike("Strike", 8, 10, 16, 1.9, 100, 0.4, 16, 2, roster.ANIM_SWING))
    end
    b.heading = heading_of(player.body.position - b.body.position)
    b.aware = true
    b.fade = 0
    b.think = 40
    return b
end

# The skills of the Arena a boss can use here: its attacks, and its tricks (buffs, blinks,
# cloaks, portals, mirrors, walls, switching places, fanning the hammer).
function boss_ranged(roster.Attack a) returns bool
    return a.shot != roster.SHOT_NONE or a.beam > 0 or a.skyfall or a.kind == roster.KIND_FAN
end
# No boss zones: every one fights up close, and after any ranged attack (a shot, a beam, a
# throw, a fan of the hammer) it waits a few seconds before the next, closing in meanwhile.
function shot_taken(Actor b, roster.Attack a)
    if boss_ranged(a) do
        b.shot_gap = int(double(BOSS_SHOT_GAP[data.difficulty]) * ap.random(0.85, 1.2))
    end
end
# The melee blow a boss closes in for: its first basic, or its fallback if its basics are shots.
function melee_blow(roster.Character kit) returns roster.Attack
    if kit.basics.length > 0 and not boss_ranged(kit.basics[0]) do
        return kit.basics[0]
    end
    if kit.fallback.name != "" do
        return kit.fallback
    end
    return strike("Strike", 8, 10, 16, 1.9, 100, 0.4, 16, 2, roster.ANIM_SWING)
end

function boss_can_use(roster.Attack a) returns bool
    if a.kind == roster.KIND_STRIKE do
        return a.damage > 0 or a.shot != roster.SHOT_NONE or a.beam > 0
    end
    int[] tricks = [roster.KIND_BUFF, roster.KIND_BLINK, roster.KIND_CLOAK, roster.KIND_PORTAL, roster.KIND_MIRROR,
        roster.KIND_GLASS, roster.KIND_SHATTER, roster.KIND_WALL, roster.KIND_SWITCH, roster.KIND_FAN]
    return has(tricks, a.kind)
end

# HELL's last: no fighter of the Arena. Huge, horned, winged, burning.
function satan() returns roster.Character
    var have = satan_ref
    if have != null do
        return have as roster.Character
    end
    var c = roster.Character("SATAN", "THE ADVERSARY")
    c.health = 2600
    c.speed = 4.4
    c.armor = 0.8
    c.ai_range = 3.2
    c.basics = [strike("Rake", 16, 14, 18, 3.4, 140, 0.6, 24, 6, roster.ANIM_SWING),
        strike("Rake", 16, 14, 18, 3.4, 140, 0.6, 24, 6, roster.ANIM_BACKSWING),
        strike("Hammerfist", 26, 22, 24, 3.6, 120, 0.8, 34, 10, roster.ANIM_SLAM)]
    var slam = strike("Brimstone Slam", 30, 34, 30, 6.5, 360, 0, 30, 14, roster.ANIM_SLAM)
    slam.radial = true
    slam.launch = 9
    slam.cooldown = 300
    var breath = shot("Hellbreath", 34, 46, 30, 0, roster.ANIM_SPIT)
    breath.beam = 18
    breath.cooldown = 360
    var rain = shot("Hellfire Rain", 22, 26, 26, 0, roster.ANIM_CAST)
    rain.skyfall = true
    rain.blast = 2.4
    rain.volley = 7
    rain.cooldown = 320
    var grasp = multi(strike("Grasp of the Pit", 12, 18, 26, 3.0, 90, 3.5, 30, 0, roster.ANIM_BITE), 3, 9)
    grasp.cooldown = 280
    var damned = strike("Call the Damned", 0, 30, 20, 0, 0, 0, 0, 0, roster.ANIM_FOCUS)
    damned.kind = roster.KIND_MIRROR
    damned.cooldown = 700
    var pillars = strike("Pillars of Fire", 0, 24, 20, 0, 0, 0, 0, 0, roster.ANIM_CAST)
    pillars.kind = roster.KIND_PORTAL
    pillars.cooldown = 240
    c.skills = [slam, breath, rain, grasp, damned, pillars]
    c.ultimate = shot("Judgement", 60, 60, 40, 0, roster.ANIM_CAST)
    c.ultimate.beam = 22
    c.ultimate.unblockable = true
    c.maximum.name = "HELLFIRE"
    c.maximum.anim = roster.ANIM_FOCUS
    c.maximum.power = 1.3
    c.maximum.speed = 1.2
    c.maximum.foe_dps = 2
    c.maximum.portals = true
    c.maximum.strike = strike("Brimstone", 18, 1, 1, 0, 0, 0, 0, 0, roster.ANIM_CAST)
    c.maximum.strike_every = 2.5
    c.maximum.sky = ap.Color(40, 4, 2)
    c.maximum.ambient = ap.Color(160, 50, 30)
    var l = c.look
    l.skin = ap.Color(170, 30, 30)
    l.body = ap.Color(90, 14, 16)
    l.legs = ap.Color(40, 10, 12)
    l.trim = ap.Color(20, 10, 10)
    l.accent = ap.Color(255, 90, 30)
    l.metal = ap.Color(40, 30, 30)
    l.eyes = ap.Color(255, 220, 80)
    l.glowing_eyes = true
    l.head = roster.HEAD_JESTER
    l.weapon = roster.WEAPON_CLAWS
    l.wings = true
    l.wing_color = ap.Color(50, 10, 12)
    l.cape = true
    l.cape_color = ap.Color(40, 8, 10)
    l.bulk = 1.8
    l.tall = 2.6
    satan_ref = c
    return c
end

function make_satan(ap.Vec3 at) returns Actor
    var kit = satan()
    var b = Actor()
    b.kind = A_BOSS
    b.role = ROLE_SATAN
    b.boss_index = -1
    b.look = kit.look
    b.body = ap.Body(at)
    b.body.radius = 0.4 * kit.look.bulk
    b.body.height = 1.8 * kit.look.tall
    b.hp = kit.health * 0.75
    b.hp_max = b.hp
    b.speed = kit.speed
    b.tempo = 1.0
    b.power = 1.0
    b.damage_taken = kit.armor
    for a in kit.basics do
        b.basics.push(a)
    end
    for a in kit.skills do
        b.skills.push(a)
        b.skill_cool.push(int(ap.random(90, 200)))
    end
    b.aware = true
    b.fade = 1
    b.think = 60
    b.rise = 0
    return b
end

# --- Effects -----------------------------------------------------------------------------------

function burst(ap.Vec3 at, int count, ap.Color color, double speed, double life = 0.5, double size = 0.08)
    for k in 0..<count do
        var dir = ap.Vec3(ap.random(-1, 1), ap.random(-0.3, 1), ap.random(-1, 1))
        motes.push(Mote(at, unit(dir) * (speed * ap.random(0.4, 1)), color, life, life, size, 6))
    end
end
function float_text(ap.Vec3 at, string words, ap.Color color)
    floaters.push(Floater(at + ap.Vec3(ap.random(-0.2, 0.2), 0, ap.random(-0.2, 0.2)), words, color))
end

# --- Hurting -----------------------------------------------------------------------------------

function alive(Actor a) returns bool
    return a.state != S_DEAD
end

# `who` hurts `victim` by `amount`; `stun` ticks and a shove (only real fighters stagger Scarf).
# Mid melee attack (not a shot, ray or a move with no hit): hyperarmor.
function in_melee(Actor a) returns bool
    return a.state == S_ATTACK and a.act.damage > 0 and a.act.reach > 0 and a.act.shot == roster.SHOT_NONE and a.act.beam <= 0 and not a.act.skyfall
end

function hurt(Actor victim, double amount, int stun, ap.Vec3 from, double push, double launch, Actor? who, Move? how) returns void
    if not alive(victim) or victim.fade < 0.5 do
        return
    end
    if victim.iframes > 0 or victim.state == S_KNEEL or victim.super_cast > 0 do
        if victim.super_cast > 0 do
            float_text(chest_of(victim), "UNTOUCHABLE", ap.Color(220, 210, 230))
        end
        return
    end
    if victim.kind == A_BOSS and victim.rise < 1 and victim.role == ROLE_SATAN do
        return
    end
    var dmg = amount
    var facing_hit = math.abs(wrap(heading_of(from - victim.body.position) - victim.heading)) < 75
    var by_player = who != null and (who as Actor).kind == A_PLAYER
    var src = SRC_BASIC
    if how != null do
        src = (how as Move).src
    end
    if by_player do
        dmg = item_damage(dmg, how)
        dmg = synergy_damage(dmg, victim, src)
    end
    if victim.sunder > 0 do
        dmg *= 1.4
    end
    if victim.kind == A_PLAYER do
        combat_lock = true
        calm_ticks = 0
        if boss_phase == BP_FIGHT do
            boss_hit_taken = true
        end
        if pact_is("glass") do
            dmg *= 1.5
        end
        if ap.random() * 100 < item_fx(items.E_DODGE) do
            float_text(chest_of(victim), "DODGED", ap.Color(200, 230, 255))
            return
        end
        since_hurt = 0
        if victim.guard_time > 0 do
            float_text(chest_of(victim), "GUARDED", ap.Color(255, 220, 140))
            sfx(SND_BLOCK, 0.5, 1.2)
            return
        end
        if victim.state == S_BLOCK and facing_hit and not unblockable_hit and not pact_is("berserk") do
            if victim.block_ticks < 9 + int(item_fx(items.E_PARRY_TIME)) and who != null do
                # A parry: nothing gets through, and whoever swung reels.
                var w = who as Actor
                w.state = S_HURT
                w.stun = 40
                w.stun_total = 40
                w.frame = 0
                float_text(chest_of(victim), "PARRY", ap.Color(255, 240, 160))
                sfx(SND_PARRY, 0.7)
                burst(chest_of(victim) + forward_of(victim.heading) * 0.4, 14, ap.Color(255, 240, 180), 5)
                stamina = math.min(stamina + 15, data.max_stamina)
                since_parry = 0
                victim.hp = math.min(victim.hp + item_fx(items.E_PARRY_HEAL), victim.hp_max)
                return
            end
            dmg *= 0.08 * items.less(item_fx(items.E_GUARD))
            sfx(SND_BLOCK, 0.55)
            if who != null and (who as Actor).kind == A_BOSS and not ranged_hit do
                # A block (not a parry) of a melee hit shoves a boss back a couple of metres.
                var w = who as Actor
                w.knock = unit(flat(w.body.position - victim.body.position)) * BLOCK_SHOVE
            end
            stamina = math.max(stamina - amount * 1.2, 0.0)
            if stamina <= 0 and not unstunnable() do
                victim.state = S_HURT
                victim.stun = 40
                victim.stun_total = 40
                float_text(chest_of(victim), "GUARD BROKEN", ap.Color(255, 120, 100))
                sfx(SND_HIT_HEAVY, 0.7, 0.8)
            end
        end
        if victim.armor_time > 0 do
            dmg *= 0.5
        end
        dmg *= items.less(item_fx(items.E_ARMOR))
        if item_fx(items.E_THORNS) > 0 and who != null and not ranged_hit do
            # THORN MAIL: melee attackers take some back.
            var w = who as Actor
            w.hp -= dmg * item_fx(items.E_THORNS) / 100
            if w.hp <= 0 do
                die(w)
            end
        end
        if shield_hp > 0 do
            var soaked = math.min(shield_hp, dmg)
            shield_hp -= soaked
            dmg -= soaked
            float_text(chest_of(victim) + ap.Vec3(0, 0.4, 0), "SHIELD", ap.Color(160, 200, 255))
        end
    else do
        if who != null and (who as Actor).kind == A_PLAYER do
            combat_lock = true
            calm_ticks = 0
            victim.aware = true
        end
        dmg *= victim.damage_taken
        if victim.buff_time > 0 do
            dmg *= 0.6
        end
        if victim.cloak_time > 0 do
            victim.cloak_time = 0
        end
    end
    victim.hp -= dmg
    victim.flash = 1
    var hit_weapon = (who as Actor).look.weapon if who != null else roster.WEAPON_HANDS
    if how != null and (how as Move).mn > 0 do
        hit_weapon = roster.WEAPON_GUN
    end
    if who != null and (who as Actor).kind == A_PLAYER and menu == MENU_STANCE and how != null do
        hit_weapon = roster.WEAPON_FISTS
    end
    sfx_at(impact_sound(hit_weapon, dmg), victim.body.position, 0.6 if victim.kind != A_PLAYER else 0.75, 1.0 if victim.kind != A_SKELETON and victim.kind != A_ARCHER else 1.3)
    if victim.kind == A_PLAYER do
        sfx(SND_HIT, 0.35, 0.8)
    end
    if launch > 0 do
        sfx_at(SND_LAUNCH, victim.body.position, 0.5)
    end
    burst(chest_of(victim), 6, ap.Color(255, 250, 240), 2.5, 0.18, 0.05)
    float_text(chest_of(victim), "{int(math.round(dmg))}", ap.Color(255, 90, 80) if victim.kind == A_PLAYER else ap.Color(255, 240, 220))
    var away = unit(flat(victim.body.position - from))
    var can_stagger = victim.kind != A_PLAYER or (who != null and (who as Actor).kind == A_BOSS)
    if victim.kind == A_PLAYER and (in_melee(victim) or unstunnable()) do
        can_stagger = false              # hyperarmor: a melee attack is never interrupted (the damage still lands)
    end
    if victim.kind == A_BOSS and victim.state == S_ATTACK and victim.frame >= victim.act.startup do
        can_stagger = false              # mid-swing, a boss does not flinch
    end
    var stun_for = stun
    if victim.kind == A_PLAYER and who != null and (who as Actor).kind == A_BOSS do
        stun_for = int(double(stun) * BOSS_STUN[data.difficulty] * items.less(item_fx(items.E_TENACITY)))
    end
    var shove = push
    var throw_up = launch
    if by_player do
        # The items' after-effects of Scarf's hit.
        stun_for = int(double(stun_for) * items.more(item_fx(items.E_STUN)))
        shove = push * items.more(item_fx(items.E_PUSH))
        throw_up = launch + item_fx(items.E_LAUNCH)
        player.hp = math.min(player.hp + dmg * item_fx(items.E_LIFESTEAL) / 100 + item_fx(items.E_HEAL_HIT), player.hp_max)
        stamina = math.min(stamina + item_fx(items.E_BAR_HIT), data.max_stamina)
        if item_fx(items.E_POISON) > 0 do
            victim.poison += item_fx(items.E_POISON)
        end
        if item_fx(items.E_SLOW) > 0 do
            victim.freeze += item_fx(items.E_SLOW)
        end
        if item_fx(items.E_REFUND) > 0 do
            for k in 0..<cools.length do
                cools[k] = math.max(cools[k] - int(item_fx(items.E_REFUND) * 60), 0)
            end
        end
        weapon_aftermath(victim, src, dmg)
    end
    if can_stagger and stun_for > 0 do
        if victim.state != S_DEAD do
            victim.state = S_HURT
            victim.frame = 0
            victim.stun = stun_for
            victim.stun_total = stun_for
        end
        victim.knock = away * shove
        if throw_up > 0 do
            victim.lift_speed = throw_up * 0.8
        end
    else if victim.kind != A_PLAYER do
        victim.knock = away * (shove * 0.5)
    end
    if how != null do
        var m = how as Move
        if m.fx == FX_BURN do
            victim.burn = math.max(victim.burn, m.fx_time)
        else if m.fx == FX_FREEZE do
            victim.freeze = math.max(victim.freeze, m.fx_time)
        else if m.fx == FX_POISON do
            victim.poison = math.max(victim.poison, m.fx_time)
        else if m.fx == FX_DRAIN and who != null do
            var w = who as Actor
            w.hp = math.min(w.hp + dmg * 0.6, w.hp_max)
            streaks.push(Streak(chest_of(victim), chest_of(w), m.color, 0.3, 0.3, 0.06))
        else if m.fx == FX_HEAL and who != null do
            var w = who as Actor
            w.hp = math.min(w.hp + dmg * 0.33, w.hp_max)
            burst(chest_of(w), 4, m.color, 1.5, 0.4, 0.05)
        else if m.fx == FX_MANA and by_player do
            mana = math.min(mana + m.fx_time, data.max_mana)
            streaks.push(Streak(chest_of(victim), chest_of(player), m.color, 0.25, 0.25, 0.04))
        else if m.fx == FX_SUNDER do
            victim.sunder = math.max(victim.sunder, m.fx_time)
            float_text(chest_of(victim) + ap.Vec3(0, 0.3, 0), "SUNDERED", m.color)
        else if m.fx == FX_VENOM do
            victim.poison = math.max(victim.poison, m.fx_time)
        end
    end
    if victim.hp <= 0 do
        die(victim)
    end
end

# What Scarf's hit is worth with everything that goes with it: a stance under War Cry, the pact,
# Berserk's rage, and each weapon's favourite prey.
function synergy_damage(double dmg, Actor victim, int src) returns double
    var out = dmg
    if src == SRC_STANCE and warcry_time > 0 do
        out *= 1.4
    end
    if pact_is("glass") do
        out *= 1.6
    end
    if pact_is("berserk") and player.hp < player.hp_max * 0.5 do
        out *= 1.35
    end
    if src == SRC_BASIC or src == SRC_ARMS do
        var w = data.weapon
        if w == 0 and victim.freeze > 0 do
            out *= 1.5
        else if w == 1 and victim.burn > 0 do
            out *= 1.5
        else if w == 2 and victim.sunder > 0 do
            out *= 1.4
        else if w == 4 and victim.poison > 0 do
            out *= 1.5
        end
    end
    return out
end

# After Scarf's weapon lands: the staff's mana, and whatever the forge put in it.
function weapon_aftermath(Actor victim, int src, double dmg) returns void
    if src != SRC_BASIC and src != SRC_ARMS do
        return
    end
    if data.weapon == 3 do
        mana = math.min(mana + 3, data.max_mana)
    end
    var inf = infusion(data.weapon)
    if inf == "ember" do
        victim.burn = math.max(victim.burn, 2.5)
    else if inf == "frost" do
        victim.freeze = math.max(victim.freeze, 1.2)
    else if inf == "venom" do
        victim.poison = math.max(victim.poison, 3.0)
    else if inf == "soul" do
        mana = math.min(mana + 2, data.max_mana)
    else if inf == "storm" and not storm_arcing do
        # An arc to the nearest other enemy, for 40%.
        var best = -1
        var near = 5.0
        var all = targets_of(player)
        for k, o in all do
            var d = flat_distance(o.body.position, victim.body.position)
            if o != victim and d < near do
                near = d
                best = k
            end
        end
        if best >= 0 do
            storm_arcing = true
            streaks.push(Streak(chest_of(victim), chest_of(all[best]), INFUSE_COLORS[3], 0.25, 0.25, 0.05))
            hurt(all[best], dmg * 0.4, 8, victim.body.position, 1, 0, player, null)
            storm_arcing = false
        end
    end
end
var storm_arcing = false
var warcry_time = 0.0                # seconds War Cry has left
var venom_time = 0.0                 # seconds Venom Mist's boost has left
var boss_hit_taken = false           # Scarf has been hit in this boss fight

function die(Actor a) returns void
    a.hp = 0
    a.state = S_DEAD
    a.frame = 0
    if a.kind == A_PLAYER and item_fx(items.E_REVIVE) > 0 and not revive_used do
        # PHOENIX FEATHER: up again, once a level.
        revive_used = true
        a.state = S_IDLE
        a.hp = a.hp_max * item_fx(items.E_REVIVE) / 100
        burst(chest_of(a), 40, ap.Color(255, 160, 60), 5, 1.0, 0.1)
        say("PHOENIX FEATHER: BACK ON YOUR FEET", ap.Color(255, 180, 90), 160)
        sfx(SND_FLASH, 0.6)
        return
    end
    if a.kind == A_PLAYER do
        sfx(SND_THUD, 0.8, 0.7)
        sfx(SND_BELL, 0.5, 0.5)
        overlay = O_DEATH
        overlay_ticks = 0
        overlay_row = 0
        deaths += 1
        release_mouse()
        if data.difficulty == DIFF_HELL do
            # One life: the run is over.
            data.hell_deaths += 1
            data = fresh_save(data)
            data.difficulty = DIFF_HELL
            store()
        end
        return
    end
    if a.kind == A_BOSS and boss_kneels(a) do
        return
    end
    burst(chest_of(a), 24, a.look.eyes, 3.5, 0.9, 0.07)
    sfx_at(SND_THUD, a.body.position, 0.6, 0.9)
    if a.kind == A_SKELETON or a.kind == A_ARCHER do
        sfx_at(SND_CLASH_B, a.body.position, 0.45, 0.6)
    else if a.kind == A_WRAITH do
        sfx_at(SND_WISP, a.body.position, 0.6, 0.6)
    else if a.kind == A_BOSS do
        sfx_at(SND_BOOM_BIG, a.body.position, 0.8)
    else do
        sfx_at(SND_GROWL, a.body.position, 0.4, 0.6)
    end
    sfx_at(SND_SHIMMER, a.body.position, 0.3, 1.4)
    var worth = [0, 2, 2, 3, 3, 1, 0, 0][a.kind] if a.kind != A_BOSS else 40 + math.max(a.boss_index, 0) * 3
    if a.kind == A_BOSS and a.role == ROLE_GAUNTLET do
        worth = 6
    else if a.kind == A_BOSS and a.role == ROLE_REVENGE do
        worth = 90 + a.boss_index * 6        # beaten back: twice a boss's souls, and more

    end
    if pact_is("greed") do
        worth *= 3
    end
    if infusion(data.weapon) == "soul" and a.kind != A_BOSS do
        worth += 1
    end
    for k in 0..<math.min(worth, 12) do
        souls.push(Soul(chest_of(a), ap.Vec3(ap.random(-2, 2), ap.random(2, 4), ap.random(-2, 2)), 1 if worth <= 12 else worth // 12 + 1))
    end
    if pact_is("bloodlust") do
        player.hp = math.min(player.hp + player.hp_max * 0.1, player.hp_max)
    end
    achieve("first_blood")
    if a.kind == A_BOSS do
        boss_fell(a)
    end
end

# --- Moves -------------------------------------------------------------------------------------

function begin(Actor a, roster.Attack act, Move? how)
    a.state = S_ATTACK
    a.frame = 0
    a.act = act
    a.struck_beat = -1
    a.skill = how as Move if how != null else Move("")
    if a.kind == A_ZOMBIE do
        sfx_at(SND_GROWL, a.body.position, 0.5, 0.8)
    else if a.kind == A_GHOUL do
        sfx_at(SND_HISS, a.body.position, 0.4, 1.3)
    else if a.kind == A_ARCHER do
        sfx_at(SND_LATCH, a.body.position, 0.5)
    else if a.kind == A_WRAITH do
        sfx_at(SND_CHARGE, a.body.position, 0.4, 0.7)
    else if a.kind == A_PLAYER and how != null do
        var m = how as Move
        if m.mn > 0 do
            sfx(SND_CHARGE, 0.3, 1.3)
        end
        if m.a.damage >= 15 and m.st > 0 do
            sfx(SND_KIAI, 0.4)
        end
    end
end

function attack_length(roster.Attack a) returns int
    return a.startup + (a.hits - 1) * a.interval + a.recovery
end
function attack_phase(roster.Attack a, int frame) returns double
    if frame < a.startup do
        return double(frame) / double(math.max(a.startup, 1))
    end
    var into = frame - a.startup
    var striking = (a.hits - 1) * a.interval + 7
    if into < striking do
        if a.hits > 1 and into < a.hits * a.interval do
            return 1 + double(into % a.interval) / double(a.interval)
        end
        return 1 + math.min(double(into - (a.hits - 1) * a.interval) / 7, 0.99)
    end
    return 2 + math.min(double(into - striking) / double(math.max(a.recovery - 7, 1)), 0.99)
end

# The targets of an attack by `a`: Scarf's are everything else, everything else's is Scarf.
function targets_of(Actor a) returns Actor[]
    if a.kind == A_PLAYER do
        Actor[] all = []
        for f in foes do
            if alive(f) do
                all.push(f)
            end
        end
        for b in bosses do
            if alive(b) and b.fade > 0.5 do
                all.push(b)
            end
        end
        return all
    end
    return [player] if alive(player) else []
end

# One tick of an attack in progress: the lunge, then each strike as its moment comes.
function run_attack(Actor a)
    var act = a.act
    a.frame += 1
    # Steps behind the target just before striking (a boss's teleport strikes; Scarf's Shade Strike).
    var behind = (a.kind == A_BOSS and act.teleport) or (a.kind == A_PLAYER and a.skill.fx == FX_BEHIND)
    # A boss appears at the very start of the move, so its whole wind-up is there to see.
    var step_at = 1 if a.kind == A_BOSS else math.max(act.startup - 5, 1)
    if behind and a.frame == step_at do
        var t = aim_target(a)
        if t != null do
            var o = t as Actor
            var to = o.body.position - forward_of(o.heading) * 1.3
            if a.kind == A_BOSS do
                # Not behind Scarf: in front, off to one side, where it can be seen and blocked.
                to = stand_near(lv, o.body.position + forward_of(o.heading + (50.0 if ap.random() < 0.5 else -50.0)) * 2.0)
            end
            if standable(lv, to) and lv.world.sees(chest_of(o), to + ap.Vec3(0, 1, 0)) do
                burst(chest_of(a), 14, a.look.accent if a.kind != A_PLAYER else a.skill.color, 3, 0.4, 0.07)
                a.body = ap.Body(to)
                a.body.radius = 0.33 if a.kind == A_PLAYER else 0.4 * a.look.bulk
                a.body.height = 1.75 if a.kind == A_PLAYER else 1.8 * a.look.tall
                a.heading = heading_of(flat(o.body.position - to))
                sfx_at(SND_RIFT, to, 0.5, 1.2)
                burst(chest_of(a), 14, a.look.accent if a.kind != A_PLAYER else a.skill.color, 3, 0.4, 0.07)
            end
        end
    end
    if a.kind == A_PLAYER and a.skill.fx == FX_DODGE and a.frame < act.startup + 2 do
        a.iframes = math.max(a.iframes, 2)
    end
    if a.kind == A_BOSS and a.ulting and a.frame < act.startup + 8 do
        a.iframes = math.max(a.iframes, 2)
    end
    if a.frame < act.startup do
        # Turning toward the target while winding up (a boss's long, aimed moves lock their aim
        # for the last half second: the moment to step aside).
        var t = aim_target(a)
        var locked = a.kind == A_BOSS and act.startup > 40 and a.frame > act.startup - 30
        if t != null and not locked do
            var want = heading_of(flat((t as Actor).body.position - a.body.position))
            a.heading = a.heading + math.clamp(wrap(want - a.heading), -8.0, 8.0)
        end
        return
    end
    var beat = math.min((a.frame - act.startup) // math.max(act.interval, 1), act.hits - 1)
    if a.frame - act.startup == 0 and act.lunge > 0 do
        a.dash_way = forward_of(a.heading) * (act.lunge * reach_of(a) / 0.15)
        a.dash_ticks = 9
    end
    if beat != a.struck_beat and (a.frame - act.startup) % math.max(act.interval, 1) == 0 do
        a.struck_beat = beat
        fire(a, act, beat)
    end
    if a.frame >= attack_length(act) do
        a.state = S_IDLE
        a.frame = 0
        a.ulting = false
    end
end

function aim_target(Actor a) returns Actor?
    if a.kind != A_PLAYER do
        return player
    end
    var best = -1
    var near = 1000.0
    var all = targets_of(a)
    for k, t in all do
        var d = flat_distance(t.body.position, a.body.position)
        var off = math.abs(wrap(heading_of(t.body.position - a.body.position) - a.heading))
        var score = d + off / 30
        if d < 18 and score < near and lv.world.sees(chest_of(a), chest_of(t)) do
            near = score
            best = k
        end
    end
    if best < 0 do
        return null
    end
    return all[best]
end

# The moment an attack goes off.
# What a move sounds like as it goes off.
function fire_sound(Actor a, roster.Attack act, int fx)
    var at = a.body.position
    var near = a.kind == A_PLAYER
    var k = -1
    var volume = 0.55
    var pitch = 1.0
    if fx == FX_ARMOR do
        k = SND_FLASH
    else if fx == FX_GUARD do
        k = SND_WHOOSH_LONG
    else if fx == FX_BLINK do
        k = SND_RIFT
    else if act.beam > 0 do
        k = SND_ZAP if fx == FX_CHAIN else (SND_WISP if fx == FX_DRAIN else SND_BEAM)
    else if act.shot == roster.SHOT_BULLET do
        k = SND_GUN
        volume = 0.7
    else if act.shot == roster.SHOT_KNIFE do
        k = SND_DRAW_KNIFE
    else if act.shot == roster.SHOT_EMBER do
        k = SND_FIRE
    else if act.shot != roster.SHOT_NONE do
        k = SND_WISP if a.kind == A_WRAITH else (SND_WHOOSH if a.kind == A_ARCHER else SND_SPIT)
    else if act.name == "Frost Nova" do
        k = SND_SHIMMER
    else if act.name == "Earth Spike" or act.name == "Ground Stomp" do
        k = SND_BOOM
        volume = 0.45
        pitch = 0.7
    else if a.kind == A_PLAYER and menu == MENU_STANCE do
        k = one_of([SND_FIST_A, SND_FIST_B])
    else if a.kind == A_ZOMBIE or a.kind == A_GHOUL do
        k = SND_BITE if a.kind == A_GHOUL else one_of([SND_FIST_A, SND_FIST_B])
    else do
        k = swing_sound(a.look.weapon)
    end
    if act.radial and act.shot == roster.SHOT_NONE and k != SND_SHIMMER and k != SND_BOOM do
        k = SND_WHOOSH_LONG
    end
    if k < 0 do
        return
    end
    if near do
        sfx(k, volume, pitch)
    else do
        sfx_at(k, at, volume, pitch)
    end
    if k == SND_GUN do
        sfx_at(SND_CASING, at, 0.25, ap.random(0.9, 1.2))
    end
end

function fire(Actor a, roster.Attack act, int beat)
    var how = a.skill if a.skill.name != "" else null
    var color = a.skill.color if a.skill.name != "" else a.look.accent
    var power = a.power
    fire_sound(a, act, a.skill.fx if a.skill.name != "" else FX_NONE)
    if a.kind == A_PLAYER and how != null do
        var m = how as Move
        if m.fx == FX_ARMOR do
            a.armor_time = m.fx_time
            burst(chest_of(a), 20, m.color, 3)
            say("IRON BODY", m.color, 90)
            return
        else if m.fx == FX_GUARD do
            a.guard_time = m.fx_time
            burst(chest_of(a), 16, m.color, 3)
            return
        else if m.fx == FX_BLINK do
            var way = steer_way()
            if way.length() < 0.1 do
                way = forward_of(a.heading)
            end
            var to = a.body.position + way * 5
            streaks.push(Streak(chest_of(a), to + ap.Vec3(0, 1.1, 0), m.color, 0.35, 0.35, 0.12))
            a.body.move(lv.world, way * 5)
            a.iframes = 12
            burst(chest_of(a), 18, m.color, 2.5)
            return
        else if m.fx == FX_BACKSTEP and beat == 0 do
            a.body.move(lv.world, forward_of(a.heading) * -1.6)
        else if m.fx == FX_RESTORE do
            var heal = a.hp_max * m.fx_time
            a.hp = math.min(a.hp + heal, a.hp_max)
            float_text(chest_of(a), "+{int(heal)}", ap.Color(120, 230, 140))
            burst(chest_of(a), 24, m.color, 2.5, 0.8, 0.07)
            sfx(SND_HEAL, 0.55)
            return
        else if m.fx == FX_WARCRY do
            warcry_time = m.fx_time
            burst(chest_of(a), 30, m.color, 5, 0.6, 0.08)
            say("WAR CRY: STANCE MOVES HIT HARDER", m.color, 90)
            sfx(SND_KIAI, 0.6, 0.8)
            return
        else if m.fx == FX_RITE do
            var cost = a.hp_max * 0.12
            a.hp = math.max(a.hp - cost, 1.0)
            stamina = data.max_stamina
            mana = math.min(mana + 40, data.max_mana)
            float_text(chest_of(a), "-{int(cost)}", ap.Color(255, 90, 80))
            burst(chest_of(a), 26, m.color, 3, 0.7, 0.07)
            sfx(SND_SLICE, 0.5)
            sfx(SND_HEAL, 0.4, 0.7)
            return
        else if m.fx == FX_METEOR do
            var t = aim_target(a)
            var at = (t as Actor).body.position if t != null else a.body.position + forward_of(a.heading) * 6
            var rock = Bolt(at + ap.Vec3(0.5, 12, 0.3), ap.Vec3(-0.4, -13, -0.2))
            rock.mine = true
            rock.damage = act.damage * power
            rock.color = m.color
            rock.size = 0.45
            rock.blast = act.blast
            rock.life = 2
            rock.src = SRC_ART
            bolts.push(rock)
            marks.push(Mark(at, 1.0, m.color))
            sfx(SND_WHOOSH_LONG, 0.5, 0.6)
            return
        else if m.fx == FX_VENOM and beat == 0 do
            venom_time = 8
            for k in 0..<28 do
                var ang = double(k) / 28 * 360
                motes.push(Mote(a.body.position + ap.Vec3(0, 0.4, 0), forward_of(ang) * ap.random(2, 5) + ap.Vec3(0, ap.random(0.2, 1.0), 0), m.color.fade(0.7), 1.2, 1.2, 0.16))
            end
        end
        if act.name == "Earth Spike" or act.name == "Grave Hands" do
            raise_spikes(a, act, m.color)
        end
    end
    if a.kind == A_BOSS and act.kind != roster.KIND_STRIKE do
        boss_trick(a, act)
        return
    end
    if a.kind == A_PLAYER and how != null and (how as Move).fx == FX_LANCE do
        # Soul Lance: every drop of mana left goes into it.
        power *= 1 + mana / 40
        mana = 0
    end
    if a.kind == A_BOSS and (act.skyfall or act.lob) and act.shot != roster.SHOT_NONE or a.kind == A_BOSS and act.skyfall do
        boss_sky(a, act)
        return
    end
    if act.beam > 0 do
        ranged_hit = true
        fire_beam(a, act, how, color, power)
        unblockable_hit = false
        ranged_hit = false
        return
    end
    if act.shot != roster.SHOT_NONE do
        var from = chest_of(a) + forward_of(a.heading) * 0.5 + ap.Vec3(0, 0.25, 0)
        var aim = forward_of(a.heading)
        var t = aim_target(a)
        if t != null do
            aim = unit((chest_of(t as Actor)) - from)
        end
        var spread = act.spread if act.hits > 1 or act.volley > 1 else 0.0
        var volley = math.max(act.volley, 1)
        for v in 0..<volley do
        var turn = (ap.random(-spread, spread) if volley == 1 else spread * (double(v) - double(volley - 1) / 2)) * math.PI / 180
        var dir = ap.Vec3(aim.x * math.cos(turn) + aim.z * math.sin(turn), aim.y, -aim.x * math.sin(turn) + aim.z * math.cos(turn))
        var b = Bolt(from, dir * math.max(act.shot_speed, 4.0 if a.kind == A_BOSS else 0.0))
        b.mine = a.kind == A_PLAYER
        b.damage = act.damage * power
        b.color = color if a.kind == A_PLAYER else (a.look.eyes if a.kind != A_BOSS else a.look.accent)
        b.size = 0.09 if act.shot == roster.SHOT_BULLET else 0.16
        b.blast = act.blast
        b.homing = act.homing
        b.stun = act.stun
        b.knife = act.shot == roster.SHOT_KNIFE
        b.poison = act.poison
        b.slow = act.slow
        if act.shot_speed <= 0.1 and a.kind == A_BOSS do
            # A mine: set down where the boss stands, to wait.
            b.at = a.body.position + forward_of(a.heading) * 1.2 + ap.Vec3(0, 0.25, 0)
            b.vel = ap.Vec3(0, 0, 0)
            b.life = math.min(act.shot_life, 12.0)
            b.size = 0.22
            b.mine_wait = true
        end
        if how != null do
            var m = how as Move
            b.fx = m.fx
            b.fx_time = m.fx_time
            b.src = m.src
            b.ricochet = m.fx == FX_RICOCHET
            b.bounces = 2 if m.fx == FX_RICOCHET else 0
            b.pierce = m.fx == FX_PIERCE
            if m.fx == FX_RICOCHET do
                b.life = 3.5
            end
        end
        if act.shot == roster.SHOT_BULLET and a.kind == A_PLAYER do
            muzzle(from, dir)
            noise(a.body.position, 14)
        end
        bolts.push(b)
        end
        return
    end
    # A melee strike: everything in reach, in front (or all round).
    for t in targets_of(a) do
        var gap = flat_distance(t.body.position, a.body.position) - t.body.radius
        if gap > act.reach * reach_of(a) do
            continue
        end
        var off = math.abs(wrap(heading_of(t.body.position - a.body.position) - a.heading))
        if not act.radial and off > act.arc / 2 + 10 do
            continue
        end
        if math.abs(t.lift - a.lift) > 1.6 do
            continue
        end
        var dmg = act.damage * power
        if beat == act.hits - 1 do
            dmg += act.finish
        end
        var before = t.hp
        hurt(t, dmg, act.stun, a.body.position, act.push, act.launch, a, how)
        burst(chest_of(t), 8, color.lerp(ap.WHITE, 0.4), 3, 0.3, 0.06)
        if a.kind == A_BOSS and t.hp < before do
            boss_hit_effects(a, act, t)
        end
    end
    if act.radial do
        for k in 0..<16 do
            var ang = double(k) * 22.5
            motes.push(Mote(a.body.position + ap.Vec3(0, 0.3, 0), forward_of(ang) * (act.reach * 2.2), color.lerp(ap.WHITE, 0.3), 0.35, 0.35, 0.09))
        end
    end
end

function fire_beam(Actor a, roster.Attack act, Move? how, ap.Color color, double power)
    var from = chest_of(a) + ap.Vec3(0, 0.2, 0)
    var t = aim_target(a)
    var way = forward_of(a.heading)
    if t != null and a.kind != A_BOSS do
        way = unit(chest_of(t as Actor) - from)
    end
    if a.kind == A_BOSS and act.unblockable do
        unblockable_hit = true
    end
    var chain = how != null and (how as Move).fx == FX_CHAIN
    if chain and t != null do
        # Leaps from one to the next, up to four.
        Actor[] hit = []
        var at = from
        var current = t as Actor
        for jump in 0..<4 do
            streaks.push(Streak(at, chest_of(current), color, 0.3, 0.3, 0.07))
            hurt(current, act.damage * power * (1 - 0.15 * double(jump)), act.stun, at, 1, 0, a, how)
            hit.push(current)
            at = chest_of(current)
            var next_one = -1
            var near = 7.0
            var all = targets_of(a)
            for k, o in all do
                var done = false
                for h in hit do
                    if h == o do
                        done = true
                    end
                end
                var d = (chest_of(o) - at).length()
                if not done and d < near do
                    near = d
                    next_one = k
                end
            end
            if next_one < 0 do
                break
            end
            current = all[next_one]
        end
        return
    end
    var reach = act.beam
    if a.kind == A_BOSS and act.damage * power > player.hp_max * BOSS_ULT_CAP[data.difficulty] do
        # An ultimate hurts, but never more than this share of Scarf's health.
        power = player.hp_max * BOSS_ULT_CAP[data.difficulty] / act.damage
    end
    var wall = lv.world.raycast(ap.Ray(from, way), reach)
    if wall.found do
        reach = wall.distance
    end
    streaks.push(Streak(from, from + way * reach, color, 0.35, 0.35, 0.14))
    for o in targets_of(a) do
        var to = chest_of(o) - from
        var along = to.x * way.x + to.y * way.y + to.z * way.z
        if along < 0 or along > reach do
            continue
        end
        var off = (to - way * along).length()
        if off < 0.7 do
            hurt(o, act.damage * power, act.stun, a.body.position, act.push, act.launch, a, how)
            if a.kind != A_PLAYER do
                break
            end
        end
    end
end

# Earth Spike (and Grave Hands): stone (or hands) bursting up along the ground ahead, and under
# whatever it catches.
class Spike
    ap.Vec3 at
    double delay                     # seconds before it bursts up
    double life
    double span
    double size
    ap.Color color
    bool hand = false
end
Spike[] spikes = []
function raise_spikes(Actor a, roster.Attack act, ap.Color color)
    var hands = act.name == "Grave Hands"
    var ahead = forward_of(a.heading)
    var side = ap.Vec3(ahead.z, 0, -ahead.x)
    var n = int(act.reach / 0.7)
    for k in 1..<(n + 1) do
        var d = double(k) * 0.7
        var at = a.body.position + ahead * d + side * ap.random(-0.25, 0.25)
        var wall = lv.world.raycast(ap.Ray(a.body.position + ap.Vec3(0, 0.5, 0), ahead), d)
        if wall.found do
            break
        end
        spikes.push(Spike(at, d * 0.035, 0.7, 0.7, 0.6 + 0.4 * double(k) / double(n), color, hands))
    end
    for t in targets_of(a) do
        var gap = flat_distance(t.body.position, a.body.position) - t.body.radius
        var off = math.abs(wrap(heading_of(t.body.position - a.body.position) - a.heading))
        if gap <= act.reach and off <= act.arc / 2 + 10 do
            spikes.push(Spike(t.body.position, gap * 0.035, 0.9, 0.9, 1.5, color, hands))
        end
    end
end
function run_spikes()
    var dt = 1.0 / 60
    Spike[] kept = []
    for sp in spikes do
        if sp.delay > 0 do
            sp.delay -= dt
            if sp.delay <= 0 and sp.size > 1.2 do
                burst(sp.at + ap.Vec3(0, 0.2, 0), 10, sp.color, 3, 0.5, 0.08)
            end
        else do
            sp.life -= dt
        end
        if sp.life > 0 do
            kept.push(sp)
        end
    end
    spikes = kept
end
function draw_spikes(puppet.Rig r)
    for sp in spikes do
        if sp.delay > 0 do
            continue
        end
        var t = 1 - sp.life / sp.span
        var up = math.min(t / 0.18, 1.0) * (1 - math.max((t - 0.7) / 0.3, 0.0))
        var h = sp.size * 1.3 * up
        if h <= 0.02 do
            continue
        end
        if sp.hand do
            # A grasping hand of bone.
            var bone = ap.Color(200, 205, 180)
            ap.draw(r.sleeve, sp.at + ap.Vec3(0, h * 0.4, 0), bone, ap.Vec3(0, sp.at.x * 40, 0), ap.Vec3(0.18, h * 0.8, 0.18) * sp.size)
            for f in 0..<4 do
                ap.draw(r.blade, sp.at + ap.Vec3((double(f) - 1.5) * 0.08 * sp.size, h * 0.85, 0), bone, ap.Vec3(0, 0, (double(f) - 1.5) * 12), ap.Vec3(0.05, 0.3, 0.05) * sp.size)
            end
        else do
            var stone = ap.Color(150, 128, 100).lerp(sp.color, 0.3)
            ap.draw(r.spike, sp.at + ap.Vec3(0, h / 2, 0), stone, ap.Vec3(0, sp.at.z * 50, 0), ap.Vec3(0.5 * sp.size, h, 0.5 * sp.size))
            ap.draw(r.spike, sp.at + ap.Vec3(0.2 * sp.size, h * 0.3, 0.1), stone.brightness(0.8), ap.Vec3(10, sp.at.x * 60, 14), ap.Vec3(0.3 * sp.size, h * 0.6, 0.3 * sp.size))
            ap.draw(r.soft, sp.at + ap.Vec3(0, 0.04, 0), stone.brightness(0.6), ap.Vec3(0, sp.at.x * 30, 0), ap.Vec3(0.9 * sp.size, 0.08, 0.9 * sp.size))
        end
    end
end

function muzzle(ap.Vec3 from, ap.Vec3 aim)
    for k in 0..<6 do
        motes.push(Mote(from, (aim + ap.Vec3(ap.random(-0.3, 0.3), ap.random(-0.3, 0.3), ap.random(-0.3, 0.3))) * ap.random(3, 7),
            ap.Color(255, 220, 140), 0.12, 0.12, 0.08))
    end
end

# A gunshot (or a scream) wakes everything near enough to hear it.
function noise(ap.Vec3 at, double far)
    for f in foes do
        if alive(f) and flat_distance(f.body.position, at) < far and not f.aware do
            notice(f)
        end
    end
end

function notice(Actor f)
    if f.aware do
        return
    end
    f.aware = true
    f.unseen = 0
    f.think = int(ap.random(10, 40))
    float_text(chest_of(f) + ap.Vec3(0, 0.6, 0), "!", ap.Color(255, 90, 70))
    var cry = SND_GROWL
    if f.kind == A_WRAITH do
        cry = SND_HISS
    else if f.kind == A_SKELETON or f.kind == A_ARCHER do
        cry = SND_CREAK
    else if f.kind == A_GHOUL do
        cry = SND_HISS
    end
    sfx_at(cry, f.body.position, 0.6, 1.0 if f.kind != A_GHOUL else 1.4)
    # Its neighbours hear it.
    for o in foes do
        if alive(o) and not o.aware and flat_distance(o.body.position, f.body.position) < 6 do
            o.aware = true
            o.think = int(ap.random(20, 60))
        end
    end
end

# --- Input -------------------------------------------------------------------------------------

function pressed(int key) returns bool
    return ap.key_pressed(key)
end
function down(int key) returns bool
    return ap.key_down(key)
end

# Where WASD (or the left stick) points, on the ground, from the camera's point of view.
function steer_way() returns ap.Vec3
    var x = 0.0
    var y = 0.0
    if down(ap.KEY_A) do
        x -= 1
    end
    if down(ap.KEY_D) do
        x += 1
    end
    if down(ap.KEY_W) do
        y -= 1
    end
    if down(ap.KEY_S) do
        y += 1
    end
    x += ap.pad_axis(0, 0)
    y += ap.pad_axis(0, 1)
    var a = cam_yaw * math.PI / 180
    var ahead = ap.Vec3(-math.sin(a), 0, -math.cos(a))
    var right = ap.Vec3(math.cos(a), 0, -math.sin(a))
    var v = right * x - ahead * y
    return v * (1 / v.length()) if v.length() > 1 else v
end

function grab_mouse()
    if not mouse_held do
        ap.capture_mouse(true)
        ap.show_cursor(false)
        mouse_held = true
        ap.mouse_delta()
    end
end
function release_mouse()
    if mouse_held do
        ap.capture_mouse(false)
        ap.show_cursor(true)
        mouse_held = false
    end
end

# --- Arena items, bought at shops ----------------------------------------------------------------
# The Arena's built-in items (items.fw) that make sense here: no super bar, no rounds, no combo
# counter. Bought with souls, kept for good, and all of them work at once.
items.ItemDef[] item_defs = []
function item_works(items.ItemDef it) returns bool
    if it.source != items.SOURCE_BUILTIN do
        return false
    end
    int[] no_conditions = [items.W_BEHIND, items.W_AHEAD, items.W_MY_SUPER, items.W_THEIR_SUPER, items.W_EARLY,
        items.W_LATE, items.W_DECIDER, items.W_SUPER_READY, items.W_COMBO]
    int[] no_effects = [items.E_SUPER, items.E_SUPER_HIT, items.E_STEAL, items.E_SUPER_START, items.E_SPAM]
    if has(no_conditions, it.condition) do
        return false
    end
    for e in it.effects do
        if has(no_effects, e.kind) do
            return false
        end
    end
    return true
end
function load_items()
    item_defs = []
    for it in items.builtins() do
        if item_works(it) do
            item_defs.push(it)
        end
    end
end
function owns_item(int def_index) returns bool
    return has(data.items_owned, item_defs[def_index].id)
end
function unowned_items() returns int[]
    int[] out = []
    for k in 0..<item_defs.length do
        if not owns_item(k) do
            out.push(k)
        end
    end
    return out
end
function item_price(int def_index) returns int
    var it = item_defs[def_index]
    return int(double([35, 60, 50][it.tier] + 2 * math.max(lv.index, 0)) * DIFF_PRICES[data.difficulty])
end

# What every item held adds up to right now (items.fw's totals, for Purgatory's situation).
double[] fx = []
var since_parry = 999.0              # seconds
var since_hurt = 999.0
var shield_hp = 0.0                  # SHIELD items: soaked before health, refilled each level
var revive_used = false              # PHOENIX FEATHER: once a level
var ranged_hit = false               # the hit being dealt came from a shot or a ray
function item_fx(int kind) returns double
    return fx[kind] if kind < fx.length else 0.0
end
function update_items()
    int[] held = []
    for k in 0..<item_defs.length do
        if owns_item(k) do
            held.push(k)
        end
    end
    var sit = items.Situation()
    sit.health = player.hp / math.max(player.hp_max, 1.0)
    sit.moving = player.moving > 0.5
    sit.blocking = player.state == S_BLOCK
    sit.since_parry = since_parry
    sit.since_hurt = since_hurt
    sit.bar = stamina / math.max(data.max_stamina, 1.0)
    var t = locked_target()
    if t != null do
        var o = t as Actor
        sit.foe_health = o.hp / math.max(o.hp_max, 1.0)
        sit.foe_poisoned = o.poison > 0
        sit.foe_slowed = o.freeze > 0
        sit.distance = flat_distance(o.body.position, player.body.position)
        sit.behind_foe = math.abs(wrap(heading_of(player.body.position - o.body.position) - o.heading)) > 120
        sit.foe_airborne = o.lift > 0
    end
    fx = items.totals(item_defs, held, sit)
    since_parry += 1.0 / 60
    since_hurt += 1.0 / 60
    # Health and speed follow the items held.
    var top = data.max_health * items.more(item_fx(items.E_HEALTH))
    if math.abs(top - player.hp_max) > 0.01 do
        var share = player.hp / math.max(player.hp_max, 1.0)
        player.hp_max = top
        player.hp = math.min(player.hp_max * share, player.hp_max) if player.hp > 0 else 0.0
    end
    player.speed = 4.8 * items.more(item_fx(items.E_SPEED))
    if item_fx(items.E_REGEN) > 0 and alive(player) do
        player.hp = math.min(player.hp + item_fx(items.E_REGEN) / 60, player.hp_max)
    end
end

# Scarf's hit, with the items: damage, melee or ranged, basic or skill, a critical now and then.
function item_damage(double dmg, Move? how) returns double
    var out = dmg * items.more(item_fx(items.E_DAMAGE))
    out *= items.more(item_fx(items.E_RANGED) if ranged_hit else item_fx(items.E_MELEE))
    out *= items.more(item_fx(items.E_BASIC) if how == null else item_fx(items.E_SKILL))
    if ap.random() * 100 < item_fx(items.E_CRIT) do
        out *= 2
        float_text(chest_of(player) + ap.Vec3(0, 0.8, 0), "CRITICAL", ap.Color(255, 220, 100))
    end
    return out
end

# --- Achievements ----------------------------------------------------------------------------------
# Kept through every run. One earned on HELL burns: it is drawn in red fire.
const string[] ACH_IDS = ["armed", "first_blood", "bookworm", "student", "boss_1", "boss_10", "boss_all",
    "foresight", "revenge_denied", "intermission", "soul_eater", "red_reader", "gambler", "forged", "pact",
    "bounty", "hoarder", "untouched", "ricochet", "gauntlet", "devil", "awake"]
const string[] ACH_NAMES = ["ARMED", "FIRST BLOOD", "BOOKWORM", "STUDENT", "FIRST TO FALL", "TEN DOWN", "THE LAST FIGHTER",
    "FORESIGHT", "REVENGE DENIED", "INTERMISSION", "SOUL EATER", "RED READER", "LUCKY", "TEMPERED", "SIGNED IN BLOOD",
    "BOUNTY HUNTER", "HOARDER", "UNTOUCHED", "TRICK SHOT", "THE GAUNTLET", "THE DEVIL'S DUE", "AWAKE"]
const string[] ACH_NOTES = ["Find THE GUN.", "Kill something.", "Learn an art from a cursed book.", "Learn a stance at a dojo.",
    "Defeat a boss.", "Defeat ten bosses.", "Defeat the last fighter.", "Win a Death Focus as a boss arrives.",
    "Stop a boss coming back for revenge.", "Survive an Intermission.", "Defeat a boss's second phase.",
    "Buy a red book.", "Win a wager with the Gambler.", "Have your weapon infused at a forge.", "Take a pact at a shrine.",
    "Collect a shrine's bounty.", "Hold 1000 souls at once.", "Defeat a boss without being hit.",
    "Hit three enemies with one Ricochet Shot.", "Outlast every boss in the dark.", "Defeat Satan.", "Wake up."]
var ach_banner = 0
var ach_text = ""
var ach_hell = false

function achieved(string id) returns bool
    for a in data.achievements do
        if a == id do
            return true
        end
    end
    return false
end
function achieved_hell(string id) returns bool
    for a in data.achievements_hell do
        if a == id do
            return true
        end
    end
    return false
end
function achieve(string id)
    if data.admin_run do
        return
    end
    var fresh = not achieved(id)
    if fresh do
        data.achievements.push(id)
    end
    var hell_fresh = data.difficulty == DIFF_HELL and not achieved_hell(id)
    if hell_fresh do
        data.achievements_hell.push(id)
    end
    if fresh or hell_fresh do
        for k, a in ACH_IDS do
            if a == id do
                ach_text = ACH_NAMES[k]
            end
        end
        ach_banner = 260
        ach_hell = hell_fresh
        sfx(SND_BELL, 0.5, 1.4)
        sfx(SND_GOLD, 0.35, 1.2)
        store()
    end
end

# --- Pacts (a shrine's) ------------------------------------------------------------------------------
# A boon and a bane, for the rest of the level; or a bounty on every enemy in it.
const string[] PACT_IDS = ["glass", "bloodlust", "greed", "haste", "berserk", "hunt"]
const string[] PACT_NAMES = ["GLASS CANNON", "BLOODLUST", "GREED", "HASTE", "BERSERK", "THE HUNT"]
const string[] PACT_NOTES = ["You deal 60% more damage, and take 50% more.",
    "Every kill heals 10% of your health; your health is capped at 75%.",
    "Kills drop three times the souls; every enemy has 40% more health.",
    "Cooldowns 40% shorter; every move costs 50% more stamina and mana.",
    "Below half health you hit 35% harder and move 25% faster; you cannot block.",
    "A bounty: kill every enemy on the level before the boss's hall and get four times the price back."]
var pact = ""                        # the pact taken on this level, or ""
function pact_is(string id) returns bool
    return pact == id
end
function pick_pacts(Dice d) returns string[]
    var a = d.range(0, PACT_IDS.length - 1)
    var b = d.range(0, PACT_IDS.length - 2)
    if b >= a do
        b += 1
    end
    return [PACT_IDS[a], PACT_IDS[b]]
end
function pact_index(string id) returns int
    for k, p in PACT_IDS do
        if p == id do
            return k
        end
    end
    return 0
end
function pact_price() returns int
    return int(double(40 + 3 * math.max(lv.index, 0)) * (1.0 + 0.2 * double(data.difficulty)))
end
var pact_paid = 0
function take_pact(string id)
    pact = id
    pact_paid = pact_price()
    if id == "greed" do
        for f in foes do
            f.hp *= 1.4
            f.hp_max *= 1.4
        end
    end
    say("PACT: {PACT_NAMES[pact_index(id)]}. {PACT_NOTES[pact_index(id)]}", ap.Color(255, 110, 100), 300)
    sfx(SND_RIFT, 0.6, 0.6)
    sfx(SND_BOOM, 0.4, 0.5)
    achieve("pact")
end
# THE HUNT: paid out on reaching the boss's hall with nothing left alive behind you.
function settle_hunt()
    if not pact_is("hunt") do
        return
    end
    var left = 0
    for f in foes do
        if alive(f) do
            left += 1
        end
    end
    if left == 0 do
        data.souls += pact_paid * 4
        say("BOUNTY COLLECTED: +{pact_paid * 4} SOULS", ap.Color(255, 220, 120), 260)
        sfx(SND_GOLD, 0.6)
        achieve("bounty")
    else do
        say("THE HUNT FAILED: {left} ENEMIES STILL WALK THIS LEVEL", ap.Color(255, 120, 110), 220)
    end
    pact = ""
end

# --- The forge's infusions -------------------------------------------------------------------------
const string[] INFUSE_IDS = ["ember", "frost", "venom", "storm", "soul"]
const string[] INFUSE_NAMES = ["EMBER", "FROST", "VENOM", "STORM", "SOUL"]
const string[] INFUSE_NOTES = ["Its hits set them burning.", "Its hits slow them to a crawl for a moment.",
    "Its hits poison.", "Its hits arc to one more enemy nearby.", "Its hits give 2 mana; its kills drop an extra soul."]
const ap.Color[] INFUSE_COLORS = [ap.Color(255, 140, 50), ap.Color(150, 220, 255), ap.Color(140, 230, 90), ap.Color(190, 190, 255), ap.Color(200, 230, 255)]
function infusion(int weapon) returns string
    for f in data.infusions do
        var parts = f.split(":")
        if int(parts[0]) == weapon do
            return parts[1]
        end
    end
    return ""
end
function infuse(int weapon, string kind)
    string[] kept = []
    for f in data.infusions do
        if int(f.split(":")[0]) != weapon do
            kept.push(f)
        end
    end
    kept.push("{weapon}:{kind}")
    data.infusions = kept
    store()
end
function infuse_price() returns int
    return int(double(80 + 4 * math.max(lv.index, 0)) * DIFF_PRICES[data.difficulty] / 2)
end
function weapon_name(int weapon) returns string
    return WEAPON_NAMES[weapon] if weapon >= 0 else "FISTS"
end

# --- The Gambler --------------------------------------------------------------------------------------
function gamble_rows(Spot sp) returns string[]
    var dice = "THE BONE DICE  -  40 SOULS" if not has_word(sp.offer, "dice") else "THE BONE DICE  -  ROLLED"
    var box = "MYSTERY BOX  -  {box_price()} SOULS" if not has_word(sp.offer, "box") else "MYSTERY BOX  -  OPENED"
    return ["DOUBLE OR NOTHING  -  WAGER 25", "DOUBLE OR NOTHING  -  WAGER HALF YOUR SOULS", dice, box, "LEAVE"]
end
function box_price() returns int
    return int(double(60 + 3 * math.max(lv.index, 0)) * DIFF_PRICES[data.difficulty] / 2)
end
function has_word(string[] list, string word) returns bool
    for w in list do
        if w == word do
            return true
        end
    end
    return false
end
var gamble_said = ""
function gamble(Spot sp, int row)
    if row == 0 or row == 1 do
        var stake = 25 if row == 0 else data.souls // 2
        if stake <= 0 or data.souls < stake or (row == 0 and data.souls < 25) do
            gamble_said = "NOT ENOUGH SOULS TO WAGER"
            sfx(SND_DENY, 0.45)
            return
        end
        sfx(SND_COIN_A, 0.5)
        sfx(SND_COINS, 0.4, 1.2)
        if ap.random() < 0.48 do
            data.souls += stake
            gamble_said = "HEADS. YOU WIN {stake} SOULS."
            sfx(SND_GOLD, 0.5)
            achieve("gambler")
        else do
            data.souls -= stake
            gamble_said = "TAILS. THE GAMBLER KEEPS {stake} SOULS."
            sfx(SND_DENY, 0.35, 0.8)
        end
    else if row == 2 do
        if has_word(sp.offer, "dice") do
            gamble_said = "THE DICE ARE ROLLED ONCE A VISIT"
            return
        end
        if data.souls < 40 do
            gamble_said = "NOT ENOUGH SOULS"
            sfx(SND_DENY, 0.45)
            return
        end
        data.souls -= 40
        sp.offer.push("dice")
        var roll = 1 + int(ap.random(0, 5.999))
        sfx(SND_CLASH_B, 0.4, 1.6)
        if roll == 1 do
            var cost = player.hp_max * 0.15
            player.hp = math.max(player.hp - cost, 1.0)
            gamble_said = "A ONE. SNAKE EYES: THE BONES BITE ({int(cost)} HP)."
            sfx(SND_BITE, 0.5)
        else if roll == 2 do
            gamble_said = "A TWO. NOTHING."
        else if roll == 3 or roll == 4 do
            var win = 30 * (roll - 2)
            data.souls += win
            gamble_said = "A {["", "", "", "THREE", "FOUR"][roll]}: +{win} SOULS."
            sfx(SND_COINS, 0.5)
        else if roll == 5 do
            player.hp = math.min(player.hp + player.hp_max * 0.25, player.hp_max)
            stamina = data.max_stamina
            mana = data.max_mana
            gamble_said = "A FIVE: HEALED, STAMINA AND MANA FULL."
            sfx(SND_HEAL, 0.5)
        else do
            gamble_said = "A SIX: AN UPGRADE, FREE."
            make_offers()
            upgrade_wait = 2
            sfx(SND_GOLD, 0.6)
        end
    else if row == 3 do
        if has_word(sp.offer, "box") do
            gamble_said = "THE BOX IS EMPTY NOW"
            return
        end
        var price = box_price()
        if data.souls < price do
            gamble_said = "NOT ENOUGH SOULS"
            sfx(SND_DENY, 0.45)
            return
        end
        data.souls -= price
        sp.offer.push("box")
        sfx(SND_CREAK, 0.5, 1.3)
        int[] lacking = []
        for w in 1..<WEAPON_NAMES.length do
            if not has(data.weapons, w) do
                lacking.push(w)
            end
        end
        var pool = unowned_items()
        var roll = ap.random()
        if roll < 0.3 and lacking.length > 0 do
            take_weapon(lacking[int(ap.random(0, double(lacking.length) - 0.001))])
            gamble_said = "INSIDE: A WEAPON."
        else if roll < 0.7 and pool.length > 0 do
            var k = pool[int(ap.random(0, double(pool.length) - 0.001))]
            data.items_owned.push(item_defs[k].id)
            update_items()
            gamble_said = "INSIDE: {item_defs[k].name}."
            sfx(SND_GOLD, 0.5)
        else if roll < 0.85 do
            data.souls += price * 2
            gamble_said = "INSIDE: {price * 2} SOULS."
            sfx(SND_COINS, 0.5)
        else do
            gamble_said = "INSIDE: MOTHS. ONLY MOTHS."
            sfx(SND_WISP, 0.4, 1.4)
        end
    end
    store()
end

# --- Upgrades (one chosen after each boss) ---------------------------------------------------------
const string[] UPGRADE_KINDS = ["power", "thrift", "haste"]
const string[] UPGRADE_WORDS = ["+20% DAMAGE", "-20% COST", "-25% COOLDOWN"]
const double UPGRADE_POWER = 0.2
const double UPGRADE_THRIFT = 0.8
const double UPGRADE_HASTE = 0.75

function upgrade_count(string key) returns int
    var n = 0
    for u in data.upgrades do
        if u == key do
            n += 1
        end
    end
    return n
end
# A move with every upgrade taken for what it belongs to (`owner`: "stance:2", "art:0", "arms:-1").
function upgraded(Move m, string owner) returns Move
    var power = upgrade_count("{owner}:power")
    var thrift = upgrade_count("{owner}:thrift")
    var haste = upgrade_count("{owner}:haste")
    m.a.damage *= 1 + UPGRADE_POWER * double(power)
    m.st *= math.pow(UPGRADE_THRIFT, double(thrift))
    m.mn *= math.pow(UPGRADE_THRIFT, double(thrift))
    m.cooldown = int(double(m.cooldown) * math.pow(UPGRADE_HASTE, double(haste)))
    return m
end
function owner_name(string owner) returns string
    var parts = owner.split(":")
    var id = int(parts[1])
    if parts[0] == "stance" do
        return "STANCE: " + STANCE_NAMES[id]
    else if parts[0] == "art" do
        return "ART: " + art_name(id)
    end
    return "ARMAMENT: " + (WEAPON_NAMES[id] if id >= 0 else "FISTS")
end

string[] offers = []                 # the three upgrades on offer: "owner:kind"
function make_offers()
    offers = []
    string[] owners = ["stance:{data.stance}"]
    int[] equipped = []
    for a in data.art_slots do
        if a >= 0 do
            equipped.push(a)
        end
    end
    if equipped.length > 0 do
        owners.push("art:{equipped[int(ap.random(0, double(equipped.length) - 0.001))]}")
    end
    owners.push("arms:{data.weapon}")
    while owners.length < 3 do
        owners.push(owners[int(ap.random(0, double(owners.length) - 0.001))])
    end
    for o in owners do
        var kind = UPGRADE_KINDS[int(ap.random(0, 2.999))]
        # The same thing twice gets a different kind of upgrade.
        for prev in offers do
            if prev == "{o}:{kind}" do
                kind = UPGRADE_KINDS[0] if kind != UPGRADE_KINDS[0] else UPGRADE_KINDS[1]
            end
        end
        offers.push("{o}:{kind}")
    end
end
# Where an upgrade card sits: the cards on offer centred on the screen.
function offer_x(int k) returns double
    return 110 + double(3 - offers.length) * 72.5 + double(k) * 145
end
function offer_words(string offer) returns string
    var parts = offer.split(":")
    for k, kind in UPGRADE_KINDS do
        if kind == parts[2] do
            return UPGRADE_WORDS[k]
        end
    end
    return ""
end

function menu_moves(int m) returns Move[]
    if m == MENU_STANCE do
        Move[] out = []
        for mv in stance_moves(data.stance) do
            out.push(upgraded(mv, "stance:{data.stance}"))
        end
        return out
    else if m == MENU_ART do
        Move[] arts = []
        for slot in data.art_slots do
            arts.push(upgraded(art_move(slot), "art:{slot}") if slot >= 0 else Move(""))
        end
        return arts
    else if m == MENU_ARMAMENT do
        Move[] out = []
        for mv in weapon_moves(data.weapon) do
            out.push(upgraded(mv, "arms:{data.weapon}"))
        end
        return out
    end
    if data.difficulty == DIFF_EASY do
        return [Move(FOCUS_NAMES[focus_context()]), Move("RECOVERY FOCUS"), Move("BANDAGE" if not bandage_used else "BANDAGE (USED)"), Move("SOULS FOCUS")]
    end
    return [Move(FOCUS_NAMES[focus_context()]), Move("STAMINA FOCUS"), Move("MANA FOCUS"), Move("SOULS FOCUS")]
end

function focus_context() returns int
    if boss_phase == BP_WAIT or revenge_state == 2 or near_kneeler() or final_phase == FP_SATAN_DOWN do
        return FOCUS_DEATH
    end
    if alerted or combat_lock do
        return FOCUS_COMBAT
    end
    return FOCUS_TREASURE
end

function deny(string words)
    sfx(SND_DENY, 0.35)
    float_text(chest_of(player) + ap.Vec3(0, 0.5, 0), words, ap.Color(200, 190, 210))
end

# Z / X / C / V: switch straight to a menu (its own letter again: back to none). Each has a look:
# a fighting stance, a glow of mana, the weapon drawn, a kneel.
const string[] MENU_KEYS = ["", "Z", "X", "C", "V"]
function pick_menu(int m)
    if menu == m do
        menu = MENU_ROOT
        sfx(SND_MOVE, 0.3, 0.85)
        return
    end
    menu = m
    sfx(SND_MOVE, 0.3, 1.1)
    if m == MENU_ART do
        burst(chest_of(player), 10, ap.Color(120, 170, 255), 2.5)
        sfx(SND_SHIMMER, 0.3, 1.3)
    else if m == MENU_ARMAMENT and data.weapon >= 0 do
        sfx(SND_UNSHEATHE, 0.4, 1.1)
    else if m == MENU_REFLEX or m == MENU_STANCE do
        sfx(SND_CLOTH, 0.35, 1.0 if m == MENU_REFLEX else 1.3)
    end
end

# 1-4: use that move of the open menu.
function number_key(int slot)
    if menu == MENU_ROOT do
        deny("PICK A MENU FIRST: Z STANCE, X ART, C ARMAMENT, V REFLEX")
        return
    end
    if menu == MENU_REFLEX do
        if slot == 3 do
            start_focus(FOCUS_EXTRACT)
        else if data.difficulty == DIFF_EASY and slot == 2 do
            use_bandage()
        else if data.difficulty == DIFF_EASY and slot == 1 do
            start_focus(FOCUS_RECOVER)
        else do
            start_focus(focus_context() if slot == 0 else (FOCUS_STAMINA if slot == 1 else FOCUS_MANA))
        end
        return
    end
    var m = menu_moves(menu)[slot]
    if m.name == "" do
        deny("NO ART HERE: READ A CURSED BOOK")
        return
    end
    var cool_slot = menu * 4 + slot
    if cools[cool_slot] > 0 do
        deny("NOT READY")
        return
    end
    var st = m.st * (1.5 if pact_is("haste") else 1.0) * (0.67 if m.src == SRC_STANCE and warcry_time > 0 else 1.0)
    var mn = m.mn * (1.5 if pact_is("haste") else 1.0)
    if stamina < st do
        deny("NOT ENOUGH STAMINA")
        return
    end
    if mana < mn do
        deny("NOT ENOUGH MANA")
        return
    end
    if m.ammo != 0 and data.weapon == 0 do
        var need = 1 if m.ammo < 0 else m.ammo
        if reload_ticks > 0 or ammo < need do
            deny("RELOAD FIRST" if reload_ticks <= 0 else "RELOADING")
            if reload_ticks <= 0 and ammo < 6 do
                start_reload()
            end
            return
        end
    end
    if player.state != S_IDLE and player.state != S_BLOCK do
        return
    end
    cancel_reload()
    stamina -= st
    mana -= mn
    if m.ammo != 0 and data.weapon == 0 do
        if m.ammo < 0 do
            m.a.hits = ammo
            ammo = 0
        else do
            ammo -= m.ammo
        end
    end
    if m.src == SRC_ART do
        # Arts hit harder the fuller your mana was.
        m.a.damage *= 0.8 + 0.5 * math.clamp((mana + mn) / math.max(data.max_mana, 1.0), 0.0, 1.0)
    end
    cools[cool_slot] = int(double(m.cooldown) * items.less(item_fx(items.E_COOLDOWN)) * (0.6 if pact_is("haste") else 1.0))
    begin(player, m.a, m)
end

# The gun's reload: long, and cancelled by a dash, a block or a move (the rounds stay spent).
function start_reload()
    if data.weapon != 0 or reload_ticks > 0 or ammo >= 6 do
        return
    end
    reload_ticks = RELOAD_TICKS
    sfx(SND_EMPTY, 0.5)
    sfx(SND_LATCH, 0.4, 0.8)
end
function cancel_reload()
    if reload_ticks > 0 do
        reload_ticks = 0
        float_text(chest_of(player) + ap.Vec3(0, 0.5, 0), "RELOAD CANCELLED", ap.Color(200, 190, 210))
    end
end
function run_reload()
    if reload_ticks <= 0 do
        return
    end
    reload_ticks -= 1
    var t = RELOAD_TICKS - reload_ticks
    if t == 15 do
        # The empties tumble out.
        for k in 0..<6 do
            sfx_at(SND_CASING, player.body.position, 0.25, ap.random(0.9, 1.25))
        end
    else if t == 30 or t == 38 or t == 45 do
        sfx(SND_RELOAD, 0.3, 1.1)
    end
    if reload_ticks == 0 do
        ammo = 6
        sfx(SND_LATCH, 0.5)
    end
end

var bandage_used = false             # EASY: the bandage, once a level
var closed_at = -1                   # the tick a menu was last shut (its key does nothing else that tick)
var upgrade_wait = 0                 # ticks after a boss falls before its reward is offered
var upgrade_picks = 1                # how many of the offers to take (two after a revenge)

function use_bandage()
    if bandage_used do
        deny("THE BANDAGE IS USED UP UNTIL THE NEXT LEVEL")
        return
    end
    if player.hp >= player.hp_max do
        deny("ALREADY AT FULL HEALTH")
        return
    end
    data.souls -= soul_cost(BANDAGE_SOULS)
    bandage_used = true
    var heal = player.hp_max * BANDAGE_HEAL
    player.hp = math.min(player.hp + heal, player.hp_max)
    float_text(chest_of(player), "+{int(heal)}", ap.Color(120, 230, 140))
    burst(chest_of(player), 16, ap.Color(120, 230, 140), 2.5)
    sfx(SND_CLOTH, 0.5)
    sfx(SND_HEAL, 0.5)
end

function start_focus(int kind)
    if player.state != S_IDLE do
        return
    end
    if kind == FOCUS_DEATH do
        if final_phase != FP_SATAN_DOWN do
            data.souls -= soul_cost(FOCUS_PRICE[FOCUS_DEATH])
        end
        if final_phase == FP_SATAN_DOWN do
            begin_qte(QP_SATAN)
        else if revenge_state == 2 do
            begin_qte(QP_REVENGE)
        else if near_kneeler() do
            begin_qte(QP_KNEEL)
        else if boss_phase == BP_WAIT do
            begin_qte(QP_ENTRANCE)
        end
        return
    end
    if (kind == FOCUS_TREASURE or kind == FOCUS_COMBAT) and focus_cool > 0 do
        deny("FOCUS IS COOLING DOWN")
        return
    end
    if kind == FOCUS_EXTRACT and player.hp <= player.hp_max * EXTRACT_FLOOR + 1 do
        deny("TOO WEAK TO GIVE UP ANY MORE")
        return
    end
    if kind == FOCUS_COMBAT and mana < 10 do
        deny("NOT ENOUGH MANA")
        return
    end
    data.souls -= soul_cost(FOCUS_PRICE[kind])
    player.state = S_FOCUS
    player.focus = kind
    player.focus_ticks = 0
    sfx(SND_CHARGE, 0.4, 0.8 if kind >= FOCUS_STAMINA else 1.0)
    if kind == FOCUS_COMBAT do
        mana -= 10
    end
end

function run_focus()
    player.focus_ticks += 1
    var k = player.focus
    if k == FOCUS_TREASURE or k == FOCUS_COMBAT do
        if player.focus_ticks == 30 do
            focus_kind = k
            focus_left = 600 if k == FOCUS_TREASURE else 480
            focus_cool = 900 if k == FOCUS_TREASURE else 600
            burst(chest_of(player), 20, ap.Color(255, 220, 140) if k == FOCUS_TREASURE else ap.Color(255, 90, 90), 4)
            sfx(SND_FLASH, 0.5, 1.2 if k == FOCUS_TREASURE else 0.9)
            player.state = S_IDLE
        end
        return
    end
    var moved = steer_way().length() > 0.2
    if k == FOCUS_EXTRACT do
        # Souls focus: rooted, tearing souls out of yourself; every pull costs health.
        if ticks % 4 == 0 do
            var a = ap.random(0, 2 * math.PI)
            motes.push(Mote(chest_of(player) + ap.Vec3(math.sin(a) * 0.3, 0, math.cos(a) * 0.3), ap.Vec3(math.sin(a) * 0.6, 1.8, math.cos(a) * 0.6), ap.Color(200, 230, 255), 0.9, 0.9, 0.08))
        end
        if player.focus_ticks % EXTRACT_EVERY == 0 do
            var cost = player.hp_max * EXTRACT_HP
            if player.hp - cost < player.hp_max * EXTRACT_FLOOR do
                player.state = S_IDLE
                deny("TOO WEAK TO GIVE UP ANY MORE")
                return
            end
            player.hp -= cost
            player.flash = 0.6
            var gain = EXTRACT_SOULS + (lv.index if lv.index > 0 else 0) // 3
            data.souls += gain
            float_text(chest_of(player), "+{gain} SOULS", ap.Color(200, 230, 255))
            sfx(SND_WISP, 0.35, 1.2)
            sfx(SND_HIT, 0.2, 0.7)
        end
        if moved or player.focus_ticks > 600 do
            player.state = S_IDLE
        end
        return
    end
    # Stamina and mana focus: breathe, rooted, until full, moved, or out of breath.
    if k == FOCUS_STAMINA or k == FOCUS_RECOVER do
        stamina = math.min(stamina + 45.0 / 60, data.max_stamina)
    end
    if k == FOCUS_MANA or k == FOCUS_RECOVER do
        mana = math.min(mana + 28.0 / 60, data.max_mana)
    end
    if player.focus_ticks % 50 == 1 do
        sfx(SND_HEAL, 0.3, 1.1 if k == FOCUS_STAMINA else 0.8)
    end
    if ticks % 6 == 0 do
        var c = ap.Color(120, 230, 140) if k == FOCUS_STAMINA else ap.Color(120, 170, 255)
        var a = ap.random(0, 2 * math.PI)
        motes.push(Mote(player.body.position + ap.Vec3(math.sin(a) * 1.2, 0.1, math.cos(a) * 1.2), ap.Vec3(-math.sin(a) * 1.0, 1.4, -math.cos(a) * 1.0), c, 0.8, 0.8, 0.07))
    end
    var full = stamina >= data.max_stamina if k == FOCUS_STAMINA else mana >= data.max_mana
    if k == FOCUS_RECOVER do
        full = stamina >= data.max_stamina and mana >= data.max_mana
    end
    if moved or full or player.focus_ticks > 240 do
        player.state = S_IDLE
    end
end

# --- Scarf ---------------------------------------------------------------------------------------

function control_player()
    var p = player
    if not alive(p) do
        return
    end
    if boss_phase == BP_ARRIVE do
        # The entrance plays out: Scarf turns to face it and waits.
        if bosses.length > 0 do
            p.heading = p.heading + math.clamp(wrap(heading_of(flat(bosses[0].body.position - p.body.position)) - p.heading), -8.0, 8.0)
        end
        if p.state != S_HURT do
            p.state = S_IDLE
        end
        move_actor(p, ap.Vec3(0, 0, 0))
        return
    end
    if overlay != O_NONE or qte_on or soul_show > 0 do
        # A menu open, or a Death Focus going: none of the keys do anything else.
        if p.state == S_BLOCK do
            p.state = S_IDLE
        end
        move_actor(p, ap.Vec3(0, 0, 0))
        return
    end
    if closed_at == ticks do
        # A menu was shut by a key this very tick: that key does nothing more.
        move_actor(p, ap.Vec3(0, 0, 0))
        return
    end
    for k in 0..<4 do
        if pressed([ap.KEY_Z, ap.KEY_X, ap.KEY_C, ap.KEY_V][k]) do
            pick_menu(k + 1)
        end
        if pressed([ap.KEY_1, ap.KEY_2, ap.KEY_3, ap.KEY_4][k]) do
            number_key(k)
        end
    end
    if pressed(ap.KEY_E) do
        open_overlay(O_INVENTORY)
        return
    end
    if pressed(ap.KEY_ESCAPE) do
        if menu != MENU_ROOT do
            menu = MENU_ROOT
            sfx(SND_MOVE, 0.3, 0.85)
            return
        end
        open_overlay(O_PAUSE)
        return
    end
    var way = steer_way()
    var wish = way * p.speed
    if reload_ticks > 0 do
        wish = wish * 0.6
    end
    if pact_is("berserk") and p.hp < p.hp_max * 0.5 do
        wish = wish * 1.25
    end
    if boss_in_super() do
        var sb = super_boss()
        if sb != null and kit_of(sb as Actor).maximum.foe_slowmo > 1 do
            wish = wish * 0.65
        end
    end
    if p.state == S_FOCUS do
        run_focus()
        wish = ap.Vec3(0, 0, 0)
    else if p.state == S_HURT do
        p.stun -= 1
        wish = ap.Vec3(0, 0, 0)
        if p.stun <= 0 do
            p.state = S_IDLE
        end
    else if p.state == S_ATTACK do
        run_attack(p)
        wish = wish * 0.15
    else if p.state == S_DASH do
        wish = ap.Vec3(0, 0, 0)
        if p.dash_ticks <= 0 do
            p.state = S_IDLE
        end
    else do
        if down(ap.KEY_F) and not pact_is("berserk") do
            if p.state != S_BLOCK do
                p.state = S_BLOCK
                p.block_ticks = 0
                cancel_reload()
            end
            p.block_ticks += 1
            wish = wish * 0.35
        else if p.state == S_BLOCK do
            p.state = S_IDLE
        end
        if pressed(ap.KEY_Q) and p.state == S_IDLE do
            var dash_cost = 15 * items.less(item_fx(items.E_DASH))
            if stamina >= dash_cost do
                stamina -= dash_cost
                cancel_reload()
                var dir = way if way.length() > 0.2 else forward_of(p.heading) * -1
                p.state = S_DASH
                sfx(SND_WHOOSH_LONG, 0.45)
                p.dash_way = unit(dir) * 12.5
                p.dash_ticks = 10
                p.iframes = 9
            else do
                deny("NOT ENOUGH STAMINA")
            end
        end
        if pressed(ap.KEY_R) and p.state == S_IDLE do
            basic_attack()
        end
    end
    # Facing: where you walk, or at what you are fighting.
    var t = locked_target()
    if p.state == S_IDLE or p.state == S_BLOCK or p.state == S_FOCUS do
        if t != null do
            var want = heading_of(flat((t as Actor).body.position - p.body.position))
            p.heading = p.heading + math.clamp(wrap(want - p.heading), -10.0, 10.0)
        else if way.length() > 0.2 do
            p.heading = p.heading + math.clamp(wrap(heading_of(way) - p.heading), -14.0, 14.0)
        end
    end
    var before = p.body.position
    move_actor(p, wish)
    if lv.index < 0 do
        walked += flat_distance(p.body.position, before)
    end
end

function basic_attack()
    var a = weapon_basic(data.weapon)
    a.damage *= 1 + UPGRADE_POWER * double(upgrade_count("arms:{data.weapon}:power"))
    if data.weapon == 0 do
        if reload_ticks > 0 do
            return
        end
        if ammo <= 0 do
            start_reload()
            return
        end
        ammo -= 1
        begin(player, a, null)
        if ammo == 0 do
            start_reload()
        end
        return
    end
    # Melee basics chain: the third in a row hits harder.
    if player.chain_wait <= 0 do
        player.chain = 0
    end
    if player.chain == 2 do
        a.damage *= 1.6
        a.stun += 8
        a.push += 2
        a.anim = roster.ANIM_SLAM
    else if player.chain == 1 do
        a.anim = roster.ANIM_BACKSWING
    end
    player.chain = (player.chain + 1) % 3
    player.chain_wait = attack_length(a) + 18
    begin(player, a, null)
end

# The enemy the camera holds on: the nearest boss, else the nearest that knows you are there.
function locked_target() returns Actor?
    Actor? best = null
    var near = 30.0
    for b in bosses do
        if alive(b) and b.fade > 0.3 and b.state != S_KNEEL and (b.role != ROLE_GAUNTLET or final_phase == FP_GAUNTLET) do
            var d = flat_distance(b.body.position, player.body.position)
            if d < near do
                near = d
                best = b
            end
        end
    end
    if best != null do
        return best
    end
    for f in foes do
        if alive(f) and f.aware do
            var d = flat_distance(f.body.position, player.body.position)
            if d < near do
                near = d
                best = f
            end
        end
    end
    return best
end

# One tick of a body: walking, dashing, being knocked about and thrown up, burning.
function move_actor(Actor a, ap.Vec3 wish)
    var dt = 1.0 / 60
    var v = wish
    if a.freeze > 0 do
        v = v * 0.3
    end
    if a.dash_ticks > 0 do
        v = a.dash_way
        a.dash_ticks -= 1
    end
    v = v + a.knock
    a.knock = a.knock * 0.84
    a.body.move(lv.world, ap.Vec3(v.x * dt, -0.05, v.z * dt))
    if a.lift > 0 or a.lift_speed > 0 do
        a.lift_speed -= 22 * dt
        a.lift += a.lift_speed * dt
        if a.lift <= 0 do
            a.lift = 0
            a.lift_speed = 0
        end
    end
    var speed = flat(v).length()
    a.moving = ap.approach(a.moving, 1.0 if speed > 0.5 and a.state != S_ATTACK else 0.0, 0.12)
    a.cycle += speed * dt * 2.3
    # The legs swing with sin(cycle) (puppet.fw): a foot comes down at each end of the swing, once
    # every half turn of the cycle.
    var step = int(math.floor((a.cycle - math.PI / 2) / math.PI))
    if step != a.last_step do
        a.last_step = step
        if a.moving > 0.4 and a.lift <= 0 and not a.hovering and alive(a) do
            if a.kind == A_PLAYER do
                sfx(SND_STEP, 0.22, ap.random(0.9, 1.1))
            else if flat_distance(a.body.position, player.body.position) < 14 do
                # The dead shuffle; bones clack; a boss strides.
                var k = SND_CLOTH if a.kind == A_ZOMBIE else SND_STEP
                var pitch = 1.5 if a.kind == A_SKELETON or a.kind == A_ARCHER else (0.75 if a.kind == A_BOSS else 0.9)
                sfx_at(k, a.body.position, 0.25 if a.kind != A_BOSS else 0.4, pitch)
            end
        end
    end
    for kind_of in 0..<3 do
        var left = [a.burn, a.freeze, a.poison][kind_of]
        if left > 0 do
            if kind_of != 1 and alive(a) do
                a.hp -= (3.0 if kind_of == 0 else 2.0) * dt * (0.5 if a.kind == A_PLAYER else (2.5 if kind_of == 2 and venom_time > 0 else 1.0))
                if a.hp <= 0 do
                    die(a)
                end
            end
            if ticks % 8 == 0 do
                var c = [ap.Color(255, 130, 40), ap.Color(160, 220, 255), ap.Color(140, 230, 90)][kind_of]
                motes.push(Mote(chest_of(a) + ap.Vec3(ap.random(-0.3, 0.3), ap.random(-0.5, 0.4), ap.random(-0.3, 0.3)), ap.Vec3(0, 1.2, 0), c, 0.5, 0.5, 0.06))
            end
        end
    end
    a.burn = math.max(a.burn - dt, 0.0)
    a.freeze = math.max(a.freeze - dt, 0.0)
    a.poison = math.max(a.poison - dt, 0.0)
    a.armor_time = math.max(a.armor_time - dt, 0.0)
    a.sunder = math.max(a.sunder - dt, 0.0)
    a.guard_time = math.max(a.guard_time - dt, 0.0)
    a.flash = math.max(a.flash - 0.08, 0.0)
    if a.iframes > 0 do
        a.iframes -= 1
    end
    if a.chain_wait > 0 do
        a.chain_wait -= 1
    end
    spring(a)
end

function spring(Actor a)
    var action = puppet.ACT_IDLE
    var anim = 0
    var phase_at = 0.0
    var beat = 0
    if a.state == S_ATTACK do
        action = puppet.ACT_ATTACK
        anim = a.act.anim
        phase_at = attack_phase(a.act, a.frame)
        beat = math.max(a.struck_beat, 0)
    else if a.state == S_BLOCK do
        action = puppet.ACT_BLOCK
    else if a.state == S_HURT do
        action = puppet.ACT_HURT if a.lift <= 0 else puppet.ACT_AIR
        phase_at = 1 - double(a.stun) / double(math.max(a.stun_total, 1))
    else if a.state == S_DEAD do
        action = puppet.ACT_DOWN
        phase_at = math.min(double(a.frame) / 26, 1.0)
        a.frame += 1
    else if a.state == S_DASH do
        action = puppet.ACT_DASH
    else if a.state == S_FOCUS do
        action = puppet.ACT_ATTACK
        anim = roster.ANIM_FOCUS
        phase_at = math.min(double(a.focus_ticks) / 30, 1.0) + (1.0 if a.focus_ticks > 30 else 0.0)
    end
    if a.kind == A_PLAYER and reload_ticks > 0 and a.state == S_IDLE do
        # Reloading: the cylinder out, the rounds thumbed in.
        action = puppet.ACT_ATTACK
        anim = roster.ANIM_TWIRL
        phase_at = 0.3 + 0.5 * double(RELOAD_TICKS - reload_ticks) / double(RELOAD_TICKS)
    end
    var kneeling = false
    if a.kind == A_PLAYER do
        var drawn = menu == MENU_ARMAMENT or reload_ticks > 0 or (a.state == S_ATTACK and (a.skill.name == "" or a.skill.src == SRC_ARMS))
        a.look.weapon = WEAPON_LOOKS[data.weapon] if data.weapon >= 0 and drawn else roster.WEAPON_HANDS
        if a.state == S_IDLE and reload_ticks <= 0 and a.moving < 0.3 do
            if menu == MENU_STANCE do
                # Z: a fighting stance, guard up.
                action = puppet.ACT_ATTACK
                anim = roster.ANIM_COUNTER
                phase_at = 0.5
            else if menu == MENU_REFLEX do
                kneeling = true          # V: down on one knee (posed below)
            end
        end
        if menu == MENU_ART and a.fade > 0.5 do
            # X: mana rising off you, a glow all over.
            for n in 0..<2 do
                var ang = ap.random(0, 2 * math.PI)
                var rr = ap.random(0.2, 0.45)
                motes.push(Mote(a.body.position + ap.Vec3(math.sin(ang) * rr, ap.random(0.05, 1.7), math.cos(ang) * rr), ap.Vec3(0, ap.random(0.5, 1.3), 0), ap.Color(110, 160, 255).lerp(ap.WHITE, ap.random(0, 0.5)), 0.8, 0.8, ap.random(0.06, 0.12)))
            end
        end
    end
    if a.state == S_KNEEL do
        action = puppet.ACT_ATTACK
        anim = roster.ANIM_PLANT
        phase_at = 1.5
        beat = 0
    end
    if a.kind == A_BOSS and a.super_cast > 0 do
        # Its super coming on: its own cutscene's pose.
        var t = 120.0 - double(a.super_cast)
        action = puppet.ACT_ATTACK
        anim = kit_of(a).maximum.anim
        phase_at = math.clamp(t / 90, 0.0, 1.0) + math.clamp((t - 90) / 12, 0.0, 1.0)
        beat = 1
    end
    if a.kind == A_BOSS and a.role == ROLE_GAUNTLET and final_phase == FP_ARMY and final_ticks > ARMY_SHOT * 2 + 40 do
        # The last shot: all of them at once, in their entrance poses.
        action = puppet.ACT_ATTACK
        anim = kit_of(a).maximum.anim
        phase_at = 1.2
        beat = 1
    end
    if a.kind == A_BOSS and boss_phase == BP_ARRIVE and a.role == ROLE_MAIN do
        # Its own super's pose (the Arena's cutscene): a long wind-up, the moment, a held finish.
        var t = double(boss_ticks) - 50
        action = puppet.ACT_ATTACK
        anim = kit_of(a).maximum.anim
        phase_at = math.clamp(t / 110, 0.0, 1.0) + math.clamp((t - 110) / 16, 0.0, 1.0) + math.clamp((t - 126) / 120, 0.0, 0.5)
        beat = 1
    end
    var target = puppet.make_pose(a.look, action, anim, phase_at, beat, a.cycle, a.moving, double(ticks) / 60 + double(a.kind) * 1.3, 1)
    if kneeling do
        # One knee down: the right foot planted ahead, the left knee and shin on the floor.
        target.leg_r = -88
        target.knee_r = 88
        target.leg_l = 4
        target.knee_l = 86
        target.spread = 3
        target.lift = 0              # the puppet itself sets the planted foot on the floor
        target.lean = 10
        target.head = 8
        target.arm_r = -38
        target.elbow_r = -40
        target.arm_l = -8
        target.elbow_l = -20
    end
    var moved = puppet.follow(a.pose, a.pose_speed, target, 30, 0.8)
    a.pose = moved[0]
    a.pose_speed = moved[1]
end

# --- The dead ------------------------------------------------------------------------------------

function run_enemy(Actor e)
    if not alive(e) do
        e.frame += 1
        spring(e)
        return
    end
    if e.cool > 0 do
        e.cool -= 1
    end
    if e.think > 0 do
        e.think -= 1
    end
    var to_player = flat(player.body.position - e.body.position)
    var dist = to_player.length()
    var wish = ap.Vec3(0, 0, 0)
    if e.state == S_HURT do
        e.stun -= 1
        if e.stun <= 0 do
            e.state = S_IDLE
        end
    else if e.state == S_ATTACK do
        run_attack(e)
    else if not e.aware do
        # Wandering; looking.
        var sees = dist < 10 and ticks % 5 == 0 and lv.world.sees(chest_of(e), chest_of(player))
        var in_front = math.abs(wrap(heading_of(to_player) - e.heading)) < 70
        if sees and (in_front or dist < 3.5) and alive(player) do
            e.sight += 5
        else if ticks % 5 == 0 do
            e.sight = math.max(e.sight - 2, 0)
        end
        if e.sight > (40 if e.kind == A_ZOMBIE else 22) do
            notice(e)
        end
        if e.think <= 0 do
            e.wander = e.home + ap.Vec3(ap.random(-3, 3), 0, ap.random(-3, 3))
            e.think = int(ap.random(90, 220))
        end
        var go = flat(e.wander - e.body.position)
        if go.length() > 0.4 do
            wish = unit(go) * (e.speed * 0.35)
            e.heading = e.heading + math.clamp(wrap(heading_of(go) - e.heading), -4.0, 4.0)
        end
    else do
        if ticks % 10 == 0 do
            var seen = lv.world.sees(chest_of(e), chest_of(player))
            e.unseen = 0 if seen and dist < 26 else e.unseen + 10
            if e.unseen > 420 or not alive(player) do
                e.aware = false
                e.sight = 0
            end
        end
        e.heading = e.heading + math.clamp(wrap(heading_of(to_player) - e.heading), -6.0, 6.0)
        var ranged = e.kind == A_ARCHER or e.kind == A_WRAITH
        var a = enemy_attack(e)
        if ranged do
            if dist < 5 do
                wish = unit(to_player) * -e.speed
            else if dist > 10 do
                wish = unit(to_player) * e.speed
            else do
                var side = ap.Vec3(to_player.z, 0, -to_player.x)
                wish = unit(side) * (e.speed * 0.4 * (1.0 if (ticks // 120 + int(e.home.x)) % 2 == 0 else -1.0))
            end
            if e.cool <= 0 and e.think <= 0 and dist < 14 and e.unseen == 0 do
                begin(e, a, null)
                e.cool = int(ap.random(90, 170))
            end
        else do
            if dist > a.reach - 0.2 do
                wish = unit(to_player) * e.speed
            else if e.cool <= 0 and e.think <= 0 do
                begin(e, a, null)
                e.cool = int(ap.random(50, 110)) if e.kind != A_ZOMBIE else int(ap.random(80, 140))
            end
        end
        # Keep a little apart from each other.
        for o in foes do
            if o != e and alive(o) do
                var gap = flat(e.body.position - o.body.position)
                if gap.length() < 0.9 and gap.length() > 0.01 do
                    wish = wish + unit(gap) * 1.2
                end
            end
        end
    end
    move_actor(e, wish)
end

# --- The boss ------------------------------------------------------------------------------------

function boss_fighting() returns bool
    return boss_phase == BP_FIGHT or final_phase == FP_GAUNTLET or final_phase == FP_SATAN
end

function run_boss(Actor b)
    if not alive(b) do
        b.frame += 1
        spring(b)
        return
    end
    var dt = 1.0 / 60
    b.buff_time = math.max(b.buff_time - dt, 0.0)
    b.cloak_time = math.max(b.cloak_time - dt, 0.0)
    if b.portal_cool > 0 do
        b.portal_cool -= 1
    end
    if b.summon_cool > 0 do
        b.summon_cool -= 1
    end
    # HELL's bosses, and any risen in its true form, burn.
    if (data.difficulty == DIFF_HELL or b.true_form or b.role == ROLE_SATAN) and ticks % 2 == 0 and b.fade > 0.3 do
        var tall = 1.8 * b.look.tall
        var at = b.body.position + ap.Vec3(ap.random(-0.5, 0.5) * b.look.bulk, ap.random(0.1, tall), ap.random(-0.5, 0.5) * b.look.bulk)
        var c = ap.Color(255, int(ap.random(40, 150)), 30)
        motes.push(Mote(at, ap.Vec3(ap.random(-0.3, 0.3), ap.random(1.6, 3.0), ap.random(-0.3, 0.3)), c, 0.55, 0.55, ap.random(0.05, 0.12)))
    end
    if b.state == S_KNEEL do
        run_kneeling(b)
        return
    end
    if b.fade < 1 do
        b.fade = math.min(b.fade + 1.0 / 90, 1.0)
    end
    if b.role == ROLE_SATAN and b.rise < 1 do
        # Up out of the floor.
        b.rise = math.min(b.rise + 1.0 / 240, 1.0)
        b.heading = heading_of(flat(player.body.position - b.body.position))
        if ticks % 8 == 0 do
            burst(b.body.position + ap.Vec3(ap.random(-2, 2), 0.1, ap.random(-2, 2)), 4, ap.Color(255, 90, 30), 4, 0.8, 0.12)
        end
        move_actor(b, ap.Vec3(0, 0, 0))
        return
    end
    var cpu = boss_cpu(data.difficulty)
    var to_player = flat(player.body.position - b.body.position)
    var dist = to_player.length()
    var wish = ap.Vec3(0, 0, 0)
    for k in 0..<b.skill_cool.length do
        if b.skill_cool[k] > 0 do
            b.skill_cool[k] -= 1
        end
    end
    if b.shot_gap > 0 do
        b.shot_gap -= 1
    end
    if not boss_fighting() or (b.role == ROLE_GAUNTLET and final_phase != FP_GAUNTLET) do
        b.heading = b.heading + math.clamp(wrap(heading_of(to_player) - b.heading), -6.0, 6.0)
        move_actor(b, wish)
        return
    end
    run_boss_super(b)
    if b.super_cast > 0 do
        # Its super coming on: posing, untouchable, then a shockwave.
        b.super_cast -= 1
        b.iframes = math.max(b.iframes, 2)
        b.heading = heading_of(to_player)
        if b.super_cast == 1 do
            super_shockwave(b)
        end
        move_actor(b, wish)
        return
    end
    var speed = b.speed * (1.3 if b.buff_time > 0 else 1.0)
    if b.state == S_HURT do
        b.stun -= 1
        if b.stun <= 0 do
            b.state = S_IDLE
            b.think = math.min(b.think, 6)
        end
    else if b.state == S_ATTACK do
        # Slower on lower difficulties: its attack (wind-up, strike, recovery) plays out at a tempo.
        b.tempo_left += b.tempo
        while b.tempo_left >= 1 and b.state == S_ATTACK do
            b.tempo_left -= 1
            run_attack(b)
        end
        if b.state == S_IDLE and ap.random() < CPU_COMBO[cpu] and dist < 2.6 do
            b.think = 2
        end
    else do
        if b.think > 0 do
            b.think -= 1
        end
        b.heading = b.heading + math.clamp(wrap(heading_of(to_player) - b.heading), -9.0, 9.0)
        var kit = kit_of(b)
        # Up close, in its own melee reach (the Arena's ai_range kept ranged fighters far off).
        var range = math.min(kit.ai_range, melee_blow(kit).reach * 0.9) * reach_of(b)
        var ult = kit.ultimate
        if b.super_state == 1 and not b.ult_used and ult.damage > 0 and ult.shot == roster.SHOT_NONE and ult.beam <= 0 do
            # Closing in to land its ultimate.
            range = math.max(ult.reach * reach_of(b) * 0.7, 1.2)
            speed *= 1.25
        end
        if b.role == ROLE_GAUNTLET and not b.may_attack do
            range = 6.5
        end
        if dist > range + 0.4 do
            wish = unit(to_player) * speed
        else if dist < range - 0.8 do
            wish = unit(to_player) * (-speed * 0.5)
        else do
            var side = ap.Vec3(to_player.z, 0, -to_player.x)
            wish = unit(side) * (speed * 0.35 * (1.0 if (ticks // 150 + b.boss_index) % 2 == 0 else -1.0))
        end
        if b.role == ROLE_GAUNTLET do
            # Keep a little apart from each other.
            for o in bosses do
                if o != b and alive(o) do
                    var gap = flat(b.body.position - o.body.position)
                    if gap.length() < 1.1 and gap.length() > 0.01 do
                        wish = wish + unit(gap) * 2.0
                    end
                end
            end
        end
        if b.think <= 0 do
            boss_choose(b, dist, cpu)
        end
    end
    move_actor(b, wish)
end

function boss_choose(Actor b, double dist, int cpu)
    b.think = int(double(CPU_WAIT[cpu] // 2 + int(ap.random(0, double(CPU_WAIT_MORE[cpu]) / 2))) * BOSS_THINK[data.difficulty])
    if b.true_form or b.role == ROLE_REVENGE do
        b.think = b.think * 2 // 3
    end
    if not b.may_attack do
        b.think = 20
        return
    end
    var kit = kit_of(b)
    var seen = lv.world.sees(chest_of(b), chest_of(player))
    # In its super, once, its ultimate (its Arena super move), after a moment to settle.
    var ult = kit.ultimate
    if b.super_state == 1 and not b.ult_used and b.super_ticks > 60 and ult.damage > 0 and seen do
        var ranged = ult.shot != roster.SHOT_NONE or ult.beam > 0
        if ranged or dist < (ult.reach + ult.lunge) * reach_of(b) + 0.5 do
            b.ult_used = true
            b.ulting = true
            begin(b, ult, null)
            say("{kit.name}: {ult.name.upper()}!", b.look.accent.lerp(ap.WHITE, 0.3), 160)
            sfx_at(SND_CHARGE, b.body.position, 0.7, 0.6)
            return
        end
    end
    # Its skills, tricks and all, far more often than in the Arena.
    var rate = BOSS_SKILL_RATE[data.difficulty] + (0.15 if b.super_state == 1 else 0.0)
    if b.role == ROLE_GAUNTLET do
        rate *= 0.4
    end
    if b.skills.length > 0 and ap.random() < rate do
        var first = int(ap.random(0, double(b.skills.length) - 0.001))
        for n in 0..<b.skills.length do
            var k = (first + n) % b.skills.length
            var a = b.skills[k]
            if b.skill_cool[k] > 0 do
                continue
            end
            if boss_skill_fits(b, a, dist, seen) do
                var cool = math.max(int(double(a.cooldown) * 0.6), 120)
                if a.teleport or a.kind == roster.KIND_BLINK do
                    cool = math.max(cool, 330)       # teleports now and then, not every few seconds
                end
                if a.kind == roster.KIND_PORTAL do
                    cool = math.max(int(double(cool) * 0.6), 150)
                end
                b.skill_cool[k] = int(double(cool) / BOSS_TEMPO[data.difficulty])
                shot_taken(b, a)
                begin(b, a, null)
                return
            end
        end
    end
    var a = b.basics[b.chain % b.basics.length]
    if boss_ranged(a) and (b.shot_gap > 0 or dist < 2.6) do
        a = melee_blow(kit)               # up close, or between shots: the melee blow instead
    end
    var reach = (a.reach + a.lunge) * reach_of(b)
    if a.shot != roster.SHOT_NONE or a.beam > 0 do
        reach = BOSS_SIGHT[data.difficulty] * 0.75
    end
    if dist < reach + 0.2 do
        b.chain = (b.chain + 1) % b.basics.length
        shot_taken(b, a)
        begin(b, a, null)
        if b.chain != 0 and ap.random() < CPU_COMBO[cpu] do
            b.think = 4
        end
    else do
        b.chain = 0
        b.think = 8
    end
end

function decoys_alive() returns int
    var n = 0
    for f in foes do
        if f.kind == A_DECOY and alive(f) do
            n += 1
        end
    end
    return n
end

function boss_skill_fits(Actor b, roster.Attack a, double dist, bool seen) returns bool
    if b.shot_gap > 0 and boss_ranged(a) do
        return false
    end
    var k = a.kind
    if k == roster.KIND_STRIKE do
        var ranged = a.shot != roster.SHOT_NONE or a.beam > 0 or a.skyfall
        if ranged do
            return seen and dist < BOSS_SIGHT[data.difficulty]
        end
        if a.teleport do
            return dist < 10 and seen
        end
        return dist < (a.reach + a.lunge) * reach_of(b) + 0.3
    else if k == roster.KIND_BUFF do
        return b.buff_time <= 0 and dist < 9
    else if k == roster.KIND_BLINK do
        return dist > 4 or ap.random() < 0.3
    else if k == roster.KIND_CLOAK do
        return b.cloak_time <= 0 and dist > 3
    else if k == roster.KIND_PORTAL do
        return dist < 22
    else if k == roster.KIND_MIRROR do
        return decoys_alive() < 2 and b.summon_cool <= 0
    else if k == roster.KIND_GLASS do
        return decoys_alive() > 0
    else if k == roster.KIND_SHATTER do
        for f in foes do
            if f.kind == A_DECOY and alive(f) and flat_distance(f.body.position, player.body.position) < 3 do
                return true
            end
        end
        return false
    else if k == roster.KIND_WALL do
        return dist < 12 and dist > 2
    else if k == roster.KIND_SWITCH do
        return dist < 12 and dist > 2.5 and seen
    else if k == roster.KIND_FAN do
        return seen and dist < BOSS_SIGHT[data.difficulty] - 2
    end
    return false
end

# A boss's trick going off (what the Arena's non-attack skills do, here).
function boss_trick(Actor b, roster.Attack a)
    var k = a.kind
    var c = b.look.accent
    if k == roster.KIND_BUFF do
        b.buff_time = math.max(a.buff_time, 3.5)
        burst(chest_of(b), 24, c, 4, 0.6, 0.08)
        float_text(chest_of(b) + ap.Vec3(0, 0.5, 0), a.name.upper(), c)
        sfx_at(SND_FLASH, b.body.position, 0.5, 0.9)
    else if k == roster.KIND_BLINK do
        var side = ap.Vec3(forward_of(player.heading).z, 0, -forward_of(player.heading).x) * (1.0 if ap.random() < 0.5 else -1.0)
        var to = stand_near(lv, player.body.position + side * 3 + forward_of(player.heading) * 2.5)   # off to the side, ahead: never behind
        teleport_boss(b, to)
    else if k == roster.KIND_CLOAK do
        b.cloak_time = 4
        burst(chest_of(b), 18, c.fade(0.5), 3, 0.6, 0.07)
        sfx_at(SND_CLOTH, b.body.position, 0.5, 0.7)
    else if k == roster.KIND_PORTAL do
        if b.role == ROLE_SATAN do
            portal_attack(b, P_PILLARS)
        else do
            portal_attack(b, int(ap.random(0, double(P_KINDS) - 0.001)))
        end
    else if k == roster.KIND_MIRROR do
        b.summon_cool = 420
        if b.role == ROLE_SATAN do
            # The damned crawl up out of the floor around Scarf.
            for n in 0..<4 do
                var ang = double(n) * 90 + ap.random(0, 40)
                var at = stand_near(lv, player.body.position + forward_of(ang) * 4)
                var g = spawn_enemy(A_GHOUL, at)
                g.aware = true
                g.look.skin = ap.Color(160, 40, 30)
                g.look.eyes = ap.Color(255, 200, 60)
                g.hp *= 2
                g.hp_max = g.hp
                foes.push(g)
                burst(at + ap.Vec3(0, 0.3, 0), 14, ap.Color(255, 90, 30), 4, 0.6, 0.1)
            end
            sfx_at(SND_GROWL, b.body.position, 0.7, 0.5)
        else do
            for n in 0..<2 do
                var ang = heading_of(b.body.position - player.body.position) + (120.0 if n == 0 else -120.0)
                spawn_decoy(b, stand_near(lv, player.body.position + forward_of(ang) * 3))
            end
            sfx_at(SND_SHIMMER, b.body.position, 0.6, 1.2)
        end
    else if k == roster.KIND_GLASS do
        var best = -1
        var near = 1000.0
        for i, f in foes do
            if f.kind == A_DECOY and alive(f) do
                var d = flat_distance(f.body.position, player.body.position)
                if d < near do
                    near = d
                    best = i
                end
            end
        end
        if best >= 0 do
            var here = b.body.position
            teleport_boss(b, foes[best].body.position)
            foes[best].body = ap.Body(here)
            foes[best].body.radius = 0.32
            foes[best].body.height = 1.7
        end
    else if k == roster.KIND_SHATTER do
        for f in foes do
            if f.kind == A_DECOY and alive(f) do
                burst(chest_of(f), 30, ap.Color(220, 240, 255), 6, 0.5, 0.08)
                sfx_at(SND_CLASH_A, f.body.position, 0.6, 1.4)
                if flat_distance(f.body.position, player.body.position) < 2.4 do
                    hurt(player, 10 * b.power, 18, f.body.position, 5, 0, b, null)
                end
                f.hp = 0
                f.state = S_DEAD
                f.frame = 100
            end
        end
    else if k == roster.KIND_WALL do
        raise_wall(b)
    else if k == roster.KIND_SWITCH do
        var mine = b.body.position
        var theirs = player.body.position
        teleport_boss(b, theirs)
        player.body = ap.Body(mine)
        player.body.radius = 0.33
        player.body.height = 1.75
        if not unstunnable() do
            player.state = S_HURT
            player.stun = 30
            player.stun_total = 30
        end
        streaks.push(Streak(mine + ap.Vec3(0, 1, 0), theirs + ap.Vec3(0, 1, 0), c, 0.4, 0.4, 0.08))
        say("SWITCHED!", c, 60)
    else if k == roster.KIND_FAN do
        for n in 0..<6 do
            var from = chest_of(b) + forward_of(b.heading) * 0.5
            var aim = unit(chest_of(player) - from)
            var turn = (double(n) - 2.5) * 7 * math.PI / 180
            var dir = ap.Vec3(aim.x * math.cos(turn) + aim.z * math.sin(turn), aim.y, -aim.x * math.sin(turn) + aim.z * math.cos(turn))
            var bolt = Bolt(from, dir * 30)
            bolt.damage = 5 * b.power
            bolt.color = c
            bolt.size = 0.09
            bolts.push(bolt)
        end
        sfx_at(SND_GUN, b.body.position, 0.7)
    end
end

function teleport_boss(Actor b, ap.Vec3 to)
    burst(chest_of(b), 18, b.look.accent, 3, 0.4, 0.07)
    sfx_at(SND_RIFT, b.body.position, 0.5)
    b.body = ap.Body(to)
    b.body.radius = 0.4 * b.look.bulk
    b.body.height = 1.8 * b.look.tall
    b.heading = heading_of(flat(player.body.position - to))
    burst(chest_of(b), 18, b.look.accent, 3, 0.4, 0.07)
end

function spawn_decoy(Actor b, ap.Vec3 at)
    var e = spawn_enemy(A_DECOY, at)
    e.look = b.look
    e.aware = true
    e.fade = 0.6
    e.speed = b.speed * 0.8
    e.power = b.power * 0.6
    foes.push(e)
    burst(at + ap.Vec3(0, 1, 0), 16, ap.Color(220, 240, 255), 3, 0.5, 0.07)
end

# CARBON's wall (and anyone's): three pillars of stone burst up across the way, throwing Scarf off
# them, and stand a while.
function raise_wall(Actor b)
    var way = unit(flat(player.body.position - b.body.position))
    var side = ap.Vec3(way.z, 0, -way.x)
    var mid = b.body.position + way * (flat_distance(player.body.position, b.body.position) * 0.55)
    var made = false
    for n in -1..<2 do
        var at = mid + side * (double(n) * 1.0)
        var spot = cell_of(at)
        if cell_at(lv, spot[0], spot[1]) != CELL_FLOOR do
            continue
        end
        if flat_distance(at, player.body.position) < 1.0 do
            hurt(player, 9 * b.power, 20, at, 6, 7, b, null)
            continue
        end
        var pr = Prop(PROP_PILLAR, at, 1.1, ap.random(0, 360))
        pr.life = 7
        pr.rise = 0
        lv.props.push(pr)
        burst(at + ap.Vec3(0, 0.2, 0), 14, ap.Color(170, 150, 120), 4, 0.6, 0.1)
        made = true
    end
    if made do
        build_world(lv)
        sfx_at(SND_BOOM, mid, 0.6, 0.7)
    end
end

# What a boss's blow leaves behind on Scarf: its poison, its slow, its heal, its ragdoll throw.
function boss_hit_effects(Actor b, roster.Attack act, Actor t)
    if act.poison > 0 do
        t.poison = math.max(t.poison, act.poison)
    end
    if act.slow > 0 do
        t.freeze = math.max(t.freeze, act.slow * 0.6)
    end
    if act.heal > 0 do
        b.hp = math.min(b.hp + act.heal, b.hp_max)
    end
    if act.ragdoll > 0 and not (t.kind == A_PLAYER and unstunnable()) do
        t.knock = t.knock * 1.6
        t.lift_speed = math.max(t.lift_speed, 5.0)
    end
end

# Shots that fall from the sky (or are lobbed): a mark on the ground, then the blow.
function boss_sky(Actor b, roster.Attack act)
    var count = math.max(act.volley, 1)
    for n in 0..<count do
        var at = player.body.position
        if n > 0 do
            at = at + ap.Vec3(ap.random(-3.5, 3.5), 0, ap.random(-3.5, 3.5))
        end
        var bolt = Bolt(at + ap.Vec3(0, 9, 0), ap.Vec3(0, -9, 0))
        bolt.damage = act.damage * b.power
        bolt.color = b.look.accent
        bolt.size = 0.3
        bolt.blast = math.max(act.blast, 1.4)
        bolt.stun = 0
        bolt.life = 1.6
        bolt.poison = act.poison
        bolts.push(bolt)
        marks.push(Mark(at, 1.0, b.look.accent))
    end
    sfx_at(SND_WHOOSH_LONG, b.body.position, 0.5, 0.7)
end

# --- Portals ----------------------------------------------------------------------------------------
# ATOMIC's (and any super's wild portals, and HELL's pillars of fire).
const int P_BARRAGE = 0              # a ring of portals around Scarf, each firing in turn
const int P_DROP = 1                 # one overhead: something heavy falls through
const int P_RAY = 2                  # two facing each other across Scarf: a ray between them
const int P_GATES = 3                # a linked pair: step in one, burn, come out the other
const int P_FLANK = 4                # the boss steps into one and out behind Scarf, striking
const int P_MINES = 5                # a portal that spits mines around Scarf
const int P_KINDS = 6
const int P_PILLARS = 6              # Satan's: the floor opens in fire
class Portal
    ap.Vec3 at
    int kind
    double life                      # seconds left
    double fire_in                   # seconds until it goes off
    ap.Color color
    ap.Vec3 aim = ap.Vec3(0, 0, 1)   # which way it faces
    int twin = -1
    bool fired = false
    double power = 1
end
Portal[] portals = []

function portal_attack(Actor b, int kind)
    var c = b.look.accent
    var here = player.body.position
    var p = b.power
    if kind == P_BARRAGE do
        var n = 4 + data.difficulty
        for i in 0..<n do
            var ang = double(i) / double(n) * 360 + ap.random(0, 30)
            var at = here + forward_of(ang) * 5.5 + ap.Vec3(0, 1.3, 0)
            var pt = Portal(at, P_BARRAGE, 2.6, 0.9 + double(i) * 0.25, c)
            pt.power = p
            portals.push(pt)
        end
        say("PORTALS!", c, 50)
    else if kind == P_DROP do
        var pt = Portal(here + ap.Vec3(0, 5, 0), P_DROP, 2.0, 1.1, c)
        pt.power = p
        portals.push(pt)
        marks.push(Mark(here, 1.1, c))
    else if kind == P_RAY do
        var ang = ap.random(0, 360)
        var a = here + forward_of(ang) * 6 + ap.Vec3(0, 1.1, 0)
        var z = here - forward_of(ang) * 6 + ap.Vec3(0, 1.1, 0)
        var pa = Portal(a, P_RAY, 2.4, 1.3, c)
        pa.aim = unit(z - a)
        pa.power = p
        portals.push(pa)
        var pz = Portal(z, P_RAY, 2.4, 99, c)
        pz.aim = unit(a - z)
        pz.fired = true
        portals.push(pz)
    else if kind == P_GATES do
        var a = stand_near(lv, here + forward_of(ap.random(0, 360)) * 2.5)
        var z = stand_near(lv, b.body.position + forward_of(ap.random(0, 360)) * 3)
        var pa = Portal(a + ap.Vec3(0, 1.2, 0), P_GATES, 8, 0.6, c)
        var pz = Portal(z + ap.Vec3(0, 1.2, 0), P_GATES, 8, 0.6, c)
        pa.twin = portals.length + 1
        pz.twin = portals.length
        pa.power = p
        pz.power = p
        portals.push(pa)
        portals.push(pz)
    else if kind == P_FLANK do
        var behind = stand_near(lv, here - forward_of(player.heading) * 1.6)
        portals.push(Portal(b.body.position + ap.Vec3(0, 1.2, 0), P_FLANK, 0.8, 99, c))
        portals.push(Portal(behind + ap.Vec3(0, 1.2, 0), P_FLANK, 0.8, 99, c))
        teleport_boss(b, behind)
        b.think = 0
        var a = b.basics[0]
        begin(b, a, null)
    else if kind == P_MINES do
        var pt = Portal(here + ap.Vec3(ap.random(-2, 2), 3.2, ap.random(-2, 2)), P_MINES, 2.2, 0.8, c)
        pt.power = p
        portals.push(pt)
    else do
        # Satan's pillars of fire: rings on the floor, then fire up out of each.
        for i in 0..<6 do
            var at = here + (ap.Vec3(0, 0, 0) if i == 0 else forward_of(double(i) * 72 + ap.random(0, 30)) * ap.random(2.5, 5.5))
            var pt = Portal(ap.Vec3(at.x, 0.05, at.z), P_PILLARS, 2.4, 1.0 + double(i) * 0.12, ap.Color(255, 90, 30))
            pt.power = p
            portals.push(pt)
        end
    end
    sfx_at(SND_RIFT, here, 0.6, 0.8)
end

function run_portals()
    var dt = 1.0 / 60
    Portal[] kept = []
    for i, pt in portals do
        pt.life -= dt
        pt.fire_in -= dt
        if not pt.fired and pt.fire_in <= 0 do
            pt.fired = true
            portal_fire(pt)
        end
        if pt.kind == P_GATES and alive(player) and pt.twin >= 0 and pt.twin < portals.length and pt.fire_in < 0 do
            if flat_distance(pt.at, player.body.position) < 0.9 and player.iframes <= 0 do
                var out = portals[pt.twin].at
                player.body = ap.Body(ap.Vec3(out.x, 0, out.z) + unit(flat(out - pt.at)) * 1.2)
                player.body.radius = 0.33
                player.body.height = 1.75
                player.iframes = 20
                player.burn = math.max(player.burn, 3.0)
                hurt(player, 6 * pt.power, 0, pt.at, 0, 0, null, null)
                sfx(SND_RIFT, 0.6, 1.3)
                sfx(SND_FIRE, 0.5)
            end
        end
        if pt.life > 0 do
            kept.push(pt)
        end
    end
    portals = kept
end

function portal_fire(Portal pt)
    if pt.kind == P_BARRAGE do
        var bolt = Bolt(pt.at, unit(chest_of(player) - pt.at) * 17)
        bolt.damage = 6 * pt.power
        bolt.color = pt.color
        bolt.size = 0.16
        bolts.push(bolt)
        sfx_at(SND_ZAP, pt.at, 0.45, 1.2)
    else if pt.kind == P_DROP do
        var bolt = Bolt(pt.at, ap.Vec3(0, -14, 0))
        bolt.damage = 16 * pt.power
        bolt.color = pt.color
        bolt.size = 0.45
        bolt.blast = 1.8
        bolt.life = 1
        bolts.push(bolt)
        sfx_at(SND_WHOOSH_LONG, pt.at, 0.5, 0.6)
    else if pt.kind == P_RAY do
        var from = pt.at
        streaks.push(Streak(from, from + pt.aim * 12, pt.color, 0.45, 0.45, 0.16))
        sfx_at(SND_BEAM, from, 0.6)
        var to = chest_of(player) - from
        var along = to.x * pt.aim.x + to.y * pt.aim.y + to.z * pt.aim.z
        var off = (to - pt.aim * along).length()
        if along > 0 and along < 12 and off < 0.8 do
            unblockable_hit = true
            hurt(player, 14 * pt.power, 20, from, 3, 0, boss_source(), null)
            unblockable_hit = false
        end
    else if pt.kind == P_MINES do
        for n in 0..<3 do
            var at = player.body.position + ap.Vec3(ap.random(-2.5, 2.5), 0.25, ap.random(-2.5, 2.5))
            var m = Bolt(at, ap.Vec3(0, 0, 0))
            m.damage = 12 * pt.power
            m.color = pt.color
            m.size = 0.22
            m.blast = 2.0
            m.life = 7
            m.mine_wait = true
            bolts.push(m)
            burst(at, 8, pt.color, 2, 0.4, 0.06)
        end
        sfx_at(SND_SPIT, pt.at, 0.5, 0.8)
    else if pt.kind == P_PILLARS do
        for k in 0..<14 do
            motes.push(Mote(pt.at + ap.Vec3(ap.random(-0.5, 0.5), 0, ap.random(-0.5, 0.5)), ap.Vec3(ap.random(-0.4, 0.4), ap.random(7, 11), ap.random(-0.4, 0.4)), ap.Color(255, int(ap.random(60, 180)), 30), 0.7, 0.7, ap.random(0.12, 0.24)))
        end
        sfx_at(SND_FIRE, pt.at, 0.55, 0.7)
        if flat_distance(pt.at, player.body.position) < 1.4 do
            hurt(player, 18 * pt.power, 20, pt.at, 2, 8, boss_source(), null)
            player.burn = math.max(player.burn, 3.0)
        end
    end
end

# --- A boss's super ------------------------------------------------------------------------------
# At half health a boss goes into its Arena super for a while: it poses (untouchable) and a
# shockwave throws Scarf back; the place takes on the super's colors; its effects come on (power,
# armor, speed, healing, steadiness, harm over time, poison, slowing, copies, wild portals, its
# strike from the sky, vanishing) and it closes in to land its ultimate (aimed, with a line showing
# where; untouchable as it winds up).
const int BOSS_SUPER_TICKS = 20 * 60
var super_banner = 0                 # ticks the super's name stays on screen
var super_tint = 0.0                 # how far the place has taken on the super's colors

function boss_in_super() returns bool
    for b in bosses do
        if b.super_state == 1 and alive(b) and b.role != ROLE_GAUNTLET do
            return true
        end
    end
    return false
end
function super_boss() returns Actor?
    for b in bosses do
        if b.super_state == 1 and alive(b) do
            return b
        end
    end
    return null
end

function run_boss_super(Actor b)
    if b.role != ROLE_MAIN and b.role != ROLE_SATAN do
        return
    end
    var m = kit_of(b).maximum
    if b.super_state == 0 and b.hp < b.hp_max * 0.5 and b.state != S_ATTACK do
        b.super_state = 1
        b.super_ticks = 0
        b.strike_left = 3
        b.super_cast = 120
        b.iframes = 120
        b.state = S_IDLE
        super_banner = 150
        burst(chest_of(b), 60, b.look.accent, 6, 1.0, 0.1)
        sfx_at(SND_BOOM_BIG, b.body.position, 0.6, 0.7)
        sfx_at(SND_AMBUSH, b.body.position, 0.6)
        sfx_at(SND_CHARGE, b.body.position, 0.7, 0.5)
        b.power *= m.power
        b.damage_taken *= m.armor
        b.speed *= m.speed
        b.tempo *= 1.15
        if m.clones > 0 do
            for n in 0..<math.min(m.clones, 3) do
                spawn_decoy(b, stand_near(lv, player.body.position + forward_of(double(n) * 120 + ap.random(0, 60)) * 3.5))
            end
        end
    end
    if b.super_state != 1 do
        return
    end
    b.super_ticks += 1
    if b.super_cast > 0 do
        return
    end
    var dt = 1.0 / 60
    var strength = BOSS_POWER[data.difficulty]
    if m.regen > 0 do
        b.hp = math.min(b.hp + m.regen * dt * strength, b.hp_max)
    end
    if m.foe_dps > 0 and alive(player) do
        player.hp -= m.foe_dps * dt * strength * 0.6
        if player.hp <= 0 do
            die(player)
        end
    end
    if m.foe_poison > 0 and alive(player) do
        player.poison = math.min(player.poison + m.foe_poison * dt, 6.0)
    end
    if m.foe_slow and alive(player) do
        player.freeze = math.max(player.freeze, 0.1)
    end
    # Its strike from the sky: a marked spot, then a blow on it.
    if m.strike.name != "" and m.strike_every > 0 do
        b.strike_left -= dt
        if b.strike_left <= 0 do
            b.strike_left = m.strike_every * 0.8 / BOSS_TEMPO[data.difficulty]
            var at = player.body.position + ap.Vec3(ap.random(-0.6, 0.6), 0, ap.random(-0.6, 0.6))
            var bolt = Bolt(at + ap.Vec3(0, 9, 0), ap.Vec3(0, -9, 0))
            bolt.damage = m.strike.damage * b.power
            bolt.color = b.look.accent
            bolt.size = 0.3
            bolt.blast = 1.6
            bolt.stun = 0
            bolt.life = 1.6
            bolts.push(bolt)
            marks.push(Mark(at, 1.0, b.look.accent))
        end
    end
    # Wild portals, now and then.
    if m.portals and b.portal_cool <= 0 do
        b.portal_cool = int(220 / BOSS_TEMPO[data.difficulty])
        portal_attack(b, P_PILLARS if b.role == ROLE_SATAN else int(ap.random(0, double(P_KINDS) - 0.001)))
    end
    if m.steady and b.state == S_HURT do
        b.state = S_IDLE
    end
    if ticks % 3 == 0 do
        motes.push(Mote(b.body.position + ap.Vec3(ap.random(-0.6, 0.6), ap.random(0, 2), ap.random(-0.6, 0.6)), ap.Vec3(0, 1.5, 0), b.look.accent, 0.6, 0.6, 0.07))
    end
    if b.super_ticks >= BOSS_SUPER_TICKS do
        b.super_state = 2
        b.power /= m.power
        b.damage_taken /= m.armor
        b.speed /= m.speed
        b.tempo /= 1.15
        say("{kit_of(b).name}'S SUPER IS OVER", ap.Color(220, 210, 230), 120)
    end
end

# The end of a super's coming-on: everything near is thrown back.
function super_shockwave(Actor b)
    sfx_at(SND_BOOM_BIG, b.body.position, 0.7, 0.9)
    for k in 0..<32 do
        var ang = double(k) / 32 * 360
        motes.push(Mote(b.body.position + ap.Vec3(0, 0.3, 0), forward_of(ang) * 12, b.look.accent.lerp(ap.WHITE, 0.3), 0.5, 0.5, 0.12))
    end
    if flat_distance(player.body.position, b.body.position) < 6 do
        var was = player.iframes
        player.iframes = 0
        unblockable_hit = true
        hurt(player, player.hp_max * 0.06, 20, b.body.position, 12, 3, b, null)
        unblockable_hit = false
        player.iframes = math.max(was, player.iframes)
    end
    say("{kit_of(b).name}'S SUPER: {kit_of(b).maximum.name}", b.look.accent.lerp(ap.WHITE, 0.3), 160)
end

# Whether a boss can be seen: one whose super vanishes it is a shimmer until its ultimate goes off.
function boss_alpha(Actor b) returns double
    if b.cloak_time > 0 do
        return 0.06 + 0.04 * math.sin(double(ticks) * 0.25)
    end
    if b.super_state == 1 and kit_of(b).maximum.vanish and not (b.ult_used and b.state == S_ATTACK and b.frame >= b.act.startup) do
        if b.ult_used and b.state != S_ATTACK do
            return 1.0
        end
        return 0.08 + 0.05 * math.sin(double(ticks) * 0.2)
    end
    return 1.0
end

# Spots a strike is about to land on.
class Mark
    ap.Vec3 at
    double life
    ap.Color color
end
Mark[] marks = []

# --- When a boss falls -------------------------------------------------------------------------------

function boss_fell(Actor b)
    if b.role == ROLE_GAUNTLET do
        sfx_at(SND_BOOM, b.body.position, 0.4, 1.2)
        var left = 0
        for o in bosses do
            if alive(o) and o.role == ROLE_GAUNTLET do
                left += 1
            end
        end
        if left == 0 do
            gauntlet_won()
        end
        return
    end
    if b.role == ROLE_REVENGE do
        # Its revenge failed: a rich haul, and two upgrades to pick instead of one.
        say("{kit_of(b).name}'S REVENGE FAILED. A RICH HAUL OF SOULS, AND TWO UPGRADES.", ap.Color(255, 220, 190), 260)
        make_offers()
        upgrade_picks = 2
        upgrade_wait = 120
        store()
        return
    end
    if b.role == ROLE_SATAN do
        return
    end
    if b.true_form do
        # Its red book flies out, to hang in front of Scarf.
        var book = Book(RED_ART + b.boss_index, player.body.position + forward_of(heading_of(flat(b.body.position - player.body.position))) * 1.8)
        book.red = true
        book.fly = 0
        book.start = chest_of(b)
        book.price = int(double(140 + 6 * b.boss_index) * DIFF_PRICES[data.difficulty] / 2)
        book.known = true
        lv.books.push(book)
        if not has(data.red_arts, b.boss_index) do
            data.red_arts.push(b.boss_index)
        end
        sfx(SND_BOOK, 0.7, 0.7)
        achieve("soul_eater")
        say("A RED BOOK FLIES OUT OF {kit_of(b).name}. WALK UP TO IT TO BUY THEIR ART.", ap.Color(255, 80, 70), 260)
        clear_hazards()
        reopen_hall(b.boss_index)
        boss_phase = BP_DONE
        combat_lock = false
        store()
        return
    end
    hall_cleared(b)
end

# The hall's boss is down: what happens next depends on the level.
function hall_cleared(Actor b)
    var index = b.boss_index
    sfx(SND_BELL, 0.6)
    sfx(SND_GOLD, 0.5)
    if lv.mode == LEVEL_INTERMISSION do
        queue_pos += 1
        if queue_pos < lv.queue.length do
            # The next one is already coming.
            boss_phase = BP_WAIT
            boss_ticks = 200
            bosses = []
            say("{queue_pos} OF {lv.queue.length}. THE NEXT ONE IS COMING.", ap.Color(255, 120, 140), 200)
            return
        end
        boss_phase = BP_DONE
        intermission_won()
        return
    end
    boss_phase = BP_DONE
    if not has(data.cleared, index) do
        data.cleared.push(index)
        # Each one beaten leaves you more willful.
        data.max_health += 8
        data.max_stamina += 4
        data.max_mana += 4
    end
    data.unlocked = math.max(data.unlocked, index + 1)
    achieve("boss_1")
    if data.cleared.length >= 10 do
        achieve("boss_10")
    end
    if not boss_hit_taken do
        achieve("untouched")
    end
    if b.state != S_KNEEL do
        data.since_kneel += 1
    end
    combat_lock = false
    clear_hazards()
    if lv.mode == LEVEL_FINAL do
        achieve("boss_all")
        final_breach()
        store()
        return
    end
    reopen_hall(index)
    make_offers()
    upgrade_wait = 150
    say("BOSS DEFEATED: {cast[index].name}. MAX HP, ST AND MN UP. A PORTAL TO THE NEXT LEVEL HAS OPENED.", lv.glow, 300)
    store()
end

# A fight's leftovers (its portals, its mines and shots, its copies) go with it.
function clear_hazards()
    portals = []
    Bolt[] mine_only = []
    for b in bolts do
        if b.mine do
            mine_only.push(b)
        end
    end
    bolts = mine_only
    for f in foes do
        if f.kind == A_DECOY and alive(f) do
            f.hp = 0
            f.state = S_DEAD
            f.frame = 100
        end
    end
end

# The portal (or portals) out, and the hall's doors open again.
function reopen_hall(int index)
    var room = lv.rooms[lv.boss_room]
    var gate = Gate(stand_near(lv, room.center() + ap.Vec3(0, 0, -2)), index + 1)
    gate.open = true
    gate.known = true
    lv.gates.push(gate)
    if lv.mode == LEVEL_PLAIN and (index + 1) % 5 == 0 and index < cast.length - 1 do
        # Every fifth level: a second portal, near the hall but not in it, to the Intermission.
        var near = lv.rooms[math.max(lv.boss_room - 1, 0)]
        var side = Gate(stand_near(lv, near.center() + ap.Vec3(1.5, 0, 0)), index + 1)
        side.kind = GATE_INTERMISSION
        side.open = true
        lv.gates.push(side)
        say("SOMEWHERE NEAR THE HALL, A STRANGER PORTAL HAS OPENED: THE INTERMISSION.", ap.Color(255, 90, 120), 320)
    end
    for k in lv.boss_doors do
        lv.cells[k] = CELL_FLOOR
    end
    build_world(lv)
end

# An intermission's three are down: treasure fills the hall, and the way on opens.
function intermission_won()
    var room = lv.rooms[lv.boss_room]
    var d = Dice(int(ap.random(1, 999999)))
    for k in 0..<10 do
        var a = double(k) / 10 * 2 * math.PI
        var c = Chest(100 + k, stand_near(lv, room.center() + ap.Vec3(math.sin(a), 0, math.cos(a)) * 6), heading_of(ap.Vec3(-math.sin(a), 0, -math.cos(a))))
        fill_chest(c, lv.index + 4, d, 2.0)
        c.known = true
        lv.chests.push(c)
        burst(c.at + ap.Vec3(0, 0.5, 0), 12, ap.Color(255, 220, 140), 3, 0.6, 0.07)
    end
    var gate = Gate(room.center(), lv.index + 1)
    gate.open = true
    gate.known = true
    lv.gates.push(gate)
    for k in lv.boss_doors do
        lv.cells[k] = CELL_FLOOR
    end
    build_world(lv)
    achieve("intermission")
    combat_lock = false
    make_offers()
    upgrade_wait = 200
    say("THE INTERMISSION IS OVER. TAKE WHAT YOU CAN CARRY.", ap.Color(255, 220, 160), 300)
    store()
end

# --- A boss on its knees -------------------------------------------------------------------------------
# Every 6 to 10 bosses, one does not fall: it kneels. Walk up to it and Death Focus, and its soul
# leaves it, then rushes back: it rises red, with half again its health and far stronger. Beat
# that and its red book (its own move, as an art) is yours to buy.
var soul_show = 0                    # ticks into a soul leaving its body and coming back (0: none)
var soul_owner = -1
var kneel_ready = true

function boss_kneels(Actor b) returns bool
    if b.role == ROLE_SATAN do
        satan_down(b)
        return true
    end
    if b.role != ROLE_MAIN or b.true_form or lv.mode != LEVEL_PLAIN do
        return false
    end
    if data.since_kneel + 1 < data.kneel_next do
        return false
    end
    b.hp = 1
    b.state = S_KNEEL
    b.frame = 0
    b.super_state = 2
    data.since_kneel = 0
    data.kneel_next = 6 + int(ap.random(0, 4.99))
    sfx_at(SND_THUD, b.body.position, 0.7, 0.6)
    hall_cleared(b)
    say("{kit_of(b).name} KNEELS, NOT DEAD. WALK UP AND USE DEATH FOCUS (V, THEN 1) FOR A HARDER SECOND FIGHT AND ITS RED BOOK - OR LEAVE THROUGH THE PORTAL.", ap.Color(255, 90, 80), 420)
    return true
end

function kneeler() returns Actor?
    for b in bosses do
        if b.state == S_KNEEL and alive(b) do
            return b
        end
    end
    return null
end

function run_kneeling(Actor b)
    b.heading = b.heading + math.clamp(wrap(heading_of(flat(player.body.position - b.body.position)) - b.heading), -2.0, 2.0)
    if flat_distance(player.body.position, b.body.position) > 4.5 do
        kneel_ready = true
    end
    if ticks % 4 == 0 do
        motes.push(Mote(chest_of(b) + ap.Vec3(ap.random(-0.3, 0.3), 0, ap.random(-0.3, 0.3)), ap.Vec3(0, 0.6, 0), ap.Color(200, 230, 255).fade(0.6), 1, 1, 0.05))
    end
    move_actor(b, ap.Vec3(0, 0, 0))
end

function near_kneeler() returns bool
    var k = kneeler()
    return k != null and kneel_ready and flat_distance(player.body.position, (k as Actor).body.position) < 3.2 and soul_show == 0
end

# The Death Focus on a kneeling boss is won: its soul goes, and comes back.
function begin_soul_show(Actor b)
    soul_show = 1
    soul_owner = b.boss_index
    sfx(SND_WISP, 0.7, 0.6)
    sfx(SND_SHIMMER, 0.5, 0.5)
end
function run_soul_show()
    if soul_show <= 0 do
        return
    end
    soul_show += 1
    var k = kneeler()
    if soul_show == 150 do
        sfx(SND_WHOOSH_LONG, 0.7, 0.6)
    end
    if soul_show >= 190 do
        soul_show = 0
        if k != null do
            rise_true_form(k as Actor)
        end
    end
end
function soul_place() returns ap.Vec3
    var k = kneeler()
    if k == null do
        return ap.Vec3(0, -100, 0)
    end
    var b = k as Actor
    var t = double(soul_show)
    var up = 3.2 * puppet.smooth(math.min(t / 140, 1.0))
    if t > 150 do
        up = 3.2 * (1 - puppet.smooth(math.min((t - 150) / 40, 1.0)))
    end
    return chest_of(b) + ap.Vec3(0, up, 0)
end

function rise_true_form(Actor b)
    b.state = S_IDLE
    b.true_form = true
    b.hp_max = b.hp_max * 1.5
    b.hp = b.hp_max
    b.power *= 1.75
    b.speed *= 1.75
    b.tempo *= 1.3
    b.super_state = 0
    b.ult_used = false
    b.iframes = 60
    b.look.accent = ap.Color(255, 40, 30)
    b.look.eyes = ap.Color(255, 60, 40)
    b.look.glowing_eyes = true
    sfx_at(SND_BOOM_BIG, b.body.position, 0.8, 0.6)
    sfx_at(SND_AMBUSH, b.body.position, 0.7, 0.7)
    burst(chest_of(b), 70, ap.Color(255, 40, 30), 7, 1.2, 0.12)
    # The portal closes; the doors seal again.
    Gate[] kept = []
    for g in lv.gates do
        if g.kind != GATE_NEXT and g.kind != GATE_INTERMISSION do
            kept.push(g)
        end
    end
    lv.gates = kept
    seal_boss(lv)
    upgrade_wait = 0
    upgrade_picks = 1
    if overlay == O_UPGRADE do
        overlay = O_NONE
    end
    boss_phase = BP_FIGHT
    boss_ticks = 0
    boss_hit_taken = false
    combat_lock = true
    alerted = true
    say("{kit_of(b).name} RISES AGAIN, RED.", ap.Color(255, 60, 50), 200)
end

# --- Revenge ----------------------------------------------------------------------------------------
# Now and then, in a boss fight, one you beat before comes back for revenge: faster, with half its
# health. A warning comes first; Death Focus in time stops it.
const int[] REVENGE_WINDOW = [330, 260, 200, 170]
var revenge_state = 0                # 0 none, 1 planned, 2 coming (Death Focus now), 3 over
var revenge_at = 0
var revenge_ticks = 0
var revenge_index = -1

function plan_revenge()
    revenge_state = 0
    if lv.mode != LEVEL_PLAIN or bosses.length == 0 do
        return
    end
    int[] pool = []
    for k in data.cleared do
        if k != lv.index and k >= 0 and k < cast.length do
            pool.push(k)
        end
    end
    var chance = [0.2, 0.3, 0.35, 0.45][data.difficulty]
    if pool.length == 0 or ap.random() > chance do
        return
    end
    revenge_index = pool[int(ap.random(0, double(pool.length) - 0.001))]
    revenge_state = 1
    revenge_at = int(ap.random(600, 2100))
end

function run_revenge()
    if revenge_state == 1 and boss_phase == BP_FIGHT and boss_ticks >= revenge_at do
        var main = boss_source()
        if main != null and (main as Actor).state != S_KNEEL do
            revenge_state = 2
            revenge_ticks = 0
            sfx(SND_GROWL, 0.6, 0.6)
            sfx(SND_THUD, 0.6, 0.5)
            say("SOMETHING YOU KILLED IS COMING BACK FOR REVENGE. DEATH FOCUS (V, THEN 1) NOW TO STOP IT.", ap.Color(255, 90, 80), REVENGE_WINDOW[data.difficulty])
        end
    end
    if revenge_state == 2 and not qte_on do
        revenge_ticks += 1
        if revenge_ticks % 40 == 0 do
            sfx(SND_THUD, 0.45, 0.6)
        end
        if revenge_ticks > REVENGE_WINDOW[data.difficulty] do
            spawn_revenge()
        end
    end
end

function spawn_revenge()
    revenge_state = 3
    if revenge_index < 0 do
        return
    end
    var room = lv.rooms[lv.boss_room]
    var ang = ap.random(0, 360)
    var at = stand_near(lv, room.center() + forward_of(ang) * (double(room.w) * TILE * 0.35))
    var b = make_boss(revenge_index)
    b.role = ROLE_REVENGE
    b.body = ap.Body(at)
    b.body.radius = 0.4 * b.look.bulk
    b.body.height = 1.8 * b.look.tall
    b.hp = b.hp_max * 0.5
    b.hp_max = b.hp
    b.speed *= 1.5
    b.tempo *= 1.3
    b.super_state = 2
    b.fade = 0
    b.think = 30
    bosses.push(b)
    sfx_at(SND_AMBUSH, at, 0.8)
    sfx_at(SND_BOOM_BIG, at, 0.5, 0.9)
    burst(at + ap.Vec3(0, 1, 0), 40, b.look.accent, 5, 1.0, 0.1)
    say("{cast[revenge_index].name} IS BACK FOR REVENGE!", b.look.accent.lerp(ap.WHITE, 0.3), 200)
end

# --- The Death Focus key prompts ---------------------------------------------------------------------------
const int QP_ENTRANCE = 0            # as a boss arrives: stun it
const int QP_REVENGE = 1             # stop one coming back
const int QP_KNEEL = 2               # tear a kneeling boss's soul out
const int QP_SATAN = 3               # end him
const int[] QP_LENGTH = [4, 4, 6, 14]
var qte_on = false
var qte_purpose = QP_ENTRANCE

function qte_window() returns int
    var w = [80, 62, 46, 40][data.difficulty]
    if qte_purpose == QP_SATAN do
        w = 48                           # Satan's fourteen keys: 0.8 s each
    end
    return w
end

function begin_qte(int purpose)
    if qte_on do
        return
    end
    qte_on = true
    qte_purpose = purpose
    if purpose == QP_ENTRANCE do
        boss_phase = BP_QTE
    end
    sfx(SND_CHARGE, 0.6, 0.6)
    qte_keys = []
    for k in 0..<QP_LENGTH[purpose] do
        qte_keys.push(int(ap.random(0, 6.99)))
    end
    qte_step = 0
    qte_ticks = 0
    player.state = S_FOCUS
    player.focus = FOCUS_DEATH
    player.focus_ticks = 0
    menu = MENU_ROOT
end

function run_qte()
    qte_ticks += 1
    var keys = [ap.KEY_R, ap.KEY_F, ap.KEY_Q, ap.KEY_1, ap.KEY_2, ap.KEY_3, ap.KEY_4]
    var want = keys[qte_keys[qte_step]]
    var wrong = false
    for k in keys do
        if pressed(k) and k != want and qte_ticks > 6 do
            wrong = true
        end
    end
    if pressed(want) and qte_ticks > 6 do
        sfx(SND_PARRY, 0.5, 1.0 + 0.06 * double(qte_step))
        qte_step += 1
        qte_ticks = 0
        burst(chest_of(player), 10, ap.Color(255, 240, 200), 3)
        if qte_step >= qte_keys.length do
            qte_end(true)
        end
    else if wrong or qte_ticks > qte_window() do
        sfx(SND_DENY, 0.5)
        sfx(SND_HIT_HEAVY, 0.7)
        if qte_purpose != QP_SATAN do
            var cost = player.hp_max * 0.12
            player.hp = math.max(player.hp - cost, 1.0)
            float_text(chest_of(player), "{int(cost)}", ap.Color(255, 90, 80))
        end
        qte_end(false)
    end
end

function qte_end(bool won)
    qte_on = false
    player.state = S_IDLE
    var p = qte_purpose
    if p == QP_ENTRANCE do
        if not won do
            say("DEATH FOCUS FAILED: YOU TOOK 12% DAMAGE.", ap.Color(255, 110, 100), 200)
        else do
            achieve("foresight")
        end
        arrive(won)
    else if p == QP_REVENGE do
        if won do
            revenge_state = 3
            say("REVENGE DENIED: {cast[revenge_index].name} STAYS DEAD.", ap.Color(255, 240, 200), 200)
            sfx(SND_BELL, 0.5, 0.8)
            achieve("revenge_denied")
        else do
            spawn_revenge()
        end
    else if p == QP_KNEEL do
        var k = kneeler()
        if won and k != null do
            begin_soul_show(k as Actor)
        else do
            kneel_ready = false
            say("DEATH FOCUS FAILED. WALK AWAY AND BACK TO TRY AGAIN.", ap.Color(255, 110, 100), 200)
        end
    else if p == QP_SATAN do
        if won do
            satan_ended()
        else do
            satan_revives()
        end
    end
end

# --- The boss's hall ---------------------------------------------------------------------------

function in_boss_room() returns bool
    if lv.boss_room < 0 do
        return false
    end
    var r = lv.rooms[lv.boss_room]
    var inner = Room(r.x + 1, r.y + 1, r.w - 2, r.h - 2)
    return inner.holds(player.body.position)
end

function run_boss_room()
    if lv.index < 0 do
        return
    end
    if qte_on do
        run_qte()
        return
    end
    if boss_phase == BP_NONE do
        if in_boss_room() and alive(player) do
            settle_hunt()
            seal_boss(lv)
            # The hall is the boss's alone: anything small that followed you in is gone.
            var hall = lv.rooms[lv.boss_room]
            Actor[] outside = []
            for f in foes do
                if not hall.holds(f.body.position) do
                    outside.push(f)
                else do
                    burst(chest_of(f), 12, lv.glow, 3, 0.6, 0.06)
                end
            end
            foes = outside
            sfx(SND_BOOM_BIG, 0.5, 0.6)
            sfx(SND_THUD, 0.7, 0.6)
            boss_phase = BP_WAIT
            boss_ticks = 0
            queue_pos = 0
            if lv.mode == LEVEL_INTERMISSION do
                say("THE INTERMISSION: THREE OF THE LAST FIVE, ONE AFTER ANOTHER.", ap.Color(255, 90, 120), 260)
            else do
                say("BOSS ROOM: THE DOORS ARE SEALED. THE BOSS ARRIVES IN A FEW SECONDS.", ap.Color(255, 120, 110), 240)
            end
        end
        return
    end
    boss_ticks += 1
    if boss_phase == BP_WAIT do
        if boss_ticks % 120 == 60 do
            # A heartbeat while it comes.
            sfx(SND_THUD, 0.4, 0.5)
        end
        if boss_ticks == 150 do
            say("PRESS V, THEN 1 FOR DEATH FOCUS: WIN THE KEY PROMPTS TO STUN AND DAMAGE THE BOSS AS IT ARRIVES", ap.Color(255, 230, 200), 260)
        end
        if boss_ticks > [520, 460, 380, 340][data.difficulty] do
            arrive(false)
        end
    else if boss_phase == BP_ARRIVE do
        if boss_ticks == 70 and bosses.length > 0 do
            sfx_at(SND_KIAI, bosses[0].body.position, 0.5, 0.8)
        end
        if boss_ticks > ARRIVE_TICKS do
            boss_phase = BP_FIGHT
            boss_ticks = 0
            alerted = true
            combat_lock = true
            boss_hit_taken = false
            plan_revenge()
        end
    else if boss_phase == BP_FIGHT do
        run_revenge()
    end
end

function arrival_index() returns int
    if lv.mode == LEVEL_INTERMISSION and queue_pos < lv.queue.length do
        return lv.queue[queue_pos]
    end
    return lv.index
end

function arrive(bool seen_coming)
    boss_phase = BP_ARRIVE
    boss_ticks = 0
    qte_won = seen_coming
    player.state = S_IDLE
    var b = make_boss(arrival_index())
    if lv.mode == LEVEL_INTERMISSION do
        # Strange here: a little more of them.
        b.hp *= 0.8
        b.hp_max = b.hp
    end
    bosses = [b]
    sfx_at(SND_AMBUSH, b.body.position, 0.8)
    sfx_at(SND_BOOM_BIG, b.body.position, 0.6, 0.8)
    if seen_coming do
        b.state = S_HURT
        b.stun = 200
        b.stun_total = 200
        b.hp -= b.hp_max * 0.12
        say("DEATH FOCUS SUCCEEDED: THE BOSS IS STUNNED AND LOST 12% HEALTH.", ap.Color(255, 240, 200), 220)
    end
    burst(b.body.position + ap.Vec3(0, 1, 0), 40, lv.glow, 5, 1.2, 0.1)
end
var queue_pos = 0

# --- The end: the dark past the last hall ----------------------------------------------------------------
const int FP_NONE = 0
const int FP_QUIET = 1               # the last boss is down: the music fades, then a wall comes down
const int FP_BREACH = 2              # the way into the dark is open
const int FP_LIGHTS = 3              # a floodlight: every boss there is, waiting
const int FP_ARMY = 4                # three shots of the whole army, before it attacks
const int FP_GAUNTLET = 5            # ...and then running at Scarf
const int FP_SATAN_RISE = 6          # HELL: something comes up out of the floor
const int FP_SATAN = 7
const int FP_SATAN_DOWN = 8          # he is down: Death Focus, now, or he gets up again
const int FP_ENDING = 9              # the screen goes black (then, on HELL, the field; then the end)
const int ARMY_SHOT = 150            # ticks per shot (three of them)

# The last fight is a test of endurance: nothing stuns Scarf in it.
function unstunnable() returns bool
    return lv.mode == LEVEL_FINAL and final_phase >= FP_LIGHTS and final_phase < FP_ENDING
end
var army_center = ap.Vec3(0, 0, 0)    # the middle of the army
var army_front = ap.Vec3(0, 0, 0)     # the middle of its front row
var army_ahead = ap.Vec3(0, 0, 1)     # from Scarf toward it
var army_from = ap.Vec3(0, 0, 0)      # where Scarf stood when the light came on
var final_phase = FP_NONE
var final_ticks = 0
var flood = 0.0                      # the floodlight, 0 off .. 1 on
var void_dark = 0.0                  # how far into the dark Scarf has walked (0 .. 1)
const int SATAN_WINDOW = 360         # ticks to start the last Death Focus before he rises again

function final_breach()
    final_phase = FP_QUIET
    final_ticks = 0
    say("THERE IS NO PORTAL.", ap.Color(220, 210, 230), 200)
end

function break_wall()
    var hall = lv.rooms[lv.boss_room]
    var east = hall.x + hall.w
    for y in 0..<lv.h do
        for x in east..<lv.w do
            var gap = y >= hall.y + 3 and y < hall.y + hall.h - 3
            var k = cell_at(lv, x, y)
            if gap or (x >= lv.dark_x and (k == CELL_VOID or k == CELL_WALL)) do
                set_cell(lv, x, y, CELL_DARK)
            end
        end
    end
    var at = cell_center(east, hall.y + hall.h // 2)
    for n in 0..<5 do
        lv.props.push(Prop(PROP_CRATER, at + ap.Vec3(ap.random(-1.2, 1.2), 0, ap.random(-4, 4)), ap.random(0.6, 1.2), ap.random(0, 360)))
    end
    build_world(lv)
    for n in 0..<6 do
        burst(at + ap.Vec3(0, ap.random(0.5, 3.5), ap.random(-4, 4)), 20, lv.wall_color.lerp(ap.WHITE, 0.2), 7, 1.2, 0.18)
    end
    sfx(SND_BOOM_BIG, 0.9, 0.6)
    sfx(SND_THUD, 0.8, 0.5)
    sfx(SND_CREAK, 0.6, 0.5)
    say("A WALL OF THE HALL HAS COME DOWN. BEYOND IT: NOTHING.", ap.Color(220, 210, 230), 260)
end

function run_final()
    if lv.mode != LEVEL_FINAL or final_phase == FP_NONE do
        return
    end
    final_ticks += 1
    var hall = lv.rooms[lv.boss_room]
    if final_phase == FP_QUIET and final_ticks == 150 do
        break_wall()
        final_phase = FP_BREACH
        final_ticks = 0
    end
    if final_phase == FP_BREACH do
        var into = (player.body.position.x / TILE - double(hall.x + hall.w)) / 9
        void_dark = ap.approach(void_dark, math.clamp(into, 0.0, 1.0), 0.02)
        if flat_distance(player.body.position, lv.death_at) < 7 do
            lights_on()
        end
    else if final_phase >= FP_LIGHTS do
        flood = math.min(flood + 0.05, 1.0)
    end
    if final_phase == FP_LIGHTS and final_ticks > 170 do
        final_phase = FP_ARMY
        final_ticks = 0
    end
    if final_phase == FP_ARMY do
        if final_ticks % ARMY_SHOT == 1 do
            # Each cut lands on a drum hit.
            sfx(SND_THUD, 0.9, 0.45 + 0.08 * double(final_ticks // ARMY_SHOT))
            sfx(SND_BOOM, 0.5, 0.5)
        end
        if final_ticks == ARMY_SHOT * 2 + 40 do
            sfx(SND_GROWL, 0.9, 0.5)
            sfx(SND_AMBUSH, 0.6, 0.5)
        end
        if final_ticks >= ARMY_SHOT * 3 do
            final_phase = FP_GAUNTLET
            final_ticks = 0
            say("RUN.", ap.Color(255, 90, 80), 90)
            sfx(SND_AMBUSH, 0.8, 0.7)
            combat_lock = true
            alerted = true
        end
    end
    if final_phase == FP_BREACH and final_ticks % 1500 == 1200 do
        say("LOST IN THE DARK? TREASURE FOCUS (V, THEN 1) SHOWS THE WAY TO DEATH.", ap.Color(230, 220, 230), 300)
    end
    if final_phase == FP_GAUNTLET do
        # Only the nearest few close in at a time; the rest circle, waiting their turn.
        Actor[] living = []
        for b in bosses do
            b.may_attack = false
            if alive(b) do
                living.push(b)
            end
        end
        for pick in 0..<math.min(6, living.length) do
            var best = -1
            var near = 1000.0
            for k, b in living do
                var d = flat_distance(b.body.position, player.body.position)
                if not b.may_attack and d < near do
                    near = d
                    best = k
                end
            end
            if best >= 0 do
                living[best].may_attack = true
            end
        end
    end
    if final_phase == FP_SATAN_RISE do
        if bosses.length > 0 and bosses[bosses.length - 1].rise >= 1 do
            final_phase = FP_SATAN
            final_ticks = 0
            combat_lock = true
        end
        if final_ticks % 30 == 0 do
            sfx(SND_THUD, 0.6, 0.4)
        end
    end
    if final_phase == FP_SATAN_DOWN do
        if final_ticks > SATAN_WINDOW and not qte_on do
            satan_revives()
        end
    end
end

# The three shots of the army, letterboxed: from low behind Scarf, pushing in; along its front
# row, face after face; then craning up and back over Scarf to take in all of it.
function final_camera() returns bool
    if lv.mode != LEVEL_FINAL or final_phase != FP_ARMY do
        return false
    end
    var shot = math.min(final_ticks // ARMY_SHOT, 2)
    var t = puppet.smooth(double(final_ticks % ARMY_SHOT) / double(ARMY_SHOT))
    var up = ap.Vec3(0, 1, 0)
    var side = ap.Vec3(army_ahead.z, 0, -army_ahead.x)
    var eye = army_from
    var look = army_center
    if shot == 0 do
        eye = army_from - army_ahead * (4.5 - 2.5 * t) + side * 1.2 + up * 0.7
        look = army_center + up * 1.6
    else if shot == 1 do
        eye = army_front - army_ahead * 2.6 + side * (9 - 18 * t) + up * 1.5
        look = eye + army_ahead * 6 - side * 1.5 - up * 0.2
    else do
        eye = army_from - army_ahead * (2 + 6 * t) + up * (2 + 9 * t)
        look = army_center + up * (1.2 - 0.8 * t)
    end
    camera = ap.Camera3D(eye, look)
    camera.fov = 48 if shot != 1 else 40
    return true
end

# The floodlight comes on: every boss there is, standing in the dark ahead.
function lights_on()
    final_phase = FP_LIGHTS
    final_ticks = 0
    void_dark = 0
    sfx(SND_LATCH, 0.9, 0.45)
    sfx(SND_THUD, 0.9, 0.35)
    sfx(SND_BOOM, 0.6, 0.4)
    var ahead = unit(flat(lv.death_at - player.body.position))
    var side = ap.Vec3(ahead.z, 0, -ahead.x)
    var center = player.body.position + ahead * 15
    bosses = []
    # The formation, then shifted as a whole so every spot is inside the map (Scarf stands
    # near its east edge when the light comes on), then each one on ground it can stand on.
    ap.Vec3[] spots = []
    for k in 0..<cast.length do
        var row = k // 11
        var col = k % 11
        spots.push(center + side * ((double(col) - 5) * 2.2 + (1.1 if row % 2 == 1 else 0.0)) + ahead * (double(row) * 2.3))
    end
    var lo_x = 1000000.0
    var hi_x = -1000000.0
    var lo_z = 1000000.0
    var hi_z = -1000000.0
    for sp in spots do
        lo_x = math.min(lo_x, sp.x)
        hi_x = math.max(hi_x, sp.x)
        lo_z = math.min(lo_z, sp.z)
        hi_z = math.max(hi_z, sp.z)
    end
    var margin = TILE * 2.5
    var max_x = double(lv.w) * TILE - margin
    var max_z = double(lv.h) * TILE - margin
    var shift = ap.Vec3(0, 0, 0)
    if hi_x > max_x do
        shift.x = max_x - hi_x
    else if lo_x < margin do
        shift.x = margin - lo_x
    end
    if hi_z > max_z do
        shift.z = max_z - hi_z
    else if lo_z < margin do
        shift.z = margin - lo_z
    end
    for k in 0..<cast.length do
        var at = stand_near(lv, spots[k] + shift)
        var b = make_boss(k)
        b.role = ROLE_GAUNTLET
        b.body = ap.Body(at)
        b.body.radius = 0.4 * b.look.bulk
        b.body.height = 1.8 * b.look.tall
        b.hp = 26 * [1.2, 1.5, 1.95, 1.2][data.difficulty]
        b.hp_max = b.hp
        b.power *= 0.55
        b.fade = 1
        b.super_state = 2
        b.heading = heading_of(flat(player.body.position - at))
        bosses.push(b)
    end
    army_from = player.body.position
    army_center = ap.Vec3(0, 0, 0)
    army_front = ap.Vec3(0, 0, 0)
    for k, b in bosses do
        army_center = army_center + b.body.position / double(bosses.length)
        if k < 11 do
            army_front = army_front + b.body.position / 11.0
        end
    end
    army_ahead = unit(flat(army_center - army_from))
    foes = []
    say("", ap.WHITE, 1)
end

function gauntlet_won()
    achieve("gauntlet")
    combat_lock = false
    if data.difficulty == DIFF_HELL do
        final_phase = FP_SATAN_RISE
        final_ticks = 0
        var ahead = unit(flat(lv.death_at - player.body.position))
        var s = make_satan(player.body.position + ahead * 9)
        s.heading = heading_of(flat(player.body.position - s.body.position))
        bosses = [s]
        sfx(SND_BOOM_BIG, 0.9, 0.4)
        sfx(SND_GROWL, 0.9, 0.4)
        say("THE FLOOR SPLITS OPEN.", ap.Color(255, 80, 40), 240)
    else do
        start_ending()
    end
end

function satan_down(Actor s)
    s.hp = 1
    s.state = S_KNEEL
    final_phase = FP_SATAN_DOWN
    final_ticks = 0
    sfx_at(SND_BOOM_BIG, s.body.position, 0.8, 0.5)
    say("HE IS DOWN. DEATH FOCUS (V, THEN 1) - NOW, BEFORE HE RISES.", ap.Color(255, 230, 200), SATAN_WINDOW)
end

function satan_revives()
    for b in bosses do
        if b.role == ROLE_SATAN do
            b.state = S_IDLE
            b.hp = b.hp_max * 0.25
            b.iframes = 60
            burst(chest_of(b), 60, ap.Color(255, 80, 30), 7, 1.0, 0.12)
            sfx_at(SND_GROWL, b.body.position, 0.9, 0.4)
        end
    end
    final_phase = FP_SATAN
    final_ticks = 0
    say("HE RISES AGAIN.", ap.Color(255, 70, 40), 160)
end

function satan_ended()
    for b in bosses do
        if b.role == ROLE_SATAN do
            b.hp = 0
            b.state = S_DEAD
            b.frame = 0
            burst(chest_of(b), 120, ap.Color(255, 90, 30), 9, 2.0, 0.16)
        end
    end
    achieve("devil")
    start_ending()
end

# --- The ending: black, then a field, then the end ---------------------------------------------------------
var ending_phase = 0                 # 0 none, 1 going black, 2 the field, 3 black again, 4 the win screen
var ending_ticks = 0
const int ENDING_BLACK = 240
const int ENDING_FIELD = 1080
const int ENDING_OUT = 200

function start_ending()
    final_phase = FP_ENDING
    ending_phase = 1
    ending_ticks = 0
    combat_lock = false
    data.runs_won += 1
    store()
    if data.difficulty != DIFF_HELL do
        # Only HELL wakes up in the field; the rest simply win.
        ending_phase = 4
        open_overlay(O_WIN)
    end
end

function run_ending()
    if ending_phase == 0 do
        return
    end
    ending_ticks += 1
    if ending_phase == 1 and ending_ticks > ENDING_BLACK do
        ending_phase = 2
        ending_ticks = 0
        release_mouse()
    else if ending_phase == 2 and ending_ticks > ENDING_FIELD do
        ending_phase = 3
        ending_ticks = 0
    else if ending_phase == 3 and ending_ticks > ENDING_OUT do
        ending_phase = 4
        ending_ticks = 0
        achieve("awake")
        open_overlay(O_WIN)
    end
end

# --- Things to find -------------------------------------------------------------------------------

function run_things()
    var here = player.body.position
    # The gun on the threshold: it is wherever you end up walking.
    if lv.index < 0 and not gun_dropped and walked > 15 do
        var way = steer_way()
        if way.length() < 0.2 do
            way = forward_of(player.heading)
        end
        var at = here + unit(way) * 4.5
        at = ap.Vec3(math.clamp(at.x, 4.0, double(lv.w) * TILE - 4), 0, math.clamp(at.z, 4.0, double(lv.h) * TILE - 4))
        pickups.push(Pickup(at, 0))
        gun_dropped = true
    end
    for pk in pickups do
        pk.appear = math.min(pk.appear + 0.01, 1.0)
        if not pk.taken and flat_distance(pk.at, here) < 1.3 do
            pk.taken = true
            sfx(SND_LATCH, 0.6)
            sfx(SND_UNSHEATHE, 0.4, 1.2)
            take_weapon(pk.weapon)
            if pk.weapon == 0 and not data.tutorial do
                if data.tutorial_seen do
                    # Seen it before (an earlier run): straight on to the portal.
                    data.tutorial = true
                    store()
                    say("A PORTAL HAS OPENED AHEAD OF YOU: WALK INTO IT TO START LEVEL 1.", ap.Color(255, 230, 200), 260)
                else do
                    tutorial_page = 0
                    open_overlay(O_TUTORIAL)
                end
            end
            if lv.index < 0 do
                var gate = Gate(here + forward_of(player.heading) * 9, 0)
                gate.open = true
                lv.gates.push(gate)
                sfx_at(SND_RIFT, gate.at, 0.6, 0.8)
            end
        end
    end
    for c in lv.chests do
        if c.opened do
            c.lid = math.min(c.lid + 0.05, 1.0)
        else if flat_distance(c.at, here) < 1.6 and alive(player) do
            c.opened = true
            sfx_at(SND_CREAK, c.at, 0.6)
            sfx_at(SND_COINS, c.at, 0.5)
            for k in 0..<math.min(c.souls, 14) do
                souls.push(Soul(c.at + ap.Vec3(0, 0.6, 0), ap.Vec3(ap.random(-2, 2), ap.random(3, 5), ap.random(-2, 2)), c.souls // 14 + 1))
            end
            if c.weapon >= 0 do
                sfx(SND_UNSHEATHE, 0.5)
                take_weapon(c.weapon)
            end
            store()
        end
    end
    for k, b in lv.books do
        var d = flat_distance(b.at, here)
        if d > 2.6 do
            b.ready = true
        end
        if b.red do
            if b.fly < 1 do
                b.fly = math.min(b.fly + 1.0 / 80, 1.0)
            end
            if not b.taken and b.ready and b.fly >= 1 and d < 1.6 and alive(player) and overlay == O_NONE do
                b.ready = false
                read_book = k
                sfx(SND_BOOK, 0.6, 0.7)
                open_overlay(O_REDBOOK)
            end
            continue
        end
        if not b.taken and b.ready and d < 1.4 and alive(player) and overlay == O_NONE do
            # An attempt: it costs health up front, then the text has to be copied out.
            b.ready = false
            sfx(SND_BOOK, 0.6)
            sfx(SND_RIFT, 0.4, 0.7)
            read_book = k
            read_art = b.art
            read_pos = 0
            read_chances = CHANCES
            read_state = 0
            read_wrong = 0
            read_cost = player.hp_max * TIER_COST[ART_TIER[b.art]]
            player.hp = math.max(player.hp - read_cost, 1.0)
            typed_text = ""
            # Whatever is held as it opens (walking into it with W, say) does not count until
            # it is let go and pressed again.
            read_held = []
            for key in typing_keys() do
                if down(key) do
                    read_held.push(key)
                end
            end
            open_overlay(O_READ)
        end
    end
    if lv.has_shop and flat_distance(lv.shop, here) < 2.0 and not alerted and alive(player) do
        if overlay == O_NONE and shop_ready do
            open_overlay(O_SHOP)
            sfx(SND_COINS, 0.5)
            shop_ready = false
        end
    else do
        shop_ready = true
    end
    for i, sp in lv.spots do
        var d = flat_distance(sp.at, here)
        if d > 2.8 do
            sp.ready = true
        end
        if d < 1.8 and sp.ready and not alerted and alive(player) and overlay == O_NONE do
            sp.ready = false
            spot_at = i
            gamble_said = ""
            open_overlay(O_GAMBLER if sp.kind == ROOM_GAMBLER else (O_FORGE if sp.kind == ROOM_FORGE else O_SHRINE))
            sfx(SND_COINS if sp.kind == ROOM_GAMBLER else (SND_CLASH_B if sp.kind == ROOM_FORGE else SND_RIFT), 0.5, 0.8)
        end
    end
    if lv.has_dojo and flat_distance(lv.dojo, here) < 1.8 and not alerted and alive(player) do
        if not has(data.dojos, lv.index) do
            data.dojos.push(lv.index)
            store()
        end
        if overlay == O_NONE and ticks % 1 == 0 and dojo_ready do
            open_overlay(O_DOJO)
            sfx(SND_BELL, 0.45)
            dojo_ready = false
        end
    else do
        dojo_ready = true
    end
    for g in lv.gates do
        g.grow = math.min(g.grow + 0.012, 1.0)
        if g.open and g.grow > 0.6 and flat_distance(g.at, here) < 1.2 and alive(player) do
            if g.to >= cast.length do
                say("THAT WAS THE LAST LEVEL: EVERY BOSS IS DEFEATED.", ap.Color(255, 230, 200), 400)
                g.open = false
            else if g.kind == GATE_INTERMISSION do
                sfx(SND_WISP, 0.6, 0.5)
                sfx(SND_RIFT, 0.6, 0.6)
                start_intermission(g.to - 1)
                return
            else do
                sfx(SND_WISP, 0.6, 0.8)
                sfx(SND_RIFT, 0.5, 1.2)
                start_level(g.to)
                return
            end
        end
    end
    if data.souls >= 1000 do
        achieve("hoarder")
    end
    # Souls drift up, then come to you.
    Soul[] kept = []
    for s in souls do
        s.age += 1.0 / 60
        if s.age < 0.6 do
            s.vel = s.vel + ap.Vec3(0, -6.0 / 60, 0)
            s.vel = s.vel * 0.96
        else do
            var to = chest_of(player) - s.at
            s.vel = s.vel * 0.85 + unit(to) * 1.6
        end
        s.at = s.at + s.vel * (1.0 / 60)
        if s.at.y < 0.3 do
            s.at = ap.Vec3(s.at.x, 0.3, s.at.z)
        end
        if s.age > 0.6 and (chest_of(player) - s.at).length() < 0.6 do
            data.souls += s.value
            sfx(one_of([SND_COIN_A, SND_COIN_B]), 0.2, ap.random(1.4, 1.8))
        else do
            kept.push(s)
        end
    end
    souls = kept
end
var dojo_ready = true
var shop_ready = true

function take_weapon(int weapon)
    if not has(data.weapons, weapon) do
        data.weapons.push(weapon)
    end
    if weapon == 0 do
        achieve("armed")
    end
    say("FOUND: {WEAPON_NAMES[weapon]}" if weapon != 0 else "FOUND: THE GUN", ap.Color(255, 220, 160), 220)
    if data.weapon < 0 or weapon == 0 do
        equip(weapon)
    end
    store()
end

function equip(int weapon)
    data.weapon = weapon
    player.look.weapon = WEAPON_LOOKS[weapon] if weapon >= 0 else roster.WEAPON_HANDS
    if weapon == 0 do
        ammo = 6
    end
end

function dojo_price(int stance) returns int
    var wobble = 0.82 + double((lv.index * 7 + stance * 3) % 5) * 0.09
    return int(double(STANCE_PRICE[stance]) * wobble)
end

# --- Shots and the rest ------------------------------------------------------------------------------

function run_bolts()
    var dt = 1.0 / 60
    Bolt[] kept = []
    for b in bolts do
        b.life -= dt
        if b.homing > 0 and not b.mine and alive(player) do
            var want = unit(chest_of(player) - b.at)
            var speed = b.vel.length()
            var turn = b.homing * math.PI / 180 * dt
            b.vel = unit(unit(b.vel) + want * turn) * speed
        end
        var done = false
        if b.mine_wait do
            # A mine: still until Scarf steps near, then it goes off.
            if alive(player) and flat_distance(player.body.position, b.at) < 1.3 do
                explode(b, b.at)
                if flat_distance(player.body.position, b.at) < b.blast + 0.4 do
                    hurt(player, b.damage, 20, b.at, 4, 3, boss_source(), null)
                end
                done = true
            end
            if b.life <= 0 do
                done = true
            end
            if not done do
                kept.push(b)
            end
            continue
        end
        var step = b.vel * dt
        var wall = lv.world.raycast(ap.Ray(b.at, unit(step)), step.length())
        if wall.found and b.ricochet and b.mine and b.hops == 0 do
            # A Ricochet Shot that found no one: off the wall and straight back at Scarf. A dodge
            # (or a block) is the only way out.
            punish_ricochet(b, wall.point + wall.normal * 0.1)
            streaks.push(Streak(wall.point - step, wall.point, b.color, 0.25, 0.25, 0.03))
            burst(wall.point, 10, ap.Color(255, 230, 160), 3, 0.25, 0.05)
            sfx_at(SND_RICOCHET, wall.point, 0.6, ap.random(0.9, 1.3))
        else if wall.found do
            burst(wall.point, 6, b.color, 2, 0.3, 0.05)
            if b.mine and b.size < 0.1 do
                sfx_at(SND_RICOCHET, wall.point, 0.3, ap.random(0.8, 1.3))
            else do
                sfx_at(SND_THUD, wall.point, 0.25, 1.4)
            end
            if b.blast > 0 do
                explode(b, wall.point)
            end
            done = true
            if b.knife do
                pickups.push(Pickup(ap.Vec3(wall.point.x, 0, wall.point.z), 1))
                pickups[pickups.length - 1].taken = true
            end
        else do
            b.at = b.at + step
            if b.at.y < 0.05 and b.blast > 0 do
                # Something falling from the sky lands.
                explode(b, ap.Vec3(b.at.x, 0.1, b.at.z))
                done = true
            else if b.mine do
                for t in targets_of(player) do
                    var already = false
                    for h in b.pierced do
                        if h == t do
                            already = true
                        end
                    end
                    if already do
                        continue
                    end
                    if (chest_of(t) - b.at).length() < 0.55 + t.body.radius do
                        ranged_hit = true
                        var how = Move("", "", roster.Attack(""), 0, 0, 0, b.fx, b.fx_time)
                        how.src = b.src
                        hurt(t, b.damage, b.stun, b.at - b.vel, 1.5, 0, player, how if b.fx != FX_NONE or b.src != SRC_BASIC else null)
                        ranged_hit = false
                        burst(b.at, 8, b.color, 3, 0.3, 0.06)
                        if b.pierce do
                            # Straight on through, and harder past each one.
                            b.pierced.push(t)
                            b.damage *= 1.4
                            b.size = math.min(b.size * 1.15, 0.2)
                            burst(b.at, 14, ap.Color(255, 230, 160), 5, 0.3, 0.06)
                            sfx_at(SND_HIT_HEAVY, b.at, 0.4, 1.3)
                            continue
                        end
                        if b.blast > 0 do
                            explode(b, b.at)
                        end
                        if b.ricochet do
                            # On to the nearest other one, harder each hop. None left to hop to on the
                            # first: it comes back at Scarf.
                            b.pierced.push(t)
                            var next_one = -1
                            var near = 11.0
                            var all = targets_of(player)
                            for k, o in all do
                                var d = (chest_of(o) - b.at).length()
                                var hit_before = false
                                for h in b.pierced do
                                    if h == o do
                                        hit_before = true
                                    end
                                end
                                if not hit_before and d < near and lv.world.sees(b.at, chest_of(o)) do
                                    near = d
                                    next_one = k
                                end
                            end
                            if next_one >= 0 and b.bounces > 0 do
                                b.bounces -= 1
                                b.hops += 1
                                b.damage *= 1.5
                                b.life = 2
                                sfx_at(SND_RICOCHET, b.at, 0.5)
                                streaks.push(Streak(b.at, chest_of(all[next_one]), ap.Color(255, 230, 160), 0.2, 0.2, 0.02))
                                b.vel = unit(chest_of(all[next_one]) - b.at) * b.vel.length()
                                b.at = b.at + unit(b.vel) * 0.7
                                if b.hops >= 2 do
                                    achieve("ricochet")
                                end
                                break
                            else if b.hops == 0 do
                                punish_ricochet(b, b.at)
                                sfx_at(SND_RICOCHET, b.at, 0.6, 0.8)
                                break
                            end
                        end
                        done = true
                        break
                    end
                end
            else if alive(player) and (chest_of(player) - b.at).length() < 0.6 + (0.3 if b.size > 0.25 else 0.0) do
                var who = boss_source()
                var before = player.hp
                if b.blast > 0 do
                    explode(b, b.at)
                else do
                    hurt(player, b.damage, b.stun if who != null else 0, b.at - b.vel, 1, 0, who, null)
                end
                if player.hp < before do
                    player.poison = math.max(player.poison, b.poison)
                    player.freeze = math.max(player.freeze, b.slow * 0.6)
                end
                done = true
            end
        end
        if b.life <= 0 do
            done = true
        end
        if not done do
            kept.push(b)
            if ticks % 2 == 0 do
                motes.push(Mote(b.at, ap.Vec3(0, 0, 0), b.color, 0.2, 0.2, b.size * 0.7))
            end
        end
    end
    bolts = kept
end

# Whoever is fighting Scarf, for the hits of shots (a boss staggers Scarf; the small dead do not).
function boss_source() returns Actor?
    for b in bosses do
        if alive(b) do
            return b
        end
    end
    return null
end

# A ricochet with no one to hop to turns on its shooter.
function punish_ricochet(Bolt b, ap.Vec3 at)
    b.at = at
    b.mine = false
    b.ricochet = false
    b.homing = 240
    b.life = 2.5
    b.color = ap.Color(255, 120, 80)
    b.stun = 16
    b.vel = unit(chest_of(player) - at) * math.max(b.vel.length() * 0.8, 18.0)
    float_text(at + ap.Vec3(0, 0.4, 0), "NO ONE TO HOP TO", ap.Color(255, 160, 120))
end

function explode(Bolt b, ap.Vec3 at)
    sfx_at(SND_BOOM, at, 0.6)
    burst(at, 26, b.color, 5, 0.6, 0.1)
    if b.mine do
        for t in targets_of(player) do
            if (chest_of(t) - at).length() < b.blast + t.body.radius do
                var how = Move("")
                how.src = b.src
                hurt(t, b.damage * (1.0 if b.src == SRC_ART else 0.5), 20, at, 5, 0, player, how)
            end
        end
    else if alive(player) and flat_distance(player.body.position, at) < b.blast + 0.3 and player.lift < 2 do
        hurt(player, b.damage, 18, at, 4, 0, boss_source(), null)
    end
end

function run_effects()
    var dt = 1.0 / 60
    var changed = false
    Prop[] standing = []
    for pr in lv.props do
        if pr.life > 0 do
            pr.rise = math.min(pr.rise + 0.08, 1.0)
            pr.life -= dt
            if pr.life <= 0 do
                changed = true
                burst(pr.at + ap.Vec3(0, 0.5, 0), 10, ap.Color(170, 150, 120), 2, 0.5, 0.08)
                continue
            end
        end
        standing.push(pr)
    end
    if changed do
        lv.props = standing
        build_world(lv)
    end
    Mark[] left = []
    for mk in marks do
        mk.life -= dt
        if mk.life > 0 do
            left.push(mk)
        end
    end
    marks = left
    if super_banner > 0 do
        super_banner -= 1
    end
    Mote[] kept = []
    for m in motes do
        m.life -= dt
        m.vel = m.vel + ap.Vec3(0, -m.gravity * dt, 0)
        m.at = m.at + m.vel * dt
        if m.life > 0 do
            kept.push(m)
        end
    end
    motes = kept
    Streak[] ks = []
    for s in streaks do
        s.life -= dt
        if s.life > 0 do
            ks.push(s)
        end
    end
    streaks = ks
    Floater[] kf = []
    for f in floaters do
        f.life -= dt
        f.at = f.at + ap.Vec3(0, 0.9 * dt, 0)
        if f.life > 0 do
            kf.push(f)
        end
    end
    floaters = kf
    # The air: drifting motes in the level's color, near you.
    if ticks % 9 == 0 do
        var at = player.body.position + ap.Vec3(ap.random(-8, 8), ap.random(0, 3), ap.random(-8, 8))
        motes.push(Mote(at, ap.Vec3(0, 0.25, 0), lv.mote.fade(0.6), 3, 3, 0.04))
    end
end

# Where Scarf has been: the minimap shows only that (and whatever is in it).
var map_dirty = false
function explore()
    if lv.index < 0 do
        return
    end
    var c = cell_of(player.body.position)
    var span = 5
    for dy in -span..<(span + 1) do
        for dx in -span..<(span + 1) do
            var x = c[0] + dx
            var y = c[1] + dy
            if x < 0 or y < 0 or x >= lv.w or y >= lv.h do
                continue
            end
            var k = y * lv.w + x
            if not lv.explored[k] and dx * dx + dy * dy <= span * span do
                lv.explored[k] = true
                map_dirty = true
            end
        end
    end
    if map_dirty and ticks % 12 == 0 do
        map_dirty = false
        make_minimap()
        # What has come into sight is known now.
        for ch in lv.chests do
            ch.known = ch.known or explored_at(ch.at)
        end
        for b in lv.books do
            b.known = b.known or explored_at(b.at)
        end
        for g in lv.gates do
            g.known = g.known or explored_at(g.at)
        end
        for sp in lv.spots do
            sp.known = sp.known or explored_at(sp.at)
        end
        lv.shop_known = lv.shop_known or (lv.has_shop and explored_at(lv.shop))
        lv.dojo_known = lv.dojo_known or (lv.has_dojo and explored_at(lv.dojo))
        if lv.boss_room >= 0 and not lv.boss_known do
            var r = lv.rooms[lv.boss_room]
            for y in r.y..<(r.y + r.h) do
                for x in r.x..<(r.x + r.w) do
                    if lv.explored[y * lv.w + x] do
                        lv.boss_known = true
                    end
                end
            end
        end
    end
end
function explored_at(ap.Vec3 p) returns bool
    var c = cell_of(p)
    if c[0] < 0 or c[1] < 0 or c[0] >= lv.w or c[1] >= lv.h do
        return false
    end
    return lv.explored[c[1] * lv.w + c[0]]
end

# The dark gives way around Scarf, slowly.
function run_reveal()
    # Once Scarf has the gun the dark lifts, everywhere.
    if lv.index >= 0 or has(data.weapons, 0) do
        light_up = math.min(light_up + 1.0 / 180, 1.0)
    end
    if light_up > 0 do
        for k in 0..<lv.reveal.length do
            if lv.reveal[k] < light_up do
                lv.reveal[k] = light_up
            end
        end
    end
    var c = cell_of(player.body.position)
    var span = int(REVEAL_RADIUS / TILE) + 1
    for dy in -span..<(span + 1) do
        for dx in -span..<(span + 1) do
            var x = c[0] + dx
            var y = c[1] + dy
            if x < 0 or y < 0 or x >= lv.w or y >= lv.h do
                continue
            end
            var d = flat_distance(cell_center(x, y), player.body.position)
            if d < REVEAL_RADIUS do
                var k = y * lv.w + x
                lv.reveal[k] = math.min(lv.reveal[k] + REVEAL_RATE * (1 - d / REVEAL_RADIUS) * 2, 1.0)
            end
        end
    end
end

# --- A whole tick ------------------------------------------------------------------------------------

function step_world()
    admin_tick()
    if ending_phase > 0 do
        run_ending()
        run_effects()
        return
    end
    control_player()
    update_items()
    var refill = items.more(item_fx(items.E_BAR))
    stamina = math.min(stamina + (14.0 if player.state == S_IDLE else 5.0) * refill / 60, data.max_stamina)
    mana = math.min(mana + 1.6 * refill / 60, data.max_mana)
    run_reload()
    warcry_time = math.max(warcry_time - 1.0 / 60, 0.0)
    venom_time = math.max(venom_time - 1.0 / 60, 0.0)
    super_tint = ap.approach(super_tint, 1.0 if boss_in_super() else 0.0, 0.015)
    explore()
    run_soul_show()
    for k in 0..<cools.length do
        if cools[k] > 0 do
            cools[k] -= 1
        end
    end
    if focus_left > 0 do
        focus_left -= 1
    end
    if focus_cool > 0 do
        focus_cool -= 1
    end
    # A boss's entrance and the Death Focus moment hold everything else still.
    var held_still = boss_phase == BP_ARRIVE or qte_on or soul_show > 0
    if held_still do
        player.iframes = math.max(player.iframes, 2)
    end
    for e in foes do
        if not held_still do
            run_enemy(e)
        end
    end
    Actor[] kept = []
    for e in foes do
        if alive(e) or e.frame < 160 do
            kept.push(e)
        end
    end
    foes = kept
    for b in bosses do
        if not held_still or b.state == S_KNEEL or (boss_phase == BP_ARRIVE and qte_on == false) do
            run_boss(b)
        end
    end
    if not held_still do
        run_bolts()
        run_portals()
    end
    run_spikes()
    run_effects()
    run_reveal()
    run_boss_room()
    run_final()
    run_things()
    # In a fight, or out of one.
    var any_aware = false
    for f in foes do
        if alive(f) and f.aware do
            any_aware = true
        end
    end
    if boss_phase == BP_FIGHT or boss_phase == BP_ARRIVE or final_phase == FP_GAUNTLET or final_phase == FP_SATAN do
        any_aware = true
    end
    alerted = any_aware
    if any_aware do
        calm_ticks = 0
    else do
        calm_ticks += 1
        if calm_ticks > 120 do
            combat_lock = false
        end
    end
    if title_ticks < 100000 do
        title_ticks += 1
    end
    if hint_ticks > 0 do
        hint_ticks -= 1
    end
    if upgrade_wait > 0 do
        upgrade_wait -= 1
        if upgrade_wait == 0 and offers.length > 0 do
            open_overlay(O_UPGRADE)
            sfx(SND_BELL, 0.5, 1.2)
        end
    end
end

# The entrance's camera: low in front of the boss, pushing slowly in on its face as it poses,
# then easing back to Scarf's shoulder.
function arrival_camera() returns bool
    if boss_phase != BP_ARRIVE or bosses.length == 0 do
        return false
    end
    var b = bosses[0]
    var t = double(boss_ticks)
    if t > double(ARRIVE_TICKS) - 30 do
        return false
    end
    var face = b.body.position + ap.Vec3(0, 1.55 * b.look.tall, 0)
    var front = forward_of(b.heading)
    var side = ap.Vec3(front.z, 0, -front.x)
    var push = puppet.smooth(math.clamp(t / double(ARRIVE_TICKS), 0.0, 1.0))
    var near = 4.2 - 1.9 * push
    var eye = face + front * near + side * (1.2 - 0.9 * push) + ap.Vec3(0, -0.35 + 0.25 * push, 0)
    if t < 40 do
        # First, from further off, the column of light coming down.
        eye = face + front * 7 + side * 2 + ap.Vec3(0, 1.5, 0)
    end
    camera = ap.Camera3D(eye, face - ap.Vec3(0, 0.15, 0))
    camera.fov = 44
    cam_focus = player.body.position + ap.Vec3(0, 1.45, 0)
    cam_yaw = heading_of(player.body.position - b.body.position)
    return true
end

function update_camera()
    if ending_phase == 2 do
        meadow_camera()
        return
    end
    if arrival_camera() or final_camera() do
        return
    end
    var t = locked_target()
    var held = false
    var foe = player.body.position
    if t != null do
        held = alive(player)
        foe = (t as Actor).body.position
    end
    if held do
        var between = flat(player.body.position - foe)
        var keen = math.clamp((between.length() - 0.6) / 2.4, 0.0, 1.0)
        cam_yaw = wrap(cam_yaw + math.clamp(wrap(heading_of(between) - cam_yaw) * 0.08 * keen, -3.0, 3.0))
        cam_pitch = ap.lerp(cam_pitch, 16, 0.06)
    else if overlay == O_NONE or (overlay != O_DEATH and combat_lock) do
        var turn = 0.0
        var tilt = 0.0
        if mouse_held do
            var d = ap.mouse_delta()
            turn -= d.x * 0.22 * data.sensitivity
            tilt += d.y * 0.16 * data.sensitivity
        end
        if down(ap.KEY_LEFT) do
            turn += 2.6
        end
        if down(ap.KEY_RIGHT) do
            turn -= 2.6
        end
        if down(ap.KEY_UP) do
            tilt -= 1.6
        end
        if down(ap.KEY_DOWN) do
            tilt += 1.6
        end
        turn -= ap.pad_axis(0, 2) * 3
        tilt += ap.pad_axis(0, 3) * 2
        cam_yaw = wrap(cam_yaw + turn)
        # Down to -40: below the shoulder, looking up.
        cam_pitch = math.clamp(cam_pitch + tilt, -40.0, 62.0)
    end
    var focus = player.body.position + ap.Vec3(0, 1.45 + player.lift * 0.5, 0)
    if held do
        focus = focus * 0.8 + (foe + ap.Vec3(0, 1.2, 0)) * 0.2
    end
    cam_focus = cam_focus.lerp(focus, 0.2)
    var want = 6.4 if held else 5.6
    var pitch = math.max(cam_pitch, 4.0)
    var up_look = math.max(4.0 - cam_pitch, 0.0)
    if up_look > 0 do
        # Looking up: the camera comes in and down behind Scarf.
        want *= 1 - 0.35 * math.min(up_look / 40, 1.0)
    end
    var view = ap.orbit(cam_focus, cam_yaw, pitch, want)
    var back = view.position - cam_focus
    var hit = lv.world.raycast(ap.Ray(cam_focus, unit(back)), back.length())
    var far = want
    if hit.found do
        far = math.max(hit.distance - 0.3, 1.2)
    end
    cam_dist = far if far < cam_dist else ap.lerp(cam_dist, far, 0.08)
    camera = ap.orbit(cam_focus, cam_yaw, pitch, cam_dist)
    if up_look > 0 do
        # Below Scarf's shoulder, tilted up past them: Scarf stays at the bottom of the view.
        var fov = camera.fov
        var eye = camera.position
        eye = ap.Vec3(eye.x, math.max(eye.y - up_look * 0.03, 0.55), eye.z)
        var ahead = unit(flat(cam_focus - eye))
        var tilt = math.min(up_look * 0.9, 36.0) * math.PI / 180
        camera = ap.Camera3D(eye, eye + ahead * math.cos(tilt) * 4 + ap.Vec3(0, math.sin(tilt) * 4, 0))
        camera.fov = fov
    end
end

# --- Coming and going ----------------------------------------------------------------------------

function setup(puppet.Rig r, roster.Character[] everyone)
    rig_ref = r
    cast = everyone
    load_sounds()
    load_items()
end

# The mode opens on its own front menu, with Scarf standing in a small patch of light.
function open()
    active = true
    leave = false
    light_up = 0
    front = true
    front_row = 0
    front_level = math.min(data.unlocked, cast.length - 1) if data.tutorial else -1
    overlay = O_NONE
    lv = threshold()
    reset_player()
    for k in 0..<lv.reveal.length do
        var x = k % lv.w
        var y = k // lv.w
        var d = flat_distance(cell_center(x, y), lv.spawn)
        lv.reveal[k] = math.clamp(1.4 - d / 5, 0.0, 1.0)
    end
    foes = []
    bosses = []
    pickups = []
    gun_dropped = true
    release_mouse()
    ap.shadows(false)
end

function close()
    active = false
    release_mouse()
end

function reset_player()
    player = Actor()
    player.kind = A_PLAYER
    player.look = scarf_look()
    player.body = ap.Body(lv.spawn)
    player.body.radius = 0.33
    player.body.height = 1.75
    player.hp_max = data.max_health
    player.hp = player.hp_max
    player.speed = 4.8
    player.heading = 45 if lv.index >= 0 else 0
    equip(data.weapon)
    stamina = data.max_stamina
    mana = data.max_mana
    menu = MENU_ROOT
    cam_yaw = wrap(player.heading + 180)
    cam_focus = player.body.position + ap.Vec3(0, 1.45, 0)
end

function start_level(int index)
    front = false
    overlay = O_NONE
    lv = threshold() if index < 0 else make_level(index, cast[index], int(ap.random(1, 1999999999)))
    if index >= 0 do
        data.since_book = 0 if lv.books.length > 0 else data.since_book + 1
        data.since_dojo = 0 if lv.has_dojo else data.since_dojo + 1
        data.since_shop = 0 if lv.has_shop else data.since_shop + 1
    end
    enter_level(index)
end

# The strange hall after a fifth level (`index` is the level just beaten).
function start_intermission(int index)
    front = false
    overlay = O_NONE
    lv = make_intermission(index)
    enter_level(-2)
end

# Everything that starts over with a level.
function enter_level(int index)
    light_up = 1.0 if index != -1 else 0.0
    pact = ""
    portals = []
    spikes = []
    marks = []
    qte_on = false
    revenge_state = 0
    soul_show = 0
    kneel_ready = true
    queue_pos = 0
    final_phase = FP_NONE
    final_ticks = 0
    flood = 0
    void_dark = 0
    ending_phase = 0
    super_tint = 0
    warcry_time = 0
    venom_time = 0
    reload_ticks = 0
    upgrade_wait = 0
    upgrade_picks = 1
    offers = []
    bandage_used = false
    revive_used = false
    make_minimap()
    update_items()
    shield_hp = item_fx(items.E_SHIELD)
    populate(lv)
    bosses = []
    bolts = []
    motes = []
    streaks = []
    souls = []
    pickups = []
    boss_phase = BP_NONE
    combat_lock = false
    alerted = false
    focus_left = 0
    title_ticks = 0
    hint_ticks = 0
    walked = 0
    gun_dropped = index != -1 or has(data.weapons, 0)
    if index >= 0 do
        data.unlocked = math.max(data.unlocked, index)
    end
    data.started = true
    store()
    reset_player()
    if index == -1 and has(data.weapons, 0) do
        var gate = Gate(lv.spawn + ap.Vec3(0, 0, 8), 0)
        gate.open = true
        lv.gates.push(gate)
    end
    grab_mouse()
end

function respawn()
    data.souls -= data.souls // 4
    qte_on = false
    soul_show = 0
    portals = []
    revenge_state = 0
    if lv.mode == LEVEL_FINAL and final_phase >= FP_LIGHTS and final_phase < FP_ENDING do
        # The dark again, from the hall's broken wall: the bosses wait in it once more.
        final_phase = FP_BREACH
        flood = 0
        bosses = []
        foes = []
        reset_player()
        var hall = lv.rooms[lv.boss_room]
        player.body = ap.Body(stand_near(lv, hall.center()))
    else if boss_phase != BP_NONE and boss_phase != BP_DONE do
        for k in lv.boss_doors do
            lv.cells[k] = CELL_FLOOR
        end
        build_world(lv)
        boss_phase = BP_NONE
        queue_pos = 0
        Actor[] small = []
        for f in foes do
            if f.kind != A_DECOY do
                small.push(f)
            end
        end
        foes = small
        bosses = []
        var hp = data.max_health
        reset_player()
        player.body = ap.Body(stand_near(lv, lv.rooms[math.max(lv.boss_room - 1, 0)].center()))
        player.hp = hp
    else do
        reset_player()
    end
    for f in foes do
        f.aware = false
        f.sight = 0
    end
    bolts = []
    combat_lock = false
    overlay = O_NONE
    store()
    grab_mouse()
end

function open_overlay(int which_one)
    if which_one == O_INVENTORY or which_one == O_PAUSE do
        sfx(SND_CLOTH, 0.4)
    else if which_one == O_TUTORIAL do
        sfx(SND_BELL, 0.4, 1.2)
    end
    overlay = which_one
    overlay_ticks = 0
    overlay_row = 0
    release_mouse()
end
function close_overlay()
    if overlay == O_READ and read_state == 2 do
        say("THE BOOK SHUT. WALK AWAY AND BACK TO TRY AGAIN (IT COSTS HEALTH AGAIN).", ap.Color(255, 140, 120), 260)
    end
    if overlay == O_INVENTORY or overlay == O_PAUSE do
        sfx(SND_CLOTH, 0.35, 0.9)
    end
    if overlay == O_TUTORIAL do
        data.tutorial = true
        data.tutorial_seen = true
        store()
        say("A PORTAL HAS OPENED AHEAD OF YOU: WALK INTO IT TO START LEVEL 1.", ap.Color(255, 230, 200), 260)
    end
    overlay = O_NONE
    closed_at = ticks
    grab_mouse()
end

# Whether time stands still: menus out of combat do stop it; in combat, nothing does.
function time_stopped() returns bool
    if overlay == O_NONE do
        return false
    end
    if (overlay == O_PAUSE or overlay == O_INVENTORY) and combat_lock do
        return false
    end
    return true
end

function update()
    ticks += 1
    overlay_ticks += 1
    if front do
        update_front()
        update_camera_front()
        return
    end
    if pressed(ap.KEY_F6) and (overlay == O_NONE or overlay == O_ADMIN) and ending_phase == 0 do
        if overlay == O_ADMIN do
            close_overlay()
        else do
            open_overlay(O_ADMIN)
        end
        sfx(SND_MOVE, 0.4)
    else if overlay != O_NONE do
        update_overlay()
    end
    if not time_stopped() do
        step_world()
    end
    update_camera()
end

# --- The admin panel (F6 in a level): cheats; using it turns achievements off for the run ---------

var admin_god = false
var admin_endless = false
var admin_level = 0
const int ADMIN_ROWS = 10

function admin_rows() returns string[]
    var on = "ON" if data.admin else "OFF"
    return ["ADMIN MODE: {on}", "GOD MODE: " + ("ON" if admin_god else "OFF"),
        "ENDLESS STAMINA, MANA, AMMO, COOLDOWNS: " + ("ON" if admin_endless else "OFF"), "+1000 SOULS", "HEAL",
        "KILL THE BOSS", "KILL EVERY ENEMY", "UNLOCK EVERY LEVEL",
        "GO TO LEVEL  <  {admin_level + 1}. {level_title(cast[admin_level])}  >", "CLOSE"]
end

function update_admin()
    if back() and overlay_ticks > 1 do
        close_overlay()
        return
    end
    if overlay_row == 8 and (lf() or rt()) do
        admin_level = (admin_level + (1 if rt() else cast.length - 1)) % cast.length
        sfx(SND_MOVE, 0.3)
    end
    if not list_input(ADMIN_ROWS, 150, 110, 340) or overlay_ticks < 4 do
        return
    end
    var row = overlay_row
    sfx(SND_PICK, 0.4)
    if row == ADMIN_ROWS - 1 do
        close_overlay()
        return
    end
    if row == 0 do
        data.admin = not data.admin
        if data.admin do
            data.admin_run = true
        else do
            admin_god = false
            admin_endless = false
        end
        store()
        return
    end
    if not data.admin do
        deny("TURN ADMIN MODE ON FIRST")
        return
    end
    if row == 1 do
        admin_god = not admin_god
    else if row == 2 do
        admin_endless = not admin_endless
    else if row == 3 do
        data.souls += 1000
    else if row == 4 do
        player.hp = player.hp_max
        stamina = data.max_stamina
        mana = data.max_mana
    else if row == 5 do
        for b in bosses do
            if alive(b) and b.fade > 0.5 do
                b.hp = 0
                die(b)
            end
        end
    else if row == 6 do
        for f in foes do
            if alive(f) do
                f.hp = 0
                die(f)
            end
        end
    else if row == 7 do
        data.tutorial = true
        data.tutorial_seen = true
        data.started = true
        data.unlocked = cast.length - 1
        store()
    else if row == 8 do
        data.tutorial = true
        data.started = true
        data.unlocked = math.max(data.unlocked, admin_level)
        store()
        start_level(admin_level)
    end
end

function admin_tick()
    if not data.admin do
        return
    end
    if admin_god do
        player.hp = player.hp_max
    end
    if admin_endless do
        stamina = data.max_stamina
        mana = data.max_mana
        if reload_ticks <= 0 do
            ammo = 6
        end
        for k in 0..<cools.length do
            cools[k] = 0
        end
        focus_cool = 0
    end
end

function draw_admin()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 150))
    panel(140, 70, 360, 252)
    label_centered("ADMIN PANEL  (F6 TO CLOSE)", 320, 80, 8, ap.Color(255, 110, 100))
    var note = "ACHIEVEMENTS ARE OFF UNTIL YOU START A NEW RUN" if data.admin_run else "TURNING ADMIN MODE ON TURNS ACHIEVEMENTS OFF FOR THIS RUN"
    label_centered(note, 320, 94, 8, ap.Color(200, 180, 190))
    draw_rows(admin_rows(), overlay_row, 150, 110, 340)
end

# --- Menus --------------------------------------------------------------------------------------

function confirm() returns bool
    return pressed(ap.KEY_ENTER) or pressed(ap.KEY_SPACE) or ap.pad_pressed(ap.PAD_SOUTH)
end
function back() returns bool
    return pressed(ap.KEY_ESCAPE) or pressed(ap.KEY_BACKSPACE) or ap.pad_pressed(ap.PAD_EAST)
end
function up() returns bool
    return pressed(ap.KEY_W) or pressed(ap.KEY_UP) or ap.pad_pressed(ap.PAD_UP)
end
function dn() returns bool
    return pressed(ap.KEY_S) or pressed(ap.KEY_DOWN) or ap.pad_pressed(ap.PAD_DOWN)
end
function lf() returns bool
    return pressed(ap.KEY_A) or pressed(ap.KEY_LEFT) or ap.pad_pressed(ap.PAD_LEFT)
end
function rt() returns bool
    return pressed(ap.KEY_D) or pressed(ap.KEY_RIGHT) or ap.pad_pressed(ap.PAD_RIGHT)
end

# A list of rows the mouse can point at and click: which row it is over, or -1.
function row_rect(int i, double x, double y, double w) returns ap.Rect
    return ap.Rect(x, y + double(i) * 20, w, 18)
end
function mouse_row(int count, double x, double y, double w) returns int
    var m = ap.mouse()
    for i in 0..<count do
        var r = row_rect(i, x, y, w)
        if m.x >= r.x and m.x <= r.x + r.w and m.y >= r.y and m.y <= r.y + r.h do
            return i
        end
    end
    return -1
end
var last_mouse = ap.Vec2(0, 0)
# Moves the cursor row with the keys or the mouse; true when the row is chosen.
function list_input(int count, double x, double y, double w) returns bool
    if up() do
        overlay_row = (overlay_row + count - 1) % count
        sfx(SND_MOVE, 0.3)
    end
    if dn() do
        overlay_row = (overlay_row + 1) % count
        sfx(SND_MOVE, 0.3)
    end
    var m = ap.mouse()
    var over = mouse_row(count, x, y, w)
    if over >= 0 and (m.x != last_mouse.x or m.y != last_mouse.y) do
        overlay_row = over
    end
    last_mouse = m
    if over >= 0 and ap.mouse_pressed(1) do
        overlay_row = over
        return true
    end
    return confirm()
end

function front_rows() returns string[]
    var level = "THE THRESHOLD" if front_level < 0 else "{front_level + 1}. {level_title(cast[front_level])}"
    return ["CONTINUE" if data.started else "BEGIN", "NEW GAME" if data.started else "", "LEVEL  <  {level}  >",
        "DIFFICULTY  <  {DIFF_NAMES[data.difficulty]}  >", "ACHIEVEMENTS  ({data.achievements.length} OF {ACH_IDS.length})", "BACK TO THE TITLE"]
end
var new_game_armed = false

var front_achievements = false
var ach_scroll = 0
function update_front()
    if front_achievements do
        if back() or confirm() or ap.mouse_pressed(1) do
            front_achievements = false
            sfx(SND_MOVE, 0.3, 0.85)
        end
        if up() do
            ach_scroll = math.max(ach_scroll - 1, 0)
        end
        if dn() do
            ach_scroll = math.min(ach_scroll + 1, math.max(ACH_IDS.length - 11, 0))
        end
        return
    end
    var rows = front_rows()
    if up() or dn() or lf() or rt() do
        sfx(SND_MOVE, 0.3)
    end
    if up() do
        front_row = (front_row + rows.length - 1) % rows.length
        if rows[front_row] == "" do
            front_row = (front_row + rows.length - 1) % rows.length
        end
    end
    if dn() do
        front_row = (front_row + 1) % rows.length
        if rows[front_row] == "" do
            front_row = (front_row + 1) % rows.length
        end
    end
    var over = mouse_row(rows.length, 360, 190, 250)
    var m = ap.mouse()
    if over >= 0 and rows[over] != "" and (m.x != last_mouse.x or m.y != last_mouse.y) do
        front_row = over
    end
    last_mouse = m
    var clicked = over >= 0 and rows[over] != "" and ap.mouse_pressed(1)
    var step = 0
    if lf() do
        step = -1
    end
    if rt() do
        step = 1
    end
    var top = math.min(data.unlocked, cast.length - 1)
    if front_row == 2 and step != 0 do
        front_level = math.clamp(front_level + step, -1, top)
    end
    if front_row == 3 and step != 0 do
        set_difficulty(math.clamp(data.difficulty + step, 0, 3))
    end
    if back() do
        leave = true
        return
    end
    if not (confirm() or clicked) do
        return
    end
    sfx(SND_PICK, 0.5)
    if front_row == 0 do
        if not data.started or not data.tutorial do
            start_level(-1)
        else do
            start_level(math.min(data.unlocked, cast.length - 1))
        end
    else if front_row == 1 do
        if new_game_armed do
            data = fresh_save(data)
            store()
            new_game_armed = false
            start_level(-1)
        else do
            new_game_armed = true
            say("PRESS AGAIN TO DELETE YOUR PURGATORY PROGRESS AND START OVER", ap.Color(255, 140, 120), 200)
        end
    else if front_row == 2 do
        if front_level < 0 or data.tutorial do
            start_level(front_level)
        end
    else if front_row == 3 do
        set_difficulty((data.difficulty + 1) % 4)
    else if front_row == 4 do
        front_achievements = true
        ach_scroll = 0
    else do
        leave = true
    end
end

# HELL is a run of its own: one life. Going to it (or leaving it) with a run under way starts over.
var hell_armed = -1
function set_difficulty(int to)
    var crossing = (to == DIFF_HELL) != (data.difficulty == DIFF_HELL)
    if crossing and data.started and hell_armed != to do
        hell_armed = to
        data.difficulty = data.difficulty
        say("PRESS AGAIN: CHANGING TO OR FROM HELL STARTS A NEW RUN (ACHIEVEMENTS ARE KEPT)" if to != DIFF_HELL else "HELL: ONE LIFE, HARDER THAN HARD, POORER LOOT EARLY. PRESS AGAIN TO START A NEW RUN ON IT.", ap.Color(255, 120, 100), 260)
        return
    end
    if crossing and data.started do
        data = fresh_save(data)
        front_level = -1
    end
    hell_armed = -1
    data.difficulty = to
    store()
end

function update_camera_front()
    cam_yaw = wrap(cam_yaw + 0.05)
    var a = cam_yaw * math.PI / 180
    var right = ap.Vec3(math.cos(a), 0, -math.sin(a))
    cam_focus = player.body.position + ap.Vec3(0, 1.3, 0) + right * 1.3
    camera = ap.orbit(cam_focus, cam_yaw, 12, 4.4)
    spring(player)
    if hint_ticks > 0 do
        hint_ticks -= 1
    end
    if ticks % 12 == 0 do
        motes.push(Mote(player.body.position + ap.Vec3(ap.random(-4, 4), 0, ap.random(-4, 4)), ap.Vec3(0, 0.3, 0), ap.Color(220, 200, 255).fade(0.6), 3, 3, 0.04))
    end
    run_effects()
end

function pause_rows() returns string[]
    return ["RESUME", "CAMERA SPEED  <  {int(data.sensitivity * 100)}%  >", "LEAVE (BACK TO THE PURGATORY MENU)"]
end

function update_overlay()
    if overlay == O_UPGRADE do
        var pick = -1
        var n = offers.length
        for k in 0..<n do
            if pressed([ap.KEY_1, ap.KEY_2, ap.KEY_3][k]) do
                pick = k
            end
        end
        if lf() do
            overlay_row = (overlay_row + n - 1) % n
            sfx(SND_MOVE, 0.3)
        end
        if rt() do
            overlay_row = (overlay_row + 1) % n
            sfx(SND_MOVE, 0.3)
        end
        var m = ap.mouse()
        for k in 0..<n do
            var x = offer_x(k)
            if m.x >= x and m.x <= x + 130 and m.y >= 120 and m.y <= 250 do
                if m.x != last_mouse.x or m.y != last_mouse.y do
                    overlay_row = k
                end
                if ap.mouse_pressed(1) do
                    pick = k
                end
            end
        end
        last_mouse = m
        if confirm() and overlay_ticks > 20 do
            pick = overlay_row
        end
        if pick >= 0 and overlay_ticks > 20 do
            data.upgrades.push(offers[pick])
            store()
            var parts = offers[pick].split(":")
            say("UPGRADED {owner_name("{parts[0]}:{parts[1]}")}: {offer_words(offers[pick])}", ap.Color(255, 230, 160), 260)
            sfx(SND_GOLD, 0.5)
            sfx(SND_UNSHEATHE, 0.4)
            if upgrade_picks > 1 do
                # Another to take, from what is left.
                upgrade_picks -= 1
                string[] rest = []
                for k, o in offers do
                    if k != pick do
                        rest.push(o)
                    end
                end
                offers = rest
                overlay_row = 0
                overlay_ticks = 0
                return
            end
            upgrade_picks = 1
            offers = []
            close_overlay()
        end
        return
    end
    if overlay == O_PAUSE do
        var rows = pause_rows()
        if back() and overlay_ticks > 1 do
            close_overlay()
            return
        end
        if overlay_row == 1 and (lf() or rt()) do
            data.sensitivity = math.clamp(data.sensitivity + (0.1 if rt() else -0.1), 0.3, 2.5)
            store()
        end
        if list_input(rows.length, 200, 170, 240) do
            if overlay_row == 0 do
                close_overlay()
            else if overlay_row == 2 do
                store()
                open()
            end
        end
    else if overlay == O_ADMIN do
        update_admin()
    else if overlay == O_INVENTORY do
        update_inventory()
    else if overlay == O_TUTORIAL do
        if (confirm() or ap.mouse_pressed(1) or pressed(ap.KEY_R)) and overlay_ticks > 20 do
            sfx(SND_PICK, 0.4)
            tutorial_page += 1
            overlay_ticks = 0
            if tutorial_page >= 4 do
                close_overlay()
            end
        end
    else if overlay == O_READ do
        update_reading()
    else if overlay == O_DOJO do
        update_dojo()
    else if overlay == O_SHOP do
        update_shop()
    else if overlay == O_DEATH do
        if data.difficulty == DIFF_HELL do
            # Permadeath: there is nothing to retry.
            if overlay_ticks > 90 and list_input(1, 230, 236, 180) do
                open()
            end
        else if overlay_ticks > 70 and list_input(2, 230, 220, 180) do
            if overlay_row == 0 do
                respawn()
            else do
                open()
            end
        end
    else if overlay == O_REDBOOK do
        update_redbook()
    else if overlay == O_GAMBLER do
        update_gambler()
    else if overlay == O_FORGE do
        update_forge()
    else if overlay == O_SHRINE do
        update_shrine()
    else if overlay == O_WIN do
        if overlay_ticks > 120 and (confirm() or ap.mouse_pressed(1) or back()) do
            open()
        end
    end
end

function update_redbook()
    if read_book < 0 or read_book >= lv.books.length do
        close_overlay()
        return
    end
    var b = lv.books[read_book]
    if back() and overlay_ticks > 1 do
        close_overlay()
        return
    end
    if not list_input(2, 230, 230, 180) or overlay_ticks < 10 do
        return
    end
    if overlay_row == 1 do
        close_overlay()
        return
    end
    if data.souls < b.price do
        say("NOT ENOUGH SOULS: IT WILL WAIT HERE UNTIL YOU LEAVE THE LEVEL", ap.Color(255, 130, 110), 160)
        sfx(SND_DENY, 0.45)
        return
    end
    data.souls -= b.price
    b.taken = true
    if not has(data.arts, b.art) do
        data.arts.push(b.art)
        var placed = false
        for i in 0..<4 do
            if not placed and data.art_slots[i] < 0 do
                data.art_slots[i] = b.art
                placed = true
            end
        end
    end
    sfx(SND_RIFT, 0.6, 0.8)
    sfx(SND_GOLD, 0.5)
    say("LEARNED: {art_name(b.art)}. PUT IT IN THE ART MENU FROM THE INVENTORY (E) IF IT IS NOT THERE.", ap.Color(255, 90, 80), 260)
    achieve("red_reader")
    store()
    close_overlay()
end

function current_spot() returns Spot?
    if spot_at >= 0 and spot_at < lv.spots.length do
        return lv.spots[spot_at]
    end
    return null
end

function update_gambler()
    var have = current_spot()
    if have == null or (back() and overlay_ticks > 1) do
        close_overlay()
        return
    end
    var sp = have as Spot
    var rows = gamble_rows(sp)
    if not list_input(rows.length, 150, 140, 340) or overlay_ticks < 6 do
        return
    end
    if overlay_row == rows.length - 1 do
        close_overlay()
        return
    end
    gamble(sp, overlay_row)
    if upgrade_wait > 0 do
        close_overlay()
    end
end

function forge_rows() returns string[]
    string[] rows = []
    var now = infusion(data.weapon)
    for k, id in INFUSE_IDS do
        rows.push("{INFUSE_NAMES[k]}  -  " + ("INFUSED" if now == id else "{infuse_price()} SOULS"))
    end
    rows.push("LEAVE")
    return rows
end
function update_forge()
    if back() and overlay_ticks > 1 do
        close_overlay()
        return
    end
    var rows = forge_rows()
    if not list_input(rows.length, 150, 140, 340) or overlay_ticks < 6 do
        return
    end
    if overlay_row == rows.length - 1 do
        close_overlay()
        return
    end
    var id = INFUSE_IDS[overlay_row]
    if infusion(data.weapon) == id do
        gamble_said = "IT ALREADY BURNS WITH THAT"
        return
    end
    if data.souls < infuse_price() do
        gamble_said = "NOT ENOUGH SOULS"
        sfx(SND_DENY, 0.45)
        return
    end
    data.souls -= infuse_price()
    infuse(data.weapon, id)
    gamble_said = "{weapon_name(data.weapon)} IS INFUSED: {INFUSE_NAMES[overlay_row]}"
    sfx(SND_CLASH_A, 0.6, 0.7)
    sfx(SND_FIRE, 0.5, 0.8)
    burst(chest_of(player), 20, INFUSE_COLORS[overlay_row], 3, 0.6, 0.07)
    achieve("forged")
end

function update_shrine()
    var have = current_spot()
    if have == null or (back() and overlay_ticks > 1) do
        close_overlay()
        return
    end
    var sp = have as Spot
    var count = sp.offer.length + 1
    if not list_input(count, 150, 150, 340) or overlay_ticks < 6 do
        return
    end
    if overlay_row >= sp.offer.length do
        close_overlay()
        return
    end
    if sp.used or pact != "" do
        gamble_said = "A PACT IS ALREADY SIGNED ON THIS LEVEL"
        sfx(SND_DENY, 0.45)
        return
    end
    if data.souls < pact_price() do
        gamble_said = "NOT ENOUGH SOULS"
        sfx(SND_DENY, 0.45)
        return
    end
    data.souls -= pact_price()
    sp.used = true
    take_pact(sp.offer[overlay_row])
    store()
    close_overlay()
end

const string[] INV_TABS = ["WEAPONS", "STANCES", "ARTS", "ITEMS", "SOULS"]
function inventory_rows() returns string[]
    string[] rows = []
    if inv_tab == 0 do
        rows.push("FISTS" + ("   (EQUIPPED)" if data.weapon < 0 else ""))
        for w in data.weapons do
            rows.push(WEAPON_NAMES[w] + ("   (EQUIPPED)" if data.weapon == w else ""))
        end
    else if inv_tab == 1 do
        rows.push(STANCE_NAMES[data.stance] + "   (KNOWN)")
    else if inv_tab == 2 do
        for a in data.arts do
            var slot = -1
            for i in 0..<4 do
                if data.art_slots[i] == a do
                    slot = i
                end
            end
            rows.push(art_name(a) + ("   (SLOT {slot + 1})" if slot >= 0 else ""))
        end
    else if inv_tab == 3 do
        for k in 0..<item_defs.length do
            if owns_item(k) do
                rows.push(item_defs[k].name)
            end
        end
    end
    return rows
end

function update_inventory()
    if (pressed(ap.KEY_E) or back()) and overlay_ticks > 1 do
        close_overlay()
        return
    end
    if lf() do
        inv_tab = (inv_tab + INV_TABS.length - 1) % INV_TABS.length
        overlay_row = 0
        sfx(SND_MOVE, 0.3)
    end
    if rt() do
        inv_tab = (inv_tab + 1) % INV_TABS.length
        overlay_row = 0
        sfx(SND_MOVE, 0.3)
    end
    var rows = inventory_rows()
    if rows.length == 0 do
        return
    end
    overlay_row = math.min(overlay_row, rows.length - 1)
    if not list_input(rows.length, 120, 110, 400) do
        return
    end
    if combat_lock do
        deny("NOT IN COMBAT")
        say("WEAPONS, STANCES AND ARTS CAN ONLY BE CHANGED OUT OF COMBAT", ap.Color(255, 130, 110), 120)
        return
    end
    sfx(SND_PICK, 0.4)
    if inv_tab == 0 do
        equip(-1 if overlay_row == 0 else data.weapons[overlay_row - 1])
        sfx(SND_UNSHEATHE, 0.35)
        menu = MENU_ROOT
    else if inv_tab == 1 do
        say("ONE STANCE AT A TIME: A DOJO CAN TEACH ANOTHER, WHICH REPLACES THIS ONE", ap.Color(200, 190, 210), 160)
        return
    else if inv_tab == 2 do
        var art = data.arts[overlay_row]
        var placed = false
        for i in 0..<4 do
            if data.art_slots[i] == art do
                data.art_slots[i] = -1
                placed = true
            end
        end
        if not placed do
            var free = -1
            for i in 0..<4 do
                if free < 0 and data.art_slots[i] < 0 do
                    free = i
                end
            end
            data.art_slots[free if free >= 0 else 3] = art
        end
    end
    store()
end

# Copying out a cursed book: every key typed is checked against the next letter.
# The keys that type something into a book, and which key a letter comes from.
function typing_keys() returns int[]
    int[] keys = [ap.KEY_SPACE, ap.KEY_COMMA, ap.KEY_PERIOD, ap.KEY_SEMICOLON]
    for k in ap.KEY_A..<(ap.KEY_Z + 1) do
        keys.push(k)
    end
    return keys
end
function key_of_char(string c) returns int
    var letters = "abcdefghijklmnopqrstuvwxyz"
    var at = letters.find(c.lower())
    if at >= 0 do
        return ap.KEY_A + at
    end
    if c == " " do
        return ap.KEY_SPACE
    else if c == "," do
        return ap.KEY_COMMA
    else if c == "." do
        return ap.KEY_PERIOD
    else if c == ";" do
        return ap.KEY_SEMICOLON
    end
    return -1
end

function update_reading()
    read_wrong = math.max(read_wrong - 0.06, 0.0)
    # Keys held since it opened count again once they have been let go.
    int[] still = []
    for key in read_held do
        if down(key) do
            still.push(key)
        end
    end
    read_held = still
    var text = ART_TEXTS[read_art]
    if read_state != 0 do
        if (pressed(ap.KEY_ENTER) or ap.mouse_pressed(1) or back()) and overlay_ticks > 30 do
            close_overlay()
        end
        return
    end
    if pressed(ap.KEY_ESCAPE) do
        # Giving up costs the attempt.
        read_state = 2
        overlay_ticks = 0
        sfx(SND_DENY, 0.5)
        return
    end
    for i in 0..<typed_text.length do
        if read_state != 0 do
            break
        end
        var got = typed_text[i..<(i + 1)].lower()
        if has(read_held, key_of_char(got)) do
            continue
        end
        var want = text[read_pos..<(read_pos + 1)].lower()
        if got == want do
            read_pos += 1
            sfx(SND_MOVE, 0.15, ap.random(1.3, 1.6))
            if read_pos >= text.length do
                learn_art(read_art)
            end
        else do
            read_chances -= 1
            read_wrong = 1
            sfx(SND_DENY, 0.45)
            if read_chances <= 0 do
                read_state = 2
                overlay_ticks = 0
                sfx(SND_THUD, 0.5, 0.6)
            end
        end
    end
    typed_text = ""
end

function learn_art(int art)
    read_state = 1
    overlay_ticks = 0
    if read_book >= 0 and read_book < lv.books.length do
        lv.books[read_book].taken = true
    end
    if not has(data.arts, art) do
        data.arts.push(art)
        var placed = false
        for i in 0..<4 do
            if not placed and data.art_slots[i] < 0 do
                data.art_slots[i] = art
                placed = true
            end
        end
    end
    store()
    achieve("bookworm")
    sfx(SND_RIFT, 0.6, 1.2)
    sfx(SND_BELL, 0.45, 1.3)
end

function update_shop()
    if back() and overlay_ticks > 1 do
        close_overlay()
        return
    end
    var count = lv.stock.length + 1
    if not list_input(count, 130, 130, 380) do
        return
    end
    if overlay_row >= lv.stock.length do
        close_overlay()
        return
    end
    var k = lv.stock[overlay_row]
    if owns_item(k) do
        say("YOU ALREADY OWN THAT", ap.Color(200, 190, 210), 90)
        return
    end
    var price = item_price(k)
    if data.souls < price do
        say("NOT ENOUGH SOULS", ap.Color(255, 130, 110), 120)
        sfx(SND_DENY, 0.45)
        return
    end
    data.souls -= price
    data.items_owned.push(item_defs[k].id)
    store()
    update_items()
    if item_fx(items.E_SHIELD) > shield_hp do
        shield_hp = item_fx(items.E_SHIELD)
    end
    say("BOUGHT: {item_defs[k].name}", ap.Color(255, 230, 160), 160)
    sfx(SND_GOLD, 0.55)
    sfx(SND_COIN_A, 0.4)
end

# The dojo: its master teaches two stances. Learning one replaces the one you know (you would have
# to be taught that one again). Two big buttons, side by side; A / D or the mouse, ENTER to learn.
var dojo_pop = [0.0, 0.0]
var dojo_pop_speed = [0.0, 0.0]
function dojo_button(int k) returns ap.Rect
    return ap.Rect(70 + double(k) * 256, 92, 244, 196)
end
function update_dojo()
    if back() and overlay_ticks > 1 do
        close_overlay()
        return
    end
    var choices = lv.dojo_stances
    if choices.length == 0 do
        return
    end
    if lf() or rt() or up() or dn() do
        overlay_row = (overlay_row + 1) % choices.length
        sfx(SND_MOVE, 0.3)
    end
    var m = ap.mouse()
    var clicked = false
    for k in 0..<choices.length do
        var r = dojo_button(k)
        if m.x >= r.x and m.x <= r.x + r.w and m.y >= r.y and m.y <= r.y + r.h do
            if (m.x != last_mouse.x or m.y != last_mouse.y) and overlay_row != k do
                overlay_row = k
                sfx(SND_MOVE, 0.25)
            end
            if ap.mouse_pressed(1) do
                clicked = true
            end
        end
    end
    last_mouse = m
    # Springy hover: the chosen button pops out.
    for k in 0..<2 do
        var want = 1.0 if k == overlay_row else 0.0
        dojo_pop_speed[k] = dojo_pop_speed[k] * 0.72 + (want - dojo_pop[k]) * 0.22
        dojo_pop[k] += dojo_pop_speed[k]
    end
    if not (confirm() or clicked) or overlay_ticks < 8 do
        return
    end
    overlay_row = math.min(overlay_row, choices.length - 1)
    var s = choices[overlay_row]
    if s == data.stance do
        say("YOU ALREADY KNOW {STANCE_NAMES[s]}", ap.Color(200, 190, 210), 120)
        return
    end
    var price = dojo_price(s)
    if data.souls < price do
        say("NOT ENOUGH SOULS", ap.Color(255, 130, 110), 120)
        sfx(SND_DENY, 0.45)
        return
    end
    var old = data.stance
    data.souls -= price
    data.stance = s
    data.stances = [s]
    menu = MENU_ROOT
    sfx(SND_GOLD, 0.5)
    sfx(SND_KIAI, 0.4)
    say("LEARNED: {STANCE_NAMES[s]}. {STANCE_NAMES[old]} IS FORGOTTEN.", ap.Color(255, 230, 160), 220)
    achieve("student")
    store()
end

# --- What the game asks of the mode -------------------------------------------------------------------

function wants_leave() returns bool
    return leave
end

function first_of(string[] names) returns string
    for n in names do
        if n != "" and music_has(n) do
            return n
        end
    end
    return ""
end
var music_has_fn = false
function music_has(string name) returns bool
    return has_track(name)
end

# Filled in by the game: whether a track exists (music.fw lives in the game).
string[] known_tracks = []
function has_track(string name) returns bool
    for t in known_tracks do
        if t == name do
            return true
        end
    end
    return false
end

function music_now() returns string
    if front do
        return first_of(["purgatory_menu", "title"])
    end
    if ending_phase == 2 do
        # The field: birdsong, if it is installed; else quiet.
        return first_of(["purgatory_meadow"])
    end
    if ending_phase > 0 do
        return ""
    end
    if lv.index < 0 do
        return first_of(["purgatory_threshold"])
    end
    if lv.mode == LEVEL_FINAL and final_phase != FP_NONE do
        if final_phase == FP_SATAN_RISE or final_phase == FP_SATAN or final_phase == FP_SATAN_DOWN do
            return first_of(["purgatory_satan", "finale_2", "finale_1"])
        end
        if final_phase == FP_LIGHTS or final_phase == FP_ARMY or final_phase == FP_GAUNTLET do
            return first_of(["purgatory_finale", "finale_1", "finale_2"])
        end
        # The last boss is down: nothing, then the dark.
        return ""
    end
    var n = lv.index
    if boss_phase == BP_WAIT or boss_phase == BP_QTE do
        return ""
    end
    if boss_phase == BP_ARRIVE or boss_phase == BP_FIGHT do
        # Its super's own music, the whole fight through. One whose super is silent (WANTED DEAD)
        # has the boss music until its super comes on, then silence, as in the Arena.
        var k = arrival_index() if bosses.length == 0 else bosses[0].boss_index
        if k < 0 or k >= cast.length do
            k = n
        end
        if cast[k].maximum.silent do
            return "" if boss_in_super() else first_of(["purgatory_boss_{1 + k % 3}"])
        end
        return first_of(["super_{cast[k].name.lower()}", "purgatory_boss_{1 + k % 3}", "finale_1"])
    end
    if overlay == O_DOJO do
        return first_of(["purgatory_dojo", "shop"])
    end
    if overlay == O_SHOP or overlay == O_GAMBLER or overlay == O_FORGE do
        return first_of(["shop", "purgatory_dojo"])
    end
    if alerted do
        return first_of(["purgatory_combat_{1 + n % 3}", "fight_{1 + n % 9}"])
    end
    return first_of(["purgatory_explore_{1 + n % 4}"])
end

# --- Drawing -------------------------------------------------------------------------------------------

# Bricks, in grey, so any level's color tints them.
function paint_brick(int x, int y) returns ap.Color
    var row = y // 16
    var shift = 16 if row % 2 == 1 else 0
    var bx = (x + shift) % 64
    var mortar = y % 16 < 2 or bx % 32 < 2
    if mortar do
        return ap.Color(70, 66, 66)
    end
    var brick = (x + shift) // 32 + row * 3
    var v = math.sin(double(brick) * 12.9898) * 43758.5453
    var shade = 170 + int((v - math.floor(v)) * 60)
    var grain = math.sin(double(x * 7 + y * 13)) * 6
    var g = shade + int(grain)
    return ap.Color(g, g, g)
end

ap.Texture? brick_tex = null
ap.Mesh? tile_mesh = null
ap.Mesh? box_mesh = null
function bricks() returns ap.Texture
    var have = brick_tex
    if have != null do
        return have as ap.Texture
    end
    var t = ap.make_texture(64, 64, paint_brick)
    brick_tex = t
    return t
end
function tile() returns ap.Mesh
    var have = tile_mesh
    if have != null do
        return have as ap.Mesh
    end
    var m = ap.plane(TILE, TILE, 1)
    tile_mesh = m
    return m
end
function box() returns ap.Mesh
    var have = box_mesh
    if have != null do
        return have as ap.Mesh
    end
    var m = ap.cube(1, 1, 1)
    box_mesh = m
    return m
end

# The lights of the place this frame: Scarf's own, then the nearest lamps and glows.
ap.Vec3[] light_at = []
double[] light_reach = []
ap.Color[] light_color = []
function gather_lights()
    var toward_camera = unit(flat(camera.position - player.body.position))
    light_at = [player.body.position + ap.Vec3(0, 2.4, 0) + toward_camera * 1.2]
    light_reach = [REVEAL_RADIUS + 1.5]
    light_color = [ap.Color(255, 226, 196)]
    ap.Vec3[] spots = []
    ap.Color[] tints = []
    double[] reaches = []
    for pr in lv.props do
        if pr.kind == PROP_LAMP or pr.kind == PROP_CRYSTAL do
            spots.push(pr.at + ap.Vec3(0, 1.8, 0))
            tints.push(lv.glow)
            reaches.push(6.5)
        end
    end
    for g in lv.gates do
        spots.push(g.at + ap.Vec3(0, 1.5, 0))
        tints.push(lv.glow.lerp(ap.WHITE, 0.3))
        reaches.push(8 * g.grow)
    end
    for b in lv.books do
        if not b.taken do
            spots.push(b.at + ap.Vec3(0, 1.3, 0))
            tints.push(ap.Color(200, 120, 255))
            reaches.push(5)
        end
    end
    if lv.has_dojo do
        spots.push(lv.dojo + ap.Vec3(0, 2.4, 0))
        tints.push(ap.Color(255, 190, 120))
        reaches.push(7)
    end
    for bo in bosses do
        if alive(bo) and bo.role != ROLE_GAUNTLET do
            var burning = data.difficulty == DIFF_HELL or bo.true_form or bo.role == ROLE_SATAN
            spots.push(chest_of(bo) + ap.Vec3(0, 1.4, 0))
            tints.push(ap.Color(255, 70, 30) if burning else bo.look.accent)
            reaches.push((10.0 if bo.role == ROLE_SATAN else 7.0) * bo.fade)
        end
    end
    for sp in lv.spots do
        spots.push(sp.at + ap.Vec3(0, 2.2, 0))
        tints.push([ap.Color(255, 220, 120), ap.Color(255, 140, 60), ap.Color(255, 70, 70)][math.clamp(sp.kind - ROOM_GAMBLER, 0, 2)])
        reaches.push(6.5)
    end
    for pt in portals do
        spots.push(pt.at)
        tints.push(pt.color)
        reaches.push(4)
    end
    # The nearest five of those.
    for pick in 0..<5 do
        var best = -1
        var near = 30.0
        for k, at in spots do
            var d = flat_distance(at, player.body.position)
            if d < near and reaches[k] > 0.1 do
                near = d
                best = k
            end
        end
        if best < 0 do
            break
        end
        light_at.push(spots[best])
        light_color.push(tints[best])
        light_reach.push(reaches[best])
        reaches[best] = 0
    end
end

function set_lights()
    ap.listen_from(camera)
    gather_lights()
    for i in 0..<8 do
        ap.light_off(i)
    end
    for k in 0..<light_at.length do
        ap.light(k, light_at[k], light_color[k], light_reach[k])
    end
    var slot = light_at.length
    for b in bolts do
        if slot < 8 do
            ap.light(slot, b.at, b.color, 3)
            slot += 1
        end
    end
    if ending_phase == 2 do
        meadow_lights()
        return
    end
    var amb = lv.ambient.lerp(lv.ambient_lit, light_up)
    var sun = ap.Color(0, 0, 0).lerp(lv.sun, light_up)
    var sb = super_boss()
    if sb != null and super_tint > 0 do
        # The place takes on the super's colors.
        var m = kit_of(sb as Actor).maximum
        amb = amb.lerp(m.ambient, 0.6 * super_tint)
        sun = sun.lerp(m.sun, 0.5 * super_tint)
    end
    # Walking into the dark: everything goes.
    var dark = 1 - void_dark
    amb = amb.brightness(dark * (1 - 0.8 * flood) + 0.25 * flood)
    sun = sun.brightness(dark * (1 - flood))
    if flood > 0 do
        # The floodlight, high over where it all ends.
        ap.light(7, lv.death_at + ap.Vec3(0, 16, 0), ap.Color(255, 244, 220).brightness(flood), 48 * flood)
    end
    ap.ambient(amb)
    ap.sun(ap.Vec3(-0.3, -1, -0.2), sun)
    ap.fog(sky(), (9 + 25 * light_up) * (1 - 0.6 * void_dark), (30 + 50 * light_up) * (1 - 0.6 * void_dark))
end

function sky() returns ap.Color
    if ending_phase == 2 do
        return ap.Color(150, 196, 236)
    end
    var c = ap.Color(0, 0, 0).lerp(lv.sky, light_up)
    var sb = super_boss()
    if sb != null and super_tint > 0 do
        c = c.lerp(kit_of(sb as Actor).maximum.sky, 0.7 * super_tint)
    end
    return c.brightness(1 - math.max(void_dark, flood))
end

# How lit a spot on the ground is (0..1), by the lights gathered.
function lit(ap.Vec3 at) returns double
    var best = 0.0
    for k in 0..<light_at.length do
        var d = flat_distance(at, light_at[k])
        var v = 1 - d / light_reach[k]
        if v > best do
            best = v
        end
    end
    return best
end

function draw_scene()
    var r = rig()
    if ending_phase == 2 do
        draw_meadow(r)
        return
    end
    var tex = bricks()
    var floor_tex = tex
    if lv.style == STYLE_FOREST do
        floor_tex = grass()
    else if lv.style == STYLE_CAVE do
        floor_tex = stone()
    else if lv.style == STYLE_LAB do
        floor_tex = lab_tiles()
    else if lv.style == STYLE_MANOR do
        floor_tex = planks()
    else if lv.style == STYLE_TOY do
        floor_tex = checker()
    end
    var center = cell_of(cam_focus)
    var span = 15 + int(8 * light_up)
    var gloom = 1 - void_dark
    ap.lighting(false)
    for dy in -span..<(span + 1) do
        for dx in -span..<(span + 1) do
            var x = center[0] + dx
            var y = center[1] + dy
            if x < 0 or y < 0 or x >= lv.w or y >= lv.h do
                continue
            end
            var k = y * lv.w + x
            var kind = lv.cells[k]
            var c = cell_center(x, y)
            if kind == CELL_DARK do
                # The dark past the last hall: nothing, unless the floodlight is on.
                if flood > 0 do
                    var d = flat_distance(c, lv.death_at)
                    var fb = flood * math.clamp(1.2 - d / 26, 0.0, 1.0)
                    if fb > 0.02 do
                        ap.draw(tile(), c, ap.Color(120, 116, 124).brightness(fb), ap.Vec3(0, 0, 0), ap.Vec3(1, 1, 1), stone())
                    end
                end
                continue
            end
            var seen = lv.reveal[k]
            if seen < 0.02 do
                continue
            end
            var light = lit(c)
            var dark = 0.2 + 0.8 * light * light
            var b = seen * (dark + ((0.72 + 0.28 * light) - dark) * light_up) * gloom
            if b < 0.01 do
                continue
            end
            if kind == CELL_FLOOR do
                ap.draw(tile(), c, lv.floor_color.brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(1, 1, 1), floor_tex)
            else if kind == CELL_WALL do
                draw_wall_cell(r, x, y, c, b)
            end
        end
    end
    ap.lighting(true)
    for pr in lv.props do
        if revealed_at(pr.at) do
            draw_prop(r, pr)
        end
    end
    for c in lv.chests do
        if revealed_at(c.at) do
            draw_chest(r, c)
        end
    end
    for b in lv.books do
        if revealed_at(b.at) do
            draw_book(r, b)
        end
    end
    if lv.has_shop and revealed_at(lv.shop) do
        draw_shop(r)
    end
    if lv.has_dojo and revealed_at(lv.dojo) do
        draw_dojo(r)
    end
    for g in lv.gates do
        draw_gate(r, g)
    end
    for sp in lv.spots do
        if revealed_at(sp.at) do
            draw_spot(r, sp)
        end
    end
    draw_spikes(r)
    draw_portals(r)
    if soul_show > 0 do
        var at = soul_place()
        ap.lighting(false)
        var pulse = 0.28 + 0.06 * math.sin(double(ticks) * 0.4)
        ap.draw(r.orb, at, ap.Color(220, 240, 255), ap.Vec3(0, double(ticks) * 4, 0), ap.Vec3(pulse, pulse * 1.4, pulse))
        ap.draw(r.orb, at, ap.Color(200, 230, 255).fade(0.3), ap.Vec3(0, 0, 0), ap.Vec3(pulse, pulse * 1.4, pulse) * 2.4)
        ap.lighting(true)
        if ticks % 2 == 0 do
            motes.push(Mote(at, ap.Vec3(ap.random(-0.4, 0.4), ap.random(-0.4, 0.4), ap.random(-0.4, 0.4)), ap.Color(200, 230, 255), 0.6, 0.6, 0.06))
        end
    end
    for pk in pickups do
        if not pk.taken do
            draw_pickup(r, pk)
        end
    end
    for e in foes do
        draw_actor(r, e)
    end
    for b in bosses do
        draw_actor(r, b)
        if boss_phase == BP_ARRIVE do
            # A pale column where it is coming through.
            var fade = math.max(0.0, 1 - math.abs(double(boss_ticks) - 60) / 90) * 0.45
            ap.lighting(false)
            ap.draw(r.drum, b.body.position + ap.Vec3(0, 6, 0), b.look.accent.lerp(ap.WHITE, 0.5).fade(fade), ap.Vec3(0, 0, 0), ap.Vec3(1.6, 12, 1.6))
            ap.lighting(true)
        end
    end
    var cut_to_boss = boss_phase == BP_ARRIVE and boss_ticks >= 40 and boss_ticks < ARRIVE_TICKS - 30
    if (alive(player) or player.frame < 400) and not cut_to_boss do
        draw_actor(r, player)
    end
    ap.lighting(false)
    for b in bolts do
        ap.draw(r.orb, b.at, b.color, ap.Vec3(0, 0, 0), ap.Vec3(b.size, b.size, b.size) * 2)
        ap.draw(r.orb, b.at, ap.WHITE.fade(0.8), ap.Vec3(0, 0, 0), ap.Vec3(b.size, b.size, b.size))
    end
    for m in motes do
        var s = m.size * (m.life / m.span)
        ap.draw(r.box, m.at, m.color.fade(math.min(1.0, m.life / m.span * 1.5) * (double(m.color.a) / 255)), ap.Vec3(0, 0, 0), ap.Vec3(s, s, s))
    end
    for s in souls do
        var pulse = 0.12 + 0.03 * math.sin(s.age * 12)
        ap.draw(r.orb, s.at, ap.Color(200, 230, 255), ap.Vec3(0, s.age * 200, 0), ap.Vec3(pulse, pulse * 1.4, pulse))
    end
    # A boss aiming something long: a line where it will go (gold, then red once it is locked).
    for b in bosses do
        if alive(b) and b.state == S_ATTACK and b.act.beam > 0 and b.frame < b.act.startup do
            var locked = b.act.startup > 40 and b.frame > b.act.startup - 30
            var from = chest_of(b) + ap.Vec3(0, 0.2, 0)
            var reach = b.act.beam
            var wall = lv.world.raycast(ap.Ray(from, forward_of(b.heading)), reach)
            if wall.found do
                reach = wall.distance
            end
            var pulse = 0.4 + 0.3 * math.sin(double(ticks) * (0.5 if locked else 0.2))
            var c = ap.Color(255, 70, 60) if locked else ap.Color(255, 210, 90)
            draw_streak(r, Streak(from, from + forward_of(b.heading) * reach, c.fade(pulse), 1, 1, 0.03))
        end
    end
    for mk in marks do
        var grow = 1 - mk.life
        ap.draw(r.ring, mk.at + ap.Vec3(0, 0.05, 0), mk.color.fade(0.4 + 0.5 * grow), ap.Vec3(0, double(ticks) * 3, 0), ap.Vec3(2.4, 2.4, 2.4) * (1.2 - 0.6 * grow))
    end
    for st in streaks do
        draw_streak(r, st)
    end
    ap.lighting(true)
end

# A cell's own random number (the same every frame), 0..1.
function cell_hash(int x, int y, int salt) returns double
    var v = math.sin(double(x) * 12.9898 + double(y) * 78.233 + double(salt) * 37.719) * 43758.5453
    return v - math.floor(v)
end

# Which side of a wall cell faces the floor (a unit step), or (0, 0) if none does.
function floor_side(int x, int y) returns ap.Vec3
    if cell_at(lv, x + 1, y) == CELL_FLOOR do
        return ap.Vec3(1, 0, 0)
    else if cell_at(lv, x - 1, y) == CELL_FLOOR do
        return ap.Vec3(-1, 0, 0)
    else if cell_at(lv, x, y + 1) == CELL_FLOOR do
        return ap.Vec3(0, 0, 1)
    else if cell_at(lv, x, y - 1) == CELL_FLOOR do
        return ap.Vec3(0, 0, -1)
    end
    return ap.Vec3(0, 0, 0)
end

# One wall cell, in its level's style.
function draw_wall_cell(puppet.Rig r, int x, int y, ap.Vec3 c, double b)
    var h = cell_hash(x, y, 1)
    var jitter = ap.Vec3((cell_hash(x, y, 2) - 0.5) * 0.8, 0, (cell_hash(x, y, 3) - 0.5) * 0.8)
    var at = c + jitter
    var turn = cell_hash(x, y, 4) * 360
    var face = floor_side(x, y)
    var faces = face.length() > 0.5
    var yaw = heading_of(face) if faces else 0.0
    if lv.style == STYLE_HALLS do
        # Brick, on a stone plinth, under a stone cornice; a pilaster now and then, and torches.
        var wb = b * 0.9
        for level_up in 0..<2 do
            ap.draw(box(), c + ap.Vec3(0, 0.85 + double(level_up) * 1.7, 0), lv.wall_color.brightness(wb * (1.0 - 0.2 * double(level_up))),
                ap.Vec3(0, 0, 0), ap.Vec3(TILE, 1.7, TILE), bricks())
        end
        var stone = lv.wall_color.lerp(ap.Color(150, 140, 130), 0.5)
        ap.draw(box(), c + ap.Vec3(0, 0.18, 0), stone.brightness(wb * 0.8), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.06, 0.36, TILE * 1.06))
        ap.draw(box(), c + ap.Vec3(0, 3.48, 0), stone.brightness(wb), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.1, 0.16, TILE * 1.1))
        if faces and h < 0.3 do
            ap.draw(box(), c + face * (TILE / 2 + 0.12) + ap.Vec3(0, 1.75, 0), stone.brightness(wb * 0.95), ap.Vec3(0, yaw, 0), ap.Vec3(0.55, 3.4, 0.3))
        else if faces and h > 0.9 do
            # A torch in a bracket, its flame the level's light.
            var p = c + face * (TILE / 2 + 0.15) + ap.Vec3(0, 2.1, 0)
            ap.draw(r.rod, p, ap.Color(50, 40, 34).brightness(wb), ap.Vec3(30, yaw, 0), ap.Vec3(0.07, 0.5, 0.07))
            ap.draw(r.blade, p + ap.Vec3(0, 0.34, 0) + face * 0.12, lv.glow, ap.Vec3(0, double(ticks) * 3, 0), ap.Vec3(0.12, 0.28 + 0.04 * math.sin(double(ticks) * 0.3 + h * 9), 0.12))
        end
    else if lv.style == STYLE_LAB do
        # Steel panels, a band of hazard stripes, a strip light in the level's glow, pipes.
        var steel = lv.wall_color.lerp(ap.Color(170, 178, 186), cell_hash(x, y, 5) * 0.3)
        ap.draw(box(), c + ap.Vec3(0, 1.8, 0), steel.brightness(b * 0.95), ap.Vec3(0, 0, 0), ap.Vec3(TILE, 3.6, TILE), panels())
        ap.draw(box(), c + ap.Vec3(0, 0.25, 0), ap.Color(230, 190, 40).brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.02, 0.5, TILE * 1.02), stripes())
        ap.draw(box(), c + ap.Vec3(0, 3.66, 0), steel.brightness(b * 0.6), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.04, 0.12, TILE * 1.04))
        if faces do
            ap.draw(box(), c + face * (TILE / 2 + 0.03) + ap.Vec3(0, 2.9, 0), lv.glow.lerp(ap.WHITE, 0.4).brightness(0.5 + 0.5 * light_up), ap.Vec3(0, yaw, 0), ap.Vec3(TILE * 0.8, 0.1, 0.06))
            if h < 0.35 do
                ap.draw(r.drum, c + face * (TILE / 2 + 0.16) + ap.Vec3(0, 1.8, 0), ap.Color(120, 126, 134).brightness(b), ap.Vec3(0, yaw, 90), ap.Vec3(0.22, TILE, 0.22))
                ap.draw(r.drum, c + face * (TILE / 2 + 0.16) + ap.Vec3(0, 2.25, 0), ap.Color(150, 90, 60).brightness(b), ap.Vec3(0, yaw, 90), ap.Vec3(0.14, TILE, 0.14))
            else if h > 0.88 do
                # A warning lamp, turning.
                var spin = math.sin(double(ticks) * 0.12 + h * 20)
                ap.draw(r.drum, c + face * (TILE / 2 + 0.14) + ap.Vec3(0, 3.2, 0), ap.Color(255, 90, 40).brightness(0.6 + 0.4 * spin), ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.2, 0.2))
            end
        end
    else if lv.style == STYLE_MANOR do
        # Dark wood wainscot, papered walls, a crown moulding; portraits and sconces.
        var wood = ap.Color(80, 48, 32)
        ap.draw(box(), c + ap.Vec3(0, 0.6, 0), wood.brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(TILE, 1.2, TILE), planks())
        ap.draw(box(), c + ap.Vec3(0, 2.35, 0), lv.wall_color.brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(TILE, 2.3, TILE), wallpaper())
        ap.draw(box(), c + ap.Vec3(0, 1.24, 0), wood.lerp(ap.Color(200, 160, 90), 0.3).brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.03, 0.08, TILE * 1.03))
        ap.draw(box(), c + ap.Vec3(0, 3.56, 0), ap.Color(200, 180, 150).brightness(b * 0.9), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.08, 0.2, TILE * 1.08))
        if faces and h < 0.22 do
            # A portrait: a gilt frame, a dark sitter with pale eyes.
            var p = c + face * (TILE / 2 + 0.04) + ap.Vec3(0, 2.3, 0)
            ap.draw(box(), p, ap.Color(200, 160, 70).brightness(b), ap.Vec3(0, yaw, 0), ap.Vec3(1.1, 1.3, 0.06))
            ap.draw(box(), p + face * 0.02, ap.Color(40, 30, 34).brightness(b), ap.Vec3(0, yaw, 0), ap.Vec3(0.9, 1.1, 0.06))
            ap.draw(r.orb, p + face * 0.05 + ap.Vec3(0, 0.12, 0), ap.Color(150, 120, 110).brightness(b), ap.Vec3(0, yaw, 0), ap.Vec3(0.3, 0.38, 0.05))
        else if faces and h > 0.88 do
            var p = c + face * (TILE / 2 + 0.12) + ap.Vec3(0, 2.0, 0)
            ap.draw(r.flare, p, ap.Color(200, 160, 70).brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(0.18, 0.12, 0.18))
            ap.draw(r.drum, p + ap.Vec3(0, 0.15, 0), ap.Color(240, 230, 210).brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(0.06, 0.22, 0.06))
            ap.draw(r.blade, p + ap.Vec3(0, 0.33, 0), ap.Color(255, 200, 110), ap.Vec3(0, double(ticks) * 2, 0), ap.Vec3(0.06, 0.12, 0.06))
        end
    else if lv.style == STYLE_TOY do
        # Alphabet blocks, stacked: each its own color, a letter on it.
        var colors = [ap.Color(240, 120, 120), ap.Color(120, 180, 240), ap.Color(250, 210, 90), ap.Color(130, 210, 130), ap.Color(200, 140, 230), ap.Color(250, 160, 80)]
        # A solid core behind the blocks, so nothing shows through between them.
        ap.draw(box(), c + ap.Vec3(0, 1.5, 0), ap.Color(150, 120, 140).brightness(b * 0.6), ap.Vec3(0, 0, 0), ap.Vec3(TILE, 3.0, TILE))
        var stack = 2 + int(h * 1.99)
        for n in 0..<stack do
            var size = TILE * (0.92 - 0.1 * double(n))
            var col = colors[int(cell_hash(x, y, 10 + n) * 5.99)]
            var spin = (cell_hash(x, y, 20 + n) - 0.5) * 24
            var p = c + ap.Vec3((cell_hash(x, y, 30 + n) - 0.5) * 0.3, size / 2 + double(n) * TILE * 0.86, (cell_hash(x, y, 40 + n) - 0.5) * 0.3)
            ap.draw(box(), p, col.brightness(b), ap.Vec3(0, spin, 0), ap.Vec3(size, size * 0.98, size))
            # The letter: a raised panel on each side.
            ap.draw(box(), p, col.lerp(ap.WHITE, 0.6).brightness(b), ap.Vec3(0, spin, 0), ap.Vec3(size * 1.02, size * 0.5, size * 0.3))
            ap.draw(box(), p, col.lerp(ap.WHITE, 0.6).brightness(b), ap.Vec3(0, spin, 0), ap.Vec3(size * 0.3, size * 0.5, size * 1.02))
        end
    else if lv.style == STYLE_FOREST do
        var leaf = lv.wall_color.lerp(ap.Color(40, 70, 36), cell_hash(x, y, 5) * 0.5)
        if h < 0.62 do
            var tall = 2.6 + cell_hash(x, y, 6) * 1.6
            ap.draw(r.thigh, at + ap.Vec3(0, tall / 2, 0), ap.Color(70, 54, 40).brightness(b), ap.Vec3(0, turn, 0), ap.Vec3(0.45, tall, 0.45))
            ap.draw(r.orb, at + ap.Vec3(0, tall + 0.4, 0), leaf.brightness(b), ap.Vec3(0, turn, 0), ap.Vec3(2.8, 2.0, 2.8))
            ap.draw(r.cone, at + ap.Vec3(0, tall + 1.5, 0), leaf.brightness(b * 0.85), ap.Vec3(0, turn, 0), ap.Vec3(2.0, 1.8, 2.0))
        else if h < 0.84 do
            ap.draw(r.orb, at + ap.Vec3(0, 0.6, 0), leaf.brightness(b * 1.1), ap.Vec3(0, turn, 0), ap.Vec3(2.1, 1.3, 2.1))
            ap.draw(r.orb, at + ap.Vec3(0.4, 1.0, 0.2), leaf.brightness(b * 0.95), ap.Vec3(0, turn, 0), ap.Vec3(1.2, 0.9, 1.2))
        else do
            # A boulder, sat down into the earth.
            var rock = ap.Color(120, 116, 110)
            ap.draw(r.orb, at + ap.Vec3(0, 0.5, 0), rock.brightness(b), ap.Vec3(5, turn, 3), ap.Vec3(2.1, 1.7, 1.9))
            ap.draw(r.orb, at + ap.Vec3(0.6, 0.15, 0.4), rock.brightness(b * 0.85), ap.Vec3(0, turn, 0), ap.Vec3(1.1, 0.7, 1.0))
            ap.draw(r.orb, at + ap.Vec3(0, 0.02, 0), ap.Color(70, 60, 46).brightness(b), ap.Vec3(0, turn, 0), ap.Vec3(2.5, 0.2, 2.3))
        end
    else if lv.style == STYLE_CAVE do
        var rock = lv.wall_color.lerp(ap.Color(120, 110, 100), cell_hash(x, y, 5) * 0.4)
        var tall = 1.8 + h * 2.4
        ap.draw(r.orb, at + ap.Vec3(0, tall * 0.4, 0), rock.brightness(b), ap.Vec3(cell_hash(x, y, 7) * 8, turn, 0), ap.Vec3(2.6, tall, 2.5))
        ap.draw(r.orb, at + ap.Vec3(0, tall * 0.88, 0), rock.brightness(b * 0.8), ap.Vec3(0, turn, 6), ap.Vec3(1.9, tall * 0.5, 1.9))
        if h > 0.85 do
            # A stalagmite.
            ap.draw(r.spike, at + ap.Vec3(0.3, tall * 0.9 + 0.5, 0.2), rock.brightness(b * 0.9), ap.Vec3(0, turn, 0), ap.Vec3(0.5, 1.2, 0.5))
        end
    else do
        # A building: its height its own, a band of lit windows on some.
        var tall = 4.5 + h * 5
        var brick = lv.wall_color.lerp(ap.Color(150, 140, 130), cell_hash(x, y, 5) * 0.35)
        ap.draw(box(), c + ap.Vec3(0, tall / 2, 0), brick.brightness(b), ap.Vec3(0, 0, 0), ap.Vec3(TILE, tall, TILE), bricks())
        ap.draw(box(), c + ap.Vec3(0, tall + 0.1, 0), brick.brightness(b * 0.6), ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.04, 0.2, TILE * 1.04))
        if cell_hash(x, y, 8) > 0.45 do
            for floor_up in 0..<int(tall / 2.2) do
                var lit_window = cell_hash(x, y, 9 + floor_up) > 0.4
                ap.draw(box(), c + ap.Vec3(0, 1.6 + double(floor_up) * 2.2, 0), (ap.Color(255, 210, 130) if lit_window else ap.Color(30, 30, 40)).brightness(0.4 + 0.6 * light_up),
                    ap.Vec3(0, 0, 0), ap.Vec3(TILE * 1.01, 0.5, TILE * 1.01))
            end
        end
        if faces and h < 0.2 do
            # An awning over a door.
            ap.draw(box(), c + face * (TILE / 2 + 0.02) + ap.Vec3(0, 1.1, 0), ap.Color(40, 30, 28).brightness(b), ap.Vec3(0, yaw, 0), ap.Vec3(0.9, 2.2, 0.05))
            ap.draw(r.wedge, c + face * (TILE / 2 + 0.4) + ap.Vec3(0, 2.5, 0), lv.glow.lerp(ap.Color(120, 40, 40), 0.6).brightness(b), ap.Vec3(90, yaw, 0), ap.Vec3(1.6, 0.8, 0.12))
        end
    end
end

# The floor and wall textures, painted once, in grey so a level's colors tint them.
function paint_lab_tiles(int x, int y) returns ap.Color
    var line = x % 32 < 1 or y % 32 < 1
    var v = cell_hash(x // 32, y // 32, 3)
    var g = 140 if line else 220 + int(v * 30)
    return ap.Color(g, g, g)
end
function paint_planks(int x, int y) returns ap.Color
    var plank = y // 8
    var shift = (plank * 23) % 64
    var seam = y % 8 == 0 or (x + shift) % 64 == 0
    var grain = math.sin(double(x) * 0.35 + double(plank) * 3.1) * 12
    var g = 120 if seam else 190 + int(grain) + int(cell_hash(plank, (x + shift) // 64, 5) * 40)
    return ap.Color(g, g, g)
end
function paint_checker(int x, int y) returns ap.Color
    var dark = ((x // 16) + (y // 16)) % 2 == 0
    var g = 170 if dark else 250
    return ap.Color(g, g, g)
end
function paint_panels(int x, int y) returns ap.Color
    var seam = x % 32 < 1 or y % 32 < 1
    var rivet = (x % 32 == 3 or x % 32 == 28) and (y % 32 == 3 or y % 32 == 28)
    var g = 130 if seam else (110 if rivet else 200 + int(cell_hash(x // 32, y // 32, 7) * 25))
    return ap.Color(g, g, g)
end
function paint_stripes(int x, int y) returns ap.Color
    return ap.Color(255, 255, 255) if ((x + y) // 10) % 2 == 0 else ap.Color(40, 40, 40)
end
function paint_wallpaper(int x, int y) returns ap.Color
    var band = x % 16
    var g = 215 if band < 7 else 175
    if band == 11 and y % 12 < 4 do
        g = 235
    end
    return ap.Color(g, g, g)
end
ap.Texture[] style_textures = []
function style_texture(int k) returns ap.Texture
    if style_textures.length == 0 do
        style_textures = [ap.make_texture(64, 64, paint_lab_tiles), ap.make_texture(64, 64, paint_planks),
            ap.make_texture(64, 64, paint_checker), ap.make_texture(64, 64, paint_panels),
            ap.make_texture(64, 64, paint_stripes), ap.make_texture(64, 64, paint_wallpaper)]
    end
    return style_textures[k]
end
function lab_tiles() returns ap.Texture
    return style_texture(0)
end
function planks() returns ap.Texture
    return style_texture(1)
end
function checker() returns ap.Texture
    return style_texture(2)
end
function panels() returns ap.Texture
    return style_texture(3)
end
function stripes() returns ap.Texture
    return style_texture(4)
end
function wallpaper() returns ap.Texture
    return style_texture(5)
end

function paint_grass(int x, int y) returns ap.Color
    var v = math.sin(double(x) * 12.9898 + double(y) * 78.233) * 43758.5453
    var n = v - math.floor(v)
    var g = 170 + int(n * 60) + (20 if (x * 7 + y * 3) % 11 == 0 else 0)
    return ap.Color(g, g, g)
end
function paint_stone(int x, int y) returns ap.Color
    var v = math.sin(double(x / 4) * 12.9898 + double(y / 4) * 78.233) * 43758.5453
    var n = v - math.floor(v)
    var crack = (x + y * 2) % 23 == 0 or (x * 3 - y) % 29 == 0
    var g = (110 if crack else 160) + int(n * 50)
    return ap.Color(g, g, g)
end
ap.Texture? grass_tex = null
ap.Texture? stone_tex = null
function grass() returns ap.Texture
    var have = grass_tex
    if have != null do
        return have as ap.Texture
    end
    var t = ap.make_texture(64, 64, paint_grass)
    grass_tex = t
    return t
end
function stone() returns ap.Texture
    var have = stone_tex
    if have != null do
        return have as ap.Texture
    end
    var t = ap.make_texture(64, 64, paint_stone)
    stone_tex = t
    return t
end

function revealed_at(ap.Vec3 p) returns bool
    var c = cell_of(p)
    if c[0] < 0 or c[1] < 0 or c[0] >= lv.w or c[1] >= lv.h do
        return false
    end
    return lv.reveal[c[1] * lv.w + c[0]] > 0.3
end

function draw_streak(puppet.Rig r, Streak st)
    var way = st.to - st.from
    var len = way.length()
    if len < 0.01 do
        return
    end
    var d = unit(way)
    var yaw = heading_of(d)
    var pitch = -math.asin(math.clamp(d.y, -1.0, 1.0)) * 180 / math.PI
    var fade = st.life / st.span
    var mid = (st.from + st.to) * 0.5
    ap.draw(r.box, mid, st.color.fade(fade), ap.Vec3(pitch, yaw, 0), ap.Vec3(st.width * 2, st.width * 2, len))
    ap.draw(r.box, mid, ap.WHITE.fade(fade), ap.Vec3(pitch, yaw, 0), ap.Vec3(st.width * 0.8, st.width * 0.8, len))
end

function draw_actor(puppet.Rig r, Actor a)
    var alpha = a.fade
    if a.state == S_DEAD do
        alpha *= math.clamp(1 - double(a.frame - 60) / 100, 0.0, 1.0)
    end
    if alpha <= 0.02 do
        return
    end
    if a.kind != A_PLAYER and not revealed_at(a.body.position) and not a.aware and a.kind != A_BOSS do
        return
    end
    if a.kind == A_BOSS and a.role == ROLE_GAUNTLET and flood <= 0.05 do
        return
    end
    var at = a.body.position + ap.Vec3(0, a.look.hover + a.lift + (0.08 * math.sin(double(ticks) * 0.05) if a.hovering else 0.0), 0)
    if a.kind == A_BOSS do
        alpha *= boss_alpha(a)
        if a.role == ROLE_SATAN and a.rise < 1 do
            at = at - ap.Vec3(0, (1 - puppet.smooth(a.rise)) * 2.0 * a.look.tall, 0)
        end
    end
    if a.kind == A_DECOY do
        alpha *= 0.55 + 0.1 * math.sin(double(ticks) * 0.3)
    end
    if void_dark > 0.6 and a.kind == A_PLAYER do
        alpha *= math.max(1.0 - (void_dark - 0.6) * 2, 0.15)
    end
    puppet.draw(r, a.look, a.pose, at, a.heading, alpha)
    if a.kind == A_BOSS and alive(a) and (data.difficulty == DIFF_HELL or a.true_form or a.role == ROLE_SATAN) and a.fade > 0.3 do
        # Burning: a red-fire glow about it.
        ap.lighting(false)
        var flick = 0.85 + 0.15 * math.sin(double(ticks) * 0.5 + double(a.boss_index))
        var tall = 1.8 * a.look.tall
        ap.draw(r.orb, at + ap.Vec3(0, tall * 0.5, 0), ap.Color(255, 60, 20).fade(0.13 * flick * alpha), ap.Vec3(0, double(ticks) * 2, 0), ap.Vec3(1.3 * a.look.bulk, tall * 1.1, 1.3 * a.look.bulk))
        ap.draw(r.ring, at + ap.Vec3(0, 0.05, 0), ap.Color(255, 90, 30).fade(0.5 * flick * alpha), ap.Vec3(0, double(ticks) * 3, 0), ap.Vec3(1.8, 1.8, 1.8) * a.look.bulk)
        ap.lighting(true)
    end
    if a.kind == A_BOSS and a.buff_time > 0 do
        ap.lighting(false)
        ap.draw(r.ring, a.body.position + ap.Vec3(0, 0.1, 0), a.look.accent.fade(0.6), ap.Vec3(0, double(ticks) * 5, 0), ap.Vec3(1.8, 1.8, 1.8))
        ap.lighting(true)
    end
    if a.guard_time > 0 or a.armor_time > 0 do
        ap.lighting(false)
        ap.draw(r.ring, a.body.position + ap.Vec3(0, 0.1, 0), ap.Color(255, 220, 140).fade(0.6), ap.Vec3(0, double(ticks) * 3, 0), ap.Vec3(1.6, 1.6, 1.6))
        ap.lighting(true)
    end
end

function draw_prop(puppet.Rig r, Prop pr)
    var s = pr.size
    var stone = lv.wall_color.lerp(ap.WHITE, 0.15)
    var sink = (1 - pr.rise) * 3.4 * s
    if pr.kind == PROP_PILLAR do
        var base = pr.at - ap.Vec3(0, sink, 0)
        ap.draw(r.drum, base + ap.Vec3(0, 1.6 * s, 0), stone, ap.Vec3(0, pr.turn, 0), ap.Vec3(0.8 * s, 3.2 * s, 0.8 * s))
        ap.draw(r.soft, base + ap.Vec3(0, 0.1, 0), stone.brightness(0.8), ap.Vec3(0, pr.turn, 0), ap.Vec3(1.1 * s, 0.2, 1.1 * s))
        ap.draw(r.soft, base + ap.Vec3(0, 3.2 * s, 0), stone.brightness(0.8), ap.Vec3(0, pr.turn, 0), ap.Vec3(1.05 * s, 0.25, 1.05 * s))
    else if pr.kind == PROP_TOMB do
        ap.draw(r.soft, pr.at + ap.Vec3(0, 0.55 * s, 0), stone, ap.Vec3(0, pr.turn, 4), ap.Vec3(0.7 * s, 1.1 * s, 0.18 * s))
        ap.draw(r.orb, pr.at + ap.Vec3(0, 1.1 * s, 0), stone, ap.Vec3(0, pr.turn, 4), ap.Vec3(0.7 * s, 0.4 * s, 0.18 * s))
        ap.draw(r.soft, pr.at + ap.Vec3(0, 0.05, 0), ap.Color(60, 50, 40), ap.Vec3(0, pr.turn, 0), ap.Vec3(0.9 * s, 0.1, 1.6 * s))
    else if pr.kind == PROP_TREE do
        var bark = ap.Color(60, 48, 40)
        ap.draw(r.thigh, pr.at + ap.Vec3(0, 1.4 * s, 0), bark, ap.Vec3(0, pr.turn, 0), ap.Vec3(0.4 * s, 2.8 * s, 0.4 * s))
        for k in 0..<4 do
            ap.draw(r.blade, pr.at + ap.Vec3(0, (2.2 + double(k) * 0.35) * s, 0), bark, ap.Vec3(0, pr.turn + double(k) * 97, 40 + double(k) * 8), ap.Vec3(0.12 * s, 1.4 * s, 0.12 * s))
        end
    else if pr.kind == PROP_ROCK do
        # Sat firmly in the ground: half of it under the floor, a ring of earth and pebbles round it.
        var rock = lv.wall_color.lerp(ap.Color(130, 124, 116), 0.4)
        ap.draw(r.orb, pr.at + ap.Vec3(0, 0.28 * s, 0), rock, ap.Vec3(4, pr.turn, 3), ap.Vec3(1.25 * s, 0.95 * s, 1.05 * s))
        ap.draw(r.orb, pr.at + ap.Vec3(0.45 * s, 0.1 * s, 0.3 * s), rock.brightness(0.85), ap.Vec3(0, pr.turn, 0), ap.Vec3(0.6 * s, 0.45 * s, 0.6 * s))
        ap.draw(r.orb, pr.at + ap.Vec3(0, 0.01, 0), lv.floor_color.lerp(ap.Color(70, 60, 50), 0.6), ap.Vec3(0, pr.turn, 0), ap.Vec3(1.6 * s, 0.12, 1.4 * s))
        for k in 0..<3 do
            var a = pr.turn + double(k) * 120
            ap.draw(r.orb, pr.at + forward_of(a) * (0.75 * s) + ap.Vec3(0, 0.04, 0), rock.brightness(0.75), ap.Vec3(0, a, 0), ap.Vec3(0.18, 0.1, 0.16) * s)
        end
    else if pr.kind == PROP_BUSH do
        var leaf = lv.wall_color.lerp(ap.Color(60, 96, 50), 0.4)
        ap.draw(r.orb, pr.at + ap.Vec3(0, 0.45 * s, 0), leaf, ap.Vec3(0, pr.turn, 0), ap.Vec3(1.4 * s, 0.9 * s, 1.4 * s))
    else if pr.kind == PROP_CRATE do
        var wood = ap.Color(110, 80, 52)
        ap.draw(r.soft, pr.at + ap.Vec3(0, 0.5 * s, 0), wood, ap.Vec3(0, pr.turn, 0), ap.Vec3(s, s, s))
        ap.draw(r.soft, pr.at + ap.Vec3(0.2, 1.3 * s, 0.1), wood.brightness(0.85), ap.Vec3(0, pr.turn + 30, 0), ap.Vec3(0.6 * s, 0.6 * s, 0.6 * s))
    else if pr.kind == PROP_CRYSTAL do
        ap.lighting(false)
        for k in 0..<3 do
            ap.draw(r.blade, pr.at + ap.Vec3(double(k - 1) * 0.25 * s, 0.7 * s, 0), lv.glow.fade(0.85), ap.Vec3(0, pr.turn + double(k) * 40, double(k - 1) * 20), ap.Vec3(0.3 * s, (1.6 - 0.3 * double(k % 2)) * s, 0.3 * s))
        end
        ap.lighting(true)
    else if pr.kind == PROP_TANK do
        # A glass tank on a steel base, something floating in the glow.
        var steel = ap.Color(120, 128, 138)
        ap.draw(r.drum, pr.at + ap.Vec3(0, 0.2, 0), steel, ap.Vec3(0, pr.turn, 0), ap.Vec3(1.0 * s, 0.4, 1.0 * s))
        ap.draw(r.drum, pr.at + ap.Vec3(0, 2.45 * s, 0), steel, ap.Vec3(0, pr.turn, 0), ap.Vec3(1.0 * s, 0.25, 1.0 * s))
        ap.lighting(false)
        ap.draw(r.drum, pr.at + ap.Vec3(0, 1.3 * s, 0), lv.glow.fade(0.35), ap.Vec3(0, pr.turn, 0), ap.Vec3(0.86 * s, 1.9 * s, 0.86 * s))
        var bob = 0.08 * math.sin(double(ticks) * 0.03 + pr.turn)
        ap.draw(r.orb, pr.at + ap.Vec3(0, (1.3 + bob) * s, 0), lv.glow.lerp(ap.BLACK, 0.5).fade(0.8), ap.Vec3(0, double(ticks) * 0.3, 20), ap.Vec3(0.35, 0.5, 0.3) * s)
        if ticks % 20 == 0 and flat_distance(pr.at, player.body.position) < 12 do
            motes.push(Mote(pr.at + ap.Vec3(ap.random(-0.25, 0.25), 0.5 * s, ap.random(-0.25, 0.25)), ap.Vec3(0, 0.6, 0), ap.WHITE.fade(0.5), 2.2, 2.2, 0.04))
        end
        ap.lighting(true)
    else if pr.kind == PROP_CANDLES do
        # A tall brass candelabra.
        var brass = ap.Color(200, 160, 70)
        ap.draw(r.flare, pr.at + ap.Vec3(0, 0.12, 0), brass.brightness(0.8), ap.Vec3(0, 0, 0), ap.Vec3(0.5, 0.24, 0.5))
        ap.draw(r.rod, pr.at + ap.Vec3(0, 1.0 * s, 0), brass, ap.Vec3(0, 0, 0), ap.Vec3(0.07, 1.9 * s, 0.07))
        ap.draw(r.soft, pr.at + ap.Vec3(0, 1.9 * s, 0), brass, ap.Vec3(0, pr.turn, 0), ap.Vec3(0.9, 0.05, 0.08))
        for k in -1..<2 do
            var p = pr.at + forward_of(pr.turn + 90) * (double(k) * 0.42) + ap.Vec3(0, 1.9 * s, 0)
            ap.draw(r.drum, p + ap.Vec3(0, 0.16, 0), ap.Color(240, 232, 214), ap.Vec3(0, 0, 0), ap.Vec3(0.07, 0.28, 0.07))
            ap.lighting(false)
            ap.draw(r.blade, p + ap.Vec3(0, 0.38, 0), ap.Color(255, 200, 110), ap.Vec3(0, double(ticks) * 2, 0), ap.Vec3(0.06, 0.13 + 0.02 * math.sin(double(ticks) * 0.4 + double(k)), 0.06))
            ap.lighting(true)
        end
    else if pr.kind == PROP_BLOCKS do
        var colors = [ap.Color(240, 120, 120), ap.Color(120, 180, 240), ap.Color(250, 210, 90), ap.Color(130, 210, 130)]
        for k in 0..<3 do
            var col = colors[(int(pr.turn) + k) % 4]
            var size = 0.8 * s * (1 - 0.15 * double(k))
            var p = pr.at + ap.Vec3(0, size / 2 + double(k) * 0.72 * s, 0)
            ap.draw(r.soft, p, col, ap.Vec3(0, pr.turn + double(k) * 25, 0), ap.Vec3(size, size, size))
            ap.draw(r.soft, p, col.lerp(ap.WHITE, 0.6), ap.Vec3(0, pr.turn + double(k) * 25, 0), ap.Vec3(size * 1.02, size * 0.45, size * 0.3))
        end
    else if pr.kind == PROP_YARN do
        var col = [ap.Color(240, 110, 140), ap.Color(110, 170, 240), ap.Color(250, 200, 90)][int(pr.turn) % 3]
        ap.draw(r.orb, pr.at + ap.Vec3(0, 0.7 * s, 0), col, ap.Vec3(double(ticks) * 0.1, pr.turn, 0), ap.Vec3(1.4 * s, 1.4 * s, 1.4 * s))
        for k in 0..<3 do
            ap.draw(r.ring, pr.at + ap.Vec3(0, 0.7 * s, 0), col.brightness(0.8), ap.Vec3(double(k) * 60, pr.turn + double(k) * 40, 0), ap.Vec3(1.45, 1.45, 1.45) * s)
        end
        ap.draw(r.rod, pr.at + forward_of(pr.turn) * (1.2 * s) + ap.Vec3(0, 0.03, 0), col, ap.Vec3(90, pr.turn, 0), ap.Vec3(0.04, 1.4, 0.04))
    else if pr.kind == PROP_CRATER do
        var rubble = lv.wall_color.lerp(ap.Color(110, 100, 90), 0.5)
        for k in 0..<4 do
            var a = pr.turn + double(k) * 90
            ap.draw(r.soft, pr.at + forward_of(a) * (0.4 * s) + ap.Vec3(0, 0.12, 0), rubble.brightness(0.7 + 0.1 * double(k)), ap.Vec3(10, a, 14), ap.Vec3(0.5, 0.25, 0.4) * s)
        end
    else do
        # A lamp on a post, its flame the level's color.
        ap.draw(r.rod, pr.at + ap.Vec3(0, 1.0, 0), ap.Color(40, 36, 36), ap.Vec3(0, 0, 0), ap.Vec3(0.1, 2.0, 0.1))
        ap.draw(r.flare, pr.at + ap.Vec3(0, 2.05, 0), ap.Color(50, 44, 40), ap.Vec3(0, 0, 0), ap.Vec3(0.34, 0.1, 0.34))
        ap.lighting(false)
        var flick = 1 + 0.08 * math.sin(double(ticks) * 0.3 + pr.turn)
        ap.draw(r.blade, pr.at + ap.Vec3(0, 2.28, 0), lv.glow, ap.Vec3(0, double(ticks) * 2, 0), ap.Vec3(0.14 * flick, 0.32 * flick, 0.14 * flick))
        ap.lighting(true)
    end
end

# A chest: a banded trunk on little feet, its lid rounded, a lock plate on the front. Its wood
# and bands say how good what is inside is: plain wood and iron, dark wood and silver, or red
# lacquer and gold with a gem in the lock (and a glint about it until it is opened).
function draw_chest(puppet.Rig r, Chest c)
    var woods = [ap.Color(110, 72, 44), ap.Color(70, 46, 34), ap.Color(130, 36, 34)]
    var metals = [ap.Color(96, 96, 104), ap.Color(196, 200, 210), ap.Color(232, 186, 70)]
    var wood = woods[c.tier]
    var metal = metals[c.tier]
    var dark = wood.brightness(0.6)
    ap.push_3d()
    ap.translate_3d(c.at)
    ap.rotate_3d(c.heading, ap.Vec3(0, 1, 0))
    # Feet.
    for sx in [-1.0, 1.0] do
        for sz in [-1.0, 1.0] do
            ap.draw(r.soft, ap.Vec3(sx * 0.48, 0.04, sz * 0.27), metal.brightness(0.7), ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.08, 0.12))
        end
    end
    # The body, its planks, its bands and corners.
    ap.draw(r.soft, ap.Vec3(0, 0.34, 0), wood, ap.Vec3(0, 0, 0), ap.Vec3(1.1, 0.52, 0.64))
    for y in [0.24, 0.42] do
        ap.draw(r.soft, ap.Vec3(0, y, 0), dark, ap.Vec3(0, 0, 0), ap.Vec3(1.115, 0.018, 0.655))
    end
    for bx in [-0.4, 0.4] do
        ap.draw(r.soft, ap.Vec3(bx, 0.34, 0), metal, ap.Vec3(0, 0, 0), ap.Vec3(0.08, 0.54, 0.665))
    end
    for sx in [-1.0, 1.0] do
        for sz in [-1.0, 1.0] do
            ap.draw(r.soft, ap.Vec3(sx * 0.53, 0.14, sz * 0.3), metal, ap.Vec3(0, 0, 0), ap.Vec3(0.07, 0.2, 0.07))
            ap.draw(r.spike, ap.Vec3(sx * 0.42, 0.56, sz * 0.32), metal.brightness(0.9), ap.Vec3(0, 45, 0), ap.Vec3(0.04, 0.04, 0.04))
        end
    end
    # The lid, on its hinge at the back.
    ap.push_3d()
    ap.translate_3d(ap.Vec3(0, 0.6, -0.32))
    ap.rotate_3d(-c.lid * 105, ap.Vec3(1, 0, 0))
    ap.draw(r.soft, ap.Vec3(0, 0.03, 0.32), wood.brightness(1.05), ap.Vec3(0, 0, 0), ap.Vec3(1.12, 0.08, 0.66))
    ap.draw(r.drum, ap.Vec3(0, 0.1, 0.32), wood.brightness(1.12), ap.Vec3(0, 0, 90), ap.Vec3(0.3, 1.1, 0.64))
    for bx in [-0.4, 0.4] do
        ap.draw(r.drum, ap.Vec3(bx, 0.1, 0.32), metal, ap.Vec3(0, 0, 90), ap.Vec3(0.33, 0.08, 0.67))
    end
    ap.draw(r.soft, ap.Vec3(0, 0.02, 0.665), metal, ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.12, 0.03))
    ap.pop_3d()
    # The lock plate (and a gem in a gold one).
    ap.draw(r.soft, ap.Vec3(0, 0.5, 0.33), metal, ap.Vec3(0, 0, 0), ap.Vec3(0.17, 0.2, 0.04))
    ap.draw(r.soft, ap.Vec3(0, 0.47, 0.352), ap.Color(16, 12, 12), ap.Vec3(0, 0, 0), ap.Vec3(0.035, 0.07, 0.01))
    if c.tier == 2 do
        ap.lighting(false)
        ap.draw(r.orb, ap.Vec3(0, 0.56, 0.355), ap.Color(255, 60, 80), ap.Vec3(0, 0, 0), ap.Vec3(0.05, 0.05, 0.03))
        ap.lighting(true)
    end
    if c.opened and c.lid < 1 do
        ap.lighting(false)
        ap.draw(r.orb, ap.Vec3(0, 0.8, 0), metal.fade(0.6 * (1 - c.lid)), ap.Vec3(0, 0, 0), ap.Vec3(0.8, 0.8, 0.8))
        ap.lighting(true)
    end
    ap.pop_3d()
    if not c.opened and c.tier > 0 and ticks % (18 if c.tier == 2 else 40) == 0 do
        motes.push(Mote(c.at + ap.Vec3(ap.random(-0.5, 0.5), ap.random(0.3, 0.9), ap.random(-0.3, 0.3)), ap.Vec3(0, 0.4, 0), metal.lerp(ap.WHITE, 0.3), 0.8, 0.8, 0.04))
    end
end

function draw_book(puppet.Rig r, Book b)
    if b.red do
        if b.taken do
            return
        end
        # A red book: it flies out of its boss and hangs in the air, burning.
        var t = puppet.smooth(b.fly)
        var to = b.at + ap.Vec3(0, 1.3, 0)
        var at = b.start.lerp(to, t) + ap.Vec3(0, math.sin(t * math.PI) * 1.5, 0) + ap.Vec3(0, 0.06 * math.sin(double(ticks) * 0.06), 0)
        ap.draw(r.soft, at, ap.Color(120, 10, 16), ap.Vec3(-20, double(ticks) * 0.8, 0), ap.Vec3(0.55, 0.12, 0.42))
        ap.lighting(false)
        ap.draw(r.soft, at + ap.Vec3(0, 0.07, 0), ap.Color(255, 80, 60), ap.Vec3(-20, double(ticks) * 0.8, 0), ap.Vec3(0.46, 0.03, 0.34))
        ap.draw(r.orb, at, ap.Color(255, 40, 30).fade(0.18), ap.Vec3(0, 0, 0), ap.Vec3(1.2, 1.2, 1.2))
        ap.lighting(true)
        if ticks % 3 == 0 do
            motes.push(Mote(at + ap.Vec3(ap.random(-0.3, 0.3), 0, ap.random(-0.3, 0.3)), ap.Vec3(0, 1.2, 0), ap.Color(255, int(ap.random(40, 140)), 30), 0.5, 0.5, 0.06))
        end
        return
    end
    var stone = lv.wall_color.lerp(ap.WHITE, 0.2)
    ap.draw(r.flare, b.at + ap.Vec3(0, 0.45, 0), stone, ap.Vec3(0, 0, 0), ap.Vec3(0.5, 0.9, 0.5))
    ap.draw(r.soft, b.at + ap.Vec3(0, 0.95, 0), stone.brightness(0.8), ap.Vec3(0, 0, 0), ap.Vec3(0.7, 0.1, 0.55))
    if b.taken do
        return
    end
    var hover = 0.05 * math.sin(double(ticks) * 0.05)
    ap.draw(r.soft, b.at + ap.Vec3(0, 1.1 + hover, 0), ap.Color(60, 20, 40), ap.Vec3(-20, double(ticks) * 0.5, 0), ap.Vec3(0.5, 0.1, 0.38))
    ap.lighting(false)
    ap.draw(r.soft, b.at + ap.Vec3(0, 1.16 + hover, 0), ap.Color(220, 160, 255), ap.Vec3(-20, double(ticks) * 0.5, 0), ap.Vec3(0.42, 0.03, 0.3))
    for k in 0..<4 do
        var a = double(ticks) * 0.02 + double(k) * math.PI / 2
        ap.draw(r.spike, b.at + ap.Vec3(math.sin(a) * 0.7, 1.5 + 0.15 * math.sin(a * 3), math.cos(a) * 0.7), ap.Color(200, 120, 255).fade(0.7), ap.Vec3(0, a * 57, 45), ap.Vec3(0.08, 0.08, 0.02))
    end
    ap.lighting(true)
end

# The Gambler's table, the Smith's forge, a shrine of pacts.
roster.Look[] spot_looks = []
function spot_keeper(int kind) returns roster.Look
    if spot_looks.length == 0 do
        var g = roster.Look()
        g.skin = ap.Color(214, 206, 186)
        g.body = ap.Color(40, 90, 60)
        g.legs = ap.Color(30, 30, 36)
        g.trim = ap.Color(222, 178, 70)
        g.accent = ap.Color(255, 220, 120)
        g.eyes = ap.Color(255, 220, 120)
        g.glowing_eyes = true
        g.head = roster.HEAD_SEER
        g.weapon = roster.WEAPON_HANDS
        var f = roster.Look()
        f.skin = ap.Color(150, 110, 90)
        f.body = ap.Color(90, 60, 40)
        f.legs = ap.Color(50, 40, 36)
        f.trim = ap.Color(60, 40, 30)
        f.accent = ap.Color(255, 140, 60)
        f.metal = ap.Color(110, 110, 120)
        f.eyes = ap.Color(255, 160, 80)
        f.glowing_eyes = true
        f.head = roster.HEAD_STRONGMAN
        f.weapon = roster.WEAPON_AXE
        f.bulk = 1.25
        var h = roster.Look()
        h.skin = ap.Color(40, 20, 24)
        h.body = ap.Color(60, 10, 16)
        h.legs = ap.Color(30, 8, 12)
        h.cape = true
        h.cape_color = ap.Color(50, 8, 12)
        h.eyes = ap.Color(255, 60, 50)
        h.glowing_eyes = true
        h.head = roster.HEAD_VEIL
        h.weapon = roster.WEAPON_HANDS
        h.hover = 0.25
        spot_looks = [g, f, h]
    end
    return spot_looks[math.clamp(kind - ROOM_GAMBLER, 0, 2)]
end
function draw_spot(puppet.Rig r, Spot sp)
    var at = sp.at
    var face = heading_of(player.body.position - at)
    if sp.kind == ROOM_GAMBLER do
        var felt = ap.Color(30, 100, 60)
        ap.draw(r.soft, at + ap.Vec3(0, 0.45, 1.0), ap.Color(90, 60, 40), ap.Vec3(0, 0, 0), ap.Vec3(2.0, 0.9, 0.9))
        ap.draw(r.soft, at + ap.Vec3(0, 0.91, 1.0), felt, ap.Vec3(0, 0, 0), ap.Vec3(1.9, 0.03, 0.8))
        for k in 0..<4 do
            var c = ap.Color(240, 236, 226) if k % 2 == 0 else ap.Color(200, 40, 50)
            ap.draw(r.soft, at + ap.Vec3(-0.6 + double(k) * 0.35, 0.94, 1.0 + 0.1 * double(k % 2)), c, ap.Vec3(0, double(k) * 25, 0), ap.Vec3(0.18, 0.01, 0.26))
        end
        ap.draw(r.soft, at + ap.Vec3(0.7, 0.98, 0.95), ap.Color(236, 230, 214), ap.Vec3(0, double(ticks) * 0.5, 0), ap.Vec3(0.12, 0.12, 0.12))
        for k in 0..<5 do
            ap.draw(r.drum, at + ap.Vec3(0.4, 0.94 + double(k) * 0.03, 1.2), ap.Color(222, 178, 70), ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.025, 0.12))
        end
    else if sp.kind == ROOM_FORGE do
        var iron = ap.Color(60, 60, 66)
        ap.draw(r.soft, at + ap.Vec3(-1.2, 0.5, 0.6), ap.Color(90, 70, 60), ap.Vec3(0, 0, 0), ap.Vec3(1.2, 1.0, 1.0))
        ap.lighting(false)
        var flick = 0.8 + 0.2 * math.sin(double(ticks) * 0.3)
        ap.draw(r.soft, at + ap.Vec3(-1.2, 1.0, 0.6), ap.Color(255, 120, 40).brightness(flick), ap.Vec3(0, 0, 0), ap.Vec3(0.9, 0.06, 0.7))
        ap.lighting(true)
        ap.draw(r.soft, at + ap.Vec3(0.6, 0.35, 0.8), iron, ap.Vec3(0, 20, 0), ap.Vec3(0.3, 0.7, 0.3))
        ap.draw(r.soft, at + ap.Vec3(0.6, 0.74, 0.8), iron.brightness(1.2), ap.Vec3(0, 20, 0), ap.Vec3(0.8, 0.12, 0.32))
        ap.draw(r.spike, at + ap.Vec3(1.05, 0.74, 0.95), iron.brightness(1.2), ap.Vec3(0, 20, -90), ap.Vec3(0.14, 0.3, 0.14))
        if ticks % 6 == 0 do
            motes.push(Mote(at + ap.Vec3(-1.2 + ap.random(-0.3, 0.3), 1.05, 0.6 + ap.random(-0.3, 0.3)), ap.Vec3(ap.random(-0.2, 0.2), ap.random(1.0, 2.0), ap.random(-0.2, 0.2)), ap.Color(255, int(ap.random(90, 200)), 40), 0.8, 0.8, 0.04))
        end
    else do
        var stone = ap.Color(70, 60, 64)
        ap.draw(r.soft, at + ap.Vec3(0, 0.5, 0.6), stone, ap.Vec3(0, 0, 0), ap.Vec3(1.6, 1.0, 0.9))
        ap.draw(r.soft, at + ap.Vec3(0, 1.02, 0.6), ap.Color(110, 20, 26), ap.Vec3(0, 0, 0), ap.Vec3(1.4, 0.04, 0.7))
        for sx in [-0.6, 0.6] do
            ap.draw(r.drum, at + ap.Vec3(sx, 1.2, 0.6), ap.Color(150, 20, 26), ap.Vec3(0, 0, 0), ap.Vec3(0.1, 0.36, 0.1))
            ap.lighting(false)
            ap.draw(r.blade, at + ap.Vec3(sx, 1.45, 0.6), ap.Color(255, 120, 80), ap.Vec3(0, double(ticks) * 2, 0), ap.Vec3(0.06, 0.12, 0.06))
            ap.lighting(true)
        end
        ap.lighting(false)
        ap.draw(r.ring, at + ap.Vec3(0, 2.3, 0.6), ap.Color(255, 50, 40).fade(0.7), ap.Vec3(90, double(ticks) * 0.8, 0), ap.Vec3(1.2, 1.2, 1.2))
        ap.draw(r.ring, at + ap.Vec3(0, 2.3, 0.6), ap.Color(255, 50, 40).fade(0.5), ap.Vec3(90, -double(ticks) * 1.3, 0), ap.Vec3(0.8, 0.8, 0.8))
        ap.lighting(true)
    end
    var look = spot_keeper(sp.kind)
    var pose = puppet.make_pose(look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, double(ticks) / 60 + double(sp.kind), 1)
    puppet.draw(r, look, pose, at + ap.Vec3(0, look.hover, -0.2), face, 1)
end

function draw_portals(puppet.Rig r)
    ap.lighting(false)
    for pt in portals do
        var grow = math.min(1.0, (2.6 - pt.fire_in) * 3) if pt.kind == P_BARRAGE else 1.0
        grow = math.clamp(grow, 0.2, 1.0) * math.min(pt.life * 3, 1.0)
        var c = pt.color
        if pt.kind == P_PILLARS do
            var ready = 1 - math.clamp(pt.fire_in, 0.0, 1.0)
            ap.draw(r.ring, pt.at, c.fade(0.4 + 0.5 * ready), ap.Vec3(0, double(ticks) * 4, 0), ap.Vec3(2.4, 2.4, 2.4) * (0.6 + 0.4 * ready))
            if pt.fired do
                ap.draw(r.drum, pt.at + ap.Vec3(0, 2.5, 0), ap.Color(255, 140, 40).fade(0.5 * math.min(pt.life, 1.0)), ap.Vec3(0, double(ticks) * 6, 0), ap.Vec3(1.2, 5, 1.2))
            end
            continue
        end
        if pt.kind == P_DROP or pt.kind == P_MINES do
            ap.draw(r.ring, pt.at, c, ap.Vec3(0, double(ticks) * 3, 0), ap.Vec3(1.8, 1.8, 1.8) * grow)
            ap.draw(r.orb, pt.at, c.fade(0.35), ap.Vec3(0, double(ticks), 0), ap.Vec3(1.5, 0.05, 1.5) * grow)
            continue
        end
        var yaw = heading_of(pt.aim) if pt.kind == P_RAY else heading_of(player.body.position - pt.at)
        ap.push_3d()
        ap.translate_3d(pt.at)
        ap.rotate_3d(yaw, ap.Vec3(0, 1, 0))
        ap.draw(r.ring, ap.Vec3(0, 0, 0), c, ap.Vec3(90, 0, double(ticks) * 2), ap.Vec3(1.5, 1.5, 1.5) * grow)
        ap.draw(r.orb, ap.Vec3(0, 0, 0), c.fade(0.35), ap.Vec3(0, 0, double(ticks) * 3), ap.Vec3(1.2, 1.6, 0.05) * grow)
        ap.draw(r.orb, ap.Vec3(0, 0, 0.02), ap.WHITE.fade(0.4), ap.Vec3(0, 0, -double(ticks) * 3), ap.Vec3(0.5, 0.7, 0.05) * grow)
        ap.pop_3d()
        if pt.kind == P_RAY and not pt.fired do
            # Where the ray will go: a thin line, gold, then red.
            var locked = pt.fire_in < 0.5
            var lc = ap.Color(255, 70, 60) if locked else ap.Color(255, 210, 90)
            draw_streak(r, Streak(pt.at, pt.at + pt.aim * 12, lc.fade(0.5), 1, 1, 0.02))
        end
    end
    ap.lighting(true)
end

# --- The field, at the very end --------------------------------------------------------------------------
# Scarf wakes up in the real world: grass, sun, trees, birds.
var meadow_pose = puppet.Pose()
var meadow_speed = puppet.Pose()
function meadow_lights()
    for i in 0..<8 do
        ap.light_off(i)
    end
    ap.ambient(ap.Color(150, 158, 170))
    ap.sun(ap.Vec3(-0.4, -0.8, -0.3), ap.Color(255, 236, 200))
    ap.fog(sky(), 40, 140)
end
function meadow_camera()
    var t = double(ending_ticks)
    var p = puppet.smooth(math.clamp(t / double(ENDING_FIELD), 0.0, 1.0))
    var focus = ap.Vec3(0, 0.4 + 1.0 * p, 0)
    var yaw = 30 + 70 * p
    var pitch = 70 - 55 * p
    var dist = 2.4 + 5.6 * p
    camera = ap.orbit(focus, yaw, pitch, dist)
    if t > double(ENDING_FIELD) * 0.8 do
        # And at last, up: the sky.
        var q = puppet.smooth((t - double(ENDING_FIELD) * 0.8) / (double(ENDING_FIELD) * 0.2))
        var fov = camera.fov
        camera = ap.Camera3D(camera.position, focus + ap.Vec3(0, 6 * q, 0))
        camera.fov = fov
    end
end
function draw_meadow(puppet.Rig r)
    var t = double(ending_ticks)
    ap.lighting(true)
    var green = ap.Color(96, 150, 70)
    for gz in -6..<7 do
        for gx in -6..<7 do
            var c = ap.Vec3(double(gx) * 8, 0, double(gz) * 8)
            ap.draw(tile(), c, green.lerp(ap.Color(130, 170, 80), cell_hash(gx, gz, 1) * 0.4), ap.Vec3(0, 0, 0), ap.Vec3(4, 1, 4), grass())
        end
    end
    # Grass, flowers.
    for k in 0..<220 do
        var x = (cell_hash(k, 1, 2) - 0.5) * 30
        var z = (cell_hash(k, 2, 3) - 0.5) * 30
        if x * x + z * z < 1.5 do
            continue
        end
        var sway = math.sin(t * 0.03 + double(k)) * 8
        ap.draw(r.blade, ap.Vec3(x, 0.15, z), green.lerp(ap.Color(160, 200, 90), cell_hash(k, 3, 4)), ap.Vec3(sway, double(k) * 37, 0), ap.Vec3(0.05, 0.35, 0.05))
        if k % 7 == 0 do
            var bloom = [ap.Color(255, 255, 255), ap.Color(255, 220, 80), ap.Color(240, 140, 190), ap.Color(170, 150, 255)][k % 4]
            ap.draw(r.orb, ap.Vec3(x + 0.1, 0.34, z), bloom, ap.Vec3(0, 0, 0), ap.Vec3(0.08, 0.06, 0.08))
        end
    end
    # Trees round about, hills beyond, clouds over.
    for k in 0..<22 do
        var a = double(k) / 22 * 360 + cell_hash(k, 5, 6) * 10
        var d = 18 + cell_hash(k, 6, 7) * 14
        var at = forward_of(a) * d
        var tall = 3 + cell_hash(k, 7, 8) * 2
        ap.draw(r.thigh, at + ap.Vec3(0, tall / 2, 0), ap.Color(90, 66, 46), ap.Vec3(0, a, 0), ap.Vec3(0.5, tall, 0.5))
        ap.draw(r.orb, at + ap.Vec3(0, tall + 0.6, 0), ap.Color(70, 120, 56).lerp(ap.Color(110, 150, 70), cell_hash(k, 8, 9)), ap.Vec3(0, a, 0), ap.Vec3(3.2, 2.6, 3.2))
    end
    for k in 0..<8 do
        var at = forward_of(double(k) * 45 + 20) * 70
        ap.draw(r.orb, at + ap.Vec3(0, -4, 0), ap.Color(110, 150, 90), ap.Vec3(0, 0, 0), ap.Vec3(50, 16, 40))
    end
    ap.lighting(false)
    for k in 0..<7 do
        var at = ap.Vec3((cell_hash(k, 9, 1) - 0.5) * 120 + t * 0.01, 30 + cell_hash(k, 9, 2) * 10, (cell_hash(k, 9, 3) - 0.5) * 120)
        ap.draw(r.orb, at, ap.Color(255, 255, 255).fade(0.85), ap.Vec3(0, 0, 0), ap.Vec3(14, 3, 8))
    end
    # Birds: little dark Vs, wheeling.
    for k in 0..<6 do
        var a = t * 0.01 + double(k) * 1.1
        var at = ap.Vec3(math.sin(a) * (10 + double(k)), 9 + double(k % 3), math.cos(a) * (10 + double(k)))
        var flap = 25 * math.sin(t * 0.25 + double(k))
        var yaw = a * 180 / math.PI + 90
        ap.draw(r.blade, at, ap.Color(40, 40, 46), ap.Vec3(0, yaw, 70 + flap), ap.Vec3(0.05, 0.4, 0.05))
        ap.draw(r.blade, at, ap.Color(40, 40, 46), ap.Vec3(0, yaw, -70 - flap), ap.Vec3(0.05, 0.4, 0.05))
    end
    ap.lighting(true)
    # Scarf: lying in the grass, then up, looking round.
    var up = t > double(ENDING_FIELD) * 0.4
    var look = scarf_look()
    var target = puppet.make_pose(look, puppet.ACT_IDLE if up else puppet.ACT_DOWN, 0, 1.0, 0, 0, 0, t / 60, 1)
    var moved = puppet.follow(meadow_pose, meadow_speed, target, 6 if up else 30, 0.9)
    meadow_pose = moved[0]
    meadow_speed = moved[1]
    puppet.draw(r, look, meadow_pose, ap.Vec3(0, 0, 0), 200 + (math.sin(t * 0.01) * 30 if up else 0.0), 1)
end

roster.Look? merchant_look = null
function soul_merchant() returns roster.Look
    var have = merchant_look
    if have != null do
        return have as roster.Look
    end
    var l = roster.Look()
    l.skin = ap.Color(170, 160, 190)
    l.body = ap.Color(70, 40, 90)
    l.legs = ap.Color(40, 30, 50)
    l.trim = ap.Color(222, 178, 70)
    l.accent = ap.Color(200, 230, 255)
    l.metal = ap.Color(222, 178, 70)
    l.eyes = ap.Color(200, 230, 255)
    l.glowing_eyes = true
    l.head = roster.HEAD_TOPHAT
    l.weapon = roster.WEAPON_LANTERN
    l.glowing_weapon = true
    merchant_look = l
    return l
end
function draw_shop(puppet.Rig r)
    var wood = ap.Color(110, 76, 50)
    var cloth = ap.Color(110, 50, 140)
    var at = lv.shop
    # A stall: a counter, posts and an awning, goods on top.
    ap.draw(r.soft, at + ap.Vec3(0, 0.5, 0.9), wood, ap.Vec3(0, 0, 0), ap.Vec3(2.6, 1.0, 0.7))
    for side in [-1.0, 1.0] do
        ap.draw(r.rod, at + ap.Vec3(side * 1.25, 1.3, 0.9), wood.brightness(0.8), ap.Vec3(0, 0, 0), ap.Vec3(0.12, 2.6, 0.12))
    end
    ap.draw(r.wedge, at + ap.Vec3(0, 2.7, 0.7), cloth, ap.Vec3(90, 0, 0), ap.Vec3(2.9, 1.4, 0.3))
    for k in 0..<4 do
        var c = [ap.Color(130, 230, 60), ap.Color(255, 120, 40), ap.Color(140, 210, 255), ap.Color(255, 230, 80)][k]
        ap.lighting(false)
        ap.draw(r.orb, at + ap.Vec3(-0.9 + double(k) * 0.6, 1.12, 0.9), c, ap.Vec3(0, double(ticks), 0), ap.Vec3(0.2, 0.24, 0.2))
        ap.lighting(true)
    end
    var look = soul_merchant()
    var pose = puppet.make_pose(look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, double(ticks) / 60, 1)
    puppet.draw(r, look, pose, at + ap.Vec3(0, 0, 0.1), heading_of(player.body.position - at), 1)
end

roster.Look? master_look = null
function dojo_master() returns roster.Look
    var have = master_look
    if have != null do
        return have as roster.Look
    end
    var l = roster.Look()
    l.skin = ap.Color(150, 150, 170)
    l.body = ap.Color(220, 214, 200)
    l.legs = ap.Color(60, 56, 60)
    l.trim = ap.Color(40, 36, 40)
    l.accent = ap.Color(255, 190, 120)
    l.eyes = ap.Color(255, 220, 160)
    l.glowing_eyes = true
    l.head = roster.HEAD_TOPKNOT
    l.weapon = roster.WEAPON_BO
    l.metal = ap.Color(120, 90, 60)
    master_look = l
    return l
end
var master_pose = puppet.Pose()
function draw_dojo(puppet.Rig r)
    var mat = ap.Color(150, 120, 70)
    ap.draw(r.soft, lv.dojo + ap.Vec3(0, 0.03, 0), mat, ap.Vec3(0, 0, 0), ap.Vec3(5, 0.06, 5))
    ap.draw(r.soft, lv.dojo + ap.Vec3(0, 0.05, 0), mat.brightness(0.6), ap.Vec3(0, 0, 0), ap.Vec3(4.4, 0.06, 0.1))
    var look = dojo_master()
    var pose = puppet.make_pose(look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, double(ticks) / 60, 1)
    puppet.draw(r, look, pose, lv.dojo + ap.Vec3(0, 0, -1.6), heading_of(player.body.position - lv.dojo), 1)
end

function draw_gate(puppet.Rig r, Gate g)
    var s = g.grow
    if s <= 0 do
        return
    end
    var c = lv.glow.lerp(ap.WHITE, 0.35)
    ap.push_3d()
    ap.translate_3d(g.at + ap.Vec3(0, 1.5 * s, 0))
    ap.rotate_3d(heading_of(player.body.position - g.at), ap.Vec3(0, 1, 0))
    ap.lighting(false)
    ap.draw(r.ring, ap.Vec3(0, 0, 0), c, ap.Vec3(90, 0, double(ticks) * 0.5), ap.Vec3(2.4 * s, 2.4 * s, 2.4 * s))
    ap.draw(r.orb, ap.Vec3(0, 0, 0), c.fade(0.35), ap.Vec3(0, 0, double(ticks)), ap.Vec3(2.0 * s, 2.6 * s, 0.05))
    ap.draw(r.orb, ap.Vec3(0, 0, 0.02), ap.WHITE.fade(0.4), ap.Vec3(0, 0, -double(ticks)), ap.Vec3(0.9 * s, 1.3 * s, 0.05))
    ap.lighting(true)
    ap.pop_3d()
end

function draw_pickup(puppet.Rig r, Pickup pk)
    var y = 0.7 + 0.1 * math.sin(double(ticks) * 0.05)
    var look = roster.Look()
    look.metal = ap.Color(150, 150, 160)
    look.legs = ap.Color(80, 60, 50)
    ap.push_3d()
    ap.translate_3d(pk.at + ap.Vec3(0, y, 0))
    ap.rotate_3d(double(ticks) * 1.5, ap.Vec3(0, 1, 0))
    ap.rotate_3d(90, ap.Vec3(0, 0, 1))
    ap.scale_3d(ap.Vec3(1.6, 1.6, 1.6))
    var l = scarf_look()
    l.weapon = WEAPON_LOOKS[pk.weapon]
    puppet.draw_held(r, l)
    ap.pop_3d()
    ap.lighting(false)
    var glint = 0.5 + 0.5 * math.sin(double(ticks) * 0.12)
    ap.draw(r.spike, pk.at + ap.Vec3(0, y + 0.1, 0), ap.Color(255, 240, 200).fade(0.5 + 0.5 * glint), ap.Vec3(0, 0, 45), ap.Vec3(0.06, 0.4 * glint + 0.1, 0.06))
    ap.draw(r.ring, pk.at + ap.Vec3(0, 0.02, 0), ap.Color(255, 230, 190).fade(0.5 * pk.appear), ap.Vec3(0, double(ticks), 0), ap.Vec3(1.2, 1.2, 1.2))
    ap.lighting(true)
end

# --- Where things are on the screen (worked out while the 3D camera is still set) -----------------

class Marker
    ap.Vec2 at
    string words
    ap.Color color
    double share = -1                # a health bar's fill, or -1
    bool behind = false
end
Marker[] markers = []

function after_scene(double sw, double sh)
    markers = []
    var sx = VW / sw
    var sy = VH / sh
    for f in floaters do
        var p = ap.project(f.at)
        f.screen = ap.Vec2(p.x * sx, p.y * sy)
    end
    var combat_seen = focus_left > 0 and focus_kind == FOCUS_COMBAT
    var treasure_seen = focus_left > 0 and focus_kind == FOCUS_TREASURE
    # A kneeling boss: the prompt over it.
    var kn = kneeler()
    if kn != null and near_kneeler() and ap.visible(chest_of(kn as Actor)) do
        var p = ap.project(chest_of(kn as Actor) + ap.Vec3(0, 1.2, 0))
        markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "V, THEN 1: DEATH FOCUS", ap.Color(255, 90, 80), -1, false))
    end
    for e in foes do
        if not alive(e) do
            continue
        end
        var top = e.body.position + ap.Vec3(0, 2.1 * e.look.tall + e.look.hover, 0)
        if not ap.visible(top) do
            continue
        end
        var p = ap.project(top)
        var through = not lv.world.sees(cam_focus, chest_of(e))
        if combat_seen and e.aware or combat_seen and flat_distance(e.body.position, player.body.position) < 22 do
            markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), KIND_NAMES[e.kind], ap.Color(255, 90, 80), e.hp / e.hp_max, through))
        else if e.aware and not through do
            markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "", ap.Color(255, 90, 80), e.hp / e.hp_max if e.hp < e.hp_max else -1, false))
        end
    end
    if treasure_seen and lv.mode == LEVEL_FINAL and final_phase >= FP_QUIET do
        # Past the last boss, focus finds only one thing.
        if ap.visible(lv.death_at) do
            var p = ap.project(lv.death_at + ap.Vec3(0, 2, 0))
            markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "DEATH", ap.Color(230, 220, 230), -1, true))
        end
        treasure_seen = false
    end
    if treasure_seen do
        for c in lv.chests do
            if not c.opened and ap.visible(c.at) do
                var p = ap.project(c.at + ap.Vec3(0, 0.8, 0))
                markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "CHEST", ap.Color(255, 210, 110), -1, true))
                c.known = true
            end
        end
        for sp in lv.spots do
            if ap.visible(sp.at) do
                var p = ap.project(sp.at + ap.Vec3(0, 2.6, 0))
                markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), ["GAMBLER", "FORGE", "SHRINE"][math.clamp(sp.kind - ROOM_GAMBLER, 0, 2)], ap.Color(255, 200, 120), -1, true))
                sp.known = true
            end
        end
        for b in lv.books do
            if not b.taken and ap.visible(b.at) do
                var p = ap.project(b.at + ap.Vec3(0, 1.4, 0))
                markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "RED BOOK" if b.red else "CURSED BOOK", ap.Color(255, 80, 70) if b.red else ap.Color(210, 150, 255), -1, true))
                b.known = true
            end
        end
        if lv.has_shop and ap.visible(lv.shop) do
            var p = ap.project(lv.shop + ap.Vec3(0, 2.6, 0))
            markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "SHOP", ap.Color(255, 210, 130), -1, true))
            lv.shop_known = true
        end
        if lv.has_dojo and ap.visible(lv.dojo) do
            var p = ap.project(lv.dojo + ap.Vec3(0, 2.4, 0))
            markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "DOJO", ap.Color(255, 190, 120), -1, true))
            lv.dojo_known = true
        end
        for g in lv.gates do
            if ap.visible(g.at) do
                var p = ap.project(g.at + ap.Vec3(0, 3, 0))
                markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "INTERMISSION" if g.kind == GATE_INTERMISSION else "WAY ON", ap.Color(255, 90, 120) if g.kind == GATE_INTERMISSION else lv.glow, -1, true))
                g.known = true
            end
        end
        if lv.boss_room >= 0 and boss_phase == BP_NONE do
            var at = lv.rooms[lv.boss_room].center()
            if ap.visible(at) do
                var p = ap.project(at + ap.Vec3(0, 2, 0))
                markers.push(Marker(ap.Vec2(p.x * sx, p.y * sy), "BOSS ROOM", ap.Color(255, 90, 80), -1, true))
                lv.boss_known = true
            end
        end
    end
end

# --- The HUD --------------------------------------------------------------------------------------------

function label(string words, double x, double y, double size, ap.Color color)
    ap.text(words, x + size / 8, y + size / 8, size, ap.BLACK.fade(double(color.a) / 255 * 0.8))
    ap.text(words, x, y, size, color)
end
function label_centered(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x / 2, y, size, color)
end
function label_right(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x, y, size, color)
end
function bar(double x, double y, double w, double h, double share, ap.Color color, string name)
    ap.rect(x - 1, y - 1, w + 2, h + 2, ap.Color(0, 0, 0, 170))
    ap.rect(x, y, w * math.clamp(share, 0.0, 1.0), h, color)
    ap.rect(x, y, w * math.clamp(share, 0.0, 1.0), 1, ap.WHITE.fade(0.25))
    label(name, x - 20, y - 1, 8, color.lerp(ap.WHITE, 0.4))
end

function draw_hud()
    if front do
        draw_front()
        draw_achievement_banner()
        return
    end
    if ending_phase > 0 do
        draw_ending_hud()
        draw_overlay()
        draw_achievement_banner()
        return
    end
    if boss_phase == BP_ARRIVE do
        # The entrance has the screen to itself.
        draw_boss_moment()
        draw_overlay()
        return
    end
    if lv.mode == LEVEL_FINAL and final_phase == FP_ARMY do
        # The army's three shots: letterboxed, a flash of black on each cut.
        ap.rect(0, 0, VW, 40, ap.BLACK)
        ap.rect(0, VH - 40, VW, 40, ap.BLACK)
        var into = final_ticks % ARMY_SHOT
        if into < 6 do
            ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, int(255 * (1 - double(into) / 6))))
        end
        if final_ticks > ARMY_SHOT * 2 + 40 do
            var a = math.clamp(double(final_ticks - ARMY_SHOT * 2 - 40) / 30, 0.0, 1.0)
            label_centered("EVERY ONE OF THEM.", 320, 332, 16, ap.Color(255, 90, 80).fade(a))
        end
        draw_overlay()
        return
    end
    for mk in markers do
        if mk.words != "" do
            label_centered(mk.words, mk.at.x, mk.at.y - 12, 8, mk.color.fade(0.9 if mk.behind else 1.0))
        end
        if mk.share >= 0 do
            ap.rect(mk.at.x - 16, mk.at.y - 2, 32, 4, ap.Color(0, 0, 0, 170))
            ap.rect(mk.at.x - 16, mk.at.y - 2, 32 * mk.share, 4, mk.color)
        end
        if mk.behind do
            ap.rect_lines(mk.at.x - 4, mk.at.y + 4, 8, 8, 1, mk.color)
        end
    end
    for f in floaters do
        var a = math.min(f.life * 2, 1.0)
        label_centered(f.words, f.screen.x, f.screen.y, 8 if f.words.length > 3 else 12, f.color.fade(a))
    end
    # Health, stamina, mana; souls.
    bar(32, 312, 150, 8, player.hp / player.hp_max, ap.Color(220, 60, 70), "HP")
    bar(32, 326, 120, 6, stamina / data.max_stamina, ap.Color(110, 220, 120), "ST")
    bar(32, 338, 120, 6, mana / data.max_mana, ap.Color(110, 160, 255), "MN")
    label_right("{data.souls}", 620, 14, 16, ap.Color(200, 230, 255))
    label_right("SOULS", 620, 32, 8, ap.Color(150, 170, 200))
    draw_minimap()
    if lv.index >= 0 do
        label("{lv.index + 1}. {lv.name}", 14, 14, 8, lv.glow.lerp(ap.WHITE, 0.4))
    end
    if combat_lock do
        label("IN COMBAT", 14, 26, 8, ap.Color(255, 100, 90).fade(0.6 + 0.4 * math.sin(double(ticks) * 0.15)))
    else if alerted do
        label("AN ENEMY HAS SEEN YOU", 14, 26, 8, ap.Color(255, 170, 110))
    end
    if focus_left > 0 do
        label("{FOCUS_NAMES[focus_kind]}  {focus_left // 60 + 1}", 14, 38, 8, ap.Color(255, 220, 140))
    end
    draw_moves()
    draw_boss_bars()
    if pact != "" do
        label("PACT: {PACT_NAMES[pact_index(pact)]}", 14, 50, 8, ap.Color(255, 110, 100))
    end
    if data.difficulty == DIFF_HELL do
        label_right("HELL", 620, 42, 8, ap.Color(255, 80, 40).fade(0.7 + 0.3 * math.sin(double(ticks) * 0.1)))
    end
    if warcry_time > 0 do
        label("WAR CRY {int(warcry_time) + 1}", 14, 62, 8, ap.Color(255, 110, 80))
    end
    # A level's name, as you arrive.
    if title_ticks < 260 do
        var a = math.min(double(title_ticks) / 40, 1.0) * math.min(double(260 - title_ticks) / 60, 1.0)
        if lv.index >= 0 do
            label_centered("{cast[lv.index].name}'S", 320, 120, 8, ap.Color(220, 210, 230).fade(a))
            label_centered(lv.name, 320, 132, 24, lv.glow.lerp(ap.WHITE, 0.4).fade(a))
            label_centered("LEVEL {lv.index + 1} OF {cast.length}", 320, 162, 8, ap.Color(180, 170, 190).fade(a))
        else do
            label_centered("PURGATORY", 320, 132, 24, ap.Color(220, 210, 230).fade(a))
            label_centered("EXPLORE TO FIND A WEAPON. WASD MOVES; MOUSE OR ARROWS TURN THE CAMERA.", 320, 162, 8, ap.Color(180, 170, 190).fade(a))
        end
    end
    if hint_ticks > 0 do
        for i, line in wrap_words(hint, 66) do
            label_centered(line, 320, 86 + double(i) * 12, 8, hint_color.fade(math.min(double(hint_ticks) / 30, 1.0)))
        end
    end
    if super_banner > 0 and bosses.length > 0 do
        var m = kit_of(bosses[0]).maximum
        var a = math.min(double(super_banner) / 30, 1.0) * math.min(double(150 - super_banner) / 10, 1.0)
        ap.rect(0, 130, VW, 60, ap.Color(0, 0, 0, int(150 * a)))
        label_centered(m.name, 320, 140, 32, bosses[0].look.accent.lerp(ap.WHITE, 0.3).fade(a))
        label_centered("{kit_of(bosses[0]).name}'S SUPER", 320, 176, 8, ap.Color(230, 220, 230).fade(a))
    end
    draw_boss_moment()
    draw_death_prompt()
    draw_overlay()
    draw_achievement_banner()
end

function draw_boss_bars()
    if final_phase == FP_GAUNTLET or final_phase == FP_LIGHTS do
        var left = 0
        for b in bosses do
            if alive(b) do
                left += 1
            end
        end
        label_centered("EVERY BOSS THERE IS", 320, 12, 16, ap.Color(255, 220, 220))
        label_centered("{left} LEFT", 320, 32, 8, ap.Color(255, 120, 110))
        return
    end
    var row = 0
    for b in bosses do
        if not alive(b) or b.fade <= 0.5 or b.role == ROLE_GAUNTLET do
            continue
        end
        var kit = kit_of(b)
        var y = 12 + double(row) * 34
        var big = row == 0
        var burning = data.difficulty == DIFF_HELL or b.true_form or b.role == ROLE_SATAN
        var name = kit.name + ("  (REVENGE)" if b.role == ROLE_REVENGE else "") + ("  (RISEN)" if b.true_form else "")
        var col = ap.Color(255, 80, 40) if burning else b.look.accent.lerp(ap.WHITE, 0.4)
        if burning do
            draw_flames(320 - ap.measure(name, 16.0 if big else 8.0).x / 2, y + (14.0 if big else 7.0), ap.measure(name, 16.0 if big else 8.0).x, 10, double(row))
        end
        label_centered(name, 320, y, 16.0 if big else 8.0, col)
        var bw = 300.0 if big else 200.0
        var by = y + (21.0 if big else 11.0)
        ap.rect(320 - bw / 2 - 1, by - 1, bw + 2, 8.0 if big else 6.0, ap.Color(0, 0, 0, 180))
        ap.rect(320 - bw / 2, by, bw * math.max(b.hp, 0.0) / b.hp_max, 6.0 if big else 4.0, ap.Color(255, 60, 30) if burning else b.look.accent)
        if b.state == S_KNEEL do
            label_centered("KNEELING", 320, by + 10, 8, ap.Color(255, 220, 200))
        end
        row += 1
        if row > 2 do
            break
        end
    end
end

# Red fire, licking up from a line on the screen (HELL's achievements and bosses).
function draw_flames(double x, double y, double w, double h, double seed)
    var n = int(w / 5) + 2
    for i in 0..<n do
        var fx = x + double(i) * 5 + 2 * math.sin(double(ticks) * 0.13 + double(i) * 1.7 + seed)
        var phase = (double(ticks) * 0.045 + cell_hash(i, int(seed), 3)) % 1.0
        var rise = phase * h * 1.6
        var size = (1 - phase) * 4 + 1
        var col = ap.Color(255, int(200 * (1 - phase)), 30, int(200 * (1 - phase)))
        ap.rect(fx - size / 2, y - rise - size / 2, size, size, col)
    end
    ap.rect(x - 2, y - 1, w + 4, 2, ap.Color(255, 60, 20, int(120 + 80 * math.sin(double(ticks) * 0.2 + seed))))
end

function draw_achievement_banner()
    if ach_banner <= 0 do
        return
    end
    ach_banner -= 1
    var a = math.min(double(ach_banner) / 30, 1.0) * math.min(double(260 - ach_banner) / 15, 1.0)
    var y = 266 - 12 * (1 - math.min(double(260 - ach_banner) / 15, 1.0))
    ap.rect(200, y, 240, 30, ap.Color(10, 6, 12, int(220 * a)))
    ap.rect_lines(200, y, 240, 30, 1, (ap.Color(255, 80, 40) if ach_hell else ap.Color(255, 220, 140)).fade(a))
    if ach_hell do
        draw_flames(206, y + 28, 228, 10, 7)
    end
    label_centered("ACHIEVEMENT" + (" (HELL)" if ach_hell else ""), 320, y + 5, 8, ap.Color(200, 190, 210).fade(a))
    label_centered(ach_text, 320, y + 16, 8, (ap.Color(255, 120, 60) if ach_hell else ap.Color(255, 230, 160)).fade(a))
end

# When Death Focus is what is called for now (and not as a boss arrives): the moment, big.
function draw_death_prompt()
    if qte_on or overlay != O_NONE do
        return
    end
    var ctx = focus_context()
    if ctx != FOCUS_DEATH or boss_phase == BP_WAIT do
        return
    end
    var pulse = 0.6 + 0.4 * math.sin(double(ticks) * 0.25)
    ap.rect_lines(4, 4, VW - 8, VH - 8, 3, ap.Color(255, 50, 40, int(255 * pulse)))
    var words = "DEATH FOCUS: V, THEN 1"
    if final_phase == FP_SATAN_DOWN do
        var left = math.max(SATAN_WINDOW - final_ticks, 0)
        words = "DEATH FOCUS: V, THEN 1   ({left // 60 + 1})"
    else if revenge_state == 2 do
        var left = math.max(REVENGE_WINDOW[data.difficulty] - revenge_ticks, 0)
        words = "SOMETHING IS COMING BACK: V, THEN 1   ({left // 60 + 1})"
    end
    ap.rect(160, 250, 320, 24, ap.Color(30, 0, 4, 200))
    label_centered(words, 320, 258, 8, ap.Color(255, 230, 200).fade(pulse))
end

# The end: black, the field (no HUD), black, then the win screen.
function draw_ending_hud()
    var a = 0.0
    if ending_phase == 1 do
        a = math.min(double(ending_ticks) / double(ENDING_BLACK - 60), 1.0)
    else if ending_phase == 2 do
        a = 1 - math.min(double(ending_ticks) / 150, 1.0)
        if ending_ticks > 200 and ending_ticks < 520 do
            var w = math.min(double(ending_ticks - 200) / 60, 1.0) * math.min(double(520 - ending_ticks) / 60, 1.0)
            label_centered("you wake up.", 320, 300, 8, ap.Color(255, 255, 255).fade(w * 0.8))
        end
    else do
        a = math.min(double(ending_ticks) / double(ENDING_OUT - 40), 1.0) if ending_phase == 3 else 1.0
    end
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, int(255 * a)))
end

# --- The minimap -----------------------------------------------------------------------------------
# The level's plan, drawn once into a small texture when it is made, north up; on top of it where
# Scarf is and faces, what has seen you, and what is worth walking to.
ap.Texture? map_tex = null
function paint_map(int x, int y) returns ap.Color
    if x < 0 or y < 0 or x >= lv.w or y >= lv.h or not lv.explored[y * lv.w + x] do
        return ap.Color(0, 0, 0, 0)
    end
    var c = cell_at(lv, x, y)
    if c == CELL_FLOOR do
        return ap.Color(170, 160, 180, 230)
    else if c == CELL_WALL do
        return ap.Color(50, 44, 60, 230)
    end
    return ap.Color(0, 0, 0, 0)
end
function make_minimap()
    map_tex = ap.make_texture(lv.w, lv.h, paint_map)
end

const double MAP_X = 528
const double MAP_Y = 48
const double MAP_SIZE = 100
function map_point(ap.Vec3 at) returns ap.Vec2
    return ap.Vec2(MAP_X + at.x / TILE * MAP_SIZE / double(math.min(lv.w, MAP)), MAP_Y + at.z / TILE * MAP_SIZE / double(lv.h))
end
function map_dot(ap.Vec3 at, double size, ap.Color color)
    var p = map_point(at)
    ap.rect(p.x - size / 2, p.y - size / 2, size, size, color)
end

function draw_minimap()
    if lv.index < 0 or light_up < 0.5 or void_dark > 0.3 or flood > 0 do
        return
    end
    var have = map_tex
    if have == null do
        return
    end
    ap.rect(MAP_X - 3, MAP_Y - 3, MAP_SIZE + 6, MAP_SIZE + 6, ap.Color(6, 4, 10, 190))
    ap.rect_lines(MAP_X - 3, MAP_Y - 3, MAP_SIZE + 6, MAP_SIZE + 6, 1, lv.glow.fade(0.6))
    var mw = math.min(lv.w, MAP)
    ap.sprite_part(have as ap.Texture, ap.Rect(0, 0, double(mw), double(lv.h)), ap.Rect(MAP_X, MAP_Y, MAP_SIZE, MAP_SIZE))
    # The boss's hall, outlined, once you have seen it. Everything else only once found.
    if lv.boss_room >= 0 and lv.boss_known do
        var r = lv.rooms[lv.boss_room]
        var a = map_point(ap.Vec3(double(r.x) * TILE, 0, double(r.y) * TILE))
        var b = map_point(ap.Vec3(double(r.x + r.w) * TILE, 0, double(r.y + r.h) * TILE))
        ap.rect_lines(a.x, a.y, b.x - a.x, b.y - a.y, 1, ap.Color(255, 80, 70).fade(0.6 + 0.4 * math.sin(double(ticks) * 0.08)))
    end
    for c in lv.chests do
        if not c.opened and c.known do
            map_dot(c.at, 3, ap.Color(255, 210, 110))
        end
    end
    for b in lv.books do
        if not b.taken and b.known do
            map_dot(b.at, 3, ap.Color(255, 80, 70) if b.red else ap.Color(210, 150, 255))
        end
    end
    for sp in lv.spots do
        if sp.known do
            map_dot(sp.at, 4, ap.Color(255, 200, 120))
        end
    end
    if lv.has_dojo and lv.dojo_known do
        map_dot(lv.dojo, 4, ap.Color(255, 170, 90))
    end
    if lv.has_shop and lv.shop_known do
        map_dot(lv.shop, 4, ap.Color(255, 230, 120))
    end
    for g in lv.gates do
        if g.known do
            map_dot(g.at, 4, ap.Color(255, 90, 120) if g.kind == GATE_INTERMISSION else lv.glow.lerp(ap.WHITE, 0.4))
        end
    end
    for f in foes do
        if alive(f) and f.aware do
            map_dot(f.body.position, 2, ap.Color(255, 70, 60))
        end
    end
    for b in bosses do
        if alive(b) and b.fade > 0.5 and boss_alpha(b) > 0.5 do
            map_dot(b.body.position, 4, ap.Color(255, 40, 40))
        end
    end
    # Scarf: an arrow the way they face.
    var p = map_point(player.body.position)
    var f = forward_of(player.heading)
    var side = ap.Vec2(f.z, -f.x)
    ap.triangle(ap.Vec2(p.x + f.x * 4, p.y + f.z * 4), ap.Vec2(p.x - f.x * 2.5 + side.x * 2.5, p.y - f.z * 2.5 + side.y * 2.5),
        ap.Vec2(p.x - f.x * 2.5 - side.x * 2.5, p.y - f.z * 2.5 - side.y * 2.5), ap.WHITE)
    label("MAP", MAP_X, MAP_Y + MAP_SIZE + 4, 8, ap.Color(140, 130, 150))
end

function move_note(Move m, int cool_slot) returns string
    if m.name == "" do
        return "-"
    end
    var cost = ""
    if m.st > 0 do
        cost = "{int(m.st)} ST"
    else if m.mn > 0 do
        cost = "{int(m.mn)} MN"
    end
    return cost
end

function draw_moves()
    var x0 = 198.0
    var y0 = 312.0
    var w = 70.0
    var gap = 4.0
    # The four menus, as tabs: the open one lit, with what it holds.
    var names = ["STANCE", "ART", "ARMAMENT", "REFLEX"]
    var tab_colors = [ap.Color(120, 230, 130), ap.Color(130, 170, 255), ap.Color(255, 210, 120), ap.Color(255, 220, 140)]
    for k in 1..<5 do
        var x = x0 + double(k - 1) * (w + gap)
        var on = menu == k
        var c = tab_colors[k - 1]
        ap.rect(x, y0 - 16, w, 14, c.fade(0.35) if on else ap.Color(10, 8, 14, 170))
        ap.rect_lines(x, y0 - 16, w, 14, 1, c.fade(0.9 if on else 0.35))
        label(MENU_KEYS[k], x + 3, y0 - 13, 8, ap.Color(255, 255, 255, 220 if on else 140))
        label_centered(names[k - 1], x + w / 2 + 4, y0 - 13, 8, ap.WHITE if on else ap.Color(170, 160, 180))
    end
    if menu != MENU_ROOT do
        var what = ""
        if menu == MENU_STANCE do
            what = STANCE_NAMES[data.stance]
        else if menu == MENU_ARMAMENT do
            what = WEAPON_NAMES[data.weapon] if data.weapon >= 0 else "FISTS"
        end
        if what != "" do
            label_centered(what, x0 + 2 * (w + gap) - gap / 2, y0 - 28, 8, ap.Color(255, 220, 190))
        end
    end
    var moves = menu_moves(menu) if menu != MENU_ROOT else [Move(""), Move(""), Move(""), Move("")]
    for slot in 0..<4 do
        var x = x0 + double(slot) * (w + gap)
        var title = ""
        var sub = ""
        var color = ap.Color(220, 214, 230)
        var cool = 0.0
        if menu == MENU_ROOT do
            color = ap.Color(110, 100, 120)
        else do
            var m = moves[slot]
            title = m.name.upper() if m.name != "" else "(EMPTY)"
            if menu == MENU_REFLEX do
                var fk = focus_context() if slot == 0 else (FOCUS_STAMINA if slot == 1 else FOCUS_MANA)
                if data.difficulty == DIFF_EASY and slot == 1 do
                    fk = FOCUS_RECOVER
                end
                if slot == 3 do
                    fk = FOCUS_EXTRACT
                end
                sub = "{FOCUS_PRICE[fk]}% SOULS" if FOCUS_PRICE[fk] > 0 and not (fk == FOCUS_DEATH and final_phase == FP_SATAN_DOWN) else "FREE"
                if fk == FOCUS_EXTRACT do
                    sub = "COSTS HP"
                end
                if slot == 0 and focus_cool > 0 and fk != FOCUS_DEATH do
                    sub = "{focus_cool // 60 + 1}S"
                end
                if data.difficulty == DIFF_EASY and slot == 2 do
                    sub = "USED" if bandage_used else "{BANDAGE_SOULS}% SOULS"
                end
                color = ap.Color(255, 220, 140)
            else do
                sub = move_note(m, menu * 4 + slot)
                var cs = menu * 4 + slot
                if m.cooldown > 0 do
                    cool = double(cools[cs]) / double(m.cooldown)
                end
                var short = (m.st > stamina) or (m.mn > mana)
                color = m.color.lerp(ap.WHITE, 0.5) if not short else ap.Color(150, 140, 150)
            end
        end
        if menu == MENU_ROOT do
            continue
        end
        ap.rect(x, y0, w, 42, ap.Color(10, 8, 14, 200))
        ap.rect_lines(x, y0, w, 42, 1, color.fade(0.6))
        if cool > 0 do
            ap.rect(x, y0 + 42 * (1 - cool), w, 42 * cool, ap.Color(0, 0, 0, 150))
        end
        label("{slot + 1}", x + 3, y0 + 3, 8, ap.Color(255, 255, 255, 160))
        # The name (one or two lines), then what it costs on a line of its own.
        var lines = wrap_words(title, 10)
        if lines.length > 1 do
            label_centered(lines[0], x + w / 2 + 3, y0 + 4, 8, color)
            label_centered(lines[1], x + w / 2 + 3, y0 + 15, 8, color)
        else do
            label_centered(title, x + w / 2 + 3, y0 + 9, 8, color)
        end
        var cost_color = ap.Color(120, 230, 130) if sub.contains(" ST") else (ap.Color(130, 170, 255) if sub.contains(" MN") else (ap.Color(255, 120, 110) if sub == "COSTS HP" else ap.Color(255, 220, 140)))
        label_centered(sub, x + w / 2, y0 + 29, 8, cost_color.fade(0.85))
    end
    if menu == MENU_ROOT do
        ap.rect(x0, y0, 4 * w + 3 * gap, 42, ap.Color(10, 8, 14, 170))
        ap.rect_lines(x0, y0, 4 * w + 3 * gap, 42, 1, ap.Color(110, 100, 120).fade(0.5))
        label_centered("Z, X, C OR V: PICK A MENU.  1-4: USE ITS MOVES", x0 + 2 * (w + gap) - gap / 2, y0 + 17, 8, ap.Color(170, 160, 180))
    end
    # The basic attack.
    var rx = x0 + 4 * (w + gap)
    ap.rect(rx, y0, 48, 42, ap.Color(10, 8, 14, 200))
    label("R", rx + 3, y0 + 3, 8, ap.Color(255, 255, 255, 160))
    label_centered(weapon_basic(data.weapon).name.upper(), rx + 24, y0 + 9, 8, ap.Color(230, 220, 210))
    if data.weapon == 0 do
        if reload_ticks > 0 do
            label_centered("RELOAD", rx + 22, y0 + 26, 8, ap.Color(200, 190, 200))
        else do
            for i in 0..<6 do
                ap.rect(rx + 6 + double(i) * 6, y0 + 27, 4, 6, ap.Color(255, 210, 120) if i < ammo else ap.Color(60, 50, 50))
            end
        end
    end
    label("F BLOCK   Q DASH   E INVENTORY", 32, 282, 8, ap.Color(150, 140, 160))
end

function pact_index_infuse(string id) returns int
    for k, p in INFUSE_IDS do
        if p == id do
            return k
        end
    end
    return 0
end

function art_count() returns int
    return data.arts.length
end

const string[] QTE_LABELS = ["R", "F", "Q", "1", "2", "3", "4"]
function draw_boss_moment()
    if qte_on do
        ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 120))
        var window = double(qte_window())
        var left = 1 - double(qte_ticks) / window
        label_centered("DEATH FOCUS", 320, 100, 16, ap.Color(255, 230, 200))
        ap.circle_lines(320, 180, 20 + 40 * left, 2, ap.Color(255, 120, 100))
        label_centered(QTE_LABELS[qte_keys[qte_step]], 320, 168, 24, ap.WHITE)
        var x0 = 320 - double(qte_keys.length) * 8
        for i in 0..<qte_keys.length do
            ap.rect(x0 + double(i) * 16 + 3, 230, 10, 4, ap.Color(255, 230, 200) if i < qte_step else ap.Color(80, 70, 80))
        end
    end
    if boss_phase == BP_ARRIVE and bosses.length > 0 do
        var kit = kit_of(bosses[0])
        var t = double(boss_ticks)
        var out = math.clamp((double(ARRIVE_TICKS) - t) / 30, 0.0, 1.0)
        # Letterbox bars slide in.
        var bars = 44 * math.min(t / 25, 1.0) * out
        ap.rect(0, 0, VW, bars, ap.BLACK)
        ap.rect(0, VH - bars, VW, bars, ap.BLACK)
        # The name slams in, big, then the title, then the quote word by word.
        var land = math.clamp((t - 120) / 10, 0.0, 1.0)
        if t > 120 do
            var grow = 1 + 0.6 * (1 - land)
            var a = land * out
            ap.push()
            ap.translate(320, 236)
            ap.scale(grow, grow)
            label_centered(kit.name, 0, -24, 48, kit.look.accent.lerp(ap.WHITE, 0.25).fade(a))
            ap.pop()
            label_centered(kit.title + "   -   " + level_title(kit), 320, 268, 8, ap.Color(230, 220, 230).fade(math.clamp((t - 140) / 20, 0.0, 1.0) * out))
        end
        var quote = boss_quote(kit)
        if t > 160 and quote != "" do
            var shown = math.min(int((t - 160) * 0.9), quote.length)
            label_centered("\"" + quote[0..<shown] + ("\"" if shown == quote.length else ""), 320, 290, 8, ap.Color(255, 240, 220).fade(out))
        end
    end
    if boss_phase == BP_WAIT do
        var pulse = 0.3 + 0.3 * math.sin(double(ticks) * 0.08)
        ap.rect_lines(4, 4, VW - 8, VH - 8, 2, ap.Color(255, 60, 60, int(255 * pulse)))
    end
end

# --- Overlays ---------------------------------------------------------------------------------------

function panel(double x, double y, double w, double h)
    ap.rect(x, y, w, h, ap.Color(8, 6, 12, 235))
    ap.rect_lines(x, y, w, h, 1, ap.Color(160, 40, 50))
    ap.rect(x, y, w, 2, ap.Color(160, 40, 50))
end

function draw_rows(string[] rows, int chosen, double x, double y, double w)
    for i, row in rows do
        if row == "" do
            continue
        end
        var r = row_rect(i, x, y, w)
        if i == chosen do
            ap.rect(r.x, r.y, r.w, r.h, ap.Color(160, 40, 50, 120))
            ap.rect(r.x, r.y, 2, r.h, ap.Color(255, 120, 110))
        end
        label(row, r.x + 8, r.y + 5, 8, ap.WHITE if i == chosen else ap.Color(190, 180, 200))
    end
end

function draw_overlay()
    if overlay == O_NONE do
        return
    end
    if overlay == O_UPGRADE do
        ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 160))
        label_centered("BOSS DEFEATED: CHOOSE AN UPGRADE" if upgrade_picks <= 1 else "REVENGE BEATEN: CHOOSE {upgrade_picks} UPGRADES", 320, 84, 16, ap.Color(255, 230, 160))
        label_centered("IT IS PERMANENT, FOR WHAT YOU HAVE EQUIPPED NOW. 1, 2, 3 OR CLICK.", 320, 104, 8, ap.Color(200, 190, 210))
        for k, offer in offers do
            var x = offer_x(k)
            var on = k == overlay_row
            var pop = 6.0 if on else 0.0
            ap.rect(x, 120 - pop, 130, 130, ap.Color(30, 14, 20, 240) if on else ap.Color(14, 10, 16, 230))
            ap.rect_lines(x, 120 - pop, 130, 130, 2 if on else 1, ap.Color(255, 140, 120) if on else ap.Color(110, 80, 90))
            label("{k + 1}", x + 6, 126 - pop, 8, ap.Color(255, 255, 255, 160))
            var parts = offer.split(":")
            var who = owner_name("{parts[0]}:{parts[1]}")
            var lines = wrap_words(who, 16)
            for i, line in lines do
                label_centered(line, x + 65, 146 - pop + double(i) * 12, 8, ap.WHITE)
            end
            label_centered(offer_words(offer), x + 65, 196 - pop, 16 if offer_words(offer).length < 10 else 8, ap.Color(255, 220, 140))
            var have = upgrade_count(offer)
            if have > 0 do
                label_centered("(YOU HAVE {have})", x + 65, 228 - pop, 8, ap.Color(160, 150, 170))
            end
        end
        return
    end
    if overlay == O_PAUSE do
        ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 140))
        panel(180, 120, 280, 120)
        label_centered("PAUSED" if not combat_lock else "IN COMBAT: THE GAME KEEPS RUNNING WHILE THIS MENU IS OPEN", 320, 132, 8, ap.Color(255, 220, 200) if not combat_lock else ap.Color(255, 110, 100))
        draw_rows(pause_rows(), overlay_row, 200, 170, 240)
    else if overlay == O_INVENTORY do
        draw_inventory()
    else if overlay == O_ADMIN do
        draw_admin()
    else if overlay == O_TUTORIAL do
        draw_tutorial()
    else if overlay == O_READ do
        draw_reading()
    else if overlay == O_DOJO do
        draw_dojo_menu()
    else if overlay == O_SHOP do
        draw_shop_menu()
    else if overlay == O_DEATH do
        var a = math.min(double(overlay_ticks) / 60, 1.0)
        ap.rect(0, 0, VW, VH, ap.Color(30, 0, 4, int(200 * a)))
        label_centered("YOU DIED", 320, 140, 24, ap.Color(220, 60, 60).fade(a))
        if data.difficulty == DIFF_HELL do
            draw_flames(250, 168, 140, 14, 3)
            label_centered("HELL HAS NO SECOND CHANCES. THE RUN IS OVER.", 320, 186, 8, ap.Color(255, 120, 90).fade(a))
            label_centered("YOUR ACHIEVEMENTS ARE KEPT.", 320, 200, 8, ap.Color(200, 180, 190).fade(a))
            if overlay_ticks > 90 do
                draw_rows(["BACK TO THE PURGATORY MENU"], overlay_row, 230, 236, 180)
            end
        else do
            label_centered("YOU LOST 25% OF YOUR SOULS.", 320, 176, 8, ap.Color(200, 180, 190).fade(a))
            label_centered("RETRY STARTS YOU AT THE LEVEL START (OR OUTSIDE THE BOSS ROOM).", 320, 190, 8, ap.Color(200, 180, 190).fade(a))
            if overlay_ticks > 70 do
                draw_rows(["RETRY", "QUIT TO THE PURGATORY MENU"], overlay_row, 230, 220, 180)
            end
        end
    else if overlay == O_REDBOOK do
        draw_redbook_menu()
    else if overlay == O_GAMBLER do
        draw_spot_menu("THE GAMBLER", "WAGERS, THE BONE DICE AND A MYSTERY BOX. THE HOUSE ALWAYS WINS, MOSTLY.", gamble_rows_now(), 150, 140)
    else if overlay == O_FORGE do
        draw_spot_menu("THE SMITH", "INFUSE {weapon_name(data.weapon)} WITH AN ELEMENT. ONE AT A TIME; A NEW ONE REPLACES THE OLD.", forge_rows(), 150, 140)
        if overlay_row < INFUSE_IDS.length do
            label(INFUSE_NOTES[overlay_row], 150, 262, 8, INFUSE_COLORS[overlay_row])
        end
    else if overlay == O_SHRINE do
        var have = current_spot()
        string[] rows = []
        if have != null do
            for id in (have as Spot).offer do
                rows.push("{PACT_NAMES[pact_index(id)]}  -  {pact_price()} SOULS")
            end
        end
        rows.push("LEAVE")
        draw_spot_menu("A SHRINE OF PACTS", "SIGN ONE, FOR THIS LEVEL ONLY. EVERY BOON HAS ITS PRICE.", rows, 150, 150)
        if have != null and overlay_row < (have as Spot).offer.length do
            var lines = wrap_words(PACT_NOTES[pact_index((have as Spot).offer[overlay_row])], 60)
            for i, line in lines do
                label(line, 150, 252 + double(i) * 11, 8, ap.Color(255, 140, 120))
            end
        end
    else if overlay == O_WIN do
        draw_win()
    end
end

function gamble_rows_now() returns string[]
    var have = current_spot()
    if have == null do
        return ["LEAVE"]
    end
    return gamble_rows(have as Spot)
end

function draw_spot_menu(string title, string note, string[] rows, double x, double y)
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 150))
    panel(120, 80, 400, 220)
    label_centered(title, 320, 92, 8, ap.Color(255, 210, 130))
    var lines = wrap_words(note, 64)
    for i, line in lines do
        label_centered(line, 320, 106 + double(i) * 11, 8, ap.Color(200, 190, 210))
    end
    draw_rows(rows, overlay_row, x, y, 340)
    if gamble_said != "" do
        label_centered(gamble_said, 320, 238, 8, ap.Color(255, 230, 160))
    end
    label_right("YOUR SOULS: {data.souls}", 500, 284, 8, ap.Color(200, 230, 255))
    label("ESC: LEAVE", 140, 284, 8, ap.Color(130, 120, 140))
end

function draw_redbook_menu()
    if read_book < 0 or read_book >= lv.books.length do
        return
    end
    var b = lv.books[read_book]
    ap.rect(0, 0, VW, VH, ap.Color(30, 0, 4, 190))
    panel(110, 90, 420, 190)
    draw_flames(150, 108, 340, 12, 5)
    var k = b.art - RED_ART
    label_centered("THE RED BOOK OF {cast[k].name}", 320, 116, 16, ap.Color(255, 90, 70))
    label_centered("ITS ART: {art_name(b.art)}", 320, 144, 8, ap.Color(255, 220, 200))
    var m = art_move(b.art)
    label_centered("{m.note}. {int(m.a.damage)} DAMAGE, {int(m.mn)} MANA.", 320, 160, 8, ap.Color(200, 190, 210))
    label_centered("NO COPYING OUT: THIS ONE IS BOUGHT, WITH SOULS.", 320, 176, 8, ap.Color(170, 160, 180))
    draw_rows(["BUY FOR {b.price} SOULS", "LEAVE IT FOR NOW"], overlay_row, 230, 230, 180)
    label_right("YOUR SOULS: {data.souls}", 510, 268, 8, ap.Color(200, 230, 255))
end

function draw_win()
    var a = math.min(double(overlay_ticks) / 90, 1.0)
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 255))
    if data.difficulty == DIFF_HELL do
        label_centered("YOU WOKE UP.", 320, 110, 32, ap.Color(255, 250, 240).fade(a))
        label_centered("THE PURGATORY IS BEHIND YOU.", 320, 152, 8, ap.Color(200, 200, 210).fade(a))
    else do
        label_centered("YOU WIN!", 320, 110, 32, ap.Color(255, 250, 240).fade(a))
    end
    label_centered("DIFFICULTY: {DIFF_NAMES[data.difficulty]}    DEATHS: {deaths}    SOULS: {data.souls}", 320, 180, 8, ap.Color(180, 180, 190).fade(a))
    label_centered("ACHIEVEMENTS: {data.achievements.length} OF {ACH_IDS.length}" + ("    IN HELL: {data.achievements_hell.length}" if data.achievements_hell.length > 0 else ""), 320, 194, 8, ap.Color(180, 180, 190).fade(a))
    if data.difficulty == DIFF_HELL do
        draw_flames(230, 230, 180, 14, 9)
        label_centered("YOU WALKED OUT OF HELL.", 320, 236, 8, ap.Color(255, 110, 70).fade(a))
    end
    if overlay_ticks > 120 do
        label_centered("ENTER: BACK TO THE PURGATORY MENU", 320, 300, 8, ap.Color(150, 140, 160).fade(0.5 + 0.5 * math.sin(double(ticks) * 0.08)))
    end
end

# Where a text breaks into lines of at most `width` letters, at spaces (each line keeps its
# space, so the letters still count straight through).
function line_starts(string text, int width) returns int[]
    int[] starts = [0]
    var start = 0
    while text.length - start > width do
        var cut = start + width
        while cut > start and text[(cut - 1)..<cut] != " " do
            cut -= 1
        end
        if cut == start do
            cut = start + width
        end
        starts.push(cut)
        start = cut
    end
    return starts
end

function draw_reading()
    ap.rect(0, 0, VW, VH, ap.Color(20, 0, 30, 190))
    panel(70, 70, 500, 220)
    var art = read_art
    var text = ART_TEXTS[art]
    label_centered(ART_BOOKS[art], 320, 82, 16, ap.Color(220, 160, 255))
    label_centered("CURSED BOOK: {ART_NAMES[art]}  ({TIER_NAMES[ART_TIER[art]]}{", LATIN" if ART_TIER[art] > 0 else ""})", 320, 104, 8, ap.Color(200, 190, 210))
    if read_state == 1 do
        label_centered("LEARNED: " + ART_NAMES[art], 320, 160, 16, ap.Color(255, 230, 160))
        label_centered(art_move(art).note + ". PRESS X IN A FIGHT, THEN 1-4, TO USE ARTS (THEY COST MANA).", 320, 192, 8, ap.Color(200, 190, 210))
        label_centered("ENTER", 320, 262, 8, ap.Color(150, 140, 160))
        return
    end
    if read_state == 2 do
        label_centered("FAILED", 320, 156, 16, ap.Color(255, 110, 100))
        label_centered("OUT OF CHANCES. WALK AWAY AND BACK TO TRY AGAIN; EACH ATTEMPT COSTS HEALTH.", 320, 188, 8, ap.Color(200, 190, 210))
        label_centered("ENTER", 320, 262, 8, ap.Color(150, 140, 160))
        return
    end
    label_centered("TYPE THE TEXT BELOW EXACTLY, LETTER BY LETTER (SPACES AND PUNCTUATION TOO).", 320, 122, 8, ap.Color(220, 210, 230))
    var starts = line_starts(text, 50)
    for n, start in starts do
        var stop = starts[n + 1] if n + 1 < starts.length else text.length
        var line = text[start..<stop]
        var x = 320 - ap.measure(line, 8).x / 2
        var y = 146 + double(n) * 16
        # Copied, then the letter wanted now, then the rest.
        var done = math.clamp(read_pos - start, 0, line.length)
        if done > 0 do
            label(line[0..<done], x, y, 8, ap.WHITE)
            x += ap.measure(line[0..<done], 8).x
        end
        if done < line.length do
            var here = line[done..<(done + 1)]
            if read_pos >= start and read_pos < stop do
                var shown = "_" if here == " " else here
                var w = math.max(ap.measure(shown, 8).x, 5.0)
                ap.rect(x - 1, y - 1, w + 2, 11, ap.Color(255, 60, 70, int(80 + 175 * read_wrong)) if read_wrong > 0 else ap.Color(170, 110, 255, 120))
                label(shown, x, y, 8, ap.Color(255, 240, 200))
                x += ap.measure(here, 8).x
                if done + 1 < line.length do
                    label(line[(done + 1)..<line.length], x, y, 8, ap.Color(110, 100, 125))
                end
            else do
                label(line[done..<line.length], x, y, 8, ap.Color(110, 100, 125))
            end
        end
    end
    var progress = double(read_pos) / double(text.length)
    ap.rect(170, 246, 300, 4, ap.Color(40, 30, 50))
    ap.rect(170, 246, 300 * progress, 4, ap.Color(220, 160, 255))
    label("CHANCES:", 270, 256, 8, ap.Color(200, 190, 210))
    for i in 0..<CHANCES do
        ap.rect(338 + double(i) * 14, 256, 10, 8, ap.Color(255, 120, 110) if i < read_chances else ap.Color(60, 50, 60))
    end
    label_centered("THIS ATTEMPT COST {int(read_cost)} HP.  EACH WRONG LETTER COSTS A CHANCE.  ESC GIVES UP.", 320, 274, 8, ap.Color(150, 140, 160))
    if read_wrong > 0 do
        ap.rect_lines(70, 70, 500, 220, 2, ap.Color(255, 60, 70, int(255 * read_wrong)))
    end
end

function draw_inventory()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 150))
    panel(100, 60, 440, 240)
    label_centered("INVENTORY" + ("  (IN COMBAT: NOT PAUSED)" if combat_lock else "  (PAUSED)"), 320, 70, 8, ap.Color(255, 220, 200))
    for i, t in INV_TABS do
        var x = 140 + double(i) * 90
        label_centered(t, x, 88, 8, ap.WHITE if i == inv_tab else ap.Color(130, 120, 140))
        if i == inv_tab do
            ap.rect(x - 24, 98, 48, 1, ap.Color(255, 120, 110))
        end
    end
    if inv_tab == 4 do
        label("SOULS: {data.souls}", 130, 116, 8, ap.Color(200, 230, 255))
        label("HEALTH {int(data.max_health)}   STAMINA {int(data.max_stamina)}   MANA {int(data.max_mana)}", 130, 132, 8, ap.Color(220, 210, 230))
        label("BOSSES DEFEATED: {data.cleared.length} OF {cast.length}", 130, 148, 8, ap.Color(220, 210, 230))
        label("STANCE {STANCE_NAMES[data.stance]}   ARTS {data.arts.length}   WEAPONS {data.weapons.length} OF {WEAPON_NAMES.length}", 130, 164, 8, ap.Color(220, 210, 230))
        if pact != "" do
            label("PACT: {PACT_NAMES[pact_index(pact)]} - {PACT_NOTES[pact_index(pact)]}", 130, 196, 8, ap.Color(255, 120, 110))
        end
        var inf = infusion(data.weapon)
        if inf != "" do
            label("{weapon_name(data.weapon)} INFUSED: {INFUSE_NAMES[pact_index_infuse(inf)]}", 130, 236, 8, INFUSE_COLORS[pact_index_infuse(inf)])
        end
        label("DIFFICULTY: {DIFF_NAMES[data.difficulty]}", 130, 180, 8, ap.Color(220, 210, 230))
        label("Souls are your currency: spend them at dojos and shops. Defeating a boss raises max HP, ST and MN.", 130, 210, 8, ap.Color(150, 140, 160))
    else do
        var rows = inventory_rows()
        if rows.length == 0 do
            label_centered("NO ARTS YET: FIND A CURSED BOOK" if inv_tab == 2 else ("NO ITEMS YET: BUY THEM AT SHOPS" if inv_tab == 3 else "NOTHING YET"), 320, 140, 8, ap.Color(150, 140, 160))
        end
        draw_rows(rows, overlay_row, 120, 110, 400)
        var note = ""
        if inv_tab == 0 and overlay_row > 0 and overlay_row - 1 < data.weapons.length do
            note = WEAPON_NOTES[data.weapons[overlay_row - 1]]
        else if inv_tab == 1 do
            note = STANCE_NOTES[data.stance] + "  (LEARNING ANOTHER AT A DOJO REPLACES IT)"
        else if inv_tab == 2 and overlay_row < data.arts.length do
            note = art_move(data.arts[overlay_row]).note + "  (ENTER: PUT IN / TAKE OUT OF THE ART MENU)"
        else if inv_tab == 3 do
            var n = 0
            for k in 0..<item_defs.length do
                if owns_item(k) do
                    if n == overlay_row do
                        note = items.describe(item_defs[k])
                    end
                    n += 1
                end
            end
        end
        label(note, 120, 270, 8, ap.Color(170, 160, 180))
    end
    label_centered("A / D: TABS   W / S: CHOOSE   ENTER: EQUIP   E: CLOSE", 320, 286, 8, ap.Color(130, 120, 140))
end

const string[] TUTORIAL_TITLES = ["R: SHOOT", "E: INVENTORY", "C: ARMAMENT", "Z STANCE  X ART  V REFLEX"]
const string[] TUTORIAL_LINES = ["Fires at the nearest enemy in front of you. Six rounds; when empty it reloads (a dash, a block or a move cancels the reload). Gunshots alert enemies within about 14 m.",
    "Equip weapons, stances and arts. Out of combat the game pauses while it is open. In combat it does not pause, and weapons and stances cannot be changed.",
    "Press C to draw your weapon and pick its four skills, then 1, 2, 3 or 4 to use one. The gun's take rounds and cool down a long while; melee skills cost stamina.",
    "Z picks stance moves (stamina), X arts (mana), V focus moves. 1-4 always use the open menu's moves; press another letter to switch, or the same one to put it away."]
function draw_tutorial()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 160))
    panel(130, 104, 380, 160)
    label_centered("THE GUN", 320, 116, 8, ap.Color(255, 220, 160))
    label_centered(TUTORIAL_TITLES[tutorial_page], 320, 144, 24, ap.WHITE)
    var lines = wrap_words(TUTORIAL_LINES[tutorial_page], 56)
    for i, line in lines do
        label_centered(line, 320, 180 + double(i) * 12, 8, ap.Color(200, 190, 210))
    end
    for i in 0..<4 do
        ap.rect(296 + double(i) * 14, 242, 8, 3, ap.Color(255, 120, 110) if i == tutorial_page else ap.Color(80, 70, 80))
    end
    label_centered("ENTER", 320, 250, 8, ap.Color(150, 140, 160).fade(0.5 + 0.5 * math.sin(double(ticks) * 0.08)))
end

function wrap_words(string words, int width) returns string[]
    string[] lines = []
    var line = ""
    for word in words.split(" ") do
        if line.length + word.length + 1 > width and line != "" do
            lines.push(line)
            line = word
        else do
            line = word if line == "" else line + " " + word
        end
    end
    if line != "" do
        lines.push(line)
    end
    return lines
end

function draw_shop_menu()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 150))
    panel(110, 80, 420, 220)
    label_centered("THE SOUL MERCHANT", 320, 92, 8, ap.Color(255, 210, 130))
    label_centered("ARENA ITEMS, YOURS FOR GOOD: ALL OF THEM WORK AT ONCE, IN EVERY LEVEL.", 320, 108, 8, ap.Color(200, 190, 210))
    string[] rows = []
    for k in lv.stock do
        var it = item_defs[k]
        var state = "OWNED" if owns_item(k) else "{item_price(k)} SOULS"
        rows.push("{it.name}  -  {state}")
    end
    rows.push("LEAVE")
    draw_rows(rows, overlay_row, 130, 130, 380)
    if overlay_row < lv.stock.length do
        var it = item_defs[lv.stock[overlay_row]]
        label(items.describe(it), 130, 236, 8, ap.Color(255, 220, 160))
        label(it.flavor, 130, 250, 8, ap.Color(160, 150, 170))
        label(["COMMON", "RARE", "CURSED (HAS A DRAWBACK)"][it.tier], 130, 264, 8, [ap.Color(190, 190, 200), ap.Color(120, 180, 255), ap.Color(255, 110, 110)][it.tier])
    end
    label_right("YOUR SOULS: {data.souls}", 510, 280, 8, ap.Color(200, 230, 255))
    label("ESC: LEAVE", 130, 280, 8, ap.Color(130, 120, 140))
end

function draw_dojo_menu()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 170))
    label_centered("THE DOJO IN {lv.name}", 320, 52, 16, ap.Color(255, 200, 140))
    label_centered("ITS MASTER TEACHES TWO STANCES. YOU KNOW ONE AT A TIME: LEARNING ONE REPLACES {STANCE_NAMES[data.stance]}.", 320, 74, 8, ap.Color(200, 190, 210))
    var choices = lv.dojo_stances
    for k, st in choices do
        var r = dojo_button(k)
        var pop = dojo_pop[k]
        var grow = 1 + 0.06 * pop
        var cx = r.x + r.w / 2
        var cy = r.y + r.h / 2 - 6 * pop
        var w = r.w * grow
        var h = r.h * grow
        var x = cx - w / 2
        var y = cy - h / 2
        var col = STANCE_COLORS[st]
        var on = k == overlay_row
        ap.rect(x, y, w, h, col.lerp(ap.BLACK, 0.82 - 0.1 * pop))
        ap.rect_lines(x, y, w, h, 2 if on else 1, col.fade(0.5 + 0.5 * pop))
        ap.rect(x, y, w, 3, col.fade(0.6 + 0.4 * pop))
        # The stance's emblem.
        draw_stance_emblem(st, cx, y + 58, 34 * grow, col)
        label_centered(STANCE_NAMES[st], cx, y + 104, 16, ap.WHITE if on else ap.Color(220, 214, 230))
        var notes = wrap_words(STANCE_NOTES[st], 38)
        for i, line in notes do
            if i < 3 do
                label_centered(line, cx, y + 126 + double(i) * 10, 8, ap.Color(190, 180, 200))
            end
        end
        var ms = stance_moves(st)
        label_centered("{ms[0].name.upper()} / {ms[1].name.upper()}", cx, y + 154, 8, col.lerp(ap.WHITE, 0.4))
        label_centered("{ms[2].name.upper()} / {ms[3].name.upper()}", cx, y + 165, 8, col.lerp(ap.WHITE, 0.4))
        var price = "YOU KNOW IT" if st == data.stance else "{dojo_price(st)} SOULS"
        label_centered(price, cx, y + h - 18, 8, ap.Color(200, 230, 255) if data.souls >= dojo_price(st) or st == data.stance else ap.Color(255, 130, 110))
    end
    if choices.length == 0 do
        label_centered("THE MASTER HAS NOTHING TO TEACH YOU.", 320, 180, 8, ap.Color(200, 190, 210))
    end
    ap.rect(0, 293, VW, 67, ap.Color(4, 2, 6, 245))
    label_right("YOUR SOULS: {data.souls}", 570, 300, 8, ap.Color(200, 230, 255))
    label("A / D OR MOUSE: CHOOSE   ENTER / CLICK: LEARN   ESC: LEAVE", 70, 300, 8, ap.Color(130, 120, 140))
end

# Each stance's sign, drawn on its dojo button.
function draw_stance_emblem(int st, double cx, double cy, double size, ap.Color col)
    var s = size
    var t = double(ticks)
    ap.circle(cx, cy, s * 0.95, col.fade(0.12))
    ap.circle_lines(cx, cy, s * 0.95, 1, col.fade(0.5))
    if st == 0 do
        # STREET: a fist.
        ap.rect(cx - s * 0.35, cy - s * 0.3, s * 0.7, s * 0.55, col)
        for i in 0..<4 do
            ap.rect(cx - s * 0.35 + double(i) * s * 0.18, cy - s * 0.42, s * 0.15, s * 0.18, col.lerp(ap.WHITE, 0.3))
        end
        ap.rect(cx - s * 0.2, cy + s * 0.25, s * 0.4, s * 0.3, col.brightness(0.8))
    else if st == 1 or st == 11 do
        # CRANE / HAWK: a bird, wings up.
        var flap = math.sin(t * 0.08) * s * 0.12
        ap.triangle(ap.Vec2(cx, cy), ap.Vec2(cx - s * 0.8, cy - s * 0.45 - flap), ap.Vec2(cx - s * 0.2, cy + s * 0.1), col)
        ap.triangle(ap.Vec2(cx, cy), ap.Vec2(cx + s * 0.8, cy - s * 0.45 - flap), ap.Vec2(cx + s * 0.2, cy + s * 0.1), col)
        ap.triangle(ap.Vec2(cx - s * 0.08, cy - s * 0.1), ap.Vec2(cx + s * 0.08, cy - s * 0.1), ap.Vec2(cx, cy + s * 0.55), col.brightness(0.85))
        if st == 11 do
            ap.triangle(ap.Vec2(cx - s * 0.1, cy - s * 0.12), ap.Vec2(cx + s * 0.1, cy - s * 0.12), ap.Vec2(cx, cy - s * 0.32), ap.Color(250, 210, 80))
        end
    else if st == 2 or st == 7 do
        # IRON OX / BULL: horns over a head.
        ap.rect(cx - s * 0.3, cy - s * 0.15, s * 0.6, s * 0.6, col)
        ap.triangle(ap.Vec2(cx - s * 0.3, cy - s * 0.1), ap.Vec2(cx - s * 0.85, cy - s * 0.55), ap.Vec2(cx - s * 0.3, cy + s * 0.1), col.lerp(ap.WHITE, 0.4))
        ap.triangle(ap.Vec2(cx + s * 0.3, cy - s * 0.1), ap.Vec2(cx + s * 0.85, cy - s * 0.55), ap.Vec2(cx + s * 0.3, cy + s * 0.1), col.lerp(ap.WHITE, 0.4))
        ap.rect(cx - s * 0.12, cy + s * 0.25, s * 0.08, s * 0.08, ap.BLACK)
        ap.rect(cx + s * 0.04, cy + s * 0.25, s * 0.08, s * 0.08, ap.BLACK)
    else if st == 3 or st == 9 do
        # VIPER / SCORPION: a coil (and for the scorpion, a sting).
        for i in 0..<9 do
            var a = double(i) * 0.75 + t * 0.03
            var r = s * (0.15 + 0.06 * double(i))
            ap.circle(cx + math.cos(a) * r, cy + math.sin(a) * r * 0.7, s * (0.17 - 0.008 * double(i)), col)
        end
        if st == 9 do
            ap.triangle(ap.Vec2(cx + s * 0.55, cy - s * 0.5), ap.Vec2(cx + s * 0.75, cy - s * 0.25), ap.Vec2(cx + s * 0.85, cy - s * 0.7), ap.Color(255, 230, 120))
        end
    else if st == 4 do
        # TEMPEST: a whirl.
        for i in 0..<3 do
            var a = t * 0.06 + double(i) * 2.09
            ap.triangle(ap.Vec2(cx, cy), ap.Vec2(cx + math.cos(a) * s * 0.85, cy + math.sin(a) * s * 0.85), ap.Vec2(cx + math.cos(a + 0.6) * s * 0.5, cy + math.sin(a + 0.6) * s * 0.5), col)
        end
    else if st == 5 do
        # SIPHON: a drop, filling.
        ap.circle(cx, cy + s * 0.15, s * 0.42, col)
        ap.triangle(ap.Vec2(cx - s * 0.4, cy + s * 0.05), ap.Vec2(cx + s * 0.4, cy + s * 0.05), ap.Vec2(cx, cy - s * 0.7), col)
        var fill = 0.5 + 0.5 * math.sin(t * 0.05)
        ap.rect(cx - s * 0.25, cy + s * 0.5 - s * 0.6 * fill, s * 0.5, s * 0.6 * fill, ap.WHITE.fade(0.35))
    else if st == 6 do
        # MANTIS: two scythes.
        ap.triangle(ap.Vec2(cx - s * 0.1, cy + s * 0.6), ap.Vec2(cx - s * 0.2, cy - s * 0.6), ap.Vec2(cx - s * 0.75, cy - s * 0.2), col)
        ap.triangle(ap.Vec2(cx + s * 0.1, cy + s * 0.6), ap.Vec2(cx + s * 0.2, cy - s * 0.6), ap.Vec2(cx + s * 0.75, cy - s * 0.2), col)
    else if st == 8 do
        # DRUNKEN: a gourd, tilting.
        var tip = math.sin(t * 0.04) * s * 0.15
        ap.circle(cx + tip, cy + s * 0.25, s * 0.42, col)
        ap.circle(cx + tip * 1.5, cy - s * 0.25, s * 0.25, col)
        ap.rect(cx + tip * 2 - s * 0.06, cy - s * 0.62, s * 0.12, s * 0.18, col.brightness(0.7))
    else if st == 10 do
        # LOTUS: petals.
        for i in 0..<6 do
            var a = double(i) * 1.047 + t * 0.01
            ap.circle(cx + math.cos(a) * s * 0.4, cy + math.sin(a) * s * 0.4, s * 0.28, col.fade(0.8))
        end
        ap.circle(cx, cy, s * 0.22, ap.Color(255, 230, 140))
    else if st == 12 do
        # BEAR: a paw.
        ap.circle(cx, cy + s * 0.2, s * 0.4, col)
        for i in 0..<4 do
            ap.circle(cx + (double(i) - 1.5) * s * 0.3, cy - s * 0.35 - (0.08 * s if i == 1 or i == 2 else 0.0), s * 0.15, col)
        end
    else do
        # SHADE: an eye in the dark.
        ap.triangle(ap.Vec2(cx - s * 0.8, cy), ap.Vec2(cx, cy - s * 0.45), ap.Vec2(cx + s * 0.8, cy), col)
        ap.triangle(ap.Vec2(cx - s * 0.8, cy), ap.Vec2(cx, cy + s * 0.45), ap.Vec2(cx + s * 0.8, cy), col)
        ap.circle(cx, cy, s * 0.26, ap.BLACK)
        ap.circle(cx + math.sin(t * 0.05) * s * 0.08, cy, s * 0.1, ap.Color(255, 220, 255))
    end
end

function draw_front()
    if front_achievements do
        draw_achievements()
        return
    end
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 80))
    label_centered("PURGATORY", 320, 70, 32, ap.Color(230, 60, 70))
    label_centered("PLAY AS SCARF THROUGH 44 LEVELS, ONE PER ARENA FIGHTER,", 320, 106, 8, ap.Color(190, 180, 200))
    label_centered("EACH ENDING IN A BOSS FIGHT AGAINST THAT FIGHTER.", 320, 116, 8, ap.Color(190, 180, 200))
    var progress = "NOT STARTED" if not data.tutorial else "{data.cleared.length} OF {cast.length} BOSSES DEFEATED"
    label_centered(progress + "    {data.souls} SOULS", 320, 130, 8, ap.Color(150, 140, 160))
    draw_rows(front_rows(), front_row, 360, 190, 250)
    if hint_ticks > 0 do
        label_centered(hint, 320, 320, 8, hint_color.fade(math.min(double(hint_ticks) / 30, 1.0)))
    end
    label_centered("W / S CHOOSE   A / D CHANGE   ENTER GO   ESC BACK", 320, 340, 8, ap.Color(120, 110, 130))
    if data.difficulty == DIFF_HELL do
        # The word HELL in its row, underlined in fire (the row is drawn by draw_rows: its text
        # starts 8 in from the row's left edge, 5 down from its top).
        var r = row_rect(3, 360, 190, 250)
        var x = r.x + 8 + ap.measure("DIFFICULTY  <  ", 8).x
        var w = ap.measure("HELL", 8).x
        draw_flames(x, r.y + 15, w, 7, 2)
        label("HELL", x, r.y + 5, 8, ap.Color(255, 110, 50).lerp(ap.Color(255, 200, 90), 0.5 + 0.5 * math.sin(double(ticks) * 0.15)))
    end
end

function draw_achievements()
    ap.rect(0, 0, VW, VH, ap.Color(0, 0, 0, 200))
    label_centered("ACHIEVEMENTS", 320, 24, 16, ap.Color(255, 220, 160))
    label_centered("{data.achievements.length} OF {ACH_IDS.length} EARNED.  THOSE EARNED ON HELL BURN.", 320, 46, 8, ap.Color(190, 180, 200))
    for row in 0..<11 do
        var k = row + ach_scroll
        if k >= ACH_IDS.length do
            break
        end
        var y = 64 + double(row) * 24
        var got = achieved(ACH_IDS[k])
        var hell = achieved_hell(ACH_IDS[k])
        ap.rect(110, y, 420, 20, ap.Color(40, 8, 6, 220) if hell else (ap.Color(24, 20, 30, 220) if got else ap.Color(12, 10, 14, 200)))
        if hell do
            draw_flames(112, y + 19, 416, 10, double(k))
            ap.rect_lines(110, y, 420, 20, 1, ap.Color(255, 70, 30, int(160 + 90 * math.sin(double(ticks) * 0.15 + double(k)))))
        else if got do
            ap.rect_lines(110, y, 420, 20, 1, ap.Color(255, 220, 140, 160))
        end
        label(ACH_NAMES[k] if got else "???", 118, y + 6, 8, ap.Color(255, 140, 80) if hell else (ap.Color(255, 230, 170) if got else ap.Color(110, 100, 120)))
        label_right(ACH_NOTES[k], 522, y + 6, 8, ap.Color(200, 190, 210) if got else ap.Color(100, 90, 110))
    end
    label_centered("W / S SCROLL   ESC BACK", 320, 340, 8, ap.Color(120, 110, 130))
end

# Whether every level can be walked from its start to its boss (the tests ask).
function reachable(Level level) returns bool
    var start = cell_of(level.spawn)
    var goal = cell_of(level.rooms[level.boss_room].center())
    bool[] seen = []
    for k in 0..<(level.w * level.h) do
        seen.push(false)
    end
    int[] queue = [start[1] * level.w + start[0]]
    seen[queue[0]] = true
    var head = 0
    while head < queue.length do
        var k = queue[head]
        head += 1
        if k == goal[1] * level.w + goal[0] do
            return true
        end
        var x = k % level.w
        var y = k // level.w
        for d in [[1, 0], [-1, 0], [0, 1], [0, -1]] do
            var nx = x + d[0]
            var ny = y + d[1]
            if cell_at(level, nx, ny) == CELL_FLOOR and not seen[ny * level.w + nx] do
                seen[ny * level.w + nx] = true
                queue.push(ny * level.w + nx)
            end
        end
    end
    return false
end

# Checks the game's tests run (tests/test_systems.fw): what is wrong, or nothing.
function self_test() returns string[]
    string[] wrong = []
    var everyone = roster.build()
    cast = everyone
    for k in 0..<everyone.length do
        if k % 5 == 4 do
            var hall = make_intermission(k)
            if not reachable(hall) do
                wrong.push("the intermission after level {k} cannot be walked to its hall")
            end
            if hall.queue.length != 3 do
                wrong.push("the intermission after level {k} does not have three bosses")
            end
        end
    end
    for k in 0..<everyone.length do
        for seed in [1, 77, 4242, 99991] do
            var level = make_level(k, everyone[k], seed * (k + 1))
            if not reachable(level) do
                wrong.push("level {k} ({everyone[k].name}), seed {seed}, cannot be walked to its boss")
            end
            if level.boss_doors.length == 0 do
                wrong.push("level {k}, seed {seed}: the boss hall has no door to seal")
            end
        end
    end
    for a in 0..<ART_NAMES.length do
        if ART_TEXTS[a].length == 0 or (ART_TIER[a] == 0 and ART_TEXTS[a].length > 30) or (ART_TIER[a] == 2 and ART_TEXTS[a].length < 60) do
            wrong.push("art {a}'s text does not fit its tier")
        end
    end
    for st in 0..<STANCE_NAMES.length do
        if stance_moves(st).length != 4 do
            wrong.push("stance {st} does not have four moves")
        end
    end
    if STANCE_PRICE.length != STANCE_NAMES.length or STANCE_HOMES.length != STANCE_NAMES.length or STANCE_NOTES.length != STANCE_NAMES.length or STANCE_COLORS.length != STANCE_NAMES.length do
        wrong.push("the stance tables are not all the same length")
    end
    if ART_TEXTS.length != ART_NAMES.length or ART_TIER.length != ART_NAMES.length or ART_HOMES.length != ART_NAMES.length or ART_BOOKS.length != ART_NAMES.length do
        wrong.push("the art tables are not all the same length")
    end
    if LEVEL_LAYOUTS.length != LEVEL_OWNERS.length or LEVEL_STYLES.length != LEVEL_OWNERS.length do
        wrong.push("the level tables are not all the same length")
    end
    if ACH_NAMES.length != ACH_IDS.length or ACH_NOTES.length != ACH_IDS.length do
        wrong.push("the achievement tables are not all the same length")
    end
    if PACT_NAMES.length != PACT_IDS.length or PACT_NOTES.length != PACT_IDS.length do
        wrong.push("the pact tables are not all the same length")
    end
    for w in -1..<WEAPON_NAMES.length do
        if weapon_moves(w).length != 4 do
            wrong.push("weapon {w} does not have four skills")
        end
    end
    return wrong
end
