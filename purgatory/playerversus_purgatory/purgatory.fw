function owner_slot(string name) returns int
    for k, n in LEVEL_OWNERS do
        if n == name do
            return k
        end
    end
    return -1
end
function level_title(roster.Character kit) returns string
    var k = owner_slot(kit.name)
    return LEVEL_TITLES[k] if k >= 0 else kit.maximum.place
end
function level_style(roster.Character kit) returns int
    var k = owner_slot(kit.name)
    return LEVEL_STYLES[k] if k >= 0 else STYLE_HALLS
end
function level_layout(roster.Character kit) returns int
    var k = owner_slot(kit.name)
    return LEVEL_LAYOUTS[k] if k >= 0 else LAYOUT_NORMAL
end
function boss_quote(roster.Character kit) returns string
    var k = owner_slot(kit.name)
    return BOSS_QUOTES[k] if k >= 0 else ""
end

# --- Levels ------------------------------------------------------------------------------------
# A level is a grid of cells: floor, wall, or nothing. Rooms strung along a path from the start to
# the boss's hall, a few side rooms off it (treasure, a dojo, a reading room), corridors between.
# Each is built from one Arena fighter's place: its colors, its light, its kind of furniture.

const int ROOM_PLAIN = 0
const int ROOM_START = 1
const int ROOM_BOSS = 2
const int ROOM_TREASURE = 3
const int ROOM_DOJO = 4
const int ROOM_LIBRARY = 5
const int ROOM_SHOP = 6
const int ROOM_GAMBLER = 7           # the Gambler: wagers, dice and a mystery box, for souls
const int ROOM_FORGE = 8             # the Smith: infuses your weapon with an element
const int ROOM_SHRINE = 9            # a shrine of pacts: a boon and a bane for the level, or a bounty

const int PROP_PILLAR = 0
const int PROP_TOMB = 1
const int PROP_TREE = 2
const int PROP_CRATE = 3
const int PROP_CRYSTAL = 4
const int PROP_LAMP = 5
const int PROP_ROCK = 6
const int PROP_BUSH = 7
const int PROP_TANK = 8              # a glass tank of something glowing (labs)
const int PROP_CANDLES = 9           # a tall candelabra (manors)
const int PROP_BLOCKS = 10           # a stack of alphabet blocks (the nursery)
const int PROP_YARN = 11             # a ball of yarn as big as you
const int PROP_CRATER = 12           # rubble where a wall stood (no collision)

class Room
    int x
    int y
    int w
    int h
    int kind = ROOM_PLAIN
    function cx() returns double
        return (double(this.x) + double(this.w) / 2) * TILE
    end
    function cz() returns double
        return (double(this.y) + double(this.h) / 2) * TILE
    end
    function center() returns ap.Vec3
        return ap.Vec3(this.cx(), 0, this.cz())
    end
    function holds(ap.Vec3 p) returns bool
        return p.x >= double(this.x) * TILE and p.x <= double(this.x + this.w) * TILE and
            p.z >= double(this.y) * TILE and p.z <= double(this.y + this.h) * TILE
    end
end

class Prop
    int kind
    ap.Vec3 at
    double size = 1
    double turn = 0
    double life = -1                 # over 0: seconds before it sinks away (a boss's raised wall)
    double rise = 1                  # 0 .. 1 as it comes up
end

class Chest
    int id
    ap.Vec3 at
    double heading = 0
    bool opened = false
    double lid = 0                   # 0 shut .. 1 thrown open
    int souls = 10
    int weapon = -1                  # a weapon inside, or -1
    int book = -1                    # a cursed book inside, or -1
    int tier = 0                     # 0 wood, 1 iron, 2 gold: how good what is inside is
    bool known = false               # seen (it is on the minimap)
end

class Book
    int art
    ap.Vec3 at
    bool taken = false
    bool ready = true                # walked away since the last attempt (one attempt per approach)
    bool known = false
    bool red = false                 # a red book (a boss's own art): bought with souls, not copied out
    int price = 0
    double fly = 1                   # 0 .. 1: a red book flying out of its boss to hang before you
    ap.Vec3 start = ap.Vec3(0, 0, 0)
end

const int GATE_NEXT = 0
const int GATE_INTERMISSION = 1      # to the strange hall between levels
class Gate
    ap.Vec3 at
    int to = 0                       # the level it leads to
    bool open = false
    double grow = 0
    int kind = GATE_NEXT
    bool known = false
end

# A place to spend souls, other than a shop or a dojo.
class Spot
    int kind                         # ROOM_GAMBLER, ROOM_FORGE or ROOM_SHRINE
    ap.Vec3 at
    bool known = false
    bool ready = true
    string[] offer = []              # the shrine's pacts on offer
    bool used = false
end

const int LEVEL_PLAIN = 0
const int LEVEL_INTERMISSION = 1     # one great hall, three bosses back to back, then treasure
const int LEVEL_FINAL = 2            # the last fighter's level: past it, the dark

class Level
    int index = -1                   # -1: the threshold; 0..: the fighter's level
    string name = "THE THRESHOLD"
    string owner = ""
    int w = MAP
    int h = MAP
    int[] cells = []
    double[] reveal = []
    Room[] rooms = []
    Prop[] props = []
    Chest[] chests = []
    Book[] books = []
    Gate[] gates = []
    ap.Vec3 spawn = ap.Vec3(0, 0, 0)
    ap.Vec3 dojo = ap.Vec3(0, 0, 0)
    bool has_dojo = false
    int[] dojo_stances = []          # the two stances its master teaches
    bool dojo_known = false
    bool shop_known = false
    bool boss_known = false
    Spot[] spots = []
    bool[] explored = []             # cells Scarf has been near (the minimap shows only these)
    int mode = LEVEL_PLAIN
    int[] queue = []                 # an intermission's bosses, in order
    int layout = LAYOUT_NORMAL
    int dark_x = -1                  # the final level: where the dark begins (a cell column)...
    ap.Vec3 death_at = ap.Vec3(0, 0, 0)   # ...and where it leads
    bool has_shop = false
    ap.Vec3 shop = ap.Vec3(0, 0, 0)
    int[] stock = []                 # what the shop sells: indexes into item_defs
    int[] boss_doors = []            # the cells sealed behind you in the boss's hall
    int boss_room = -1
    ap.Color floor_color = ap.Color(120, 70, 60)
    ap.Color wall_color = ap.Color(90, 60, 56)
    ap.Color glow = ap.Color(255, 120, 90)
    ap.Color mote = ap.Color(255, 200, 160)
    ap.Color ambient = ap.Color(14, 12, 18)     # in the dark
    ap.Color ambient_lit = ap.Color(110, 100, 120)   # once the place is lit
    ap.Color sun = ap.Color(200, 190, 180)
    ap.Color sky = ap.Color(10, 8, 14)
    int prop_kind = PROP_PILLAR
    int style = 0                    # STYLE_HALLS, _FOREST, _CAVE or _STREETS
    ap.World world = ap.World()
end

# A seeded random source, so a level is the same every time.
class Dice
    int state = 1
    function next() returns double
        this.state = (this.state * 1103515245 + 12345) % 2147483648
        return double(this.state) / 2147483648.0
    end
    function range(int low, int high) returns int
        return low + int(this.next() * double(high - low + 1)) % (high - low + 1)
    end
    function chance(double p) returns bool
        return this.next() < p
    end
end

function cell_at(Level lv, int x, int y) returns int
    if x < 0 or y < 0 or x >= lv.w or y >= lv.h do
        return CELL_VOID
    end
    return lv.cells[y * lv.w + x]
end
function set_cell(Level lv, int x, int y, int kind)
    if x < 0 or y < 0 or x >= lv.w or y >= lv.h do
        return
    end
    lv.cells[y * lv.w + x] = kind
end
function cell_of(ap.Vec3 p) returns int[]
    return [int(math.floor(p.x / TILE)), int(math.floor(p.z / TILE))]
end
function cell_center(int x, int y) returns ap.Vec3
    return ap.Vec3((double(x) + 0.5) * TILE, 0, (double(y) + 0.5) * TILE)
end

function carve_room(Level lv, Room r, Dice d)
    var round = lv.style == STYLE_FOREST or lv.style == STYLE_CAVE
    var cx = double(r.x) + double(r.w) / 2 - 0.5
    var cy = double(r.y) + double(r.h) / 2 - 0.5
    for y in r.y..<(r.y + r.h) do
        for x in r.x..<(r.x + r.w) do
            if round do
                # A clearing or a cavern: round, and (a cave) lumpy at the edge.
                var dx = (double(x) - cx) / (double(r.w) / 2)
                var dy = (double(y) - cy) / (double(r.h) / 2)
                var edge = 1.0 if lv.style == STYLE_FOREST else 0.8 + d.next() * 0.45
                if dx * dx + dy * dy <= edge do
                    set_cell(lv, x, y, CELL_FLOOR)
                end
            else do
                set_cell(lv, x, y, CELL_FLOOR)
            end
        end
    end
    # The middle is always open (so the way through always is).
    set_cell(lv, r.x + r.w // 2, r.y + r.h // 2, CELL_FLOOR)
end
# A path between two rooms' middles: in the open, a winding trail; underground, a twisting
# tunnel; otherwise an L-shaped corridor (three wide between buildings, two between walls).
function carve_corridor(Level lv, Room a, Room b, Dice d)
    var ax = a.x + a.w // 2
    var ay = a.y + a.h // 2
    var bx = b.x + b.w // 2
    var by = b.y + b.h // 2
    var wide = lv.layout == LAYOUT_OPEN
    if lv.style == STYLE_FOREST or lv.style == STYLE_CAVE do
        var x = ax
        var y = ay
        var steps = 0
        while (x != bx or y != by) and steps < 900 do
            set_cell(lv, x, y, CELL_FLOOR)
            set_cell(lv, x + 1, y, CELL_FLOOR)
            set_cell(lv, x, y + 1, CELL_FLOOR)
            if (lv.style == STYLE_CAVE and d.chance(0.3)) or wide do
                set_cell(lv, x + 1, y + 1, CELL_FLOOR)
            end
            if wide do
                set_cell(lv, x - 1, y, CELL_FLOOR)
                set_cell(lv, x, y - 1, CELL_FLOOR)
                set_cell(lv, x + 2, y, CELL_FLOOR)
                set_cell(lv, x, y + 2, CELL_FLOOR)
            end
            var roll = d.next()
            var gx = bx - x
            var gy = by - y
            if roll < (0.26 if lv.layout == LAYOUT_TIGHT else 0.18) do
                # A step aside, so the way wanders.
                if d.chance(0.5) do
                    x = int(math.clamp(double(x + (1 if d.chance(0.5) else -1)), 2.0, double(lv.w - 3)))
                else do
                    y = int(math.clamp(double(y + (1 if d.chance(0.5) else -1)), 2.0, double(lv.h - 3)))
                end
            else if gx != 0 and (gy == 0 or d.chance(double(math.abs(gx)) / double(math.abs(gx) + math.abs(gy)))) do
                x += 1 if gx > 0 else -1
            else if gy != 0 do
                y += 1 if gy > 0 else -1
            end
            steps += 1
        end
        if x == bx and y == by do
            return
        end
        ax = x
        ay = y
    end
    var across_first = d.chance(0.5)
    var x = ax
    var y = ay
    var steps = 0
    while (x != bx or y != by) and steps < 400 do
        set_cell(lv, x, y, CELL_FLOOR)
        set_cell(lv, x + 1, y, CELL_FLOOR)
        set_cell(lv, x, y + 1, CELL_FLOOR)
        if lv.style == STYLE_STREETS or wide do
            set_cell(lv, x + 1, y + 1, CELL_FLOOR)
            set_cell(lv, x - 1, y, CELL_FLOOR)
            set_cell(lv, x, y - 1, CELL_FLOOR)
        end
        if wide and lv.style == STYLE_STREETS do
            set_cell(lv, x + 2, y, CELL_FLOOR)
            set_cell(lv, x, y + 2, CELL_FLOOR)
        end
        if (across_first and x != bx) or y == by do
            x += 1 if bx > x else -1
        else do
            y += 1 if by > y else -1
        end
        steps += 1
    end
end

function prop_style(int scene) returns int
    if scene == roster.SCENE_GRAVEYARD or scene == roster.SCENE_CEMETERY or scene == roster.SCENE_SWAMP or scene == roster.SCENE_GALLOWS do
        return PROP_TOMB
    else if scene == roster.SCENE_FOREST or scene == roster.SCENE_GROVE or scene == roster.SCENE_WILDWOOD or scene == roster.SCENE_CANYON do
        return PROP_TREE
    else if scene == roster.SCENE_WAREHOUSE or scene == roster.SCENE_FACTORY or scene == roster.SCENE_WORKSHOP or
            scene == roster.SCENE_TRENCHES or scene == roster.SCENE_CITY or scene == roster.SCENE_ALLEY or scene == roster.SCENE_BANK do
        return PROP_CRATE
    else if scene == roster.SCENE_MIRRORS or scene == roster.SCENE_REACTOR or scene == roster.SCENE_LAB or
            scene == roster.SCENE_ALCHEMY or scene == roster.SCENE_FATE or scene == roster.SCENE_ABYSS or scene == roster.SCENE_QUARRY do
        return PROP_CRYSTAL
    else if scene == roster.SCENE_TOWN or scene == roster.SCENE_STUDIO or scene == roster.SCENE_CIRCUS or scene == roster.SCENE_TIDE do
        return PROP_LAMP
    end
    return PROP_PILLAR
end

# Which arts a level's book may hold, by how far in it is: simple ones early, Latin ones late.
function art_tier_allowed(int index) returns int
    if index < 6 do
        return 0
    else if index < 16 do
        return 1
    end
    return 2
end
# A random art not known yet, of a tier this level allows; -1 when there is none. A book is far
# likelier to hold the art whose home this level is (and that one may be of any tier).
function pick_book_art(int index, string owner, Dice d) returns int
    int[] choices = []
    double[] weights = []
    var total = 0.0
    for a in 0..<ART_NAMES.length do
        var home = ART_HOMES[a] == owner
        if not has(data.arts, a) and (ART_TIER[a] <= art_tier_allowed(index) or home) do
            choices.push(a)
            var w = 14.0 if home else 1.0
            weights.push(w)
            total += w
        end
    end
    if choices.length == 0 do
        return -1
    end
    var roll = d.next() * total
    for k, a in choices do
        roll -= weights[k]
        if roll <= 0 do
            return a
        end
    end
    return choices[choices.length - 1]
end
# The two stances a dojo teaches: not the one you know, and the level's own one far likelier.
function pick_dojo_stances(string owner, Dice d) returns int[]
    int[] out = []
    for pick in 0..<2 do
        double[] weights = []
        var total = 0.0
        for s in 0..<STANCE_NAMES.length do
            var w = 0.0
            if s != data.stance and not has(out, s) do
                w = 12.0 if STANCE_HOMES[s] == owner else (0.4 if s == 0 else 1.0)
            end
            weights.push(w)
            total += w
        end
        var roll = d.next() * total
        var chosen = -1
        for s in 0..<STANCE_NAMES.length do
            if chosen < 0 and weights[s] > 0 do
                roll -= weights[s]
                if roll <= 0 do
                    chosen = s
                end
            end
        end
        if chosen < 0 do
            for s in 0..<STANCE_NAMES.length do
                if chosen < 0 and weights[s] > 0 do
                    chosen = s
                end
            end
        end
        if chosen >= 0 do
            out.push(chosen)
        end
    end
    return out
end

function new_level(int w, int h) returns Level
    var lv = Level()
    lv.w = w
    lv.h = h
    for k in 0..<(w * h) do
        lv.cells.push(CELL_VOID)
        lv.reveal.push(0.0)
        lv.explored.push(false)
    end
    return lv
end

# The threshold: an open floor of brick in every direction, and nothing else (yet).
function threshold() returns Level
    var n = 64
    var lv = new_level(n, n)
    for k in 0..<(n * n) do
        lv.cells[k] = CELL_FLOOR
    end
    lv.spawn = cell_center(n // 2, n // 2)
    lv.floor_color = ap.Color(110, 84, 78)
    lv.wall_color = ap.Color(70, 60, 60)
    lv.glow = ap.Color(255, 230, 210)
    lv.mote = ap.Color(220, 210, 255)
    lv.ambient_lit = ap.Color(100, 92, 110)
    lv.sun = ap.Color(190, 180, 170)
    lv.sky = ap.Color(12, 10, 16)
    lv.name = "THE THRESHOLD"
    build_world(lv)
    return lv
end

# The colors of a fighter's place, for its level.
function paint_level(Level lv, roster.Character kit)
    var m = kit.maximum
    lv.floor_color = m.ground.lerp(m.floor, 0.3).lerp(ap.WHITE, 0.25)
    lv.wall_color = m.ground.lerp(ap.BLACK, 0.1)
    lv.glow = m.glow
    lv.mote = m.mote
    lv.ambient = m.ambient.lerp(ap.BLACK, 0.8)
    lv.ambient_lit = m.ambient.lerp(ap.WHITE, 0.25)
    lv.sun = m.sun
    lv.sky = m.sky
    lv.prop_kind = prop_style(m.scene)
    # Each kind of place in its own colors underfoot.
    if lv.style == STYLE_FOREST do
        lv.floor_color = lv.floor_color.lerp(ap.Color(92, 126, 70), 0.6)
        lv.wall_color = ap.Color(64, 84, 52).lerp(m.ground, 0.25)
        lv.prop_kind = PROP_TREE
        lv.ambient_lit = lv.ambient_lit.lerp(ap.Color(110, 130, 100), 0.4)
    else if lv.style == STYLE_CAVE do
        lv.floor_color = lv.floor_color.lerp(ap.Color(112, 100, 88), 0.5)
        lv.wall_color = lv.wall_color.lerp(ap.Color(86, 78, 72), 0.5)
        lv.prop_kind = PROP_ROCK if lv.prop_kind == PROP_PILLAR else lv.prop_kind
    else if lv.style == STYLE_STREETS do
        lv.floor_color = lv.floor_color.lerp(ap.Color(120, 116, 112), 0.5)
        lv.prop_kind = PROP_LAMP if lv.prop_kind == PROP_PILLAR else lv.prop_kind
    else if lv.style == STYLE_LAB do
        # Clean and cold: white tile, steel, the place's glow in the tanks and the warning lights.
        lv.floor_color = ap.Color(196, 202, 206).lerp(m.ground, 0.15)
        lv.wall_color = ap.Color(130, 138, 148).lerp(m.ground, 0.2)
        lv.prop_kind = PROP_TANK
        lv.ambient_lit = lv.ambient_lit.lerp(ap.Color(150, 165, 175), 0.5)
    else if lv.style == STYLE_MANOR do
        lv.floor_color = ap.Color(150, 100, 64).lerp(m.ground, 0.2)
        lv.wall_color = ap.Color(110, 50, 56).lerp(m.ground, 0.35)
        lv.prop_kind = PROP_CANDLES
        lv.ambient_lit = lv.ambient_lit.lerp(ap.Color(140, 110, 90), 0.4)
    else if lv.style == STYLE_TOY do
        lv.floor_color = ap.Color(236, 222, 228)
        lv.wall_color = ap.Color(230, 190, 120)
        lv.prop_kind = PROP_BLOCKS
        lv.ambient_lit = lv.ambient_lit.lerp(ap.Color(190, 170, 190), 0.6)
        lv.sky = lv.sky.lerp(ap.Color(60, 40, 70), 0.5)
    end
end

# A new, random layout every time (`seed` picks it).
function make_level(int index, roster.Character kit, int seed) returns Level
    var final_level = index == cast.length - 1 and cast.length > 1
    # The last level runs on, past its boss's hall, into the dark.
    var lv = new_level(MAP + 46 if final_level else MAP, MAP)
    lv.index = index
    lv.owner = kit.name
    lv.name = level_title(kit)
    lv.style = level_style(kit)
    lv.layout = level_layout(kit)
    lv.mode = LEVEL_FINAL if final_level else LEVEL_PLAIN
    paint_level(lv, kit)
    var d = Dice(seed % 2000000000 + 1)
    d.next()
    d.next()
    # The path: start, rooms, the boss's hall in the far corner. Open places have fewer, far
    # bigger spaces; tight ones many small rooms.
    var start = Room(2, 2, 6, 6, ROOM_START)
    var boss = Room(MAP - 14, MAP - 14, 11, 11, ROOM_BOSS)
    Room[] chain = [start]
    var count = 5 + d.range(0, 2) + math.min(index // 12, 2)
    var low = 5
    var high = 8
    if lv.layout == LAYOUT_OPEN do
        count = 3 + d.range(0, 1)
        low = 9
        high = 13
    else if lv.layout == LAYOUT_TIGHT do
        count = 8 + d.range(0, 2)
        low = 4
        high = 6
    end
    for i in 1..<(count + 1) do
        var t = double(i) / double(count + 1)
        var bend = (d.next() - 0.5) * (12.0 if lv.layout == LAYOUT_OPEN else 20.0)
        var cx = 5.0 + (double(MAP) - 14) * t + bend
        var cy = 5.0 + (double(MAP) - 14) * t - bend
        var rw = d.range(low, high)
        var rh = d.range(low, high)
        var x = int(math.clamp(cx - double(rw) / 2, 2.0, double(MAP - rw - 3)))
        var y = int(math.clamp(cy - double(rh) / 2, 2.0, double(MAP - rh - 3)))
        chain.push(Room(x, y, rw, rh, ROOM_PLAIN))
    end
    chain.push(boss)
    for r in chain do
        carve_room(lv, r, d)
    end
    for i in 0..<(chain.length - 1) do
        carve_corridor(lv, chain[i], chain[i + 1], d)
    end
    if lv.layout == LAYOUT_OPEN do
        # Open country: the spaces between the rooms worn open as well, here and there.
        for k in 0..<(3 + d.range(0, 2)) do
            var r = chain[1 + d.range(0, chain.length - 3)]
            var blob = Room(int(math.clamp(double(r.x + d.range(-4, 4)), 2.0, double(MAP - 14))), int(math.clamp(double(r.y + d.range(-4, 4)), 2.0, double(MAP - 14))), d.range(6, 10), d.range(6, 10), ROOM_PLAIN)
            if blob.x + blob.w < MAP - 15 or blob.y + blob.h < MAP - 15 do
                carve_room(lv, blob, d)
            end
        end
    end
    lv.rooms = chain
    lv.boss_room = chain.length - 1
    # Side rooms, by chance: treasure (one or two), a reading room with a cursed book, a dojo, a
    # shop, and the other places to spend souls. The longer since the last book or dojo, the
    # likelier the next.
    int[] kinds = [ROOM_TREASURE]
    if d.chance(0.5) do
        kinds.push(ROOM_TREASURE)
    end
    var book_art = pick_book_art(index, kit.name, d)
    if book_art >= 0 and d.chance(0.45 + 0.2 * double(data.since_book)) do
        kinds.push(ROOM_LIBRARY)
    end
    if index >= 1 and unowned_items().length > 0 and d.chance(0.3 + 0.15 * double(data.since_shop)) do
        kinds.push(ROOM_SHOP)
    end
    if index >= 1 and d.chance(0.2 + 0.15 * double(data.since_dojo)) do
        kinds.push(ROOM_DOJO)
    end
    if index >= 1 and d.chance(0.3) do
        kinds.push(ROOM_GAMBLER)
    end
    if index >= 2 and data.weapons.length > 0 and d.chance(0.25) do
        kinds.push(ROOM_FORGE)
    end
    if index >= 1 and d.chance(0.3) do
        kinds.push(ROOM_SHRINE)
    end
    # Shuffled, so which branch each hangs off is random too.
    for k in 0..<kinds.length do
        var j = d.range(0, kinds.length - 1)
        var t = kinds[k]
        kinds[k] = kinds[j]
        kinds[j] = t
    end
    for kind in kinds do
        var tries = 0
        while tries < 60 do
            tries += 1
            var from_room = chain[1 + d.range(0, chain.length - 3)]
            var rw = d.range(4, 6)
            var rh = d.range(4, 6)
            var side = d.range(0, 3)
            var x = from_room.x + (from_room.w + 3 if side == 0 else -(rw + 3) if side == 1 else d.range(-2, 2))
            var y = from_room.y + (from_room.h + 3 if side == 2 else -(rh + 3) if side == 3 else d.range(-2, 2))
            if x < 2 or y < 2 or x + rw > MAP - 2 or y + rh > MAP - 2 do
                continue
            end
            var clear = true
            for yy in (y - 1)..<(y + rh + 1) do
                for xx in (x - 1)..<(x + rw + 1) do
                    if cell_at(lv, xx, yy) != CELL_VOID do
                        clear = false
                    end
                end
            end
            if not clear do
                continue
            end
            var r = Room(x, y, rw, rh, kind)
            carve_room(lv, r, d)
            carve_corridor(lv, from_room, r, d)
            lv.rooms.push(r)
            break
        end
    end
    # The boss's hall is sealed at its doors once you are in: find the corridor cells that
    # touch its edge from outside.
    find_boss_doors(lv)
    walls_around(lv, 2 if lv.style == STYLE_FOREST or lv.style == STYLE_CAVE else 1)
    if kit.name == "HUNTER" do
        walls_around(lv, 3)
    end
    if final_level do
        # Beyond the hall's east wall, the dark: nothing to see, nothing on the map.
        lv.dark_x = boss.x + boss.w + 3
        lv.death_at = cell_center(lv.w - 6, boss.y + boss.h // 2)
    end
    lv.spawn = start.center()
    furnish(lv, d, index)
    for r in lv.rooms do
        if r.kind == ROOM_LIBRARY do
            lv.books.push(Book(book_art, r.center()))
        end
    end
    build_world(lv)
    return lv
end

function find_boss_doors(Level lv)
    lv.boss_doors = []
    var boss = lv.rooms[lv.boss_room]
    for y in (boss.y - 1)..<(boss.y + boss.h + 1) do
        for x in (boss.x - 1)..<(boss.x + boss.w + 1) do
            var inside = x >= boss.x and x < boss.x + boss.w and y >= boss.y and y < boss.y + boss.h
            if not inside and cell_at(lv, x, y) == CELL_FLOOR do
                lv.boss_doors.push(y * lv.w + x)
            end
        end
    end
end

# A chest's loot, by how far in it is and the difficulty (HELL is stingy early on).
function fill_chest(Chest c, int index, Dice d, double rich)
    c.souls = int(double(6 + d.range(0, 10 + index * 2)) * rich)
    var weapon_chance = 0.3
    if data.difficulty == DIFF_HELL and index < 15 do
        c.souls = int(double(c.souls) * (0.35 + 0.04 * double(index)))
        weapon_chance = 0.1
    end
    if d.chance(0.12) do
        c.souls *= 3
        c.tier = 1
    end
    if d.chance(weapon_chance * rich) do
        c.weapon = 1 + d.range(0, WEAPON_NAMES.length - 2)
        if has(data.weapons, c.weapon) and d.chance(0.7) do
            c.weapon = 1 + d.range(0, WEAPON_NAMES.length - 2)
        end
        c.tier = 2
    end
    if c.souls > 40 + index * 3 and c.tier < 1 do
        c.tier = 1
    end
end

# Furniture, chests, the book's lamps, the dojo, the shop and the soul spots.
function furnish(Level lv, Dice d, int index)
    var chest_id = 0
    for r in lv.rooms do
        if r.kind == ROOM_PLAIN or r.kind == ROOM_BOSS do
            var props = 2 + d.range(0, 3) + (4 if r.kind == ROOM_BOSS else 0)
            if lv.layout == LAYOUT_OPEN and r.kind == ROOM_PLAIN do
                props += 3
            end
            for k in 0..<props do
                var at = ap.Vec3((double(r.x) + 1 + d.next() * double(r.w - 2)) * TILE, 0,
                    (double(r.y) + 1 + d.next() * double(r.h - 2)) * TILE)
                if r.kind == ROOM_BOSS do
                    # Around the edge of the hall, leaving the middle for the fight.
                    var a = double(k) / double(props) * 2 * math.PI
                    at = r.center() + ap.Vec3(math.sin(a), 0, math.cos(a)) * (double(r.w) * TILE * 0.42)
                end
                var kind = lv.prop_kind if d.chance(0.75) else PROP_LAMP
                if lv.style == STYLE_FOREST do
                    kind = [PROP_TREE, PROP_ROCK, PROP_BUSH, PROP_BUSH][d.range(0, 3)]
                else if lv.style == STYLE_CAVE and d.chance(0.5) do
                    kind = PROP_ROCK
                else if lv.style == STYLE_LAB and d.chance(0.4) do
                    kind = PROP_CRATE
                else if lv.style == STYLE_MANOR and d.chance(0.35) do
                    kind = PROP_PILLAR
                else if lv.style == STYLE_TOY do
                    kind = [PROP_BLOCKS, PROP_BLOCKS, PROP_YARN, PROP_LAMP][d.range(0, 3)]
                end
                var spot = cell_of(at)
                if cell_at(lv, spot[0], spot[1]) == CELL_FLOOR and open_around(lv, at, 1) do
                    lv.props.push(Prop(kind, at, 0.8 + d.next() * 0.6, d.next() * 360))
                end
            end
        else if r.kind == ROOM_TREASURE do
            for k in 0..<(1 + d.range(0, 1)) do
                var c = Chest(chest_id, r.center() + ap.Vec3((double(k) - 0.5) * 2.4, 0, 0), d.next() * 360)
                fill_chest(c, index, d, 1.0)
                lv.chests.push(c)
                chest_id += 1
            end
            lv.props.push(Prop(PROP_LAMP, r.center() + ap.Vec3(0, 0, double(r.h) * 0.7), 1, 0))
        else if r.kind == ROOM_LIBRARY do
            for k in 0..<4 do
                var a = double(k) * math.PI / 2 + 0.6
                lv.props.push(Prop(PROP_LAMP, r.center() + ap.Vec3(math.sin(a), 0, math.cos(a)) * 2.6, 0.7, 0))
            end
        else if r.kind == ROOM_SHOP do
            lv.has_shop = true
            lv.shop = r.center()
            # What it sells, picked at random from what you do not own (HELL's early shops are thin).
            var pool = unowned_items()
            var wares = 3 if data.difficulty == DIFF_HELL and index < 10 else 4
            for k in 0..<math.min(wares, pool.length) do
                var j = d.range(0, pool.length - 1)
                lv.stock.push(pool[j])
                int[] rest = []
                for q, v in pool do
                    if q != j do
                        rest.push(v)
                    end
                end
                pool = rest
            end
            lv.props.push(Prop(PROP_LAMP, r.center() + ap.Vec3(2.2, 0, 1.6), 0.8, 0))
        else if r.kind == ROOM_DOJO do
            lv.has_dojo = true
            lv.dojo = r.center()
            lv.dojo_stances = pick_dojo_stances(lv.owner, d)
        else if r.kind == ROOM_GAMBLER or r.kind == ROOM_FORGE or r.kind == ROOM_SHRINE do
            var sp = Spot(r.kind, r.center())
            if r.kind == ROOM_SHRINE do
                sp.offer = pick_pacts(d)
            end
            lv.spots.push(sp)
            lv.props.push(Prop(PROP_LAMP, r.center() + ap.Vec3(-2.0, 0, 1.4), 0.8, 0))
        end
    end
end

# Whether a spot has room to stand: floor all round it (no wall within `margin` cells).
function open_around(Level lv, ap.Vec3 at, int margin) returns bool
    var c = cell_of(at)
    for dy in -margin..<(margin + 1) do
        for dx in -margin..<(margin + 1) do
            var k = cell_at(lv, c[0] + dx, c[1] + dy)
            if k != CELL_FLOOR and k != CELL_DARK do
                return false
            end
        end
    end
    return true
end

# The strange hall after every fifth level: a small room, and through it one great hall.
function make_intermission(int index) returns Level
    var lv = new_level(MAP, MAP)
    lv.index = index
    lv.owner = cast[index].name
    lv.name = "INTERMISSION"
    lv.style = STYLE_HALLS
    lv.mode = LEVEL_INTERMISSION
    lv.floor_color = ap.Color(200, 196, 210)
    lv.wall_color = ap.Color(36, 30, 44)
    lv.glow = ap.Color(255, 60, 90)
    lv.mote = ap.Color(255, 200, 220)
    lv.ambient = ap.Color(10, 6, 12)
    lv.ambient_lit = ap.Color(120, 100, 130)
    lv.sun = ap.Color(220, 180, 210)
    lv.sky = ap.Color(20, 4, 14)
    lv.prop_kind = PROP_PILLAR
    var d = Dice(int(ap.random(1, 1999999)))
    d.next()
    var start = Room(3, 18, 6, 6, ROOM_START)
    var hall = Room(12, 7, 29, 29, ROOM_BOSS)
    lv.rooms = [start, hall]
    lv.boss_room = 1
    carve_room(lv, start, d)
    carve_room(lv, hall, d)
    carve_corridor(lv, start, hall, d)
    find_boss_doors(lv)
    walls_around(lv, 1)
    lv.spawn = start.center()
    # A ring of pillars, a ring of lamps.
    for k in 0..<10 do
        var a = double(k) / 10 * 2 * math.PI
        lv.props.push(Prop(PROP_PILLAR, hall.center() + ap.Vec3(math.sin(a), 0, math.cos(a)) * 21, 1.3, 0))
        lv.props.push(Prop(PROP_LAMP, hall.center() + ap.Vec3(math.sin(a + 0.3), 0, math.cos(a + 0.3)) * 17, 1.0, 0))
    end
    # Three of the last five bosses, all different, in a random order.
    int[] pool = []
    for k in math.max(0, index - 4)..<(index + 1) do
        pool.push(k)
    end
    while lv.queue.length < 3 and pool.length > 0 do
        var j = d.range(0, pool.length - 1)
        lv.queue.push(pool[j])
        int[] rest = []
        for q, v in pool do
            if q != j do
                rest.push(v)
            end
        end
        pool = rest
    end
    build_world(lv)
    return lv
end

# Every empty cell next to floor becomes wall.
# Every empty cell next to floor (and, `thickness` over 1, next to that) becomes wall: a band of
# trees or rock rather than a single line of brick.
function walls_around(Level lv, int thickness = 1)
    for pass in 0..<thickness do
        int[] to_wall = []
        for y in 0..<lv.h do
            for x in 0..<lv.w do
                if cell_at(lv, x, y) == CELL_VOID do
                    var near = false
                    for dy in -1..<2 do
                        for dx in -1..<2 do
                            var c = cell_at(lv, x + dx, y + dy)
                            if c == CELL_FLOOR or (pass > 0 and c == CELL_WALL) do
                                near = true
                            end
                        end
                    end
                    if near do
                        to_wall.push(y * lv.w + x)
                    end
                end
            end
        end
        for k in to_wall do
            lv.cells[k] = CELL_WALL
        end
    end
end

function build_world(Level lv)
    var w = ap.World()
    w.add_box(ap.Vec3(-20, -2, -20), ap.Vec3(double(lv.w) * TILE + 20, 0, double(lv.h) * TILE + 20))
    for y in 0..<lv.h do
        var x = 0
        while x < lv.w do
            if cell_at(lv, x, y) == CELL_WALL do
                var run = x
                while run < lv.w and cell_at(lv, run, y) == CELL_WALL do
                    run += 1
                end
                w.add_box(ap.Vec3(double(x) * TILE, 0, double(y) * TILE), ap.Vec3(double(run) * TILE, 4, double(y + 1) * TILE))
                x = run
            else do
                x += 1
            end
        end
    end
    # The edge of the map holds whatever is open (the threshold has no walls).
    var far_x = double(lv.w) * TILE
    var far_z = double(lv.h) * TILE
    w.add_box(ap.Vec3(-2, 0, -2), ap.Vec3(far_x + 2, 4, 0))
    w.add_box(ap.Vec3(-2, 0, far_z), ap.Vec3(far_x + 2, 4, far_z + 2))
    w.add_box(ap.Vec3(-2, 0, 0), ap.Vec3(0, 4, far_z))
    w.add_box(ap.Vec3(far_x, 0, 0), ap.Vec3(far_x + 2, 4, far_z))
    for pr in lv.props do
        if pr.kind != PROP_LAMP and pr.kind != PROP_CRATER do
            var half = 0.45 * pr.size
            w.add_box(pr.at - ap.Vec3(half, 0, half), pr.at + ap.Vec3(half, 2.5 if pr.life > 0 else 2.0, half))
        end
    end
    lv.world = w
end

# Shuts the boss's hall behind Scarf.
function seal_boss(Level lv)
    for k in lv.boss_doors do
        lv.cells[k] = CELL_WALL
        lv.reveal[k] = 1
    end
    build_world(lv)
end

# --- Who is in it ------------------------------------------------------------------------------

const int A_PLAYER = 0
const int A_ZOMBIE = 1               # slow, hits fairly hard
const int A_SKELETON = 2             # quicker, brittle
const int A_ARCHER = 3               # a skeleton with a crossbow: keeps its distance
const int A_WRAITH = 4               # drifts, throws cold fire
const int A_GHOUL = 5                # fast and weak, in packs
const int A_BOSS = 6
const int A_DECOY = 7                # a boss's mirror copy: hits like it, breaks in a blow or two
const string[] KIND_NAMES = ["SCARF", "ZOMBIE", "SKELETON", "SKELETON ARCHER", "WRAITH", "GHOUL", "BOSS", "COPY"]

# What a boss is there for.
const int ROLE_MAIN = 0              # the level's own
const int ROLE_REVENGE = 1           # an old one, back for revenge: fast, half health
const int ROLE_GAUNTLET = 2          # one of every boss, at the very end, with little health
const int ROLE_SATAN = 3             # HELL's last

const int S_IDLE = 0
const int S_ATTACK = 1
const int S_HURT = 2
const int S_DEAD = 3
const int S_BLOCK = 4
const int S_DASH = 5
const int S_FOCUS = 6
const int S_KNEEL = 7                # a beaten boss, on its knees (it may rise again)

const int FOCUS_TREASURE = 0
const int FOCUS_COMBAT = 1
const int FOCUS_DEATH = 2
const int FOCUS_STAMINA = 3
const int FOCUS_MANA = 4
const int FOCUS_RECOVER = 5          # EASY: stamina and mana focus in one
const int FOCUS_EXTRACT = 6          # souls drawn out of yourself, paid for in health
const string[] FOCUS_NAMES = ["TREASURE FOCUS", "COMBAT FOCUS", "DEATH FOCUS", "STAMINA FOCUS", "MANA FOCUS", "RECOVERY FOCUS", "SOULS FOCUS"]
const int[] FOCUS_PRICE = [20, 20, 20, 20, 20, 20, 0]  # % of your souls each reflex costs (rounded up); Satan's DEATH FOCUS is free
const int BANDAGE_SOULS = 20                    # % of your souls
function soul_cost(int percent) returns int
    return (data.souls * percent + 99) // 100
end
const double BLOCK_SHOVE = 22                 # a blocked boss is knocked back this hard (about 2.3 m)
const int EXTRACT_EVERY = 20                  # SOULS FOCUS: ticks between pulls
const double EXTRACT_HP = 0.04                # health each pull costs, as a share of the most you can have
const int EXTRACT_SOULS = 4                   # souls each pull gives (+1 every third level)
const double EXTRACT_FLOOR = 0.15             # it stops before your health would drop under this share
const double BANDAGE_HEAL = 0.5      # EASY's bandage: this share of your health, once a level

class Actor
    int kind = A_PLAYER
    roster.Look look = roster.Look()
    ap.Body body = ap.Body(ap.Vec3(0, 0, 0))
    double heading = 0
    double hp = 100
    double hp_max = 100
    double speed = 4.6
    double power = 1                 # damage dealt is multiplied by this
    int state = S_IDLE
    int frame = 0
    roster.Attack act = roster.Attack("")
    Move skill = Move("")            # the player's move being done (name "" for a basic attack)
    int stun = 0
    int stun_total = 1
    double cycle = 0
    double moving = 0
    puppet.Pose pose = puppet.Pose()
    puppet.Pose pose_speed = puppet.Pose()
    bool aware = false
    int unseen = 0                   # ticks it has not seen the player while aware
    int think = 30
    int cool = 0                     # ticks before an enemy can attack again
    double burn = 0                  # seconds of each
    double freeze = 0
    double poison = 0
    double flash = 0
    int block_ticks = 0
    int chain = 0                    # where in the basic chain
    int chain_wait = 0               # ticks the next link may still follow
    ap.Vec3 knock = ap.Vec3(0, 0, 0)
    double lift = 0                  # thrown into the air: meters up...
    double lift_speed = 0            # ...and how fast it is going
    int dash_ticks = 0
    ap.Vec3 dash_way = ap.Vec3(0, 0, 0)
    double fade = 1
    int iframes = 0
    int struck_beat = -1
    int last_step = 0                # which half of the walk cycle the last footstep was
    int boss_index = -1
    double tempo_left = 0            # a slow boss's attacks advance only some ticks
    int super_state = 0              # a boss's super: 0 not yet, 1 on, 2 over
    int super_ticks = 0
    bool ult_used = false            # its ultimate, once during the super
    double strike_left = 0           # seconds to the super's next strike from the sky
    roster.Attack[] basics = []
    roster.Attack[] skills = []
    int[] skill_cool = []
    int sight = 0                    # how long an enemy has been looking (noticing takes a moment)
    ap.Vec3 home = ap.Vec3(0, 0, 0)
    ap.Vec3 wander = ap.Vec3(0, 0, 0)
    double armor_time = 0
    double guard_time = 0
    int focus = -1
    int focus_ticks = 0
    double damage_taken = 1
    bool hovering = false
    int role = ROLE_MAIN
    double tempo = 1                 # a boss's attacks advance this many ticks a tick (below 1: slower)
    bool true_form = false           # risen again after a Death Focus: red, and far stronger
    double buff_time = 0             # a boss's buff: faster, and takes far less
    double cloak_time = 0            # a boss unseen
    double sunder = 0                # seconds it takes 40% more from everything
    int super_cast = 0               # ticks left of a boss's super coming on (untouchable)
    int src = SRC_BASIC              # where the move being done came from
    int portal_cool = 0
    int shot_gap = 0                 # ticks before this boss may use a ranged attack again
    int summon_cool = 0
    bool may_attack = true           # the gauntlet: only the nearest few close in at once
    bool ulting = false              # a boss in its ultimate (untouchable as it winds up)
    double rise = 0                  # Satan coming up out of the floor
end

class Bolt
    ap.Vec3 at
    ap.Vec3 vel
    bool mine = false                # fired by Scarf
    int src = SRC_BASIC
    bool ricochet = false            # a Ricochet Shot...
    int hops = 0                     # ...and how many enemies it has hopped to
    double poison = 0                # what a boss's shot leaves on Scarf
    double slow = 0
    bool mine_wait = false           # lies still until Scarf comes near (a boss's mine)
    double damage = 5
    double life = 2
    ap.Color color = ap.WHITE
    double size = 0.12
    int fx = FX_NONE
    double fx_time = 0
    int bounces = 0                  # enemies it can still leap on to (Ricochet Shot)
    double blast = 0
    double homing = 0
    bool knife = false
    bool pierce = false              # goes on through enemies (Charged Shot)...
    Actor[] pierced = []             # ...each of them once
    int stun = 10
end

class Mote
    ap.Vec3 at
    ap.Vec3 vel
    ap.Color color
    double life
    double span
    double size
    double gravity = 0
end

class Streak
    ap.Vec3 from
    ap.Vec3 to
    ap.Color color
    double life
    double span
    double width = 0.08
end

class Floater
    ap.Vec3 at
    string words
    ap.Color color
    double life = 1
    ap.Vec2 screen = ap.Vec2(-100, -100)
end

class Soul
    ap.Vec3 at
    ap.Vec3 vel
    int value = 1
    double age = 0
end

class Pickup
    ap.Vec3 at
    int weapon = 0
    bool taken = false
    double appear = 0
end

