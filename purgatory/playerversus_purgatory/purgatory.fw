const double[] DIFF_ENEMY_HEALTH = [0.8, 1.0, 1.25, 1.5]
# What the Soul Merchant asks, of the list price (NORMAL is twice what it once was).
const double[] DIFF_PRICES = [1.5, 2.0, 2.6, 3.2]

# How bosses fight on each difficulty. HARD is what the first bosses were tuned to (the Arena's
# NORMAL CPU at full speed); NORMAL and EASY think with the Arena's EASY CPU, move and wind up much
# slower, hit softer, stun for less and have less health.
const int[] BOSS_CPU = [0, 0, 1, 2]               # which of the Arena CPU levels it thinks like
const double[] BOSS_TEMPO = [0.55, 0.75, 1.0, 1.0]   # how fast its attacks play out
# Its walking speed, of the fighter's own. HELL's are slow on their feet (well under Scarf's 4.8
# m/s), so dashing away and kiting them works; they make up for it in health and damage.
const double[] BOSS_SPEED = [0.55, 0.75, 0.92, 0.62]
const double[] BOSS_REACH = [1.0, 1.0, 1.0, 0.75]    # how far its blows and lunges reach
const double[] BOSS_SIGHT = [16.0, 16.0, 16.0, 11.0] # how far off it will shoot
const double[] BOSS_THINK = [2.0, 1.35, 1.0, 0.8]    # the pauses between its actions, stretched
const double[] BOSS_POWER = [0.5, 0.7, 0.9, 1.1]     # its damage
const double[] BOSS_STUN = [0.45, 0.65, 1.0, 1.1]    # how long its hits leave Scarf staggered
const int[] BOSS_SHOT_GAP = [330, 270, 210, 180]   # every boss's ticks between ranged attacks
const double[] BOSS_HEALTH = [1.05, 1.8, 2.4, 1.5]    # of the fighter's Arena health (NORMAL: twice what it was)
const double[] BOSS_ULT_CAP = [0.3, 0.4, 0.55, 0.65] # the most of Scarf's health its ultimate can take
const double[] BOSS_SKILL_RATE = [0.35, 0.55, 0.65, 0.75]  # how often it reaches for a skill (its gimmicks) over a basic
var unblockable_hit = false          # the hit being dealt goes through a block (a boss's ultimate)
# How far a fighter's blows carry: a boss's are cut short on HELL.
function reach_of(Actor a) returns double
    return BOSS_REACH[data.difficulty] if a.kind == A_BOSS else 1.0
end
function boss_cpu(int difficulty) returns int
    return BOSS_CPU[difficulty]
end

