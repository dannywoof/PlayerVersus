function multi(roster.Attack a, int hits, int interval) returns roster.Attack
    a.hits = hits
    a.interval = interval
    return a
end

# Arts: magic, from the cursed books. Each hits harder the fuller your mana is when it is cast
# (80% at empty, 130% at full). A red book's art (a boss's own move) is numbered 100 + its level.
const string[] ART_NAMES = ["FIRE BOLT", "FROST NOVA", "LASER", "CHAIN LIGHTNING", "SOUL DRAIN", "SHADOW STEP", "EARTH SPIKE",
    "VENOM MIST", "METEOR", "WAR CRY", "GRAVE HANDS", "BLOOD RITE", "HEX", "SOUL LANCE"]
const string[] ART_BOOKS = ["THE BOOK OF CINDERS", "THE WINTER CODEX", "THE NEEDLE OF LIGHT", "STORM LITANY",
    "THE HUNGRY PSALTER", "NOTES FROM NOWHERE", "THE STONE TONGUE", "THE GREEN GOSPEL", "THE FALLING SKY",
    "THE DRUM OF WAR", "THE BURIAL HYMN", "THE RED LEDGER", "THE EVIL EYE", "THE HOLLOW SPEAR"]
# How hard each art is to learn: 0 simple (a short line in English), 1 middling (short Latin),
# 2 powerful (a long Latin passage). Later levels hold the harder books.
const int[] ART_TIER = [0, 1, 2, 2, 2, 0, 1, 1, 2, 0, 1, 0, 2, 2]
# The fighter whose level hides each book far more often.
const string[] ART_HOMES = ["MOTH", "PHANTOM", "LASER", "CONDUCTOR", "FANGS", "SHEPHERD", "CARBON", "ANACONDA",
    "DON", "COMBATANT", "UNDERTAKER", "DEATH", "ORACLE", "HOLLOW"]
const string[] TIER_NAMES = ["SIMPLE", "MIDDLING", "POWERFUL"]
# What has to be copied out, letter by letter, to learn each art.
const string[] ART_TEXTS = ["fire, answer me",
    "frigus, veni et tene eos",
    "lux una, acuta ut acus, per tenebras et per carnem transit; nihil eam sistere potest, neque murus neque scutum",
    "fulgur de caelo cadit et ab hoste ad hostem salit, nec quiescit donec omnes cadant",
    "animam tuam bibo, et quod tuum erat nunc meum est; vires tuae in me fluunt",
    "the dark will carry me",
    "terra, surge contra hostes meos",
    "venenum, surge et bibe eos",
    "saxum de caelo, cade super caput eius, et terra sub pedibus eius tremat donec nihil maneat",
    "my blood runs loud",
    "mortui, tenete pedes eorum",
    "take my blood, give me breath",
    "oculus malus te videt, et omnia vulnera tua aperit; quidquid te tangit, te plus laedit",
    "anima mea hasta est, et quanto plus habeo, tanto altius in te descendit; nihil retineo"]
# What one attempt at a book costs, as a share of your health (the knowledge burns).
const double[] TIER_COST = [0.08, 0.14, 0.22]
const int CHANCES = 3
const int RED_ART = 100

function art_name(int art) returns string
    if art >= RED_ART do
        var k = art - RED_ART
        if k < cast.length do
            return "{cast[k].name}'S {boss_art_attack(k).name.upper()}"
        end
        return "A RED ART"
    end
    return ART_NAMES[art]
end

# The move of a boss's arsenal its red book teaches: its ultimate if that is an attack, else its
# hardest-hitting skill.
function boss_art_attack(int boss) returns roster.Attack
    var kit = cast[boss]
    if kit.ultimate.damage > 0 and kit.ultimate.kind == roster.KIND_STRIKE do
        return kit.ultimate
    end
    var best = roster.Attack("Strike")
    best.damage = 0
    for a in kit.skills do
        if a.kind == roster.KIND_STRIKE and a.damage > best.damage do
            best = a
        end
    end
    if best.damage <= 0 and kit.basics.length > 0 do
        best = kit.basics[kit.basics.length - 1]
    end
    return best
end

function art_move(int art) returns Move
    return sourced(art_move_raw(art), SRC_ART)
end

function art_move_raw(int art) returns Move
    if art >= RED_ART do
        var k = art - RED_ART
        var src = boss_art_attack(k)
        var a = roster.Attack(src.name)
        a.damage = math.max(src.damage, 14.0) * 0.9
        a.startup = math.min(src.startup, 22)
        a.recovery = math.min(src.recovery, 22)
        a.reach = src.reach
        a.arc = src.arc
        a.lunge = math.min(src.lunge, 5.0)
        a.stun = src.stun
        a.push = src.push
        a.launch = src.launch
        a.radial = src.radial
        a.hits = src.hits
        a.interval = src.interval
        a.anim = src.anim
        a.beam = src.beam
        a.blast = src.blast
        a.shot = src.shot
        a.shot_speed = math.max(src.shot_speed, 16.0)
        a.volley = src.volley
        a.spread = src.spread
        a.homing = src.homing
        a.poison = src.poison
        if a.shot == roster.SHOT_NONE and a.beam <= 0 and a.reach < 1.5 do
            a.reach = 2.2
        end
        var c = cast[k].look.accent
        return with_fx(move(art_name(art).lower(), "{cast[k].name}'s own move, from their red book", a, 0, 34, 420), FX_BOSS, 0, c)
    end
    if art == 0 do
        var a = shot("Fire Bolt", 12, 12, 16, 16, roster.ANIM_CAST)
        a.shot = roster.SHOT_EMBER
        return with_fx(move("Fire Bolt", "A bolt of fire that sets them burning", a, 0, 16, 40), FX_BURN, 4, ap.Color(255, 140, 50))
    else if art == 1 do
        var a = strike("Frost Nova", 10, 14, 20, 4.0, 360, 0, 18, 3, roster.ANIM_FOCUS)
        a.radial = true
        return with_fx(move("Frost Nova", "Freezes everything around you", a, 0, 26, 150), FX_FREEZE, 3, ap.Color(150, 220, 255))
    else if art == 2 do
        var a = shot("Laser", 20, 18, 18, 0, roster.ANIM_CAST)
        a.beam = 14
        return with_fx(move("Laser", "A ray through every enemy in a line", a, 0, 30, 120), FX_NONE, 0, ap.Color(255, 80, 110))
    else if art == 3 do
        var a = shot("Chain Lightning", 11, 10, 16, 0, roster.ANIM_CAST)
        a.beam = 9
        return with_fx(move("Chain Lightning", "Leaps from one enemy to the next", a, 0, 24, 90), FX_CHAIN, 0, ap.Color(190, 190, 255))
    else if art == 4 do
        var a = shot("Soul Drain", 14, 14, 18, 0, roster.ANIM_CAST)
        a.beam = 6
        return with_fx(move("Soul Drain", "Drinks their health", a, 0, 22, 120), FX_DRAIN, 0, ap.Color(200, 90, 255))
    else if art == 5 do
        return with_fx(move("Shadow Step", "Steps five meters through the dark", strike("Shadow Step", 0, 4, 10, 0, 0, 0, 0, 0, roster.ANIM_CHARGE), 0, 10, 60), FX_BLINK, 0, ap.Color(120, 100, 160))
    else if art == 7 do
        var a = strike("Venom Mist", 6, 14, 20, 3.6, 360, 0, 12, 1, roster.ANIM_CAST)
        a.radial = true
        return with_fx(move("Venom Mist", "Poisons all round; for 8s every poison burns 2.5x", a, 0, 24, 200), FX_VENOM, 6, ap.Color(140, 230, 90))
    else if art == 8 do
        var a = shot("Meteor", 30, 20, 20, 0, roster.ANIM_CAST)
        a.blast = 2.8
        return with_fx(move("Meteor", "A stone falls on them from the sky", a, 0, 34, 240), FX_METEOR, 0, ap.Color(255, 150, 80))
    else if art == 9 do
        return with_fx(move("War Cry", "8s: stance moves hit 40% harder and cost a third less", strike("War Cry", 0, 14, 12, 0, 0, 0, 0, 0, roster.ANIM_FOCUS), 0, 18, 720), FX_WARCRY, 8, ap.Color(255, 110, 80))
    else if art == 10 do
        var a = strike("Grave Hands", 9, 16, 18, 6.0, 70, 0, 20, 0, roster.ANIM_SLAM)
        return with_fx(move("Grave Hands", "Hands from below hold them still for 3s", a, 0, 22, 160), FX_FREEZE, 3, ap.Color(170, 200, 160))
    else if art == 11 do
        return with_fx(move("Blood Rite", "Spends 12% health: stamina full, mana +40", strike("Blood Rite", 0, 12, 12, 0, 0, 0, 0, 0, roster.ANIM_FOCUS), 0, 0, 600), FX_RITE, 0, ap.Color(220, 40, 50))
    else if art == 12 do
        var a = shot("Hex", 6, 12, 16, 0, roster.ANIM_CAST)
        a.beam = 12
        return with_fx(move("Hex", "Marks them: +40% from everything for 8s", a, 0, 20, 200), FX_SUNDER, 8, ap.Color(200, 60, 200))
    else if art == 13 do
        var a = shot("Soul Lance", 10, 22, 20, 0, roster.ANIM_THRUST)
        a.beam = 16
        return with_fx(move("Soul Lance", "Spends all your mana: each point is more damage", a, 0, 20, 300), FX_LANCE, 0, ap.Color(170, 220, 255))
    end
    var a = strike("Earth Spike", 16, 16, 20, 7.0, 40, 0, 26, 2, roster.ANIM_SLAM)
    a.launch = 8
    return with_fx(move("Earth Spike", "Stone bursts up under them", a, 0, 22, 100), FX_NONE, 0, ap.Color(190, 150, 100))
end

# Weapons: the basic attack (R) and four armament skills. The gun's skills cost no stamina
# (shooting is not hard work) but take rounds and have long cooldowns.
const int ARMS_FISTS = -1
const string[] WEAPON_NAMES = ["THE GUN", "RUSTED KNIFE", "GRAVE CUTLASS", "IRON STAFF", "BONE SAW"]
const int[] WEAPON_LOOKS = [roster.WEAPON_GUN, roster.WEAPON_DAGGER, roster.WEAPON_CUTLASS, roster.WEAPON_BO, roster.WEAPON_SAW]
const string[] WEAPON_NOTES = ["Ranged. Six rounds; a quick reload when empty (dash, block or a move cancels it). +50% to frozen enemies.",
    "Fast, short-range melee. One skill throws the knife. +50% to burning enemies.",
    "Medium-speed melee with a wide arc and a lunge. +40% to sundered or hexed enemies.",
    "Long-reach melee; its skills hit everything around you. Every hit gives 3 mana.",
    "Slow, heavy melee. Its skills poison and heal you. +50% to poisoned enemies."]
const int RELOAD_TICKS = 65

function weapon_basic(int weapon) returns roster.Attack
    if weapon == 0 do
        var a = shot("Shoot", 7, 5, 12, 34, roster.ANIM_SHOOT)
        return a
    else if weapon == 1 do
        return strike("Slash", 6, 5, 10, 1.8, 100, 0.4, 10, 1, roster.ANIM_SWING)
    else if weapon == 2 do
        return strike("Cut", 9, 8, 14, 2.2, 120, 0.5, 14, 2, roster.ANIM_SWING)
    else if weapon == 3 do
        return strike("Strike", 8, 9, 14, 2.7, 140, 0.3, 14, 3, roster.ANIM_SWING)
    else if weapon == 4 do
        return strike("Saw", 11, 12, 18, 2.0, 100, 0.4, 16, 2, roster.ANIM_SLAM)
    end
    return strike("Punch", 5, 5, 10, 1.6, 80, 0.3, 10, 1, roster.ANIM_PUNCH)
end

function weapon_moves(int weapon) returns Move[]
    Move[] out = []
    for m in weapon_moves_raw(weapon) do
        out.push(sourced(m, SRC_ARMS))
    end
    out.push(sourced(weapon_extra(weapon), SRC_ARMS))
    return out
end

# Each weapon's fourth skill.
function weapon_extra(int weapon) returns Move
    var gold = ap.Color(255, 210, 120)
    if weapon == 0 do
        return move("Pistol Whip", "The gun's grip across their face. No rounds", strike("Pistol Whip", 10, 8, 16, 1.7, 100, 0.5, 28, 5, roster.ANIM_SWING), 10, 0, 70)
    else if weapon == 1 do
        return with_fx(move("Cut Throat", "Steps behind them and stabs", strike("Cut Throat", 16, 8, 16, 1.8, 80, 0.2, 24, 2, roster.ANIM_THRUST), 14, 0, 110), FX_BEHIND, 0, gold)
    else if weapon == 2 do
        return with_fx(move("Riposte", "Guards a moment, then cuts back hard", strike("Riposte", 18, 26, 16, 2.3, 110, 0.6, 30, 5, roster.ANIM_COUNTER), 14, 0, 110), FX_GUARD, 0.5, gold)
    else if weapon == 3 do
        return move("Hundred Thrusts", "Five long jabs of the staff", multi(strike("Hundred Thrusts", 5, 8, 16, 3.0, 50, 0.4, 10, 2, roster.ANIM_THRUST), 5, 6), 16, 0, 100)
    else if weapon == 4 do
        return with_fx(move("Grind", "Holds the saw on them: six bites that sunder", multi(strike("Grind", 4, 12, 18, 1.9, 90, 0.3, 12, 0, roster.ANIM_SLAM), 6, 6), 20, 0, 140), FX_SUNDER, 5, ap.Color(200, 40, 40))
    end
    var grapple = strike("Grapple Throw", 12, 10, 20, 1.5, 70, 0.3, 30, 4, roster.ANIM_BITE)
    grapple.launch = 6
    return move("Grapple Throw", "Grabs them and hurls them up", grapple, 12, 0, 90)
end

function weapon_moves_raw(int weapon) returns Move[]
    var gold = ap.Color(255, 210, 120)
    if weapon == 0 do
        var charged = shot("Charged Shot", 15, 30, 18, 46, roster.ANIM_SHOOT)
        charged.blast = 1.5
        var fan = shot("Fan the Hammer", 6, 6, 18, 32, roster.ANIM_SHOOT)
        fan.hits = 6
        fan.interval = 4
        fan.volley = 1
        fan.spread = 16
        var ricochet = with_fx(move("Ricochet Shot", "Hops to 2 more enemies, harder each hop. No enemy to hop to (or a wall): it comes back at you", shot("Ricochet Shot", 10, 8, 14, 36, roster.ANIM_SHOOT), 0, 0, 160), FX_RICOCHET, 0, gold)
        ricochet.ammo = 1
        var charge = with_fx(move("Charged Shot", "Pierces every enemy, harder past each one, and bursts on the wall", charged, 0, 0, 280), FX_PIERCE, 0, gold)
        charge.ammo = 2
        var hammer = move("Fan the Hammer", "Empties every round left across them", fan, 0, 0, 320)
        hammer.ammo = -1
        return [ricochet, charge, hammer]
    else if weapon == 1 do
        var toss = shot("Throw", 12, 8, 14, 24, roster.ANIM_THROW)
        toss.shot = roster.SHOT_KNIFE
        return [move("Flurry", "Five fast cuts", multi(strike("Flurry", 4, 6, 14, 1.8, 90, 0.3, 8, 1, roster.ANIM_SWING), 5, 5), 12, 0, 60),
            move("Throw", "Throws a knife (it comes back)", toss, 6, 0, 60),
            with_fx(move("Backstep Slash", "Leaps back cutting", strike("Backstep Slash", 9, 6, 14, 2.0, 120, 0, 12, 4, roster.ANIM_BACKSWING), 9, 0, 60), FX_BACKSTEP, 0, gold)]
    else if weapon == 2 do
        var whirl = multi(strike("Whirl", 7, 12, 20, 2.4, 360, 0, 12, 3, roster.ANIM_SPIN), 2, 8)
        whirl.radial = true
        return [move("Cleave", "A huge cut that knocks them down", strike("Cleave", 17, 16, 20, 2.5, 160, 0.6, 28, 6, roster.ANIM_SLAM), 15, 0, 80),
            move("Lunge", "Covers four meters in a thrust", strike("Lunge", 13, 8, 16, 2.2, 50, 4.0, 18, 3, roster.ANIM_THRUST), 12, 0, 70),
            move("Whirl", "Cuts all around", whirl, 16, 0, 110)]
    else if weapon == 3 do
        var sweep = strike("Sweep", 10, 12, 18, 3.0, 360, 0, 24, 6, roster.ANIM_SPIN)
        sweep.radial = true
        return [move("Sweep", "Knocks everything near away", sweep, 13, 0, 80),
            move("Vault Strike", "Vaults in and brings it down", strike("Vault Strike", 16, 18, 20, 2.6, 90, 3.6, 26, 4, roster.ANIM_POUNCE), 16, 0, 100),
            with_fx(move("Spin Guard", "A spinning guard that stops everything", strike("Spin Guard", 0, 6, 30, 0, 0, 0, 0, 0, roster.ANIM_TWIRL), 12, 0, 160), FX_GUARD, 1.2, gold)]
    else if weapon == 4 do
        return [with_fx(move("Rend", "Four tearing cuts", multi(strike("Rend", 6, 12, 18, 2.0, 100, 0.3, 10, 1, roster.ANIM_SWING), 4, 7), 15, 0, 80), FX_POISON, 3, ap.Color(200, 40, 40)),
            move("Hack", "One brutal chop", strike("Hack", 22, 22, 22, 2.1, 80, 0.5, 34, 5, roster.ANIM_SLAM), 18, 0, 110),
            with_fx(move("Bloodletting", "Cuts, and drinks what spills", strike("Bloodletting", 12, 12, 18, 2.0, 100, 0.3, 16, 2, roster.ANIM_BACKSWING), 13, 0, 120), FX_DRAIN, 0, ap.Color(200, 40, 40))]
    end
    return [move("Haymaker", "A big swinging punch", strike("Haymaker", 10, 12, 16, 1.8, 90, 0.4, 20, 4, roster.ANIM_SWING), 10, 0, 60),
        move("Headbutt", "Close and dirty", strike("Headbutt", 8, 6, 14, 1.4, 60, 0.2, 26, 2, roster.ANIM_BITE), 8, 0, 60),
        move("Tackle", "Barges forward", strike("Tackle", 8, 8, 18, 1.8, 80, 3.0, 20, 6, roster.ANIM_CHARGE), 12, 0, 80)]
end
# --- The save -----------------------------------------------------------------------------------

class PurgSave
    bool started = false
    bool tutorial = false            # this run has picked up the gun (and seen or skipped its tutorial)
    bool admin = false               # the admin panel's cheats are on
    bool admin_run = false           # admin mode was on at some point this run: no achievements until a new run
    bool tutorial_seen = false       # the tutorial has been shown once; kept across new runs
    bool skip_install = false        # chose to play without the extra content
    int difficulty = DIFF_NORMAL
    int unlocked = 0                 # the furthest level reached (0: the threshold)
    int[] cleared = []               # levels whose boss is beaten
    int souls = 0
    int[] weapons = []               # owned
    int weapon = -1                  # equipped (-1: fists)
    int[] stances = [0]
    int stance = 0
    int[] arts = []
    int[] art_slots = [-1, -1, -1, -1]
    int[] books_read = []            # levels whose book is taken
    int[] chests_opened = []         # level * 100 + chest
    int[] dojos = []                 # levels whose dojo has been found
    int since_dojo = 0               # levels entered since the last one with a dojo (makes the next likelier)
    int since_book = 0               # ...and since the last with a cursed book
    int[] items_owned = []           # the Arena items bought at shops (their ids), kept for good
    int since_shop = 0               # levels since the last with a shop
    string[] upgrades = []           # one entry per upgrade taken: "stance:2:power", "art:0:thrift", "arms:-1:haste"
    double max_health = 120
    double max_stamina = 100
    double max_mana = 100
    double sensitivity = 1
    string[] infusions = []          # the forge's work, one per weapon: "weapon:kind" (kinds: INFUSE_*)
    int since_kneel = 0              # bosses beaten since the last one knelt for a second phase...
    int kneel_next = 7               # ...and how many it takes this time (6 to 10)
    int[] red_arts = []              # the bosses whose red books have been offered (bought or not)
    # Kept through a new game and through HELL's permadeath:
    string[] achievements = []       # ids of the achievements earned...
    string[] achievements_hell = []  # ...and of those earned on HELL (they burn)
    int runs_won = 0
    int hell_deaths = 0
end

# A fresh run, keeping what outlives runs (achievements, the settings).
function fresh_save(PurgSave old) returns PurgSave
    var d = PurgSave()
    d.difficulty = old.difficulty
    d.sensitivity = old.sensitivity
    d.achievements = old.achievements
    d.achievements_hell = old.achievements_hell
    d.runs_won = old.runs_won
    d.hell_deaths = old.hell_deaths
    d.tutorial_seen = old.tutorial_seen or old.tutorial
    d.kneel_next = 6 + int(ap.random(0, 4.99))
    return d
end

function save_path() returns string
    return fs.join(save.folder(), "purgatory.json")
end
function load_save() returns PurgSave
    try
        if fs.exists(save_path()) do
            PurgSave data = json.decode(fs.read(save_path()))
            # One stance at a time now: whichever is in use is the one known.
            data.stances = [data.stance]
            data.tutorial_seen = data.tutorial_seen or data.tutorial
            while data.art_slots.length < 4 do
                data.art_slots.push(-1)       # saves from when there were three
            end
            return data
        end
    catch e
    end
    return PurgSave()
end
var data = load_save()
function store()
    try
        fs.mkdir(save.folder())
        fs.write(save_path(), json.encode(data, 2))
    catch e
    end
end

function has(int[] list, int value) returns bool
    for v in list do
        if v == value do
            return true
        end
    end
    return false
end

# --- Each fighter's level --------------------------------------------------------------------------
