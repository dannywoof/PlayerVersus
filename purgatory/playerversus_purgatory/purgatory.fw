ap.Sound[] bank = []
function load_sounds()
    if bank.length > 0 do
        return
    end
    for f in SFX_FILES do
        bank.push(ap.load_sound(fs.join(__dir__, "assets", "sounds", f)))
    end
end
# A sound with no place (menus, Scarf's own).
function sfx(int k, double volume = 0.5, double pitch = 1)
    if k < bank.length do
        bank[k].play(volume, pitch * ap.random(0.96, 1.04))
    end
end
# A sound somewhere in the world, heard from the camera.
function sfx_at(int k, ap.Vec3 at, double volume = 0.6, double pitch = 1)
    if k < bank.length do
        bank[k].play_at(at + ap.Vec3(0, 1, 0), volume, pitch * ap.random(0.93, 1.07), 6, 0)
    end
end
function one_of(int[] ks) returns int
    return ks[int(ap.random(0, double(ks.length) - 0.001))]
end

# What swinging, and landing, a weapon sounds like.
function swing_sound(int weapon) returns int
    if weapon == roster.WEAPON_HANDS or weapon == roster.WEAPON_FISTS or weapon == roster.WEAPON_CLAWS do
        return one_of([SND_FIST_A, SND_FIST_B])
    else if weapon == roster.WEAPON_BO or weapon == roster.WEAPON_STAFF do
        return SND_WHOOSH
    end
    return one_of([SND_SWING_A, SND_SWING_B, SND_SWING_C])
end
function impact_sound(int weapon, double damage) returns int
    if damage >= 15 do
        return SND_HIT_HEAVY
    end
    if weapon == roster.WEAPON_HANDS or weapon == roster.WEAPON_FISTS do
        return one_of([SND_PUNCH_A, SND_PUNCH_B, SND_PUNCH_C])
    else if weapon == roster.WEAPON_DAGGER or weapon == roster.WEAPON_CLAWS do
        return one_of([SND_SLICE, SND_SLASH])
    else if weapon == roster.WEAPON_SAW do
        return SND_CHOP
    else if weapon == roster.WEAPON_BO or weapon == roster.WEAPON_STAFF do
        return SND_THUD
    else if weapon == roster.WEAPON_GUN or weapon == roster.WEAPON_REVOLVER do
        return SND_HIT
    end
    return one_of([SND_SLASH, SND_CLASH_A, SND_CLASH_B])
end

# --- What Scarf can learn and carry ------------------------------------------------------------

const int MENU_ROOT = 0
const int MENU_STANCE = 1
const int MENU_ART = 2
const int MENU_ARMAMENT = 3
const int MENU_REFLEX = 4
const string[] MENU_NAMES = ["", "STANCE", "ART", "ARMAMENT", "REFLEX"]

# Where a move comes from (its synergies key off it).
const int SRC_BASIC = 0
const int SRC_STANCE = 1
const int SRC_ART = 2
const int SRC_ARMS = 3

# What a move does beyond hitting.
const int FX_NONE = 0
const int FX_BURN = 1                # sets the target alight
const int FX_FREEZE = 2              # slows the target to a crawl
const int FX_POISON = 3
const int FX_ARMOR = 4               # Scarf takes less damage for a while
const int FX_BLINK = 5               # Scarf steps through space
const int FX_DRAIN = 6               # what it takes comes back as health
const int FX_CHAIN = 7               # leaps on to the next enemy, and the next
const int FX_RICOCHET = 8            # the bullet hops on to more enemies (or comes back at Scarf)
const int FX_BACKSTEP = 9            # leaps back first
const int FX_GUARD = 10              # blocks everything for a moment
const int FX_PIERCE = 11             # the shot goes on through every enemy in its way
const int FX_MANA = 12               # every hit pours mana back into Scarf (`fx_time` of it)
const int FX_SUNDER = 13             # the target takes 40% more from everything for `fx_time` seconds
const int FX_HEAL = 14               # a share of what it deals comes back as health (gentler than drain)
const int FX_BEHIND = 15             # Scarf steps behind the target first
const int FX_DODGE = 16              # Scarf cannot be touched while winding up
const int FX_VENOM = 17              # poisons all round, and poison burns 2.5x as hard for a while
const int FX_METEOR = 18             # a stone falls on the target from the sky
const int FX_WARCRY = 19             # stance moves hit 40% harder and cost a third less, for a while
const int FX_RITE = 20               # blood for breath: health spent, stamina and mana filled
const int FX_LANCE = 21              # a ray that spends all your mana, and hits harder for each drop
const int FX_RESTORE = 22            # heals Scarf outright (`fx_time` of their health, as a share)
const int FX_BOSS = 23               # a red book's art: a boss's own move

class Move
    string name
    string note = ""
    roster.Attack a = roster.Attack("")
    double st = 0                    # stamina it costs
    double mn = 0                    # mana it costs
    int cooldown = 0                 # ticks before it can be used again
    int fx = FX_NONE
    double fx_time = 0               # seconds the effect lasts
    ap.Color color = ap.WHITE        # its light
    int src = SRC_BASIC
    int ammo = 0                     # rounds of the gun it takes (-1: every round left)
end

function strike(string name, double damage, int startup, int recovery, double reach, double arc, double lunge,
        int stun, double push, int anim) returns roster.Attack
    var a = roster.Attack(name)
    a.damage = damage
    a.startup = startup
    a.recovery = recovery
    a.reach = reach
    a.arc = arc
    a.lunge = lunge
    a.stun = stun
    a.push = push
    a.anim = anim
    return a
end
function shot(string name, double damage, int startup, int recovery, double speed, int anim) returns roster.Attack
    var a = roster.Attack(name)
    a.damage = damage
    a.startup = startup
    a.recovery = recovery
    a.shot = roster.SHOT_BULLET
    a.shot_speed = speed
    a.anim = anim
    a.stun = 10
    return a
end
function move(string name, string note, roster.Attack a, double st, double mn, int cooldown) returns Move
    var m = Move(name)
    m.note = note
    m.a = a
    m.st = st
    m.mn = mn
    m.cooldown = cooldown
    return m
end
function with_fx(Move m, int fx, double seconds, ap.Color color) returns Move
    m.fx = fx
    m.fx_time = seconds
    m.color = color
    return m
end
function sourced(Move m, int src) returns Move
    m.src = src
    return m
end

# Stances: four physical moves each (the fourth from stance_extra). STREET is Scarf's own; the rest are taught at dojos, two to
# a dojo. Only one is known at a time: learning another replaces it (and the old one has to be
# taught again). Each has a fighter whose level teaches it far more often (STANCE_HOMES).
const string[] STANCE_NAMES = ["STREET", "CRANE", "IRON OX", "VIPER", "TEMPEST", "SIPHON", "MANTIS", "BULL",
    "DRUNKEN", "SCORPION", "LOTUS", "HAWK", "BEAR", "SHADE"]
const int[] STANCE_PRICE = [30, 45, 80, 120, 170, 110, 95, 90, 100, 130, 115, 105, 125, 150]
const string[] STANCE_HOMES = ["STAB", "EAGLE", "SHERMAN", "ANACONDA", "ASTER", "FANGS", "RAPIER", "STRONGMAN",
    "ZERO", "DEATH", "SPRUCE", "RAVEN", "COMBATANT", "SHEPHERD"]
const string[] STANCE_NOTES = ["Your starting style: fast punches, a sweep and a charge. Cheap on stamina.",
    "Kicks that launch enemies into the air, and a wide sweep.",
    "Slow, heavy blows, a stomp that hits all around, and a 50% damage-reduction buff.",
    "Quick jabs and hooks that poison. Pairs with VENOM MIST and the BONE SAW.",
    "Spinning kicks that hit everything around you, a dash strike and a launcher.",
    "Every hit pours mana back into you, and arts hit harder the fuller your mana is.",
    "Quick hooks, a guard that strikes back, and scything cuts.",
    "A goring charge, a trample all around, and a horn toss into the air.",
    "Lurching, untouchable wind-ups and heavy falling punches.",
    "Pincers that sunder (+40% damage taken) and a tail that poisons. Pairs with venom and HEX.",
    "Palms that heal you as they land, and a breath that restores your health.",
    "Diving talons and updrafts: everything ends up in the air.",
    "Brutal mauls, a crushing hug, and a roar that stuns everything near.",
    "Strikes from behind the enemy, and a fade through the dark. Pairs with SHADOW STEP."]
# What each stance is drawn as on a dojo's buttons.
const ap.Color[] STANCE_COLORS = [ap.Color(220, 200, 180), ap.Color(240, 240, 255), ap.Color(180, 180, 200),
    ap.Color(140, 230, 90), ap.Color(150, 210, 255), ap.Color(130, 160, 255), ap.Color(170, 230, 110),
    ap.Color(230, 110, 70), ap.Color(230, 150, 200), ap.Color(230, 190, 70), ap.Color(255, 170, 200),
    ap.Color(220, 190, 140), ap.Color(170, 120, 80), ap.Color(150, 120, 200)]

function stance_moves(int stance) returns Move[]
    Move[] out = []
    for m in stance_moves_raw(stance) do
        out.push(sourced(m, SRC_STANCE))
    end
    out.push(sourced(stance_extra(stance), SRC_STANCE))
    return out
end

# Each stance's fourth move: its biggest, with the longest cooldown.
function stance_extra(int stance) returns Move
    if stance == 1 do
        var dance = multi(strike("Crane Dance", 6, 10, 20, 2.1, 100, 1.0, 16, 1, roster.ANIM_HIGH_KICK), 3, 8)
        dance.launch = 4
        return move("Crane Dance", "Three hopping kicks that keep them in the air", dance, 22, 0, 110)
    else if stance == 2 do
        return move("Ox Ram", "Charges four meters and flattens them", strike("Ox Ram", 18, 18, 22, 1.9, 80, 4.0, 32, 10, roster.ANIM_CHARGE), 24, 0, 130)
    else if stance == 3 do
        return with_fx(move("Viper Strike", "Darts in from afar and poisons for 10s", strike("Viper Strike", 12, 10, 18, 1.9, 60, 3.6, 20, 3, roster.ANIM_THRUST), 18, 0, 110), FX_POISON, 10, ap.Color(140, 230, 90))
    else if stance == 4 do
        var eye = multi(strike("Eye of the Storm", 5, 14, 24, 2.8, 360, 0, 12, 3, roster.ANIM_SPIN), 5, 7)
        eye.radial = true
        return move("Eye of the Storm", "Five spinning kicks all around you", eye, 30, 0, 200)
    else if stance == 5 do
        var burst = strike("Mana Burst", 10, 14, 20, 3.0, 360, 0, 20, 5, roster.ANIM_FOCUS)
        burst.radial = true
        return with_fx(move("Mana Burst", "A palm of force all round; 6 mana from each it hits", burst, 18, 0, 140), FX_MANA, 6, ap.Color(130, 160, 255))
    else if stance == 6 do
        return move("Mantis Flurry", "Six lightning-fast hooks", multi(strike("Mantis Flurry", 4, 6, 16, 1.9, 100, 0.4, 10, 1, roster.ANIM_HOOK), 6, 5), 22, 0, 110)
    else if stance == 7 do
        return move("Stampede", "A seven-meter charge through everything", strike("Stampede", 16, 14, 24, 2.0, 100, 7.0, 26, 11, roster.ANIM_CHARGE), 26, 0, 160)
    else if stance == 8 do
        var spin = strike("Bottle Spin", 14, 16, 20, 2.4, 360, 0, 22, 5, roster.ANIM_SPIN)
        spin.radial = true
        return with_fx(move("Bottle Spin", "Reels round, untouchable, hitting all near", spin, 20, 0, 120), FX_DODGE, 0, ap.Color(230, 150, 200))
    else if stance == 9 do
        var sweep = strike("Tail Sweep", 10, 14, 20, 2.6, 360, 0, 18, 4, roster.ANIM_SPIN)
        sweep.radial = true
        return with_fx(move("Tail Sweep", "A tail swung all round that poisons", sweep, 22, 0, 130), FX_POISON, 6, ap.Color(140, 230, 90))
    else if stance == 10 do
        return with_fx(move("Lotus Bloom", "Three palms; each heals you a little", multi(strike("Lotus Bloom", 7, 10, 18, 1.9, 100, 0.4, 14, 2, roster.ANIM_THRUST), 3, 8), 20, 0, 130), FX_HEAL, 0, ap.Color(255, 170, 200))
    else if stance == 11 do
        return move("Hawk Drop", "Leaps and drops on them from above", strike("Hawk Drop", 20, 20, 24, 2.2, 90, 3.0, 32, 4, roster.ANIM_SLAM), 24, 0, 130)
    else if stance == 12 do
        return move("Bear Swipe", "Two wide, heavy swipes", multi(strike("Bear Swipe", 11, 12, 20, 2.2, 180, 0.4, 22, 6, roster.ANIM_SWING), 2, 10), 20, 0, 90)
    else if stance == 13 do
        return with_fx(move("Shadow Rush", "Appears behind them: three cuts", multi(strike("Shadow Rush", 7, 10, 16, 2.0, 100, 0.2, 14, 2, roster.ANIM_SWING), 3, 6), 22, 0, 140), FX_BEHIND, 0, ap.Color(150, 120, 200))
    end
    var upper = strike("Uppercut", 13, 12, 20, 1.8, 80, 0.5, 26, 3, roster.ANIM_UPPERCUT)
    upper.launch = 8
    return move("Uppercut", "From the knees: throws them up", upper, 18, 0, 90)
end

function stance_moves_raw(int stance) returns Move[]
    var green = ap.Color(140, 230, 90)
    if stance == 1 do
        var lift = strike("Crane Kick", 11, 10, 18, 2.0, 90, 0.6, 22, 2, roster.ANIM_HIGH_KICK)
        lift.launch = 7
        return [move("Crane Kick", "A high kick that throws them up", lift, 18, 0, 50),
            move("Wing Sweep", "A wide sweeping kick", strike("Wing Sweep", 9, 12, 18, 2.4, 200, 0.2, 18, 4, roster.ANIM_SPIN), 16, 0, 60),
            move("Rising Heel", "Leaps and drives a heel down", strike("Rising Heel", 16, 18, 22, 2.2, 80, 2.0, 30, 3, roster.ANIM_HIGH_KICK), 24, 0, 110)]
    else if stance == 2 do
        var stomp = strike("Ground Stomp", 12, 20, 22, 3.0, 360, 0, 26, 5, roster.ANIM_SLAM)
        stomp.radial = true
        return [move("Palm Strike", "A heavy palm that sends them flying", strike("Palm Strike", 15, 16, 20, 1.9, 70, 0.4, 28, 9, roster.ANIM_THRUST), 20, 0, 70),
            move("Ground Stomp", "Shakes everything around you", stomp, 26, 0, 140),
            with_fx(move("Iron Body", "Six seconds taking half damage", strike("Iron Body", 0, 12, 12, 0, 0, 0, 0, 0, roster.ANIM_FOCUS), 25, 0, 600), FX_ARMOR, 6, ap.Color(200, 200, 220))]
    else if stance == 3 do
        return [with_fx(move("Fang Jab", "Three quick jabs that poison", multi(strike("Fang Jab", 4, 6, 12, 1.8, 60, 0.3, 10, 1, roster.ANIM_PUNCH), 3, 6), 14, 0, 45), FX_POISON, 4, green),
            with_fx(move("Coil Step", "Slips back, then strikes", strike("Coil Step", 10, 14, 14, 2.0, 80, 2.2, 18, 2, roster.ANIM_THRUST), 14, 0, 80), FX_BACKSTEP, 0, green),
