    return [move("Jab Rush", "Four quick punches", multi(strike("Jab Rush", 4, 5, 12, 1.7, 70, 0.3, 10, 1, roster.ANIM_PUNCH), 4, 5), 12, 0, 40),
        move("Low Kick", "Sweeps their legs", strike("Low Kick", 9, 10, 16, 1.9, 100, 0.3, 24, 2, roster.ANIM_KICK), 14, 0, 55),
        move("Shoulder Charge", "Barges three steps forward", strike("Shoulder Charge", 10, 8, 18, 1.8, 80, 3.2, 22, 7, roster.ANIM_CHARGE), 18, 0, 80)]
