# The CPU levels of the Arena (playerversus.fw): a boss fights like the Arena's NORMAL CPU on
# easy and normal, and like its HARD CPU on hard.
const int[] CPU_WAIT = [75, 42, 20, 14]
const int[] CPU_WAIT_MORE = [70, 50, 36, 26]
const double[] CPU_COMBO = [0.15, 0.45, 0.75, 0.85]
const double[] CPU_SKILL = [0.2, 0.35, 0.5, 0.6]
const double[] CPU_DAMAGE = [0.7, 0.85, 1.0, 1.1]

