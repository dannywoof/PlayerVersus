# --- What the game asks -----------------------------------------------------------------------------
# A fighter's situation this tick, filled in by the game: what the conditions look at.
class Situation
    double health = 1                # shares of the maximum
    double foe_health = 1
    bool foe_poisoned = false
    bool foe_slowed = false
    int rounds_behind = 0
    int rounds_ahead = 0
    bool my_super = false
    bool their_super = false
    double distance = 3
    bool moving = false
    bool blocking = false
    double since_parry = 999         # seconds
    double since_hurt = 999
    int combo = 0
    double round_time = 0            # seconds fought this round
    double clock = 99                # seconds left
    bool decider = false
    double bar = 1                   # share of the special bar
    bool behind_foe = false
    bool foe_airborne = false
    bool super_ready = false
end

function holds(int c, double p, Situation s) returns bool
    if c == W_ALWAYS do
        return true
    else if c == W_HP_BELOW do
        return s.health * 100 < p
    else if c == W_HP_ABOVE do
        return s.health * 100 > p
    else if c == W_FOE_HP_BELOW do
        return s.foe_health * 100 < p
    else if c == W_FOE_HP_ABOVE do
        return s.foe_health * 100 > p
    else if c == W_FOE_POISONED do
        return s.foe_poisoned
    else if c == W_FOE_SLOWED do
        return s.foe_slowed
    else if c == W_BEHIND do
        return s.rounds_behind > 0
    else if c == W_AHEAD do
        return s.rounds_ahead > 0
    else if c == W_MY_SUPER do
        return s.my_super
    else if c == W_THEIR_SUPER do
        return s.their_super
    else if c == W_CLOSE do
        return s.distance <= p
    else if c == W_FAR do
        return s.distance > p
    else if c == W_MOVING do
        return s.moving
    else if c == W_STILL do
        return not s.moving
    else if c == W_BLOCKING do
        return s.blocking
    else if c == W_AFTER_PARRY do
        return s.since_parry <= p
    else if c == W_AFTER_HURT do
        return s.since_hurt <= p
    else if c == W_UNHURT do
        return s.since_hurt > p
    else if c == W_COMBO do
        return double(s.combo) >= p
    else if c == W_EARLY do
        return s.round_time <= p
    else if c == W_LATE do
        return s.clock < p
    else if c == W_DECIDER do
        return s.decider
    else if c == W_BAR_ABOVE do
        return s.bar * 100 > p
    else if c == W_BAR_BELOW do
        return s.bar * 100 < p
    else if c == W_BEHIND_FOE do
        return s.behind_foe
    else if c == W_FOE_AIRBORNE do
        return s.foe_airborne
    else if c == W_SUPER_READY do
        return s.super_ready
    end
    return false
end

# Every effect added up over the items held, for the situation now. `held` are indexes into `defs`.
function totals(ItemDef[] defs, int[] held, Situation s) returns double[]
    double[] sum = []
    for i in 0..<EFFECT_COUNT do
        sum.push(0.0)
    end
    for index in held do
        if index < 0 or index >= defs.length do
            continue
        end
        var it = defs[index]
        if not holds(it.condition, it.param, s) do
            continue
        end
        for e in it.effects do
            if e.kind >= 0 and e.kind < EFFECT_COUNT do
                sum[e.kind] += e.amount
            end
        end
    end
    return sum
end

# A percent as a multiplier that never goes below `floor`: 25 -> 1.25, -30 -> 0.7.
function more(double percent, double floor = 0.1) returns double
    return math.max(1 + percent / 100, floor)
end
# A reduction as a multiplier: 25 -> 0.75 (capped so nothing reaches zero).
function less(double percent, double cap = 85) returns double
    return 1 - math.min(percent, cap) / 100
end
