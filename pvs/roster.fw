# A copy of a move, for a fighter that steals them.
function copy(Attack a) returns Attack
    var b = Attack(a.name, a.damage, a.startup, a.recovery, a.reach, a.arc, a.lunge, a.stun, a.push)
    b.cost = a.cost
    b.per_hit = a.per_hit
    b.gain = a.gain
    b.hits = a.hits
    b.interval = a.interval
    b.shot = a.shot
    b.shot_speed = a.shot_speed
    b.blast = a.blast
    b.poison = a.poison
    b.heal = a.heal
    b.teleport = a.teleport
    b.radial = a.radial
    b.anim = a.anim
    b.fx = a.fx
    b.cooldown = a.cooldown
    b.kind = a.kind
    b.note = a.note
    b.launch = a.launch
    b.slow = a.slow
    b.unblockable = a.unblockable
    b.counter = a.counter
    b.on_trigger = a.on_trigger
    b.evade = a.evade
    b.sturdy = a.sturdy
    b.finish = a.finish
    b.restock = a.restock
    b.shroud = a.shroud
    b.volley = a.volley
    b.spread = a.spread
    b.homing = a.homing
    b.lob = a.lob
    b.skyfall = a.skyfall
    b.pool = a.pool
    b.shot_life = a.shot_life
    b.buff = a.buff
    b.buff_time = a.buff_time
    b.blink = a.blink
    b.summon = a.summon
    b.recoil = a.recoil
    b.beam = a.beam
    b.inject = a.inject
    b.steal = a.steal
    b.crater = a.crater
    return b
end

# A move taken from someone else, re-priced for the bar of the one using it (CAT).
function adapt(Attack from, double price) returns Attack
    var a = copy(from)
    a.cost = price if a.cost > 0 or a.kind == KIND_RELOAD else 0.0
    a.per_hit = false
    a.gain = 0
    a.restock = 0
    a.steal = 0
    a.cooldown = math.max(a.cooldown + a.cooldown // 4, 60)
    if a.kind == KIND_FAN do
        # Bullets mean nothing to it: four shots, paid for once.
        a.kind = KIND_STRIKE
        a.hits = 4
    else if a.kind == KIND_RELOAD do
        # Nothing to reload: it takes a nap instead.
        a = skill(trick("Catnap", KIND_BUFF, ANIM_PLANT), 14, price, "Heals 6 a second for 3s")
        a.buff = BUFF_REGEN
        a.buff_time = 3
        a.heal = 6
    end
    return a
end

# Whether a move still means something in someone else's hands.
function portable(Attack a) returns bool
    return a.name != "" and a.startup > 1 and not a.inject and a.kind != KIND_SWAP and a.kind != KIND_RECALL and
        a.kind != KIND_LOCK
end

# Every skill in the game that a copycat could be handed at random.
function move_pool(Character[] cast) returns Attack[]
    Attack[] pool = []
    for c in cast do
        if c.copycat do
            continue
        end
        for a in c.skills do
            if portable(a) do
                pool.push(a)
            end
        end
        for arm in c.arsenal do
            for a in arm.skills do
                if portable(a) do
                    pool.push(a)
                end
            end
        end
    end
    return pool
end

# Every super move in the game, for the same.
function ultimate_pool(Character[] cast) returns Attack[]
    Attack[] pool = []
    for c in cast do
        if not c.copycat and not c.maximum.jammer and portable(c.ultimate) do
            pool.push(c.ultimate)
        end
    end
    return pool
end

# Every basic chain in the game: a copycat in its super borrows a whole one at a time.
function chain_pool(Character[] cast) returns Attack[][]
    Attack[][] pool = []
    for c in cast do
        if c.copycat do
            continue
        end
        pool.push(c.basics)
        for i, arm in c.arsenal do
            if i > 0 do
                pool.push(arm.basics)
            end
        end
    end
    return pool
end

# Everyone who can be picked, in the order the select screen shows them.
function build() returns Character[]
    Character[] cast = [fangs(), aster(), anaconda(), rapier(), quickdraw(), void_blade(), sherman(), shepherd(), don(),
        hotline(), buckshot(), stab(), atomic(), cat(), droid(), laser(), eagle(), combatant(), phantom(), carbon(),
        monopolist(), mirrorman(), bob(), teleman(), dismantle(), spruce()]
    for c in cast do
        c.maximum = maximum_of(c.name)
        c.bio = bio_of(c.name)
        c.health *= 2
    end
    return cast
end

# Who each of them is: the select screen's description.
function bio_of(string who) returns string
    if who == "FANGS" do
        return "A centuries-old aristocrat who outlived his estate, his family and his own name. He still dresses for dinner. Dinner is you."
    else if who == "ASTER" do
        return "A bare-knuckle prizefighter from the docks who never learned how to stay down. Loud, cheerful, and proud of the two teeth she lost."
    else if who == "ANACONDA" do
        return "The last priestess of a serpent cult, raised in the temple pits and taught that poison is only patience. She speaks softly and never blinks."
    else if who == "RAPIER" do
        return "A disgraced fencing master who ran a prince through over a point of etiquette. Perfect manners, a plumed hat, and a grudge against everyone."
    else if who == "QUICKDRAW" do
        return "A drifter out of a dust-bowl frontier town with six bullets and no plans. He talks slow, draws fast, and never looks back to check."
    else if who == "VOID" do
        return "A swordsman who cut away everything he felt to become faster. What is left is calm, quiet, and a blade that arrives before he does."
    else if who == "SHERMAN" do
        return "A retired siege engineer who bolted his old artillery to his own shoulders. As patient as a fortress, and about as easy to move."
    else if who == "SHEPHERD" do
        return "A hooded watcher who kept his flock on cursed hills until the wolves learned to fear the dark. Nobody has seen his face, and he likes it that way."
    else if who == "DON" do
        return "An absent-minded professor of the old arts, bearded, star-hatted and forever mid-lecture. He forgets your name, but never a formula."
    else if who == "HOTLINE" do
        return "A switchboard operator who knows every number in the city and exactly who owes whom. She fights on the phone, and she never hangs up first."
    else if who == "BUCKSHOT" do
        return "A riot-squad veteran who has kicked down more doors than she can count. Blunt, loud, and entirely allergic to subtlety."
    else if who == "STAB" do
        return "A street kid raised in the market alleys on picked pockets and picked locks. Quick hands, a quicker mouth, and loyal to nothing but coin."
    else if who == "ATOMIC" do
        return "A wild-haired physicist who opened a hole in the world during an experiment and stepped straight through it. She is still taking notes."
    else if who == "CAT" do
        return "A stray that wandered into the Purgatory and never wandered out. Curious, vain and endlessly mimicking, it learns your best move just to tease you."
    else if who == "DROID" do
        return "A maintenance robot built to fix machines in a factory that closed a century ago. It is still following its last order: keep running."
    else if who == "LASER" do
        return "A lighthouse keeper who swallowed the lamp's light the night the ships went down. She glows when she is angry, which is most of the time."
    else if who == "EAGLE" do
        return "A mountain sniper in a white-feathered cowl who sees for miles and speaks maybe once a day. He has never missed on purpose."
    else if who == "COMBATANT" do
        return "A mercenary who has fought in every war he could find and kept a weapon from each one. He changes arms the way others change their minds."
    else if who == "PHANTOM" do
        return "A widow who waited on a cliff for a ship that never came home, until the sea took her too. Now she drifts between worlds, taking what others save."
    else if who == "CARBON" do
        return "A quarry worker buried alive by a rockslide, who came out of the stone with some of it still in her. She hums the old songs of the mine."
    else if who == "MONOPOLIST" do
        return "A top-hatted magnate who bought a city, a railroad and a senator before lunch. He believes everything has a price, and he is behind on his own."
    else if who == "MIRRORMAN" do
        return "A vain stage magician who fell into his own trick mirror and never quite came out. Nobody knows which of him is the real one. Neither does he."
    else if who == "BOB" do
        return "A cheerful lab assistant who kept the experiments running after his employer vanished. His injections work perfectly. That is the problem."
    else if who == "TELEMAN" do
        return "A late-night TV host whose show was cancelled mid-sentence. He keeps broadcasting anyway, and changes the channel on anyone who interrupts."
    else if who == "DISMANTLE" do
        return "A gravedigger stitched back together from what the plague pits left behind. Slow, enormous, and very hard to keep in the ground."
    else if who == "SPRUCE" do
        return "A monk from a mountain temple who has not lost her temper in forty years. She waits by the water with her staff and lets you beat yourself."
    end
    return ""
end

