    else if who == "SPRUCE" do
        m.name = "STILL GROVE"
        m.place = "THE SPRUCE GROVE"
        m.note = "Blocks parry; each parry heals 10"
        m.anim = ANIM_COUNTER
        m.scene = SCENE_GROVE
        m.sky = ap.Color(180, 206, 214)
        m.ambient = ap.Color(120, 140, 130)
        m.sun = ap.Color(255, 246, 220)
        m.ground = ap.Color(96, 110, 84)
        m.floor = ap.Color(220, 236, 210)
        m.glow = ap.Color(150, 225, 120)
        m.mote = ap.Color(255, 255, 255)
        m.drift = -0.5
        m.fog_near = 16
        m.fog_far = 70
        m.perfect_guard = true
        m.parry_heal = 10
    end
    return m
end

# Rough 0..1 ratings for the select screen.
function rate_health(Character c) returns double
    return c.health / c.armor / 530
end
function rate_speed(Character c) returns double
    return c.speed / 7
end
function rate_power(Character c) returns double
    var best = 0.0
    for a in c.skills do
        var total = a.damage * double(a.hits) + a.finish
        if a.kind == KIND_FAN do
            total = a.damage * c.bar_max
        end
        if total > best do
            best = total
        end
    end
    return best / 30
end
function rate_range(Character c) returns double
    var far = 0.0
    var shoots = false
    for a in c.basics do
        if a.reach > far do
            far = a.reach
        end
        shoots = shoots or a.shot != SHOT_NONE or a.beam > 0
    end
    for a in c.skills do
        shoots = shoots or a.shot != SHOT_NONE or a.beam > 0
    end
    if shoots do
        far = far + 2.2
    end
    return far / 5
end
