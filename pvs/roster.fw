# --- The effects and sounds a move sets off (see playerversus.fw) ------------------------------
const int FX_NONE = 0
const int FX_FEAST = 1
const int FX_RUSH = 2
const int FX_SPIT = 3
const int FX_FLECHE = 4
const int FX_FAN = 5
const int FX_FLASH = 6
const int FX_ROCKET = 7
const int FX_NOVA = 8
const int FX_BOLT = 9
const int FX_CHAIN = 10      # a hooked chain flung out to the move's reach

# One move. Times are ticks (60 a second): `startup` before it hits, `recovery` after.
class Attack
    string name
    double damage = 5
    int startup = 8
    int recovery = 12
    double reach = 1.8        # meters, for melee
    double arc = 100          # degrees in front that a melee hit covers (the full angle)
    double lunge = 0          # meters stepped forward while striking
    int stun = 15             # ticks the victim cannot act
    double push = 3           # how hard the victim is knocked away (negative pulls them in)
    double cost = 0           # special bar spent
    bool per_hit = false      # the cost is paid for each hit (bullets) instead of once
    double gain = 0           # special bar gained when it lands
    int hits = 1              # how many times it strikes
    int interval = 6          # ticks between strikes
    int shot = SHOT_NONE      # what it fires, if anything
    double shot_speed = 20
    double blast = 0          # explosion radius of the shot
    double poison = 0         # seconds of poison it adds
    double heal = 0           # health the attacker gets back when it lands
    bool teleport = false     # appear behind the opponent just before striking
    bool radial = false       # hits all around instead of in front
    int anim = ANIM_SWING
    int fx = FX_NONE
    int cooldown = 0          # ticks before it can be used again
    int kind = KIND_STRIKE
    string note = ""          # one line for the select screen
    double launch = 0         # throws the victim into the air (meters a second, upward)
    double slow = 0           # seconds the victim moves at half speed
    bool unblockable = false  # a block does not stop it (a parry still does)
    bool counter = false      # struck while winding up, it parries and hits back far harder
    bool on_trigger = false   # a counter that does nothing unless set off (it restocks instead)
    bool evade = false        # cannot be hit while winding up; `lunge` goes where the stick points
    bool sturdy = false       # cannot be staggered out of it
    double finish = 0         # extra damage on the last hit of a multi-hit move
    double restock = 0        # special bar gained just for doing it
    bool shroud = false       # the user turns invisible as it goes off
    int volley = 1            # shots fired at once...
    double spread = 10        # ...this many degrees apart
    double homing = 0         # degrees a second the shot can turn after its target
    bool lob = false          # thrown in an arc to where the opponent stands
    bool skyfall = false      # falls on the opponent from above
    double pool = 0           # seconds a pool of it lies where the shot lands
    double shot_life = 2.5    # seconds before the shot gives out
    int buff = BUFF_NONE
    double buff_time = 0
    double blink = 0
    double summon = 0         # the shot starts this many meters behind the user and drives through
    double recoil = 0         # how hard firing it throws the user backward
    double beam = 0           # over 0: no shot, but a ray this long that hits at once
    bool inject = false       # a dose: enough of them and a clone of the victim joins the user (BOB)
    double steal = 0          # super bar taken from the victim when it lands
    bool crater = false       # torn out of the floor: leaves a hole where the user stood
end

class Look
    ap.Color skin = ap.Color(232, 190, 160)
    ap.Color body = ap.GRAY          # torso and sleeves
    ap.Color legs = ap.DARK_GRAY
    ap.Color trim = ap.WHITE         # belt, headgear details
    ap.Color accent = ap.WHITE       # the fighter's signature color: glows, effects, UI
    ap.Color metal = ap.LIGHT_GRAY   # the weapon
    ap.Color eyes = ap.Color(20, 20, 28)
    double bulk = 1                  # how wide
    double tall = 1                  # how tall
    int head = HEAD_BAND
    int weapon = WEAPON_FISTS
    int stance = STANCE_GUARD
    bool cape = false
    ap.Color cape_color = ap.BLACK
    bool glowing_eyes = false
    bool glowing_weapon = false
    bool wings = false               # a pair of wings on the back
    ap.Color wing_color = ap.BLACK
    double hover = 0                 # meters off the ground, always
end

# --- Supers ------------------------------------------------------------------------------------
# A fighter's super (G with a full super bar, in any mode): the arena crumbles and becomes
# somewhere of their own, which works in their favor for thirty seconds. Inside it, G once more
# is the fighter's `ultimate` move. The game reads these numbers; `scene` picks the scenery.
const int SCENE_CASTLE = 0
const int SCENE_RING = 1
const int SCENE_SWAMP = 2
const int SCENE_HALL = 3
const int SCENE_TOWN = 4
const int SCENE_ABYSS = 5
const int SCENE_TRENCHES = 6
const int SCENE_GRAVEYARD = 7
const int SCENE_TOWER = 8
const int SCENE_CITY = 9
const int SCENE_WAREHOUSE = 10
const int SCENE_ALLEY = 11
const int SCENE_REACTOR = 12
const int SCENE_FACTORY = 13
const int SCENE_SUN = 14
const int SCENE_CANYON = 15
const int SCENE_BOX = 16
const int SCENE_COLOSSEUM = 17
const int SCENE_FOREST = 18
const int SCENE_QUARRY = 19
const int SCENE_BANK = 20
const int SCENE_MIRRORS = 21
const int SCENE_LAB = 22
const int SCENE_STUDIO = 23
const int SCENE_PIT = 24
const int SCENE_GROVE = 25

class Maximum
    string name = "SUPER"
    string place = ""                 # the name of where the arena becomes
    string note = ""                  # one line for the select screen
    int anim = ANIM_FOCUS             # what the fighter does in the cutscene
    int scene = SCENE_CASTLE
    ap.Color sky = ap.Color(10, 8, 16)
    ap.Color ambient = ap.Color(70, 70, 90)
    ap.Color sun = ap.Color(200, 200, 220)
    ap.Color ground = ap.Color(50, 46, 60)   # the stone of the floor's edge
    ap.Color floor = ap.WHITE                # a tint over the painted floor
    ap.Color glow = ap.Color(255, 255, 255)  # lamps and the arena's rim
    ap.Color mote = ap.Color(255, 255, 255)  # what drifts in the air...
    double drift = 0.3                       # ...and how fast it rises (or falls)
    double fog_near = 18
    double fog_far = 80
    # What it does, for the user (self_) and against the other fighter (foe_).
    double foe_dps = 0                # health a second, no block or stagger
    double drain = 0                  # share of foe_dps the user drinks back
    double foe_poison = 0             # seconds of poison added each second
    bool foe_slow = false
    double foe_vulnerable = 1         # damage the foe takes is multiplied by this
    double regen = 0                  # health a second for the user
    double power = 1                  # the user's damage
    double armor = 1                  # damage the user takes
    double speed = 1
    int cool_rate = 1                 # cooldowns tick this many times as fast
    double bar_regen = 0              # special bar a second
    bool perfect_guard = false        # every block is a parry
    bool portals = false              # wild portals that come and go, leading anywhere
    Attack strike = Attack("")        # something sent at the foe now and then (no name: nothing)
    double strike_every = 0           # seconds between them
    bool strike_ground = false        # comes along the ground from the edge (else from the sky)
    double seconds = 30               # how long the place lasts
    int cut_ticks = 170               # how long its cutscene takes
    bool vanish = false               # the user cannot be seen at all
    bool mono = false                 # the whole place is drained of color
    bool randomize = false            # every move the user has is a random one from the game, reshuffled on use
    bool free_bar = false             # moves cost nothing from the special bar
    int clones = 0                    # mirror copies of the user kept around the foe
    bool labs = false                 # extra machines; every dose makes a clone (BOB)
    bool jammer = false               # not a place: used inside the foe's super, it switches it off (TELEMAN)
    double parry_heal = 0             # health the user gets back from every parry
end

# One weapon of a fighter who carries several (COMBATANT): its basic chain, skills 1-3 and fallback.
class Arsenal
    string name
    int weapon
    Attack[] basics
    Attack[] skills
    Attack fallback
    double ai_range = 1.8
end

class Character
    string name
    string title
    string blurb = ""                # how they play, in one line (the select screen's PASSIVE)
    string bio = ""                  # who they are
    string style = ""                # two or three words on how they play
    double health = 100
    double speed = 5.5               # meters a second
    double armor = 1                 # damage taken is multiplied by this
    bool poise = false               # light hits do not stagger
    double lifesteal = 0             # share of damage dealt that comes back as health
    double toxic_bonus = 1           # damage multiplier against a poisoned opponent
    double backstab = 1              # damage multiplier for melee hits from behind
    string dot_name = "POISONED"     # what this fighter's poison is called on the opponent's HUD
    bool machine = false             # cannot be poisoned or slowed
    bool copycat = false             # skill 1 becomes the last skill that hit them
    bool reload_all = false          # the reload puts every bullet in at once, at the end
    # The special bar.
    string bar_name = "ENERGY"
    string bar_note = ""
    double bar_max = 100
    double bar_start = 100
    double bar_regen = 0             # per second
    double bar_drain = 0             # per second while cloaked
    double parry_gain = 15           # bar gained from a parry
    bool bar_pips = false            # shown as separate pips (bullets, rockets)
    int bar_icon = ICON_NONE
    # Moves: the basic attack is a chain (press again to go on), then four skills and a super.
    Attack[] basics = []
    Attack[] skills = []
    Attack ultimate = Attack("Super")
    Attack fallback = Attack("")     # the basic attack when the bar cannot pay for it (no name: none)
    double ai_range = 1.7            # the distance the CPU likes to fight at
    double super_steal = 0           # super bar taken from the opponent by every hit that lands
    double greed = 1                 # damage dealt is multiplied by this
    int bankrupt = 0                 # over 0: the bar never refills; at zero, stunned this many ticks
    Arsenal[] arsenal = []           # weapons switched between with KIND_SWAP; the first is held at the start
    bool lab = false                 # a machine stands behind them at the start of every round (BOB)
    int inject_need = 3              # doses that make a clone
    double clone_cool = 10           # seconds after a clone dies before another can be made
    double revive = 0                # over 0: the first knockout of a round, they get up with this share of health
    Look look = Look()
    Maximum maximum = Maximum()
end

const double POISON_DPS = 2.2        # health lost per second while poisoned
const double POISON_LIMIT = 10       # the most seconds of poison that can stack up
const double CLOAK_BONUS = 1.6       # damage multiplier striking out of invisibility...
const double AMBUSH_BONUS = 2.2      # ...and from behind
const double COUNTER_BONUS = 4       # damage multiplier of a counter that was set off
const int RELOAD_TICKS = 10             # ticks to load one bullet
const int SPEEDLOAD_TICKS = 45          # ticks for a reload_all reload to drop every bullet in
const double SUPER_MAX = 100
# The super is a late-match weapon: kept from round to round, it is meant to be ready around the
# second round, not the first.
const double SUPER_PER_SECOND = 0.5  # the super bar fills on its own in over three minutes...
const double SUPER_PER_DEALT = 0.1   # ...faster for damage dealt...
const double SUPER_PER_TAKEN = 0.15  # ...and a little faster for damage taken, so the one behind gets theirs first

# A melee move: the numbers every one of them needs.
function hit(string name, double damage, int startup, int recovery, double reach, double arc, double lunge,
        int stun, double push, int anim) returns Attack
    var a = Attack(name, damage, startup, recovery, reach, arc, lunge, stun, push)
    a.anim = anim
    return a
end
# A move that fires something.
function fire(string name, double damage, int startup, int recovery, int shot, double speed, int stun,
        double push, int anim) returns Attack
    var a = Attack(name, damage, startup, recovery)
    a.shot = shot
    a.shot_speed = speed
    a.stun = stun
    a.push = push
    a.anim = anim
    return a
end
# A move that is not an attack.
function trick(string name, int kind, int anim) returns Attack
    var a = Attack(name, 0, 10, 14)
    a.kind = kind
    a.anim = anim
    return a
end
# Sets what every skill has: its cooldown in seconds, bar cost, and a line for the select screen.
function skill(Attack a, double seconds, double cost, string note) returns Attack
    a.cooldown = int(seconds * 60)
    a.cost = cost
    a.note = note
    return a
end

function fangs() returns Character
    var c = Character("FANGS", "THE VAMPIRE")
    c.blurb = "Rushdown. Heals 12% of damage dealt; Blood fills on hits."
    c.style = "Rushdown, lifesteal"
    c.health = 140
    c.speed = 5.6
    c.lifesteal = 0.12
    c.bar_name = "BLOOD"
    c.bar_icon = ICON_DROP
    c.bar_note = "Fills as hits land"
    c.bar_start = 0
    c.basics = [hit("Claw", 5, 7, 12, 1.9, 100, 0.5, 18, 2, ANIM_SWING),
        hit("Claw", 5, 7, 12, 1.9, 100, 0.5, 18, 2, ANIM_BACKSWING),
        hit("Rend", 9, 10, 18, 2.1, 110, 0.8, 24, 5, ANIM_SLAM)]
    c.basics[0].gain = 10
    c.basics[1].gain = 10
    c.basics[2].gain = 16
    var pounce = skill(hit("Pounce", 10, 12, 20, 2.0, 90, 4.2, 26, 3, ANIM_POUNCE), 5, 0, "Leaps 4 m into a claw strike")
    pounce.gain = 15
    var bats = skill(fire("Bat Swarm", 7, 14, 18, SHOT_BATS, 10, 16, 1, ANIM_CAST), 6, 0, "Slow homing bats; heal 6 on hit")
    bats.homing = 150
    bats.heal = 6
    bats.shot_life = 3.2
    var feast = skill(hit("Blood Feast", 12, 12, 26, 2.0, 80, 3.2, 34, 2, ANIM_BITE), 8, 50, "A bite that heals 20")
    feast.heal = 20
    feast.fx = FX_FEAST
    var mist = skill(trick("Mist Form", KIND_BUFF, ANIM_FOCUS), 11, 20, "1.5s untouchable and faster")
    mist.buff = BUFF_MIST
    mist.buff_time = 1.5
    c.skills = [pounce, bats, feast, mist]
    c.ultimate = hit("Crimson Banquet", 6, 14, 30, 2.2, 100, 4.5, 20, 1, ANIM_BITE)
    c.ultimate.hits = 6
    c.ultimate.heal = 5
    c.ultimate.finish = 8
    c.ultimate.fx = FX_FEAST
    c.ultimate.note = "Six bites, each heals 5"
    var l = c.look
    l.skin = ap.Color(214, 208, 220)
    l.body = ap.Color(46, 16, 28)
    l.legs = ap.Color(24, 18, 28)
    l.trim = ap.Color(150, 20, 40)
    l.accent = ap.Color(230, 40, 70)
    l.metal = ap.Color(235, 230, 240)
    l.eyes = ap.Color(255, 60, 80)
    l.glowing_eyes = true
    l.head = HEAD_SLICK
    l.weapon = WEAPON_CLAWS
    l.stance = STANCE_PROWL
    l.cape = true
    l.cape_color = ap.Color(110, 14, 30)
    return c
end

function aster() returns Character
    var c = Character("ASTER", "THE BRAWLER")
    c.blurb = "Fast combos on stamina. Uppercut launches for juggles."
    c.style = "Combos, juggles"
    c.health = 135
    c.speed = 6.6
    c.bar_name = "STAMINA"
    c.bar_icon = ICON_BOLT
    c.bar_note = "Punches cost it; refills fast"
    c.bar_regen = 26
    c.basics = [hit("Jab", 4, 5, 9, 1.6, 90, 0.4, 16, 1.5, ANIM_PUNCH),
        hit("Cross", 5, 6, 10, 1.7, 90, 0.5, 17, 2, ANIM_CROSS),
