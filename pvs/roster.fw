function combatant() returns Character
    var c = Character("COMBATANT", "THE ARMSMAN")
    c.blurb = "Skill 4 cycles greatsword, axe and 6 throwing daggers."
    c.style = "Three weapons"
    c.health = 145
    c.speed = 5.4
    c.bar_name = "DAGGERS"
