    c.parry_gain = 0
    # The greatsword: slow, wide and heavy.
    Attack[] sword = [hit("Cleave", 9, 12, 18, 2.6, 130, 0.5, 24, 5, ANIM_SWING),
        hit("Backcut", 9, 12, 18, 2.6, 130, 0.5, 24, 5, ANIM_BACKSWING),
