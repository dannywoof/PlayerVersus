const int SHOT_BULLET = 1
const int SHOT_VENOM = 2
const int SHOT_ROCKET = 3
const int SHOT_BOLT = 4
const int SHOT_BATS = 5
const int SHOT_WAVE = 6
const int SHOT_BOMB = 7
const int SHOT_MINE = 8
const int SHOT_METEOR = 9
const int SHOT_CAR = 10
const int SHOT_KNIFE = 11
const int SHOT_FIST = 12
const int SHOT_RING = 13     # a phone ringing in the victim's pocket
const int SHOT_ROCK = 14     # a chunk torn out of the floor
const int SHOT_COIN = 15     # a gold coin, flicked
const int SHOT_FEATHER = 16  # a black feather, sharp as glass
const int SHOT_SPIKE = 17    # a ridge of stone that runs along the ground

# --- What kind of thing a move is ---------------------------------------------------------------
const int KIND_STRIKE = 0    # an attack: a melee hit or a shot
const int KIND_CLOAK = 1     # toggles invisibility, draining the bar
const int KIND_FAN = 2       # fires every bullet left
const int KIND_RELOAD = 3    # refills the bar after a pause
const int KIND_BUFF = 4      # puts `buff` on the user for `buff_time` seconds
const int KIND_BLINK = 5     # an instant teleport `blink` meters the way the stick points
const int KIND_PORTAL = 6    # opens one end of a pair of portals a few steps ahead
const int KIND_LOCK = 7      # keeps skill 1 as it is, or lets it be copied again (CAT)
const int KIND_SWAP = 8      # the next weapon of the fighter's arsenal (COMBATANT)
const int KIND_RECALL = 9    # every thrown dagger lying about flies back to the hand
const int KIND_MIRROR = 10   # mirrored copies of the user appear around the opponent
const int KIND_GLASS = 11    # trades places with one of the user's mirror copies
const int KIND_SHATTER = 12  # the user's mirror copies burst, cutting whoever is near
const int KIND_WALL = 13     # a pillar of stone rises a few steps ahead
const int KIND_SWITCH = 14   # the user and the opponent trade places

const int BUFF_NONE = 0
const int BUFF_MIST = 1      # cannot be hit, moves faster
const int BUFF_HASTE = 2     # moves faster, the bar refills quicker
const int BUFF_GUARD = 3     # takes far less damage and cannot be staggered
const int BUFF_REGEN = 4     # heals `heal` health a second
const int BUFF_POWER = 5     # the next shot fired hits far harder
const int BUFF_PARRY = 6     # every block is a parry

