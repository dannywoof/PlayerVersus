# The roster of PLAYER VERSUS: every fighter's numbers, moves, special bar and look.
#
# To add a fighter, write a function like the ones below and add it to `build()`: the
# character select grid, the HUD and the CPU all read from ROSTER, so nothing else needs
# to change unless the fighter needs a brand new kind of special, head or weapon.
#
# Nothing here opens a window, so tests can import it on their own.
import aperture as ap
import math

# --- How a move is animated ------------------------------------------------------------------
const int ANIM_SWING = 0      # a slash down across the body
const int ANIM_THRUST = 1     # a straight stab
const int ANIM_PUNCH = 2      # a straight punch (alternating fists on multi-hit moves)
const int ANIM_SHOOT = 3      # arm level, recoil per shot
const int ANIM_CAST = 4       # both arms up, then thrown open
const int ANIM_SLAM = 5       # both arms overhead, then down
const int ANIM_BITE = 6       # a grab with both arms
const int ANIM_SPIT = 7       # head back, then forward
const int ANIM_BACKSWING = 8  # the slash coming back the other way
const int ANIM_CROSS = 9      # a punch with the other hand
const int ANIM_HOOK = 10      # a wide swinging punch
const int ANIM_UPPERCUT = 11  # from the knees, upward
const int ANIM_SPIN = 12      # a full turn, weapon out
const int ANIM_POUNCE = 13    # a leap, arms wide
const int ANIM_CHARGE = 14    # shoulder down, running
const int ANIM_THROW = 15     # an overarm lob
const int ANIM_ROLL = 16      # tucked and tumbling
const int ANIM_COUNTER = 17   # a still guard, then a stab
const int ANIM_PLANT = 18     # kneeling to set something down
const int ANIM_FOCUS = 19     # arms pulled in, then flung down: powering up
const int ANIM_TWIRL = 20     # the gun spun in the hand; set off, it snaps level and fires

# --- What a move launches (0 is a melee hit) ---------------------------------------------------
