pad.button("super", ap.KEY_G, ap.PAD_LEFT_SHOULDER)
pad.button("block", ap.KEY_F, ap.PAD_RIGHT_SHOULDER)
pad.button("dash", ap.KEY_Q, ap.PAD_SOUTH)

# --- Small helpers -----------------------------------------------------------------------------

# An angle between -180 and 180 degrees.
function wrap(double angle) returns double
    var r = (angle + 540) % 360
    if r < 0 do
        r += 360
    end
    return r - 180
end
function forward_of(double heading) returns ap.Vec3
    var a = heading * math.PI / 180
    return ap.Vec3(math.sin(a), 0, math.cos(a))
end
function heading_of(ap.Vec3 way) returns double
    return math.atan2(way.x, way.z) * 180 / math.PI
end
function flat(ap.Vec3 v) returns ap.Vec3
    return ap.Vec3(v.x, 0, v.z)
end
function flat_distance(ap.Vec3 a, ap.Vec3 b) returns double
    return flat(a - b).length()
end
function unit(ap.Vec3 v) returns ap.Vec3
    if v.length() < 0.0001 do
        return ap.Vec3(0, 0, 0)
    end
    return v.normalized()
end
function other(Fighter f) returns Fighter
    return fighters[1 - f.id]
end

# 2v2: side `side`'s second fighter, or its first when it has none.
function partner_of(int side) returns Fighter
    for m in minions do
        if m.partner and m.id == side do
            return m
        end
    end
    return fighters[side]
end
function has_partner(int side) returns bool
    return partner_of(side) != fighters[side]
end

# The fighters of side `side` (one, or two in a 2v2).
function side_fighters(int side) returns Fighter[]
    Fighter[] out = [fighters[side]]
    if has_partner(side) do
        out.push(partner_of(side))
    end
    return out
end

# Every fighter that items and rounds apply to: both sides' first fighters and any partners.
function everyone() returns Fighter[]
    Fighter[] out = []
    for f in fighters do
        out.push(f)
    end
    for m in minions do
        if m.partner do
            out.push(m)
        end
    end
    return out
end

# Who `f` is fighting: their opponent, or in a 2v2 whichever of the two they are after (the
# other one if that one is down).
function foe_of(Fighter f) returns Fighter
    var side = 1 - f.id
    if not has_partner(side) do
        return fighters[side]
    end
    var first = fighters[side]
    var second = partner_of(side)
    var chosen = f.aim
    if not f.cpu do
        chosen = player_aim
    end
    var want = first if chosen == 0 else second
    if want.state == STATE_DOWN do
        return second if want == first else first
    end
    return want
end

# Whether a side still has someone standing.
function side_standing(int side) returns bool
    for g in side_fighters(side) do
        if g.state != STATE_DOWN do
            return true
        end
    end
    return false
end

# Whether the select screen picks more than one fighter a side.
function uses_teams() returns bool
    return lineup == LINE_TEAM or duo
end

function endless() returns bool
    return length_kind == LEN_ENDLESS
end

# Whether the fighters are dealt rather than picked.
function randomized() returns bool
    return lineup == LINE_RANDOM or lineup == LINE_RANDOM_TEAM
end

# Whether a lost round sends in the next fighter of a team.
function team_play() returns bool
    return lineup == LINE_TEAM or lineup == LINE_RANDOM_TEAM
end

# A team's size: one fighter for every round a side can lose and still be in it (one more in 2v2,
# where two fight at once), or the size chosen for an Endless random team.
function team_size() returns int
    if endless() do
        return team_of
    end
    return wins_needed() + (1 if duo else 0)
end

# Whether the fighters choice `k` goes with the length chosen: a team needs rounds to lose, so
# TEAM wants a best of; a random team is dealt in a best of or in Endless.
function lineup_open(int k) returns bool
    if k == LINE_TEAM do
        return length_kind == LEN_BEST
    end
    if k == LINE_RANDOM_TEAM do
        return length_kind != LEN_SINGLE
    end
    return true
end

# The full name of the setup chosen: "2V2 BEST OF 5, TEAMS OF 4".
function mode_title() returns string
    var words = "ENDLESS" if endless() else ("SINGLE ROUND" if length_kind == LEN_SINGLE else "BEST OF {best_of}")
    if lineup == LINE_TEAM do
        words = "{words}, TEAMS OF {team_size()}"
    else if lineup == LINE_RANDOM do
        words = "{words}, RANDOM"
    else if lineup == LINE_RANDOM_TEAM do
        words = "{words}, RANDOM TEAMS OF {team_size()}"
    end
    return "2V2 {words}" if duo else words
end

# Whether the setup is the plain default (1v1, best of 3, one fighter each).
function plain_setup() returns bool
    return not duo and length_kind == LEN_BEST and best_of == 3 and lineup == LINE_ONE
end
function pips(roster.Character kit, double bar) returns int
    return int(bar + 0.001) if kit.bar_pips else int(bar)
end

function left_pressed() returns bool
    return ap.key_pressed(ap.KEY_A) or ap.key_pressed(ap.KEY_LEFT) or ap.pad_pressed(ap.PAD_LEFT)
end
function right_pressed() returns bool
    return ap.key_pressed(ap.KEY_D) or ap.key_pressed(ap.KEY_RIGHT) or ap.pad_pressed(ap.PAD_RIGHT)
end
function up_pressed() returns bool
    return ap.key_pressed(ap.KEY_W) or ap.key_pressed(ap.KEY_UP) or ap.pad_pressed(ap.PAD_UP)
end
function down_pressed() returns bool
    return ap.key_pressed(ap.KEY_S) or ap.key_pressed(ap.KEY_DOWN) or ap.pad_pressed(ap.PAD_DOWN)
end
function confirm_pressed() returns bool
    return ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_R) or ap.key_pressed(ap.KEY_SPACE) or
        ap.pad_pressed(ap.PAD_SOUTH) or ap.pad_pressed(ap.PAD_START)
end
function back_pressed() returns bool
    return ap.key_pressed(ap.KEY_ESCAPE) or ap.key_pressed(ap.KEY_BACKSPACE) or ap.pad_pressed(ap.PAD_EAST)
end

function go(int to)
    screen = to
    screen_ticks = 0
end

# --- Effects -----------------------------------------------------------------------------------

function spark(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double size, double gravity)
    if sparks.length < 900 do
        sparks.push(Spark(at, velocity, color, life, life, size, gravity))
    end
end
function burst(ap.Vec3 at, int count, ap.Color color, double speed, double life = 0.45, double size = 0.08)
    for i in 0..<count do
        var way = unit(ap.Vec3(ap.random(-1, 1), ap.random(-0.4, 1), ap.random(-1, 1)))
        spark(at, way * (speed * ap.random(0.35, 1)), color, life * ap.random(0.6, 1), size, 7)
    end
end
function say(ap.Vec3 at, string words, ap.Color color)
    floaters.push(Floater(at + ap.Vec3(ap.random(-0.2, 0.2), 0.3, 0), words, color))
end
function sound_at(ap.Sound sound, ap.Vec3 at, double volume = 0.6, double pitch = 1)
    # CLOCKWORK's wind bends every sound with the fight.
    var bent = time_scale if screen == SCREEN_FIGHT else 1.0
    sound.play_at(at + ap.Vec3(0, 1, 0), volume, pitch * bent * ap.random(0.94, 1.06), 6, 0)
end

function blade_weapon(int weapon) returns bool
    return weapon == roster.WEAPON_DAGGER or weapon == roster.WEAPON_RAPIER or
        weapon == roster.WEAPON_KATANA or weapon == roster.WEAPON_CROOK or
        weapon == roster.WEAPON_STAFF or weapon == roster.WEAPON_SABER or weapon == roster.WEAPON_SAW or
        weapon == roster.WEAPON_SCYTHE or weapon == roster.WEAPON_CUTLASS or weapon == roster.WEAPON_PITCHFORK or
        weapon == roster.WEAPON_CLOCKBLADES or weapon == roster.WEAPON_FEATHERS or weapon == roster.WEAPON_SHIELD or
        weapon == roster.WEAPON_BROKEN or weapon == roster.WEAPON_CARDS
end

function weapon_swing_sound(Fighter f) returns ap.Sound
    if blade_weapon(f.kit.look.weapon) do
        if f.serial % 3 == 0 do
            return snd_blade_swing1
        else if f.serial % 3 == 1 do
            return snd_blade_swing2
        end
        return snd_blade_swing3
    else if f.kit.look.weapon == roster.WEAPON_FISTS or f.kit.look.weapon == roster.WEAPON_CLAWS or
            f.kit.look.weapon == roster.WEAPON_CANNON or f.kit.look.weapon == roster.WEAPON_GAUNTLET or
            f.kit.look.weapon == roster.WEAPON_DUMBBELL or f.kit.look.weapon == roster.WEAPON_KEY or
            f.kit.look.weapon == roster.WEAPON_HANDS do
        if f.serial % 2 == 0 do
            return snd_swing_file1
        end
        return snd_swing_file2
    end
    return snd_swing
end

function weapon_fire_sound(Fighter f) returns ap.Sound
    var weapon = f.kit.look.weapon
    if weapon == roster.WEAPON_REVOLVER do
        return snd_revolver1 if f.hits_done % 2 == 0 else snd_revolver2
    else if weapon == roster.WEAPON_SHOTGUN do
        return snd_shotgun1 if f.hits_done % 2 == 0 else snd_shotgun2
    else if weapon == roster.WEAPON_GUN do
        if f.hits_done % 3 == 0 do
            return snd_pistol1
        else if f.hits_done % 3 == 1 do
            return snd_pistol2
        end
        return snd_pistol3
    else if weapon == roster.WEAPON_DEVICE or weapon == roster.WEAPON_SABER do
        return snd_zap_file if weapon == roster.WEAPON_DEVICE else snd_beam_file
    else if weapon == roster.WEAPON_CROSSBOW or weapon == roster.WEAPON_KEY do
        return snd_lock
    end
    return snd_shot
end

function weapon_hit_sound(Fighter f, bool heavy, bool melee) returns ap.Sound
    if melee and blade_weapon(f.kit.look.weapon) do
        if f.hits_done % 3 == 0 do
            return snd_blade_hit1
        else if f.hits_done % 3 == 1 do
            return snd_blade_hit2
        end
        return snd_blade_hit3
    else if melee and (f.kit.look.weapon == roster.WEAPON_FISTS or
            f.kit.look.weapon == roster.WEAPON_CLAWS or f.kit.look.weapon == roster.WEAPON_CANNON or
            f.kit.look.weapon == roster.WEAPON_GAUNTLET or f.kit.look.weapon == roster.WEAPON_DUMBBELL or
            f.kit.look.weapon == roster.WEAPON_KEY or f.kit.look.weapon == roster.WEAPON_FLAIL or
            f.kit.look.weapon == roster.WEAPON_HANDS) do
        if f.hits_done % 3 == 0 do
            return snd_punch1
        else if f.hits_done % 3 == 1 do
            return snd_punch2
        end
        return snd_punch3
    end
    return snd_heavy if heavy else snd_hit
end

# A thin line of light flying along its own length.
function streak(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double length, double size = 0.05)
    if sparks.length < 900 do
        sparks.push(Spark(at, velocity, color, life, life, size, 0, length))
    end
end
function scatter(double amount) returns ap.Vec3
    return ap.Vec3(ap.random(-amount, amount), ap.random(-amount, amount), ap.random(-amount, amount))
end
# Sparks drawn in toward a point from `from` meters away.
function gather(ap.Vec3 to, int count, ap.Color color, double from, double life = 0.22, double size = 0.07)
    for i in 0..<count do
        var way = unit(scatter(1))
        spark(to + way * from, way * (-from / life), color, life, size, 0)
    end
end
function smoke(ap.Vec3 at, int count, double spread, double life = 0.9)
    for i in 0..<count do
        var shade = int(ap.random(70, 130))
        puff(at + scatter(spread), ap.Vec3(ap.random(-0.5, 0.5), ap.random(0.4, 1.4), ap.random(-0.5, 0.5)),
            ap.Color(shade, shade, shade + 12), life * ap.random(0.6, 1), 0.12, 0.22)
    end
end
# A puff of smoke: it swells, slows, and drifts up as it fades.
function puff(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double size, double grow)
    if sparks.length < 900 do
        var s = Spark(at, velocity, color, life, life, size, -0.35)
        s.grow = grow
        s.drag = 1.6
        sparks.push(s)
    end
end

# The flash of a gun going off: a ball of light, a star of fire along the barrel, embers, and
# smoke that hangs in the air and rolls upward. `big` for shotguns and hand cannons.
function muzzle_flash(ap.Vec3 from, ap.Vec3 aim, bool big)
    var fire = ap.Color(255, 226, 150)
    var way = unit(aim)
    rings.push(Ring(from + way * 0.15, ap.Color(255, 240, 200), 3.5 if big else 2.2, 0.07, true))
    for i in 0..<(10 if big else 6) do
        var off = way + scatter(0.22 if big else 0.12)
        streak(from + way * 0.1, unit(off) * ap.random(7, 13), fire if i % 3 != 0 else ap.WHITE, ap.random(0.04, 0.08),
            ap.random(0.25, 0.5) * (1.5 if big else 1.0), 0.05)
    end
    # A cross of side flare, like a muzzle brake.
    var side = ap.Vec3(way.z, 0, -way.x)
    for k in [-1.0, 1.0] do
        streak(from + way * 0.12, (side * k + way * 0.3) * ap.random(3, 5), fire, 0.05, 0.2, 0.04)
    end
    for i in 0..<(6 if big else 3) do
        spark(from + scatter(0.05), (way + scatter(0.5)) * ap.random(1.5, 3.5) + ap.Vec3(0, 0.8, 0),
            ap.Color(255, 160, 70), ap.random(0.3, 0.6), 0.03, 6)
    end
    for i in 0..<(9 if big else 5) do
        var shade = int(ap.random(105, 160))
        puff(from + way * ap.random(0.1, 0.5) + scatter(0.06), way * ap.random(0.8, 2.6) + ap.Vec3(0, ap.random(0.2, 0.6), 0) +
            scatter(0.2), ap.Color(shade, shade, shade + 8), ap.random(0.9, 1.6) * (1.3 if big else 1.0), 0.06, ap.random(0.18, 0.32))
    end
end
function stain(ap.Vec3 at, ap.Color color, double radius, double life, double strength, bool bubbles = false)
    if flat(at).length() < ARENA + 0.5 and marks.length < 12 do
        marks.push(Mark(ap.Vec3(at.x, 0.03, at.z), color, radius, life, life, strength, bubbles))
    end
end
function later(ap.Sound sound, ap.Vec3 at, int wait, double volume = 0.5, double pitch = 1)
    cues.push(Cue(sound, at, wait, volume, pitch))
end
function leave_ghost(Fighter f, double life)
    if f.cpu and mx(f).vanish do
        return
    end
    ghosts.push(Ghost(f.kit.look, fighter_pose(f), f.body.position, f.heading, life, life))
end
# The right-hand side of a fighter facing `heading`.
function right_of(double heading) returns ap.Vec3
    var a = heading * math.PI / 180
    return ap.Vec3(-math.cos(a), 0, math.sin(a))
end

function update_effects()
    var dt = 1.0 / 60
    Ghost[] lingering = []
    for g in ghosts do
        g.life -= dt
        if g.life > 0 do
            lingering.push(g)
        end
    end
    ghosts = lingering
    Mark[] staying = []
    for m in marks do
        m.life -= dt
        if m.bubbles and ap.chance(0.18) do
            spark(m.position + ap.Vec3(ap.random(-0.6, 0.6) * m.radius, 0.03, ap.random(-0.6, 0.6) * m.radius),
                ap.Vec3(0, ap.random(0.4, 1.0), 0), m.color, 0.5, 0.06, 0)
        end
        if m.life > 0 do
            staying.push(m)
        end
    end
    marks = staying
    Cue[] waiting = []
    for c in cues do
        c.wait -= 1
        if c.wait <= 0 do
            sound_at(c.sound, c.position, c.volume, c.pitch)
        else do
            waiting.push(c)
        end
    end
    cues = waiting
    Spark[] alive = []
    for s in sparks do
        s.life -= dt
        if s.life > 0 do
            s.velocity = s.velocity - ap.Vec3(0, s.gravity * dt, 0)
            if s.drag > 0 do
                s.velocity = s.velocity * math.max(1 - s.drag * dt, 0.0)
            end
            s.size += s.grow * dt
            s.position = s.position + s.velocity * dt
            if s.position.y < 0.03 and s.gravity > 0 and flat(s.position).length() < ARENA + 1 do
                s.position = ap.Vec3(s.position.x, 0.03, s.position.z)
                s.velocity = ap.Vec3(s.velocity.x * 0.6, 0, s.velocity.z * 0.6)
            end
            alive.push(s)
        end
    end
    sparks = alive
    Ring[] growing = []
    for r in rings do
        r.life -= dt
        r.radius += r.grow * dt
        if r.life > 0 do
            growing.push(r)
        end
    end
    rings = growing
    Floater[] rising = []
    for f in floaters do
        f.life -= dt
        f.position = f.position + ap.Vec3(0, 0.9 * dt, 0)
        if f.life > 0 do
            rising.push(f)
        end
    end
    floaters = rising
    for i in 0..<souls.length do
        var s = souls[i]
        var y = s.y + drift_now * dt
        if y > 12 do
            y = -2
        else if y < -2 do
            y = 12
        end
        souls[i] = ap.Vec3(s.x, y, s.z)
    end
end

# --- A match -----------------------------------------------------------------------------------

function new_fighter(int id, int pick) returns Fighter
    # Their own copy of the fighter, since a copycat rewrites its moves.
    var kit = roster.build()[pick]
    var body = ap.Body(ap.Vec3(0, 0, 3.5 if id == 0 else -3.5))
    body.radius = 0.36 * kit.look.bulk
    body.height = 1.8 * kit.look.tall
    var f = Fighter(id, kit, body, kit.basics[0])
    f.cooldowns = [0, 0, 0, 0]
    f.pose = puppet.Pose()
    f.cpu = id == 1
    f.pick = pick
    f.max_health = kit.health
    return f
end

function start_match()
    if randomized() do
        deal_teams()
    end
    if uses_teams() or randomized() do
        picks = [teams[0][0], teams[1][0]]
    end
    partner_picks = [-1, -1]
    if duo do
        partner_picks = [teams[0][1], teams[1][1]]
    end
    fighters = [new_fighter(0, picks[0]), new_fighter(1, picks[1])]
    side_items = [[], []]
    select_world = -1
    set_area(0)
    round = 1
    paused = false
    admin_open = false
    banner_sub = ""
    match_seed = pick_index(music.FIGHT_TRACKS.length)
    start_round()
    go(SCREEN_FIGHT)
end

# --- Items ---------------------------------------------------------------------------------------
# Every item is data (items.fw): a condition and some effects. Each tick a fighter's effects are
# added up once (refresh_stats), and the game reads the sums with `st`. Items written in Flywheel
# (custom_items.fw) also run their hooks: code_tick, code_hit, code_hurt.

# Every item there is, in the order the item menu lists them.
function gather_items()
    items.ItemDef[] all = items.builtins()
    for i, s in saved.simple do
        var it = items.ItemDef(1000 + i, s.name.upper(), s.flavor, s.condition, s.param)
        items.Effect[] list = []
        for k in 0..<math.min(s.kinds.length, s.amounts.length) do
            list.push(items.Effect(s.kinds[k], s.amounts[k]))
        end
        it.effects = list
        it.source = items.SOURCE_SIMPLE
        it.tier = items.TIER_RARE
        all.push(it)
    end
    for i, c in custom.items() do
        var it = items.ItemDef(2000 + i, c.name.upper(), "Written in Flywheel.")
        it.source = items.SOURCE_CODE
        it.code_id = c.id
        it.code_note = c.note
        it.tier = items.TIER_RARE
        all.push(it)
    end
    item_defs = all
end
gather_items()

function item_on(int index) returns bool
    return not (items.key_of(item_defs[index]) in saved.off)
end

# Indexes of the items that can be offered.
function item_pool() returns int[]
    int[] pool = []
    for i in 0..<item_defs.length do
        if item_on(i) do
            pool.push(i)
        end
    end
    return pool
end

function side_of_items(Fighter f) returns int[]
    if f.minion or f.id >= side_items.length do
        return []
    end
    return side_items[f.id]
end

# What the conditions see: filled in once a tick for each fighter.
function situation(Fighter f) returns items.Situation
    var s = items.Situation()
    var o = foe_of(f)
    s.health = f.health / math.max(f.max_health, 1.0)
    s.foe_health = o.health / math.max(o.max_health, 1.0)
    s.foe_poisoned = o.poison > 0
    s.foe_slowed = o.slow > 0
    s.rounds_behind = math.max(fighters[1 - f.id].wins - fighters[f.id].wins, 0) if fighters.length == 2 else 0
    s.rounds_ahead = math.max(fighters[f.id].wins - fighters[1 - f.id].wins, 0) if fighters.length == 2 else 0
    s.my_super = max_owner == f.id or merge_owner == f.id
    s.their_super = (max_owner >= 0 and max_owner != f.id) or (merge_owner >= 0 and merge_owner != f.id)
    s.distance = flat_distance(f.body.position, o.body.position)
    s.moving = f.moving > 0.5 or f.state == STATE_DASH
    s.blocking = f.state == STATE_BLOCK
    s.since_parry = double(f.since_parry) / 60
    s.since_hurt = double(f.since_hit) / 60
    s.combo = f.combo if f.combo_show > 0 else 0
    s.round_time = double(f.round_ticks) / 60
    s.clock = double(clock) / 60
    s.decider = decider()
    s.bar = f.bar / math.max(f.kit.bar_max, 1.0)
    s.behind_foe = not ap.in_cone(o.body.position, forward_of(o.heading), f.body.position, 200)
    s.foe_airborne = not o.body.grounded and o.body.position.y > 0.3
    s.super_ready = f.energy >= roster.SUPER_MAX
    return s
end

function refresh_stats(Fighter f)
    f.sit = situation(f)
    f.stats = items.totals(item_defs, side_of_items(f), f.sit)
end

# An item effect, added up over everything this fighter's side holds (0 when nothing).
function st(Fighter f, int kind) returns double
    if kind >= f.stats.length do
        return 0
    end
    return f.stats[kind]
end

# The round-start effects (health, shield, the super head start) for the items held now.
function round_stats(Fighter f) returns double[]
    var s = items.Situation()
    s.decider = decider()
    s.rounds_behind = math.max(fighters[1 - f.id].wins - fighters[f.id].wins, 0)
    s.rounds_ahead = math.max(fighters[f.id].wins - fighters[1 - f.id].wins, 0)
    return items.totals(item_defs, side_of_items(f), s)
end

# Health for the round: the kit's, doubled in a decider, trimmed in a 2v2, and whatever items add.
function round_health(Fighter f) returns double
    var base = f.kit.health * (DECIDER_HEALTH if decider() else 1.0) * (DUO_HEALTH if duo else 1.0)
    return base * items.more(round_stats(f)[items.E_HEALTH], 0.3)
end

function arm_items(Fighter f)
    var rs = round_stats(f)
    f.max_health = round_health(f)
    f.health = f.max_health
    f.shown_health = f.max_health
    f.shield = rs[items.E_SHIELD]
    f.item_revived = false
    var head = rs[items.E_SUPER_START]
    if head > 0 and not f.partner do
        f.energy = math.max(f.energy, math.min(head, roster.SUPER_MAX))
    end
    refresh_stats(f)
end

# --- Flywheel items: the hooks in custom_items.fw.
function code_items_held(Fighter f) returns items.ItemDef[]
    items.ItemDef[] out = []
    for index in side_of_items(f) do
        if index >= 0 and index < item_defs.length and item_defs[index].source == items.SOURCE_CODE do
            out.push(item_defs[index])
        end
    end
    return out
end

function code_ctx(Fighter f) returns api.Ctx
    var o = foe_of(f)
    var c = api.Ctx()
    c.health = f.health
    c.max_health = f.max_health
    c.foe_health = o.health
    c.foe_max_health = o.max_health
    c.bar = f.bar
    c.bar_max = f.kit.bar_max
    c.super_bar = f.energy
    c.distance = flat_distance(f.body.position, o.body.position)
    c.moving = f.moving > 0.5
    c.blocking = f.state == STATE_BLOCK
    c.foe_poisoned = o.poison > 0
    c.foe_slowed = o.slow > 0
    c.foe_airborne = not o.body.grounded and o.body.position.y > 0.3
    c.combo = f.combo if f.combo_show > 0 else 0
    c.rounds_won = fighters[f.id].wins
    c.rounds_lost = fighters[1 - f.id].wins
    c.round_time = double(f.round_ticks) / 60
    c.clock = double(clock) / 60
    c.ticks = f.round_ticks
    return c
end

function hex_color(string hex) returns ap.Color
    var digits = "0123456789abcdef"
    var h = hex.lower().replace("#", "")
    if h.length != 6 do
        return ap.WHITE
    end
    int[] v = []
    for i in 0..<6 do
        v.push(math.max(digits.find(h[i..i]), 0))
    end
    return ap.Color(v[0] * 16 + v[1], v[2] * 16 + v[3], v[4] * 16 + v[5])
end

# What a hook asked for, done.
function code_apply(Fighter f, api.Ctx c)
    var o = foe_of(f)
    var tint = hex_color(c.color)
    if c.heal > 0 and f.state != STATE_DOWN do
        f.health = math.min(f.health + c.heal, f.max_health)
    end
    if c.hurt_self > 0 do
        f.health = math.max(f.health - c.hurt_self, 1.0)
    end
    if c.hurt_foe > 0 and o.state != STATE_DOWN and phase == PHASE_FIGHT do
        o.health -= c.hurt_foe
    end
    if c.poison > 0 and not o.kit.machine do
        o.poison = math.min(o.poison + c.poison, roster.POISON_LIMIT)
    end
    if c.slow > 0 and not o.kit.machine do
        o.slow = math.max(o.slow, c.slow)
    end
    f.bar = math.clamp(f.bar + c.bar_gain, 0.0, f.kit.bar_max)
    if not f.partner do
        f.energy = math.clamp(f.energy + c.super_gain, 0.0, roster.SUPER_MAX)
    end
    if c.launch > 0 and o.state == STATE_HURT do
        o.body.velocity = ap.Vec3(o.body.velocity.x, math.max(o.body.velocity.y, c.launch), o.body.velocity.z)
    end
    if c.say != "" do
        say(f.body.top() + ap.Vec3(0, 0.3, 0), c.say, tint)
    end
    if c.sparks > 0 do
        burst(f.body.center(), math.min(c.sparks, 60), tint, 4, 0.45, 0.08)
    end
end

function code_tick(Fighter f)
    f.code_speed = 1
    f.code_power = 1
    f.code_armor = 1
    for it in code_items_held(f) do
        var c = code_ctx(f)
        custom.tick(it.code_id, c)
        f.code_speed *= math.clamp(c.speed, 0.1, 5.0)
        f.code_power *= math.clamp(c.power, 0.0, 10.0)
        f.code_armor *= math.clamp(c.armor, 0.0, 10.0)
        code_apply(f, c)
    end
end

# The holder lands a hit worth `damage`: what the hooks make of it.
function code_hit(Fighter f, roster.Attack a, bool melee, double damage) returns double
    var out = damage
    for it in code_items_held(f) do
        var c = code_ctx(f)
        c.melee = melee
        c.basic = is_basic(f, a)
        c.move = a.name
        c.damage = out
        custom.hit(it.code_id, c)
        out = math.max(c.damage, 0.0)
        code_apply(f, c)
    end
    return out
end

function code_hurt(Fighter o, roster.Attack a, bool melee, double damage) returns double
    var out = damage
    for it in code_items_held(o) do
        var c = code_ctx(o)
        c.melee = melee
        c.move = a.name
        c.damage = out
        custom.hurt(it.code_id, c)
        out = math.max(c.damage, 0.0)
        code_apply(o, c)
    end
    return out
end

# --- The draft: before the intro, whoever the item option allows picks one of two.

# Two different items from the pool, avoiding what `avoid` holds when it can.
function deal_offer(int side, int[] avoid) returns int[]
    var pool = item_pool()
    if pool.length == 0 do
        return []
    end
    int[] fresh = []
    for i in pool do
        if not (i in avoid) do
            fresh.push(i)
        end
    end
    if fresh.length >= 2 do
        pool = fresh
    end
    var a = pool[pick_index(pool.length)]
    if pool.length == 1 do
        return [a]
    end
    var b = a
    while b == a do
        b = pool[pick_index(pool.length)]
    end
    return [a, b]
end

function begin_draft()
    drafting = [false, false]
    rerolled = [false, false]
    if item_pool().length == 0 do
        return
    end
    if items_mode == ITEMS_ON do
        drafting = [true, true]
    else if items_mode == ITEMS_LOSING and fighters[0].wins != fighters[1].wins do
        drafting[0 if fighters[0].wins < fighters[1].wins else 1] = true
    end
    if not drafting[0] and not drafting[1] do
        return
    end
    for i in 0..<2 do
        offers[i] = deal_offer(i, [])
    end
    draft_cursor = 0
    draft_ticks = 0
    phase = PHASE_DRAFT
end

function take_item(int side, int choice)
    var index = offers[side][math.min(choice, offers[side].length - 1)]
    side_items[side].push(index)
    drafting[side] = false
    var f = fighters[side]
    var it = item_defs[index]
    say(f.body.top() + ap.Vec3(0, 0.3, 0), it.name, tier_color(it.tier))
    sound_at(snd_shimmer, f.body.position, 0.6, 1.2)
    sound_at(snd_coin_a if it.tier == items.TIER_COMMON else snd_chip_stack, f.body.position, 0.5, 1.1)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), tier_color(it.tier), 5, 0.4))
    gather(f.body.center(), 16, tier_color(it.tier), 1.4, 0.3, 0.07)
end

# A new pair of items, once per pick.
function reroll(int side)
    if rerolled[side] do
        return
    end
    rerolled[side] = true
    offers[side] = deal_offer(side, offers[side])
    if side == 0 do
        sound_at(snd_shuffle, fighters[0].body.position, 0.6)
        later(snd_card, fighters[0].body.position, 14, 0.5)
        draft_cursor = 0
        draft_ticks = 15
    end
end

function tier_color(int tier) returns ap.Color
    if tier == items.TIER_CURSED do
        return ap.Color(255, 110, 120)
    else if tier == items.TIER_RARE do
        return ap.Color(120, 200, 255)
    end
    return ap.Color(150, 225, 120)
end

function update_draft()
    draft_ticks += 1
    for i in 0..<2 do
        if drafting[i] and fighters[i].cpu and draft_ticks > 45 + i * 15 do
            # The CPU sometimes doesn't like what it sees.
            if not rerolled[i] and ap.chance(0.25) do
                reroll(i)
            else do
                take_item(i, pick_index(offers[i].length))
            end
        end
    end
    if drafting[0] and not fighters[0].cpu do
        var choices = offers[0].length + (0 if rerolled[0] else 1)
        if left_pressed() do
            draft_cursor = (draft_cursor + choices - 1) % choices
            snd_move.play(0.5)
        end
        if right_pressed() do
            draft_cursor = (draft_cursor + 1) % choices
            snd_move.play(0.5)
        end
        if (ap.key_pressed(ap.KEY_E) or ap.pad_pressed(ap.PAD_NORTH)) and not rerolled[0] do
            reroll(0)
        end
        # The mouse: hover a card, click to take it (or the reroll).
        var m = ap.mouse()
        if ap.mouse_delta().length() > 0.5 do
            for k in 0..<choices do
                if draft_card(k).contains(m) do
                    draft_cursor = k
                end
            end
        end
        var clicked = ap.mouse_pressed() and draft_card(draft_cursor).contains(m)
        if draft_ticks > 15 and (confirm_pressed() or clicked) do
            if draft_cursor >= offers[0].length do
                reroll(0)
            else do
                snd_pick.play(0.5)
                take_item(0, draft_cursor)
            end
        end
    end
    if not drafting[0] and not drafting[1] do
        if draft_ticks < 1000 do
            draft_ticks = 1000
        end
        if draft_ticks > 1030 do
            # Picks made: health comes up to whatever the items now give, and the round begins.
            for f in everyone() do
                arm_items(f)
            end
            phase = PHASE_INTRO
            phase_ticks = 0
            pad.clear()
        end
    end
end

# Where draft card `k` is on the screen (the last, past the items, is the reroll).
function draft_card(int k) returns ap.Rect
    var count = offers[0].length
    if k >= count do
        return ap.Rect(270, 222, 100, 16)
    end
    var w = 212.0
    var x = 320 - (double(count) * (w + 24) - 24) / 2 + double(k) * (w + 24)
    return ap.Rect(x, 128, w, 86)
end

function draw_draft_hud()
    var title = "ROUND {round}: CHOOSE AN ITEM"
    if not drafting[0] and drafting[1] do
        title = "{fighters[1].kit.name} CHOOSES AN ITEM"
    else if not drafting[0] and not drafting[1] do
        title = "ITEMS CHOSEN"
    end
    ap.rect(0, 96, VW, 172, ap.BLACK.fade(0.6))
    label_centered(title, 320, 104, 16, MAX_GOLD)
    if drafting[0] and not fighters[0].cpu do
        var rise = math.min(double(draft_ticks % 1000) / 12, 1.0)
        for k in 0..<offers[0].length do
            var it = item_defs[offers[0][k]]
            var r = draft_card(k)
            var chosen = k == draft_cursor
            var tint = tier_color(it.tier)
            var y = r.y + (1 - puppet.ease(rise)) * 16 - (3.0 if chosen else 0.0)
            ap.rect(r.x, y, r.w, r.h, ap.Color(24, 20, 36).fade(0.95))
            ap.gradient(r.x, y, r.w, 14, tint.brightness(0.45).fade(0.7), ap.Color(24, 20, 36).fade(0))
            ap.rect_lines(r.x, y, r.w, r.h, 2 if chosen else 1, MAX_GOLD if chosen else tint.brightness(0.6))
            label_centered(it.name, r.x + r.w / 2, y + 8, 16 if chosen else 8, ap.WHITE if chosen else ap.Color(190, 185, 210))
            var lines = wrap_words(items.describe(it), 32)
            for n, line in lines do
                label_centered(line, r.x + r.w / 2, y + 30 + double(n) * 10, 8, tint)
            end
            if it.flavor != "" and ap.measure(it.flavor, 8).x < r.w - 8 do
                label_centered(it.flavor, r.x + r.w / 2, y + r.h - 12, 8, ap.Color(120, 116, 140))
            end
        end
        var rr = draft_card(offers[0].length)
        if not rerolled[0] do
            var on = draft_cursor >= offers[0].length
            ap.rect(rr.x, rr.y, rr.w, rr.h, ap.Color(24, 20, 36).fade(0.95))
            ap.rect_lines(rr.x, rr.y, rr.w, rr.h, 2 if on else 1, MAX_GOLD if on else ap.Color(90, 86, 110))
            label_centered("E  REROLL (1)", rr.x + rr.w / 2, rr.y + 4, 8, ap.WHITE if on else ap.Color(170, 165, 190))
        else do
            label_centered("REROLLED", rr.x + rr.w / 2, rr.y + 4, 8, ap.Color(110, 106, 130))
        end
        label_centered("A / D  CHOOSE      R / ENTER / CLICK  TAKE IT", 320, 246, 8, ap.Color(170, 165, 190))
    else do
        label_centered("Waiting..." if drafting[1] else "", 320, 160, 8, ap.Color(170, 165, 190))
    end
    # What each side holds so far.
    for side in 0..<2 do
        var words = held_items(side)
        if words != "" do
            if side == 0 do
                label(words, 16, 258, 8, fighters[0].kit.look.accent)
            else do
                label_right(words, 624, 258, 8, fighters[1].kit.look.accent)
            end
        end
    end
end

# `words` broken into lines of at most `width` characters, at the spaces.
function wrap_words(string words, int width) returns string[]
    string[] lines = []
    var line = ""
    for word in words.split(" ") do
        if line != "" and line.length + 1 + word.length > width do
            lines.push(line)
            line = word
        else do
            line = word if line == "" else "{line} {word}"
        end
    end
    if line != "" do
        lines.push(line)
    end
    return lines
end

# A side's items, as a short list ("IRON SKIN x2, MOSS").
function held_items(int side) returns string
    var words = ""
    map<int, int> counts = {}
    int[] order = []
    for index in side_items[side] do
        if index in counts do
            counts[index] += 1
        else do
            counts[index] = 1
            order.push(index)
        end
    end
    for index in order do
        var it = item_defs[index]
        var n = counts[index]
        var one = it.name if n == 1 else "{it.name} x{n}"
        words = one if words == "" else "{words}, {one}"
    end
    return words
end

# Where a side's fighters stand at the start of a round: in a 2v2 the two of a side stand apart.
function start_spot(int side, bool second) returns ap.Vec3
    var z = 3.5 if side == 0 else -3.5
    if not duo do
        return ap.Vec3(0, 0, z)
    end
    var x = 1.7 if second else -1.7
    return ap.Vec3(x if side == 0 else -x, 0, z)
end

# Everything about a fighter that does not carry over into a new round.
function reset_fighter(Fighter f)
    var kit = f.kit
    f.body.position = start_spot(f.id, f.partner)
    f.body.velocity = ap.Vec3(0, 0, 0)
    f.heading = 180 if f.id == 0 else 0
    f.max_health = round_health(f)
    f.health = f.max_health
    f.shown_health = f.max_health
    if kit.mech != roster.MECH_FLASQUE do
        # FLASQUE's coins are kept from round to round.
        f.bar = kit.bar_start
    end
    f.arrows = kit.quiver
    f.state = STATE_IDLE
    f.frame = 0
    f.stun = 0
    f.poison = 0
    f.cloaked = false
    f.ambush = false
    f.fade = 1
    f.dash_cooldown = 0
    f.knock = ap.Vec3(0, 0, 0)
    f.ragdolled = false
    f.landed = false
    f.juggles = 0
    f.moving = 0
    f.cool = 40
    f.think = 0
    f.block_hold = 0
    f.last_seen = ap.Vec3(0, 0, -3.5 if f.id == 0 else 3.5)
    f.cooldowns = [0, 0, 0, 0]
    f.slot = SLOT_BASIC
    f.chain = 0
    f.taken = 0
    f.combo_show = 0
    f.buff = roster.BUFF_NONE
    f.slow = 0
    f.warp_cool = 0
    f.pressure = 0
    f.spam = 0
    f.since_hit = 999
    f.since_parry = 9999
    f.round_ticks = 0
    f.safe = 0
    f.settle = 1
    f.broke_ticks = 0
    f.revived = false
    f.item_revived = false
    f.shield = 0
    f.injects = 0
    f.clone_cool = 0
    f.decoy = -1
    f.encore_used = false
    f.trail = []
    f.trail_base = []
    f.aim = duo_aim(f) if duo else 0
    prepare_kit(f)
    wave_reset(f)
    refresh_stats(f)
end

# 2v2: the second fighter of a side, at full strength, played by the CPU.
function make_partner(int side, int pick) returns Fighter
    var g = new_fighter(side, pick)
    g.partner = true
    g.cpu = true
    reset_fighter(g)
    g.pose = target_pose(g)
    g.pose_speed = puppet.still()
    return g
end

function start_round()
    end_maximum()
    # Items last one round: last round's are gone before anything is worked out from them.
    side_items = [[], []]
    minions = []
    pickups = []
    props = []
    mirrors = []
    things = []
    time_scale = 1
    time_left = 0
    fire_left = 0
    announce_ticks = 0
    ap.stop(train_hum)
    train_hum = -1
    train_pulled = false
    train_brake = -1
    train_ride = 0
    for f in fighters do
        reset_fighter(f)
        if f.kit.lab do
            # The machine stands just behind them.
            var spot = f.body.position - forward_of(f.heading) * 2.4
            props.push(Prop(PROP_MACHINE, f.id, ap.Vec3(spot.x, 0, spot.z), 1.9, -1, 0, f.heading))
        end
        f.pose = target_pose(f)
        f.pose_speed = puppet.still()
    end
    if duo do
        for side in 0..<2 do
            if partner_picks[side] >= 0 do
                minions.push(make_partner(side, partner_picks[side]))
            end
        end
    end
    world = build_world()
    shots = []
    rings = []
    floaters = []
    ghosts = []
    marks = []
    cues = []
    hazards = []
    portals = []
    beams = []
    super_ticks = 0
    phase = PHASE_INTRO
    phase_ticks = 0
    clock = ROUND_SECONDS * 60
    clock_carry = 0
    banner = "FINALE" if finale_round() else "ROUND {round}"
    begin_draft()
    if decider() do
        banner_sub = "DOUBLE HEALTH" if banner_sub == "" else "{banner_sub}  -  DOUBLE HEALTH"
        banner_sub_color = MAX_GOLD
    end
    player_aim = duo_aim(fighters[0]) if duo else 0
    cam_yaw = 0
    cam_pitch = CAM_PITCH
    cam_reach = 1.0
    cam_foe = foe_of(fighters[0]).body.position
    pad.clear()
end

function refill()
    for f in fighters do
        if f.state != STATE_DOWN do
            f.health = f.max_health
            f.bar = f.kit.bar_max
            f.poison = 0
            f.slow = 0
            f.energy = roster.SUPER_MAX
            f.cooldowns = [0, 0, 0, 0]
        end
    end
end

# --- Attacks -----------------------------------------------------------------------------------

function attack_length(roster.Attack a, int hits) returns int
    return a.startup + (hits - 1) * a.interval + a.recovery
end
# Where in the move an attack is: 0..1 winding up, 1..2 striking, 2..3 recovering.
function attack_phase(roster.Attack a, int hits, int frame) returns double
    if frame < a.startup do
        return double(frame) / double(a.startup)
    end
    var into = frame - a.startup
    var striking = (hits - 1) * a.interval + 7
    if into < striking do
        if hits > 1 and into < hits * a.interval do
            return 1 + double(into % a.interval) / double(a.interval)
        end
        return 1 + math.min(double(into - (hits - 1) * a.interval) / 7, 0.99)
    end
    return 2 + math.min(double(into - striking) / double(math.max(a.recovery - 7, 1)), 0.99)
end
function attack_beat(roster.Attack a, int hits, int frame) returns int
    if frame < a.startup do
        return 0
    end
    return math.min((frame - a.startup) // a.interval, hits - 1)
end

function set_cloak(Fighter f, bool on)
    if f.cloaked == on do
        return
    end
    f.cloaked = on
    if not on do
        # The shroud needs a moment before it can be pulled back on.
        for i, a in f.kit.skills do
            if a.kind == roster.KIND_CLOAK do
                f.cooldowns[i] = a.cooldown
            end
        end
    end
    var here = f.body.position
    var tint = f.kit.look.accent
    sound_at(snd_cloak, here, 0.5, 1.0 if on else 1.5)
    if on do
        later(snd_wisp, here, 5, 0.4)
        smoke(f.body.center(), 8, 0.4, 0.9)
    else do
        later(snd_wisp, here, 2, 0.3, 1.6)
    end
    # The shroud winds up around the body going in, and unwinds outward coming off.
    for i in 0..<30 do
        var around = double(i) * 42
        var out = forward_of(around)
        var spin = forward_of(around + 90) * 1.8
        var rise = ap.Vec3(0, 0.9, 0) if on else out * 1.6
        spark(here + out * 0.55 + ap.Vec3(0, double(i) / 29 * 1.8 * f.kit.look.tall, 0), spin + rise,
            tint if i % 3 != 0 else ap.Color(120, 126, 124), ap.random(0.45, 0.85), 0.09, -0.4)
    end
    rings.push(Ring(here + ap.Vec3(0, 0.08, 0), tint, 4 if on else 7, 0.3))
end

function chest_of(Fighter f) returns ap.Vec3
    return f.body.position + ap.Vec3(0, 1.25 * f.kit.look.tall, 0)
end

# A skill is called on: its own sound, and a first sign of what is coming.
function skill_begins(Fighter f, roster.Attack a)
    var fx = a.fx
    var here = f.body.position
    var tint = f.kit.look.accent
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    if fx == roster.FX_FEAST do
        sound_at(snd_growl, here, 0.6)
        rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 4, 0.3))
    else if fx == roster.FX_RUSH do
        sound_at(snd_kiai, here, 0.5)
        burst(here + ap.Vec3(0, 0.1, 0), 8, ap.Color(150, 145, 170), 2.5, 0.35, 0.09)
    else if fx == roster.FX_SPIT do
        sound_at(snd_hiss, here, 0.6)
    else if fx == roster.FX_FLECHE do
        sound_at(snd_shing, here, 0.5)
        for i in 0..<8 do
            streak(hand + forward_of(f.heading) * 0.8, unit(scatter(1)) * 2.5, ap.WHITE, 0.2, 0.3)
        end
    else if fx == roster.FX_FAN do
        sound_at(snd_reload, here, 0.5, 1.7)
    else if fx == roster.FX_FLASH do
        sound_at(snd_rift, here, 0.6)
    else if fx == roster.FX_ROCKET do
        sound_at(snd_lock, here, 0.4)
        later(snd_lock, here, 7, 0.4, 1.25)
    else if fx == roster.FX_NOVA do
        sound_at(snd_charge, here, 0.6)
    else if fx == roster.FX_BOLT do
        sound_at(snd_charge, here, 0.35, 1.8)
    else if fx == roster.FX_CHAIN do
        sound_at(snd_lock, here, 0.5, 0.6)
    end
end

# Every tick of a skill's wind-up: power visibly gathering.
function skill_gathers(Fighter f, roster.Attack a)
    var fx = a.fx
    if fx == roster.FX_NONE do
        return
    end
    var here = f.body.position
    var tint = f.kit.look.accent
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    var t = double(f.frame) / double(a.startup)
    if fx == roster.FX_FEAST do
        gather(chest_of(f), 2, ap.Color(220, 30, 60), 1.3)
    else if fx == roster.FX_RUSH do
        for i in 0..<2 do
            var around = forward_of(ap.random(0, 360)) * 0.5
            streak(here + around + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(3, 5), 0), tint, 0.25, 0.35)
        end
    else if fx == roster.FX_SPIT do
        var mouth = here + ap.Vec3(0, 1.55 * f.kit.look.tall, 0) + forward_of(f.heading) * 0.3
        spark(mouth + scatter(0.15), ap.Vec3(0, -0.5, 0), tint, 0.35, 0.06, 5)
        gather(mouth, 1, tint, 0.6, 0.16, 0.05)
    else if fx == roster.FX_FLECHE do
        gather(hand + forward_of(f.heading) * 0.8, 2, tint, 0.9, 0.16, 0.05)
    else if fx == roster.FX_FLASH do
        gather(chest_of(f), 3, ap.Color(70, 34, 130), 1.1, 0.16, 0.09)
    else if fx == roster.FX_ROCKET do
        var pod = here + ap.Vec3(0, 1.75 * f.kit.look.tall, 0) + right_of(f.heading) * 0.42
        spark(pod + forward_of(f.heading) * 0.4, scatter(0.5) + ap.Vec3(0, 0.6, 0), tint, 0.25, 0.06, 0)
    else if fx == roster.FX_NOVA do
        # A circle of runes closing in on the caster.
        var radius = a.reach * (1 - 0.7 * t)
        for i in 0..<8 do
            var around = double(i) * 45 + double(f.frame) * 11
            spark(here + forward_of(around) * radius + ap.Vec3(0, 0.08, 0), ap.Vec3(0, 0.9, 0), tint, 0.14, 0.1, 0)
        end
        gather(f.body.top() + ap.Vec3(0, 0.4, 0), 2, ap.WHITE, 1.0)
    else if fx == roster.FX_BOLT do
        gather(hand, 2, tint, 0.7, 0.14, 0.05)
    end
end

# What a skill's melee strike looks and sounds like, whether or not it lands.
function skill_strikes(Fighter f, roster.Attack a)
    var fx = a.fx
    var here = f.body.position
    var tint = f.kit.look.accent
    var forward = forward_of(f.heading)
    var right = right_of(f.heading)
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    if fx == roster.FX_CHAIN do
        # Links flung out to the end of the reach, or whirled around.
        var hand = chest_of(f) - right * 0.3
        sound_at(snd_dash, here, 0.5, 0.7)
        later(snd_lock, here, 3, 0.5, 1.3)
        if a.radial do
            for i in 0..<24 do
                var around = double(i) * 15 + double(f.hits_done) * 40
                spark(here + forward_of(around) * (a.reach * 0.9) + ap.Vec3(0, 0.9, 0), forward_of(around + 90) * 6,
                    f.kit.look.metal, 0.16, 0.09, 0)
            end
        else do
            for i in 0..<18 do
                var at = hand.lerp(here + forward * a.reach + ap.Vec3(0, 1.0, 0), double(i) / 17)
                spark(at, ap.Vec3(0, 0, 0), f.kit.look.metal if i % 2 == 0 else f.kit.look.metal.brightness(0.6), 0.25, 0.09, 0)
            end
        end
        return
    end
    if fx == roster.FX_RUSH do
        var beat = f.hits_done
        var fist = chest_of(f) + forward * 1.15 + right * (0.25 if beat % 2 == 1 else -0.25) +
            ap.Vec3(0, ap.random(-0.15, 0.2), 0)
        rings.push(Ring(fist, tint, 1.8, 0.12, true))
        for i in 0..<4 do
            streak(fist - forward * 0.7 + scatter(0.15), forward * 9, tint, 0.1, 0.5)
        end
        sound_at(snd_rush, fist, 0.5, 0.85 + 0.09 * double(beat))
        if beat == f.move_hits do
            rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 9, 0.3))
            sound_at(snd_thud, here, 0.6, 1.4)
        end
    else if fx == roster.FX_FEAST do
        # Two rows of fangs snapping shut.
        sound_at(snd_bite, here, 0.7)
        var bite = chest_of(f) + forward * 1.0 + ap.Vec3(0, 0.25, 0)
        for i in 0..<6 do
            var across = right * ((double(i) - 2.5) * 0.11)
            streak(bite + across + ap.Vec3(0, 0.45, 0), ap.Vec3(0, -5, 0), ap.WHITE, 0.1, 0.3, 0.06)
            streak(bite + across - ap.Vec3(0, 0.45, 0), ap.Vec3(0, 5, 0), ap.WHITE, 0.1, 0.3, 0.06)
        end
    else if fx == roster.FX_FLECHE do
        sound_at(snd_slash, here, 0.6, 1.2)
        for i in 0..<12 do
            streak(hand + forward * (double(i) * 0.25) + scatter(0.06), forward * ap.random(8, 14),
                tint if i % 2 == 0 else ap.WHITE, 0.14, 0.7)
        end
    else if fx == roster.FX_FLASH do
        # One wide rising cut, and the dark it tears open.
        sound_at(snd_slash, here, 0.7, 0.8)
        later(snd_shing, here, 5, 0.35, 0.8)
        for i in 0..<22 do
            var along = double(i) / 21
            var around = f.heading + 170 * (along - 0.5)
            var at = here + forward_of(around) * (a.reach * 0.85) + ap.Vec3(0, 0.7 + 0.9 * along, 0)
            streak(at, forward_of(around - 90) * 5 + ap.Vec3(0, 1.5, 0), tint if i % 2 == 0 else ap.WHITE, 0.22, 0.6, 0.07)
        end
        rings.push(Ring(chest_of(f) + forward * 1.2, ap.Color(70, 34, 130), 6, 0.2, true))
    else if fx == roster.FX_NOVA do
        sound_at(snd_thud, here, 0.7)
        later(snd_shimmer, here, 8, 0.4)
        later(snd_shimmer, here, 16, 0.25, 0.75)
        rings.push(Ring(here + ap.Vec3(0, 0.12, 0), ap.WHITE, a.reach / 0.5, 0.5))
        for i in 0..<20 do
            var out = forward_of(double(i) * 18)
            streak(here + out * (a.reach * 0.5) + ap.Vec3(0, 0.1, 0), out * 2 + ap.Vec3(0, ap.random(5, 9), 0),
                tint, 0.3, 0.6, 0.06)
        end
        for i in 0..<24 do
            spark(f.body.center(), forward_of(double(i) * 15) * ap.random(6, 9) + ap.Vec3(0, ap.random(-0.5, 1.5), 0),
                ap.WHITE if i % 2 == 0 else tint, 0.4, 0.09, 2)
        end
    end
end

# A skill lands cleanly on `o` at `at`.
function skill_lands(Fighter f, Fighter o, roster.Attack a, ap.Vec3 at, ap.Vec3 origin)
    var fx = a.fx
    var tint = f.kit.look.accent
    var away = unit(flat(o.body.position - origin))
    if fx == roster.FX_FEAST do
        # Blood streaming back to the one who bit.
        for i in 0..<18 do
            var life = ap.random(0.25, 0.5)
            var from = at + scatter(0.25)
            spark(from, (chest_of(f) - from) * (1 / life), ap.Color(210, 20, 44), life, 0.08, 0)
        end
        rings.push(Ring(at, tint, 4, 0.2, true))
    else if fx == roster.FX_RUSH do
        burst(at, 4, ap.WHITE, 5, 0.2, 0.06)
        if f.hits_done == f.move_hits do
            rings.push(Ring(at, tint, 7, 0.25, true))
            sound_at(snd_heavy, at, 0.6, 0.8)
        end
    else if fx == roster.FX_SPIT do
        burst(at, 16, tint, 4, 0.5, 0.08)
    else if fx == roster.FX_FLECHE do
        # Run clean through.
        sound_at(snd_shing, at, 0.5, 1.3)
        for i in 0..<12 do
            streak(at + scatter(0.1), (away + scatter(0.2)) * ap.random(6, 12), ap.WHITE, 0.18, 0.6)
        end
        rings.push(Ring(at, tint, 5, 0.18, true))
    else if fx == roster.FX_FLASH do
        for i in 0..<10 do
            streak(at + ap.Vec3(0, -0.8 + double(i) * 0.16, 0) + scatter(0.05), ap.Vec3(0, 3, 0) + away * 2, tint,
                0.25, 0.5, 0.06)
        end
        rings.push(Ring(at, ap.Color(70, 34, 130), 5, 0.22, true))
        later(snd_thud, at, 3, 0.5, 1.6)
    else if fx == roster.FX_NOVA do
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 6, ap.WHITE, 0.2, 0.5)
        end
        sound_at(snd_shimmer, at, 0.4, 1.5)
    else if fx == roster.FX_BOLT do
        rings.push(Ring(at, tint, 5, 0.18, true))
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 5, tint if i % 2 == 0 else ap.WHITE, 0.18, 0.4)
        end
        sound_at(snd_shimmer, at, 0.4, 1.3)
    end
end

# --- Signatures: what makes each fighter's moves look and sound like theirs -------------------------
# Every move already has its sound and sparks; on top of those, each fighter has a few touches of
# their own at four moments: a move begins, a melee blow is swung, a shot leaves the hand, and a
# hit lands. MONOPOLIST's money shows wherever it goes, including every bit of capital he spends.
const int SIG_BEGIN = 0
const int SIG_STRIKE = 1
const int SIG_FIRE = 2
const int SIG_LAND = 3

const ap.Color GOLD = ap.Color(255, 206, 70)
const ap.Color CASH = ap.Color(110, 200, 110)

# A slip of something flat (a banknote, a card, a feather, a leaf) tumbling through the air.
function slip(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double length = 0.16, double gravity = 1.2)
    if sparks.length < 900 do
        var s = Spark(at, velocity, color, life, life, 0.035, gravity, length)
        s.drag = 2.2
        sparks.push(s)
    end
end
# Coins: small, gold, and they bounce on the floor.
function coins(ap.Vec3 at, int count, double speed)
    for i in 0..<count do
        spark(at + scatter(0.1), (unit(scatter(1)) + ap.Vec3(0, 1.2, 0)) * ap.random(speed * 0.5, speed), GOLD if i % 3 != 0 else ap.Color(255, 240, 160),
            ap.random(0.6, 1.1), 0.06, 11)
    end
end
function banknotes(ap.Vec3 at, int count, double speed)
    for i in 0..<count do
        slip(at + scatter(0.2), (unit(scatter(1)) + ap.Vec3(0, 0.8, 0)) * ap.random(speed * 0.4, speed),
            CASH if i % 4 != 0 else ap.Color(170, 230, 160), ap.random(0.9, 1.5))
    end
end

# MONOPOLIST pays for every move: coins spill from his hand as the capital goes.
function spend_fx(Fighter f, double cost)
    if f.kit.bankrupt <= 0 or cost <= 0.5 or mx(f).free_bar do
        return
    end
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    coins(hand, math.clamp(int(cost / 3), 2, 7), 2.5)
    sound_at(snd_coin_a if f.serial % 2 == 0 else snd_coin_b, hand, 0.25, ap.random(0.9, 1.15))
    if f.bar < f.kit.bar_max * 0.25 do
        # Running low: the till rattles.
        later(snd_coins2, hand, 4, 0.2, 0.8)
    end
end

function signature(Fighter f, int event, roster.Attack a, ap.Vec3 at)
    var who = f.kit.name
    var tint = f.kit.look.accent
    var here = f.body.position
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    var forward = forward_of(f.heading)
    var skill = not is_basic(f, a)
    if who == "MONOPOLIST" do
        if event == SIG_BEGIN do
            if a.name == "Buyout" do
                sound_at(snd_chip_stack, here, 0.6)
                banknotes(chest_of(f), 8, 2)
            else if a.name == "Make It Rain" do
                sound_at(snd_coins2, hand, 0.6, 1.1)
                for i in 0..<10 do
                    spark(hand + scatter(0.15), ap.Vec3(0, ap.random(1, 3), 0), GOLD, 0.4, 0.05, 0)
                end
            else if a.name == "Hostile Takeover" do
                sound_at(snd_book, here, 0.7, 0.8)
                later(snd_chips, here, 6, 0.5, 0.8)
                for i in 0..<6 do
                    slip(chest_of(f) + forward * 0.4 + scatter(0.2), forward * 2 + scatter(1), ap.Color(240, 236, 220), 0.9, 0.2, 0.6)
                end
            else if a.name == "Golden Parachute" do
                sound_at(snd_cloth, here, 0.6, 0.9)
                later(snd_coin_splash, here, 5, 0.5)
                coins(here + ap.Vec3(0, 0.3, 0), 10, 3)
            else if a.name == "Market Crash" do
                sound_at(snd_gold_sack, here, 0.8)
                later(snd_coin_drop, here, 10, 0.6)
                banknotes(f.body.top(), 16, 3)
                for i in 0..<10 do
                    streak(here + forward_of(double(i) * 36) * 1.2 + ap.Vec3(0, 3, 0), ap.Vec3(0, -9, 0), ap.Color(230, 60, 60), 0.3, 0.7)
                end
            end
        else if event == SIG_STRIKE do
            # The gold knob glints at the end of every swing.
            spark(hand + forward * 0.6, ap.Vec3(0, 0.3, 0), ap.Color(255, 240, 180), 0.18, 0.09, 0)
            if a.name == "Buyout" do
                banknotes(chest_of(f) - forward * 0.4, 6, 3)
            end
        else if event == SIG_FIRE do
            sound_at(snd_coin_a if f.hits_done % 2 == 0 else snd_coin_b, hand, 0.45, ap.random(1.0, 1.3))
            spark(hand, forward * 2 + ap.Vec3(0, 1, 0), ap.Color(255, 240, 180), 0.2, 0.05, 0)
        else do
            coins(at, 8 if skill else 4, 4)
            sound_at(snd_coin_b if skill else snd_coin_a, at, 0.5, ap.random(0.95, 1.2))
            if a.name == "Buyout" do
                say(at + ap.Vec3(0, 0.6, 0), "SOLD!", GOLD)
                sound_at(snd_gold_sack, at, 0.7)
                banknotes(at, 14, 4)
                rings.push(Ring(at, GOLD, 6, 0.25, true))
            else if a.name == "Hostile Takeover" do
                say(at + ap.Vec3(0, 0.6, 0), "ACQUIRED", CASH)
                sound_at(snd_chip_stack, at, 0.7, 0.9)
                for i in 0..<12 do
                    var around = forward_of(double(i) * 30)
                    streak(at + around * 0.8, around * -4, GOLD, 0.2, 0.4)
                end
            else if a.name == "Market Crash" or a.name == "Make It Rain" do
                if ap.chance(0.5) do
                    say(at + ap.Vec3(0, 0.4, 0), "-$", ap.Color(230, 80, 80))
                end
                banknotes(at, 3, 2)
            end
        end
        return
    end
    if who == "FANGS" do
        if event == SIG_BEGIN and skill do
            for i in 0..<6 do
                slip(chest_of(f) + scatter(0.4), scatter(2) + ap.Vec3(0, 1.5, 0), ap.Color(40, 16, 30), 0.6, 0.18, -0.5)
            end
        else if event == SIG_LAND do
            for i in 0..<8 do
                spark(at + scatter(0.1), (unit(scatter(1)) + forward * 0.6) * ap.random(1.5, 3.5), ap.Color(170, 10, 30), 0.7, 0.05, 9)
            end
            puff(at, scatter(0.3), ap.Color(150, 20, 40), 0.5, 0.08, 0.3)
        end
    else if who == "ASTER" do
        if event == SIG_LAND do
            for i in 0..<8 do
                var way = forward_of(f.heading + 90) * math.sin(double(i) * 0.785) + ap.Vec3(0, math.cos(double(i) * 0.785), 0)
                streak(at, way * 6, ap.WHITE if i % 2 == 0 else tint, 0.09, 0.3, 0.04)
            end
            if a.launch > 0 do
                sound_at(snd_kiai, at, 0.5, 1.2)
                for i in 0..<10 do
                    streak(at + scatter(0.3) - ap.Vec3(0, 0.6, 0), ap.Vec3(0, ap.random(8, 12), 0), tint, 0.2, 0.7)
                end
            end
        else if event == SIG_STRIKE and a.lunge > 2 do
            puff(here + ap.Vec3(0, 0.1, 0), forward * -1.5, ap.Color(150, 140, 130), 0.5, 0.1, 0.4)
        end
    else if who == "ANACONDA" do
        if event == SIG_LAND do
            for i in 0..<6 do
                spark(at + scatter(0.2), unit(scatter(1)) * 2 + ap.Vec3(0, 1, 0), ap.Color(130, 240, 60), 0.6, 0.05, 7)
            end
            later(snd_hiss, at, 3, 0.3, 1.3)
        else if event == SIG_BEGIN and a.name == "Slither" do
            sound_at(snd_hiss, here, 0.5, 0.8)
        end
    else if who == "RAPIER" do
        if event == SIG_STRIKE do
            streak(hand + forward * 0.3, forward * 16, ap.WHITE, 0.08, 1.1, 0.025)
        else if event == SIG_LAND do
            # Petals: a duel is a performance.
            for i in 0..<6 do
                slip(at + scatter(0.2), scatter(1.5) + ap.Vec3(0, 0.6, 0), ap.Color(230, 70, 110) if i % 2 == 0 else ap.Color(255, 160, 190), 1.0, 0.07, 0.8)
            end
            if skill do
                sound_at(snd_shing, at, 0.4, 1.5)
            end
        end
    else if who == "VOID" do
        if event == SIG_STRIKE do
            for i in 0..<10 do
                var around = f.heading + 120 * (double(i) / 9 - 0.5)
                streak(here + forward_of(around) * 1.4 + ap.Vec3(0, 1.0, 0), forward_of(around + 90) * 4, ap.Color(70, 34, 130), 0.14, 0.5, 0.05)
            end
        else if event == SIG_LAND do
            gather(at, 10, ap.Color(90, 50, 160), 0.9, 0.18, 0.06)
        end
    else if who == "SHERMAN" do
        if event == SIG_LAND do
            for i in 0..<6 do
                spark(at, unit(scatter(1) + ap.Vec3(0, 0.6, 0)) * ap.random(3, 6), ap.Color(255, 210, 140), 0.35, 0.035, 9)
            end
        else if event == SIG_BEGIN and a.name == "Brace" do
            sound_at(snd_lock, here, 0.6, 0.7)
        end
    else if who == "SHEPHERD" do
        if event == SIG_BEGIN do
            sound_at(snd_cloth, here, 0.4, 0.8)
            if a.name == "Sleep Dust" do
                for i in 0..<14 do
                    puff(hand + forward * 0.5 + scatter(0.3), forward * ap.random(1, 3) + scatter(0.5), ap.Color(190, 170, 230), 1.2, 0.05, 0.2)
                end
            end
        else if event == SIG_LAND do
            puff(at, scatter(0.4), ap.Color(60, 60, 70), 0.7, 0.1, 0.3)
        end
    else if who == "DON" do
        if event == SIG_BEGIN and skill do
            sound_at(snd_book, here, 0.5, 1.1)
            for i in 0..<12 do
                var around = forward_of(double(i) * 30)
                spark(here + around * 0.9 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, 1.2, 0), ap.Color(150, 190, 255) if i % 2 == 0 else ap.Color(255, 230, 140), 0.5, 0.06, 0)
            end
        else if event == SIG_LAND do
            for i in 0..<6 do
                spark(at + scatter(0.3), scatter(1) + ap.Vec3(0, 1.4, 0), ap.Color(255, 230, 140), 0.6, 0.05, -0.5)
            end
        end
    else if who == "HOTLINE" do
        if event == SIG_BEGIN and skill do
            sound_at(snd_lock, here, 0.4, 1.8)
            later(snd_lock, here, 5, 0.4, 2.0)
        else if event == SIG_LAND do
            for i in 0..<8 do
                var grey = int(ap.random(120, 255))
                spark(at + scatter(0.3), scatter(2), ap.Color(grey, grey, grey), 0.18, 0.05, 0)
            end
        end
    else if who == "BUCKSHOT" do
        if event == SIG_FIRE do
            # The spent shell kicks out, red and brass.
            spark(hand - forward * 0.3, right_of(f.heading) * 2 + ap.Vec3(0, 3, 0), ap.Color(200, 40, 40), 1.0, 0.07, 9)
            later(snd_casing, hand, 30, 0.25, 0.7)
        else if event == SIG_LAND do
            for i in 0..<8 do
                spark(at, unit(scatter(1)) * ap.random(3, 6), ap.Color(150, 130, 110), 0.5, 0.04, 9)
            end
        end
    else if who == "STAB" do
        if event == SIG_BEGIN and a.shot == roster.SHOT_KNIFE do
            sound_at(snd_draw_knife, here, 0.5)
        else if event == SIG_BEGIN and a.name == "Behind You" do
            smoke(here + ap.Vec3(0, 0.5, 0), 6, 0.3, 0.6)
        else if event == SIG_LAND do
            sound_at(snd_knife, at, 0.4, ap.random(0.9, 1.2))
            for i in 0..<5 do
                spark(at + scatter(0.1), unit(scatter(1)) * 2, ap.Color(170, 10, 30), 0.6, 0.04, 9)
            end
        end
    else if who == "ATOMIC" do
        if event == SIG_LAND do
            # A little atom: three rings of sparks orbiting where it hit.
            for k in 0..<3 do
                for i in 0..<8 do
                    var a2 = double(i) * 45 + double(k) * 60
                    var ring = forward_of(a2) * 0.4
                    var tilt = ap.Vec3(ring.x, ring.z * (0.6 if k == 1 else -0.6), ring.z * 0.8)
                    spark(at + tilt, forward_of(a2 + 90) * 2, tint, 0.3, 0.04, 0)
                end
            end
            sound_at(snd_zap_file, at, 0.3, 1.6)
        end
    else if who == "CAT" do
        if event == SIG_BEGIN and (a.name == "Wild Card" or a.name.starts_with("Copy")) do
            sound_at(snd_card_fan if a.name == "Wild Card" else snd_shuffle, here, 0.6)
            for i in 0..<8 do
                slip(chest_of(f) + scatter(0.3), scatter(2.5) + ap.Vec3(0, 1.5, 0), ap.WHITE if i % 2 == 0 else ap.Color(230, 60, 60), 0.8, 0.12, 1.5)
            end
        else if event == SIG_LAND do
            # Three claw marks.
            var across = right_of(f.heading)
            for k in 0..<3 do
                streak(at + across * (double(k) - 1) * 0.12 + ap.Vec3(0, 0.3, 0), ap.Vec3(0, -6, 0), ap.WHITE, 0.1, 0.4, 0.03)
            end
        end
    else if who == "DROID" do
        if event == SIG_LAND do
            # A zigzag of current.
            var p = at
            for i in 0..<6 do
                var next = p + scatter(0.35) + ap.Vec3(0, 0.1, 0)
                streak(p, (next - p) * 25, ap.Color(120, 220, 255), 0.08, 0.3, 0.03)
                p = next
            end
            sound_at(snd_zap_file, at, 0.25, 1.9)
        else if event == SIG_BEGIN and a.name == "Thrusters" do
            for i in 0..<10 do
                streak(here + ap.Vec3(0, 0.9, 0) - forward * 0.3, (forward * -1.0 + scatter(0.2)) * 7, ap.Color(255, 170, 70), 0.15, 0.4)
            end
        end
    else if who == "LASER" do
        if event == SIG_LAND do
            rings.push(Ring(at, ap.Color(255, 250, 220), 4, 0.1, true))
            for i in 0..<4 do
                var way = forward_of(double(i) * 90 + 45)
                streak(at, ap.Vec3(way.x, way.z, 0) * 6, ap.WHITE, 0.1, 0.5, 0.03)
            end
        end
    else if who == "EAGLE" do
        if event == SIG_LAND do
            for i in 0..<5 do
                slip(at + scatter(0.2), scatter(1.5) + ap.Vec3(0, 1, 0), ap.Color(240, 240, 235), 1.2, 0.14, 0.5)
            end
        end
    else if who == "COMBATANT" or who == "DISMANTLE" do
        if event == SIG_LAND do
            var axe = f.kit.look.weapon == roster.WEAPON_AXE or f.kit.look.weapon == roster.WEAPON_BIGAXE
            if axe do
                sound_at(snd_chop, at, 0.5, ap.random(0.8, 1.0))
            end
            if a.damage >= 10 do
                stain(o_ground(at), ap.Color(24, 20, 30), 0.6, 4, 0.6)
                for i in 0..<8 do
                    spark(o_ground(at), unit(scatter(1) + ap.Vec3(0, 1.5, 0)) * ap.random(2, 5), ap.Color(110, 100, 90), 0.8, 0.08, 9)
                end
            end
        else if event == SIG_BEGIN and a.fx == roster.FX_CHAIN do
            sound_at(snd_lock, here, 0.4, 0.7)
        end
    else if who == "PHANTOM" do
        if event == SIG_LAND do
            for i in 0..<5 do
                slip(at + scatter(0.2), scatter(1.5) + ap.Vec3(0, 0.8, 0), ap.Color(26, 22, 34), 1.2, 0.16, 0.4)
            end
        else if event == SIG_BEGIN and a.name == "Glide" do
            sound_at(snd_cloth, here, 0.5, 1.3)
        end
    else if who == "CARBON" do
        if event == SIG_LAND do
            for i in 0..<8 do
                spark(at, unit(scatter(1) + ap.Vec3(0, 0.8, 0)) * ap.random(2, 5), ap.Color(130, 108, 86), 0.8, 0.09, 9)
            end
            puff(at, scatter(0.4), ap.Color(150, 130, 110), 0.8, 0.12, 0.4)
        end
    else if who == "MIRRORMAN" do
        if event == SIG_LAND do
            for i in 0..<8 do
                streak(at, unit(scatter(1)) * ap.random(4, 8), ap.Color(210, 240, 255) if i % 2 == 0 else ap.WHITE, 0.2, 0.25, 0.03)
            end
            sound_at(snd_shimmer, at, 0.3, 1.8)
        end
    else if who == "BOB" do
        if event == SIG_LAND do
            for i in 0..<6 do
                spark(at + scatter(0.3), ap.Vec3(0, ap.random(0.6, 1.4), 0), ap.Color(140, 255, 140), 0.6, 0.06, -0.5)
            end
        else if event == SIG_BEGIN and a.inject do
            sound_at(snd_hiss, here, 0.4, 1.6)
        end
    else if who == "TELEMAN" do
        if event == SIG_BEGIN and skill do
            sound_at(snd_lock, here, 0.5, 1.3)
        else if event == SIG_LAND do
            for i in 0..<10 do
                var grey = 255 if i % 2 == 0 else 20
                spark(at + scatter(0.35), scatter(0.5), ap.Color(grey, grey, grey), 0.15, 0.05, 0)
            end
            sound_at(snd_zap_file, at, 0.2, 0.8)
        end
    else if who == "SPRUCE" do
        if event == SIG_LAND do
            for i in 0..<6 do
                slip(at + scatter(0.3), scatter(1.2) + ap.Vec3(0, 0.6, 0), ap.Color(120, 200, 90) if i % 2 == 0 else ap.Color(200, 220, 120), 1.4, 0.08, 0.5)
            end
            rings.push(Ring(o_ground(at), ap.Color(140, 200, 230), 3, 0.35))
        else if event == SIG_BEGIN and skill do
            sound_at(snd_shimmer, here, 0.3, 2.0)
        end
    else if who == "QUICKDRAW" do
        if event == SIG_LAND do
            puff(o_ground(at) + ap.Vec3(0, 0.1, 0), scatter(0.5), ap.Color(170, 150, 120), 0.6, 0.1, 0.3)
        else if event == SIG_BEGIN and a.shot == roster.SHOT_BOMB do
            for i in 0..<8 do
                spark(hand + ap.Vec3(0, 0.2, 0), scatter(1) + ap.Vec3(0, 1, 0), ap.Color(255, 220, 120), 0.3, 0.04, 2)
            end
        end
    end
end

# The floor under a point.
function o_ground(ap.Vec3 at) returns ap.Vec3
    return ap.Vec3(at.x, 0.05, at.z)
end

# --- What the newer fighters do -------------------------------------------------------------------

var skill_pool = roster.move_pool(cast)
var ultimate_pool = roster.ultimate_pool(cast)
var chain_pool = roster.chain_pool(cast)
var recall_hit = roster.hit("Recall", 4, 1, 1, 0, 0, 0, 12, -3, roster.ANIM_FOCUS)

function dot3(ap.Vec3 a, ap.Vec3 b) returns double
    return a.x * b.x + a.y * b.y + a.z * b.z
end

# How far `p` is from the segment `a`..`b`.
function off_line(ap.Vec3 p, ap.Vec3 a, ap.Vec3 b) returns double
    var ab = b - a
    var long = dot3(ab, ab)
    if long < 0.0001 do
        return (p - a).length()
    end
    var t = math.clamp(dot3(p - a, ab) / long, 0.0, 1.0)
    return (p - (a + ab * t)).length()
end

function pick_index(int count) returns int
    return math.min(int(ap.random(0, double(count))), count - 1)
end

# Whether the special bar covers `cost`. A fighter who goes bankrupt can always spend what is left.
function can_pay(Fighter f, double cost) returns bool
    return mx(f).free_bar or f.bar + 0.001 >= cost or (f.kit.bankrupt > 0 and f.bar > 0.001)
end

function pay(Fighter f, double cost)
    if not mx(f).free_bar do
        f.bar = math.max(f.bar - cost, 0.0)
        spend_fx(f, cost)
    end
end

# CAT: a move from anyone in the game, priced in mischief.
function random_skill() returns roster.Attack
    return roster.adapt(skill_pool[pick_index(skill_pool.length)], 20)
end

# CAT in its super: someone's whole basic chain, borrowed.
function random_chain(Fighter f)
    var chain = chain_pool[pick_index(chain_pool.length)]
    roster.Attack[] moves = []
    for a in chain do
        moves.push(roster.adapt(a, 0))
    end
    f.kit.basics = moves
end

# CAT's super: every move it has becomes a random one. Its own are put away until it is over.
function randomize_moves(Fighter f)
    if f.kept_skills.length == 0 do
        f.kept_basics = f.kit.basics
        roster.Attack[] kept = []
        for a in f.kit.skills do
            kept.push(a)
        end
        f.kept_skills = kept
        f.kept_ultimate = f.kit.ultimate
    end
    random_chain(f)
    roster.Attack[] wild = []
    for i in 0..<4 do
        wild.push(random_skill())
    end
    f.kit.skills = wild
    f.kit.ultimate = roster.adapt(ultimate_pool[pick_index(ultimate_pool.length)], 0)
    say(f.body.top() + ap.Vec3(0, 0.3, 0), "EVERYTHING IS RANDOM", f.kit.look.accent)
end

function restore_moves(Fighter f)
    if f.kept_skills.length == 0 do
        return
    end
    f.kit.basics = f.kept_basics
    f.kit.skills = f.kept_skills
    f.kit.ultimate = f.kept_ultimate
    f.kept_skills = []
end

# After a skill is used: a random one is dealt in its place.
function reshuffle(Fighter f, int slot)
    if mx(f).randomize or (f.kit.copycat and slot == 3) do
        f.kit.skills[slot] = random_skill()
    end
end

# Whether `a` is one of `f`'s skills (1-4), rather than a basic attack (R) or their super move.
function is_skill_move(Fighter f, roster.Attack a) returns bool
    for b in f.kit.basics do
        if b.name == a.name do
            return false
        end
    end
    return a.name != f.kit.ultimate.name
end

# CAT is hit by a skill: unless it has locked it, skill 1 becomes that move. Basic attacks and
# super moves are not copied.
function copy_move(Fighter o, Fighter f, roster.Attack a)
    if not o.kit.copycat or o.copy_locked or not roster.portable(a) or not is_skill_move(f, a) do
        return
    end
    var mine = o.kit.skills[0] if o.kept_skills.length == 0 else o.kept_skills[0]
    if mine.name == a.name do
        return
    end
    var b = roster.adapt(a, 20)
    b.note = "Copied from {f.kit.name}"
    if o.kept_skills.length > 0 do
        o.kept_skills[0] = b
    else do
        o.kit.skills[0] = b
    end
    say(o.body.top() + ap.Vec3(0, 0.55, 0), "COPIED {a.name.upper()}", o.kit.look.accent)
end

function toggle_lock(Fighter f)
    f.copy_locked = not f.copy_locked
    f.kit.skills[1].name = "Unlock" if f.copy_locked else "Lock"
    say(f.body.top(), "LOCKED" if f.copy_locked else "UNLOCKED", f.kit.look.accent)
    sound_at(snd_lock, f.body.position, 0.6, 1.4 if f.copy_locked else 1.0)
    rings.push(Ring(f.body.center(), f.kit.look.accent, 3, 0.2, true))
end

# COMBATANT: a weapon of the arsenal in hand. The skills of the one put away keep cooling down.
function equip(Fighter f, int index)
    var kit = f.kit
    if kit.arsenal.length == 0 do
        return
    end
    if f.arm_cools.length < kit.arsenal.length * 3 do
        f.arm_cools = []
        for i in 0..<kit.arsenal.length * 3 do
            f.arm_cools.push(0)
        end
    end
    for i in 0..<3 do
        f.arm_cools[f.arm * 3 + i] = f.cooldowns[i]
    end
    var arm = kit.arsenal[index]
    for i in 0..<3 do
        f.cooldowns[i] = f.arm_cools[index * 3 + i]
        kit.skills[i] = arm.skills[i]
    end
    f.arm = index
    kit.basics = arm.basics
    kit.fallback = arm.fallback
    kit.ai_range = arm.ai_range
    kit.look.weapon = arm.weapon
end

function swap_weapon(Fighter f)
    var kit = f.kit
    if kit.arsenal.length == 0 do
        return
    end
    var next = (f.arm + 1) % kit.arsenal.length
    equip(f, next)
    var hand = puppet.muzzle(kit.look, f.body.position, f.heading)
    say(f.body.top(), kit.arsenal[next].name, kit.look.accent)
    sound_at(snd_shing if next != 1 else snd_swing, hand, 0.5, 1.2)
    later(snd_lock, hand, 4, 0.4, 0.9)
    for i in 0..<8 do
        streak(hand, unit(scatter(1)) * 3, kit.look.metal, 0.15, 0.3)
    end
end

# A thrown dagger comes to rest on the floor, to be picked up again.
function drop_dagger(Shot s, ap.Vec3 at)
    var owner = fighters[s.owner]
    if s.attack.shot != roster.SHOT_KNIFE or owner.kit.arsenal.length == 0 or pickups.length >= 14 do
        return
    end
    var spot = flat(at)
    if spot.length() > ARENA - 0.6 do
        spot = unit(spot) * (ARENA - 0.6)
    end
    pickups.push(Pickup(s.owner, ap.Vec3(spot.x, 0, spot.z), heading_of(s.velocity)))
end

function update_pickups()
    Pickup[] lying = []
    for p in pickups do
        var g = fighters[p.owner]
        if g.state != STATE_DOWN and g.bar < g.kit.bar_max and flat_distance(g.body.position, p.position) < 1.0 do
            g.bar = math.min(g.bar + 1, g.kit.bar_max)
            sound_at(snd_reload, p.position, 0.4, 1.4)
            say(g.body.top(), "+1", g.kit.look.accent)
        else do
            lying.push(p)
        end
    end
    pickups = lying
end

# Every dagger lying about flies back to the hand, cutting whoever is in the way.
function recall_daggers(Fighter f, Fighter o)
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    var count = 0
    Pickup[] lying = []
    for p in pickups do
        if p.owner != f.id do
            lying.push(p)
            continue
        end
        count += 1
        var from = p.position + ap.Vec3(0, 0.3, 0)
        for i in 0..<4 do
            streak(from.lerp(hand, double(i) / 4), unit(hand - from) * 16, f.kit.look.metal, 0.18, 0.5)
        end
        if o.state != STATE_DOWN and off_line(o.body.center(), from, hand) < 0.7 do
            apply_hit(f, o, recall_hit, 1, from, false)
        end
    end
    pickups = lying
    if count == 0 do
        deny(f, "NO DAGGERS OUT")
        return
    end
    f.bar = math.min(f.bar + double(count), f.kit.bar_max)
    say(f.body.top(), "+{count}", f.kit.look.accent)
    sound_at(snd_dash, hand, 0.5, 1.5)
    later(snd_reload, hand, 6, 0.5, 1.2)
end

# --- MIRRORMAN's copies.

function mirror_count(int owner) returns int
    var n = 0
    for mi in mirrors do
        if mi.owner == owner do
            n += 1
        end
    end
    return n
end

# Whose copy it is: usually the side's first fighter.
function mirror_owner(Mirror mi) returns Fighter
    var who = mi.maker
    if who != null do
        return who
    end
    return fighters[mi.owner]
end

# Whether `f` is still in the fight: a side's first fighter, or a partner or clone not yet gone.
function still_here(Fighter f) returns bool
    if f == fighters[f.id] do
        return true
    end
    for m in minions do
        if m == f do
            return true
        end
    end
    return false
end

# How many copies of themself `f` has out.
function own_mirrors(Fighter f) returns int
    var n = 0
    for mi in mirrors do
        if mirror_owner(mi) == f do
            n += 1
        end
    end
    return n
end
function has_mirrors(Fighter f) returns bool
    return own_mirrors(f) > 0
end

# Where a copy stands: its owner's place, turned `angle` degrees around their opponent.
function mirror_spot(Fighter f, double angle) returns ap.Vec3
    var o = foe_of(f)
    var rel = flat(f.body.position - o.body.position)
    var a = angle * math.PI / 180
    var turned = ap.Vec3(rel.x * math.cos(a) + rel.z * math.sin(a), 0, -rel.x * math.sin(a) + rel.z * math.cos(a))
    var spot = flat(o.body.position) + turned
    if spot.length() > ARENA - 0.5 do
        spot = unit(spot) * (ARENA - 0.5)
    end
    return ap.Vec3(spot.x, f.body.position.y, spot.z)
end

function mirror_at(Mirror mi) returns ap.Vec3
    return mirror_spot(mirror_owner(mi), mi.angle)
end

function add_mirror(Fighter f, double angle, int life)
    if mirror_count(f.id) >= 4 do
        # The oldest one gives way.
        Mirror[] kept = []
        var dropped = false
        for mi in mirrors do
            if not dropped and mi.owner == f.id do
                dropped = true
            else do
                kept.push(mi)
            end
        end
        mirrors = kept
    end
    var made = Mirror(f.id, angle, life, ticks)
    if f != fighters[f.id] do
        made.maker = f
    end
    mirrors.push(made)
    var at = mirror_spot(f, angle) + ap.Vec3(0, 1, 0)
    rings.push(Ring(at, f.kit.look.accent, 4, 0.25, true))
    for i in 0..<10 do
        spark(at + scatter(0.6), scatter(1.5), ap.WHITE if i % 2 == 0 else f.kit.look.accent, 0.4, 0.07, 0)
    end
    sound_at(snd_shimmer, at, 0.5, 1.4)
end

function make_mirrors(Fighter f, Fighter o, roster.Attack a)
    for k in 0..<a.volley do
        var angle = 360.0 * double(k + 1) / double(a.volley + 1) + ap.random(-20, 20)
        add_mirror(f, angle, int(a.shot_life * 60))
    end
    sound_at(snd_flash, f.body.position, 0.5, 1.5)
end

# A copy is touched and breaks.
function shatter_mirror(Mirror gone)
    var owner = mirror_owner(gone)
    var at = mirror_at(gone) + ap.Vec3(0, 1, 0)
    Mirror[] kept = []
    for mi in mirrors do
        if mi != gone do
            kept.push(mi)
        end
    end
    mirrors = kept
    say(at + ap.Vec3(0, 0.8, 0), "SHATTER", ap.Color(200, 240, 255))
    sound_at(snd_parry, at, 0.6, 1.8)
    later(snd_shimmer, at, 3, 0.5, 1.6)
    for i in 0..<20 do
        streak(at + scatter(0.4), unit(scatter(1)) * ap.random(3, 7), ap.WHITE if i % 2 == 0 else owner.kit.look.accent, 0.3, 0.25, 0.05)
    end
end

# The copy of side `owner` that a blow or a shot at `at` touches, if any.
function mirror_touched(int owner, ap.Vec3 at, double size) returns Mirror
    for mi in mirrors do
        if mi.owner == owner and ticks - mi.born > 6 do
            var spot = mirror_at(mi)
            if flat_distance(spot, at) < 0.4 + size and at.y > spot.y - 0.1 and at.y < spot.y + 2.0 do
                return mi
            end
        end
    end
    return Mirror(-1, 0, 0, 0)
end

# A melee blow of `f` breaks any of the opponent's copies it sweeps through.
function break_mirrors(Fighter f, int owner, roster.Attack a)
    var forward = forward_of(f.heading)
    Mirror[] hit_ones = []
    for mi in mirrors do
        if mi.owner == owner do
            var spot = mirror_at(mi)
            if flat_distance(f.body.position, spot) <= a.reach + 0.4 and (a.radial or ap.in_cone(f.body.position, forward, spot, a.arc)) do
                hit_ones.push(mi)
            end
        end
    end
    for mi in hit_ones do
        shatter_mirror(mi)
    end
end

# Trade places with one of the copies: the copy stands where you were.
function glass_swap(Fighter f, Fighter o, roster.Attack a)
    Mirror[] mine = []
    for mi in mirrors do
        if mirror_owner(mi) == f do
            mine.push(mi)
        end
    end
    if mine.length == 0 do
        blink(f, o, a.blink)
        return
    end
    var mi = mine[pick_index(mine.length)]
    var spot = mirror_at(mi)
    if world.overlaps(ap.Vec3(spot.x, 1, spot.z), 0.4) do
        blink(f, o, a.blink)
        return
    end
    var from = f.body.center()
    f.body.position = ap.Vec3(spot.x, f.body.position.y, spot.z)
    mi.angle = -mi.angle
    f.heading = f.heading - mi.angle
    f.knock = ap.Vec3(0, 0, 0)
    sound_at(snd_shimmer, from, 0.6, 1.8)
    sound_at(snd_flash, spot, 0.5, 1.6)
    for i in 0..<12 do
        spark(from + scatter(0.5), scatter(1), f.kit.look.accent, 0.3, 0.06, 0)
        spark(f.body.center() + scatter(0.5), scatter(1), ap.WHITE, 0.3, 0.06, 0)
    end
    if o.cpu do
        o.decoy = pick_index(mine.length + 1) - 1
    end
end

# Every copy bursts; whoever stands near one is cut by the shards.
function shatter_mirrors(Fighter f, Fighter o, roster.Attack a)
    Mirror[] mine = []
    for mi in mirrors do
        if mirror_owner(mi) == f do
            mine.push(mi)
        end
    end
    if mine.length == 0 do
        deny(f, "NO COPIES")
        return
    end
    for mi in mine do
        var spot = mirror_at(mi)
        if o.state != STATE_DOWN and flat_distance(spot, o.body.position) < MIRROR_REACH do
            apply_hit(f, o, a, 1, spot, false)
        end
        for m in minions do
            if m.id == o.id and m != o and flat_distance(spot, m.body.position) < MIRROR_REACH do
                apply_hit(f, m, a, 1, spot, false)
            end
        end
        rings.push(Ring(spot + ap.Vec3(0, 0.1, 0), f.kit.look.accent, MIRROR_REACH / 0.3, 0.3))
        shatter_mirror(mi)
    end
    sound_at(snd_boom, f.body.position, 0.4, 1.8)
end

function update_mirrors()
    Mirror[] kept = []
    for mi in mirrors do
        mi.life -= 1
        var owner = mirror_owner(mi)
        if mi.life > 0 and owner.state != STATE_DOWN and still_here(owner) do
            kept.push(mi)
        else if mi.life <= 0 do
            var at = mirror_at(mi) + ap.Vec3(0, 1, 0)
            for i in 0..<8 do
                spark(at + scatter(0.5), scatter(0.8), owner.kit.look.accent, 0.3, 0.06, 0)
            end
        end
    end
    mirrors = kept
end

# In the HALL OF MIRRORS the copies never run out.
function keep_mirrors(Fighter u, Fighter o, int count)
    for mi in mirrors do
        if mi.owner == u.id do
            mi.life = math.max(mi.life, 90)
        end
    end
    mirror_clock -= 1
    if mirror_clock <= 0 and mirror_count(u.id) < count and u.state != STATE_DOWN do
        mirror_clock = MIRROR_REFORM
        add_mirror(u, ap.random(40, 320), 90)
    end
end

# Where `f` thinks the opponent is: the real one, or a copy they have been fooled by.
function target_of(Fighter f, Fighter o) returns ap.Vec3
    if not has_mirrors(o) do
        return o.body.position
    end
    if not f.cpu do
        # The player goes after whichever one is in front of them.
        var best = o.body.position
        var off = math.abs(wrap(heading_of(o.body.position - f.body.position) - f.heading))
        for mi in mirrors do
            if mirror_owner(mi) == o do
                var spot = mirror_at(mi)
                var turn = math.abs(wrap(heading_of(spot - f.body.position) - f.heading))
                if turn < off do
                    off = turn
                    best = spot
                end
            end
        end
        return best
    end
    if f.decoy >= 0 do
        var k = 0
        for mi in mirrors do
            if mirror_owner(mi) == o do
                if k == f.decoy do
                    return mirror_at(mi)
                end
                k += 1
            end
        end
    end
    return o.body.position
end

# --- BOB's machines and clones; CARBON's walls.

function add_prop(Prop pr)
    props.push(pr)
    world = build_world()
end

function update_props()
    Prop[] standing = []
    var changed = false
    for pr in props do
        if pr.life > 0 do
            pr.life -= 1
        end
        if pr.life == 0 do
            changed = true
            for i in 0..<14 do
                spark(pr.position + ap.Vec3(ap.random(-0.6, 0.6), ap.random(0, pr.height), ap.random(-0.6, 0.6)),
                    ap.Vec3(ap.random(-1, 1), ap.random(0, 2), ap.random(-1, 1)), ap.Color(116, 96, 78), 1.0, 0.18, 9)
            end
            sound_at(snd_thud, pr.position, 0.5, 0.7)
        else do
            standing.push(pr)
        end
    end
    if changed do
        props = standing
        world = build_world()
    end
end

# A pillar of stone bursts out of the floor a few steps ahead. Anyone standing there goes up with it.
function raise_wall(Fighter f, Fighter o, roster.Attack a)
    var forward = forward_of(f.heading)
    var spot = flat(f.body.position) + forward * a.blink
    if spot.length() > ARENA - 1 do
        spot = unit(spot) * (ARENA - 1)
    end
    Prop[] kept = []
    var walls = 0
    var i = props.length - 1
    while i >= 0 do
        var pr = props[i]
        if pr.kind == PROP_WALL and pr.owner == f.id do
            walls += 1
        end
        i -= 1
    end
    if walls >= 3 do
        # The oldest crumbles to make room.
        var dropped = false
        for pr in props do
            if not dropped and pr.kind == PROP_WALL and pr.owner == f.id do
                dropped = true
            else do
                kept.push(pr)
            end
        end
        props = kept
    end
    Fighter[] near = [o]
    for m in minions do
        if m.id == o.id and m != o do
            near.push(m)
        end
    end
    for g in near do
        if g.state != STATE_DOWN and flat_distance(spot, g.body.position) < 1.1 do
            var away = unit(flat(g.body.position - spot))
            if away.length() < 0.5 do
                away = forward
            end
            g.body.position = ap.Vec3(spot.x + away.x * 1.2, g.body.position.y, spot.z + away.z * 1.2)
            var limp = g.ragdolled and g.state == STATE_HURT
            apply_hit(f, g, a, 1, spot, false)
            if limp and g.state == STATE_HURT do
                # Someone already ragdolled, flying or lying, is thrown high by the rising stone.
                g.ragdolled = true
                g.landed = false
                g.ragdoll_age = 0
                g.juggles = 0
                g.floor_ticks = math.max(g.floor_ticks, 60)
                g.body.velocity = ap.Vec3(g.body.velocity.x, WALL_RAGDOLL_LIFT, g.body.velocity.z)
                g.knock = away * 2
                say(g.body.top() + ap.Vec3(0, 0.3, 0), "UP", f.kit.look.accent)
                sound_at(snd_launch, g.body.position, 0.7, 0.9)
                for k in 0..<10 do
                    streak(g.body.position + forward_of(double(k) * 36) * 0.4, ap.Vec3(0, ap.random(8, 13), 0),
                        f.kit.look.accent, 0.25, 0.6)
                end
            end
        end
    end
    add_prop(Prop(PROP_WALL, f.id, ap.Vec3(spot.x, 0, spot.z), 3.2, WALL_TICKS, ticks, f.heading))
    var at = ap.Vec3(spot.x, 0.1, spot.z)
    sound_at(snd_boom, at, 0.7, 0.6)
    sound_at(snd_thud, at, 0.8, 0.5)
    rings.push(Ring(at, f.kit.look.accent, 6, 0.3))
    burst(at, 24, ap.Color(130, 108, 86), 6, 0.6, 0.14)
    smoke(at, 10, 0.6, 1.2)
    stain(spot, ap.Color(30, 22, 16), 1.4, 8, 0.6)
end

# CARBON's chunk comes out of the floor in front of her.
function tear_ground(Fighter f)
    var at = f.body.position + forward_of(f.heading) * 0.8
    stain(at, ap.Color(26, 20, 14), 0.8, 6, 0.7)
    burst(at + ap.Vec3(0, 0.1, 0), 14, ap.Color(130, 108, 86), 4, 0.5, 0.12)
    sound_at(snd_thud, at, 0.7, 0.8)
end

# TELEMAN: change the channel, and the two of them are where the other was.
function switch_places(Fighter f, Fighter o)
    if o.state == STATE_DOWN do
        return
    end
    var mine = f.body.position
    var theirs = o.body.position
    leave_ghost(f, 0.3)
    leave_ghost(o, 0.3)
    f.body.position = ap.Vec3(theirs.x, mine.y, theirs.z)
    o.body.position = ap.Vec3(mine.x, theirs.y, mine.z)
    f.heading = heading_of(o.body.position - f.body.position)
    f.knock = ap.Vec3(0, 0, 0)
    o.knock = ap.Vec3(0, 0, 0)
    if o.state != STATE_HURT and o.safe == 0 and not unstoppable(o) do
        # A moment to work out which way is which.
        o.state = STATE_HURT
        o.stun = 20
        o.stun_total = 20
    end
    for g in [f, o] do
        for i in 0..<14 do
            var grey = int(ap.random(110, 250))
            spark(g.body.center() + scatter(0.5), scatter(1.4), ap.Color(grey, grey, grey), 0.35, 0.08, 0)
        end
        rings.push(Ring(g.body.position + ap.Vec3(0, 0.08, 0), f.kit.look.accent, 5, 0.25))
    end
    sound_at(snd_lock, mine, 0.6, 1.6)
    sound_at(snd_flash, theirs, 0.6, 1.4)
    say(o.body.top(), "CHANGED CHANNEL", f.kit.look.accent)
end

function minion_count(int side) returns int
    var n = 0
    for m in minions do
        if m.id == side do
            n += 1
        end
    end
    return n
end

# BOB's machine makes a weak copy of the one he has been dosing, to fight on his side.
function spawn_minion(Fighter f, Fighter o)
    Prop[] machines = []
    for pr in props do
        if pr.kind == PROP_MACHINE and pr.owner == f.id do
            machines.push(pr)
        end
    end
    var spot = f.body.position - forward_of(f.heading) * 1.2
    if machines.length > 0 do
        var pr = machines[pick_index(machines.length)]
        spot = pr.position + forward_of(pr.yaw) * 1.3
    end
    var m = new_fighter(f.id, o.pick)
    m.minion = true
    m.cpu = true
    m.power_scale = MINION_POWER
    m.max_health = m.kit.health * MINION_HEALTH
    m.health = m.max_health
    m.shown_health = m.max_health
    m.bar = m.kit.bar_start
    m.arrows = m.kit.quiver
    m.body.position = ap.Vec3(spot.x, 0, spot.z)
    m.heading = heading_of(o.body.position - spot)
    m.cool = 30
    m.safe = 20
    prepare_kit(m)
    m.pose = target_pose(m)
    m.pose_speed = puppet.still()
    minions.push(m)
    var green = ap.Color(120, 255, 120)
    var at = m.body.center()
    burst(at, 30, green, 5, 0.6, 0.1)
    rings.push(Ring(m.body.position + ap.Vec3(0, 0.1, 0), green, 6, 0.4))
    rings.push(Ring(at, green, 4, 0.3, true))
    sound_at(snd_charge, at, 0.7, 0.8)
    later(snd_splash, at, 6, 0.6, 0.8)
    say(m.body.top() + ap.Vec3(0, 0.3, 0), "CLONE OF {o.kit.name}", green)
end

# A dose lands: enough of them and the machine makes a clone.
function count_dose(Fighter f, Fighter o)
    if o.minion do
        return
    end
    var labs = mx(f).labs
    var need = 1 if labs else f.kit.inject_need
    var limit = 2 if labs else 1
    f.injects = math.min(f.injects + 1, need)
    if f.injects < need do
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "DOSE {f.injects}/{need}", f.kit.look.accent)
        return
    end
    if minion_count(f.id) >= limit do
        say(f.body.top(), "ONE CLONE AT A TIME" if limit == 1 else "CLONE LIMIT", ap.GRAY)
    else if f.clone_cool > 0 and not labs do
        say(f.body.top(), "MACHINE COOLING {(f.clone_cool + 59) // 60}s", ap.GRAY)
    else do
        f.injects = 0
        spawn_minion(f, o)
    end
end

function minion_dies(Fighter m)
    var green = ap.Color(120, 255, 120)
    var at = m.body.center()
    burst(at, 26, green, 4, 0.6, 0.1)
    smoke(at, 10, 0.5, 1.0)
    sound_at(snd_splash, at, 0.7, 0.6)
    sound_at(snd_hiss, at, 0.5, 0.8)
    say(m.body.top(), "DISSOLVED", green)
    var owner = fighters[m.id]
    owner.clone_cool = int(owner.kit.clone_cool * 60)
end

# A fighter's moves set up for a new round (or a new clone).
function prepare_kit(Fighter f)
    restore_moves(f)
    if f.kit.arsenal.length > 0 do
        f.arm_cools = []
        f.arm = 0
        equip(f, 0)
    end
    if f.kit.copycat do
        f.copy_locked = false
        f.kit.skills[1].name = "Lock"
        f.kit.skills[3] = random_skill()
    end
end

# Begins a move if the bar allows. True when the button press was used up.
function begin_attack(Fighter f, roster.Attack a, int hits)
    f.state = STATE_ATTACK
    f.frame = 0
    f.move = a
    f.move_hits = hits
    f.hits_done = 0
    f.serial += 1
    f.ambush = f.cloaked
    f.connected = false
    f.blocked = false
    f.empowered = false
    if not a.per_hit do
        pay(f, a.cost)
    end
    if a.evade do
        f.dash_way = unit(flat(f.wish)) if f.wish.length() > 0.2 else forward_of(f.heading) * -1.0
        sound_at(snd_dash, f.body.position, 0.4, 0.8)
        if a.buff == roster.BUFF_POWER do
            # Thrown clear by a blast at their own feet.
            var feet = f.body.position + ap.Vec3(0, 0.2, 0)
            sound_at(snd_boom, feet, 0.6, 1.5)
            sound_at(snd_shot, feet, 0.6, 0.6)
            burst(feet, 16, ap.Color(255, 190, 110), 5, 0.4, 0.1)
            smoke(feet, 8, 0.4, 0.8)
            rings.push(Ring(feet, f.kit.look.accent, 6, 0.25))
        end
    end
    sound_at(weapon_swing_sound(f), f.body.position, 0.35, 0.8 if a.startup > 14 else 1.2)
    skill_begins(f, a)
    signature(f, SIG_BEGIN, a, f.body.position)
end

function deny(Fighter f, string words)
    sound_at(snd_deny, f.body.position, 0.4)
    say(f.body.top(), words, ap.GRAY)
end

# Whether skill `slot` is off cooldown and paid for.
function move_ready(Fighter f, int slot) returns bool
    var a = f.kit.skills[slot]
    return f.cooldowns[slot] == 0 and can_pay(f, a.cost) and a.kind != roster.KIND_RELOAD and f.locks[slot] == 0 and
        f.bar + 0.001 >= a.need and not out_of_arrows(f, a) and not (a.kind == roster.KIND_QUIVER and f.arrows >= f.kit.quiver)
end

# HUNTER: every arrow shot comes out of the quiver, and an empty one shoots nothing until it is changed.
function uses_arrow(Fighter f, roster.Attack a) returns bool
    return f.kit.quiver > 0 and a.shot == roster.SHOT_ARROW
end

function out_of_arrows(Fighter f, roster.Attack a) returns bool
    return uses_arrow(f, a) and f.arrows <= 0
end

function change_quiver(Fighter f)
    f.arrows = f.kit.quiver
    say(f.body.top(), "ARROW NOCKED" if f.kit.quiver == 1 else "{f.kit.quiver} ARROWS", f.kit.look.accent)
    sound_at(snd_reload, f.body.position, 0.5, 0.8)
    later(snd_cloth, f.body.position, 5, 0.5, 1.1)
end

# Round wins that take the match.
function wins_needed() returns int
    if endless() do
        return 1000000
    end
    if length_kind == LEN_SINGLE do
        return 1
    end
    return (best_of + 1) // 2
end

# Whether the five-slot round display (two each side and the finale) is in use: a best of 5.
function finale_slots() returns bool
    return length_kind == LEN_BEST and best_of == 5
end

# --- The random pool ---------------------------------------------------------------------------
# Who the random modes deal from. There are a lot of fighters and not everyone wants to learn
# them all, so in RANDOM and RANDOM TEAM the select screen is the pool instead: every fighter is
# in it unless banned, a preset sets it in one go, and it is remembered in the save file.
const string[] POOL_PRESETS = ["CLASSIC", "EXPANDED", "SECOND WAVE", "FULL"]
const int POOL_MIN = 2                # never fewer than this left to deal from
const int CLASSIC_COUNT = 10          # the first fighters, the original roster...
const int EXPANDED_COUNT = 26         # ...and the first wave (the second wave comes after)
bool[] banned = []

function pool_size() returns int
    var n = 0
    for i in 0..<cast.length do
        if not is_banned(i) do
            n += 1
        end
    end
    return n
end

function is_banned(int who) returns bool
    return who < banned.length and banned[who]
end

# Whether preset `k` lets fighter `who` in.
function preset_has(int k, int who) returns bool
    if k == 0 do
        return who < CLASSIC_COUNT
    else if k == 1 do
        return who < EXPANDED_COUNT
    else if k == 2 do
        return who >= EXPANDED_COUNT
    end
    return true
end

# The preset the pool is now, or -1 when it has been hand-picked.
function pool_preset() returns int
    for k in 0..<POOL_PRESETS.length do
        var same = true
        for i in 0..<cast.length do
            if preset_has(k, i) == is_banned(i) do
                same = false
                break
            end
        end
        if same do
            return k
        end
    end
    return -1
end

function pool_name() returns string
    var k = pool_preset()
    return POOL_PRESETS[k] if k >= 0 else "CUSTOM"
end

function set_pool_preset(int k)
    bool[] fresh = []
    for i in 0..<cast.length do
        fresh.push(not preset_has(k, i))
    end
    banned = fresh
    remember()
end

# The next preset along (from a custom pool, the first).
function cycle_pool_preset()
    var k = pool_preset()
    set_pool_preset((k + 1) % POOL_PRESETS.length)
end

# Bans or lets back in fighter `who`; false when that would leave too few to deal.
function toggle_ban(int who) returns bool
    if not is_banned(who) and pool_size() <= POOL_MIN do
        return false
    end
    while banned.length < cast.length do
        banned.push(false)
    end
    banned[who] = not banned[who]
    remember()
    return true
end

# A fighter at random from the pool.
function deal_one() returns int
    var left = pool_size()
    if left == 0 do
        return pick_index(cast.length)
    end
    var n = pick_index(left)
    for i in 0..<cast.length do
        if not is_banned(i) do
            if n == 0 do
                return i
            end
            n -= 1
        end
    end
    return pick_index(cast.length)
end

function load_bans()
    bool[] fresh = []
    for c in cast do
        fresh.push(saved.banned.contains(c.name))
    end
    banned = fresh
    if pool_size() < POOL_MIN do
        set_pool_preset(POOL_PRESETS.length - 1)
    end
end

# Each side's fighters when they are dealt rather than picked: a whole team for a random team, or
# whoever fights first (and their ally in 2v2). Nobody twice on a side, except in an Endless
# random team, which may hold the same fighter more than once.
function deal_teams()
    var size = team_size() if lineup == LINE_RANDOM_TEAM else (2 if duo else 1)
    var repeats = endless() and lineup == LINE_RANDOM_TEAM
    for i in 0..<2 do
        int[] team = []
        while team.length < size do
            var who = deal_one()
            if repeats or not team.contains(who) or team.length >= pool_size() do
                team.push(who)
            end
        end
        teams[i] = team
    end
end

# Room in `teams` for every pick the select screen will make.
function fit_teams()
    var size = math.max(side_size(), 2)
    for i in 0..<2 do
        int[] team = []
        for k in 0..<size do
            team.push(teams[i][k] if k < teams[i].length else (i + 2 * k) % cast.length)
        end
        teams[i] = team
    end
end

# Whether this round can decide a Finale match: someone's two side slots are full.
function finale_round() returns bool
    return finale_slots() and (fighters[0].wins >= 2 or fighters[1].wins >= 2)
end

# Teams: anyone who lost a round hands over to the next fighter of their team. Random: everyone is
# dealt someone new. Round wins and the super bar go with the side, not the fighter.
function next_fighters()
    banner_sub = ""
    if lineup == LINE_RANDOM do
        # A fresh pair, dealt at random; wins and the super bar stay with the side.
        for i in 0..<2 do
            var f = fighters[i]
            var g = new_fighter(i, deal_one())
            g.wins = f.wins
            g.energy = f.energy
            fighters[i] = g
        end
        banner_sub = "{fighters[0].kit.name}  VS  {fighters[1].kit.name}"
        if duo do
            partner_picks = [deal_one(), deal_one()]
            banner_sub = "{fighters[0].kit.name} + {cast[partner_picks[0]].name}  VS  {fighters[1].kit.name} + {cast[partner_picks[1]].name}"
        end
        banner_sub_color = MAX_GOLD
        return
    end
    if not team_play() do
        return
    end
    var changed = false
    var size = team_size()
    for i in 0..<2 do
        var f = fighters[i]
        var lost = fighters[1 - i].wins
        if duo do
            # Two of the three fight at once; every lost round rotates the next one in.
            partner_picks[i] = teams[i][(lost + 1) % size]
            var lead = teams[i][lost % size]
            if lead != f.pick do
                var g = new_fighter(i, lead)
                g.wins = f.wins
                g.energy = f.energy
                fighters[i] = g
                banner_sub = "{g.kit.name} AND {cast[partner_picks[i]].name} STEP IN"
                banner_sub_color = g.kit.look.accent
            end
            continue
        end
        # Rounds this side has lost are the rounds the other side has won; in Endless the team
        # goes round again.
        var want = teams[i][lost % size if endless() else math.min(lost, size - 1)]
        if want != f.pick do
            var g = new_fighter(i, want)
            g.wins = f.wins
            g.energy = f.energy
            fighters[i] = g
            changed = true
            banner_sub = "{g.kit.name} STEPS IN"
            banner_sub_color = g.kit.look.accent
        end
    end
end

# --- Maximums ------------------------------------------------------------------------------------

class WildPortal
    ap.Vec3 position
    int born
end

var max_owner = -1                   # who set off the maximum in force (-1: none)
var max_def = roster.Maximum()       # ...which one...
var max_left = 0                     # ...and the ticks it has left
var merge_owner = -1                 # who set off a second super inside it, merging the two (-1: none)
var merge_def = roster.Maximum()
var merge_left = 0
var half_dir = ap.Vec3(0, 0, 1)      # in a merge the first place is on this side of the seam...
var half_side = 0                    # ...and while one half is drawn: 1 the first, -1 the second, 0 both
var no_max = roster.Maximum()        # does nothing: what everyone else has
var max_cut = 0                      # ticks left of a cutscene
var cut_kind = CUT_SUPER
var cut_len = MAX_CUT_TICKS
var cut_hit = MAX_HIT
var cut_swap = MAX_SWAP
var cut_user = 0
var cut_def = roster.Maximum()
var cut_def2 = roster.Maximum()      # a merge: the place that was already there
var cut_anim = roster.ANIM_FOCUS
var cut_anim2 = roster.ANIM_FOCUS
var cut_title = ""
var cut_yaw = 0.0
var crumble = 0.0                    # 0..1: how far the old arena has come down (or has yet to rise)
var return_flash = 0                 # the white-out as the arena comes back
double[] strike_clocks = [0.0, 0.0]  # for the first place in force and the merged one
var wild_clock = 0.0
var wild_glow = ap.WHITE
WildPortal[] wild_portals = []
var mirror_clock = 0
var merge_pending = -1               # who has asked to merge into the super whose cutscene is on (-1: nobody)

# The deciding round of a best of 5: two rounds each.
function decider() returns bool
    return finale_slots() and fighters.length == 2 and fighters[0].wins == 2 and fighters[1].wins == 2
end

# Rounds this fighter is behind by.
function behind(Fighter f) returns int
    # Capped, so an ENDLESS match does not snowball the other way.
    return math.min(math.max(other(f).wins - f.wins, 0), 2)
end

# How much faster the super bar fills for whoever is behind.
function catch_up(Fighter f) returns double
    return 1 + UNDERDOG_SUPER * double(behind(f))
end

# Whether this fighter's own super is in force.
function in_super(Fighter f) returns bool
    return not f.minion and (max_owner == f.id or merge_owner == f.id)
end

# How fast a fighter's super bar fills: not at all inside their own super, faster inside someone
# else's, faster when behind on rounds, and never for a clone.
function gain(Fighter f) returns double
    if f.minion or f.partner or in_super(f) or f.kit.mech == roster.MECH_FLASQUE do
        return 0
    end
    var rate = catch_up(f) * items.more(st(f, items.E_SUPER))
    if max_owner >= 0 do
        rate *= SUPER_FOE_GAIN
    end
    return rate
end

# The maximum working for this fighter, or one that does nothing.
function mx(Fighter f) returns roster.Maximum
    if f.minion do
        return no_max
    end
    if max_owner == f.id do
        return max_def
    end
    if merge_owner == f.id do
        return merge_def
    end
    return no_max
end

# Ticks this fighter's own super has left.
function super_left(Fighter f) returns int
    return merge_left if merge_owner == f.id else max_left
end

# Inside your own super, with the old super move still to use.
function encore_ready(Fighter f) returns bool
    return in_super(f) and max_cut == 0 and (not f.encore_used or f.kit.maximum.repeat_g)
end

# Whether G does something for this fighter right now: a super, a merge, a switch-off, or the move.
function can_super(Fighter f) returns bool
    if f.minion or f.partner or max_cut > 0 do
        return false
    end
    if encore_ready(f) do
        return true
    end
    if f.kit.mech == roster.MECH_FLASQUE do
        # No super bar: a full purse of coins.
        return f.bar >= f.kit.bar_max and max_owner < 0 and not in_super(f)
    end
    if f.energy < roster.SUPER_MAX or in_super(f) do
        return false
    end
    if f.kit.maximum.jammer do
        return max_owner >= 0 and merge_owner < 0
    end
    # A merge only happens during the other one's cutscene (see update_cutscene).
    return max_owner < 0
end

# Whether `f` could merge their super into the one whose cutscene is playing.
function can_merge(Fighter f) returns bool
    return cut_kind == CUT_SUPER and max_cut > 0 and cut_user != f.id and merge_pending < 0 and not f.minion and not f.partner and
        f.energy >= roster.SUPER_MAX and not f.kit.maximum.jammer
end

# A second super is called during the first's cutscene: it merges as soon as the first place appears.
function request_merge(Fighter f)
    merge_pending = f.id
    f.energy = 0
    say(f.body.top() + ap.Vec3(0, 0.3, 0), "MERGE", f.kit.look.accent)
    sound_at(snd_bell, f.body.position, 0.8, 0.5)
    sound_at(snd_rift, f.body.position, 0.7, 0.6)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), f.kit.maximum.glow, 8, 0.5))
end

# Starts a cutscene of `kind`, `length` ticks long, for `f`.
function begin_cut(Fighter f, int kind, int length)
    var o = other(f)
    cut_kind = kind
    cut_len = length
    cut_hit = length * MAX_HIT // MAX_CUT_TICKS
    cut_swap = length * MAX_SWAP // MAX_CUT_TICKS
    cut_user = f.id
    max_cut = length
    cut_yaw = f.heading + 25
    f.energy = 0
    f.state = STATE_IDLE
    f.frame = 0
    o.knock = ap.Vec3(0, 0, 0)
    banner = ""
    pad.clear()
end

function begin_maximum(Fighter f)
    var own = f.kit.maximum
    if own.jammer do
        begin_jam(f)
        return
    end
    begin_cut(f, CUT_SUPER, own.cut_ticks)
    merge_pending = -1
    cut_title = own.name
    cut_def = own
    cut_anim = own.anim
    f.encore_used = false
    sound_at(snd_bell, f.body.position, 0.8, 0.4)
    sound_at(snd_charge, f.body.position, 0.7, 0.5)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), MAX_GOLD, 6, 0.5))
    if own.cut_ticks < MAX_CUT_TICKS do
        # A fast one: it is on before anyone can react.
        sound_at(snd_flash, f.body.position, 0.7, 0.7)
    end
end

# A super called inside someone else's: the two places tear into each other and merge.
function begin_merge(Fighter f)
    var first = fighters[max_owner]
    begin_cut(f, CUT_MERGE, MERGE_TICKS)
    cut_title = "DIMENSIONS COLLIDE"
    cut_def = f.kit.maximum
    cut_def2 = max_def
    cut_anim = cut_def.anim
    cut_anim2 = first.kit.maximum.anim
    f.encore_used = false
    first.state = STATE_IDLE
    first.frame = 0
    var mid = (f.body.center() + first.body.center()) * 0.5
    sound_at(snd_bell, mid, 0.8, 0.35)
    later(snd_bell, mid, 8, 0.7, 0.5)
    sound_at(snd_charge, f.body.position, 0.7, 0.5)
    sound_at(snd_charge, first.body.position, 0.7, 0.6)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), cut_def.glow, 6, 0.5))
    rings.push(Ring(first.body.position + ap.Vec3(0, 0.1, 0), cut_def2.glow, 6, 0.5))
end

# TELEMAN's super: only inside someone else's, which it switches off like a television.
function begin_jam(Fighter f)
    begin_cut(f, CUT_JAM, JAM_TICKS)
    cut_title = f.kit.maximum.name
    cut_def = max_def
    cut_anim = f.kit.maximum.anim
    sound_at(snd_lock, f.body.position, 0.8, 0.8)
    later(snd_zap_file, f.body.position, 4, 0.6, 0.7)
end

# The cutscene: the wind-up, the moment it goes off, the arena coming down, the new place.
function update_cutscene()
    var t = cut_len - max_cut
    max_cut -= 1
    var f = fighters[cut_user]
    var o = other(f)
    spring_pose(f, 18, 0.95)
    spring_pose(o, 18, 0.95)
    if cut_kind == CUT_JAM do
        update_jam(f, o, t)
        update_effects()
        return
    end
    if can_merge(o) do
        # G during the other one's cutscene: the two supers merge. The CPU does it on NORMAL and HARD.
        var wants = pad.buffered("super", 10) if not o.cpu else (cpu_mode == CPU_FIGHTS and level >= 1 and t >= LEVEL_REACT[level])
        if wants do
            if not o.cpu do
                pad.consume("super")
            end
            request_merge(o)
        end
    end
    if merge_pending >= 0 and t >= cut_swap do
        # The first place is up; the second tears straight into it.
        var second = fighters[merge_pending]
        merge_pending = -1
        if t == cut_swap do
            swap_to_maximum(f)
        end
        f.safe = math.max(f.safe, 30)
        begin_merge(second)
        update_effects()
        return
    end
    var merging = cut_kind == CUT_MERGE
    if t < cut_hit do
        # The screen trembles while the close-ups are up, and jolts as the words land.
        ap.shake(7 if t == SHOUT_AT else 1.6, 16 if t == SHOUT_AT else 6)
    end
    var center = f.body.center()
    if merging do
        center = (f.body.center() + o.body.center()) * 0.5
    end
    var tint = f.kit.look.accent
    if t < cut_hit do
        if t % 2 == 0 do
            gather(f.body.center(), 3, cut_def.glow if t % 4 == 0 else tint, 1.8, 0.3, 0.07)
            if merging do
                gather(o.body.center(), 3, cut_def2.glow if t % 4 == 0 else o.kit.look.accent, 1.8, 0.3, 0.07)
                # The two powers reach for each other.
                var along = ap.random(0, 1)
                spark(f.body.center().lerp(o.body.center(), along) + scatter(0.2), scatter(0.6),
                    cut_def.glow if along < 0.5 else cut_def2.glow, 0.3, 0.08, 0)
            end
        end
        if t % 18 == 0 do
            sound_at(snd_charge, center, 0.4, 0.6 + double(t) / double(math.max(cut_hit, 1)))
        end
    end
    if t == cut_hit do
        sound_at(snd_ko, center, 0.8, 0.8)
        sound_at(snd_boom, center, 0.8, 0.6)
        later(snd_thud, center, 6, 0.8, 0.5)
        burst(center, 50, cut_def.glow, 9, 0.7, 0.12)
        burst(center, 30, tint, 6, 0.6, 0.1)
        rings.push(Ring(flat(center) + ap.Vec3(0, 0.1, 0), cut_def.glow, 14, 0.6))
        rings.push(Ring(center, ap.WHITE, 10, 0.4, true))
        if merging do
            burst(center, 50, cut_def2.glow, 9, 0.7, 0.12)
            rings.push(Ring(flat(center) + ap.Vec3(0, 0.1, 0), cut_def2.glow, 10, 0.6))
            later(snd_ko, center, 10, 0.7, 0.6)
        end
    end
    if t >= cut_hit and t < cut_swap do
        if merging do
            # A seam tears open across the world, each side bleeding into the other.
            var way = unit(flat(o.body.position - f.body.position))
            var across = ap.Vec3(way.z, 0, -way.x)
            for i in 0..<3 do
                var at = across * ap.random(-14, 14) + ap.Vec3(0, ap.random(0, 7), 0)
                streak(at, way * ap.random(-3, 3) + ap.Vec3(0, ap.random(-2, 4), 0), cut_def.glow if i % 2 == 0 else cut_def2.glow,
                    0.4, 0.8, 0.07)
            end
            if t % 8 == 0 do
                sound_at(snd_rift, center + across * ap.random(-6, 6), 0.5, ap.random(0.5, 0.8))
            end
        else do
            crumble = double(t - cut_hit) / double(math.max(cut_swap - cut_hit, 1))
            # Stone coming off the pillars, dust off the floor's edge.
            for pl in pillars do
                if ap.chance(0.5) do
                    spark(pl.base + ap.Vec3(ap.random(-0.6, 0.6), ap.random(0, pl.height), ap.random(-0.6, 0.6)),
                        ap.Vec3(ap.random(-1, 1), ap.random(0, 2), ap.random(-1, 1)), ap.Color(90, 86, 110), 1.2, 0.2, 9)
                end
            end
            if ap.chance(0.6) do
                var edge = forward_of(ap.random(0, 360)) * (ARENA + 0.8)
                spark(edge, ap.Vec3(0, ap.random(1, 3), 0), ap.Color(110, 100, 130), 1.0, 0.25, 6)
            end
            if t % 10 == 0 do
                sound_at(snd_thud, ap.Vec3(ap.random(-8, 8), 0, ap.random(-8, 8)), 0.6, ap.random(0.4, 0.7))
                sound_at(snd_boom, center, 0.3, 0.4)
            end
        end
    end
    if t == cut_swap do
        if merging do
            swap_to_merge(f)
        else do
            swap_to_maximum(f)
        end
    end
    if max_cut == 0 do
        f.safe = math.max(f.safe, 30)
        o.safe = math.max(o.safe, 30)
        say(f.body.top(), cut_def.place, cut_def.glow)
    end
    update_effects()
end

# TELEMAN aims the remote: click, the picture collapses to a dot, and the super is gone.
function update_jam(Fighter f, Fighter o, int t)
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    if t < JAM_CLICK do
        for i in 0..<3 do
            var grey = int(ap.random(120, 250))
            spark(hand + scatter(0.25), scatter(1.2), ap.Color(grey, grey, grey), 0.25, 0.07, 0)
        end
    end
    if t == JAM_CLICK do
        sound_at(snd_lock, hand, 0.8, 1.7)
        sound_at(snd_zap_file, cam_focus, 0.7, 0.5)
        later(snd_charge, cam_focus, 2, 0.6, 2.4)
        for i in 0..<12 do
            streak(hand, unit(o.body.center() - hand + scatter(0.3)) * 14, f.kit.look.accent, 0.2, 0.6)
        end
    end
    if t == JAM_DARK do
        var a = f.kit.ultimate
        super_over(fighters[max_owner], max_def)
        restore_arena(max_def.glow)
        return_flash = 0
        # Back on the air, they are left reeling.
        var damage = a.damage * o.kit.armor * f.kit.greed * (1 - UNDERDOG_GUARD * double(behind(o)))
        o.health -= damage
        o.state = STATE_HURT
        o.stun = a.stun
        o.stun_total = a.stun
        o.knock = ap.Vec3(0, 0, 0)
        o.safe = 0
        o.since_hit = 0
        o.taken = 1
        o.encore_used = true
        if o.cloaked do
            set_cloak(o, false)
        end
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "SWITCHED OFF", f.kit.look.accent)
        say(o.body.top(), "{int(damage + 0.5)}", ap.Color(255, 235, 200))
        sound_at(snd_ko, o.body.position, 0.8, 1.2)
        sound_at(snd_heavy, o.body.position, 0.8, 0.7)
        for i in 0..<30 do
            var grey = int(ap.random(120, 255))
            spark(o.body.center() + scatter(0.6), scatter(4), ap.Color(grey, grey, grey), 0.6, 0.09, 2)
        end
        rings.push(Ring(o.body.position + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 9, 0.4))
    end
    if max_cut == 0 do
        f.safe = math.max(f.safe, 20)
    end
end

function cutscene_camera()
    var f = fighters[cut_user]
    var t = double(cut_len - max_cut)
    var close = math.min(t / double(math.max(cut_hit, 1)), 1.0)
    var wide = math.clamp((t - double(cut_hit)) / 40, 0.0, 1.0)
    var focus = f.body.center() + ap.Vec3(0, 0.25, 0)
    var dist = 4.4 - 1.4 * close + 9 * puppet.smooth(wide)
    var pitch = 8 + 22 * puppet.smooth(wide)
    if cut_kind == CUT_MERGE do
        # Both of them, and the tear between.
        var o = other(f)
        focus = (f.body.center() + o.body.center()) * 0.5 + ap.Vec3(0, 0.25, 0)
        var apart = flat_distance(f.body.position, o.body.position)
        dist = 3.5 + apart * 0.7 - 1.0 * close + 7 * puppet.smooth(wide)
        cut_yaw = heading_of(o.body.position - f.body.position) + 90
    else if cut_kind == CUT_JAM do
        # Over the remote's shoulder, at whoever is being switched off.
        var o = other(f)
        focus = f.body.center().lerp(o.body.center(), 0.6) + ap.Vec3(0, 0.3, 0)
        dist = 4.5 + flat_distance(f.body.position, o.body.position) * 0.5
        pitch = 12
        cut_yaw = heading_of(o.body.position - f.body.position) + 160
    end
    if t >= double(cut_hit) and t < double(cut_hit + 14) and cut_kind != CUT_JAM do
        focus = focus + scatter(0.18 * (1 - (t - double(cut_hit)) / 14))
    end
    camera = ap.orbit(focus, cut_yaw + t * 0.5, pitch, dist)
    cam_focus = focus
    cam_distance = dist
    cam_yaw = cut_yaw + t * 0.5 - 24
end

# The old arena is gone: the user's place takes over.
function swap_to_maximum(Fighter f)
    max_owner = f.id
    max_def = cut_def
    crumble = 0
    pillars_up = false
    world = build_world()
    apply_max_look(max_def)
    strike_clocks = [0.0, 0.0]
    wild_clock = 2.5
    wild_portals = []
    max_left = int(max_def.seconds * 60)
    super_starts(f, max_def)
end

# Two places at once: each fills the half of the world on its owner's side of the seam.
function swap_to_merge(Fighter f)
    var first = fighters[max_owner]
    merge_owner = f.id
    merge_def = cut_def
    merge_left = int(merge_def.seconds * 60)
    half_dir = unit(flat(first.body.position - f.body.position))
    if half_dir.length() < 0.5 do
        half_dir = ap.Vec3(0, 0, 1)
    end
    strike_clocks[1] = 0
    apply_merge_look()
    super_starts(f, merge_def)
end

# What a super sets up the moment its place appears.
function super_starts(Fighter f, roster.Maximum m)
    if f.kit.bankrupt > 0 do
        # MONOPOLY: the bank opens, and it rains money.
        sound_at(snd_chip_stack, f.body.position, 0.8)
        later(snd_coin_splash, f.body.position, 8, 0.6)
        later(snd_gold_sack, f.body.position, 16, 0.6)
        for i in 0..<5 do
            banknotes(ap.Vec3(ap.random(-6, 6), 7, ap.random(-6, 6)), 8, 1)
        end
    end
    if m.randomize do
        randomize_moves(f)
    end
    if m.labs do
        # More machines along the edge of the lab.
        for k in 0..<2 do
            var around = heading_of(f.body.position) + (120.0 if k == 0 else -120.0)
            var spot = forward_of(around) * (ARENA - 1.6)
            add_prop(Prop(PROP_MACHINE, f.id, ap.Vec3(spot.x, 0, spot.z), 1.9, -1, ticks, around + 180, true))
        end
    end
    wave_super_starts(f, m)
    if m.clones > 0 do
        # The maze fills with copies at once.
        mirror_clock = MIRROR_REFORM
        for k in 0..<m.clones - mirror_count(f.id) do
            add_mirror(f, 360.0 * double(k + 1) / double(m.clones + 1), 90)
        end
    end
end

# A super's place is gone: whatever it changed about its owner goes back.
function super_over(Fighter f, roster.Maximum m)
    wave_super_over(f, m)
    if m.randomize do
        restore_moves(f)
    end
    if m.clones > 0 do
        for mi in mirrors do
            if mi.owner == f.id do
                mi.life = math.min(mi.life, 30)
            end
        end
    end
    if m.labs do
        Prop[] kept = []
        for pr in props do
            if not (pr.super_only and pr.owner == f.id) do
                kept.push(pr)
            else do
                burst(pr.position + ap.Vec3(0, 1, 0), 16, m.glow, 4, 0.5, 0.1)
            end
        end
        props = kept
        world = build_world()
    end
end

# Time is up for the first place in force.
function finish_maximum()
    super_over(fighters[max_owner], max_def)
    if merge_owner >= 0 do
        # The merge comes apart, and the second place takes the whole arena.
        max_owner = merge_owner
        max_def = merge_def
        max_left = merge_left
        merge_owner = -1
        strike_clocks[0] = strike_clocks[1]
        apply_max_look(max_def)
        return_flash = 16
        sound_at(snd_boom, cam_focus, 0.6, 0.7)
        return
    end
    restore_arena(max_def.glow)
end

# Time is up for the second, merged place: the first has the arena to itself again.
function end_merge()
    super_over(fighters[merge_owner], merge_def)
    merge_owner = -1
    apply_max_look(max_def)
    return_flash = 16
    sound_at(snd_boom, cam_focus, 0.6, 0.7)
end

# The arena pulls itself back together around the fighters.
function restore_arena(ap.Color glow)
    max_owner = -1
    merge_owner = -1
    wild_portals = []
    for f in fighters do
        for pl in pillars do
            var off = flat(f.body.position - pl.base)
            if off.length() < 1.1 do
                var away = unit(off) if off.length() > 0.05 else ap.Vec3(1, 0, 0)
                f.body.position = ap.Vec3(pl.base.x + away.x * 1.2, f.body.position.y, pl.base.z + away.z * 1.2)
            end
        end
    end
    pillars_up = true
    world = build_world()
    crumble = 1
    return_flash = 24
    apply_area()
    sound_at(snd_boom, cam_focus, 0.6, 0.5)
    sound_at(snd_bell, cam_focus, 0.5, 0.6)
    for pl in pillars do
        burst(pl.base + ap.Vec3(0, 0.3, 0), 8, glow, 3, 0.5, 0.1)
    end
end

# Back to the Purgatory, standing: at the start of every round.
function end_maximum()
    max_cut = 0
    merge_pending = -1
    return_flash = 0
    if merge_owner >= 0 and merge_owner < fighters.length do
        super_over(fighters[merge_owner], merge_def)
    end
    if max_owner >= 0 and max_owner < fighters.length do
        super_over(fighters[max_owner], max_def)
    end
    merge_owner = -1
    if max_owner >= 0 or not pillars_up or crumble > 0 do
        max_owner = -1
        crumble = 0
        pillars_up = true
        world = build_world()
        apply_area()
    end
    wild_portals = []
end

function apply_max_look(roster.Maximum m)
    sky_now = m.sky
    lamp_now = m.glow
    mote_now = m.mote
    drift_now = m.drift
    ap.ambient(m.ambient)
    ap.sun(ap.Vec3(-0.35, -1, -0.3), m.sun)
    ap.fog(m.sky, m.fog_near, m.fog_far)
    stone.color(m.ground)
    pillar_stone.color(m.ground)
    monolith_look.color(m.ground)
    rim_look.color(m.glow.brightness(0.4))
    rim_look.glow(m.glow, 1.6)
    floor_look.color(m.floor)
end

# Half of each: the light, the air and the stone of two places at once.
function apply_merge_look()
    var a = max_def
    var b = merge_def
    sky_now = a.sky.lerp(b.sky, 0.5)
    lamp_now = a.glow.lerp(b.glow, 0.5)
    mote_now = a.mote.lerp(b.mote, 0.5)
    drift_now = (a.drift + b.drift) / 2
    ap.ambient(a.ambient.lerp(b.ambient, 0.5))
    ap.sun(ap.Vec3(-0.35, -1, -0.3), a.sun.lerp(b.sun, 0.5))
    ap.fog(sky_now, (a.fog_near + b.fog_near) / 2, (a.fog_far + b.fog_far) / 2)
    stone.color(a.ground.lerp(b.ground, 0.5))
    pillar_stone.color(a.ground.lerp(b.ground, 0.5))
    monolith_look.color(a.ground.lerp(b.ground, 0.5))
    rim_look.color(a.glow.lerp(b.glow, 0.5).brightness(0.4))
    rim_look.glow(a.glow.lerp(b.glow, 0.5), 1.6)
    floor_look.color(a.floor.lerp(b.floor, 0.5))
end

function area_title() returns string
    if merge_owner >= 0 do
        return "{max_def.place} + {merge_def.place}"
    end
    return max_def.place if max_owner >= 0 else areas[area_to].name
end

function area_glow() returns ap.Color
    return max_def.glow if max_owner >= 0 else areas[area_to].glow
end

# What the places in force keep doing.
function update_maximum()
    if max_owner < 0 do
        # After a super, the pillars rise back out of the floor.
        if crumble > 0 and max_cut == 0 do
            crumble = math.max(crumble - 1.0 / 50, 0.0)
        end
        return_flash = math.max(return_flash - 1, 0)
        return
    end
    return_flash = math.max(return_flash - 1, 0)
    max_left -= 1
    if merge_owner >= 0 do
        merge_left -= 1
        if merge_left <= 0 do
            end_merge()
        end
    end
    if max_left <= 0 do
        finish_maximum()
        if max_owner < 0 do
            return
        end
    end
    scene_life(max_def.scene)
    if merge_owner >= 0 do
        scene_life(merge_def.scene)
        # The seam keeps sparking.
        var across = ap.Vec3(half_dir.z, 0, -half_dir.x)
        spark(across * ap.random(-ARENA, ARENA) + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(1, 3), 0),
            max_def.glow if ap.chance(0.5) else merge_def.glow, 0.8, 0.07, -0.5)
    end
    run_maximum(fighters[max_owner], max_def, 0)
    if merge_owner >= 0 do
        run_maximum(fighters[merge_owner], merge_def, 1)
    end
end

# One place's effects, for its owner `u`.
function run_maximum(Fighter u, roster.Maximum m, int k)
    var o = other(u)
    var dt = 1.0 / 60
    if m.portals do
        update_wild(u, m)
    end
    if m.clones > 0 do
        keep_mirrors(u, o, m.clones)
    end
    if u.state == STATE_DOWN or o.state == STATE_DOWN do
        return
    end
    wave_super_tick(u, o, m)
    if m.foe_dps > 0 do
        o.health -= m.foe_dps * dt
        u.health = math.min(u.health + m.foe_dps * m.drain * dt, u.max_health)
        if ap.chance(0.15) do
            spark(o.body.center() + scatter(0.4), ap.Vec3(0, ap.random(0.4, 1.2), 0), m.glow, 0.5, 0.06, 0)
        end
    end
    if m.foe_poison > 0 and not o.kit.machine do
        o.poison = math.min(o.poison + m.foe_poison * dt, roster.POISON_LIMIT)
    end
    if m.foe_slow and not o.kit.machine do
        o.slow = math.max(o.slow, 0.15)
    end
    if m.regen > 0 do
        u.health = math.min(u.health + m.regen * dt, u.max_health)
        if ap.chance(0.2) do
            spark(u.body.center() + scatter(0.4), ap.Vec3(0, ap.random(0.6, 1.4), 0), ap.Color(120, 240, 130), 0.5, 0.07, 0)
        end
    end
    if m.bar_regen > 0 do
        u.bar = math.min(u.bar + m.bar_regen * dt, u.kit.bar_max)
    end
    if m.strike.name != "" and m.strike_every > 0 do
        strike_clocks[k] += dt
        if strike_clocks[k] >= m.strike_every do
            strike_clocks[k] = 0
            send_strike(u, o, m)
        end
    end
end

# A shell, a star, a sunbeam from the sky, or a cab along the ground, at the foe.
function send_strike(Fighter u, Fighter o, roster.Maximum m)
    var a = m.strike
    if m.strike_ground do
        var way = forward_of(ap.random(0, 360))
        var start = flat(o.body.position) - way * 9
        if start.length() > ARENA - 1.2 do
            start = unit(start) * (ARENA - 1.2)
        end
        shots.push(Shot(u.id, a, ap.Vec3(start.x, 0.7, start.z), unit(flat(o.body.position - start)) * a.shot_speed, a.shot_life))
        sound_at(snd_kiai, start, 0.5, 1.4)
        later(snd_launch, start, 4, 0.5, 0.7)
        return
    end
    var target = flat(o.body.position) + ap.Vec3(ap.random(-1.6, 1.6), 0, ap.random(-1.6, 1.6))
    if target.length() > ARENA - 0.8 do
        target = unit(target) * (ARENA - 0.8)
    end
    shots.push(Shot(u.id, a, target + ap.Vec3(0, 14, 0), ap.Vec3(0, -a.shot_speed, 0), a.shot_life))
    stain(target, m.glow, a.blast, 14 / a.shot_speed + 0.15, 0.3)
    sound_at(snd_launch, target, 0.4, 1.3)
end

# Wild portals: they open here and there, lead into any other, and close after a while.
function update_wild(Fighter u, roster.Maximum m)
    var dt = 1.0 / 60
    wild_glow = m.glow
    wild_clock += dt
    WildPortal[] kept = []
    for w in wild_portals do
        if ticks - w.born < WILD_LIFE do
            kept.push(w)
        end
    end
    wild_portals = kept
    if wild_clock >= 3.5 and wild_portals.length < 6 do
        wild_clock = 0
        var spot = forward_of(ap.random(0, 360)) * ap.random(2, ARENA - 1.5)
        wild_portals.push(WildPortal(ap.Vec3(spot.x, 0, spot.z), ticks))
        var at = spot + ap.Vec3(0, 1, 0)
        sound_at(snd_rift, at, 0.5, 1.2)
        rings.push(Ring(at, wild_glow, 4, 0.25, true))
    end
    if wild_portals.length < 2 do
        return
    end
    for g in fighters do
        if g.warp_cool > 0 or g.state == STATE_DOWN do
            continue
        end
        for i, w in wild_portals do
            if ticks - w.born < 20 or flat_distance(g.body.position, w.position) > 0.8 or g.body.position.y > 1.6 do
                continue
            end
            var j = int(ap.random(0, double(wild_portals.length - 1) - 0.001))
            if j >= i do
                j += 1
            end
            var there = wild_portals[j]
            var going = unit(flat(g.body.velocity))
            if going.length() < 0.5 do
                going = forward_of(g.heading)
            end
            var out = there.position + going * 1.0
            if flat(out).length() > ARENA - 0.6 or world.overlaps(out + ap.Vec3(0, 1, 0), 0.5) do
                out = there.position
            end
            leave_ghost(g, 0.3)
            burst(g.body.center(), 12, wild_glow, 4, 0.35, 0.08)
            g.body.position = ap.Vec3(out.x, g.body.position.y, out.z)
            g.warp_cool = 55
            sound_at(snd_flash, there.position, 0.6, 1.1)
            rings.push(Ring(there.position + ap.Vec3(0, 1, 0), wild_glow, 5, 0.2, true))
            break
        end
    end
end

# --- Maximum scenery: each place is built out of boxes, columns, balls and rings around the disc.

# A steady 0..1 for item `i` (so a layout stays put from frame to frame).
function h01(int i, int salt) returns double
    var x = math.sin(double(i) * 12.9898 + double(salt) * 78.233) * 43758.5453
    return x - math.floor(x)
end

# In a merge each place is drawn only on its own side of the seam.
function keep(ap.Vec3 at) returns bool
    if half_side == 0 do
        return true
    end
    var d = at.x * half_dir.x + at.z * half_dir.z
    return d >= 0 if half_side > 0 else d < 0
end

function sd(ap.Mesh mesh, ap.Vec3 at, ap.Color color, ap.Vec3 rotation, ap.Vec3 size)
    if keep(at) do
        ap.draw(mesh, at, color, rotation, size)
    end
end

function sb(ap.Vec3 at, ap.Vec3 size, ap.Color color, double yaw = 0, double tilt = 0)
    sd(box, at, color, ap.Vec3(tilt, yaw, 0), size)
end

function column(ap.Vec3 base, double radius, double height, ap.Color color)
    sd(disc, base + ap.Vec3(0, height / 2, 0), color, ap.Vec3(0, 0, 0), ap.Vec3(radius, height, radius))
end

function ground_plane(ap.Color color)
    if half_side == 0 do
        ap.draw(box, ap.Vec3(0, -0.53, 0), color, ap.Vec3(0, 0, 0), ap.Vec3(260, 1, 260))
    else do
        ap.draw(box, half_dir * (65.0 * double(half_side)) + ap.Vec3(0, -0.53, 0), color,
            ap.Vec3(0, heading_of(half_dir), 0), ap.Vec3(260, 1, 130))
    end
end

# Glowing things: drawn without light so they shine in any dark.
function glow_box(ap.Vec3 at, ap.Vec3 size, ap.Color color, double yaw = 0)
    ap.lighting(false)
    sd(box, at, color, ap.Vec3(0, yaw, 0), size)
    ap.lighting(true)
end

function glow_ball(ap.Vec3 at, double size, ap.Color color)
    ap.lighting(false)
    sd(ball, at, color, ap.Vec3(0, 0, 0), ap.Vec3(size, size, size))
    ap.lighting(true)
end

# The line where two merged places meet.
function draw_seam()
    var yaw = heading_of(half_dir) + 90
    var pulse = 0.5 + 0.3 * math.sin(draw_clock() * 0.1)
    var both = max_def.glow.lerp(merge_def.glow, 0.5)
    ap.lighting(false)
    ap.draw(box, ap.Vec3(0, 0.04, 0), both, ap.Vec3(0, yaw, 0), ap.Vec3(0.1, 0.03, 2 * ARENA + 2))
    ap.draw(box, ap.Vec3(0, 10, 0), ap.WHITE.fade(0.05 * pulse + 0.03), ap.Vec3(0, yaw, 0), ap.Vec3(0.05, 20, 180))
    ap.draw(box, ap.Vec3(0, 10, 0), both.fade(0.08 * pulse), ap.Vec3(0, yaw, 0), ap.Vec3(0.5, 20, 180))
    ap.lighting(true)
end

function draw_scenery(roster.Maximum m)
    var scene = m.scene
    var t = draw_clock()
    if scene == roster.SCENE_CASTLE do
        ground_plane(ap.Color(34, 28, 32))
        var wall = ap.Color(70, 62, 70)
        for i in 0..<12 do
            var a = double(i) * 30
            var at = forward_of(a) * 24
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(4, 18, 4), wall)
            for k in 0..<4 do
                var c = forward_of(double(k) * 90 + 45) * 1.6
                sb(at + ap.Vec3(c.x, 18.6, c.z), ap.Vec3(0.9, 1.2, 0.9), wall)
            end
            sb(forward_of(a + 15) * 23.6 + ap.Vec3(0, 5, 0), ap.Vec3(12.5, 10, 1.5), ap.Color(58, 50, 58), a + 105)
            sb(forward_of(a + 15) * 22.7 + ap.Vec3(0, 6, 0), ap.Vec3(1.6, 5, 0.1), ap.Color(150, 20, 30), a + 105)
            glow_box(at - forward_of(a) * 2.05 + ap.Vec3(0, 12, 0), ap.Vec3(0.5, 0.8, 0.1), ap.Color(255, 160, 80), a + 90)
        end
        glow_ball(forward_of(200) * 52 + ap.Vec3(0, 26, 0), 15, ap.Color(220, 40, 50))
        glow_ball(forward_of(200) * 52 + ap.Vec3(0, 26, 0), 19, ap.Color(220, 40, 50).fade(0.25))
    else if scene == roster.SCENE_RING do
        ground_plane(ap.Color(20, 20, 28))
        var c = 11.3
        for k in 0..<4 do
            var sx = c if k % 2 == 0 else -c
            var sz = c if k < 2 else -c
            sb(ap.Vec3(sx, 1.0, sz), ap.Vec3(0.4, 2.0, 0.4), ap.Color(200, 200, 210))
            sb(ap.Vec3(sx, 2.05, sz), ap.Vec3(0.5, 0.15, 0.5), ap.Color(220, 40, 40) if k % 2 == 0 else ap.Color(40, 80, 220))
        end
        var ropes = [ap.Color(220, 40, 40), ap.Color(240, 240, 240), ap.Color(40, 80, 220)]
        for h in 0..<3 do
            var y = 0.6 + double(h) * 0.42
            sb(ap.Vec3(0, y, c), ap.Vec3(c * 2, 0.07, 0.07), ropes[h])
            sb(ap.Vec3(0, y, -c), ap.Vec3(c * 2, 0.07, 0.07), ropes[h])
            sb(ap.Vec3(c, y, 0), ap.Vec3(0.07, 0.07, c * 2), ropes[h])
            sb(ap.Vec3(-c, y, 0), ap.Vec3(0.07, 0.07, c * 2), ropes[h])
        end
        var shirts = [ap.Color(160, 40, 40), ap.Color(40, 70, 150), ap.Color(200, 180, 60), ap.Color(60, 120, 60), ap.Color(180, 180, 190)]
        for i in 0..<180 do
            var a = h01(i, 1) * 360
            var d = 15.5 + h01(i, 2) * 14
            var at = forward_of(a) * d
            var hop = math.max(math.sin(t * 0.15 + double(i)), 0.0) * 0.25
            sb(at + ap.Vec3(0, (d - 15) * 0.55 + 0.6 + hop, 0), ap.Vec3(0.55, 1.2, 0.45), shirts[i % 5], a)
            if h01(i + ticks // 5, 3) > 0.985 do
                glow_box(at + ap.Vec3(0, (d - 15) * 0.55 + 1.4, 0), ap.Vec3(0.3, 0.3, 0.3), ap.WHITE)
            end
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + 45) * 19
            sb(at + ap.Vec3(0, 8, 0), ap.Vec3(0.5, 16, 0.5), ap.Color(60, 60, 70))
            glow_box(at + ap.Vec3(0, 16, 0) - forward_of(double(k) * 90 + 45) * 0.5, ap.Vec3(1.4, 0.8, 0.8), ap.Color(255, 250, 220))
        end
    else if scene == roster.SCENE_SWAMP do
        sd(disc, ap.Vec3(0, -0.15, 0), ap.Color(40, 56, 36), ap.Vec3(0, 0, 0), ap.Vec3(90, 0.1, 90))
        for i in 0..<34 do
            var a = h01(i, 4) * 360
            var at = forward_of(a) * (13.5 + h01(i, 5) * 28)
            var tall = 5 + h01(i, 6) * 7
            var lean = (h01(i, 7) - 0.5) * 16
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(0.6, tall, 0.6), ap.Color(54, 44, 34), a, lean)
            sb(at + ap.Vec3(0, tall * 0.7, 0), ap.Vec3(3, 0.25, 0.25), ap.Color(50, 40, 32), a + 40, 25)
            sb(at + ap.Vec3(0, tall * 0.85, 0), ap.Vec3(2.2, 0.2, 0.2), ap.Color(50, 40, 32), a - 50, -20)
            sb(at + ap.Vec3(0.4, tall * 0.6, 0), ap.Vec3(0.12, 2.2, 0.12), ap.Color(90, 120, 60))
        end
        for i in 0..<30 do
            var at = forward_of(h01(i, 8) * 360) * (12 + h01(i, 9) * 16)
            sd(disc, at + ap.Vec3(0, -0.05, 0), ap.Color(70, 120, 50), ap.Vec3(0, 0, 0), ap.Vec3(0.6, 0.03, 0.6))
        end
    else if scene == roster.SCENE_HALL do
        ground_plane(ap.Color(150, 140, 130))
        for i in 0..<16 do
            var a = double(i) * 22.5
            var at = forward_of(a) * 16
            column(at, 0.9, 13, ap.Color(225, 220, 210))
            sb(at + ap.Vec3(0, 13.2, 0), ap.Vec3(2.4, 0.5, 2.4), ap.Color(235, 230, 220))
            sb(at + ap.Vec3(0, 0.25, 0), ap.Vec3(2.2, 0.5, 2.2), ap.Color(200, 195, 185))
            sb(forward_of(a + 11.25) * 16.5 + ap.Vec3(0, 8, 0), ap.Vec3(2.2, 7, 0.1), ap.Color(130, 20, 40), a + 101.25)
        end
        sb(ap.Vec3(0, 14, 0), ap.Vec3(40, 0.6, 40), ap.Color(70, 50, 36))
        for k in 0..<3 do
            var at = forward_of(double(k) * 120 + 30) * 7 + ap.Vec3(0, 10.5, 0)
            sd(hoop, at, ap.Color(220, 180, 90), ap.Vec3(0, t * 0.2, 0), ap.Vec3(2.2, 2.2, 2.2))
            sb(at + ap.Vec3(0, 1.7, 0), ap.Vec3(0.05, 3.4, 0.05), ap.Color(120, 100, 60))
            for c in 0..<8 do
                glow_ball(at + forward_of(double(c) * 45) * 1.75 + ap.Vec3(0, 0.2, 0), 0.22, ap.Color(255, 220, 140))
            end
        end
    else if scene == roster.SCENE_TOWN do
        ground_plane(ap.Color(170, 130, 85))
        var woods = [ap.Color(120, 80, 50), ap.Color(150, 110, 70), ap.Color(100, 70, 50), ap.Color(160, 130, 90)]
        for side in 0..<2 do
            var sx = 17.0 if side == 0 else -17.0
            var face = -1.0 if side == 0 else 1.0
            for k in 0..<7 do
                var z = -33 + double(k) * 11
                var h = 6 + h01(k + side * 10, 10) * 5
                sb(ap.Vec3(sx, h / 2, z), ap.Vec3(6, h, 9.5), woods[(k + side) % 4])
                sb(ap.Vec3(sx + face * 3.05, h + 1.2, z), ap.Vec3(0.3, 2.4, 9.5), woods[(k + side + 1) % 4])
                sb(ap.Vec3(sx + face * 4.2, 3.2, z), ap.Vec3(2.4, 0.2, 9.5), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 5.3, 1.6, z - 4.5), ap.Vec3(0.2, 3.2, 0.2), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 5.3, 1.6, z + 4.5), ap.Vec3(0.2, 3.2, 0.2), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 3.1, h - 1, z), ap.Vec3(0.15, 1, 5), ap.Color(230, 210, 170))
            end
        end
        for i in 0..<10 do
            var at = forward_of(double(i) * 36 + 10) * 70
            sb(at + ap.Vec3(0, 7, 0), ap.Vec3(20, 14 + h01(i, 11) * 10, 16), ap.Color(180, 100, 60), double(i) * 36)
        end
        for i in 0..<3 do
            var x = -30 + (t * 0.06 + double(i) * 21) % 60
            var at = ap.Vec3(x, 0.45, -6 + double(i) * 6)
            sd(ball, at, ap.Color(150, 120, 70), ap.Vec3(t * 4, 0, t * 3), ap.Vec3(0.9, 0.9, 0.9))
        end
    else if scene == roster.SCENE_ABYSS do
        ap.lighting(false)
        for i in 0..<60 do
            var a = h01(i, 12) * 360 + t * (0.05 + h01(i, 13) * 0.1)
            var at = forward_of(a) * (13 + h01(i, 14) * 20) + ap.Vec3(0, -6 + h01(i, 15) * 18, 0)
            sd(box, at, ap.WHITE.fade(0.5 + 0.3 * math.sin(t * 0.05 + double(i))), ap.Vec3(t * 0.3 + double(i), a, 20),
                ap.Vec3(0.08, 0.6 + h01(i, 16), 0.08))
        end
        ap.lighting(true)
    else if scene == roster.SCENE_TRENCHES do
        ground_plane(ap.Color(70, 58, 44))
        for row in 0..<2 do
            for i in 0..<52 do
                var a = double(i) * 360 / 52 + double(row) * 3.5
                var at = forward_of(a) * 12.6
                sb(at + ap.Vec3(0, 0.25 + double(row) * 0.45, 0), ap.Vec3(1.5, 0.45, 0.8), ap.Color(150, 130, 90), a + 90)
            end
        end
        for i in 0..<26 do
            var a = double(i) * 360 / 26
            var at = forward_of(a) * 16
            sb(at + ap.Vec3(0, 0.7, 0), ap.Vec3(0.12, 1.4, 0.12), ap.Color(70, 60, 50), a, 12)
            sb(forward_of(a + 7) * 16 + ap.Vec3(0, 1.0, 0), ap.Vec3(3.8, 0.04, 0.04), ap.Color(110, 110, 110), a + 97)
            sb(forward_of(a + 7) * 16 + ap.Vec3(0, 0.6, 0), ap.Vec3(3.8, 0.04, 0.04), ap.Color(110, 110, 110), a + 97)
        end
        for i in 0..<22 do
            var at = forward_of(h01(i, 17) * 360) * (15 + h01(i, 18) * 30)
            sd(disc, at + ap.Vec3(0, 0.01, 0), ap.Color(40, 32, 26), ap.Vec3(0, 0, 0), ap.Vec3(1.5 + h01(i, 19) * 2, 0.02, 1.5 + h01(i, 19) * 2))
        end
        for i in 0..<8 do
            var at = forward_of(h01(i, 20) * 360) * (20 + h01(i, 21) * 20)
            sb(at + ap.Vec3(0, 3, 0), ap.Vec3(0.5, 6, 0.5), ap.Color(40, 34, 28), 0, (h01(i, 22) - 0.5) * 30)
        end
        if int(t) % 50 < 3 do
            glow_box(forward_of(h01(ticks // 50, 23) * 360) * 60 + ap.Vec3(0, 2, 0), ap.Vec3(8, 3, 1), ap.Color(255, 180, 80))
        end
    else if scene == roster.SCENE_GRAVEYARD do
        ground_plane(ap.Color(36, 44, 38))
        for i in 0..<64 do
            var a = h01(i, 24) * 360
            var at = forward_of(a) * (12.5 + h01(i, 25) * 18)
            var tilt = (h01(i, 26) - 0.5) * 18
            if i % 4 == 0 do
                sb(at + ap.Vec3(0, 0.9, 0), ap.Vec3(0.18, 1.8, 0.18), ap.Color(120, 125, 130), a, tilt)
                sb(at + ap.Vec3(0, 1.3, 0), ap.Vec3(0.9, 0.16, 0.16), ap.Color(120, 125, 130), a, tilt)
            else do
                sb(at + ap.Vec3(0, 0.55, 0), ap.Vec3(0.8, 1.1, 0.22), ap.Color(110, 115, 115), a, tilt)
            end
        end
        for i in 0..<60 do
            var a = double(i) * 6
            sb(forward_of(a) * 32 + ap.Vec3(0, 1.1, 0), ap.Vec3(0.08, 2.2, 0.08), ap.Color(30, 30, 34))
        end
        sb(ap.Vec3(0, 3, -26), ap.Vec3(7, 6, 6), ap.Color(90, 92, 96))
        sb(ap.Vec3(0, 6.6, -26), ap.Vec3(8, 1.2, 7), ap.Color(70, 72, 76))
        glow_box(ap.Vec3(0, 2, -22.9), ap.Vec3(1.4, 2.6, 0.1), ap.Color(120, 170, 255))
    else if scene == roster.SCENE_TOWER do
        column(ap.Vec3(0, -40, 0), ARENA + 1.2, 39.3, ap.Color(70, 68, 96))
        for i in 0..<24 do
            var a = double(i) * 15
            if i % 2 == 0 do
                sb(forward_of(a) * (ARENA + 0.9) + ap.Vec3(0, 0.5, 0), ap.Vec3(1.6, 1.0, 0.7), ap.Color(90, 88, 120), a + 90)
            end
        end
        ap.lighting(false)
        for i in 0..<200 do
            var az = h01(i, 27) * 360
            var el = (8 + h01(i, 28) * 75) * math.PI / 180
            var at = forward_of(az) * (60 * math.cos(el)) + ap.Vec3(0, 60 * math.sin(el), 0)
            var twinkle = 0.5 + 0.5 * math.sin(t * 0.08 + double(i) * 1.7)
            sd(box, at, ap.Color(255, 250, 220).fade(0.4 + 0.6 * twinkle), ap.Vec3(0, 0, 0), ap.Vec3(0.25, 0.25, 0.25))
        end
        ap.lighting(true)
        for i in 0..<5 do
            var at = forward_of(double(i) * 72 + 20) * 45
            column(at + ap.Vec3(0, -40, 0), 3, 45, ap.Color(60, 58, 86))
            sb(at + ap.Vec3(0, 7, 0), ap.Vec3(5, 4, 5), ap.Color(70, 50, 110), 45)
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + t * 0.3) * 13 + ap.Vec3(0, 3 + math.sin(t * 0.03 + double(k)) * 0.5, 0)
            glow_box(at, ap.Vec3(0.4, 0.9, 0.4), m.glow, t)
        end
    else if scene == roster.SCENE_CITY do
        ground_plane(ap.Color(30, 30, 36))
        for i in 0..<32 do
            var a = double(i) * 360 / 32 + h01(i, 29) * 6
            var d = 24 + h01(i, 30) * 20
            var w = 6 + h01(i, 31) * 6
            var h = 16 + h01(i, 32) * 46
            var at = forward_of(a) * d
            sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(w, h, w), ap.Color(34, 34, 48), a)
            var face = at - forward_of(a) * (w / 2 + 0.06)
            var rows = int(h / 3)
            for r in 0..<rows do
                if h01(i * 40 + r, 33) > 0.35 do
                    glow_box(face + ap.Vec3(0, 1.5 + double(r) * 3, 0), ap.Vec3(w * 0.8, 0.9, 0.05), ap.Color(255, 220, 140).fade(0.5 + h01(i * 40 + r, 34) * 0.5), a + 90)
                end
            end
            if i % 5 == 0 do
                glow_box(face + ap.Vec3(0, 8, 0) - forward_of(a) * 0.1, ap.Vec3(w * 0.6, 1.6, 0.05), ap.Color(255, 60, 200) if i % 10 == 0 else ap.Color(60, 230, 255), a + 90)
            end
        end
        for i in 0..<10 do
            var at = forward_of(double(i) * 36) * 13.5
            sb(at + ap.Vec3(0, 2.5, 0), ap.Vec3(0.14, 5, 0.14), ap.Color(40, 40, 46))
            glow_box(at + ap.Vec3(0, 5, 0), ap.Vec3(0.5, 0.25, 0.5), ap.Color(255, 230, 160))
        end
    else if scene == roster.SCENE_WAREHOUSE do
        ground_plane(ap.Color(60, 58, 56))
        var wall = ap.Color(70, 66, 64)
        sb(ap.Vec3(0, 7, 20), ap.Vec3(40, 14, 1), wall)
        sb(ap.Vec3(0, 7, -20), ap.Vec3(40, 14, 1), wall)
        sb(ap.Vec3(20, 7, 0), ap.Vec3(1, 14, 40), wall)
        sb(ap.Vec3(-20, 7, 0), ap.Vec3(1, 14, 40), wall)
        for k in 0..<6 do
            sb(ap.Vec3(-15 + double(k) * 6, 13, 0), ap.Vec3(0.5, 0.7, 40), ap.Color(50, 48, 46))
        end
        for i in 0..<26 do
            var at = forward_of(h01(i, 35) * 360) * (12.6 + h01(i, 36) * 5)
            var stack = 1 + int(h01(i, 37) * 3)
            for k in 0..<stack do
                sb(at + ap.Vec3(0, 0.75 + double(k) * 1.5, 0), ap.Vec3(1.5, 1.5, 1.5), ap.Color(140, 100, 60), h01(i, 38) * 90 + double(k) * 10)
            end
        end
        var siren = 0.5 + 0.5 * math.sin(t * 0.25)
        for k in 0..<4 do
            var at = forward_of(double(k) * 90) * 19.3 + ap.Vec3(0, 10, 0)
            glow_box(at, ap.Vec3(1, 0.6, 1), ap.Color(255, 30, 20).fade(0.3 + 0.7 * siren))
        end
    else if scene == roster.SCENE_ALLEY do
        ground_plane(ap.Color(26, 28, 32))
        for side in 0..<2 do
            var sx = 12.6 if side == 0 else -12.6
            var face = -1.0 if side == 0 else 1.0
            sb(ap.Vec3(sx, 9, 0), ap.Vec3(1.2, 18, 90), ap.Color(90, 50, 44))
            for k in 0..<8 do
                var z = -35 + double(k) * 10
                sb(ap.Vec3(sx + face * 1.2, 5 + double(k % 3) * 3, z), ap.Vec3(1.4, 0.12, 4), ap.Color(40, 40, 44))
                if h01(k + side * 8, 39) > 0.5 do
                    glow_box(ap.Vec3(sx + face * 0.62, 8 + double(k % 2) * 4, z + 2), ap.Vec3(0.05, 1.6, 1.2), ap.Color(255, 210, 130))
                end
            end
            sb(ap.Vec3(sx + face * 1.6, 0.7, -6 + double(side) * 10), ap.Vec3(1.6, 1.4, 2.6), ap.Color(40, 80, 50))
            sb(ap.Vec3(sx + face * 0.9, 3, 4 - double(side) * 9), ap.Vec3(0.12, 6, 0.12), ap.Color(40, 40, 46))
            glow_box(ap.Vec3(sx + face * 1.6, 5.8, 4 - double(side) * 9), ap.Vec3(0.6, 0.3, 0.6), m.glow)
        end
        for i in 0..<12 do
            var at = ap.Vec3((h01(i, 40) - 0.5) * 18, 0.015, (h01(i, 41) - 0.5) * 60)
            sd(disc, at, ap.Color(70, 80, 100), ap.Vec3(0, 0, 0), ap.Vec3(0.8 + h01(i, 42), 0.02, 0.6 + h01(i, 43)))
        end
    else if scene == roster.SCENE_REACTOR do
        ground_plane(ap.Color(76, 70, 62))
        for k in 0..<3 do
            var at = forward_of(double(k) * 50 + 150) * 42
            for s in 0..<9 do
                var u = double(s) / 8
                var r = 5.2 + 9 * (u - 0.65) * (u - 0.65)
                column(at + ap.Vec3(0, double(s) * 3, 0), r, 3.05, ap.Color(170, 160, 150))
            end
        end
        sb(ap.Vec3(14, 6, -30), ap.Vec3(16, 12, 12), ap.Color(110, 104, 96))
        sb(ap.Vec3(10, 12.5, -26), ap.Vec3(7, 1.5, 5), ap.Color(90, 84, 78), 20, 25)
        sb(ap.Vec3(18, 11.5, -32), ap.Vec3(6, 1.2, 6), ap.Color(90, 84, 78), -15, -30)
        glow_box(ap.Vec3(14, 9, -24), ap.Vec3(5, 4, 0.2), ap.Color(150, 255, 80).fade(0.6 + 0.3 * math.sin(t * 0.1)))
        for i in 0..<18 do
            var at = forward_of(h01(i, 44) * 360) * (12.5 + h01(i, 45) * 8)
            column(at, 0.4, 1.0, ap.Color(220, 190, 40))
            sd(disc, at + ap.Vec3(0, 1.01, 0), ap.Color(40, 40, 40), ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.02, 0.2))
        end
        for i in 0..<40 do
            var a = double(i) * 9
            sb(forward_of(a) * 22 + ap.Vec3(0, 1.2, 0), ap.Vec3(0.1, 2.4, 0.1), ap.Color(90, 90, 90), 0, (h01(i, 46) - 0.5) * 20)
        end
    else if scene == roster.SCENE_FACTORY do
        ground_plane(ap.Color(54, 52, 50))
        for k in 0..<5 do
            var a = double(k) * 72 + 20
            var at = forward_of(a) * 20 + ap.Vec3(0, 6, 0)
            var spin = t * (0.6 if k % 2 == 0 else -0.8)
            sd(hoop, at, ap.Color(120, 110, 100), ap.Vec3(90, a, spin), ap.Vec3(6, 6, 18))
            for c in 0..<8 do
                var tooth = forward_of(double(c) * 45 + spin) * 4.9
                sb(at + ap.Vec3(tooth.x * math.cos(a * math.PI / 180), tooth.z, -tooth.x * math.sin(a * math.PI / 180)),
                    ap.Vec3(0.8, 0.8, 0.8), ap.Color(110, 100, 90), a)
            end
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + 45) * 34
            column(at, 1.6, 30, ap.Color(90, 70, 60))
        end
        for k in 0..<2 do
            var z = 14.0 if k == 0 else -14.0
            sb(ap.Vec3(0, 0.6, z), ap.Vec3(30, 1.2, 2), ap.Color(40, 40, 44))
            for c in 0..<5 do
                var x = -15 + (t * 0.04 + double(c) * 6) % 30
                sb(ap.Vec3(x if k == 0 else -x, 1.6, z), ap.Vec3(1, 0.8, 1), ap.Color(150, 110, 60))
            end
        end
        glow_box(ap.Vec3(-17, 2, 0), ap.Vec3(1, 3, 5), ap.Color(255, 140, 30).fade(0.7 + 0.3 * math.sin(t * 0.3)), 90)
    else if scene == roster.SCENE_SUN do
        glow_ball(forward_of(170) * 60 + ap.Vec3(0, 4, 0), 44, ap.Color(255, 250, 220))
        glow_ball(forward_of(170) * 60 + ap.Vec3(0, 4, 0), 54, ap.Color(255, 200, 80).fade(0.35))
        ap.lighting(false)
        for k in 0..<4 do
            sd(hoop, forward_of(170) * 58 + ap.Vec3(0, 4, 0), ap.Color(255, 160, 40).fade(0.6), ap.Vec3(90, 0, t * 0.4 + double(k) * 45), ap.Vec3(32, 32, 32))
        end
        sd(disc, ap.Vec3(0, -30, 0), ap.Color(255, 230, 160), ap.Vec3(0, 0, 0), ap.Vec3(140, 0.1, 140))
        ap.lighting(true)
        column(ap.Vec3(0, -12, 0), ARENA + 1.1, 11.3, ap.Color(220, 180, 110))
        for k in 0..<6 do
            var at = forward_of(double(k) * 60 + t * 0.2) * 15 + ap.Vec3(0, 3 + math.sin(t * 0.04 + double(k)) * 1.2, 0)
            sd(hoop, at, ap.Color(255, 210, 90), ap.Vec3(t * 0.5 + double(k) * 30, t * 0.3, 0), ap.Vec3(1.6, 1.6, 1.6))
        end
    else if scene == roster.SCENE_CANYON do
        ground_plane(ap.Color(170, 90, 55))
        for i in 0..<18 do
            var a = double(i) * 20 + h01(i, 47) * 10
            var at = forward_of(a) * (32 + h01(i, 48) * 34)
            var w = 8 + h01(i, 49) * 10
            var h = 10 + h01(i, 50) * 22
            sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(w, h, w * 0.8), ap.Color(180, 90, 60), a)
            sb(at + ap.Vec3(0, h * 0.3, 0), ap.Vec3(w * 1.05, 1.2, w * 0.85), ap.Color(150, 70, 50), a)
            sb(at + ap.Vec3(0, h + 0.4, 0), ap.Vec3(w * 0.9, 0.8, w * 0.7), ap.Color(200, 130, 80), a)
        end
        for i in 0..<10 do
            var at = forward_of(h01(i, 51) * 360) * (16 + h01(i, 52) * 12)
            sb(at + ap.Vec3(0, 3, 0), ap.Vec3(1.2, 6 + h01(i, 53) * 4, 1.2), ap.Color(160, 80, 50), h01(i, 54) * 90, 4)
        end
        for k in 0..<4 do
            var a = t * 0.35 + double(k) * 90
            var at = forward_of(a) * (18 + double(k) * 3) + ap.Vec3(0, 16 + double(k) * 2, 0)
            var flap = math.sin(t * 0.3 + double(k)) * 25
            sb(at, ap.Vec3(0.3, 0.25, 1.0), ap.Color(70, 50, 40), a + 90)
            sd(box, at, ap.Color(60, 44, 36), ap.Vec3(0, a + 90, flap), ap.Vec3(2.6, 0.06, 0.5))
        end
    else if scene == roster.SCENE_BOX do
        # Inside a cardboard box the size of a house, with the toys.
        ground_plane(ap.Color(168, 126, 82))
        var card = ap.Color(196, 150, 96)
        for k in 0..<4 do
            var a = double(k) * 90
            var at = forward_of(a) * 24
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(48, 18, 1), card, a)
            sb(at + forward_of(a) * 2.4 + ap.Vec3(0, 19.4, 0), ap.Vec3(48, 0.6, 6), card.brightness(0.85), a, -35)
            sb(at - forward_of(a) * 0.55 + ap.Vec3(0, 9, 0), ap.Vec3(1.6, 18, 0.05), ap.Color(214, 196, 150), a)
            sb(at - forward_of(a) * 0.56 + ap.Vec3(0, 6, 0), ap.Vec3(6, 0.15, 0.04), ap.Color(70, 50, 34), a)
        end
        var yarns = [ap.Color(220, 60, 70), ap.Color(70, 110, 220), ap.Color(90, 190, 90), ap.Color(240, 200, 60), ap.Color(200, 90, 200)]
        for i in 0..<5 do
            var a = h01(i, 60) * 360
            var at = forward_of(a) * (14 + h01(i, 61) * 6)
            var big = 2.4 + h01(i, 62) * 2
            sd(ball, at + ap.Vec3(0, big / 2, 0), yarns[i], ap.Vec3(t * 0.1, double(i) * 40, 0), ap.Vec3(big, big, big))
            sb(at + forward_of(a + 30) * (big / 2 + 2) + ap.Vec3(0, 0.05, 0), ap.Vec3(0.08, 0.08, 4), yarns[i], a + 30)
        end
        var mouse = forward_of(200) * 16
        sd(ball, mouse + ap.Vec3(0, 0.8, 0), ap.Color(150, 150, 160), ap.Vec3(0, 200, 0), ap.Vec3(2.4, 1.6, 3.2))
        sd(ball, mouse + ap.Vec3(0.8, 1.6, -0.8), ap.Color(230, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(0.8, 0.8, 0.2))
        sd(ball, mouse + ap.Vec3(-0.8, 1.6, -0.8), ap.Color(230, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(0.8, 0.8, 0.2))
        sb(mouse + forward_of(200) * -2.4 + ap.Vec3(0, 0.1, 0), ap.Vec3(0.12, 0.12, 2.4), ap.Color(230, 160, 170), 200)
        for k in 0..<3 do
            var at = forward_of(double(k) * 120 + 70) * 18
            column(at, 0.8, 8, ap.Color(210, 190, 140))
            sb(at + ap.Vec3(0, 8.1, 0), ap.Vec3(3, 0.3, 3), ap.Color(170, 120, 160))
        end
    else if scene == roster.SCENE_COLOSSEUM do
        # Sand, and tier on tier of arches, every seat taken.
        ground_plane(ap.Color(206, 180, 130))
        var rock = ap.Color(200, 178, 140)
        for tier in 0..<3 do
            var r = 19.0 + double(tier) * 4
            var y0 = double(tier) * 6
            for i in 0..<28 do
                var a = double(i) * 360 / 28
                var at = forward_of(a) * r
                sb(at + ap.Vec3(0, y0 + 3, 0), ap.Vec3(1.1, 6, 1.6), rock.brightness(1 - 0.08 * double(tier)), a)
                sb(forward_of(a + 6.4) * r + ap.Vec3(0, y0 + 5.6, 0), ap.Vec3(3.4, 0.8, 1.6), rock.brightness(0.9), a + 90)
                if tier > 0 do
                    var shirt = h01(i + tier * 30, 64)
                    sb(forward_of(a + 6.4) * (r - 1.2) + ap.Vec3(0, y0 + 0.6, 0), ap.Vec3(2.6, 1.0, 0.5),
                        ap.Color(int(120 + 100 * shirt), int(80 + 60 * h01(i, 65)), int(70 + 80 * h01(i, 66))), a + 90)
                end
            end
        end
        for k in 0..<8 do
            var a = double(k) * 45 + 22
            sb(forward_of(a) * 18.8 + ap.Vec3(0, 3.5, 0), ap.Vec3(1.4, 4, 0.06), m.glow, a)
        end
    else if scene == roster.SCENE_FOREST do
        # Black trees in a grey fog, and a white moon.
        ground_plane(ap.Color(34, 34, 36))
        for i in 0..<70 do
            var a = h01(i, 70) * 360
            var at = forward_of(a) * (12.5 + h01(i, 71) * 34)
            var tall = 10 + h01(i, 72) * 14
            var thick = 0.4 + h01(i, 73) * 0.5
            var lean = (h01(i, 74) - 0.5) * 8
            var bark = ap.Color(58, 58, 62).brightness(0.8 + 0.4 * h01(i, 75))
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(thick, tall, thick), bark, a, lean)
            sb(at + ap.Vec3(0, tall * 0.62, 0), ap.Vec3(3.2, 0.18, 0.18), bark, a + 50, 30)
            sb(at + ap.Vec3(0, tall * 0.8, 0), ap.Vec3(2.4, 0.14, 0.14), bark, a - 40, -24)
        end
        for i in 0..<26 do
            var at = forward_of(h01(i, 76) * 360) * (12 + h01(i, 77) * 14)
            sd(disc, at + ap.Vec3(0, 0.01, 0), ap.Color(44, 44, 46), ap.Vec3(0, 0, 0), ap.Vec3(0.5 + h01(i, 78), 0.02, 0.4 + h01(i, 79)))
        end
        glow_ball(forward_of(160) * 64 + ap.Vec3(0, 30, 0), 9, ap.Color(230, 230, 236))
        glow_ball(forward_of(160) * 64 + ap.Vec3(0, 30, 0), 13, ap.Color(230, 230, 236).fade(0.2))
    else if scene == roster.SCENE_QUARRY do
        # Torn-open ground in terraces, rocks hanging in the air, the heat showing through.
        ground_plane(ap.Color(84, 64, 48))
        for k in 0..<3 do
            for i in 0..<20 do
                var a = double(i) * 18 + double(k) * 6
                var at = forward_of(a) * (18 + double(k) * 6)
                var h = 4 + double(k) * 8
                sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(7, h, 5), ap.Color(110 - k * 12, 86 - k * 10, 66 - k * 8), a)
            end
        end
        for i in 0..<14 do
            var a = h01(i, 80) * 360 + t * (0.04 + h01(i, 81) * 0.06)
            var at = forward_of(a) * (14 + h01(i, 82) * 12) + ap.Vec3(0, 4 + h01(i, 83) * 10 + math.sin(t * 0.02 + double(i)) * 0.6, 0)
            var big = 1.5 + h01(i, 84) * 2.5
            sd(box, at, ap.Color(104, 82, 64), ap.Vec3(t * 0.3 + double(i) * 20, t * 0.2, double(i) * 7), ap.Vec3(big, big * 0.8, big * 1.1))
        end
        for i in 0..<12 do
            var at = forward_of(h01(i, 85) * 360) * (12 + h01(i, 86) * 10)
            glow_box(at + ap.Vec3(0, 0.0, 0), ap.Vec3(0.25, 0.04, 3 + h01(i, 87) * 3),
                ap.Color(255, 120, 40).fade(0.6 + 0.3 * math.sin(t * 0.05 + double(i))), h01(i, 88) * 180)
        end
    else if scene == roster.SCENE_BANK do
        # A trading floor in marble and gold, the boards ticking over.
        ground_plane(ap.Color(130, 120, 106))
        for i in 0..<14 do
            var a = double(i) * 360 / 14
            var at = forward_of(a) * 17
            column(at, 0.8, 14, ap.Color(232, 228, 218))
            sb(at + ap.Vec3(0, 14.1, 0), ap.Vec3(2.2, 0.4, 2.2), ap.Color(240, 236, 226))
            sb(at + ap.Vec3(0, 0.2, 0), ap.Vec3(2.2, 0.4, 2.2), ap.Color(210, 200, 186))
        end
        sb(ap.Vec3(0, 14.6, 0), ap.Vec3(40, 0.6, 40), ap.Color(60, 44, 30))
        for k in 0..<4 do
            var a = double(k) * 90 + 45
            var at = forward_of(a) * 21
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(10, 3.4, 0.3), ap.Color(20, 20, 24), a)
            for r in 0..<3 do
                var up = h01(r + k * 3 + ticks // 40, 89) > 0.45
                glow_box(at - forward_of(a) * 0.2 + ap.Vec3(0, 8 + double(r) * 0.9, 0),
                    ap.Vec3(9 * (0.3 + 0.7 * h01(r + k * 5 + ticks // 40, 90)), 0.4, 0.05),
                    ap.Color(110, 230, 110) if up else ap.Color(240, 80, 70), a)
            end
        end
        for i in 0..<16 do
            var at = forward_of(h01(i, 91) * 360) * (12.5 + h01(i, 92) * 6)
            var h = 0.5 + h01(i, 93) * 1.5
            column(at, 0.6 + h * 0.4, h, ap.Color(232, 190, 60))
        end
        sd(disc, forward_of(180) * 23 + ap.Vec3(0, 5, 0), ap.Color(150, 150, 160), ap.Vec3(90, 0, 0), ap.Vec3(4.5, 0.6, 4.5))
    else if scene == roster.SCENE_MIRRORS do
        # Panels of glass at every angle, each with a little light caught in it.
        ground_plane(ap.Color(60, 70, 84))
        for i in 0..<40 do
            var a = h01(i, 94) * 360
            var at = forward_of(a) * (12.5 + h01(i, 95) * 18) + ap.Vec3(0, 3.1, 0)
            var yaw = a + 90 + (h01(i, 96) - 0.5) * 60
            sb(at, ap.Vec3(3.2, 6.2, 0.15), ap.Color(120, 130, 142), yaw)
            glow_box(at - forward_of(yaw) * 0.09, ap.Vec3(2.9, 5.9, 0.04),
                ap.Color(170, 220, 255).fade(0.22 + 0.12 * math.sin(t * 0.03 + double(i))), yaw)
            if h01(i + ticks // 20, 97) > 0.9 do
                glow_box(at - forward_of(yaw) * 0.12 + ap.Vec3(ap.random(-1, 1), ap.random(-2, 2), 0),
                    ap.Vec3(0.2, 0.2, 0.02), ap.WHITE, yaw)
            end
        end
    else if scene == roster.SCENE_LAB do
        # Tanks of green with something growing in each, and coils that spit.
        ground_plane(ap.Color(54, 62, 58))
        for i in 0..<10 do
            var a = double(i) * 36 + 10
            var at = forward_of(a) * 15
            column(at, 1.3, 0.4, ap.Color(90, 96, 100))
            column(at + ap.Vec3(0, 4.8, 0), 1.3, 0.4, ap.Color(90, 96, 100))
            sb(at + ap.Vec3(0, 2.6, 0), ap.Vec3(0.5, 1.6, 0.3), ap.Color(20, 40, 24), a + 180)
            ap.lighting(false)
            sd(disc, at + ap.Vec3(0, 2.6, 0), ap.Color(90, 255, 120).fade(0.3), ap.Vec3(0, 0, 0), ap.Vec3(1.1, 4.4, 1.1))
            ap.lighting(true)
        end
        for k in 0..<3 do
            var a = double(k) * 120 + 60
            var at = forward_of(a) * 22
            column(at, 0.6, 7, ap.Color(80, 80, 90))
            glow_ball(at + ap.Vec3(0, 7.5, 0), 1.2, ap.Color(180, 255, 200))
            if (ticks + k * 17) % 40 < 4 do
                glow_box(at + ap.Vec3(0, 7.5, 0) - forward_of(a) * 2, ap.Vec3(0.08, 0.08, 4), ap.Color(220, 255, 230), a)
            end
        end
        for i in 0..<6 do
            var a = double(i) * 60 + 30
            var at = forward_of(a) * 18.5
            sb(at + ap.Vec3(0, 0.6, 0), ap.Vec3(2.4, 1.2, 1.2), ap.Color(70, 74, 80), a)
            glow_box(at - forward_of(a) * 0.62 + ap.Vec3(0, 1.0, 0), ap.Vec3(1.6, 0.5, 0.04), ap.Color(120, 255, 140).fade(0.7), a)
        end
    else if scene == roster.SCENE_PIT do
        # A pit of bones under hanging chains and hooks.
        ground_plane(ap.Color(56, 42, 34))
        for k in 0..<3 do
            var r = 15.0 + double(k) * 5
            for i in 0..<24 do
                var a = double(i) * 15 + double(k) * 7
                sb(forward_of(a) * r + ap.Vec3(0, 2 + double(k) * 3, 0), ap.Vec3(5, 4 + double(k) * 6, 3), ap.Color(76 - k * 8, 58 - k * 6, 46 - k * 5), a)
            end
        end
        for i in 0..<40 do
            var at = forward_of(h01(i, 110) * 360) * (12.5 + h01(i, 111) * 6)
            var bone = ap.Color(214, 204, 176)
            sb(at + ap.Vec3(0, 0.1, 0), ap.Vec3(0.12, 0.12, 0.9), bone, h01(i, 112) * 180)
            if i % 5 == 0 do
                sd(ball, at + ap.Vec3(0.3, 0.2, 0), bone, ap.Vec3(0, h01(i, 113) * 360, 0), ap.Vec3(0.4, 0.36, 0.44))
            end
        end
        for i in 0..<12 do
            var a = double(i) * 30 + 10
            var at = forward_of(a) * (13 + h01(i, 114) * 4)
            var long = 6 + h01(i, 115) * 6
            var sway = math.sin(t * 0.02 + double(i)) * 4
            sb(at + ap.Vec3(0, 20 - long / 2, 0), ap.Vec3(0.12, long, 0.12), ap.Color(90, 88, 86), a, sway)
            sb(at + ap.Vec3(0, 20 - long, 0), ap.Vec3(0.1, 0.5, 0.35), ap.Color(110, 108, 104), a, sway)
        end
        for i in 0..<6 do
            var at = forward_of(double(i) * 60 + 20) * 16
            glow_ball(at + ap.Vec3(0, 0.4, 0), 0.6, m.glow.fade(0.5 + 0.3 * math.sin(t * 0.06 + double(i))))
        end
    else if scene == roster.SCENE_GROVE do
        # Tall spruces, snow on the ground, paper lanterns and a still pond.
        ground_plane(ap.Color(200, 214, 210))
        for i in 0..<60 do
            var a = h01(i, 120) * 360
            var at = forward_of(a) * (13 + h01(i, 121) * 30)
            var tall = 8 + h01(i, 122) * 10
            column(at, 0.3, tall * 0.3, ap.Color(80, 56, 40))
            for k in 0..<3 do
                var w = (1.0 - double(k) * 0.25) * tall * 0.28
                sd(rig.cone, at + ap.Vec3(0, tall * (0.3 + 0.22 * double(k)) + tall * 0.12, 0), ap.Color(40, 76 + k * 8, 52),
                    ap.Vec3(0, 0, 0), ap.Vec3(w, tall * 0.3, w))
            end
            sd(rig.cone, at + ap.Vec3(0, tall * 0.98, 0), ap.Color(236, 242, 240), ap.Vec3(0, 0, 0), ap.Vec3(tall * 0.07, tall * 0.08, tall * 0.07))
        end
        sd(disc, forward_of(150) * 18 + ap.Vec3(0, 0.02, 0), ap.Color(120, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(5, 0.04, 3.5))
        for k in 0..<8 do
            var at = forward_of(double(k) * 45 + 22) * 12.6
            sb(at + ap.Vec3(0, 0.9, 0), ap.Vec3(0.12, 1.8, 0.12), ap.Color(70, 50, 36))
            glow_box(at + ap.Vec3(0, 2.0, 0), ap.Vec3(0.4, 0.5, 0.4), ap.Color(255, 200, 120).fade(0.8 + 0.2 * math.sin(t * 0.05 + double(k))))
        end
    else if scene == roster.SCENE_STUDIO do
        # A wall of television sets, every one of them showing snow.
        ground_plane(ap.Color(30, 30, 36))
        for i in 0..<18 do
            var a = double(i) * 20
            var at = forward_of(a) * 20
            for r in 0..<4 do
                var y = 1 + double(r) * 1.9
                sb(at + ap.Vec3(0, y, 0), ap.Vec3(3.2, 1.7, 1.2), ap.Color(50, 50, 56), a)
                var noise = h01(i * 7 + r + ticks // 4, 98)
                var grey = int(90 + 140 * noise)
                var screen_color = ap.Color(grey, grey, grey)
                if h01(i + r * 18, 99) > 0.8 do
                    screen_color = m.glow.brightness(0.6 + 0.4 * noise)
                end
                glow_box(at - forward_of(a) * 0.62 + ap.Vec3(0, y, 0), ap.Vec3(2.6, 1.3, 0.05), screen_color, a)
            end
        end
        for k in 0..<3 do
            var a = double(k) * 120
            sb(forward_of(a) * 13 + ap.Vec3(0, 12, 0), ap.Vec3(26, 0.4, 0.4), ap.Color(60, 60, 64), a + 90)
            glow_box(forward_of(a) * 13 + ap.Vec3(0, 11.6, 0), ap.Vec3(0.6, 0.4, 0.6), ap.Color(255, 250, 230))
        end
    else if scene == roster.SCENE_WARD do
        # Rows of curtained beds, a lamp over each, and bottles on every shelf.
        ground_plane(ap.Color(70, 72, 60))
        for i in 0..<20 do
            var a = double(i) * 18
            var at = forward_of(a) * 15
            sb(at + ap.Vec3(0, 0.5, 0), ap.Vec3(1.2, 0.3, 2.2), ap.Color(200, 196, 180), a)
            sb(at + ap.Vec3(0, 0.25, 0), ap.Vec3(1.1, 0.5, 2.1), ap.Color(90, 80, 60), a)
            sb(at + ap.Vec3(0, 0.7, 0) + forward_of(a) * 0.9, ap.Vec3(1.0, 0.1, 0.4), ap.Color(230, 228, 220), a)
            var sway = math.sin(t * 0.02 + double(i)) * 3
            sb(at + ap.Vec3(0, 1.7, 0) - forward_of(a) * 1.4, ap.Vec3(2.4, 2.6, 0.05), ap.Color(170, 180, 150).fade(0.9), a + 90, sway)
            glow_box(at + ap.Vec3(0, 3.4, 0), ap.Vec3(0.3, 0.2, 0.3), ap.Color(220, 240, 160).fade(0.7 + 0.2 * math.sin(t * 0.07 + double(i))))
        end
        for i in 0..<10 do
            var a = double(i) * 36 + 9
            var at = forward_of(a) * 21
            sb(at + ap.Vec3(0, 2.5, 0), ap.Vec3(4, 5, 0.6), ap.Color(80, 70, 56), a + 90)
            for k in 0..<8 do
                var c = [ap.Color(130, 200, 60), ap.Color(255, 110, 70), ap.Color(130, 170, 255)][k % 3]
                glow_box(at + ap.Vec3(0, 1.2 + double(k // 4) * 1.4, 0) + right_of(a) * (double(k % 4) * 0.8 - 1.2) - forward_of(a) * 0.35,
                    ap.Vec3(0.2, 0.4, 0.2), c.fade(0.8))
            end
        end
    else if scene == roster.SCENE_CIRCUS do
        # A torn big top, striped poles, and a crowd of grinning cut-outs.
        ground_plane(ap.Color(60, 30, 40))
        for i in 0..<16 do
            var a = double(i) * 22.5
            var at = forward_of(a) * 14
            sb(at + ap.Vec3(0, 6, 0), ap.Vec3(0.35, 12, 0.35), ap.Color(230, 230, 230) if i % 2 == 0 else ap.Color(200, 40, 60))
            sb(forward_of(a + 11) * 12 + ap.Vec3(0, 11, 0), ap.Vec3(5.6, 0.1, 9), ap.Color(200, 40, 60) if i % 2 == 0 else ap.Color(240, 230, 200), a + 11, 35)
        end
        for i in 0..<60 do
            var a = h01(i, 140) * 360
            var at = forward_of(a) * (16 + h01(i, 141) * 6)
            var bob = math.sin(t * 0.1 + double(i)) * 0.15
            sb(at + ap.Vec3(0, 1.0 + bob, 0), ap.Vec3(0.6, 1.4, 0.1), ap.Color(240, 230, 220), a + 90)
            glow_box(at + ap.Vec3(0, 1.4 + bob, 0) - forward_of(a) * 0.06, ap.Vec3(0.4, 0.08, 0.02), ap.Color(255, 60, 120), a + 90)
        end
        for k in 0..<12 do
            var a = double(k) * 30 + t * 0.4
            glow_ball(forward_of(a) * 9 + ap.Vec3(0, 10.5, 0), 0.4, [ap.Color(255, 90, 160), ap.Color(255, 230, 120), ap.Color(120, 220, 255)][k % 3])
        end
    else if scene == roster.SCENE_GALLOWS do
        # Cell after cell in a ring, a gallows on its platform, and one high window.
        ground_plane(ap.Color(40, 40, 44))
        for i in 0..<14 do
            var a = double(i) * (360.0 / 14)
            var at = forward_of(a) * 16
            sb(at + ap.Vec3(0, 2, 0), ap.Vec3(4.2, 4, 0.3), ap.Color(70, 70, 74), a + 90)
            for k in 0..<8 do
                sb(at + right_of(a) * (double(k) * 0.5 - 1.75) - forward_of(a) * 2.2 + ap.Vec3(0, 1.6, 0), ap.Vec3(0.07, 3.2, 0.07), ap.Color(50, 50, 56))
            end
            sb(at - forward_of(a) * 1.1 + right_of(a) * 2.1 + ap.Vec3(0, 2, 0), ap.Vec3(0.3, 4, 2.2), ap.Color(70, 70, 74), a + 90)
        end
        var g = forward_of(200) * 24
        sb(g + ap.Vec3(0, 1.5, 0), ap.Vec3(5, 3, 5), ap.Color(60, 44, 30))
        sb(g + ap.Vec3(-1.6, 5, 0), ap.Vec3(0.4, 7, 0.4), ap.Color(60, 44, 30))
        sb(g + ap.Vec3(0, 8.3, 0), ap.Vec3(3.6, 0.4, 0.4), ap.Color(60, 44, 30))
        sb(g + ap.Vec3(0.8, 7, 0), ap.Vec3(0.05, 2.4, 0.05), ap.Color(150, 130, 90), 0, math.sin(t * 0.03) * 6)
        glow_box(forward_of(20) * 30 + ap.Vec3(0, 14, 0), ap.Vec3(3, 4, 0.2), ap.Color(200, 210, 230), 20)
    else if scene == roster.SCENE_WORKSHOP do
        # Conveyor belts, presses going up and down, and half-built machines.
        ground_plane(ap.Color(50, 46, 40))
        for k in 0..<4 do
            var a = double(k) * 90 + 45
            var at = forward_of(a) * 14
            sb(at + ap.Vec3(0, 0.6, 0), ap.Vec3(14, 0.3, 2.2), ap.Color(60, 60, 64), a + 90)
            for i in 0..<6 do
                var along = ((double(i) * 2.4 + t * 0.05) % 14.0) - 7
                sb(at + right_of(a) * along + ap.Vec3(0, 1.0, 0), ap.Vec3(0.7, 0.5, 0.7), ap.Color(150, 120, 70), a)
            end
            var press = 2.5 + math.abs(math.sin(t * 0.04 + double(k))) * 2
            sb(at + ap.Vec3(0, press + 0.6, 0), ap.Vec3(1.6, 0.8, 1.6), ap.Color(110, 100, 90))
            sb(at + ap.Vec3(0, 6, 0), ap.Vec3(0.4, 6, 0.4), ap.Color(90, 86, 80))
        end
        for i in 0..<24 do
            var a = h01(i, 150) * 360
            var at = forward_of(a) * (20 + h01(i, 151) * 10)
            sb(at + ap.Vec3(0, 3, 0), ap.Vec3(2.2, 6, 2.2), ap.Color(70, 64, 58), a)
            glow_box(at + ap.Vec3(0, 4.5, 0) - forward_of(a) * 1.12, ap.Vec3(0.6, 0.3, 0.05), ap.Color(255, 170, 50).fade(0.6 + 0.3 * math.sin(t * 0.2 + double(i))), a)
        end
    else if scene == roster.SCENE_FATE do
        # A tent of stars: draped silk overhead, a crystal ball, and the major arcana standing round.
        ground_plane(ap.Color(30, 20, 46))
        for i in 0..<22 do
            var a = double(i) * (360.0 / 22)
            var at = forward_of(a) * 14
            sb(at + ap.Vec3(0, 1.8, 0), ap.Vec3(1.4, 2.4, 0.05), ap.Color(230, 220, 200), a + 90)
            glow_box(at + ap.Vec3(0, 1.8, 0) - forward_of(a) * 0.04, ap.Vec3(1.1, 2.0, 0.02), ap.Color(110, 70, 160), a + 90)
            glow_box(at + ap.Vec3(0, 2.4, 0) - forward_of(a) * 0.06, ap.Vec3(0.3, 0.3, 0.02), ap.Color(255, 230, 160), a + 90)
        end
        for i in 0..<16 do
            var a = double(i) * 22.5
            sb(forward_of(a) * 10 + ap.Vec3(0, 12, 0), ap.Vec3(4, 0.08, 14), ap.Color(60, 30, 90), a, 50)
        end
        for i in 0..<120 do
            var at = forward_of(h01(i, 160) * 360) * (20 + h01(i, 161) * 30) + ap.Vec3(0, 4 + h01(i, 162) * 30, 0)
            glow_box(at, ap.Vec3(0.15, 0.15, 0.15), ap.Color(255, 250, 220).fade(0.5 + 0.5 * math.sin(t * 0.05 + double(i))))
        end
        glow_ball(forward_of(180) * 18 + ap.Vec3(0, 1.4, 0), 1.6, ap.Color(190, 140, 255).fade(0.7))
    else if scene == roster.SCENE_CEMETERY do
        # Headstones in crooked rows, iron railings, and a chapel in the fog.
        ground_plane(ap.Color(34, 40, 36))
        for i in 0..<90 do
            var a = h01(i, 170) * 360
            var at = forward_of(a) * (12.5 + h01(i, 171) * 22)
            var tall = 0.8 + h01(i, 172) * 0.8
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(0.6, tall, 0.16), ap.Color(110, 112, 116), a + 90, (h01(i, 173) - 0.5) * 18)
            if i % 7 == 0 do
                sb(at + ap.Vec3(0, tall + 0.3, 0), ap.Vec3(0.12, 0.7, 0.12), ap.Color(110, 112, 116))
                sb(at + ap.Vec3(0, tall + 0.45, 0), ap.Vec3(0.5, 0.12, 0.12), ap.Color(110, 112, 116), a + 90)
            end
        end
        for i in 0..<48 do
            var a = double(i) * 7.5
            sb(forward_of(a) * 12 + ap.Vec3(0, 0.6, 0), ap.Vec3(0.05, 1.2, 0.05), ap.Color(30, 30, 34))
        end
        var c = forward_of(160) * 34
        sb(c + ap.Vec3(0, 4, 0), ap.Vec3(8, 8, 12), ap.Color(60, 62, 66))
        sb(c + ap.Vec3(0, 12, 4), ap.Vec3(2, 8, 2), ap.Color(60, 62, 66))
        glow_box(c + ap.Vec3(0, 4, -6.05) + ap.Vec3(0, 0, 0), ap.Vec3(1.2, 2.4, 0.1), ap.Color(255, 220, 150).fade(0.6))
    else if scene == roster.SCENE_WILDWOOD do
        # Trunk after trunk into the gloom.
        ground_plane(ap.Color(34, 42, 26))
        for i in 0..<120 do
            var a = h01(i, 180) * 360
            var at = forward_of(a) * (11.5 + h01(i, 181) * 30)
            var tall = 9 + h01(i, 182) * 9
            column(at, 0.4 + h01(i, 183) * 0.3, tall * 0.7, ap.Color(60, 46, 34))
            sd(rig.cone, at + ap.Vec3(0, tall * 0.75, 0), ap.Color(34, 58, 34), ap.Vec3(0, 0, 0), ap.Vec3(tall * 0.35, tall * 0.5, tall * 0.35))
        end
        for i in 0..<40 do
            var at = forward_of(h01(i, 184) * 360) * (11 + h01(i, 185) * 8)
            sb(at + ap.Vec3(0, 0.3, 0), ap.Vec3(1.2, 0.6, 1.0), ap.Color(40, 64, 34), h01(i, 186) * 180)
        end
    else if scene == roster.SCENE_TIDE do
        # Black water over everything, the masts of a wreck, and the moon.
        ground_plane(ap.Color(10, 20, 26))
        for i in 0..<4 do
            var at = forward_of(double(i) * 90 + 30) * (17 + double(i) * 2)
            sb(at + ap.Vec3(0, 6, 0), ap.Vec3(0.5, 12, 0.5), ap.Color(50, 40, 32), 0, 8 + double(i) * 3)
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(5, 0.3, 0.3), ap.Color(50, 40, 32), double(i) * 40, 6)
            sb(at + ap.Vec3(0, 7, 0), ap.Vec3(3.6, 3, 0.05), ap.Color(70, 70, 70).fade(0.8), double(i) * 40, 12)
        end
        var hull = forward_of(250) * 22
        sb(hull + ap.Vec3(0, 1.2, 0), ap.Vec3(12, 3, 4), ap.Color(46, 36, 30), 250, -14)
        glow_ball(forward_of(30) * 60 + ap.Vec3(0, 30, 0), 10, ap.Color(200, 230, 240))
        ap.lighting(false)
        ap.cull(false)
        var swell = math.sin(t * 0.03) * 0.06
        ap.draw(box, ap.Vec3(0, 1.0 + swell, 0), ap.Color(20, 60, 80).fade(0.4), ap.Vec3(0, 0, 0), ap.Vec3(200, 0.02, 200))
        for i in 0..<30 do
            var at = forward_of(h01(i, 190) * 360) * (h01(i, 191) * ARENA) + ap.Vec3(0, 1.02 + swell, 0)
            ap.draw(box, at, ap.Color(120, 200, 220).fade(0.25 + 0.2 * math.sin(t * 0.1 + double(i))), ap.Vec3(0, h01(i, 192) * 180, 0), ap.Vec3(1.4, 0.01, 0.08))
        end
        ap.cull(true)
        ap.lighting(true)
    else if scene == roster.SCENE_ALCHEMY do
        # Alembics bubbling, shelves of flasks, and a great furnace of gold.
        ground_plane(ap.Color(50, 40, 44))
        for i in 0..<12 do
            var a = double(i) * 30
            var at = forward_of(a) * 15
            sb(at + ap.Vec3(0, 0.6, 0), ap.Vec3(2.4, 1.2, 1.0), ap.Color(90, 64, 44), a + 90)
            for k in 0..<3 do
                var c = [ap.Color(130, 230, 60), ap.Color(255, 120, 40), ap.Color(140, 210, 255), ap.Color(255, 230, 80)][(i + k) % 4]
                glow_ball(at + ap.Vec3(0, 1.5, 0) + right_of(a) * (double(k) * 0.7 - 0.7), 0.45 + 0.05 * math.sin(t * 0.2 + double(i + k)), c.fade(0.8))
            end
        end
        var furnace = forward_of(190) * 22
        sb(furnace + ap.Vec3(0, 4, 0), ap.Vec3(6, 8, 6), ap.Color(70, 56, 50))
        glow_box(furnace + ap.Vec3(0, 2.5, 0) + forward_of(10) * 3.05, ap.Vec3(2.4, 2, 0.1), ap.Color(255, 200, 60).fade(0.7 + 0.2 * math.sin(t * 0.1)))
        for i in 0..<8 do
            var a = double(i) * 45 + 20
            sb(forward_of(a) * 24 + ap.Vec3(0, 5, 0), ap.Vec3(5, 10, 1), ap.Color(60, 44, 40), a + 90)
        end
    else if scene == roster.SCENE_CORN do
        # Corn higher than a man as far as there is to see, and the farmhouse.
        ground_plane(ap.Color(70, 54, 30))
        for i in 0..<220 do
            var a = h01(i, 200) * 360
            var at = forward_of(a) * (10.8 + h01(i, 201) * 24)
            var tall = 2.4 + h01(i, 202) * 0.8
            var sway = math.sin(t * 0.04 + double(i) * 0.7) * 5
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(0.08, tall, 0.08), ap.Color(150, 130, 60), 0, sway)
            sb(at + ap.Vec3(0, tall * 0.7, 0), ap.Vec3(0.9, 0.05, 0.16), ap.Color(130, 120, 50), a, sway + 20)
            if i % 3 == 0 do
                sb(at + ap.Vec3(0.05, tall * 0.55, 0), ap.Vec3(0.12, 0.35, 0.12), ap.Color(230, 190, 70), 0, sway)
            end
        end
        var house = forward_of(140) * 40
        sb(house + ap.Vec3(0, 3, 0), ap.Vec3(8, 6, 6), ap.Color(90, 60, 40))
        sb(house + ap.Vec3(0, 7, 0), ap.Vec3(8.6, 2, 6.6), ap.Color(60, 30, 26), 0, 0)
        glow_box(house + ap.Vec3(1.5, 3, -3.05), ap.Vec3(1, 1, 0.1), ap.Color(255, 200, 100).fade(0.8))
    else if scene == roster.SCENE_TRAIN do
        # Outside the carriage: only the night here. Everything out there runs past the windows,
        # so it is drawn with the carriage (see draw_carriage).
        ground_plane(ap.Color(20, 18, 26))
    else if scene == roster.SCENE_SIDESHOW do
        # A strongman's stage: velvet curtains, weights on racks, and a bell-and-hammer.
        ground_plane(ap.Color(80, 30, 26))
        for i in 0..<14 do
            var a = double(i) * (360.0 / 14)
            sb(forward_of(a) * 15 + ap.Vec3(0, 5, 0), ap.Vec3(7, 10, 0.3), ap.Color(150, 20, 30) if i % 2 == 0 else ap.Color(120, 16, 24), a + 90)
            glow_box(forward_of(a) * 14.6 + ap.Vec3(0, 9.6, 0), ap.Vec3(6.6, 0.2, 0.1), ap.Color(255, 210, 90), a + 90)
        end
        for k in 0..<6 do
            var a = double(k) * 60 + 30
            var at = forward_of(a) * 12.4
            sb(at + ap.Vec3(0, 0.8, 0), ap.Vec3(2, 0.1, 0.4), ap.Color(90, 90, 96), a + 90)
            for side in [-1.0, 1.0] do
                sd(ball, at + right_of(a) * (0.9 * side) + ap.Vec3(0, 0.8, 0), ap.Color(40, 40, 44), ap.Vec3(0, 0, 0), ap.Vec3(0.6, 0.6, 0.6))
            end
        end
        var bell = forward_of(200) * 13.5
        sb(bell + ap.Vec3(0, 4, 0), ap.Vec3(0.4, 8, 0.4), ap.Color(230, 220, 200))
        for k in 0..<8 do
            glow_box(bell + ap.Vec3(0, 0.8 + double(k) * 0.9, 0.25), ap.Vec3(0.3, 0.6, 0.05),
                ap.Color(255, 220, 80) if k <= int(4 + 4 * math.sin(t * 0.05)) else ap.Color(80, 60, 40))
        end
        glow_ball(bell + ap.Vec3(0, 8.4, 0), 0.8, ap.Color(255, 220, 80))
    else if scene == roster.SCENE_CLOCK do
        # Inside the tower: wheels as big as houses, turning, and the dial seen from behind.
        ground_plane(ap.Color(50, 44, 36))
        for k in 0..<8 do
            var a = double(k) * 45 + 10
            var at = forward_of(a) * (15 + double(k % 3) * 4) + ap.Vec3(0, 4 + double(k % 2) * 3, 0)
            var r = 2.5 + double(k % 3)
            var spin = t * (0.5 if k % 2 == 0 else -0.7) / r
            for i in 0..<16 do
                var b = double(i) * 22.5 + spin * 60
                var arm = ap.Vec3(math.cos(b * math.PI / 180) * r, math.sin(b * math.PI / 180) * r, 0)
                var turned = right_of(a + 90) * arm.x + ap.Vec3(0, arm.y, 0)
                sb(at + turned, ap.Vec3(0.4, 0.4, 0.3), ap.Color(200, 170, 90), a + 90)
            end
            sb(at, ap.Vec3(0.6, 0.6, 0.8), ap.Color(160, 130, 70), a + 90)
        end
        var dial = forward_of(180) * 26 + ap.Vec3(0, 14, 0)
        glow_ball(dial, 14, ap.Color(220, 220, 200).fade(0.35))
        for i in 0..<12 do
            var b = double(i) * 30 * math.PI / 180
            sb(dial + ap.Vec3(math.sin(b) * 6, math.cos(b) * 6, 0), ap.Vec3(0.6, 1.4, 0.2), ap.Color(40, 36, 30), 0, double(i) * 30)
        end
        for i in 0..<10 do
            var a = double(i) * 36
            var swing = math.sin(t * 0.05 + double(i)) * 10
            sb(forward_of(a) * 12 + ap.Vec3(0, 9, 0), ap.Vec3(0.1, 6, 0.1), ap.Color(150, 130, 80), a, swing)
        end
    else if scene == roster.SCENE_SUNLIT do
        # A field of lamps, every one of them lit, under a sun too bright to look at.
        ground_plane(ap.Color(220, 200, 150))
        for i in 0..<80 do
            var at = forward_of(h01(i, 220) * 360) * (12 + h01(i, 221) * 28)
            sb(at + ap.Vec3(0, 1.2, 0), ap.Vec3(0.1, 2.4, 0.1), ap.Color(90, 80, 60))
            glow_box(at + ap.Vec3(0, 2.6, 0), ap.Vec3(0.4, 0.5, 0.4), ap.Color(255, 240, 180))
        end
        glow_ball(ap.Vec3(0, 40, 0), 16, ap.Color(255, 250, 230))
        glow_ball(ap.Vec3(0, 40, 0), 24, ap.Color(255, 240, 200).fade(0.3))
    else if scene == roster.SCENE_FORTRESS do
        # The walls of the last keep, close in, with banners and arrow slits.
        ground_plane(ap.Color(60, 60, 68))
        for i in 0..<16 do
            var a = double(i) * 22.5
            var at = forward_of(a) * 13.5
            sb(at + ap.Vec3(0, 3.5, 0), ap.Vec3(5.6, 7, 1.4), ap.Color(110, 112, 120), a + 90)
            sb(at + ap.Vec3(0, 7.4, 0) + right_of(a) * 1.8, ap.Vec3(1, 0.8, 1.4), ap.Color(110, 112, 120), a + 90)
            sb(at + ap.Vec3(0, 7.4, 0) - right_of(a) * 1.8, ap.Vec3(1, 0.8, 1.4), ap.Color(110, 112, 120), a + 90)
            sb(at - forward_of(a) * 0.72 + ap.Vec3(0, 4.5, 0), ap.Vec3(1.4, 3, 0.05), ap.Color(90, 30, 30) if i % 2 == 0 else ap.Color(40, 50, 90), a + 90)
            glow_box(at - forward_of(a) * 0.71 + ap.Vec3(0, 2.2, 0) + right_of(a) * 2, ap.Vec3(0.15, 0.8, 0.02), ap.Color(150, 220, 255).fade(0.6), a + 90)
        end
        for i in 0..<12 do
            var a = double(i) * 30 + 15
            glow_box(forward_of(a) * 12.5 + ap.Vec3(0, 3, 0), ap.Vec3(0.25, 0.4, 0.25), ap.Color(255, 180, 90).fade(0.7 + 0.2 * math.sin(t * 0.1 + double(i))))
        end
    else if scene == roster.SCENE_CONCERT do
        # Red velvet seats rising away, gilded boxes, a chandelier, and every seat empty.
        ground_plane(ap.Color(60, 20, 20))
        for r in 0..<8 do
            var d = 13 + double(r) * 1.6
            for i in 0..<36 do
                var a = double(i) * 10
                if a > 140 and a < 220 do
                    continue
                end
                sb(forward_of(a) * d + ap.Vec3(0, 0.4 + double(r) * 0.6, 0), ap.Vec3(1.2, 0.9, 0.6), ap.Color(150, 20, 30), a)
            end
        end
        for i in 0..<12 do
            var a = double(i) * 30
            sb(forward_of(a) * 27 + ap.Vec3(0, 9, 0), ap.Vec3(5, 3, 2), ap.Color(200, 160, 70), a + 90)
        end
        var stage = forward_of(180) * 16
        sb(stage + ap.Vec3(0, 0.5, 0), ap.Vec3(12, 1, 6), ap.Color(80, 50, 30))
        sb(stage + ap.Vec3(0, 6, -3), ap.Vec3(14, 12, 0.3), ap.Color(130, 16, 24))
        glow_ball(ap.Vec3(0, 14, 0), 2.4, ap.Color(255, 230, 170))
        for k in 0..<12 do
            glow_ball(forward_of(double(k) * 30 + t * 0.2) * 2.6 + ap.Vec3(0, 13.2, 0), 0.4, ap.Color(255, 240, 200))
        end
    else if scene == roster.SCENE_DOOR do
        # Nothing at all, and floating stone stairs leading to doors that are all shut.
        ground_plane(ap.Color(14, 12, 18))
        for i in 0..<14 do
            var a = h01(i, 230) * 360
            var at = forward_of(a) * (18 + h01(i, 231) * 20) + ap.Vec3(0, h01(i, 232) * 12, 0)
            for k in 0..<5 do
                sb(at + forward_of(a + 90) * (double(k) * 0.8) + ap.Vec3(0, double(k) * 0.4, 0), ap.Vec3(1.6, 0.3, 0.8), ap.Color(50, 46, 56), a)
            end
            var top = at + forward_of(a + 90) * 4 + ap.Vec3(0, 2.6, 0)
            sb(top, ap.Vec3(1.4, 2.6, 0.2), ap.Color(60, 40, 30), a)
            glow_box(top + ap.Vec3(0, -1.2, 0), ap.Vec3(1.2, 0.04, 0.22), ap.Color(230, 200, 110).fade(0.5), a)
        end
    else if scene == roster.SCENE_ROOST do
        # One dead tree, enormous, its branches black with ravens, and a storm behind.
        ground_plane(ap.Color(30, 28, 34))
        var tree = forward_of(170) * 20
        column(tree, 2, 18, ap.Color(30, 26, 26))
        for k in 0..<9 do
            var a = double(k) * 40
            var y = 8 + double(k % 3) * 3.5
            sb(tree + forward_of(a) * 4 + ap.Vec3(0, y, 0), ap.Vec3(0.6, 0.6, 9), ap.Color(30, 26, 26), a, -25)
            for j in 0..<5 do
                var bird = tree + forward_of(a) * (2 + double(j) * 1.4) + ap.Vec3(0, y + 0.5 + double(j) * 0.6, 0)
                sb(bird, ap.Vec3(0.3, 0.4, 0.5), ap.Color(16, 16, 20), a + math.sin(t * 0.05 + double(j + k)) * 20)
            end
        end
        for i in 0..<60 do
            var a = h01(i, 240) * 360 + t * (0.3 + h01(i, 241) * 0.4)
            var at = forward_of(a) * (14 + h01(i, 242) * 10) + ap.Vec3(0, 10 + h01(i, 243) * 8, 0)
            var flap = math.abs(math.sin(t * 0.3 + double(i))) * 0.4
            sb(at, ap.Vec3(0.8 + flap, 0.06, 0.3), ap.Color(16, 16, 20), a + 90)
        end
        for i in 0..<30 do
            var at = forward_of(h01(i, 244) * 360) * (16 + h01(i, 245) * 20)
            sb(at + ap.Vec3(0, 0.2, 0), ap.Vec3(0.9, 0.4, 0.6), ap.Color(40, 36, 40), h01(i, 246) * 180)
        end
    end
end

# The living part of a place: steam, smoke, sparks and rain.
function scene_life(int scene)
    if scene == roster.SCENE_REACTOR do
        if ap.chance(0.6) do
            var k = int(ap.random(0, 2.999))
            var top = forward_of(double(k) * 50 + 150) * 42 + ap.Vec3(ap.random(-3, 3), 27, ap.random(-3, 3))
            spark(top, ap.Vec3(ap.random(-0.5, 0.5), ap.random(2, 4), ap.random(-0.5, 0.5)), ap.Color(230, 225, 220), 3.0, 1.6, -0.2)
        end
    else if scene == roster.SCENE_TRENCHES do
        if ap.chance(0.4) do
            var at = forward_of(ap.random(0, 360)) * ap.random(18, 40)
            spark(at, ap.Vec3(0, ap.random(1, 2.5), 0), ap.Color(90, 86, 80), 3.0, 1.4, -0.1)
        end
    else if scene == roster.SCENE_FACTORY do
        if ap.chance(0.5) do
            var at = forward_of(ap.random(0, 360)) * ap.random(13, 18) + ap.Vec3(0, ap.random(1, 4), 0)
            for i in 0..<4 do
                spark(at, ap.Vec3(ap.random(-3, 3), ap.random(1, 4), ap.random(-3, 3)), ap.Color(255, 200, 80), 0.5, 0.06, 9)
            end
        end
    else if scene == roster.SCENE_ALLEY do
        for i in 0..<3 do
            var at = cam_focus + ap.Vec3(ap.random(-9, 9), 9, ap.random(-9, 9))
            streak(at, ap.Vec3(0, -18, 0), ap.Color(170, 190, 230), 0.5, 0.5, 0.025)
        end
    else if scene == roster.SCENE_SUN do
        if ap.chance(0.3) do
            spark(forward_of(ap.random(0, 360)) * ap.random(11, 14), ap.Vec3(0, ap.random(1, 3), 0), ap.Color(255, 230, 140), 1.2, 0.12, -0.5)
        end
    else if scene == roster.SCENE_GROVE do
        if ap.chance(0.6) do
            var at = cam_focus + ap.Vec3(ap.random(-12, 12), 9, ap.random(-12, 12))
            spark(at, ap.Vec3(ap.random(-0.3, 0.3), -1.2, ap.random(-0.3, 0.3)), ap.Color(250, 252, 255), 6.0, 0.06, 0)
        end
    else if scene == roster.SCENE_PIT do
        if ap.chance(0.2) do
            spark(forward_of(ap.random(0, 360)) * ap.random(12, 18), ap.Vec3(0, ap.random(0.5, 1), 0), ap.Color(150, 200, 90), 2.0, 0.08, -0.2)
        end
    else if scene == roster.SCENE_FOREST do
        if ap.chance(0.3) do
            var at = forward_of(ap.random(0, 360)) * ap.random(8, 20) + ap.Vec3(0, ap.random(4, 9), 0)
            spark(at, ap.Vec3(ap.random(-0.4, 0.4), -0.6, ap.random(-0.4, 0.4)), ap.Color(70, 70, 72), 4.0, 0.1, 0.1)
        end
    else if scene == roster.SCENE_LAB do
        if ap.chance(0.5) do
            var at = forward_of(double(int(ap.random(0, 9.99))) * 36 + 10) * 15 + ap.Vec3(ap.random(-0.5, 0.5), 0.6, ap.random(-0.5, 0.5))
            spark(at, ap.Vec3(0, ap.random(1, 2), 0), ap.Color(160, 255, 170), 1.8, 0.08, -0.2)
        end
    else if scene == roster.SCENE_QUARRY do
        if ap.chance(0.3) do
            spark(forward_of(ap.random(0, 360)) * ap.random(12, 22), ap.Vec3(0, ap.random(1, 2), 0), ap.Color(255, 140, 50), 1.2, 0.07, -0.3)
        end
    else if scene == roster.SCENE_WARD do
        if ap.chance(0.3) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), ap.random(0.5, 3), ap.random(-10, 10)), ap.Vec3(0, 0.2, 0), ap.Color(170, 210, 110), 3.0, 0.07, -0.05)
        end
    else if scene == roster.SCENE_CIRCUS do
        if ap.chance(0.5) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), 9, ap.random(-10, 10)), ap.Vec3(ap.random(-0.5, 0.5), -1.5, ap.random(-0.5, 0.5)),
                [ap.Color(255, 90, 160), ap.Color(255, 230, 120), ap.Color(120, 220, 255)][int(ap.random(0, 2.999))], 5.0, 0.06, 0.2)
        end
    else if scene == roster.SCENE_WORKSHOP do
        if ap.chance(0.4) do
            var at = forward_of(double(int(ap.random(0, 3.999))) * 90 + 45) * 14 + ap.Vec3(0, 1.2, 0)
            for i in 0..<3 do
                spark(at, ap.Vec3(ap.random(-3, 3), ap.random(1, 4), ap.random(-3, 3)), ap.Color(255, 200, 80), 0.5, 0.05, 9)
            end
        end
    else if scene == roster.SCENE_TIDE do
        if ap.chance(0.4) do
            spark(forward_of(ap.random(0, 360)) * ap.random(0, ARENA) + ap.Vec3(0, ap.random(0.1, 0.8), 0), ap.Vec3(0, ap.random(0.4, 0.9), 0),
                ap.Color(170, 220, 230), 1.2, 0.05, 0)
        end
    else if scene == roster.SCENE_ALCHEMY do
        if ap.chance(0.5) do
            var at = forward_of(double(int(ap.random(0, 11.99))) * 30) * 15 + ap.Vec3(ap.random(-0.6, 0.6), 1.8, ap.random(-0.6, 0.6))
            spark(at, ap.Vec3(0, ap.random(1, 2), 0), [ap.Color(130, 230, 60), ap.Color(255, 120, 40), ap.Color(140, 210, 255), ap.Color(255, 230, 80)][int(ap.random(0, 3.999))], 1.5, 0.08, -0.2)
        end
    else if scene == roster.SCENE_CORN do
        if ap.chance(0.4) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), ap.random(1, 4), ap.random(-10, 10)), ap.Vec3(ap.random(1, 2), -0.2, ap.random(-0.4, 0.4)),
                ap.Color(220, 190, 110), 3.0, 0.05, 0.05)
        end
    else if scene == roster.SCENE_SUNLIT do
        if ap.chance(0.5) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), ap.random(0.5, 5), ap.random(-10, 10)), ap.Vec3(0, 0.3, 0), ap.Color(255, 245, 210), 3.0, 0.06, -0.1)
        end
    else if scene == roster.SCENE_ROOST do
        for i in 0..<2 do
            var at = cam_focus + ap.Vec3(ap.random(-9, 9), 9, ap.random(-9, 9))
            streak(at, ap.Vec3(-2, -16, 0), ap.Color(150, 150, 180), 0.5, 0.5, 0.025)
        end
    else if scene == roster.SCENE_CEMETERY do
        if ap.chance(0.2) do
            spark(forward_of(ap.random(0, 360)) * ap.random(11, 20) + ap.Vec3(0, 0.3, 0), ap.Vec3(0, ap.random(0.3, 0.7), 0), ap.Color(140, 220, 200), 2.5, 0.07, -0.05)
        end
    end
end

function draw_maximum_hud()
    if max_cut > 0 do
        var t = double(cut_len - max_cut)
        if cut_kind == CUT_JAM do
            draw_jam_hud(t)
            return
        end
        var bars = 44 * math.min(math.min(t / 12, 1.0), double(max_cut) / 12)
        ap.rect(0, 0, VW, bars, ap.BLACK)
        ap.rect(0, VH - bars, VW, bars, ap.BLACK)
        var f = fighters[cut_user]
        # Once the close-ups are gone, the title stays up over the new place.
        var show = math.clamp((t - double(cut_hit)) / 10, 0.0, 1.0) * math.min(double(max_cut) / 20, 1.0)
        draw_super_shout(t)
        label_centered(cut_title, 320, 62, 32, MAX_GOLD.fade(show))
        var player = fighters[0]
        if can_merge(player) and not player.cpu do
            var pulse = 0.6 + 0.4 * math.sin(draw_clock() * 0.3)
            ap.rect(140, VH - 34, 360, 16, ap.BLACK.fade(0.85))
            label_centered("G  MERGE YOUR SUPER INTO THEIRS", 320, VH - 30, 8, MAX_GOLD.fade(pulse))
        else if merge_pending >= 0 do
            ap.rect(180, VH - 34, 280, 16, ap.BLACK.fade(0.85))
            label_centered("{fighters[merge_pending].kit.name} MERGES", 320, VH - 30, 8, fighters[merge_pending].kit.look.accent)
        end
        if cut_kind == CUT_MERGE do
            var o = other(f)
            var names = "{o.kit.name}  +  {f.kit.name}"
            var x = 320 - ap.measure(names, 8).x / 2
            label(o.kit.name, x, 100, 8, o.kit.look.accent.fade(show))
            label("+", x + ap.measure("{o.kit.name}  ", 8).x, 100, 8, ap.WHITE.fade(show))
            label(f.kit.name, x + ap.measure("{o.kit.name}  +  ", 8).x, 100, 8, f.kit.look.accent.fade(show))
            if t > double(cut_swap) do
                label_centered("{cut_def2.place} + {cut_def.place}", 320, 260, 16, cut_def.glow.lerp(cut_def2.glow, 0.5).fade(show))
            end
        else do
            label_centered("{f.kit.name}'S SUPER", 320, 100, 8, f.kit.look.accent.fade(show))
            if t > double(cut_swap) do
                label_centered(cut_def.place, 320, 260, 16, cut_def.glow.fade(show))
            end
        end
        var flash = math.max(1 - math.abs(t - double(cut_hit)) / 8, 0.0) * 0.7
        flash = math.max(flash, math.max(1 - math.abs(t - double(cut_swap)) / 16, 0.0))
        if flash > 0 do
            ap.rect(0, 0, VW, VH, ap.WHITE.fade(flash))
        end
        return
    end
    if max_owner >= 0 do
        # How long the places in force have left.
        var left = double(max_left) / (max_def.seconds * 60)
        var y = 55.0
        ap.rect(259, y, 122, 4, ap.BLACK.fade(0.7))
        ap.rect(260, y + 1, 120 * left, 2, max_def.glow)
        if merge_owner >= 0 do
            ap.rect(259, y + 5, 122, 4, ap.BLACK.fade(0.7))
            ap.rect(260, y + 6, 120 * double(merge_left) / (merge_def.seconds * 60), 2, merge_def.glow)
        end
    end
    if return_flash > 0 do
        ap.rect(0, 0, VW, VH, ap.WHITE.fade(double(return_flash) / 24))
    end
end

# --- The super's close-ups: the user's face on a panel, and the call in big letters --------------
# A super: the user's face fills a panel on their side of the screen (the player's on the left,
# the opponent's on the right), over their colors, with SUPER! and what it does on the other
# side. A merge: both faces, half the screen each, and SUPER MERGE! between them on a black card.
# They hold until the super goes off (cut_hit), while the screen trembles.

const int CLOSE_W = 120              # a close-up's canvas, drawn at twice the size
const int CLOSE_H = 180
const int SHOUT_AT = 8               # the tick the words land
# Made up front: making them when the first super goes off stalls that frame.
ap.Canvas[] closeups = [ap.Canvas(CLOSE_W, CLOSE_H), ap.Canvas(CLOSE_W, CLOSE_H)]

# How far a close-up panel is in: sliding in, holding, sliding out before the super goes off.
function shout_in(double t) returns double
    var end_at = double(cut_hit)
    if t >= end_at do
        return 0
    end
    var come = math.clamp(t / 9, 0.0, 1.0)
    var go = math.clamp((end_at - t) / 8, 0.0, 1.0)
    return puppet.smooth(math.min(come, go))
end

# Whether the close-ups are on screen, so render() knows to draw them.
function shouting() returns bool
    return screen == SCREEN_FIGHT and max_cut > 0 and cut_kind != CUT_JAM and cut_len - max_cut < cut_hit
end

# Renders fighter `f`'s face, close up and lit in their colors, into close-up `slot` (0 left,
# 1 right: each looks in toward the middle of the screen).
function render_closeup(int slot, Fighter f, double t)
    while closeups.length < 2 do
        closeups.push(ap.Canvas(CLOSE_W, CLOSE_H))
    end
    var look = f.kit.look
    var glow = f.kit.maximum.glow
    var head = 1.62 * look.tall
    var side = 1.0 if slot == 0 else -1.0
    ap.draw_to(closeups[slot])
    ap.clear(ap.TRANSPARENT)
    for k in 0..<8 do
        ap.light_off(k)
    end
    ap.light(0, ap.Vec3(side * 1.6, head + 0.9, 1.8), look.accent.lerp(ap.WHITE, 0.7), 7)
    ap.light(1, ap.Vec3(-side * 1.6, head + 0.3, -0.8), glow, 6)
    ap.light(2, ap.Vec3(0, head - 0.8, 1.6), look.accent, 4)
    # A slow push in on the face.
    var near = 1.6 - 0.22 * puppet.smooth(math.clamp(t / double(math.max(cut_hit, 1)), 0.0, 1.0))
    var eye = ap.Vec3(-side * 0.4, head + 0.08, near * math.max(look.bulk, 1.0))
    var cam = ap.Camera3D(eye, ap.Vec3(0, head - 0.2, 0))
    cam.fov = 32
    ap.begin_3d(cam)
    # Powering up: arms down and out, chin down, glaring out of the panel.
    var pose = puppet.Pose()
    var shiver = math.sin(t * 1.9) * 2
    pose.lean = 2
    pose.arm_r = 12 + shiver
    pose.arm_l = 12 - shiver
    pose.arm_r_out = 24
    pose.arm_l_out = 24
    pose.elbow_r = -30
    pose.elbow_l = -30
    pose.head = 6
    pose.cape = 22 + math.sin(t * 0.5) * 6
    pose.wing = 12
    puppet.draw(rig, look, pose, ap.Vec3(0, -look.hover, 0), side * 22, 1)
    ap.end_3d()
end

# Before the scene: the faces the HUD will show.
var closeups_warm = false            # drawn once on the title screen, so the first super does not stall
function render_closeups()
    if not closeups_warm and cast.length > 0 do
        closeups_warm = true
        var stand_in = new_fighter(0, 0)
        render_closeup(0, stand_in, 0)
        render_closeup(1, stand_in, 0)
    end
    if not shouting() do
        return
    end
    var t = double(cut_len - max_cut)
    if cut_kind == CUT_MERGE do
        render_closeup(0, fighters[0], t)
        render_closeup(1, fighters[1], t)
    else do
        render_closeup(cut_user, fighters[cut_user], t)
    end
end

# A panel `w` wide on side `slot` (0 left, 1 right), `appear` 0..1 of the way in: the fighter's
# colors bursting out from behind their face.
function draw_closeup_panel(int slot, Fighter f, double w, double appear, double t)
    var accent = f.kit.look.accent
    var glow = f.kit.maximum.glow
    var shift = (1 - appear) * (w + 30)
    var x = -shift if slot == 0 else VW - w + shift
    var jolt = ap.shake_offset()
    x += jolt.x
    ap.clip(ap.Rect(math.max(x, 0.0), 0, w, VH))
    ap.gradient(x, 0, w, VH, accent.brightness(0.85), glow.brightness(0.35))
    # Speed lines turning slowly round the face.
    var cx = x + w / 2
    var cy = VH * 0.42
    for i in 0..<24 do
        var a = (double(i) * 15 + t * 0.8) * math.PI / 180
        var b = a + 6.5 * math.PI / 180 * (0.6 + 0.4 * math.sin(double(i) * 1.7 + t * 0.2))
        var tint = accent.lerp(ap.WHITE, 0.45).fade(0.5) if i % 2 == 0 else glow.fade(0.45)
        ap.triangle(ap.Vec2(cx, cy), ap.Vec2(cx + math.cos(a) * 520, cy + math.sin(a) * 520),
            ap.Vec2(cx + math.cos(b) * 520, cy + math.sin(b) * 520), tint)
    end
    # A bright core behind the head, and the edges burnt dark.
    ap.circle(cx, cy, 70 + 6 * math.sin(t * 0.4), ap.WHITE.fade(0.25))
    ap.circle(cx, cy, 46, accent.lerp(ap.WHITE, 0.6).fade(0.35))
    ap.gradient(x, 0, w, 50, ap.BLACK.fade(0.6), ap.BLACK.fade(0))
    ap.gradient(x, VH - 70, w, 70, ap.BLACK.fade(0), ap.BLACK.fade(0.75))
    if slot < closeups.length do
        var size = ap.Vec2(double(CLOSE_W) * 2, double(CLOSE_H) * 2)
        ap.sprite_part(closeups[slot].texture, ap.Rect(0, 0, double(CLOSE_W), double(CLOSE_H)),
            ap.Rect(cx - size.x / 2, VH - size.y, size.x, size.y))
    end
    if cut_kind != CUT_MERGE do
        # (A merge's card names both.)
        label_centered(f.kit.name, cx, VH - 22, 16, accent.lerp(ap.WHITE, 0.5))
    end
    ap.unclip()
    # The inner edge: white, then their color.
    var edge = x + w if slot == 0 else x
    var out = 1.0 if slot == 0 else -1.0
    ap.rect(edge - (4.0 if slot == 0 else 0.0), 0, 4, VH, ap.WHITE)
    ap.rect(edge + (0.0 if slot == 0 else -3.0), 0, 3, VH, accent)
    ap.rect(edge + out * 5 - (1.0 if slot == 1 else 0.0), 0, 1, VH, ap.BLACK.fade(0.6))
end

# Big, slanted words with a black outline and a block of color behind them, centered on (cx, cy).
function shout_words(string words, double cx, double cy, double size, double angle, double zoom,
        ap.Color fill, ap.Color block, double alpha)
    var w = ap.measure(words, size)
    ap.begin_camera(ap.Camera2D(ap.Vec2(0, 0), ap.Vec2(cx, cy), angle, zoom))
    var x = -w.x / 2
    var y = -w.y / 2
    var d = size / 16
    for i in 1..<7 do
        ap.text(words, x + d * double(i) * 0.7, y + d * double(i) * 0.7, size, block.brightness(0.45).fade(alpha))
    end
    for ox in -1..<2 do
        for oy in -1..<2 do
            if ox != 0 or oy != 0 do
                ap.text(words, x + double(ox) * d * 1.4, y + double(oy) * d * 1.4, size, ap.BLACK.fade(alpha))
            end
        end
    end
    ap.text(words, x, y, size, fill.fade(alpha))
    ap.end_camera()
end

# The words landing: big and faint, slamming down to size with a little bounce.
function shout_zoom(double t) returns double
    var k = math.clamp((t - double(SHOUT_AT - 6)) / 6, 0.0, 1.0)
    var settle = math.clamp((t - double(SHOUT_AT)) / 8, 0.0, 1.0)
    return 2.4 - 1.4 * k + 0.12 * math.sin(settle * math.PI) * (1 - settle)
end

# What a super does, in a few short lines for the card under SUPER!.
function shout_lines(roster.Maximum m) returns string[]
    string[] out = []
    for line in maximum_facts(m) do
        if not line.starts_with("CALL") and out.length < 4 do
            out.push(line)
        end
    end
    return out
end

function draw_super_shout(double t)
    var appear = shout_in(t)
    if appear <= 0 do
        return
    end
    var f = fighters[cut_user]
    var landed = math.clamp((t - double(SHOUT_AT - 6)) / 6, 0.0, 1.0) * appear
    var zoom = shout_zoom(t)
    var jolt = ap.shake_offset()
    if cut_kind == CUT_MERGE do
        var a = fighters[0]
        var b = fighters[1]
        draw_closeup_panel(0, a, 320, appear, t)
        draw_closeup_panel(1, b, 320, appear, t)
        shout_words("SUPER MERGE!", 320, 52, 40, -5, zoom, ap.WHITE, cut_def.glow.lerp(cut_def2.glow, 0.5), landed)
        # The card: what is merging, on black so it reads over both faces.
        var card = math.clamp((t - double(SHOUT_AT + 4)) / 8, 0.0, 1.0) * appear
        if card > 0 do
            var cx = 320 + jolt.x
            var top = 232.0 + jolt.y
            ap.rect(cx - 170, top, 340, 112, ap.BLACK.fade(0.88 * card))
            ap.rect(cx - 170, top, 340, 2, a.kit.look.accent.fade(card))
            ap.rect(cx, top, 170, 2, b.kit.look.accent.fade(card))
            label_centered("DIMENSIONS COLLIDE", cx, top + 10, 16, MAX_GOLD.fade(card))
            var names = "{a.kit.name}  +  {b.kit.name}"
            var nx = cx - ap.measure(names, 8).x / 2
            label(a.kit.name, nx, top + 32, 8, a.kit.look.accent.fade(card))
            label("+", nx + ap.measure("{a.kit.name}  ", 8).x, top + 32, 8, ap.WHITE.fade(card))
            label(b.kit.name, nx + ap.measure("{a.kit.name}  +  ", 8).x, top + 32, 8, b.kit.look.accent.fade(card))
            var ma = a.kit.maximum
            var mb = b.kit.maximum
            label_right(ma.name.upper(), cx - 8, top + 50, 8, ma.glow.fade(card))
            label(mb.name.upper(), cx + 8, top + 50, 8, mb.glow.fade(card))
            label_right(ma.place, cx - 8, top + 62, 8, ap.Color(200, 196, 220).fade(card))
            label(mb.place, cx + 8, top + 62, 8, ap.Color(200, 196, 220).fade(card))
            ap.rect(cx - 0.5, top + 48, 1, 26, ap.WHITE.fade(0.4 * card))
            label_centered("TWO PLACES AT ONCE, SPLIT DOWN THE MIDDLE", cx, top + 84, 8, ap.Color(150, 145, 175).fade(card))
            label_centered("EACH HALF FIGHTS FOR ITS OWNER", cx, top + 96, 8, ap.Color(150, 145, 175).fade(card))
        end
        return
    end
    # One super: the face on the user's side, the words and the card on the other.
    var slot = 0 if f.id == 0 else 1
    var panel = 250.0
    draw_closeup_panel(slot, f, panel, appear, t)
    var mid = (panel + VW) / 2 if slot == 0 else (VW - panel) / 2
    var drift = (1 - appear) * (40.0 if slot == 0 else -40.0)
    shout_words("SUPER!", mid + drift, 92, 56, -6, zoom, ap.WHITE, f.kit.look.accent, landed)
    var card = math.clamp((t - double(SHOUT_AT + 4)) / 8, 0.0, 1.0) * appear
    if card > 0 do
        var m = f.kit.maximum
        var lines = shout_lines(m)
        var w = 300.0
        var h = 44.0 + 12 * double(lines.length)
        var x = mid - w / 2 + drift + jolt.x
        var top = 142.0 + jolt.y
        ap.rect(x, top, w, h, ap.BLACK.fade(0.85 * card))
        ap.rect(x, top, w, 2, f.kit.look.accent.fade(card))
        label(cut_title.upper(), x + 10, top + 8, 16, m.glow.lerp(ap.WHITE, 0.25).fade(card))
        label("{f.kit.name}'S SUPER", x + 10, top + 28, 8, f.kit.look.accent.fade(card))
        for i, line in lines do
            label(line, x + 10, top + 42 + 12 * double(i), 8, ap.Color(200, 196, 220).fade(card))
        end
    end
end

# TELEMAN switches it off: the picture squeezes to a line, then a dot, then comes back.
function draw_jam_hud(double t)
    var f = fighters[cut_user]
    var mid = VH / 2
    if t < double(JAM_CLICK) do
        var show = math.clamp(t / 6, 0.0, 1.0)
        label_centered(cut_title, 320, 62, 32, f.kit.look.accent.fade(show))
        label_centered("{f.kit.name} CHANGES THE CHANNEL", 320, 100, 8, ap.WHITE.fade(show))
        return
    end
    if t < double(JAM_DARK) do
        var p = (t - double(JAM_CLICK)) / double(JAM_DARK - JAM_CLICK)
        if p < 0.6 do
            var h = math.max(VH * (1 - p / 0.6), 2.0)
            ap.rect(0, 0, VW, mid - h / 2, ap.BLACK)
            ap.rect(0, mid + h / 2, VW, VH - mid - h / 2, ap.BLACK)
            ap.rect(0, mid - h / 2, VW, h, ap.WHITE.fade(0.5 * p / 0.6))
        else do
            var w = math.max(VW * (1 - (p - 0.6) / 0.4), 3.0)
            ap.rect(0, 0, VW, VH, ap.BLACK)
            ap.rect(320 - w / 2, mid - 1, w, 2, ap.WHITE)
        end
        return
    end
    var back = (t - double(JAM_DARK)) / double(JAM_TICKS - JAM_DARK)
    if back < 0.3 do
        ap.rect(0, 0, VW, VH, ap.BLACK)
        ap.circle(320, mid, 3 * (1 - back / 0.3), ap.WHITE)
        label_centered("OFF AIR", 320, mid + 20, 16, f.kit.look.accent.fade(1 - back / 0.3))
        return
    end
    var h = VH * (back - 0.3) / 0.7
    ap.rect(0, 0, VW, mid - h / 2, ap.BLACK)
    ap.rect(0, mid + h / 2, VW, VH - mid - h / 2, ap.BLACK)
end

# Tries to begin a move: the basic chain at `chain`, a skill, or the super. True if something began.
function start_move(Fighter f, Fighter o, int slot, int chain = 0) returns bool
    var kit = f.kit
    var a = kit.ultimate
    var answer = wave_start(f, o, slot, chain)
    if answer >= 0 do
        if answer == 1 do
            wave_started(f, slot)
        end
        return answer == 1
    end
    if slot == SLOT_SUPER do
        if encore_ready(f) do
            # Inside your own super, G is the old super move, once.
            f.encore_used = true
        else if f.minion or f.partner do
            return false
        else if max_cut > 0 or in_super(f) or merge_owner >= 0 do
            deny(f, "A SUPER IS ON")
            return false
        else if max_owner >= 0 and not kit.maximum.jammer do
            deny(f, "MERGE IN THEIR CUTSCENE")
            return false
        else if f.energy < roster.SUPER_MAX do
            deny(f, "SUPER NOT READY")
            return false
        else if kit.maximum.jammer and max_owner < 0 do
            deny(f, "ONLY IN THEIR SUPER")
            return false
        else do
            # Their own, a merge with the one already on, or a switch-off.
            begin_maximum(f)
            return true
        end
    else if slot == SLOT_BASIC do
        if chain == 0 and mx(f).randomize do
            random_chain(f)
        end
        a = kit.basics[chain]
        if not can_pay(f, a.cost) do
            if kit.fallback.name == "" do
                deny(f, "NO {kit.bar_name}")
                return false
            end
            a = kit.fallback
        end
    else do
        a = kit.skills[slot]
        if a.kind == roster.KIND_CLOAK and f.cloaked do
            set_cloak(f, false)
            return true
        end
        if f.cooldowns[slot] > 0 do
            deny(f, "{(f.cooldowns[slot] + 59) // 60}s")
            return false
        end
        if a.kind == roster.KIND_RELOAD do
            if f.bar >= kit.bar_max do
                return false
            end
            f.cooldowns[slot] = a.cooldown
            begin_reload(f)
            return true
        end
        if a.kind == roster.KIND_FAN and pips(kit, f.bar) < 1 do
            deny(f, "NO {kit.bar_name}")
            return false
        end
        if not can_pay(f, a.cost) do
            deny(f, "NO {kit.bar_name}")
            return false
        end
        f.cooldowns[slot] = int(double(a.cooldown) * items.less(st(f, items.E_COOLDOWN), 80))
    end
    var hits = a.hits
    if a.kind == roster.KIND_FAN do
        hits = pips(kit, f.bar)
    end
    begin_attack(f, a, hits)
    f.slot = slot
    f.chain = chain
    if slot == SLOT_SUPER do
        super_begins(f, a)
    else if slot >= 0 do
        reshuffle(f, slot)
    end
    wave_started(f, slot)
    return true
end

# A super is called: everything holds its breath for a moment.
function super_begins(Fighter f, roster.Attack a)
    var here = f.body.position
    var red = ap.Color(240, 50, 60)
    super_name = a.name
    super_ticks = 80
    super_tint = f.kit.look.accent
    sound_at(snd_bell, here, 0.7, 0.5)
    sound_at(snd_charge, here, 0.7, 0.6)
    later(snd_thud, here, 6, 0.6, 1.2)
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), red, 7, 0.45))
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 4, 0.45))
    for i in 0..<24 do
        var out = forward_of(double(i) * 15) * ap.random(0.4, 0.9)
        streak(here + out + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(4, 9), 0), red if i % 2 == 0 else f.kit.look.accent,
            0.4, 0.7, 0.06)
    end
    hitstop(14)
end

function give_buff(Fighter f, roster.Attack a)
    var here = f.body.position
    var tint = f.kit.look.accent
    f.buff = a.buff
    f.buff_time = a.buff_time
    f.buff_rate = a.heal
    say(f.body.top(), a.name.upper(), tint)
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 6, 0.3))
    if a.buff == roster.BUFF_MIST do
        sound_at(snd_cloak, here, 0.6, 1.3)
        smoke(f.body.center(), 12, 0.5, 0.9)
    else if a.buff == roster.BUFF_REGEN do
        sound_at(snd_heal, here, 0.6)
        later(snd_heal, here, 8, 0.5, 1.3)
    else if a.buff == roster.BUFF_HASTE do
        sound_at(snd_kiai, here, 0.6, 1.3)
        later(snd_charge, here, 3, 0.4, 1.5)
        for i in 0..<16 do
            streak(here + forward_of(double(i) * 22) * 0.6, ap.Vec3(0, ap.random(4, 8), 0), tint, 0.3, 0.6)
        end
    else do
        sound_at(snd_thud, here, 0.7, 1.3)
        sound_at(snd_block, here, 0.6, 0.6)
        rings.push(Ring(f.body.center(), f.kit.look.metal, 3, 0.25, true))
    end
end

# A buff shows for as long as it lasts.
function buff_trail(Fighter f)
    var here = f.body.position
    var tint = f.kit.look.accent
    if f.buff == roster.BUFF_MIST do
        spark(f.body.center() + scatter(0.5), ap.Vec3(0, ap.random(0.2, 0.9), 0),
            tint if ap.chance(0.3) else ap.Color(150, 150, 165), 0.5, 0.11, -0.3)
    else if f.buff == roster.BUFF_HASTE do
        if ap.chance(0.5) do
            streak(here + forward_of(ap.random(0, 360)) * 0.45 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(3, 5), 0), tint, 0.25, 0.4)
        end
    else if f.buff == roster.BUFF_REGEN do
        f.health = math.min(f.health + f.buff_rate / 60, f.max_health)
        if ap.chance(0.4) do
            spark(f.body.center() + scatter(0.45), ap.Vec3(0, ap.random(0.8, 1.6), 0), ap.Color(120, 240, 130), 0.5, 0.08, 0)
        end
    else if f.buff == roster.BUFF_POWER do
        if ap.chance(0.5) do
            spark(puppet.muzzle(f.kit.look, here, f.heading) + scatter(0.15), ap.Vec3(0, ap.random(0.5, 1.2), 0), tint, 0.3, 0.07, 0)
        end
    else if f.buff == roster.BUFF_PARRY do
        # Still water: a slow ring of leaves around her.
        var turn = double(ticks) * 4
        spark(f.body.center() + forward_of(turn) * 0.8, ap.Vec3(0, -0.2, 0), tint, 0.3, 0.07, 0)
    else if f.buff == roster.BUFF_GUARD do
        var around = double(ticks) * 9
        spark(f.body.center() + forward_of(around) * 0.75, ap.Vec3(0, 0.2, 0), f.kit.look.metal, 0.25, 0.09, 0)
        spark(f.body.center() + forward_of(around + 180) * 0.75, ap.Vec3(0, 0.2, 0), tint, 0.25, 0.09, 0)
    end
end

# An instant step `far` meters the way the stick points, or straight away from the opponent.
function blink(Fighter f, Fighter o, double far)
    var body = f.body
    var from = body.center()
    var tint = f.kit.look.accent
    var way = unit(flat(f.wish))
    if f.wish.length() < 0.2 do
        way = unit(flat(body.position - o.body.position))
    end
    var reach = far
    var spot = body.position
    while reach > 0.5 do
        var there = body.position + way * reach
        there = ap.Vec3(there.x, 0, there.z)
        if flat(there).length() < ARENA - 0.6 and not world.overlaps(there + ap.Vec3(0, 1, 0), 0.5) and
                flat_distance(there, o.body.position) > 0.9 do
            spot = there
            break
        end
        reach -= 0.5
    end
    sound_at(snd_flash, from, 0.6, 1.2)
    later(snd_rift, spot, 2, 0.4, 1.8)
    leave_ghost(f, 0.4)
    gather(from, 12, tint, 1.1, 0.2, 0.09)
    rings.push(Ring(from, tint, 5, 0.2, true))
    rings.push(Ring(spot + ap.Vec3(0, 0.08, 0), tint, 6, 0.25))
    for i in 0..<10 do
        streak(spot + forward_of(double(i) * 36) * 0.5, ap.Vec3(0, ap.random(4, 7), 0), tint, 0.2, 0.5)
    end
    body.position = spot
    f.knock = ap.Vec3(0, 0, 0)
    if o.fade > 0.5 do
        f.heading = heading_of(o.body.position - spot)
    end
end

# Puts a move's shots in the air: one, a spread, a lob, a mine at the feet, or something from the sky.
function fire_shots(Fighter f, Fighter o, roster.Attack a, ap.Vec3 from, ap.Vec3 aim, double bonus, double boost = 1)
    var seen = o.fade > 0.5 and o.state != STATE_DOWN
    var target = target_of(f, o) if seen else f.body.position + forward_of(f.heading) * 6
    var power = boost * f.power_scale * (f.move_mult if a == f.move else 1.0)
    target = ap.Vec3(target.x, 0, target.z)
    if a.skyfall do
        if f.move_hits > 1 and f.hits_done > 1 do
            # The rest of a salvo falls around the first.
            target = target + ap.Vec3(ap.random(-2.4, 2.4), 0, ap.random(-2.4, 2.4))
        end
        var s = Shot(f.id, a, target + ap.Vec3(0, 14, 0), ap.Vec3(0, -a.shot_speed, 0), a.shot_life)
        s.bonus = bonus
        s.scale = power
        shots.push(s)
        # A shadow of what is coming, so there is a chance to run.
        stain(target, f.kit.look.accent, a.blast, 14 / a.shot_speed + 0.15, 0.3)
        return
    end
    if a.shot == roster.SHOT_MINE do
        var mine = Shot(f.id, a, f.body.position + forward_of(f.heading) * 0.9 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, 0, 0), a.shot_life)
        mine.scale = power
        shots.push(mine)
        return
    end
    if a.summon > 0 do
        # It comes from behind the caller and drives straight at them.
        var way = unit(flat(target - f.body.position))
        if way.length() < 0.5 do
            way = forward_of(f.heading)
        end
        var start = f.body.position - way * a.summon
        if flat(start).length() > ARENA - 1.2 do
            start = unit(flat(start)) * (ARENA - 1.2)
        end
        var car = Shot(f.id, a, ap.Vec3(start.x, 0.7, start.z), unit(flat(target - start)) * a.shot_speed, a.shot_life)
        car.scale = power
        shots.push(car)
        return
    end
    if a.lob do
        var to = target - from
        var t = math.clamp(flat(to).length() / a.shot_speed, 0.45, 1.1)
        var thrown = Shot(f.id, a, from, ap.Vec3(to.x / t, to.y / t + 0.5 * LOB_GRAVITY * t, to.z / t), a.shot_life)
        thrown.scale = power
        shots.push(thrown)
        return
    end
    for i in 0..<a.volley do
        var off = (double(i) - double(a.volley - 1) / 2) * a.spread
        var way = aim
        if off != 0 do
            way = forward_of(heading_of(aim) + off) * flat(aim).length() + ap.Vec3(0, aim.y, 0)
        end
        var s = Shot(f.id, a, from, way * a.shot_speed, a.shot_life)
        s.bonus = bonus
        s.scale = power
        shots.push(s)
    end
end

# A ray: it reaches as far as `beam` or the first thing in the way, and whoever it crosses is hit at once.
# How far along a ray from `from` going `way` it passes within `radius` of `center`; -1 if it misses.
function beam_along(ap.Vec3 from, ap.Vec3 way, ap.Vec3 center, double radius, double far) returns double
    var to = center - from
    var along = dot3(to, way)
    var off = (to - way * along).length()
    if along > 0 and along < far + 0.4 and off < radius + 0.4 do
        return along
    end
    return -1
end

function fire_beam(Fighter f, Fighter o, roster.Attack a, double bonus)
    var tint = f.kit.look.accent
    var from = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    var way = forward_of(f.heading)
    var seen = o.fade > 0.5 and o.state != STATE_DOWN
    var spot = target_of(f, o)
    if seen and ap.in_cone(f.body.position, way, spot, 70) and a.special != roster.SP_GOLDEN do
        way = unit(spot + ap.Vec3(0, o.body.height * 0.5, 0) - from)
    end
    # How far the light gets before stone stops it. The golden arrow goes clean through trees.
    var through_trees = a.special == roster.SP_GOLDEN and tree_group > 0
    if through_trees do
        world.enable(tree_group, false)
    end
    var far = 0.0
    while far < a.beam and not world.overlaps(from + way * (far + 0.4), 0.05) do
        far += 0.4
    end
    if through_trees do
        world.enable(tree_group, true)
    end
    # The first thing it crosses: the opponent, one of their clones, or a mirror copy.
    var best = far
    var hit_kind = 0
    var hit_minion = o
    var hit_mirror = Mirror(-1, 0, 0, 0)
    if o.state != STATE_DOWN do
        var d = beam_along(from, way, o.body.center(), o.body.radius, far)
        if d >= 0 do
            best = d
            hit_kind = 1
        end
    end
    for m in minions do
        if m.id == o.id and m != f and m != o do
            var d = beam_along(from, way, m.body.center(), m.body.radius, far)
            if d >= 0 and d < best do
                best = d
                hit_kind = 2
                hit_minion = m
            end
        end
    end
    for mi in mirrors do
        if mi.owner == o.id do
            var d = beam_along(from, way, mirror_at(mi) + ap.Vec3(0, 0.9, 0), 0.36, far)
            if d >= 0 and d < best do
                best = d
                hit_kind = 3
                hit_mirror = mi
            end
        end
    end
    var finish = from + way * best
    var wide = 0.08 + a.damage * 0.012
    beams.push(Beam(from, finish, tint, wide, 0.14, 0.14))
    sound_at(weapon_fire_sound(f), from, 0.4 if f.move_hits > 1 else 0.6, 1.0)
    # The energy-beam layers; a revolver's shot is only the gunshot.
    if f.hits_done == 1 and f.kit.look.weapon != roster.WEAPON_REVOLVER do
        sound_at(snd_slash, from, 0.6, 1.4)
        later(snd_charge, from, 1, 0.4, 2.2)
    end
    for i in 0..<5 do
        streak(finish, unit(scatter(1)) * ap.random(3, 7), tint if i % 2 == 0 else ap.WHITE, 0.16, 0.35)
    end
    if hit_kind == 1 do
        apply_hit(f, o, a, 1, from, false, bonus)
    else if hit_kind == 2 do
        apply_hit(f, hit_minion, a, 1, from, false, bonus)
    else if hit_kind == 3 do
        shatter_mirror(hit_mirror)
    else do
        burst(finish, 4, tint, 2, 0.3, 0.06)
    end
end

# One end of a pair of doors, a few steps ahead. A third replaces the oldest.
function open_portal(Fighter f, roster.Attack a)
    var way = forward_of(f.heading)
    var reach = a.blink
    var spot = f.body.position + way * reach
    while reach > 1 and (flat(spot).length() > ARENA - 1 or world.overlaps(spot + ap.Vec3(0, 1, 0), 0.6)) do
        reach -= 0.5
        spot = f.body.position + way * reach
    end
    Portal[] mine = []
    Portal[] kept = []
    for p in portals do
        if p.owner == f.id do
            mine.push(p)
        else do
            kept.push(p)
        end
    end
    if mine.length >= 2 do
        mine = [mine[1]]
    end
    for p in mine do
        kept.push(p)
    end
    kept.push(Portal(f.id, ap.Vec3(spot.x, 0, spot.z), ticks))
    portals = kept
    var at = spot + ap.Vec3(0, 1, 0)
    sound_at(snd_rift, at, 0.6, 1.4)
    later(snd_wisp, at, 4, 0.4, 1.4)
    rings.push(Ring(at, f.kit.look.accent, 4, 0.25, true))
    gather(at, 14, f.kit.look.accent, 1.2, 0.25, 0.08)
end

# What going through someone else's portal does to you: a burn no block stops, and a dose.
function portal_burn() returns roster.Attack
    var a = roster.hit("Portal", 8, 1, 1, 0, 0, 0, 16, 0, roster.ANIM_FOCUS)
    a.unblockable = true
    a.poison = 2
    return a
end
var portal_hit = portal_burn()

# Anyone, and anything flying, that enters one of a pair comes out of the other.
function update_portals()
    for owner in 0..<2 do
        Portal[] pair = []
        for p in portals do
            if p.owner == owner do
                pair.push(p)
            end
        end
        if pair.length < 2 do
            continue
        end
        for side in 0..<2 do
            var here = pair[side]
            var there = pair[1 - side]
            for g in fighters do
                if g.warp_cool > 0 or g.state == STATE_DOWN or ticks - here.born < 20 do
                    continue
                end
                if flat_distance(g.body.position, here.position) < 0.8 and g.body.position.y < 1.6 do
                    # Out the other side, still going the same way.
                    var going = unit(flat(g.body.velocity))
                    if going.length() < 0.5 do
                        going = forward_of(g.heading)
                    end
                    var out = there.position + going * 1.0
                    if flat(out).length() > ARENA - 0.6 or world.overlaps(out + ap.Vec3(0, 1, 0), 0.5) do
                        out = there.position
                    end
                    leave_ghost(g, 0.3)
                    burst(g.body.center(), 12, fighters[owner].kit.look.accent, 4, 0.35, 0.08)
                    g.body.position = ap.Vec3(out.x, g.body.position.y, out.z)
                    g.warp_cool = 55
                    sound_at(snd_flash, there.position, 0.6, 1.3)
                    rings.push(Ring(there.position + ap.Vec3(0, 1, 0), fighters[owner].kit.look.accent, 5, 0.2, true))
                    burst(g.body.center(), 12, ap.WHITE, 4, 0.35, 0.08)
                    if g.id != owner do
                        # The doors are tuned to their maker: anyone else comes out scorched,
                        # still flying the way they were thrown.
                        var thrown = g.knock
                        apply_hit(fighters[owner], g, portal_hit, 1, there.position - going, false)
                        g.knock = thrown
                        sound_at(snd_splash, there.position, 0.5, 1.7)
                        for i in 0..<10 do
                            streak(g.body.center(), unit(scatter(1)) * 5, fighters[owner].kit.look.accent, 0.2, 0.4)
                        end
                    end
                end
            end
            for sh in shots do
                var at = here.position + ap.Vec3(0, 1, 0)
                if not sh.warped and sh.attack.shot != roster.SHOT_MINE and not sh.attack.skyfall and
                        (sh.position - at).length() < 0.9 do
                    sh.warped = true
                    sh.position = there.position + ap.Vec3(0, sh.position.y, 0) + unit(flat(sh.velocity)) * 0.9
                    sound_at(snd_flash, there.position, 0.3, 1.8)
                end
            end
        end
    end
end

function begin_reload(Fighter f)
    f.state = STATE_RELOAD
    f.frame = 0
    sound_at(snd_reload, f.body.position, 0.5)
    # The spent casings drop out.
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    for i in 0..<5 do
        spark(hand + scatter(0.08), ap.Vec3(ap.random(-0.8, 0.8), ap.random(0.2, 1.2), ap.random(-0.8, 0.8)),
            ap.Color(230, 190, 90), 1.0, 0.05, 9)
        later(snd_casing, hand, 22 + i * 3, 0.22, ap.random(0.85, 1.25))
    end
end

# A move's strike: a melee check, or a shot leaving the hand.
function strike(Fighter f, Fighter o)
    var a = f.move
    var look = f.kit.look
    if a.kind == roster.KIND_BUFF do
        give_buff(f, a)
        return
    else if a.kind == roster.KIND_BLINK do
        blink(f, o, a.blink)
        return
    else if a.kind == roster.KIND_CLOAK do
        set_cloak(f, true)
        return
    else if a.kind == roster.KIND_PORTAL do
        open_portal(f, a)
        return
    else if a.kind == roster.KIND_LOCK do
        toggle_lock(f)
        return
    else if a.kind == roster.KIND_SWAP do
        swap_weapon(f)
        return
    else if a.kind == roster.KIND_RECALL do
        recall_daggers(f, o)
        return
    else if a.kind == roster.KIND_MIRROR do
        make_mirrors(f, o, a)
        return
    else if a.kind == roster.KIND_GLASS do
        glass_swap(f, o, a)
        return
    else if a.kind == roster.KIND_SHATTER do
        shatter_mirrors(f, o, a)
        return
    else if a.kind == roster.KIND_WALL do
        raise_wall(f, o, a)
        return
    else if a.kind == roster.KIND_QUIVER do
        change_quiver(f)
        return
    else if a.kind == roster.KIND_SWITCH do
        switch_places(f, o)
        return
    else if a.kind == roster.KIND_WAVE do
        wave_trick(f, o, a)
        return
    end
    if a.per_hit and not mx(f).free_bar do
        if f.bar + 0.001 < a.cost do
            return
        end
        f.bar -= a.cost
    end
    if a.on_trigger and not f.empowered do
        # Nobody took the bait: the spin ends with a round slid in.
        if a.restock > 0 and f.bar < f.kit.bar_max do
            f.bar = math.min(f.bar + a.restock, f.kit.bar_max)
            say(f.body.top(), "+{int(a.restock)}", look.accent)
            sound_at(snd_reload, f.body.position, 0.5, 1.2)
        end
        return
    end
    if f.cloaked do
        set_cloak(f, false)
    end
    if a.restock > 0 and not a.on_trigger do
        f.bar = math.min(f.bar + a.restock, f.kit.bar_max)
    end
    if a.buff != roster.BUFF_NONE do
        f.buff = a.buff
        f.buff_time = a.buff_time
        if a.buff == roster.BUFF_POWER do
            say(f.body.top(), "LOADED", f.kit.look.accent)
        end
    end
    var bonus = a.finish if f.hits_done == f.move_hits else 0.0
    var forward = forward_of(f.heading)
    if a.recoil > 0 do
        f.knock = forward * -a.recoil
    end
    if a.beam > 0 do
        fire_beam(f, o, a, bonus)
        return
    end
    if a.shot != roster.SHOT_NONE do
        if uses_arrow(f, a) do
            if f.arrows <= 0 do
                # The last one went on an earlier hit of this move.
                return
            end
            f.arrows -= 1
        end
        var from = puppet.muzzle(look, f.body.position, f.heading)
        var aim = forward
        if o.fade > 0.5 and o.state != STATE_DOWN do
            var spot = target_of(f, o)
            var to = spot + ap.Vec3(0, o.body.height * 0.5, 0) - from
            # Only as far off the facing as an arm could point.
            if ap.in_cone(f.body.position, forward, spot, 70) do
                aim = unit(to)
            end
        end
        if a.crater do
            tear_ground(f)
        end
        if a.shot == roster.SHOT_BULLET and f.move_hits > 1 do
            aim = unit(aim + ap.Vec3(ap.random(-0.05, 0.05), ap.random(-0.02, 0.02), ap.random(-0.05, 0.05)))
        else if a.shot == roster.SHOT_ROCKET and f.move_hits > 1 do
            aim = unit(aim + ap.Vec3(ap.random(-0.14, 0.14), ap.random(-0.02, 0.05), ap.random(-0.14, 0.14)))
        end
        var boost = 1.0
        if f.buff == roster.BUFF_POWER do
            # The loaded shot goes off.
            boost = 1.8
            f.buff = roster.BUFF_NONE
            say(f.body.top(), "LOADED SHOT", look.accent)
            rings.push(Ring(from, look.accent, 3, 0.2, true))
            sound_at(snd_boom, from, 0.5, 1.8)
        end
        fire_shots(f, o, a, from, aim, bonus, boost)
        signature(f, SIG_FIRE, a, from)
        if a.shot == roster.SHOT_BULLET do
            # Muzzle fire, a curl of smoke, and the casing spinning away. Fanned shots climb in pitch.
            sound_at(weapon_fire_sound(f), from, 0.6, 0.9 + 0.05 * double(f.hits_done) if f.move_hits > 1 else 1.0)
            var heavy_gun = look.weapon == roster.WEAPON_SHOTGUN or look.weapon == roster.WEAPON_REVOLVER or a.volley > 2
            muzzle_flash(from, aim, heavy_gun)
            if look.weapon == roster.WEAPON_SHOTGUN do
                # The spread, seen leaving the barrel.
                for i in 0..<10 do
                    streak(from + aim * 0.3, unit(aim + scatter(0.16)) * ap.random(16, 24), ap.Color(255, 220, 140), 0.07, 0.6, 0.03)
                end
            end
            spark(from - aim * 0.2, right_of(f.heading) * ap.random(1.2, 2) + ap.Vec3(0, ap.random(2, 3), 0),
                ap.Color(230, 190, 90), 1.0, 0.05, 9)
            later(snd_casing, from, 26, 0.22, ap.random(0.85, 1.25))
        else if a.shot == roster.SHOT_ROCKET do
            # The launch kicks smoke and flame out behind.
            sound_at(snd_shot, from, 0.7, 0.45)
            sound_at(snd_launch, from, 0.7)
            burst(from, 10, ap.Color(200, 200, 200), 2.5, 0.5, 0.1)
            for i in 0..<12 do
                spark(from - aim * 0.5 + scatter(0.15), aim * -ap.random(2, 5) + ap.Vec3(0, ap.random(0, 1), 0),
                    ap.Color(120, 120, 132), 0.7, 0.13, -0.5)
            end
            for i in 0..<6 do
                streak(from - aim * 0.4, (aim * -1.0 + scatter(0.3)) * 6, ap.Color(255, 170, 70), 0.12, 0.4)
            end
            rings.push(Ring(f.body.position + ap.Vec3(0, 0.08, 0), ap.Color(130, 130, 140), 5, 0.3))
        else if a.shot == roster.SHOT_CAR do
            # Somebody leans on the horn.
            sound_at(snd_kiai, f.body.position, 0.6, 1.4)
            later(snd_kiai, f.body.position, 9, 0.6, 1.4)
            later(snd_launch, f.body.position, 4, 0.5, 0.7)
        else if a.shot == roster.SHOT_KNIFE do
            sound_at(weapon_swing_sound(f), from, 0.5, 1.6)
        else if a.shot == roster.SHOT_FIST do
            sound_at(snd_launch, from, 0.6, 1.3)
            sound_at(snd_heavy, from, 0.5, 1.2)
            burst(from, 8, look.accent, 3, 0.3, 0.08)
        else if a.shot == roster.SHOT_RING do
            for i in 0..<4 do
                later(snd_lock, o.body.position, 2 + i * 6, 0.5, 1.5 if i % 2 == 0 else 1.9)
            end
        else if a.shot == roster.SHOT_BATS do
            sound_at(snd_wisp, from, 0.5, 1.9)
            sound_at(snd_hiss, from, 0.3, 0.6)
            burst(from, 10, ap.Color(40, 20, 34), 3, 0.4, 0.09)
        else if a.shot == roster.SHOT_WAVE do
            sound_at(snd_slash, from, 0.6, 0.9)
            later(snd_shing, from, 3, 0.3, 0.7)
            for i in 0..<8 do
                streak(from + scatter(0.3), aim * ap.random(5, 9), look.accent, 0.15, 0.5)
            end
        else if a.shot == roster.SHOT_BOMB do
            sound_at(snd_dash, from, 0.5, 0.7)
            later(snd_hiss, from, 2, 0.4, 1.2)
        else if a.shot == roster.SHOT_MINE do
            sound_at(snd_reload, from, 0.6, 0.6)
            later(snd_lock, from, 10, 0.4, 0.8)
            rings.push(Ring(f.body.position + forward * 0.9 + ap.Vec3(0, 0.08, 0), look.accent, 3, 0.25))
        else if a.shot == roster.SHOT_METEOR do
            sound_at(snd_thud, from, 0.6, 0.7)
            later(snd_launch, f.body.position, 12, 0.7, 0.5)
            for i in 0..<16 do
                streak(f.body.top() + scatter(0.3), ap.Vec3(ap.random(-1, 1), ap.random(9, 14), ap.random(-1, 1)), look.accent, 0.35, 0.8, 0.06)
            end
        else if a.shot == roster.SHOT_VENOM do
            sound_at(snd_spit, from, 0.6)
            sound_at(snd_splash, from, 0.3, 1.6)
            for i in 0..<8 do
                spark(from, (aim + scatter(0.35)) * ap.random(2, 5), look.accent, 0.3, 0.06, 6)
            end
        else if a.shot >= roster.SHOT_VIAL do
            wave_fire_fx(f, a, from, aim)
        else do
            sound_at(snd_cast, from, 0.5)
            later(snd_shimmer, from, 4, 0.3)
            for i in 0..<10 do
                streak(from, unit(scatter(1)) * 4, look.accent, 0.16, 0.3)
            end
            rings.push(Ring(from, look.accent, 1.6, 0.15, true))
        end
        return
    end
    if a.damage <= 0 and a.reach <= 0 do
        # Nothing but footwork.
        burst(f.body.position + ap.Vec3(0, 0.1, 0), 6, ap.Color(120, 115, 140), 2, 0.35, 0.09)
        return
    end
    # The sweep of the blow, shown as a fan of sparks.
    var sweep = math.min(a.arc, 150.0)
    if a.radial do
        rings.push(Ring(f.body.position + ap.Vec3(0, 0.15, 0), look.accent, a.reach / 0.3, 0.3))
        rings.push(Ring(f.body.center(), look.accent, a.reach / 0.35, 0.35, true))
        sound_at(snd_boom, f.body.position, 0.6, 1.6)
    else do
        for i in 0..<9 do
            var around = f.heading + sweep * (double(i) / 8 - 0.5)
            var at = f.body.position + forward_of(around) * (a.reach * 0.82) + ap.Vec3(0, 1.0 + 0.5 * double(i) / 8, 0)
            spark(at, forward_of(around) * 1.5, look.accent, 0.16, 0.07, 0)
        end
    end
    skill_strikes(f, a)
    signature(f, SIG_STRIKE, a, f.body.position)
    wave_struck(f, a)
    # Clones on their side and mirror copies are in the way too.
    for m in minions do
        if m.id == o.id and m != f and m != o and m.state != STATE_DOWN and
                flat_distance(f.body.position, m.body.position) <= a.reach + m.body.radius and
                (a.radial or ap.in_cone(f.body.position, forward, m.body.position, a.arc)) do
            apply_hit(f, m, a, 1, f.body.position, true, bonus)
        end
    end
    break_mirrors(f, o.id, a)
    if o.state == STATE_DOWN do
        return
    end
    var gap = flat_distance(f.body.position, o.body.position)
    var level = math.abs(f.body.position.y - o.body.position.y) < 1.6
    if gap <= a.reach + o.body.radius and level and
            (a.radial or ap.in_cone(f.body.position, forward, o.body.position, a.arc)) do
        apply_hit(f, o, a, 1, f.body.position, true, bonus)
    end
    if a.shroud do
        set_cloak(f, true)
    end
end

# Damage, blocking, parries, and everything a landed hit sets off.
# Nobody can be kept in a combo forever: after enough moves in a row the victim bursts free,
# cannot be hit for a moment, and the attacker is thrown back.
# --- Ragdolls -------------------------------------------------------------------------------------
# Some skills knock the victim limp: up into the air with `launch`, else back off their feet. Limp,
# they cannot act until they have landed, lain there a while, and got up. Lying on the floor almost
# nothing touches them (an explosion, something falling from above, a super). In the air anything
# does, and a basic attack juggles them: it keeps them up, but the JUGGLE_LIMIT-th throws them
# clear, so basic attacks alone cannot keep anyone up for long; it takes a skill to carry it on.

# On the floor and out of reach.
function lying(Fighter o) returns bool
    return o.ragdolled and o.landed and o.state == STATE_HURT
end

# Limp in the air: juggling.
function tumbling(Fighter o) returns bool
    return o.ragdolled and not o.landed and o.state == STATE_HURT
end

# What still reaches someone lying down.
function hits_lying(Fighter f, roster.Attack a) returns bool
    return a.blast > 0 or a.skyfall or a.kind == roster.KIND_WALL or (f.state == STATE_ATTACK and f.slot == SLOT_SUPER and f.move == a)
end

# A hit that does nothing because they are lying down (said once a move).
function passes_over(Fighter f, Fighter o, roster.Attack a) returns bool
    if not lying(o) or hits_lying(f, a) do
        return false
    end
    if o.lying_serial != f.serial do
        o.lying_serial = f.serial
        say(o.body.top(), "DOWN", ap.GRAY)
    end
    return true
end

function start_ragdoll(Fighter o, roster.Attack a, ap.Vec3 origin, double push)
    var away = unit(flat(o.body.position - origin))
    var v = o.body.velocity
    if a.launch > 0 do
        o.body.velocity = ap.Vec3(v.x, math.max(v.y, a.launch), v.z)
        o.knock = away * math.min(math.abs(push), 3.0)
    else do
        # Off their feet and back.
        o.body.velocity = ap.Vec3(v.x, math.max(v.y, 5.5), v.z)
        o.knock = away * math.max(math.abs(push) * 1.3, 8.0)
    end
    o.ragdolled = true
    o.landed = false
    o.ragdoll_age = 0
    o.floor_ticks = a.ragdoll
    o.juggles = 0
    o.state = STATE_HURT
    o.stun = math.max(o.stun, 2)
    o.stun_total = math.max(o.stun_total, 1)
    sound_at(snd_launch, o.body.position, 0.5, 1.1)
end

# A basic attack on someone in the air: up again, or the last of them, away.
function juggle(Fighter f, Fighter o)
    var away = unit(flat(o.body.position - f.body.position))
    var v = o.body.velocity
    o.juggles += 1
    if o.juggles >= JUGGLE_LIMIT do
        o.body.velocity = ap.Vec3(v.x, math.max(v.y, 4.0), v.z)
        o.knock = away * 15
        o.floor_ticks = math.max(o.floor_ticks, 50)
        rings.push(Ring(o.body.center(), f.kit.look.accent, 5, 0.2, true))
        sound_at(snd_launch, o.body.position, 0.5, 0.8)
    else do
        # Up to about the same height each time, however high they were.
        var pop = math.sqrt(2 * 24 * math.max(JUGGLE_HEIGHT - o.body.position.y, 0.2))
        o.body.velocity = ap.Vec3(v.x, pop, v.z)
        o.knock = away * 1.2
    end
end

# Each tick of someone limp. True while it holds them.
function ragdoll_tick(Fighter f) returns bool
    if not f.ragdolled do
        return false
    end
    if f.state != STATE_HURT do
        # Something else took hold of them (a break free, a grab, the round ending).
        f.ragdolled = false
        f.landed = false
        return false
    end
    f.ragdoll_age += 1
    f.stun = math.max(f.stun, 2)
    var body = f.body
    var down = (body.grounded or body.position.y < 0.05) and body.velocity.y <= 0.01 and f.ragdoll_age > 3
    if down and not f.landed do
        f.landed = true
        f.juggles = 0
        f.knock = f.knock * 0.35
        sound_at(snd_thud, body.position, 0.6, 0.8)
        burst(body.position + ap.Vec3(0, 0.1, 0), 10, ap.Color(120, 115, 140), 2.5, 0.4, 0.1)
        rings.push(Ring(body.position + ap.Vec3(0, 0.08, 0), ap.Color(150, 145, 165), 3, 0.25))
    else if not down and f.landed do
        # Knocked back into the air (an explosion under them).
        f.landed = false
    end
    if f.landed do
        f.floor_ticks -= 1
        if f.floor_ticks <= 0 do
            f.ragdolled = false
            f.landed = false
            f.state = STATE_IDLE
            f.frame = 0
            f.stun = 0
        end
    end
    return f.ragdolled
end

# Mashing has a limit: once the SPAM bar fills, the hit that filled it ragdolls the victim well
# away and their combo is over. Nobody is left open; the fight starts again at range.
function spam_shove(Fighter o, Fighter f)
    var away = unit(flat(o.body.position - f.body.position))
    var v = o.body.velocity
    f.spam = 0
    o.taken = 0
    o.pressure = 0
    o.since_hit = COMBO_GRACE
    # Knocked limp off their feet and well back (see "Ragdolls"); already limp, just thrown further.
    o.ragdolled = true
    if o.landed or o.state != STATE_HURT do
        o.ragdoll_age = 0
    end
    o.landed = false
    o.juggles = JUGGLE_LIMIT
    o.floor_ticks = SPAM_SHOVE_FLOOR
    o.knock = away * SPAM_SHOVE
    o.body.velocity = ap.Vec3(v.x, math.max(v.y, 5.0), v.z)
    o.state = STATE_HURT
    o.stun = math.max(o.stun, 2)
    o.stun_total = math.max(o.stun_total, 1)
    o.stun_basic = false
    say(f.body.top(), "SPAM", ap.Color(255, 120, 90))
    sound_at(snd_thud, o.body.position, 0.6, 1.3)
    rings.push(Ring(o.body.center(), ap.Color(255, 120, 90), 5, 0.2, true))
    for i in 0..<10 do
        streak(o.body.center(), (away + scatter(0.4)) * ap.random(5, 8), ap.Color(255, 120, 90), 0.2, 0.4)
    end
end

function combo_break(Fighter o, Fighter f)
    var at = o.body.center()
    o.state = STATE_IDLE
    o.frame = 0
    o.stun = 0
    o.safe = 50
    o.pressure = 0
    o.taken = 0
    o.since_hit = COMBO_GRACE
    o.knock = ap.Vec3(0, 0, 0)
    f.knock = unit(flat(f.body.position - o.body.position)) * 11
    say(o.body.top() + ap.Vec3(0, 0.3, 0), "BREAK FREE", ap.WHITE)
    sound_at(snd_parry, at, 0.7, 0.7)
    sound_at(snd_thud, at, 0.6, 1.5)
    rings.push(Ring(o.body.position + ap.Vec3(0, 0.1, 0), ap.WHITE, 8, 0.3))
    rings.push(Ring(at, ap.WHITE, 5, 0.2, true))
    for i in 0..<14 do
        streak(at, unit(scatter(1)) * 7, ap.WHITE, 0.2, 0.5)
    end
end

# What items add to a hit that lands clean: poison, slow, bar, super, a steal, a pop upward, and
# time off the cooldowns.
function on_hit_items(Fighter f, Fighter o, int stun)
    var venom = st(f, items.E_POISON)
    if venom > 0 and not o.kit.machine do
        o.poison = math.min(o.poison + venom, roster.POISON_LIMIT)
        for i in 0..<5 do
            spark(o.body.center() + scatter(0.3), ap.Vec3(0, ap.random(0.5, 1.2), 0), ap.Color(130, 240, 60), 0.5, 0.06, 0)
        end
    end
    var chill = st(f, items.E_SLOW)
    if chill > 0 and not o.kit.machine do
        o.slow = math.max(o.slow, chill)
        for i in 0..<5 do
            spark(o.body.position + forward_of(double(i) * 72) * 0.4 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, 0.6, 0),
                ap.Color(170, 220, 255), 0.5, 0.06, 0)
        end
    end
    f.bar = math.min(f.bar + st(f, items.E_BAR_HIT), f.kit.bar_max)
    if not f.partner and not f.minion do
        f.energy = math.min(f.energy + st(f, items.E_SUPER_HIT), roster.SUPER_MAX)
        var steal = st(f, items.E_STEAL)
        if steal > 0 and not o.minion and not o.partner do
            var take = math.min(o.energy, steal)
            o.energy -= take
            f.energy = math.min(f.energy + take, roster.SUPER_MAX)
        end
    end
    var lift = st(f, items.E_LAUNCH)
    if lift > 0 and stun > 0 do
        o.body.velocity = ap.Vec3(o.body.velocity.x, math.max(o.body.velocity.y, lift), o.body.velocity.z)
    end
    var refund = int(st(f, items.E_REFUND) * 60)
    if refund > 0 do
        for i in 0..<f.cooldowns.length do
            f.cooldowns[i] = math.max(f.cooldowns[i] - refund, 0)
        end
    end
end

# A critical: double damage, and it looks and sounds the part.
function critical_flash(Fighter f, Fighter o, ap.Vec3 at)
    var gold = ap.Color(255, 214, 90)
    say(o.body.top() + ap.Vec3(0, 0.45, 0), "CRITICAL", gold)
    sound_at(snd_coin_b, at, 0.5, 1.4)
    later(snd_heavy, at, 2, 0.5, 0.8)
    rings.push(Ring(at, gold, 7, 0.22, true))
    for i in 0..<14 do
        var way = forward_of(double(i) * 25.7) + ap.Vec3(0, ap.random(-0.4, 0.6), 0)
        streak(at, unit(way) * ap.random(7, 11), gold if i % 2 == 0 else ap.WHITE, 0.2, 0.55, 0.06)
    end
end

# A parry rings out: a bright clash of steel, a burst of sparks, a ring on the ground.
function parry_flourish(Fighter o, ap.Vec3 at)
    var face = forward_of(o.heading)
    for i in 0..<18 do
        var way = unit(face * ap.random(0.2, 1.0) + scatter(1) + ap.Vec3(0, 0.4, 0))
        streak(at, way * ap.random(5, 10), ap.Color(255, 236, 170) if i % 3 != 0 else ap.WHITE, ap.random(0.12, 0.25), 0.35, 0.04)
    end
    for i in 0..<8 do
        spark(at + scatter(0.1), unit(scatter(1) + ap.Vec3(0, 1, 0)) * ap.random(2, 5), ap.Color(255, 200, 120), 0.6, 0.04, 9)
    end
    rings.push(Ring(o.body.position + ap.Vec3(0, 0.08, 0), ap.WHITE, 7, 0.25))
    later(snd_shimmer, at, 3, 0.35, 1.6)
end

function is_basic(Fighter f, roster.Attack a) returns bool
    for b in f.kit.basics do
        if b == a do
            return true
        end
    end
    return a == f.kit.fallback
end

function apply_hit(Fighter f, Fighter o, roster.Attack a, double scale, ap.Vec3 origin, bool melee, double bonus = 0)
    if o.state == STATE_DOWN or phase != PHASE_FIGHT do
        return
    end
    var look = f.kit.look
    var at = o.body.center() + unit(flat(origin - o.body.position)) * 0.3
    # Some things simply cannot be hit.
    var slipping = o.state == STATE_ATTACK and o.move.evade and o.frame < o.move.startup + 4
    if wave_untouchable(o) do
        return
    end
    if passes_over(f, o, a) do
        return
    end
    if tumbling(o) and is_basic(f, a) and o.juggles >= JUGGLE_LIMIT do
        # Thrown clear: basic attacks cannot carry it on any further.
        return
    end
    var juggling = tumbling(o) and is_basic(f, a)
    if o.buff == roster.BUFF_MIST or slipping or o.safe > 0 do
        say(o.body.top(), "MISS", ap.GRAY)
        burst(at, 4, ap.Color(150, 150, 165), 2, 0.3, 0.07)
        return
    end
    if st(o, items.E_DODGE) > 0 and ap.chance(math.min(st(o, items.E_DODGE) / 100, 0.6)) do
        # SHADOW SILK: it was never quite there.
        say(o.body.top(), "DODGE", ap.Color(190, 186, 230))
        leave_ghost(o, 0.3)
        sound_at(snd_cloth, at, 0.5, 1.3)
        sound_at(snd_dash, at, 0.3, 1.5)
        for i in 0..<8 do
            streak(at + scatter(0.3), unit(flat(o.body.position - origin)) * ap.random(3, 6), ap.Color(170, 166, 210), 0.18, 0.4)
        end
        o.body.position = o.body.position + unit(flat(o.body.position - origin)) * 0.35
        return
    end
    var basic = is_basic(f, a)
    var bonus_pct = st(f, items.E_DAMAGE) + (st(f, items.E_MELEE) if melee else st(f, items.E_RANGED)) +
        (st(f, items.E_BASIC) if basic else st(f, items.E_SKILL))
    var damage = (a.damage + bonus) * scale * f.kit.greed * f.power_scale * items.more(bonus_pct) * f.code_power
    var crit = st(f, items.E_CRIT) > 0 and ap.chance(math.min(st(f, items.E_CRIT) / 100, 0.75))
    if crit do
        damage *= 2
    end
    if o.cpu do
        # Whatever hit them, they know where the real one is now.
        o.decoy = -1
    end
    if basic do
        # The more they have been leaned on lately, the less they do.
        damage *= BASIC_SCALE * (1 - SPAM_STALE * f.spam)
    end
    if f.cpu do
        damage *= LEVEL_DAMAGE[level]
    end
    if f.ambush do
        f.ambush = false
        var behind = not ap.in_cone(o.body.position, forward_of(o.heading), f.body.position, 200)
        damage *= roster.AMBUSH_BONUS if behind else roster.CLOAK_BONUS
        say(o.body.top(), "AMBUSH" if behind else "UNSEEN", look.accent)
        sound_at(snd_ambush, at, 0.6, 1.0 if behind else 1.3)
        rings.push(Ring(at, look.accent, 6, 0.22, true))
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 5, look.accent, 0.2, 0.45)
        end
    end
    if f.empowered and melee do
        damage *= roster.COUNTER_BONUS
        say(o.body.top(), "COUNTER", look.accent)
        rings.push(Ring(at, ap.WHITE, 6, 0.2, true))
    end
    if o.poison > 0 do
        damage *= f.kit.toxic_bonus
    end
    if melee and f.kit.backstab > 1 and not ap.in_cone(o.body.position, forward_of(o.heading), f.body.position, 200) do
        damage *= f.kit.backstab
        say(o.body.top(), "BACKSTAB", look.accent)
    end
    var guarding = o.state == STATE_BLOCK and
        ap.in_cone(o.body.position, forward_of(o.heading), origin, 170)
    guarding = wave_guard(f, o, guarding)
    var waiting = o.state == STATE_ATTACK and o.move.counter and o.frame < o.move.startup and not o.empowered
    var window = PARRY_TICKS + int(st(o, items.E_PARRY_TIME))
    if waiting or (guarding and (o.block_age <= window or mx(o).perfect_guard or o.buff == roster.BUFF_PARRY)) do
        # A parry: nothing lands, and a melee attacker is left open.
        sound_at(snd_parry, at, 0.7)
        burst(at, 14, ap.WHITE, 4, 0.35, 0.07)
        rings.push(Ring(at, ap.WHITE, 5, 0.2, true))
        say(o.body.top(), "PARRY", ap.WHITE)
        o.since_parry = 0
        parry_flourish(o, at)
        var mended = st(o, items.E_PARRY_HEAL)
        if mended > 0 do
            o.health = math.min(o.health + mended, o.max_health)
            say(o.body.top() + ap.Vec3(0, 0.5, 0), "+{int(mended)}", ap.Color(120, 240, 130))
        end
        o.bar = math.min(o.bar + o.kit.parry_gain, o.kit.bar_max)
        o.energy = math.min(o.energy + 3 * gain(o), roster.SUPER_MAX)
        if mx(o).parry_heal > 0 do
            o.health = math.min(o.health + mx(o).parry_heal, o.max_health)
            say(o.body.top() + ap.Vec3(0, 0.3, 0), "+{int(mx(o).parry_heal)}", ap.Color(120, 240, 130))
        end
        if melee do
            f.state = STATE_HURT
            f.stun = 46
            f.stun_total = 46
            f.stun_basic = false
            f.knock = unit(flat(f.body.position - o.body.position)) * 5
        end
        if wave_parry(f, o, waiting, melee) do
            waiting = false
        end
        if waiting do
            # The wait is over: straight into the answer.
            o.empowered = true
            o.frame = o.move.startup - 5
            o.heading = heading_of(f.body.position - o.body.position)
        end
        # Everything stops dead for a moment: the parry is the loudest thing in a fight.
        hitstop(PARRY_FREEZE)
        return
    end
    if guarding and a.unblockable do
        guarding = false
        say(o.body.top(), "GUARD BROKEN", ap.Color(255, 120, 90))
        sound_at(snd_block, at, 0.7, 0.5)
        burst(at, 10, ap.LIGHT_GRAY, 4, 0.3, 0.07)
    end
    var stun = a.stun
    var push = a.push
    push *= items.more(st(f, items.E_PUSH))
    if guarding do
        damage *= 0.2 * items.less(st(o, items.E_GUARD), 95)
        stun = 0
        push *= 0.5
    else do
        # A combo: each hit on someone who has not recovered does less and stuns shorter.
        # It lasts until they have gone a moment without being hit, so standing over someone
        # and hitting them the instant they recover is still the same combo.
        var helpless = o.state == STATE_HURT or o.since_hit < COMBO_GRACE
        o.taken = o.taken + 1 if helpless else 1
        if not helpless do
            o.pressure = 0
        end
        if f.serial != o.hit_serial or o.pressure == 0 do
            o.hit_serial = f.serial
            o.pressure += 1
        end
        o.since_hit = 0
        if o.taken > 2 do
            damage *= math.max(0.4, 1 - 0.1 * double(o.taken - 2))
        end
        stun = int(double(stun) * math.max(0.35, 1 - 0.07 * double(o.taken - 1)) * items.more(st(f, items.E_STUN), 0.2) *
            items.less(st(o, items.E_TENACITY), 80))
    end
    damage = wave_damage(f, o, a, damage, melee)
    damage *= o.kit.armor * items.less(st(o, items.E_ARMOR), 85) * o.code_armor
    if o.buff == roster.BUFF_GUARD do
        damage *= 0.45
    end
    # Whoever is behind on rounds hits a little harder and takes a little less.
    damage *= (1 + UNDERDOG_DAMAGE * double(behind(f))) * (1 - UNDERDOG_GUARD * double(behind(o)))
    damage *= mx(f).power * mx(f).foe_vulnerable * mx(o).armor
    # Items written in Flywheel have their say last.
    damage = code_hit(f, a, melee, damage)
    damage = code_hurt(o, a, melee, damage)
    if crit do
        critical_flash(f, o, at)
    end
    var through = damage
    if o.shield > 0 do
        # AEGIS takes it first.
        var soaked = math.min(o.shield, damage)
        o.shield -= soaked
        through -= soaked
        burst(at, 6, ap.Color(140, 210, 255), 3, 0.3, 0.07)
        rings.push(Ring(o.body.center(), ap.Color(140, 210, 255), 3, 0.18, true))
        if o.shield <= 0.01 do
            say(o.body.top() + ap.Vec3(0, 0.3, 0), "SHIELD BROKEN", ap.Color(140, 210, 255))
            sound_at(snd_block, at, 0.7, 0.6)
            sound_at(snd_shimmer, at, 0.5, 0.6)
            for i in 0..<16 do
                streak(o.body.center(), unit(scatter(1)) * ap.random(4, 8), ap.Color(170, 225, 255), 0.25, 0.4)
            end
        end
    end
    o.health -= through
    o.round_hurt += through
    if mech(o) == roster.MECH_HUNTER and not o.minion and not guarding and through > 0 do
        # Hit, he loses track of them.
        o.bar = math.max(o.bar - STUDY_LOST, 0.0)
    end
    o.knock = unit(flat(o.body.position - origin)) * push
    f.connected = true
    f.energy = math.min(f.energy + damage * roster.SUPER_PER_DEALT * gain(f), roster.SUPER_MAX)
    o.energy = math.min(o.energy + damage * roster.SUPER_PER_TAKEN * gain(o), roster.SUPER_MAX)
    copy_move(o, f, a)
    say(o.body.top(), "{int(damage + 0.5)}", ap.GRAY if guarding else ap.Color(255, 235, 200))
    if guarding do
        sound_at(snd_block, at, 0.6)
        burst(at, 6, ap.LIGHT_GRAY, 2.5, 0.25, 0.06)
        if basic and melee do
            # A blocked basic attack goes no further: the chain stops and the blocker has the next move.
            f.blocked = true
            f.knock = unit(flat(f.body.position - o.body.position)) * 2.5
            f.state = STATE_HURT
            f.stun = BLOCKED_STUN
            f.stun_total = BLOCKED_STUN
            f.spam = math.min(f.spam + SPAM_PER_HIT * 0.5, 0.99)
            if o.cpu do
                o.cool = math.min(o.cool, 4)
                o.block_hold = math.min(o.block_hold, 10)
            end
        end
    else do
        var unmoved = (o.kit.poise and stun < 20) or o.buff == roster.BUFF_GUARD or
            (o.state == STATE_ATTACK and o.move.sturdy) or mx(o).steady or (o.state == STATE_ATTACK and o.charge > 0)
        if unmoved do
            stun = 0
        end
        if tumbling(o) do
            # Limp in the air: a skill that ragdolls throws them again, a basic attack juggles,
            # anything else just keeps them up a little.
            if a.ragdoll > 0 do
                start_ragdoll(o, a, origin, push)
            else if basic do
                juggle(f, o)
            else do
                var v = o.body.velocity
                o.body.velocity = ap.Vec3(v.x, math.max(v.y, 3.6), v.z)
            end
            o.hurt_side = o.taken % 2
            stun = 0
        else if a.ragdoll > 0 and stun > 0 do
            start_ragdoll(o, a, origin, push)
            o.stun_basic = basic
            o.hurt_side = o.taken % 2
            stun = 0
        end
        if stun > 0 do
            if a.launch > 0 do
                # Off the ground: they cannot act until they land.
                o.body.velocity = ap.Vec3(o.body.velocity.x, a.launch, o.body.velocity.z)
                stun = math.max(stun, 40)
            else if not o.body.grounded and o.state == STATE_HURT do
                # Each hit in the air keeps them up a little longer.
                o.body.velocity = ap.Vec3(o.body.velocity.x, math.max(o.body.velocity.y, 3.6), o.body.velocity.z)
            end
            o.state = STATE_HURT
            o.stun = stun
            o.stun_total = stun
            o.stun_basic = basic
            o.hurt_side = o.taken % 2
        end
        if o.cloaked do
            set_cloak(o, false)
        end
        if a.poison > 0 and not o.kit.machine do
            o.poison = math.min(o.poison + a.poison, roster.POISON_LIMIT)
        end
        if a.slow > 0 and not o.kit.machine do
            o.slow = math.max(o.slow, a.slow)
        end
        var back = damage * (f.kit.lifesteal + st(f, items.E_LIFESTEAL) / 100) + a.heal + st(f, items.E_HEAL_HIT)
        var thorns = st(o, items.E_THORNS)
        if thorns > 0 and melee and f.state != STATE_DOWN do
            f.health = math.max(f.health - damage * thorns / 100, 1.0)
            burst(f.body.center(), 5, ap.Color(120, 200, 90), 3, 0.25, 0.06)
        end
        on_hit_items(f, o, stun)
        if back > 0 and f.state != STATE_DOWN do
            f.health = math.min(f.health + back, f.max_health)
            for i in 0..<int(4 + back / 2) do
                spark(f.body.center() + ap.Vec3(ap.random(-0.4, 0.4), ap.random(-0.6, 0.4), ap.random(-0.4, 0.4)),
                    ap.Vec3(0, ap.random(0.8, 1.8), 0), ap.Color(255, 60, 90), ap.random(0.4, 0.8), 0.07, 0)
            end
            if a.heal > 0 do
                sound_at(snd_heal, f.body.position, 0.5)
                say(f.body.top(), "+{int(back + 0.5)}", ap.Color(255, 90, 110))
            end
        end
        f.bar = math.min(f.bar + a.gain, f.kit.bar_max)
        # PHANTOM drinks the super bar out of whatever she touches.
        var steal = a.steal + f.kit.super_steal
        if steal > 0 and not f.minion and not o.minion do
            var take = math.min(o.energy, steal)
            o.energy -= take
            f.energy = math.min(f.energy + (0.0 if in_super(f) else take), roster.SUPER_MAX)
            if a.steal > 0 and take > 0.5 do
                say(o.body.top() + ap.Vec3(0, 0.3, 0), "-{int(take + 0.5)} SUPER", look.accent)
                for i in 0..<10 do
                    var life = ap.random(0.25, 0.45)
                    var from = o.body.center() + scatter(0.3)
                    spark(from, (f.body.center() - from) * (1 / life), ap.Color(240, 60, 70), life, 0.07, 0)
                end
            end
        end
        if a.inject and not f.minion and f.kit.lab do
            count_dose(f, o)
        end
        # The count the attacker sees.
        if o.taken <= 1 do
            f.combo_damage = 0
        end
        f.combo = o.taken
        f.combo_damage += damage
        f.combo_show = 110
        var heavy = damage >= 10
        sound_at(weapon_hit_sound(f, heavy, melee), at, 0.7, 1.0 + 0.04 * double(math.min(o.taken - 1, 8)))
        burst(at, int(6 + damage), look.accent, 3 + damage * 0.25, 0.4, 0.08)
        if a.launch > 0 and stun > 0 do
            for i in 0..<8 do
                streak(o.body.position + forward_of(double(i) * 45) * 0.4, ap.Vec3(0, ap.random(5, 9), 0), look.accent, 0.25, 0.6)
            end
        end
        skill_lands(f, o, a, at, origin)
        signature(f, SIG_LAND, a, at)
        wave_lands(f, o, a, damage, melee, basic)
        hitstop(int(math.clamp(2 + damage / 3, 3.0, 9.0)))
        if basic do
            # Too many basic attacks landed too quickly, and the opponent is let out.
            # Juggling someone ragdolled in the air hardly counts: the third hit ends it anyway.
            f.spam += SPAM_PER_HIT / double(a.volley) * items.less(st(f, items.E_SPAM), 90) * (JUGGLE_SPAM if juggling else 1.0)
        end
        if unstoppable(o) do
            # Nothing knocks them out of it: no breaking free, no shove.
            f.spam = math.min(f.spam, 0.99)
        else if o.pressure >= COMBO_LIMIT and o.health > 0 do
            combo_break(o, f)
            f.spam = math.min(f.spam, 0.99)
        else if f.spam >= 1 and o.health > 0 do
            spam_shove(o, f)
        end
    end
end

function explode(Shot s)
    var a = s.attack
    var owner = fighters[s.owner]
    if a.special == roster.SP_ANCHOR do
        add_pool(owner, s.position, 2.2, 9)
    else if a.potion > 0 do
        stain(ap.Vec3(s.position.x, 0, s.position.z), POTION_COLORS[a.potion], 1.6, 3, 0.5, true)
    end
    var tint = owner.kit.look.accent
    rings.push(Ring(s.position, tint, a.blast / 0.3, 0.3, true))
    rings.push(Ring(ap.Vec3(s.position.x, 0.1, s.position.z), tint, a.blast / 0.4, 0.4))
    burst(s.position, 30, ap.Color(255, 200, 110), 7, 0.6, 0.12)
    burst(s.position, 14, ap.Color(90, 90, 100), 3, 1.0, 0.16)
    sound_at(snd_boom, s.position, 0.9)
    # Fire, flying rubble, a column of smoke, and a scorch that stays on the floor.
    sound_at(snd_thud, s.position, 0.9)
    later(snd_boom, s.position, 7, 0.4, 0.5)
    rings.push(Ring(s.position, ap.Color(255, 226, 170), a.blast * 2.2, 0.16, true))
    for i in 0..<16 do
        streak(s.position, unit(scatter(1)) * ap.random(6, 11), ap.Color(255, 170, 70), 0.18, 0.6, 0.07)
    end
    for i in 0..<10 do
        spark(s.position, unit(scatter(1) + ap.Vec3(0, 1, 0)) * ap.random(4, 8), ap.Color(50, 46, 60), 1.2, 0.13, 12)
    end
    smoke(s.position + ap.Vec3(0, 0.3, 0), 14, 0.5, 1.6)
    if s.position.y < 1.6 do
        stain(s.position, ap.Color(6, 5, 10), a.blast * 0.7, 7, 0.7)
    end
    var o = other(owner)
    var gap = (o.body.center() - s.position).length()
    if gap < a.blast + o.body.radius do
        apply_hit(owner, o, a, (1.0 if gap < 1.1 else 0.6) * s.scale, s.position, false, s.bonus)
    end
    for m in minions do
        if m.id == o.id and (m.body.center() - s.position).length() < a.blast + m.body.radius do
            apply_hit(owner, m, a, 0.8 * s.scale, s.position, false, s.bonus)
        end
    end
    Mirror[] caught = []
    for mi in mirrors do
        if mi.owner == o.id and flat_distance(mirror_at(mi), s.position) < a.blast + 0.4 do
            caught.push(mi)
        end
    end
    for mi in caught do
        shatter_mirror(mi)
    end
    if a.shot == roster.SHOT_ROCK do
        # Stone, not fire: it breaks apart.
        for i in 0..<10 do
            spark(s.position, unit(scatter(1) + ap.Vec3(0, 1, 0)) * ap.random(3, 7), ap.Color(130, 108, 86), 1.0, 0.18, 12)
        end
    end
end

function update_shots()
    var dt = 1.0 / 60
    Shot[] flying = []
    for s in shots do
        var a = s.attack
        var owner = fighters[s.owner]
        var o = other(owner)
        var tint = owner.kit.look.accent
        var kind = a.shot
        if not wave_steps(owner) do
            # STOP THE CLOCK: their shots hang in the air too.
            flying.push(s)
            continue
        end
        s.age += dt
        s.life -= dt
        if kind == roster.SHOT_MINE do
            # It sits and waits for a foot.
            var near = o.state != STATE_DOWN and s.age > 0.8 and o.body.position.y < 1.2 and
                flat_distance(s.position, o.body.position) < 1.3
            if near do
                sound_at(snd_lock, s.position, 0.6, 1.6)
                explode(s)
            else if s.life <= 0 do
                burst(s.position, 6, ap.Color(120, 120, 130), 2, 0.4, 0.08)
            else do
                flying.push(s)
            end
            continue
        end
        if a.lob do
            s.velocity = s.velocity - ap.Vec3(0, LOB_GRAVITY * dt, 0)
        end
        if kind == roster.SHOT_SPIKE do
            # It runs along the floor, whatever it was aimed at.
            s.position = ap.Vec3(s.position.x, 0.35, s.position.z)
            s.velocity = unit(flat(s.velocity)) * a.shot_speed
        end
        if a.homing > 0 and o.fade > 0.5 and o.state != STATE_DOWN do
            var speed = s.velocity.length()
            var way = unit(s.velocity)
            var want = unit(o.body.center() - s.position)
            var along = math.clamp(way.x * want.x + way.y * want.y + way.z * want.z, -1.0, 1.0)
            var off = math.acos(along) * 180 / math.PI
            if off > 0.5 do
                s.velocity = unit(way + (want - way) * math.min(a.homing * dt / off, 1.0)) * speed
            end
        end
        var size = 0.18
        if kind == roster.SHOT_WAVE do
            size = 0.6
        else if kind == roster.SHOT_BATS do
            size = 0.4
        else if kind == roster.SHOT_METEOR do
            size = 0.7
        else if kind == roster.SHOT_CAR do
            size = 0.9
        else if kind == roster.SHOT_FIST or kind == roster.SHOT_RING do
            size = 0.32
        else if kind == roster.SHOT_ROCK do
            size = 0.45
        else if kind == roster.SHOT_SPIKE do
            size = 0.55
        end
        var steps = int(s.velocity.length() * dt / 0.22) + 1
        var done = false
        for k in 0..<steps do
            s.position = s.position + s.velocity * (dt / double(steps))
            var gap = flat_distance(s.position, o.body.position)
            var touching = o.state != STATE_DOWN and not (lying(o) and not hits_lying(owner, a)) and gap < o.body.radius + size and
                s.position.y > o.body.position.y - 0.1 - size and s.position.y < o.body.position.y + o.body.height + 0.1 + size
            # A clone on their side, or a mirror copy, can be in the way.
            var clone = o
            for m in minions do
                if m.id == o.id and not touching and clone == o and m.state != STATE_DOWN and not (lying(m) and not hits_lying(owner, a)) and
                        flat_distance(s.position, m.body.position) < m.body.radius + size and
                        s.position.y > m.body.position.y - 0.1 - size and s.position.y < m.body.position.y + m.body.height + 0.1 + size do
                    clone = m
                end
            end
            var glass = mirror_touched(o.id, s.position, size)
            var copy_hit = glass.owner >= 0 and not touching and clone == o
            var door = door_touched(o.id, s.position, size)
            if door != null and not touching and clone == o and not copy_hit do
                # Their door takes it, and answers.
                door_counter(door, owner)
                drop_dagger(s, s.position)
                burst(s.position, 6, ap.Color(200, 190, 170), 2.5, 0.3, 0.07)
                done = true
                break
            end
            if touching or clone != o or copy_hit or world.overlaps(s.position, 0.1) do
                if copy_hit do
                    shatter_mirror(glass)
                end
                drop_dagger(s, o.body.position if touching else (clone.body.position if clone != o else s.position))
                if a.blast > 0 do
                    explode(s)
                else do
                    if touching do
                        apply_hit(owner, o, a, s.scale, s.position - unit(s.velocity) * 0.6, false, s.bonus)
                    else if clone != o do
                        apply_hit(owner, clone, a, s.scale, s.position - unit(s.velocity) * 0.6, false, s.bonus)
                    end
                    burst(s.position, 6, tint, 2.5, 0.3, 0.07)
                    if kind == roster.SHOT_VENOM do
                        # It splashes, and what is left pools on the floor.
                        sound_at(snd_splash, s.position, 0.6)
                        burst(s.position, 10, tint, 3.5, 0.5, 0.07)
                        if a.pool > 0 do
                            var floor = ap.Vec3(s.position.x, 0, s.position.z)
                            hazards.push(Hazard(s.owner, floor, 1.7, a.pool))
                            stain(floor, tint, 1.7, a.pool, 0.5, true)
                        else do
                            stain(s.position, tint, 0.9, 4.5, 0.45, true)
                        end
                    else if kind == roster.SHOT_BULLET and not touching do
                        sound_at(snd_ricochet, s.position, 0.35, ap.random(0.8, 1.3))
                        for j in 0..<4 do
                            streak(s.position, unit(scatter(1) - unit(s.velocity)) * 5, ap.Color(255, 230, 150), 0.12, 0.3)
                        end
                    else if kind == roster.SHOT_CAR do
                        sound_at(snd_boom, s.position, 0.7, 1.2)
                        sound_at(snd_heavy, s.position, 0.7, 0.7)
                        burst(s.position, 16, ap.Color(250, 220, 70), 6, 0.6, 0.12)
                        smoke(s.position, 8, 0.5, 0.9)
                    else if kind == roster.SHOT_FIST do
                        sound_at(snd_heavy, s.position, 0.6, 0.9)
                        rings.push(Ring(s.position, tint, 5, 0.18, true))
                    else if kind == roster.SHOT_BATS do
                        sound_at(snd_bite, s.position, 0.4, 1.4)
                        burst(s.position, 10, ap.Color(40, 20, 34), 3, 0.4, 0.09)
                    else if kind == roster.SHOT_WAVE do
                        sound_at(snd_slash, s.position, 0.5, 1.2)
                        for j in 0..<8 do
                            streak(s.position, unit(scatter(1)) * 6, tint if j % 2 == 0 else ap.WHITE, 0.16, 0.5)
                        end
                    end
                end
                done = true
                break
            end
        end
        if not done and s.life <= 0 do
            drop_dagger(s, s.position)
        end
        if done or s.life <= 0 do
            continue
        end
        # What each kind trails behind it.
        if kind == roster.SHOT_ROCKET do
            spark(s.position, ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 0.6), ap.random(-0.4, 0.4)),
                ap.Color(255, 170, 70) if ap.chance(0.5) else ap.Color(120, 120, 130), 0.45, 0.11, -0.6)
        else if kind == roster.SHOT_VENOM do
            if not a.lob do
                s.velocity = s.velocity - ap.Vec3(0, 3 * dt, 0)
            end
            if ap.chance(0.4) do
                spark(s.position, ap.Vec3(0, -0.5, 0), tint, 0.4, 0.06, 4)
            end
        else if kind == roster.SHOT_BOLT do
            spark(s.position, scatter(0.5), tint, 0.3, 0.06, 0)
        else if kind == roster.SHOT_BATS do
            spark(s.position + scatter(0.3), scatter(0.6), ap.Color(60, 24, 44) if ap.chance(0.7) else tint, 0.3, 0.07, 0)
        else if kind == roster.SHOT_WAVE do
            spark(s.position + scatter(0.4), scatter(0.4), tint, 0.25, 0.07, 0)
        else if kind == roster.SHOT_BOMB do
            spark(s.position + ap.Vec3(0, 0.15, 0), scatter(0.8) + ap.Vec3(0, 1, 0), ap.Color(255, 220, 120), 0.2, 0.05, 2)
        else if kind == roster.SHOT_CAR do
            spark(s.position - unit(s.velocity) * 0.9 + ap.Vec3(0, -0.5, 0), scatter(0.6) + ap.Vec3(0, 0.6, 0), ap.Color(120, 116, 130), 0.5, 0.13, -0.3)
        else if kind == roster.SHOT_FIST do
            spark(s.position - unit(s.velocity) * 0.3, scatter(0.5), ap.Color(255, 170, 70) if ap.chance(0.5) else tint, 0.25, 0.08, 0)
        else if kind == roster.SHOT_RING do
            if ap.chance(0.5) do
                spark(s.position + scatter(0.2), scatter(0.4), tint, 0.2, 0.05, 0)
            end
        else if kind == roster.SHOT_ROCK do
            if ap.chance(0.5) do
                spark(s.position + scatter(0.2), scatter(0.4) - ap.Vec3(0, 1, 0), ap.Color(120, 100, 80), 0.4, 0.08, 6)
            end
        else if kind == roster.SHOT_SPIKE do
            # The ridge tears the floor up as it goes.
            spark(ap.Vec3(s.position.x, 0.05, s.position.z) + scatter(0.3), ap.Vec3(0, ap.random(2, 4), 0), ap.Color(130, 108, 86), 0.5, 0.12, 9)
            if ap.chance(0.3) do
                stain(s.position, ap.Color(30, 22, 16), 0.5, 3, 0.5)
            end
        else if kind == roster.SHOT_FEATHER do
            if ap.chance(0.3) do
                spark(s.position, scatter(0.3), tint, 0.25, 0.04, 0)
            end
        else if kind == roster.SHOT_COIN do
            if ap.chance(0.3) do
                spark(s.position, scatter(0.3), ap.Color(255, 230, 120), 0.2, 0.04, 0)
            end
        else if kind == roster.SHOT_METEOR do
            for j in 0..<3 do
                spark(s.position + scatter(0.4), scatter(1) + ap.Vec3(0, 3, 0),
                    ap.Color(255, 170, 70) if j > 0 else ap.Color(90, 90, 100), 0.5, 0.14, -0.5)
            end
        end
        flying.push(s)
    end
    shots = flying
    # Pools on the floor work on whoever stands in them.
    Hazard[] lying = []
    for h in hazards do
        h.life -= dt
        var foe = other(fighters[h.owner])
        if foe.state != STATE_DOWN and not foe.kit.machine and foe.body.position.y < 0.5 and flat_distance(h.position, foe.body.position) < h.radius do
            foe.poison = math.max(foe.poison, 2.0)
            foe.slow = math.max(foe.slow, 0.5)
        end
        if h.life > 0 do
            lying.push(h)
        end
    end
    hazards = lying
    update_portals()
    Beam[] lit = []
    for b in beams do
        b.life -= dt
        if b.life > 0 do
            lit.push(b)
        end
    end
    beams = lit
end

# --- A fighter's tick ----------------------------------------------------------------------------

function knock_down(Fighter f)
    f.state = STATE_DOWN
    f.frame = 0
    f.health = 0
    f.poison = 0
    if f.cloaked do
        set_cloak(f, false)
    end
end

# How fast a fighter walks right now.
function pace_of(Fighter f) returns double
    var pace = f.kit.speed * mx(f).speed * items.more(st(f, items.E_SPEED), 0.3) * f.code_speed
    if f.slow > 0 do
        pace *= 0.55
    end
    if f.buff == roster.BUFF_HASTE do
        pace *= 1.35
    else if f.buff == roster.BUFF_MIST do
        pace *= 1.5
    end
    return pace * wave_pace(f)
end

# A move that has finished striking can turn into the next: the chain, a skill, the super.
function cancel_into(Fighter f, Fighter o, Intent want)
    var kit = f.kit
    if f.slot == SLOT_BASIC and want.basic and f.chain < kit.basics.length - 1 and not f.blocked do
        used(f, "basic")
        start_move(f, o, SLOT_BASIC, f.chain + 1)
        return
    end
    if not f.connected do
        return
    end
    if want.ultimate and f.slot != SLOT_SUPER and can_super(f) do
        used(f, "super")
        start_move(f, o, SLOT_SUPER)
    else if want.skill > 0 and f.slot == SLOT_BASIC and move_ready(f, want.skill - 1) do
        used(f, "skill{want.skill}")
        start_move(f, o, want.skill - 1)
    end
end

# MONOPOLIST: out of capital, he is stuck until the bailout comes through.
function bankruptcy(Fighter f)
    var kit = f.kit
    if f.broke_ticks > 0 do
        f.broke_ticks -= 1
        f.state = STATE_HURT
        f.stun = math.max(f.stun, 2)
        f.stun_total = kit.bankrupt
        if ap.chance(0.25) do
            spark(f.body.top() + scatter(0.4), ap.Vec3(0, -1, 0), ap.Color(255, 206, 70), 0.6, 0.06, 4)
        end
        if f.broke_ticks == 0 do
            f.bar = kit.bar_max
            say(f.body.top(), "BAILOUT", kit.look.accent)
            sound_at(snd_gold_sack, f.body.position, 0.7)
            later(snd_coins, f.body.position, 8, 0.5, 1.1)
            banknotes(f.body.top() + ap.Vec3(0, 1.5, 0), 20, 2)
            rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), GOLD, 6, 0.4))
        end
    else if f.bar <= 0.001 and f.state != STATE_ATTACK and f.state != STATE_HURT and not mx(f).free_bar do
        f.broke_ticks = kit.bankrupt
        f.state = STATE_HURT
        f.stun = kit.bankrupt
        f.stun_total = kit.bankrupt
        f.knock = ap.Vec3(0, 0, 0)
        say(f.body.top() + ap.Vec3(0, 0.3, 0), "BANKRUPT", ap.Color(255, 90, 80))
        sound_at(snd_deny, f.body.position, 0.7, 0.6)
        sound_at(snd_coin_drop, f.body.position, 0.7, 0.8)
        later(snd_thud, f.body.position, 6, 0.6, 0.6)
        coins(f.body.center(), 14, 3)
        for i in 0..<16 do
            spark(f.body.center(), unit(scatter(1) + ap.Vec3(0, 1, 0)) * 4, ap.Color(255, 206, 70), 0.8, 0.07, 9)
        end
    end
end

# Body.update, but with the fight's own 1/60 s step: Body.update moves by the tick's real length,
# which is longer in a slowed fight (see FIGHT_PACE).
function step_body(ap.Body body, double gravity)
    var dt = 1.0 / 60
    var v = body.velocity
    if not body.grounded or v.y > 0 do
        v = ap.Vec3(v.x, v.y - gravity * dt, v.z)
    end
    body.move(world, v * dt)
    if body.grounded and v.y < 0 do
        v = ap.Vec3(v.x, 0, v.z)
    end
    if body.hit_ceiling and v.y > 0 do
        v = ap.Vec3(v.x, 0, v.z)
    end
    if body.hit_wall do
        var n = ap.Vec3(body.wall_normal.x, 0, body.wall_normal.z)
        if n.length() > 0.000001 do
            n = n.normalized()
            var into = v.dot(n)
            if into < 0 do
                v = v - n * into
            end
        end
    end
    body.velocity = v
end

function step_fighter(Fighter f, Fighter o, Intent want)
    var dt = 1.0 / 60
    var kit = f.kit
    var body = f.body
    var forward = forward_of(f.heading)
    wave_intent(f, o, want)
    f.wish = want.wish
    refresh_stats(f)
    f.since_parry = math.min(f.since_parry + 1, 9999)
    if phase == PHASE_FIGHT and f.state != STATE_DOWN do
        f.round_ticks += 1
        code_tick(f)
    end

    if f.state != STATE_DOWN and phase == PHASE_FIGHT do
        wave_tick(f, o)
    end
    if f.state != STATE_DOWN and phase == PHASE_FIGHT do
        # The special bar, and the super bar that fills on its own.
        if f.cloaked do
            f.bar -= kit.bar_drain * dt
            if f.bar <= 0 do
                f.bar = 0
                set_cloak(f, false)
            end
        else do
            f.bar = math.min(f.bar + kit.bar_regen * dt * (2.5 if f.buff == roster.BUFF_HASTE else 1.0) *
                items.more(st(f, items.E_BAR)), kit.bar_max)
        end
        f.energy = math.min(f.energy + roster.SUPER_PER_SECOND * dt * gain(f), roster.SUPER_MAX)
        if kit.bankrupt > 0 do
            bankruptcy(f)
        end
        # Poison.
        if f.poison > 0 do
            f.poison -= dt
            f.health -= roster.POISON_DPS * dt
            if ap.chance(0.12) do
                spark(body.center() + ap.Vec3(ap.random(-0.3, 0.3), ap.random(-0.4, 0.6), ap.random(-0.3, 0.3)),
                    ap.Vec3(0, ap.random(0.5, 1.2), 0), ap.Color(130, 240, 60), 0.6, 0.07, 0)
            end
        end
        if f.buff != roster.BUFF_NONE do
            f.buff_time -= dt
            buff_trail(f)
            if f.buff_time <= 0 do
                f.buff = roster.BUFF_NONE
            end
        end
        f.slow = math.max(f.slow - dt, 0.0)
        for i in 0..<f.cooldowns.length do
            f.cooldowns[i] = math.max(f.cooldowns[i] - mx(f).cool_rate, 0)
        end
        for i in 0..<f.arm_cools.length do
            if i // 3 != f.arm do
                f.arm_cools[i] = math.max(f.arm_cools[i] - mx(f).cool_rate, 0)
            end
        end
        f.clone_cool = math.max(f.clone_cool - 1, 0)
        var regen = st(f, items.E_REGEN)
        if regen > 0 and f.health < f.max_health do
            f.health = math.min(f.health + regen * dt, f.max_health)
            if ap.chance(0.1) do
                spark(f.body.position + ap.Vec3(ap.random(-0.4, 0.4), 0.1, ap.random(-0.4, 0.4)), ap.Vec3(0, 0.8, 0),
                    ap.Color(120, 220, 110), 0.6, 0.06, 0)
            end
        end
    end
    f.combo_show = math.max(f.combo_show - 1, 0)
    var vanished = mx(f).vanish and max_cut == 0 and not (f.state == STATE_ATTACK and f.move.special == roster.SP_GOLDEN)
    f.fade = ap.approach(f.fade, 0.0 if f.cloaked or vanished else 1.0, 0.2 if vanished else 0.07)
    if f.cloaked and not f.cpu and ap.chance(0.25) do
        # Wisps only the one wearing the shroud can see.
        spark(body.position + ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 1.6), ap.random(-0.4, 0.4)),
            ap.Vec3(0, ap.random(0.3, 0.8), 0), kit.look.accent, 0.5, 0.05, 0)
    end
    f.shown_health = ap.approach(f.shown_health, f.health, 0.35)
    f.dash_cooldown = math.max(f.dash_cooldown - 1, 0)
    f.warp_cool = math.max(f.warp_cool - 1, 0)
    f.safe = math.max(f.safe - 1, 0)
    f.spam = math.max(f.spam - 1.0 / (60 * SPAM_SECONDS), 0.0)
    f.since_hit = math.min(f.since_hit + 1, 999)
    if f.buff == roster.BUFF_PARRY and f.cpu and f.state == STATE_IDLE and o.state == STATE_ATTACK and
            flat_distance(f.body.position, o.body.position) < 4 do
        # Still water: the CPU holds its guard and lets them come.
        want.block = true
    end
    if f.since_hit == COMBO_GRACE do
        f.taken = 0
        f.pressure = 0
    end
    f.settle = ap.approach(f.settle, 1.0 if f.state == STATE_IDLE or f.state == STATE_ATTACK else 0.0, 0.1)

    # Turning: toward the opponent when they can be seen, else the way of travel.
    var can_see = o.fade > 0.5 and o.state != STATE_DOWN
    var look_at = target_of(f, o)
    if not f.cpu and has_mirrors(o) do
        # Which one is real is up to the player: they face where they steer.
        can_see = false
    end
    var turn = 0.0
    if f.state == STATE_IDLE or f.state == STATE_BLOCK or f.state == STATE_RELOAD do
        turn = 14
    else if f.state == STATE_ATTACK and f.frame < f.move.startup and not f.move.evade do
        turn = 6
    else if f.state == STATE_ATTACK and f.move_hits > 1 do
        turn = 3
    end
    if turn > 0 do
        var facing = f.heading
        if can_see do
            facing = heading_of(look_at - body.position)
        else if want.wish.length() > 0.2 do
            facing = heading_of(want.wish)
        end
        var off = wrap(facing - f.heading)
        f.heading = wrap(f.heading + math.clamp(off, -turn, turn))
        forward = forward_of(f.heading)
    end

    var walk = ap.Vec3(0, 0, 0)
    var pace = pace_of(f)
    f.frame += 1
    if ragdoll_tick(f) do
        # Limp: nothing to do but fly and lie there.
    else if f.state == STATE_HURT do
        f.stun -= 1
        if f.stun <= 0 and (body.grounded or body.position.y < 0.05) do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_RELOAD and kit.reload_all do
        walk = want.wish * (pace * 0.5)
        # A speed loader: every round drops in together at the end, or none do if a hit interrupts.
        if f.frame >= roster.SPEEDLOAD_TICKS do
            f.bar = kit.bar_max
            sound_at(snd_reload, body.position, 0.6, 0.7)
            later(snd_lock, body.position, 4, 0.5, 1.3)
            say(body.top(), "LOADED", kit.look.accent)
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_RELOAD do
        walk = want.wish * (pace * 0.5)
        # One bullet at a time: whatever is in before a hit interrupts stays in.
        if f.frame % roster.RELOAD_TICKS == 0 do
            f.bar = math.min(double(pips(kit, f.bar)) + 1, kit.bar_max)
            sound_at(snd_reload, body.position, 0.4, 0.8 + f.bar * 0.08)
        end
        if f.bar >= kit.bar_max do
            sound_at(snd_reload, body.position, 0.5, 0.6)
            later(snd_reload, body.position, 5, 0.5, 1.4)
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_DASH do
        walk = f.dash_way * DASH_SPEED
        if f.frame >= DASH_TICKS do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_ATTACK do
        var a = f.move
        var last = a.startup + (f.move_hits - 1) * a.interval
        if a.evade do
            # Footwork: out of the way while the move winds up, and nothing can touch it.
            if f.frame <= a.startup do
                walk = f.dash_way * (a.lunge / double(a.startup) * 60)
                if f.frame % 3 == 0 do
                    leave_ghost(f, 0.22)
                end
            end
        else if a.lunge > 0 do
            # Stepping in with the blow, but never through the opponent.
            var begins = math.max(a.startup - 7, 0)
            if f.frame > begins and f.frame <= last do
                var room = flat_distance(body.position, o.body.position) - body.radius - o.body.radius
                if room > 0.35 or o.state == STATE_DOWN do
                    walk = forward * (a.lunge / double(last - begins) * 60)
                end
            end
        end
        if f.frame < a.startup do
            skill_gathers(f, a)
            if a.beam > 0 do
                gather(puppet.muzzle(kit.look, body.position, f.heading), 2, kit.look.accent, 0.8, 0.14, 0.05)
            end
        end
        if (a.fx == roster.FX_FLECHE or a.sturdy or a.lunge >= 4.5 or f.slot == SLOT_SUPER) and walk.length() > 0.1 and f.frame % 3 == 0 and not a.evade do
            leave_ghost(f, 0.25)
        end
        if a.teleport and f.frame == math.max(a.startup - 6, 1) and o.state != STATE_DOWN do
            flash_step(f, o)
        end
        if f.hits_done < f.move_hits and f.frame == a.startup + f.hits_done * a.interval do
            f.hits_done += 1
            strike(f, o)
        end
        if f.state == STATE_ATTACK and f.hits_done >= f.move_hits and f.frame >= last + 3 and phase == PHASE_FIGHT do
            cancel_into(f, o, want)
        end
        if f.state == STATE_ATTACK and f.move == a and f.frame >= attack_length(a, f.move_hits) do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_IDLE or f.state == STATE_BLOCK do
        if want.block do
            if f.state != STATE_BLOCK do
                f.state = STATE_BLOCK
                f.block_age = PARRY_TICKS + 1 if want.sloppy else 0
            else do
                f.block_age += 1
            end
        else do
            f.state = STATE_IDLE
        end
        if want.dash and f.dash_cooldown == 0 and not wave_dashed(f) do
            used(f, "dash")
            f.dash_cooldown = DASH_COOLDOWN
        else if want.dash and f.dash_cooldown == 0 do
            used(f, "dash")
            f.state = STATE_DASH
            f.frame = 0
            f.dash_cooldown = int(double(DASH_COOLDOWN) * items.less(st(f, items.E_DASH), 90))
            f.dash_way = unit(want.wish) if want.wish.length() > 0.2 else forward * -1.0
            sound_at(snd_dash, body.position, 0.4)
            burst(body.position + ap.Vec3(0, 0.1, 0), 6, ap.Color(120, 115, 140), 2, 0.35, 0.09)
        else if want.ultimate do
            used(f, "super")
            start_move(f, o, SLOT_SUPER)
        else if want.skill > 0 do
            used(f, "skill{want.skill}")
            start_move(f, o, want.skill - 1)
        else if want.basic do
            used(f, "basic")
            start_move(f, o, SLOT_BASIC, 0)
        else do
            walk = want.wish * (pace * (0.35 if f.state == STATE_BLOCK else 1.0))
        end
    end

    # Moving: what the fighter means to do, plus what a hit pushed into them.
    body.velocity = ap.Vec3(walk.x + f.knock.x, body.velocity.y, walk.z + f.knock.z)
    step_body(body, 24)
    # Limp in the air nothing slows them down much; on the floor they skid to a stop.
    f.knock = f.knock * (0.86 if not f.ragdolled else (0.78 if f.landed else 0.95))
    var speed = walk.length()
    f.moving = ap.approach(f.moving, 1.0 if speed > 0.5 and f.state != STATE_DASH and f.state != STATE_ATTACK else 0.0, 0.12)
    var before = f.cycle
    f.cycle += speed * dt * 2.3
    # Footsteps come from where the feet are, so an unseen fighter can still be heard.
    if int(f.cycle / math.PI) != int(before / math.PI) and f.state != STATE_ATTACK do
        sound_at(snd_step, body.position, 0.22 if f.cloaked else 0.12)
        if f.cloaked and f.cpu and not vanished do
            burst(body.position + ap.Vec3(0, 0.05, 0), 2, ap.Color(110, 105, 130), 0.8, 0.5, 0.07)
        end
    end
    # The body is sprung toward what it is doing (see puppet.follow): stiff and a little past the
    # mark for a blow, loose and wobbling for a stagger, soft for walking and standing.
    if f.state == STATE_ATTACK do
        spring_pose(f, 40, 0.68)
    else if f.state == STATE_HURT and not f.ragdolled do
        spring_pose(f, 32, 0.45)
    else if f.state == STATE_HURT or f.state == STATE_DOWN do
        spring_pose(f, 26, 0.85)
    else if f.state == STATE_DASH do
        spring_pose(f, 34, 0.8)
    else if f.state == STATE_BLOCK do
        spring_pose(f, 36, 0.75)
    else do
        spring_pose(f, 21, 0.9)
    end
    wave_after(f, o)
    update_trail(f)
end

# --- Weapon trails ---------------------------------------------------------------------------------
# A blade, a staff or a cane leaves a ribbon of light behind its edge while it swings, and sparks
# fly where its tip drags across the stone.
const int TRAIL_POINTS = 7
var trail_quad = ap.plane(1, 1)

function swinging(Fighter f) returns bool
    if f.state != STATE_ATTACK do
        return false
    end
    var a = f.move
    if a.shot != roster.SHOT_NONE or a.beam > 0 or a.kind != roster.KIND_STRIKE or (a.damage <= 0 and a.reach <= 0) do
        return false
    end
    var t = attack_phase(a, f.move_hits, f.frame)
    return t > 0.55 and t < 2.35
end

function update_trail(Fighter f)
    var reach = puppet.weapon_reach(f.kit.look)
    if reach <= 0 or f.state == STATE_DOWN do
        f.trail = []
        f.trail_base = []
        return
    end
    var points = puppet.hand_and_tip(f.kit.look, f.pose, f.body.position, f.heading, reach)
    var base = points[0]
    var tip = points[1]
    if swinging(f) do
        f.trail.push(tip)
        f.trail_base.push(base)
        if f.trail.length > TRAIL_POINTS do
            f.trail.remove_at(0)
            f.trail_base.remove_at(0)
        end
    else if f.trail.length > 0 do
        # Let go of it from the tail end, two points a tick.
        for k in 0..<math.min(2, f.trail.length) do
            f.trail.remove_at(0)
            f.trail_base.remove_at(0)
        end
    end
    # The tip scraping the floor.
    var dragging = f.kit.look.stance == roster.STANCE_SHAMBLE or f.kit.look.stance == roster.STANCE_IAI or
        f.kit.look.weapon == roster.WEAPON_GREATSWORD
    var moving_tip = swinging(f) or (dragging and f.moving > 0.5)
    if tip.y < 0.16 and moving_tip and flat(tip).length() < ARENA + 0.5 do
        var ground = ap.Vec3(tip.x, 0.04, tip.z)
        var chance = 0.9 if swinging(f) else 0.35
        if ap.chance(chance) do
            for i in 0..<(4 if swinging(f) else 2) do
                spark(ground, (scatter(1) + ap.Vec3(0, 1.4, 0)) * ap.random(1.5, 3.5), ap.Color(255, 200, 110) if i % 2 == 0 else ap.Color(255, 245, 210),
                    ap.random(0.2, 0.45), 0.03, 9)
            end
        end
        if f.round_ticks % 9 == 0 or (swinging(f) and f.frame % 5 == 0) do
            sound_at(snd_knife, ground, 0.16 if not swinging(f) else 0.3, ap.random(1.3, 1.7))
        end
        if ap.chance(0.25) do
            stain(ground, ap.Color(20, 16, 24), 0.18, 1.5, 0.5)
        end
    end
end

function trail_color(Fighter f) returns ap.Color
    var look = f.kit.look
    if look.glowing_weapon or look.weapon == roster.WEAPON_SABER or look.weapon == roster.WEAPON_SHARD do
        return look.accent.lerp(ap.WHITE, 0.35)
    end
    return look.metal.lerp(look.accent, 0.45).lerp(ap.WHITE, 0.2)
end

# Each pair of neighbouring samples is a quad from the hand to the tip: drawn as a plane stretched
# over it, brighter toward the newest end.
function draw_trails()
    ap.cull(false)
    ap.depth_write(false)
    for g in everyone() do
        draw_trail(g)
    end
    for m in minions do
        if not m.partner do
            draw_trail(m)
        end
    end
    ap.depth_write(true)
    ap.cull(true)
end

function draw_trail(Fighter f)
    var n = f.trail.length
    if n < 2 or fighter_alpha(f) < 0.3 do
        return
    end
    ap.Mat4[] quads = []
    ap.Color[] colors = []
    var tint = trail_color(f)
    var edge = ap.WHITE.lerp(f.kit.look.accent, 0.3)
    var steps = 4
    var total = double((n - 1) * steps)
    for i in 0..<n - 1 do
        for k in 0..<steps do
            # A thin slice of the sweep between two samples, so the fan stays smooth and curved.
            var t0 = double(k) / double(steps)
            var t1 = double(k + 1) / double(steps)
            var tip0 = f.trail[i].lerp(f.trail[i + 1], t0)
            var tip1 = f.trail[i].lerp(f.trail[i + 1], t1)
            var base0 = f.trail_base[i].lerp(f.trail_base[i + 1], t0)
            var base1 = f.trail_base[i].lerp(f.trail_base[i + 1], t1)
            var age = (double(i * steps + k) + 1) / total
            for part in 0..<2 do
                # The outer edge bright and narrow, the inner part of the blade's sweep faint.
                var inner = 0.78 if part == 1 else 0.4
                var outer = 1.0 if part == 1 else 0.78
                var a0 = base0.lerp(tip0, inner)
                var a1 = base0.lerp(tip0, outer)
                var b0 = base1.lerp(tip1, inner)
                var b1 = base1.lerp(tip1, outer)
                var u = ((a1 - a0) + (b1 - b0)) * 0.5
                var w = ((b0 - a0) + (b1 - a1)) * 0.5
                if u.length() < 0.002 or w.length() < 0.0005 do
                    continue
                end
                var c = (a0 + a1 + b0 + b1) * 0.25
                var nn = unit(u.cross(w)) * 0.01
                quads.push(ap.Mat4(u.x, u.y, u.z, 0, nn.x, nn.y, nn.z, 0, w.x, w.y, w.z, 0, c.x, c.y, c.z, 1))
                var fade = age * age * fighter_alpha(f)
                colors.push((edge if part == 1 else tint).fade(fade * (0.75 if part == 1 else 0.28)))
            end
        end
    end
    ap.draw_many(trail_quad, quads, null, colors)
end

# The button press behind an action has been spent.
function used(Fighter f, string button)
    if not f.cpu do
        pad.consume(button)
    end
end

# Void's step: gone from here, behind the opponent an instant later.
function flash_step(Fighter f, Fighter o)
    var body = f.body
    var from = body.center()
    var behind = o.body.position - forward_of(o.heading) * 1.5
    var spot = ap.Vec3(behind.x, 0, behind.z)
    if flat(spot).length() > ARENA - 0.6 or world.overlaps(spot + ap.Vec3(0, 1, 0), 0.5) do
        spot = o.body.position + unit(flat(body.position - o.body.position)) * 1.5
        if world.overlaps(spot + ap.Vec3(0, 1, 0), 0.5) do
            return
        end
    end
    sound_at(snd_flash, from, 0.6)
    # What is left behind: an afterimage, and the dark closing over it.
    leave_ghost(f, 0.45)
    gather(from, 14, ap.Color(70, 34, 130), 1.2, 0.2, 0.1)
    rings.push(Ring(from, ap.Color(70, 34, 130), 5, 0.22, true))
    rings.push(Ring(spot + ap.Vec3(0, 0.08, 0), f.kit.look.accent, 6, 0.25))
    for i in 0..<10 do
        streak(spot + forward_of(double(i) * 36) * 0.5, ap.Vec3(0, ap.random(4, 7), 0), f.kit.look.accent, 0.2, 0.5)
    end
    later(snd_rift, spot, 2, 0.4, 1.8)
    for i in 0..<16 do
        var along = from.lerp(spot + ap.Vec3(0, 0.9, 0), double(i) / 15)
        spark(along + ap.Vec3(ap.random(-0.2, 0.2), ap.random(-0.5, 0.5), ap.random(-0.2, 0.2)),
            ap.Vec3(0, ap.random(0, 0.6), 0), f.kit.look.accent, ap.random(0.25, 0.5), 0.1, 0)
    end
    body.position = spot
    f.heading = heading_of(o.body.position - spot)
    f.knock = ap.Vec3(0, 0, 0)
end

# --- The second wave ---------------------------------------------------------------------------
# Eighteen fighters with mechanics of their own (roster.fw: `mech`, and each move's `special`).
# Everything they need lives here; the rest of the game calls in through the wave_ hooks:
#     wave_intent / wave_tick / wave_after   in step_fighter, before and after a fighter moves
#     wave_start / wave_started / wave_begins  when a move is asked for, chosen, and begun
#     wave_trick                              a KIND_WAVE move's strike
#     wave_damage / wave_taken / wave_lands   in apply_hit
#     wave_super_*                            supers: set up, every tick, taken down
#     wave_draw / wave_overlay                the things on the floor, and the HUD's extras

# Things the second wave leaves about: gadgets, gravestones, pools, coins, decoys, rails, lights.
const int TH_TURRET = 0
const int TH_TRAP = 1
const int TH_COIL = 2
const int TH_WALKER = 3      # a machine that walks at them and bursts (THE WORKSHOP)
const int TH_GRAVE = 4
const int TH_HANDS = 5       # hands about to come up out of the ground (THE CEMETERY)
const int TH_POOL = 6
const int TH_COIN = 7
const int TH_POTION = 8      # a potion brewing on the floor (THE GREAT WORK); value is which
const int TH_DECOY = 9
const int TH_COPY = 10       # a scarecrow in the corn (THE HARVEST); value 1: it bites
const int TH_TRACK = 11      # a length of rail from position to aim
const int TH_LIGHT = 12
const int TH_BURN = 13       # fire on the ground
const int TH_DOOR = 14       # DEADBOLT's locked door: yaw is the way it faces, value how far open (0-1)
const int DOOR_LIFE = 20 * 60        # how long a locked door stands
const int DOOR_COUNTER_COOL = 40     # ticks after a door counters before it can again

class Thing
    int kind
    int owner                        # the side it belongs to
    ap.Vec3 position
    int life                         # ticks left; -1 for as long as it is needed
    int born
    double value = 0
    double yaw = 0
    int clock = 0
    bool super_only = false          # put down by a super, taken away with it
    ap.Vec3 aim = ap.Vec3(0, 0, 0)
    bool gone = false
end
Thing[] things = []

const double CAGE_RADIUS = 3.4       # THE GALLOWS: the cell
const double DOOR_REACH = 4.5        # THE FORBIDDEN DOOR: how near the door the slam is felt
const int BEAT = 30                  # MAESTRO: ticks between beats
const int BEAT_WINDOW = 6            # ...and how far off one a move still counts as on it
const double CHAIN_REACH = 3.0       # WARDEN: how far from the stake a chain lets them go

var time_scale = 1.0                 # CLOCKWORK: how much faster than the set pace the fight runs...
var time_left = 0                    # ...for this many ticks
var cage_at = ap.Vec3(0, 0, 0)
var door_at = ap.Vec3(0, 0, 0)
var door_clock = 0
var train_ride = 0                   # CONDUCTOR: ticks the ride has run...
var train_brake = -1                 # ...and into braking (-1: not braking)
var train_clack = 0.0                # the wheels' way to the next rail joint (1: there)
var train_pulled = false             # the brake was pulled early (a smaller fine), not the arrival
var train_hum = -1                   # the voice of the brakes squealing
const int TRAIN_BRAKE = 170          # ticks from the brake to a standstill...
const int TRAIN_DWELL = 70           # ...and standing at the platform before the doors open
var train_axis = ap.Vec3(0, 0, 1)
var announce = ""                    # a line from the train's speakers...
var announce_ticks = 0
var fire_left = 0                    # MOTH: ticks the whole place burns
var fire_owner = -1
var coin_clock = 0
var omen_clock = 0

function turret_bolt() returns roster.Attack
    return roster.fire("Turret Bolt", 4, 1, 1, roster.SHOT_ARROW, 30, 12, 1, roster.ANIM_SHOOT)
end
var bolt_attack = turret_bolt()
function blast_of(string name, double damage, double radius, int stun) returns roster.Attack
    var a = roster.fire(name, damage, 1, 1, roster.SHOT_BOMB, 1, stun, 6, roster.ANIM_CAST)
    a.blast = radius
    return a
end
var walker_blast = blast_of("Walker", 12, 1.8, 26)
var decoy_blast = blast_of("Straw Man", 12, 1.9, 30)
var grave_blast = blast_of("Exhume", 13, 2.0, 30)
var gadget_blast = blast_of("Overclock", 7, 1.8, 20)
var flare_blast = blast_of("Flare", 12, 2.4, 26)
var dive_blast = blast_of("Plasma Dive", 22, 3.2, 50)

function mech(Fighter f) returns int
    return f.kit.mech
end

# Whoever stands against side `side`: one fighter, or two in a 2v2.
function foes_of_side(int side) returns Fighter[]
    return side_fighters(1 - side)
end

# HAMMERHEAD down in the tide with someone he dragged under: he holds them there and does
# nothing else until they come up.
function holding_under(Fighter f) returns bool
    if f.minion or mech(f) != roster.MECH_HAMMERHEAD do
        return false
    end
    for g in foes_of_side(f.id) do
        if g.drag > 0 do
            return true
        end
    end
    return false
end

# A super of this mechanic is in force (as the first place or the merged one).
function wave_super(int kind) returns bool
    if max_owner >= 0 and max_owner < fighters.length and mech(fighters[max_owner]) == kind do
        return true
    end
    return merge_owner >= 0 and merge_owner < fighters.length and mech(fighters[merge_owner]) == kind
end
# The fighter whose super of this mechanic is on, or null.
function wave_super_user(int kind) returns Fighter?
    if max_owner >= 0 and max_owner < fighters.length and mech(fighters[max_owner]) == kind do
        return fighters[max_owner]
    end
    if merge_owner >= 0 and merge_owner < fighters.length and mech(fighters[merge_owner]) == kind do
        return fighters[merge_owner]
    end
    return null
end
function own_super(Fighter f, int kind) returns bool
    return in_super(f) and mech(f) == kind and max_cut == 0
end

# Ends `f`'s own super at the next tick.
function end_own_super(Fighter f)
    if max_owner == f.id do
        max_left = math.min(max_left, 1)
    else if merge_owner == f.id do
        merge_left = math.min(merge_left, 1)
    end
end

# Health lost to something no block stops: an ailment, a chain, a fine, the water.
function wave_hurt(Fighter by, Fighter o, double amount, string words, ap.Color tint)
    if o.state == STATE_DOWN or phase != PHASE_FIGHT or amount <= 0 do
        return
    end
    var damage = amount * o.kit.armor * mx(o).armor
    o.health -= damage
    o.round_hurt += damage if by.id != o.id else 0.0
    by.energy = math.min(by.energy + damage * roster.SUPER_PER_DEALT * gain(by), roster.SUPER_MAX)
    o.energy = math.min(o.energy + damage * roster.SUPER_PER_TAKEN * gain(o), roster.SUPER_MAX)
    if words != "" do
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "{words} {int(damage + 0.5)}", tint)
    end
    burst(o.body.center(), int(4 + damage / 2), tint, 3, 0.35, 0.07)
end

# Knocks `o` off their feet for a moment, whatever they were doing.
# WARDEN passing his verdict: once begun it goes through. Hits do not stagger him (it is sturdy),
# and nothing stuns, swaps, seals or drags him out of it.
# Moves nothing stops once begun: WARDEN's verdict and HUNTER's golden arrow.
function unstoppable(Fighter f) returns bool
    return f.state == STATE_ATTACK and (f.move.special == roster.SP_VERDICT or f.move.special == roster.SP_GOLDEN)
end

function unstoppable_word(Fighter f) returns string
    return "THE AIM HOLDS" if f.move.special == roster.SP_GOLDEN else "THE VERDICT STANDS"
end

function wave_stun(Fighter o, int length, bool basic = false)
    if o.state == STATE_DOWN or unstoppable(o) do
        return
    end
    if mx(o).steady do
        return
    end
    o.state = STATE_HURT
    o.stun = math.max(o.stun, length)
    o.stun_total = math.max(o.stun, 1)
    o.stun_basic = basic
    o.frame = 0
end

function add_thing(Thing t)
    things.push(t)
end
function count_things(int owner, int kind) returns int
    var n = 0
    for t in things do
        if t.owner == owner and t.kind == kind and not t.gone and not t.super_only do
            n += 1
        end
    end
    return n
end
# The oldest of a side's things of this kind goes, when there are already `most` of them.
function make_room(int owner, int kind, int most)
    while count_things(owner, kind) >= most do
        for t in things do
            if t.owner == owner and t.kind == kind and not t.gone and not t.super_only do
                t.gone = true
                burst(t.position + ap.Vec3(0, 0.5, 0), 8, ap.Color(140, 130, 120), 2, 0.4, 0.08)
                break
            end
        end
    end
end
function gadget_count(int owner) returns int
    return count_things(owner, TH_TURRET) + count_things(owner, TH_TRAP) + count_things(owner, TH_COIL)
end
# A spot `far` meters ahead of `f`, on the disc and out of the stone.
function spot_ahead(Fighter f, double far) returns ap.Vec3
    var way = forward_of(f.heading)
    var reach = far
    var spot = flat(f.body.position + way * reach)
    while reach > 0.4 and (spot.length() > ARENA - 0.8 or world.overlaps(spot + ap.Vec3(0, 0.6, 0), 0.4)) do
        reach -= 0.3
        spot = flat(f.body.position + way * reach)
    end
    return spot
end
function on_disc(ap.Vec3 at, double margin) returns ap.Vec3
    var p = flat(at)
    if p.length() > ARENA - margin do
        p = unit(p) * (ARENA - margin)
    end
    return p
end

# --- DEATH: ailments that react ------------------------------------------------------------------
const int AIL_ROT = 0
const int AIL_FEVER = 1
const int AIL_PALSY = 2
const string[] AIL_NAMES = ["ROT", "FEVER", "PALSY"]
const ap.Color[] AIL_COLORS = [ap.Color(130, 200, 60), ap.Color(255, 110, 70), ap.Color(130, 170, 255)]

function add_ailment(Fighter by, Fighter o, int k, double seconds)
    if o.state == STATE_DOWN do
        return
    end
    o.ailments[k] = math.max(o.ailments[k], seconds)
    o.ailment_by = by.id
    say(o.body.top() + ap.Vec3(0, 0.15, 0), AIL_NAMES[k], AIL_COLORS[k])
    sound_at(snd_hiss, o.body.position, 0.4, 0.8 + 0.2 * double(k))
    for i in 0..<8 do
        spark(o.body.center() + scatter(0.35), ap.Vec3(0, ap.random(0.4, 1.0), 0), AIL_COLORS[k], 0.6, 0.07, 0)
    end
    react(by, o)
end

# Two ailments at once turn into something worse.
function react(Fighter by, Fighter o)
    var a = o.ailments
    var at = o.body.center()
    if a[AIL_ROT] > 0 and a[AIL_FEVER] > 0 do
        a[AIL_ROT] = 0
        a[AIL_FEVER] = 0
        wave_hurt(by, o, 14, "SEPSIS", ap.Color(220, 170, 60))
        sound_at(snd_splash, at, 0.6, 0.6)
        later(snd_boom, at, 2, 0.4, 1.6)
        rings.push(Ring(at, ap.Color(220, 170, 60), 5, 0.3, true))
    else if a[AIL_FEVER] > 0 and a[AIL_PALSY] > 0 do
        a[AIL_FEVER] = 0
        a[AIL_PALSY] = 0
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "DELIRIUM", ap.Color(220, 140, 255))
        wave_stun(o, 70)
        sound_at(snd_wisp, at, 0.6, 0.5)
        rings.push(Ring(o.body.top(), ap.Color(220, 140, 255), 3, 0.5, true))
    else if a[AIL_ROT] > 0 and a[AIL_PALSY] > 0 do
        a[AIL_ROT] = 0
        a[AIL_PALSY] = 0
        o.necrosis = 8
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "NECROSIS", ap.Color(150, 200, 170))
        sound_at(snd_growl, at, 0.5, 1.4)
        rings.push(Ring(o.body.position + ap.Vec3(0, 0.1, 0), ap.Color(110, 160, 120), 5, 0.4))
    end
end
function ailment_count(Fighter o) returns int
    var n = 0
    for v in o.ailments do
        if v > 0 do
            n += 1
        end
    end
    return n
end
function tick_ailments(Fighter f)
    var dt = 1.0 / 60
    if f.ailments[AIL_ROT] > 0 do
        f.health -= 2 * dt
        if ap.chance(0.12) do
            spark(f.body.center() + scatter(0.35), ap.Vec3(0, -0.4, 0), AIL_COLORS[AIL_ROT], 0.6, 0.07, 3)
        end
    end
    if f.ailments[AIL_FEVER] > 0 and ap.chance(0.1) do
        spark(f.body.top() + scatter(0.25), ap.Vec3(0, 0.8, 0), AIL_COLORS[AIL_FEVER], 0.5, 0.06, -0.5)
    end
    if f.ailments[AIL_PALSY] > 0 do
        f.slow = math.max(f.slow, 0.1)
        if ticks % 2 == 0 do
            # The cooldowns crawl: every other tick they get it back.
            for i in 0..<f.cooldowns.length do
                if f.cooldowns[i] > 0 do
                    f.cooldowns[i] += 1
                end
            end
        end
    end
    for k in 0..<3 do
        f.ailments[k] = math.max(f.ailments[k] - dt, 0.0)
    end
    f.necrosis = math.max(f.necrosis - dt, 0.0)
end

# --- ZERO: wild effects --------------------------------------------------------------------------
const string[] WILD_NAMES = ["...NOTHING", "BOUNCE", "BANANA PEEL", "UP YOU GO", "SHOVE", "PICKPOCKET", "GIGGLE",
    "SPARKLER", "SWAP", "DIZZY", "BACKFIRE"]

function wild_effect(Fighter f, Fighter o, double scale)
    var k = pick_index(WILD_NAMES.length)
    var tint = f.kit.look.accent
    var at = o.body.center()
    say(o.body.top() + ap.Vec3(0, 0.5, 0), WILD_NAMES[k], ap.Color(255, 230, 120))
    sound_at(snd_card, at, 0.5, ap.random(0.8, 1.4))
    if k == 1 do
        wave_hurt(f, o, 5 * scale, "", tint)
        sound_at(snd_thud, at, 0.5, 1.6)
    else if k == 2 do
        o.slow = math.max(o.slow, 2 * scale)
    else if k == 3 do
        o.body.velocity = ap.Vec3(o.body.velocity.x, 7 * math.sqrt(scale), o.body.velocity.z)
        wave_stun(o, 40)
    else if k == 4 do
        o.knock = unit(flat(o.body.position - f.body.position)) * 10 * scale
    else if k == 5 do
        var take = math.min(o.energy, 6 * scale)
        o.energy -= take
        f.energy = math.min(f.energy + (0.0 if in_super(f) else take), roster.SUPER_MAX)
        coins(at, 6, 2)
    else if k == 6 do
        f.health = math.min(f.health + 5 * scale, f.max_health)
        say(f.body.top(), "+{int(5 * scale)}", ap.Color(120, 240, 130))
    else if k == 7 do
        o.poison = math.min(o.poison + 2 * scale, roster.POISON_LIMIT)
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 5, ap.Color(255, 200, 80), 0.25, 0.3)
        end
    else if k == 8 do
        if not o.minion do
            switch_places(f, o)
        end
    else if k == 9 do
        wave_stun(o, int(30 * scale))
        rings.push(Ring(o.body.top(), ap.Color(255, 230, 120), 2, 0.5, true))
    else if k == 10 do
        wave_hurt(o, f, 3, "OOPS", tint)
    end
    for i in 0..<6 do
        streak(at, unit(scatter(1)) * 4, tint if i % 2 == 0 else ap.WHITE, 0.2, 0.3)
    end
end

# THE LAST LAUGH: whatever anyone does, it comes out a little wrong.
const string[] TWIST_NAMES = ["HEAVY", "FEATHERWEIGHT", "QUICK", "SLUGGISH", "BOUNCY", "AIRBORNE", "TOXIC", "MAGNETIC",
    "SNEAKY", "DOUBLE"]
function twist_move(Fighter f, roster.Attack a) returns roster.Attack
    var b = roster.copy(a)
    var k = pick_index(TWIST_NAMES.length)
    if mech(f) == roster.MECH_ZERO and ap.chance(0.5) do
        # The house favours its clown: a second roll, the better of the two.
        var j = pick_index(TWIST_NAMES.length)
        if j == 0 or j == 2 or j == 5 or j == 8 or j == 9 do
            k = j
        end
    end
    if k == 0 do
        b.damage *= 2
    else if k == 1 do
        b.damage *= 0.5
    else if k == 2 do
        b.startup = math.max(b.startup // 2, 2)
    else if k == 3 do
        b.startup = int(double(b.startup) * 1.6)
    else if k == 4 do
        b.push *= 3
    else if k == 5 do
        b.launch = math.max(b.launch, 8.0)
    else if k == 6 do
        b.poison += 3
    else if k == 7 do
        b.push = -math.abs(b.push) - 4
    else if k == 8 do
        b.unblockable = true
    else if k == 9 do
        b.hits *= 2
        b.interval = math.max(b.interval, 5)
    end
    say(f.body.top() + ap.Vec3(0, 0.4, 0), TWIST_NAMES[k], ap.Color(255, 120, 200))
    return b
end

# --- WARDEN: the chain ---------------------------------------------------------------------------
function tick_chain(Fighter f)
    var dt = 1.0 / 60
    if f.chained <= 0 do
        return
    end
    f.chained -= dt
    f.chain_cool = math.max(f.chain_cool - 1, 0)
    var off = flat(f.body.position - f.anchor)
    if off.length() > CHAIN_REACH do
        # Pulling at the chain: it pulls back.
        var back = f.anchor + unit(off) * CHAIN_REACH
        f.body.position = ap.Vec3(back.x, f.body.position.y, back.z)
        f.knock = ap.Vec3(0, 0, 0)
        if f.chain_cool == 0 do
            escape_attempt(f)
        end
    end
end
function escape_attempt(Fighter f)
    var by = fighters[1 - f.id]
    f.chain_cool = 30
    wave_hurt(by, f, 6, "ESCAPE ATTEMPT", ap.Color(230, 80, 60))
    wave_stun(f, 22)
    f.knock = unit(flat(f.anchor - f.body.position)) * 6
    by.bar = math.min(by.bar + 15, by.kit.bar_max)
    sound_at(snd_lock, f.body.position, 0.7, 0.6)
    later(snd_thud, f.body.position, 3, 0.5, 0.8)
end

# --- ORACLE: the cards ---------------------------------------------------------------------------
const string[] TAROT = ["THE FOOL", "THE MAGICIAN", "THE HIGH PRIESTESS", "THE EMPRESS", "THE EMPEROR", "THE HIEROPHANT",
    "THE LOVERS", "THE CHARIOT", "STRENGTH", "THE HERMIT", "WHEEL OF FORTUNE", "JUSTICE", "THE HANGED MAN", "DEATH",
    "TEMPERANCE", "THE DEVIL", "THE TOWER", "THE STAR", "THE MOON", "THE SUN", "JUDGEMENT", "THE WORLD"]
const string[] NUMERALS = ["0", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII", "XIII", "XIV",
    "XV", "XVI", "XVII", "XVIII", "XIX", "XX", "XXI"]
function card_mult(int n) returns double
    if n == 21 do
        return 2.2
    else if n == 16 do
        return 1.7
    end
    return 0.5 + double(n) * 0.07
end
function draw_card(Fighter f)
    var n = pick_index(22)
    if own_super(f, roster.MECH_ORACLE) do
        # Inside her own super, fate leans her way: the best of three.
        n = math.max(n, math.max(pick_index(22), pick_index(22)))
    end
    f.card = n
end

# --- MAESTRO: the beat ---------------------------------------------------------------------------
# Ticks from the nearest beat (0 is on it).
function beat_off(Fighter f) returns int
    var at = f.round_ticks % BEAT
    return math.min(at, BEAT - at)
end

# --- FLASQUE: coins and potions ------------------------------------------------------------------
const int SP_DRINK = 90              # FLASQUE's brace, left alone: the potion is drunk instead
const ap.Color[] POTION_COLORS = [ap.Color(200, 200, 200), ap.Color(130, 230, 60), ap.Color(255, 120, 40),
    ap.Color(140, 210, 255), ap.Color(255, 230, 80)]

function potion_throw(int potion) returns roster.Attack
    var a = roster.fire("{roster.POTION_NAMES[potion]} Potion", 5, 9, 16, roster.SHOT_POTION, 15, 16, 2, roster.ANIM_THROW)
    a.lob = true
    a.blast = 1.7
    a.potion = potion
    return a
end
roster.Attack[] potion_moves = [potion_throw(1), potion_throw(1), potion_throw(2), potion_throw(3), potion_throw(4)]
function potion_move(int potion) returns roster.Attack
    return potion_moves[potion]
end
function brace_move() returns roster.Attack
    var a = roster.wave_trick("Brace", SP_DRINK, roster.ANIM_COUNTER)
    a.startup = 45
    a.recovery = 14
    a.counter = true
    return a
end
var brace = brace_move()

# What a potion does to whoever it splashes: `strength` 2 for the stronger dose a brace throws back.
function potion_effect(Fighter by, Fighter o, int potion, double strength)
    var at = o.body.center()
    var tint = POTION_COLORS[potion]
    sound_at(snd_splash, at, 0.6, 1.2)
    burst(at, 14, tint, 4, 0.4, 0.08)
    if potion == roster.POTION_VENOM do
        o.poison = math.min(o.poison + 5 * strength, roster.POISON_LIMIT)
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "VENOM", tint)
    else if potion == roster.POTION_FIRE do
        wave_hurt(by, o, 6 * strength, "BURN", tint)
        o.burning = math.max(o.burning, 2.5 * strength)
    else if potion == roster.POTION_FROST do
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "FROZEN", tint)
        wave_stun(o, int(50 * strength))
        o.slow = math.max(o.slow, 2.5 * strength)
    else if potion == roster.POTION_THUNDER do
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "SHOCKED", tint)
        wave_stun(o, int(35 * strength))
        o.bar = math.max(o.bar - o.kit.bar_max * 0.25 * strength, 0.0)
        for i in 0..<8 do
            streak(at, unit(scatter(1)) * 6, tint, 0.15, 0.5)
        end
        sound_at(snd_zap_file, at, 0.6)
    end
end

# A brace that nobody hit: the potion goes down instead.
function drink(Fighter f)
    var p = f.potion
    if p == 0 do
        return
    end
    f.potion = 0
    f.drink_kind = p
    f.drink = 6
    var tint = POTION_COLORS[p]
    sound_at(snd_heal, f.body.position, 0.5, 0.8)
    later(snd_splash, f.body.position, 4, 0.3, 1.6)
    rings.push(Ring(f.body.center(), tint, 3, 0.3, true))
    if p == roster.POTION_VENOM do
        say(f.body.top(), "VENOM BLOOD", tint)
    else if p == roster.POTION_FIRE do
        say(f.body.top(), "FIREBRAND", tint)
    else if p == roster.POTION_FROST do
        f.buff = roster.BUFF_GUARD
        f.buff_time = 4
        say(f.body.top(), "ICE SKIN", tint)
    else if p == roster.POTION_THUNDER do
        f.buff = roster.BUFF_HASTE
        f.buff_time = 5
        say(f.body.top(), "LIGHTNING LEGS", tint)
    end
end

# A coin, somewhere on the floor not too close to anyone.
function free_spot(double margin) returns ap.Vec3
    var best = ap.Vec3(0, 0, 0)
    for tries in 0..<12 do
        var spot = forward_of(ap.random(0, 360)) * ap.random(1, ARENA - margin)
        spot = flat(spot)
        if world.overlaps(spot + ap.Vec3(0, 0.6, 0), 0.5) do
            continue
        end
        var near = false
        for g in everyone() do
            if flat_distance(g.body.position, spot) < 2 do
                near = true
            end
        end
        best = spot
        if not near do
            break
        end
    end
    return best
end

function has_flasque() returns int
    for g in everyone() do
        if mech(g) == roster.MECH_FLASQUE and g.state != STATE_DOWN do
            return g.id
        end
    end
    return -1
end

# --- SCARECROW, HUNTER: props of their own ------------------------------------------------------
const int PROP_TREE = 2              # HUNTER's forest: a trunk to hide behind

# --- The hooks ----------------------------------------------------------------------------------

# Every fighter's second-wave state, back to nothing at the start of a round.
function wave_reset(Fighter f)
    f.ailments = [0.0, 0.0, 0.0]
    f.necrosis = 0
    f.chained = 0
    f.chain_cool = 0
    f.punched = false
    f.omens = [0.0, 0.0, 0.0, 0.0]
    f.locks = [0, 0, 0, 0]
    f.last_skill = -1
    f.coffin = 0
    f.drag = 0
    f.bite_cool = 0
    f.under = false
    f.dive = 0
    f.aggro = 0
    f.burning = 0
    f.drink = 0
    f.charge = 0
    f.streak = 0
    f.move_mult = 1
    f.round_hurt = 0
    f.history = []
    f.swap_cool = 0
    f.produce = [0, 0, 0, 0]
    if mech(f) == roster.MECH_ORACLE do
        draw_card(f)
    end
    if mech(f) == roster.MECH_HOLLOW do
        shed_to(f, 0, false)
    end
    if mech(f) == roster.MECH_STRONGMAN do
        f.bar = 0
    end
end

# HOLLOW's forms: how fast, how tough, how big, and with what, as the armor comes off.
const double[] HOLLOW_SPEED = [4.4, 5.1, 5.8, 6.5]
const int SHED_TICKS = 20 * 60           # HOLLOW sheds a piece of armor after this long in one form
const int REFORGE_TICKS = 36             # in LAST STAND, the wind-up of putting the whole fortress back on
const double[] HOLLOW_ARMOR = [0.5, 0.9, 1.4, 2.0]     # damage taken, FORTRESS..HOLLOW
const double[] HOLLOW_BULK = [1.25, 1.14, 1.02, 0.92]
function shed_to(Fighter f, int form, bool show)
    var kit = f.kit
    equip(f, form)
    kit.speed = HOLLOW_SPEED[form]
    kit.armor = HOLLOW_ARMOR[form]
    kit.look.bulk = HOLLOW_BULK[form]
    kit.look.head = roster.HEAD_HOLLOW if form == 0 else roster.HEAD_WISP
    kit.look.body = ap.Color(110, 114, 120) if form < 2 else ap.Color(60, 62, 72)
    kit.look.cape = form < 3
    f.body.radius = 0.36 * kit.look.bulk
    f.bar = double(3 - form)
    f.form_ticks = 0
    set_shed_move(f)
    if show do
        var here = f.body.position
        say(f.body.top() + ap.Vec3(0, 0.3, 0), kit.arsenal[form].name, kit.look.accent)
        sound_at(snd_block, here, 0.8, 0.6)
        later(snd_thud, here, 5, 0.7, 0.8)
        later(snd_creak, here, 10, 0.5, 0.7)
        for i in 0..<5 do
            # The plate falls off and rings on the stone.
            spark(f.body.center() + scatter(0.3), ap.Vec3(ap.random(-2, 2), ap.random(1, 3), ap.random(-2, 2)),
                ap.Color(150, 154, 160), 1.2, 0.22, 9)
        end
        rings.push(Ring(here + ap.Vec3(0, 0.1, 0), kit.look.accent, 5, 0.35))
    end
end

# Whether a fighter is somewhere nothing can reach: sealed, swimming, up in the sun.
function wave_untouchable(Fighter o) returns bool
    return o.coffin != 0 or o.under or o.dive > 0
end

# On a rail of their own side's.
function on_track(Fighter f) returns bool
    for t in things do
        if t.kind == TH_TRACK and t.owner == f.id and not t.gone and f.body.position.y < 0.6 do
            if off_line(flat(f.body.position), t.position, t.aim) < 0.8 do
                return true
            end
        end
    end
    return false
end

# Standing in a pool of HAMMERHEAD's (side `side`'s).
function in_pool(Fighter f, int side) returns bool
    if f.body.position.y > 0.6 do
        return false
    end
    for t in things do
        if t.kind == TH_POOL and t.owner == side and not t.gone and flat_distance(f.body.position, t.position) < t.value do
            return true
        end
    end
    return false
end

function wave_pace(Fighter f) returns double
    var pace = 1.0
    if mech(f) == roster.MECH_CONDUCTOR and on_track(f) do
        pace *= 1.6
    end
    if mech(f) == roster.MECH_HAMMERHEAD and in_pool(f, f.id) do
        pace *= 1.25
    end
    if f.state == STATE_ATTACK and f.charge > 0 do
        pace *= 0.4
    end
    return pace
end

# What a fighter means to do, bent to their mechanic: FLASQUE's F is a brace while holding a potion.
function wave_intent(Fighter f, Fighter o, Intent want)
    if mech(f) == roster.MECH_FLASQUE and f.potion > 0 and want.block and f.state == STATE_IDLE and phase == PHASE_FIGHT do
        want.block = false
        used(f, "block")
        begin_attack(f, brace, 1)
        f.slot = SLOT_BASIC
        f.chain = 0
        say(f.body.top(), "BRACE", POTION_COLORS[f.potion])
    end
    if f.dive > 0 or f.coffin != 0 or f.drag > 0 or holding_under(f) do
        # Up in the sun, nailed in a coffin, held under (or HAMMERHEAD holding them there):
        # the controls do nothing.
        if f.dive == 0 do
            want.wish = ap.Vec3(0, 0, 0)
        end
        want.basic = false
        want.skill = 0
        want.block = false
        want.dash = false
        want.ultimate = false
    end
end

# Every tick of a fighter who is up, before they move.
# HOLLOW's fourth skill. Shedding: a countdown outside LAST STAND (the armor comes off on its own),
# a form change in it. Last Breath once all the armor is gone, except in LAST STAND, where 4
# there puts the whole fortress back on after a moment.
function set_shed_move(Fighter f)
    var kit = f.kit
    var lasting = own_super(f, roster.MECH_HOLLOW)
    if f.arm == 3 and not lasting do
        kit.skills[3] = roster.last_breath()
        return
    end
    kit.skills[3] = roster.wave_trick("Shedding", roster.SP_SHED, roster.ANIM_FOCUS)
    kit.skills[3].note = "The armor falls off by itself as the round goes on"
    if lasting do
        kit.skills[3].note = "All the armor back on" if f.arm == 3 else "The next piece off"
        kit.skills[3].startup = REFORGE_TICKS if f.arm == 3 else 8
        kit.skills[3].recovery = 10
    end
end

# HOLLOW's armor: a piece falls off every SHED_TICKS of the round (in LAST STAND, one grows back
# instead: see the super's tick). Skill 4 counts down to it.
function hollow_tick(Fighter f)
    if mech(f) != roster.MECH_HOLLOW or f.minion do
        return
    end
    if own_super(f, roster.MECH_HOLLOW) do
        # (Set again in case the super began while its cutscene was still on.)
        if f.kit.skills[3].special != roster.SP_SHED or f.kit.skills[3].startup != (REFORGE_TICKS if f.arm == 3 else 8) do
            set_shed_move(f)
        end
        f.cooldowns[3] = 0
        return
    end
    if f.arm >= 3 do
        return
    end
    f.form_ticks += 1
    f.cooldowns[3] = math.max(SHED_TICKS - f.form_ticks, 1)
    if f.form_ticks >= SHED_TICKS do
        shed_to(f, f.arm + 1, true)
        if f.arm == 3 do
            f.cooldowns[3] = 0
        end
    end
end

function wave_tick(Fighter f, Fighter o)
    var dt = 1.0 / 60
    hollow_tick(f)
    f.bite_cool = math.max(f.bite_cool - 1, 0)
    tick_ailments(f)
    tick_chain(f)
    f.burning = math.max(f.burning - dt, 0.0)
    if f.burning > 0 do
        f.health -= 2.5 * dt
        if ap.chance(0.3) do
            spark(f.body.position + scatter(0.4) + ap.Vec3(0, ap.random(0.2, 1.6), 0), ap.Vec3(0, ap.random(1, 2), 0),
                ap.Color(255, 140, 50), 0.4, 0.08, -1)
        end
    end
    f.drink = math.max(f.drink - dt, 0.0)
    f.swap_cool = math.max(f.swap_cool - 1, 0)
    for i in 0..<4 do
        f.locks[i] = math.max(f.locks[i] - 1, 0)
    end
    # RAVEN's omens on them. The letter is a clock: at zero it is delivered.
    for k in 0..<3 do
        f.omens[k] = math.max(f.omens[k] - dt, 0.0)
    end
    if f.omens[3] > 0 do
        f.omens[3] -= dt
        if f.omens[3] <= 0 do
            f.omens[3] = 0
            deliver_letter(f, 1)
        end
    end
    if f.history.length == 0 or f.round_ticks % 30 == 0 do
        f.history.push(f.health)
        if f.history.length > 16 do
            f.history.remove_at(0)
        end
    end
    var m = mech(f)
    if f.minion do
        return
    end
    if m == roster.MECH_HUNTER do
        # Watching them closely is half the job.
        if o.fade > 0.5 and o.state != STATE_DOWN and flat_distance(f.body.position, o.body.position) < 14 and
                ap.in_cone(f.body.position, forward_of(f.heading), o.body.position, 120) do
            var before = f.bar
            f.bar = math.min(f.bar + STUDY_WATCH * dt, f.kit.bar_max)
            for need in [25.0, 50.0, 80.0] do
                if before < need and f.bar >= need do
                    say(f.body.top(), "STUDIED: {int(need)}", f.kit.look.accent)
                    sound_at(snd_book, f.body.position, 0.5, 1.2)
                end
            end
        end
    else if m == roster.MECH_MAESTRO do
        if f.round_ticks % BEAT == 0 and phase == PHASE_FIGHT do
            # The metronome: soft on the beat, louder on the bar's first.
            var down = (f.round_ticks // BEAT) % 4 == 0
            sound_at(snd_lock, f.body.position, 0.18 if down else 0.1, 2.2 if down else 2.8)
            rings.push(Ring(f.body.position + ap.Vec3(0, 0.06, 0), f.kit.look.accent.fade(0.6), 3 if down else 2, 0.25))
        end
    else if m == roster.MECH_STRONGMAN do
        hold_charge(f)
    end
end

# STRONGMAN: a move held back at the top of its wind-up gathers strength.
function hold_charge(Fighter f)
    if f.state != STATE_ATTACK or f.move.kind != roster.KIND_STRIKE or f.slot == SLOT_SUPER do
        return
    end
    if f.frame != f.move.startup - 1 or f.charge >= 1 do
        return
    end
    var held = false
    if f.cpu do
        held = f.charge < f.charge_goal
    else if f.slot == SLOT_BASIC do
        held = pad.held("basic")
    else do
        held = pad.held("skill{f.slot + 1}")
    end
    if not held do
        return
    end
    f.frame -= 1
    f.charge = math.min(f.charge + 1.0 / 80, 1.0)
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    if f.round_ticks % 4 == 0 do
        gather(hand, 3, f.kit.look.accent, 0.8, 0.18, 0.06)
    end
    if f.charge >= 1 do
        say(f.body.top(), "FULL STRENGTH", f.kit.look.accent)
        sound_at(snd_charge, hand, 0.6, 0.8)
        rings.push(Ring(f.body.position + ap.Vec3(0, 0.08, 0), f.kit.look.accent, 4, 0.3))
    else if f.round_ticks % 20 == 0 do
        sound_at(snd_creak, hand, 0.3, 0.7 + f.charge)
    end
end

# After a fighter has moved: the places that hold them where they are.
function wave_after(Fighter f, Fighter o)
    var body = f.body
    if f.coffin != 0 do
        body.position = ap.Vec3(f.coffin_at.x, body.position.y if f.coffin_air else 0.0, f.coffin_at.z)
        if f.coffin_air do
            # Nailed shut in the air, and coming down hard.
            body.velocity = ap.Vec3(0, body.velocity.y, 0)
            if body.grounded or body.position.y < 0.05 do
                f.coffin_air = false
                var by = fighters[1 - f.id]
                f.coffin_drop = true
                wave_hurt(by, f, 15, "FALL", ap.Color(140, 220, 200))
                sound_at(snd_thud, body.position, 0.9, 0.6)
                later(snd_creak, body.position, 4, 0.6, 0.8)
                smoke(body.position + ap.Vec3(0, 0.2, 0), 10, 0.6, 1.0)
            end
        else do
            body.velocity = ap.Vec3(0, 0, 0)
        end
        f.state = STATE_HURT
        f.stun = math.max(f.stun, 2)
        f.fade = 0
        if f.coffin > 0 do
            f.coffin -= 1
            if f.coffin == 0 do
                open_coffin(f)
            end
        end
    end
    if holding_under(f) do
        body.velocity = ap.Vec3(0, body.velocity.y, 0)
        f.knock = ap.Vec3(0, 0, 0)
    end
    if f.drag > 0 do
        body.position = ap.Vec3(f.coffin_at.x, 0, f.coffin_at.z)
        body.velocity = ap.Vec3(0, 0, 0)
        f.state = STATE_HURT
        f.stun = math.max(f.stun, 2)
    end
    var warden = wave_super_user(roster.MECH_WARDEN)
    if warden != null and max_cut == 0 do
        var w = warden as Fighter
        var off = flat(body.position - cage_at)
        if f.id != w.id and off.length() > CAGE_RADIUS - 0.45 do
            var back = cage_at + unit(off) * (CAGE_RADIUS - 0.45)
            body.position = ap.Vec3(back.x, body.position.y, back.z)
        else if f.id == w.id and off.length() < CAGE_RADIUS + 0.5 do
            var way = unit(off) if off.length() > 0.05 else forward_of(f.heading) * -1.0
            var out = cage_at + way * (CAGE_RADIUS + 0.5)
            body.position = ap.Vec3(out.x, body.position.y, out.z)
        end
    end
    if wave_super(roster.MECH_CONDUCTOR) and max_cut == 0 do
        # The aisle of the carriage: a meter and a half either side.
        var across = ap.Vec3(train_axis.z, 0, -train_axis.x)
        var side = dot3(flat(body.position), across)
        var along = dot3(flat(body.position), train_axis)
        side = math.clamp(side, -1.3, 1.3)
        along = math.clamp(along, -(ARENA - 1), ARENA - 1)
        var p = across * side + train_axis * along
        body.position = ap.Vec3(p.x, body.position.y, p.z)
    end
    if mech(f) == roster.MECH_HUNTER and f.state == STATE_ATTACK and f.move.special == roster.SP_GOLDEN do
        if f.hits_done == 0 do
            aim_golden(f, o)
        else if own_super(f, roster.MECH_HUNTER) do
            # Hit or missed, it was the only one.
            end_own_super(f)
        end
    end
    if f.dive > 0 do
        update_dive(f, o)
    end
    if f.under do
        f.fade = 1 if f.state == STATE_ATTACK and f.slot == SLOT_BASIC else 0
    end
end

# A move asked for: whether a mechanic answers instead. 1 began something, 0 refused, -1 carry on.
function wave_start(Fighter f, Fighter o, int slot, int chain) returns int
    var kit = f.kit
    var m = mech(f)
    if slot >= 0 and slot < SLOT_SUPER do
        if f.locks[slot] > 0 do
            deny(f, "LOCKED {(f.locks[slot] + 59) // 60}s")
            return 0
        end
        var a = kit.skills[slot]
        if a.need > 0 and f.bar < a.need do
            deny(f, "{kit.bar_name} {int(a.need)}")
            return 0
        end
        if a.kind == roster.KIND_QUIVER and f.arrows >= kit.quiver do
            deny(f, "ARROW READY" if kit.quiver == 1 else "QUIVER FULL")
            return 0
        end
    end
    var shooting = kit.skills[slot] if slot >= 0 and slot < SLOT_SUPER else (kit.basics[chain] if slot == SLOT_BASIC else kit.ultimate)
    if slot != SLOT_SUPER and out_of_arrows(f, shooting) do
        deny(f, "NO ARROW: PULL ONE")
        return 0
    end
    if f.minion do
        return -1
    end
    if own_super(f, roster.MECH_HUNTER) and slot != SLOT_SUPER do
        deny(f, "YOU ARE HIDDEN")
        return 0
    end
    if own_super(f, roster.MECH_HAMMERHEAD) do
        if slot == SLOT_BASIC and f.bite_cool > 0 do
            deny(f, "BITE")
            return 0
        else if slot == SLOT_BASIC do
            f.bite_cool = attack_length(shark_bite, 1) + SHARK_COOLDOWN   # counted from the end of the bite
            begin_attack(f, shark_bite, 1)
            f.slot = SLOT_BASIC
            f.chain = 0
            return 1
        else if slot >= 0 and slot < SLOT_SUPER do
            deny(f, "UNDER THE WATER")
            return 0
        end
    end
    if m == roster.MECH_FLASQUE do
        if slot == SLOT_BASIC and f.potion > 0 do
            begin_attack(f, potion_move(f.potion), 1)
            f.slot = SLOT_BASIC
            f.chain = 0
            f.potion = 0
            return 1
        end
        if slot >= 0 and slot < SLOT_SUPER and own_super(f, roster.MECH_FLASQUE) do
            # Inside the Great Work the moves set what brews.
            f.produce[slot] = 1 - f.produce[slot]
            say(f.body.top(), "{roster.POTION_NAMES[slot + 1]} {"ON" if f.produce[slot] == 1 else "OFF"}", POTION_COLORS[slot + 1])
            sound_at(snd_lock, f.body.position, 0.4, 1.4)
            return 1
        end
        if slot >= 0 and slot < SLOT_SUPER do
            var price = double(kit.skills[slot].potion)
            if f.potion > 0 do
                deny(f, "HANDS FULL")
                return 0
            end
            if f.bar + 0.001 < price do
                deny(f, "{int(price)} COINS")
                return 0
            end
            return -1
        end
        if slot == SLOT_SUPER and not in_super(f) do
            if f.bar < kit.bar_max do
                deny(f, "{int(kit.bar_max)} COINS")
                return 0
            end
            if max_cut > 0 or max_owner >= 0 do
                deny(f, "A SUPER IS ON")
                return 0
            end
            begin_maximum(f)
            return 1
        end
    end
    if slot == SLOT_SUPER and in_super(f) and max_cut == 0 and kit.maximum.repeat_g do
        if f.swap_cool > 0 do
            return 0
        end
        begin_attack(f, kit.ultimate, 1)
        f.slot = SLOT_SUPER
        f.chain = 0
        return 1
    end
    return -1
end

# A move has been chosen and begun (f.move, f.slot): what the mechanics make of it.
function wave_started(Fighter f, int slot)
    var o = foe_of(f)
    var a = f.move
    var m = mech(f)
    if slot >= 0 and slot < SLOT_SUPER do
        f.last_skill = slot
    end
    f.move_mult = 1
    f.charge = 0
    if wave_super(roster.MECH_RAVEN) do
        f.aggro += 0.3
    end
    if wave_super(roster.MECH_ZERO) and a.kind == roster.KIND_STRIKE and not f.minion do
        f.move = twist_move(f, a)
        if f.move.hits != a.hits do
            f.move_hits = f.move_hits * f.move.hits // math.max(a.hits, 1)
        end
        a = f.move
    end
    if m == roster.MECH_ORACLE and not (a.kind == roster.KIND_WAVE and a.special == roster.SP_RESHUFFLE) and not f.minion do
        var n = f.card
        if slot == SLOT_SUPER do
            n = 21
        end
        f.move_mult = card_mult(n)
        say(f.body.top() + ap.Vec3(0, 0.35, 0), "{NUMERALS[n]} {TAROT[n]}", ap.Color(255, 230, 160) if n >= 11 else ap.Color(170, 150, 200))
        sound_at(snd_card, f.body.position, 0.5, 0.8 + double(n) * 0.03)
        if n == 0 and slot >= 0 and slot < SLOT_SUPER do
            f.cooldowns[slot] = 0
        else if n == 16 do
            wave_hurt(f, f, 5, "THE TOWER", ap.Color(255, 140, 90))
        end
        f.move_card = n
        draw_card(f)
    end
    if m == roster.MECH_MAESTRO and not f.minion do
        if beat_off(f) <= BEAT_WINDOW do
            f.streak = math.min(f.streak + 1, 5)
            f.move_mult = 1.3 + 0.1 * double(f.streak)
            say(f.body.top() + ap.Vec3(0, 0.35, 0), "ON THE BEAT x{f.streak}", f.kit.look.accent)
            sound_at(snd_shimmer, f.body.position, 0.4, 1.0 + 0.1 * double(f.streak))
        else do
            if f.streak > 0 do
                say(f.body.top() + ap.Vec3(0, 0.35, 0), "OFF THE BEAT", ap.GRAY)
            end
            f.streak = 0
            f.move_mult = 0.8
        end
    end
    if m == roster.MECH_STRONGMAN and f.cpu do
        f.charge_goal = ap.random(0, 1.2) if a.kind == roster.KIND_STRIKE else 0.0
    end
    if m == roster.MECH_CONDUCTOR and on_track(f) and a.kind == roster.KIND_STRIKE do
        # On the rails: the wind-up is mostly skipped.
        f.frame = int(double(a.startup) * 0.35)
        if a.lunge > 0 do
            f.move = roster.copy(a)
            f.move.lunge = a.lunge * 1.6
        end
        streak(f.body.position + ap.Vec3(0, 0.3, 0), forward_of(f.heading) * 8, f.kit.look.accent, 0.2, 0.6)
    end
end

# Whether `f` may take damage-dealing of this kind into account: the move under way.
function current_move(Fighter f, roster.Attack a, bool melee) returns bool
    return a == f.move and (melee or a.beam > 0)
end

# The second wave's say on how much a hit does: the attacker's side and the victim's.
function wave_damage(Fighter f, Fighter o, roster.Attack a, double damage, bool melee) returns double
    var d = damage
    var m = mech(f)
    if current_move(f, a, melee) do
        d *= f.move_mult
    end
    if m == roster.MECH_STRONGMAN do
        d *= 1 + 0.07 * f.bar
        if a == f.move do
            d *= 1 + 1.2 * f.charge
        end
    else if m == roster.MECH_CONDUCTOR do
        if on_track(f) do
            d *= 1.25
        end
        if o.punched and a.special != roster.SP_TICKET do
            o.punched = false
            d *= 1.6
            say(o.body.top() + ap.Vec3(0, 0.45, 0), "TICKET PUNCHED", f.kit.look.accent)
            sound_at(snd_lock, o.body.position, 0.6, 1.7)
        end
    else if m == roster.MECH_HAMMERHEAD and in_pool(f, f.id) do
        d *= 1.3
    else if m == roster.MECH_WARDEN and a.special == roster.SP_SENTENCE and o.chained > 0 do
        d *= 1.6
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "SENTENCED", f.kit.look.accent)
    else if m == roster.MECH_DEATH and a.special == roster.SP_AMPUTATE do
        d += 9 * double(ailment_count(o))
    else if m == roster.MECH_FLASQUE and f.drink > 0 and f.drink_kind == roster.POTION_FIRE do
        d *= 1.3
    end
    if o.ailments[AIL_FEVER] > 0 do
        d *= 1.2
    end
    if o.necrosis > 0 do
        d *= 1.35
    end
    if mech(o) == roster.MECH_STRONGMAN do
        d *= 1 - 0.04 * o.bar
        if o.state == STATE_ATTACK and o.charge > 0 do
            d *= 0.5
        end
    end
    return d
end

# A block about to stop a hit: RAVEN's Omen of Fear breaks it instead.
function wave_guard(Fighter f, Fighter o, bool guarding) returns bool
    if guarding and o.omens[2] > 0 do
        o.omens[2] = 0
        var by = fighters[1 - o.id]
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "OMEN OF FEAR", ap.Color(160, 120, 255))
        wave_hurt(by, o, 10, "", ap.Color(160, 120, 255))
        sound_at(snd_ambush, o.body.position, 0.6, 0.8)
        return false
    end
    return guarding
end

# `o` parried `f`. True when a mechanic took the answer over (the counter's own follow-up is skipped).
function wave_parry(Fighter f, Fighter o, bool waiting, bool melee) returns bool
    if mech(o) == roster.MECH_FLASQUE and waiting and o.move == brace and o.potion > 0 do
        # Struck while bracing: the attacker wears the whole flask, twice as strong.
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "SPLASH BACK", POTION_COLORS[o.potion])
        potion_effect(o, f, o.potion, 2.0)
        o.potion = 0
        o.state = STATE_IDLE
        o.frame = 0
        return true
    end
    if own_super(o, roster.MECH_HOLLOW) do
        # LAST STAND: every parry is answered by the fortress.
        wave_hurt(o, f, 18 * roster.HOLLOW_DAMAGE, "RIPOSTE", o.kit.look.accent)
        wave_stun(f, 50)
        sound_at(snd_heavy, f.body.position, 0.8, 0.7)
        rings.push(Ring(f.body.center(), o.kit.look.accent, 6, 0.25, true))
    end
    return false
end

# A hit has landed clean (not blocked): what it sets off for the second wave.
function wave_lands(Fighter f, Fighter o, roster.Attack a, double damage, bool melee, bool basic)
    var m = mech(f)
    var sp = a.special
    if f.omens[1] > 0 and not f.minion do
        # Omen of Greed: the hit is paid for.
        f.omens[1] = 0
        say(f.body.top() + ap.Vec3(0, 0.45, 0), "OMEN OF GREED", ap.Color(160, 120, 255))
        wave_hurt(o, f, 12, "", ap.Color(160, 120, 255))
        sound_at(snd_coin_drop, f.body.position, 0.5, 0.7)
    end
    if sp == roster.SP_ROT do
        add_ailment(f, o, AIL_ROT, 6)
    else if sp == roster.SP_FEVER do
        add_ailment(f, o, AIL_FEVER, 6)
    else if sp == roster.SP_PALSY do
        add_ailment(f, o, AIL_PALSY, 6)
    else if sp == roster.SP_AMPUTATE do
        if ailment_count(o) > 0 do
            say(o.body.top() + ap.Vec3(0, 0.45, 0), "CURED", f.kit.look.accent)
        end
        o.ailments = [0.0, 0.0, 0.0]
    else if sp == roster.SP_DIAGNOSIS do
        add_ailment(f, o, AIL_ROT, 6)
        add_ailment(f, o, AIL_FEVER, 6)
        add_ailment(f, o, AIL_PALSY, 6)
    else if sp == roster.SP_SHACKLE do
        o.chained = 6
        o.anchor = flat(o.body.position)
        o.chain_cool = 20
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "SHACKLED", f.kit.look.accent)
        sound_at(snd_lock, o.body.position, 0.8, 0.7)
        later(snd_lock, o.body.position, 6, 0.6, 0.9)
    else if sp == roster.SP_DRAG and o.chained > 0 do
        o.anchor = flat(f.body.position + forward_of(f.heading) * 1.2)
        wave_stun(o, 45)
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "TO THE BLOCK", f.kit.look.accent)
    else if sp == roster.SP_TICKET do
        o.punched = true
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "PUNCHED", f.kit.look.accent)
        sound_at(snd_lock, o.body.position, 0.6, 2.0)
    else if sp == roster.SP_RIPTIDE do
        add_pool(f, f.body.position, 2.0, 8)
    else if sp >= roster.SP_OMEN_HASTE and sp <= roster.SP_OMEN_LETTER do
        var k = sp - roster.SP_OMEN_HASTE
        o.omens[k] = 6 if k == 3 else 10.0
        var names = ["OMEN OF HASTE", "OMEN OF GREED", "OMEN OF FEAR", "A LETTER FOR YOU"]
        say(o.body.top() + ap.Vec3(0, 0.45, 0), names[k], f.kit.look.accent)
        sound_at(snd_wisp, o.body.position, 0.5, 0.7)
    end
    if m == roster.MECH_ZERO and not f.minion do
        if sp == roster.SP_JOKER do
            wild_effect(f, o, 2)
        else if sp == roster.SP_PUNCHLINE or ap.chance(0.35) do
            wild_effect(f, o, 1)
        end
    else if m == roster.MECH_HUNTER and not f.minion do
        f.bar = math.min(f.bar + STUDY_HIT, f.kit.bar_max)
    else if m == roster.MECH_FLASQUE do
        if a.potion > 0 do
            potion_effect(f, o, a.potion, 1)
        else if a.shot == roster.SHOT_POTION and ap.chance(0.3) do
            # The launcher's own mix: a little of something, briefly.
            var k = 1 + pick_index(4)
            var tint = POTION_COLORS[k]
            say(o.body.top() + ap.Vec3(0, 0.45, 0), roster.POTION_NAMES[k], tint)
            if k == 1 do
                o.poison = math.min(o.poison + 1.5, roster.POISON_LIMIT)
            else if k == 2 do
                o.burning = math.max(o.burning, 1.0)
            else if k == 3 do
                o.slow = math.max(o.slow, 1.5)
            else do
                wave_stun(o, 20)
            end
        end
        if f.drink > 0 and f.drink_kind == roster.POTION_VENOM do
            o.poison = math.min(o.poison + 2, roster.POISON_LIMIT)
        end
    else if m == roster.MECH_ORACLE and f.move_card == 13 and a == f.move and o.state == STATE_HURT do
        # DEATH: the card, not the fighter. Held twice as long.
        o.stun *= 2
        o.stun_total = o.stun
    else if m == roster.MECH_STRONGMAN and a == f.move and f.charge > 0 do
        o.knock = o.knock * (1 + 2 * f.charge)
    end
end

# The dash button: RAVEN's Omen of Haste and WARDEN's chain both have something to say.
function wave_dashed(Fighter f) returns bool
    if wave_super(roster.MECH_RAVEN) do
        f.aggro += 0.3
    end
    if f.omens[0] > 0 do
        f.omens[0] = 0
        var by = fighters[1 - f.id]
        say(f.body.top() + ap.Vec3(0, 0.45, 0), "OMEN OF HASTE", ap.Color(160, 120, 255))
        wave_hurt(by, f, 14, "", ap.Color(160, 120, 255))
        wave_stun(f, 30)
        sound_at(snd_ambush, f.body.position, 0.6, 1.1)
        return false
    end
    if f.chained > 0 do
        escape_attempt(f)
        return false
    end
    return true
end

# Omens' letter, delivered (doubled by NEVERMORE).
function deliver_letter(Fighter f, double scale)
    var by = fighters[1 - f.id]
    say(f.body.top() + ap.Vec3(0, 0.45, 0), "DELIVERED", ap.Color(160, 120, 255))
    wave_hurt(by, f, 18 * scale, "", ap.Color(160, 120, 255))
    sound_at(snd_book, f.body.position, 0.6, 0.7)
    later(snd_ambush, f.body.position, 4, 0.5, 0.8)
    for i in 0..<12 do
        streak(f.body.top() + scatter(0.4), ap.Vec3(ap.random(-2, 2), ap.random(-4, -1), ap.random(-2, 2)), ap.Color(30, 28, 38), 0.4, 0.3)
    end
end

# --- DEADBOLT's locked doors -------------------------------------------------------------------
# Locked Door stands a door up in front of him. Alone it stays locked, and anything that hits it
# is answered: a blow is thrown back at whoever struck it. Once he has two they unlock and swing
# open, and he (only he) can step through either and out of the other. A third replaces the oldest.

function place_door(Fighter f)
    make_room(f.id, TH_DOOR, 2)
    var spot = on_disc(spot_ahead(f, 1.4), 1.0)
    add_thing(Thing(TH_DOOR, f.id, spot, DOOR_LIFE, ticks, 0, f.heading))
    var at = spot + ap.Vec3(0, 1.2, 0)
    sound_at(snd_heavy, spot, 0.5, 0.7)
    later(snd_lock, at, 6, 0.7, 0.7)
    burst(spot + ap.Vec3(0, 0.2, 0), 12, ap.Color(140, 120, 100), 2.5, 0.4, 0.08)
    if count_things(f.id, TH_DOOR) >= 2 do
        # The pair: both locks turn and both doors swing open.
        for t in things do
            if t.kind == TH_DOOR and t.owner == f.id and not t.gone do
                later(snd_lock, t.position + ap.Vec3(0, 1.2, 0), 14, 0.7, 1.1)
                later(snd_creak, t.position + ap.Vec3(0, 1.2, 0), 20, 0.6, 0.9)
                say(t.position + ap.Vec3(0, 2.6, 0), "UNLOCKED", f.kit.look.accent)
            end
        end
    else do
        say(spot + ap.Vec3(0, 2.6, 0), "LOCKED", f.kit.look.accent)
    end
end

function door_pair(Thing t) returns Thing?
    for u in things do
        if u != t and u.kind == TH_DOOR and u.owner == t.owner and not u.gone do
            return u
        end
    end
    return null
end

# The door of side `owner` that a point (a shot) has run into, if any: a slab 1.3 wide and 2.4 tall.
function door_touched(int owner, ap.Vec3 at, double size) returns Thing?
    for t in things do
        if t.kind != TH_DOOR or t.owner != owner or t.gone or at.y > 2.5 do
            continue
        end
        var rel = flat(at - t.position)
        var face = forward_of(t.yaw)
        var across = math.abs(dot3(rel, right_of(t.yaw)))
        var through = math.abs(dot3(rel, face))
        if across < 0.65 + size and through < 0.12 + size do
            return t
        end
    end
    return null
end

# Struck by `by`: the door hits back (not more often than DOOR_COUNTER_COOL).
function door_counter(Thing t, Fighter by)
    if by.id == t.owner or by.state == STATE_DOWN or t.aim.x > 0 do
        return
    end
    t.aim = ap.Vec3(double(DOOR_COUNTER_COOL), 0, 0)
    var owner = fighters[t.owner]
    var tint = owner.kit.look.accent
    var at = t.position + ap.Vec3(0, 1.2, 0)
    sound_at(snd_block, at, 0.7, 0.7)
    later(snd_lock, at, 3, 0.8, 0.9)
    rings.push(Ring(at, tint, 5, 0.2, true))
    burst(at, 14, tint, 4, 0.4, 0.08)
    say(at + ap.Vec3(0, 1.1, 0), "COUNTER", tint)
    if not wave_untouchable(by) do
        wave_hurt(owner, by, 8, "", tint)
        wave_stun(by, 40)
        by.knock = unit(flat(by.body.position - t.position)) * 9
        for i in 0..<8 do
            streak(at, unit(by.body.center() - at + scatter(0.4)) * 9, tint, 0.15, 0.4)
        end
    end
end

function update_door(Thing t)
    if t.aim.x > 0 do
        t.aim = ap.Vec3(t.aim.x - 1, 0, 0)
    end
    var there = door_pair(t)
    var open = there != null and t.clock > 14
    t.value = ap.approach(t.value, 1.0 if open else 0.0, 0.05)
    if not open or t.value < 0.8 do
        return
    end
    # Only he goes through: to anyone else it is an empty doorframe.
    for g in everyone() do
        if g.id != t.owner or g.minion or g.warp_cool > 0 or g.state == STATE_DOWN or g.body.position.y > 1.2 do
            continue
        end
        if flat_distance(g.body.position, t.position) > 0.7 do
            continue
        end
        var going = unit(flat(g.body.velocity))
        if going.length() < 0.5 do
            going = forward_of(g.heading)
        end
        # Out of the other door the side it faces, or the far side if that is the way he is going.
        var face = forward_of(there.yaw)
        var out_way = face if dot3(going, face) >= 0 else face * -1
        var out = there.position + out_way * 1.0
        if flat(out).length() > ARENA - 0.6 or world.overlaps(out + ap.Vec3(0, 1, 0), 0.5) do
            out = there.position - out_way * 1.0
        end
        var tint = g.kit.look.accent
        leave_ghost(g, 0.3)
        burst(g.body.center(), 10, tint, 3, 0.3, 0.08)
        g.body.position = ap.Vec3(out.x, g.body.position.y, out.z)
        g.warp_cool = 45
        sound_at(snd_creak, t.position, 0.4, 1.4)
        sound_at(snd_lock, there.position, 0.5, 1.2)
        rings.push(Ring(there.position + ap.Vec3(0, 1.2, 0), tint, 4, 0.2, true))
    end
end

function draw_locked_door(Thing th, ap.Color tint0)
    var at = th.position
    var yaw = th.yaw
    var side = right_of(yaw)
    # Like a tree, a door between the camera and a fighter goes faint so it never hides the
    # fight (how faint it is now is kept in aim.z, eased; the shadow pass draws it solid).
    var shown = 1.0
    if not ap.casting_shadows() do
        var eye = flat(camera.position)
        var want = 0.0
        for g in fighters do
            if g.state != STATE_DOWN and off_line(flat(at), eye, flat(g.body.position)) < 1.2 and
                    flat_distance(eye, at) < flat_distance(eye, g.body.position) + 0.3 do
                want = 0.75
            end
        end
        th.aim = ap.Vec3(th.aim.x, th.aim.y, ap.approach(th.aim.z, want, 0.08))
        shown = 1 - th.aim.z
    end
    var tint = tint0.fade(shown)
    var wood = ap.Color(66, 44, 32).fade(shown)
    var iron = ap.Color(80, 76, 70).fade(shown)
    var open = th.value
    # The frame: two posts and a lintel.
    var frame = ap.Color(46, 31, 22).fade(shown)
    ap.draw(box, at + side * 0.68 + ap.Vec3(0, 1.2, 0), frame, ap.Vec3(0, yaw, 0), ap.Vec3(0.14, 2.4, 0.2))
    ap.draw(box, at - side * 0.68 + ap.Vec3(0, 1.2, 0), frame, ap.Vec3(0, yaw, 0), ap.Vec3(0.14, 2.4, 0.2))
    ap.draw(box, at + ap.Vec3(0, 2.45, 0), frame, ap.Vec3(0, yaw, 0), ap.Vec3(1.5, 0.14, 0.22))
    if open > 0.05 and not ap.casting_shadows() do
        # Through the open doorway, the light of the other door.
        ap.lighting(false)
        ap.draw(box, at + ap.Vec3(0, 1.15, 0), tint.fade(0.55 * open), ap.Vec3(0, yaw, 0), ap.Vec3(1.2, 2.3, 0.03))
        ap.lighting(true)
        glow_light(at + ap.Vec3(0, 1.2, 0), 0.6 * open, tint.fade(0.25))
    end
    # The door itself, hinged on one post, swinging open as the pair unlocks.
    ap.push_3d()
    ap.translate_3d(at - side * 0.6 + ap.Vec3(0, 1.15, 0))
    ap.rotate_3d(yaw - 105 * open, ap.Vec3(0, 1, 0))
    ap.draw(box, right_of(0) * 0.6, wood, ap.Vec3(0, 0, 0), ap.Vec3(1.2, 2.3, 0.1))
    for k in 0..<2 do
        ap.draw(box, right_of(0) * 0.6 + ap.Vec3(0, -0.7 + double(k) * 1.4, 0), iron, ap.Vec3(0, 0, 0), ap.Vec3(1.22, 0.1, 0.12))
    end
    # A padlock while it is locked, glowing when it has just countered.
    var flash = th.aim.x / double(DOOR_COUNTER_COOL)
    if open < 0.5 do
        ap.draw(box, right_of(0) * 1.0 + ap.Vec3(0, 0, 0.1), tint.brightness(0.8 + flash), ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.22, 0.08))
        ap.draw(box, right_of(0) * 1.0 + ap.Vec3(0, 0.17, 0.1), iron, ap.Vec3(0, 0, 0), ap.Vec3(0.14, 0.12, 0.04))
    end
    ap.pop_3d()
end

# A melee blow from `f` that swept over the opponent's things breaks them.
function wave_struck(Fighter f, roster.Attack a)
    var forward = forward_of(f.heading)
    for t in things do
        if t.owner == f.id or t.gone do
            continue
        end
        if t.kind == TH_DOOR do
            if flat_distance(f.body.position, t.position) <= a.reach + 0.5 and
                    (a.radial or ap.in_cone(f.body.position, forward, t.position, a.arc)) do
                door_counter(t, f)
            end
            continue
        end
        var breakable = t.kind == TH_TURRET or t.kind == TH_TRAP or t.kind == TH_COIL or t.kind == TH_WALKER or
            t.kind == TH_DECOY or t.kind == TH_GRAVE or t.kind == TH_COPY
        if not breakable do
            continue
        end
        if flat_distance(f.body.position, t.position) <= a.reach + 0.5 and
                (a.radial or ap.in_cone(f.body.position, forward, t.position, a.arc)) do
            if t.kind == TH_DECOY do
                pop_decoy(t)
            else if t.kind == TH_COPY do
                t.gone = true
                burst(t.position + ap.Vec3(0, 1, 0), 20, ap.Color(220, 190, 100), 4, 0.6, 0.1)
                sound_at(snd_cloth, t.position, 0.6)
            else do
                t.gone = true
                burst(t.position + ap.Vec3(0, 0.5, 0), 14, ap.Color(200, 190, 170), 4, 0.5, 0.09)
                sound_at(snd_block, t.position, 0.6, 0.8)
                say(t.position + ap.Vec3(0, 1.4, 0), "BROKEN", ap.GRAY)
            end
        end
    end
end

# --- The tricks: KIND_WAVE moves going off -------------------------------------------------------
function shark_move() returns roster.Attack
    var a = roster.hit("Shark Bite", 11, 10, 22, 2.0, 100, 5.0, 30, 4, roster.ANIM_BITE)
    a.unblockable = true
    a.special = roster.SP_SHARK
    return a
end
var shark_bite = shark_move()
const int SHARK_COOLDOWN = 24        # ticks after one bite ends before the next (THE BLACK TIDE)

function add_pool(Fighter f, ap.Vec3 at, double radius, double seconds)
    var spot = on_disc(at, 0.4)
    add_thing(Thing(TH_POOL, f.id, spot, int(seconds * 60), ticks, radius))
    stain(spot, ap.Color(30, 80, 100), radius, seconds, 0.45, true)
    sound_at(snd_splash, spot, 0.6, 0.8)
    for i in 0..<14 do
        spark(spot + scatter(radius * 0.5) + ap.Vec3(0, 0.1, 0), ap.Vec3(ap.random(-1, 1), ap.random(2, 4), ap.random(-1, 1)),
            ap.Color(120, 200, 230), 0.6, 0.07, 9)
    end
end

function wave_trick(Fighter f, Fighter o, roster.Attack a)
    var sp = a.special
    var here = f.body.position
    var tint = f.kit.look.accent
    if sp == roster.SP_RESHUFFLE do
        draw_card(f)
        say(f.body.top() + ap.Vec3(0, 0.35, 0), "NEXT: {NUMERALS[f.card]} {TAROT[f.card]}", ap.Color(255, 230, 160))
        sound_at(snd_shuffle, here, 0.5)
    else if sp == roster.SP_VERDICT do
        # Begun inside his super, it lands even if the super has ended (or been switched off) since.
        if mech(f) == roster.MECH_WARDEN do
            var owed = f.round_hurt / 3
            say(o.body.top() + ap.Vec3(0, 0.6, 0), "THE VERDICT", tint)
            sound_at(snd_bell, o.body.position, 0.9, 0.4)
            later(snd_heavy, o.body.position, 10, 0.9, 0.6)
            later(snd_lock, o.body.position, 18, 0.8, 0.5)
            wave_hurt(f, o, math.max(owed, 1.0), "", tint)
            wave_stun(o, 60)
            end_own_super(f)
        end
    else if sp == roster.SP_TURRET or sp == roster.SP_TRAP or sp == roster.SP_COIL do
        while gadget_count(f.id) >= 3 do
            for t in things do
                if t.owner == f.id and not t.gone and not t.super_only and (t.kind == TH_TURRET or t.kind == TH_TRAP or t.kind == TH_COIL) do
                    t.gone = true
                    burst(t.position + ap.Vec3(0, 0.5, 0), 8, tint, 2, 0.4, 0.08)
                    break
                end
            end
        end
        var kind = TH_TURRET if sp == roster.SP_TURRET else (TH_TRAP if sp == roster.SP_TRAP else TH_COIL)
        var life = 600 if kind == TH_TURRET else (1200 if kind == TH_TRAP else 480)
        var spot = spot_ahead(f, 1.4)
        add_thing(Thing(kind, f.id, spot, life, ticks, 0, f.heading))
        sound_at(snd_reload, spot, 0.6, 0.7)
        later(snd_lock, spot, 6, 0.5, 1.1)
        burst(spot + ap.Vec3(0, 0.3, 0), 10, tint, 2.5, 0.35, 0.07)
    else if sp == roster.SP_OVERCLOCK do
        say(f.body.top(), "OVERCLOCK", tint)
        sound_at(snd_charge, here, 0.7, 1.4)
        for t in things do
            if t.owner != f.id or t.gone or not (t.kind == TH_TURRET or t.kind == TH_TRAP or t.kind == TH_COIL) do
                continue
            end
            if t.kind == TH_TURRET do
                for k in 0..<3 do
                    turret_fire(t, f, double(k - 1) * 8)
                end
            else if t.kind == TH_COIL do
                coil_zap(t, f, 4.5, 8)
            end
            t.life = math.min(t.life, 12)
            t.value = 1
        end
    else if sp == roster.SP_GRAVE do
        make_room(f.id, TH_GRAVE, 3)
        var spot = spot_ahead(f, 1.6)
        add_thing(Thing(TH_GRAVE, f.id, spot, -1, ticks, 0, f.heading + 180))
        sound_at(snd_thud, spot, 0.7, 0.6)
        later(snd_creak, spot, 5, 0.4, 0.6)
        smoke(spot + ap.Vec3(0, 0.2, 0), 6, 0.4, 0.8)
    else if sp == roster.SP_EXHUME do
        var any = false
        for t in things do
            if t.kind == TH_GRAVE and t.owner == f.id and not t.gone do
                t.gone = true
                any = true
                var s = Shot(f.id, grave_blast, t.position + ap.Vec3(0, 0.6, 0), ap.Vec3(0, 0, 0), 0.1)
                explode(s)
                for i in 0..<10 do
                    spark(t.position + ap.Vec3(0, 0.5, 0), unit(scatter(1) + ap.Vec3(0, 1, 0)) * 5, ap.Color(120, 116, 110), 1.0, 0.16, 9)
                end
            end
        end
        if not any do
            deny(f, "NO GRAVES")
        end
    else if sp == roster.SP_GRAVEWALK do
        var best = Thing(-1, f.id, here, 0, 0)
        var near = 999.0
        for t in things do
            if t.kind == TH_GRAVE and t.owner == f.id and not t.gone do
                var d = flat_distance(t.position, o.body.position)
                if d < near do
                    near = d
                    best = t
                end
            end
        end
        if best.kind < 0 do
            deny(f, "NO GRAVES")
        else do
            leave_ghost(f, 0.4)
            smoke(f.body.center(), 8, 0.4, 0.8)
            var out = best.position + unit(flat(o.body.position - best.position)) * 1.0
            f.body.position = on_disc(out, 0.6)
            f.heading = heading_of(o.body.position - f.body.position)
            sound_at(snd_creak, f.body.position, 0.6, 0.5)
            later(snd_thud, f.body.position, 3, 0.5, 0.8)
            smoke(f.body.position + ap.Vec3(0, 0.3, 0), 10, 0.5, 0.9)
        end
    else if sp == roster.SP_COFFIN do
        seal_coffin(f, o)
    else if sp == roster.SP_POOL do
        add_pool(f, here, 2.4, 10)
    else if sp == roster.SP_UNDERTOW do
        var pulled = false
        for g in foes_of_side(f.id) do
            if in_pool(g, f.id) and g.state != STATE_DOWN do
                pulled = true
                g.knock = unit(flat(here - g.body.position)) * math.min(flat_distance(here, g.body.position) * 2.6, 16.0)
                wave_hurt(f, g, 8, "UNDERTOW", tint)
                wave_stun(g, 34)
            end
        end
        sound_at(snd_splash, here, 0.7, 0.6)
        rings.push(Ring(here + ap.Vec3(0, 0.08, 0), tint, -6, 0.4))
        if not pulled do
            say(f.body.top(), "NOBODY IN THE WATER", ap.GRAY)
        end
    else if sp == roster.SP_DRAG_UNDER do
        drag_under(f, o)
    else if sp == roster.SP_BUY do
        var price = double(a.potion)
        if f.bar + 0.001 >= price and f.potion == 0 do
            f.bar -= price
            f.potion = a.potion
            say(f.body.top(), "{roster.POTION_NAMES[a.potion]}  (R throw, F brace)", POTION_COLORS[a.potion])
            sound_at(snd_coin_a, here, 0.5)
            later(snd_splash, here, 5, 0.3, 1.8)
        end
    else if sp == SP_DRINK do
        drink(f)
    else if sp == roster.SP_SELL do
        if f.potion == 0 do
            deny(f, "NOTHING TO SELL")
        else do
            var coins_got = f.potion
            f.potion = 0
            var more = coins_got * 2 * 60
            if max_owner == f.id do
                max_left += more
            else if merge_owner == f.id do
                merge_left += more
            end
            say(f.body.top(), "SOLD: +{coins_got * 2}s", MAX_GOLD)
            sound_at(snd_gold_sack, here, 0.6)
            coins(f.body.center(), 4 + coins_got * 2, 2)
        end
    else if sp == roster.SP_DECOY do
        make_room(f.id, TH_DECOY, 3)
        var spot = spot_ahead(f, 1.2)
        add_thing(Thing(TH_DECOY, f.id, spot, 30 * 60, ticks, 0, f.heading))
        sound_at(snd_cloth, spot, 0.6, 0.8)
        for i in 0..<14 do
            spark(spot + ap.Vec3(0, ap.random(0.2, 1.6), 0), scatter(1.5), ap.Color(220, 190, 100), 0.6, 0.06, 4)
        end
    else if sp == roster.SP_IGNITE do
        var any = false
        for t in things do
            if t.kind == TH_DECOY and t.owner == f.id and not t.gone do
                pop_decoy(t)
                any = true
            end
        end
        if not any do
            deny(f, "NO STRAW MEN")
        end
    else if sp == roster.SP_SWAPCROW do
        swap_with_copy(f, o)
    else if sp == roster.SP_TRACK do
        make_room(f.id, TH_TRACK, 3)
        var from = flat(here) - forward_of(f.heading) * 1.0
        var to = spot_ahead(f, 9)
        add_thing(Thing(TH_TRACK, f.id, on_disc(from, 0.6), 15 * 60, ticks, 0, f.heading, 0, false, to))
        sound_at(snd_lock, here, 0.6, 0.7)
        later(snd_thud, to, 4, 0.5, 1.2)
        later(snd_lock, to, 8, 0.4, 1.0)
    else if sp == roster.SP_BRAKE do
        if own_super(f, roster.MECH_CONDUCTOR) and train_brake < 0 do
            train_pulled = true
            start_train_brake(1.0)
            announce_line("THIS TRAIN IS STOPPING. PLEASE HOLD ON.")
            sound_at(snd_creak, cam_focus, 0.8, 0.5)
        end
    else if sp == roster.SP_EXERCISE do
        if f.bar < f.kit.bar_max do
            f.bar = math.min(f.bar + 1, f.kit.bar_max)
            say(f.body.top(), "REP {int(f.bar)}", tint)
            sound_at(snd_kiai, here, 0.6, 0.9)
            later(snd_thud, here, 6, 0.7, 0.6)
            rings.push(Ring(here + ap.Vec3(0, 0.08, 0), tint, 4, 0.3))
        else do
            say(f.body.top(), "PUMPED", tint)
        end
    else if sp == roster.SP_WIND_UP or sp == roster.SP_WIND_DOWN do
        time_scale = 1.3 if sp == roster.SP_WIND_UP else 0.7
        time_left = 6 * 60
        say(f.body.top() + ap.Vec3(0, 0.3, 0), "TIME x{time_scale}", tint)
        sound_at(snd_lock, here, 0.7, 1.6 if sp == roster.SP_WIND_UP else 0.6)
        later(snd_creak, here, 4, 0.6, 1.6 if sp == roster.SP_WIND_UP else 0.5)
        rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 12, 0.5))
    else if sp == roster.SP_LIGHT do
        make_room(f.id, TH_LIGHT, 2)
        var spot = spot_ahead(f, 2.6)
        add_thing(Thing(TH_LIGHT, f.id, spot + ap.Vec3(0, 1.6, 0), 8 * 60, ticks))
        sound_at(snd_shimmer, spot, 0.6, 0.9)
        gather(spot + ap.Vec3(0, 1.6, 0), 12, tint, 1.0, 0.25, 0.07)
    else if sp == roster.SP_FLARE do
        var any = false
        for t in things do
            if t.kind == TH_LIGHT and t.owner == f.id and not t.gone do
                t.gone = true
                any = true
                explode(Shot(f.id, flare_blast, t.position, ap.Vec3(0, 0, 0), 0.1))
            end
        end
        if not any do
            deny(f, "NO LIGHTS")
        end
    else if sp == roster.SP_DIVE do
        if own_super(f, roster.MECH_MOTH) do
            f.dive = 1
            f.dive_aim = flat(o.body.position)
            say(f.body.top(), "TO THE SUN", tint)
            sound_at(snd_launch, here, 0.7, 0.8)
            later(snd_wisp, here, 6, 0.6, 0.6)
        end
    else if sp == roster.SP_SHED do
        # Outside LAST STAND the armor comes off on its own (see hollow_tick) and this is never
        # ready. In it: the next piece off, or from nothing at all, the whole fortress back.
        if own_super(f, roster.MECH_HOLLOW) do
            if f.arm < 3 do
                shed_to(f, f.arm + 1, true)
            else do
                shed_to(f, 0, true)
                say(f.body.top() + ap.Vec3(0, 0.6, 0), "REFORGED", f.kit.look.accent)
                sound_at(snd_heavy, f.body.position, 0.8, 0.6)
                rings.push(Ring(f.body.center(), f.kit.look.accent, 7, 0.3, true))
            end
            f.cooldowns[3] = 0
        end
    else if sp == roster.SP_DOOR do
        place_door(f)
    else if sp == roster.SP_LOCKOUT do
        var target = o.last_skill
        if target < 0 do
            target = pick_index(4)
        end
        o.locks[target] = 10 * 60
        say(o.body.top() + ap.Vec3(0, 0.45, 0), "{o.kit.skills[target].name.upper()} LOCKED", tint)
        sound_at(snd_lock, o.body.position, 0.8, 0.8)
        later(snd_lock, o.body.position, 5, 0.7, 0.6)
        for i in 0..<10 do
            var life = ap.random(0.2, 0.35)
            spark(here + ap.Vec3(0, 1.2, 0), (o.body.center() - here - ap.Vec3(0, 1.2, 0)) * (1 / life), tint, life, 0.07, 0)
        end
    else if sp == roster.SP_SLAM_DOOR do
        if own_super(f, roster.MECH_DEADBOLT) do
            var near = flat_distance(o.body.position, door_at) < DOOR_REACH
            sound_at(snd_heavy, door_at, 1.0, 0.4)
            later(snd_lock, door_at, 4, 0.9, 0.5)
            rings.push(Ring(door_at + ap.Vec3(0, 0.1, 0), tint, 9, 0.4))
            if near do
                wave_hurt(f, o, 30, "SLAMMED", tint)
                wave_stun(o, 60)
            else do
                wave_hurt(f, o, 10, "", tint)
            end
        end
    else if sp == roster.SP_NEVERMORE do
        var any = false
        for k in 0..<4 do
            if o.omens[k] > 0 do
                any = true
                o.omens[k] = 0
                if k == 3 do
                    deliver_letter(o, 2)
                else do
                    wave_hurt(f, o, [28.0, 24.0, 20.0][k], "NEVERMORE", tint)
                end
            end
        end
        if not any do
            wave_hurt(f, o, 12, "NEVERMORE", tint)
        end
        sound_at(snd_ambush, o.body.position, 0.8, 0.6)
        for i in 0..<20 do
            streak(o.body.top() + scatter(1.5) + ap.Vec3(0, 2, 0), (o.body.center() - o.body.top() + scatter(0.6)) * 6,
                ap.Color(30, 28, 38), 0.3, 0.4, 0.07)
        end
    end
end

# --- UNDERTAKER's coffin -------------------------------------------------------------------------
function seal_coffin(Fighter f, Fighter o)
    if o.state == STATE_DOWN or flat_distance(f.body.position, o.body.position) > 12 do
        deny(f, "TOO FAR")
        return
    end
    if unstoppable(o) do
        deny(f, unstoppable_word(o))
        return
    end
    # Stunned by anything but a basic attack (a parry, the hands), they stay sealed.
    var stunned = o.state == STATE_HURT and not o.stun_basic
    o.coffin_at = flat(o.body.position)
    o.coffin_air = stunned and not o.body.grounded and o.body.position.y > 0.4
    o.coffin = -1 if stunned else 3 * 60
    o.coffin_drop = false
    o.knock = ap.Vec3(0, 0, 0)
    if o.cloaked do
        set_cloak(o, false)
    end
    say(o.body.top() + ap.Vec3(0, 0.6, 0), "SEALED IN" if stunned else "BURIED", f.kit.look.accent)
    sound_at(snd_creak, o.body.position, 0.9, 0.5)
    later(snd_thud, o.body.position, 5, 0.9, 0.5)
    later(snd_lock, o.body.position, 12, 0.8, 0.6)
    smoke(o.body.position + ap.Vec3(0, 0.3, 0), 14, 0.6, 1.2)
end
function open_coffin(Fighter f)
    f.coffin = 0
    f.coffin_air = false
    f.fade = 1
    f.state = STATE_IDLE
    f.stun = 0
    f.safe = 30
    say(f.body.top(), "OUT", ap.WHITE)
    sound_at(snd_creak, f.body.position, 0.7, 0.9)
    smoke(f.body.position + ap.Vec3(0, 0.4, 0), 10, 0.6, 1.0)
    for i in 0..<8 do
        spark(f.body.center() + scatter(0.4), ap.Vec3(ap.random(-3, 3), ap.random(2, 5), ap.random(-3, 3)), ap.Color(90, 60, 40), 1.0, 0.18, 9)
    end
end

# --- HAMMERHEAD's dive ---------------------------------------------------------------------------
# A HAMMERHEAD cannot drown: held under, he takes no damage from the lack of air (only drowning;
# being shut in a coffin with no air still hurts him).
function breathes_water(Fighter f) returns bool
    return mech(f) == roster.MECH_HAMMERHEAD
end

function drag_under(Fighter f, Fighter o)
    if o.state == STATE_DOWN or flat_distance(f.body.position, o.body.position) > 4.5 do
        deny(f, "TOO FAR")
        return
    end
    if unstoppable(o) do
        deny(f, unstoppable_word(o))
        return
    end
    o.drag = 5 * 60
    o.coffin_at = flat(o.body.position)
    if breathes_water(o) do
        say(o.body.top() + ap.Vec3(0, 0.9, 0), "BREATHES WATER", o.kit.look.accent)
    end
    f.body.position = on_disc(o.body.position - forward_of(f.heading) * 0.8, 0.6)
    say(o.body.top() + ap.Vec3(0, 0.6, 0), "DRAGGED UNDER", f.kit.look.accent)
    sound_at(snd_plunge, o.body.position, 1.0, 0.8)
    later(snd_bite, o.body.position, 3, 0.7, 0.6)
    later(snd_bubbles[0], o.body.position, 14, 0.7, 0.8)
    for i in 0..<24 do
        spark(o.body.position + scatter(0.8) + ap.Vec3(0, 1.0, 0), ap.Vec3(ap.random(-2, 2), ap.random(3, 6), ap.random(-2, 2)),
            ap.Color(150, 210, 230), 0.8, 0.08, 9)
    end
end
function tick_drag(Fighter o, Fighter u)
    if o.drag <= 0 do
        return
    end
    var dt = 1.0 / 60
    o.drag -= 1
    # No air: drowning, which a HAMMERHEAD does not do (he still bleeds from the bite).
    if not breathes_water(o) do
        o.health -= 4.0 * dt
        o.round_hurt += 4.0 * dt
    end
    o.poison = math.max(o.poison, 1.0)
    if ap.chance(0.3) do
        spark(o.body.position + scatter(0.4) + ap.Vec3(0, 1.4, 0), ap.Vec3(0, ap.random(1.5, 3), 0), ap.Color(200, 240, 255), 0.6, 0.06, -1)
    end
    if o.drag % 42 == 0 and o.drag > 0 do
        # The air going out of them, a mouthful at a time.
        sound_at(snd_bubbles[(o.drag // 42) % 2], o.body.position, 0.45, ap.random(0.8, 1.05))
    end
    if o.drag == 0 do
        # Five seconds without air, and the tide goes out with them.
        if not breathes_water(o) do
            say(o.body.top(), "GASP", ap.WHITE)
        end
        sound_at(snd_surface, o.body.position, 0.8, 0.9)
        end_own_super(u)
    end
end

# --- SCARECROW ---------------------------------------------------------------------------------
function pop_decoy(Thing t)
    if t.gone do
        return
    end
    t.gone = true
    var s = Shot(t.owner, decoy_blast, t.position + ap.Vec3(0, 0.9, 0), ap.Vec3(0, 0, 0), 0.1)
    explode(s)
    for i in 0..<30 do
        spark(t.position + ap.Vec3(0, ap.random(0.3, 1.6), 0), unit(scatter(1) + ap.Vec3(0, 0.6, 0)) * ap.random(3, 7),
            ap.Color(220, 190, 100), 1.0, 0.07, 6)
    end
    sound_at(snd_cloth, t.position, 0.8, 0.7)
end
function swap_with_copy(Fighter f, Fighter o)
    if not own_super(f, roster.MECH_SCARECROW) do
        return
    end
    # The copy the stick points toward (or the one nearest them, when the stick is still).
    var way = unit(flat(f.wish)) if f.wish.length() > 0.2 else unit(flat(o.body.position - f.body.position))
    var best = Thing(-1, f.id, f.body.position, 0, 0)
    var score = -999.0
    for t in things do
        if t.kind != TH_COPY or t.gone do
            continue
        end
        var to = flat(t.position - f.body.position)
        var s = dot3(unit(to), way) * 4 - to.length() * 0.15
        if s > score do
            score = s
            best = t
        end
    end
    if best.kind < 0 do
        return
    end
    var was = flat(f.body.position)
    leave_ghost(f, 0.4)
    f.body.position = ap.Vec3(best.position.x, 0, best.position.z)
    best.position = was
    best.yaw = f.heading
    f.swap_cool = 30
    sound_at(snd_cloth, was, 0.6, 1.2)
    later(snd_cloth, f.body.position, 2, 0.6, 0.8)
    for i in 0..<12 do
        spark(f.body.position + ap.Vec3(0, ap.random(0.2, 1.6), 0), scatter(1.2), ap.Color(220, 190, 100), 0.5, 0.06, 3)
        spark(was + ap.Vec3(0, ap.random(0.2, 1.6), 0), scatter(1.2), ap.Color(220, 190, 100), 0.5, 0.06, 3)
    end
end

# --- HUNTER's arrow ------------------------------------------------------------------------------
function aim_golden(Fighter f, Fighter o)
    # The aim is the stick's, not the auto-turn's: slow and steady.
    if f.frame <= 1 do
        f.aim_heading = f.heading
    end
    var want = f.aim_heading
    if f.cpu do
        want = heading_of(o.body.position - f.body.position) + math.sin(double(f.frame) * 0.05) * 6
    else if f.wish.length() > 0.2 do
        want = heading_of(f.wish)
    end
    f.aim_heading = wrap(f.aim_heading + math.clamp(wrap(want - f.aim_heading), -1.6, 1.6))
    f.heading = f.aim_heading
    if f.frame == 1 do
        f.fade = 1
        say(f.body.top(), "SEEN", ap.Color(255, 210, 90))
        sound_at(snd_creak, f.body.position, 0.6, 0.6)
    else if f.frame % 25 == 0 and f.frame < f.move.startup do
        # The bowstring, drawn tighter.
        sound_at(snd_creak, f.body.position, 0.4 + 0.2 * double(f.frame) / double(f.move.startup), 0.6 + 0.6 * double(f.frame) / double(f.move.startup))
    end
end

# --- MOTH's dive ---------------------------------------------------------------------------------
const int DIVE_RISE = 60
const int DIVE_AIM = 150
function update_dive(Fighter f, Fighter o)
    var body = f.body
    f.dive += 1
    var t = f.dive
    body.velocity = ap.Vec3(0, 0, 0)
    f.state = STATE_ATTACK
    f.frame = 2
    if t < DIVE_RISE do
        body.position = ap.Vec3(body.position.x, double(t) * 0.35, body.position.z)
        if t % 3 == 0 do
            leave_ghost(f, 0.3)
        end
    else if t < DIVE_AIM do
        body.position = ap.Vec3(body.position.x, 24, body.position.z)
        f.fade = 0
        # Steer where the crash lands; the CPU picks them.
        if f.cpu do
            f.dive_aim = f.dive_aim.lerp(flat(o.body.position), 0.06)
        else if f.wish.length() > 0.2 do
            f.dive_aim = on_disc(f.dive_aim + unit(flat(f.wish)) * 0.16, 0.6)
        end
        if t % 30 == 0 do
            sound_at(snd_charge, f.dive_aim, 0.4, 0.6 + double(t) / 200)
        end
    else do
        # Down like a falling star.
        f.fade = 1
        body.position = ap.Vec3(f.dive_aim.x, 0, f.dive_aim.z)
        f.dive = 0
        f.state = STATE_IDLE
        f.frame = 0
        explode(Shot(f.id, dive_blast, f.dive_aim + ap.Vec3(0, 0.4, 0), ap.Vec3(0, 0, 0), 0.1))
        fire_left = math.max(fire_left, 10 * 60)
        fire_owner = f.id
        say(f.body.top() + ap.Vec3(0, 0.5, 0), "EVERYTHING BURNS", f.kit.look.accent)
        sound_at(snd_ko, f.dive_aim, 0.7, 1.3)
        for i in 0..<30 do
            streak(f.dive_aim + ap.Vec3(0, 0.2, 0), unit(scatter(1) + ap.Vec3(0, 0.5, 0)) * ap.random(6, 12), ap.Color(255, 220, 120), 0.4, 0.8)
        end
    end
end

# --- What lies about, every tick -----------------------------------------------------------------
function turret_fire(Thing t, Fighter owner, double off)
    var targets = foes_of_side(t.owner)
    var o = targets[0]
    var from = t.position + ap.Vec3(0, 0.95, 0)
    var to = o.body.center() - from
    var way = forward_of(heading_of(to) + off)
    var aim = unit(ap.Vec3(way.x, to.y / math.max(flat(to).length(), 0.5), way.z))
    t.yaw = heading_of(to)
    shots.push(Shot(t.owner, bolt_attack, from, aim * bolt_attack.shot_speed, 1.2))
    sound_at(snd_lock, from, 0.35, 1.8)
end
function coil_zap(Thing t, Fighter owner, double reach, double damage)
    var top = t.position + ap.Vec3(0, 1.3, 0)
    for g in foes_of_side(t.owner) do
        if g.state != STATE_DOWN and not wave_untouchable(g) and flat_distance(g.body.position, t.position) < reach do
            beams.push(Beam(top, g.body.center(), owner.kit.look.accent, 0.05, 0.12, 0.12))
            wave_hurt(owner, g, damage, "", owner.kit.look.accent)
            g.slow = math.max(g.slow, 0.4)
            sound_at(snd_zap_file, top, 0.4, 1.3)
        end
    end
end

function update_things()
    var dt = 1.0 / 60
    Thing[] kept = []
    for t in things do
        if t.gone do
            continue
        end
        if t.life > 0 do
            t.life -= 1
            if t.life == 0 do
                thing_expires(t)
                continue
            end
        end
        t.clock += 1
        var owner = fighters[t.owner]
        var targets = foes_of_side(t.owner)
        var o = targets[0]
        for g in targets do
            if g.state != STATE_DOWN and flat_distance(g.body.position, t.position) < flat_distance(o.body.position, t.position) do
                o = g
            end
        end
        var gap = flat_distance(o.body.position, t.position)
        var live = o.state != STATE_DOWN and phase == PHASE_FIGHT and not wave_untouchable(o)
        if t.kind == TH_TURRET do
            if live and t.clock % 66 == 0 and gap < 13 and o.fade > 0.5 do
                turret_fire(t, owner, 0)
            end
        else if t.kind == TH_TRAP do
            if live and t.clock > 40 and gap < 0.9 and o.body.position.y < 0.3 do
                t.gone = true
                say(o.body.top() + ap.Vec3(0, 0.45, 0), "SNARED", owner.kit.look.accent)
                wave_hurt(owner, o, 6, "", owner.kit.look.accent)
                wave_stun(o, 70)
                sound_at(snd_lock, t.position, 0.9, 0.6)
                later(snd_chop, t.position, 1, 0.7, 1.2)
            end
        else if t.kind == TH_COIL do
            if live and t.clock % 48 == 0 do
                coil_zap(t, owner, 3.2, 4)
            end
            if ap.chance(0.2) do
                spark(t.position + ap.Vec3(0, 1.3, 0), scatter(2), owner.kit.look.accent, 0.15, 0.05, 0)
            end
        else if t.kind == TH_WALKER do
            if live do
                var way = unit(flat(o.body.position - t.position))
                t.position = on_disc(t.position + way * (3.4 * dt), 0.6)
                t.yaw = heading_of(way)
                if gap < 1.2 do
                    t.gone = true
                    explode(Shot(t.owner, walker_blast, t.position + ap.Vec3(0, 0.6, 0), ap.Vec3(0, 0, 0), 0.1))
                end
            end
            if t.clock % 12 == 0 do
                sound_at(snd_step, t.position, 0.2, 1.6)
            end
        else if t.kind == TH_HANDS do
            if t.clock == 42 do
                t.gone = true
                sound_at(snd_growl, t.position, 0.6, 0.6)
                for g in targets do
                    if g.state != STATE_DOWN and not wave_untouchable(g) and flat_distance(g.body.position, t.position) < 1.4 and
                            g.body.position.y < 0.8 do
                        say(g.body.top() + ap.Vec3(0, 0.45, 0), "HELD DOWN", owner.kit.look.accent)
                        wave_stun(g, 55)
                        wave_hurt(owner, g, 4, "", owner.kit.look.accent)
                    end
                end
                for i in 0..<16 do
                    streak(t.position + scatter(0.6), ap.Vec3(0, ap.random(3, 6), 0), owner.kit.look.accent, 0.4, 0.5)
                end
            end
        else if t.kind == TH_POOL do
            for g in targets do
                if in_pool(g, t.owner) and not g.kit.machine do
                    g.slow = math.max(g.slow, 0.3)
                end
            end
            if ap.chance(0.05) do
                spark(t.position + scatter(t.value * 0.6) + ap.Vec3(0, 0.05, 0), ap.Vec3(0, 0.5, 0), ap.Color(150, 210, 230), 0.4, 0.05, 0)
            end
        else if t.kind == TH_COIN or t.kind == TH_POTION do
            for g in everyone() do
                if mech(g) != roster.MECH_FLASQUE or g.state == STATE_DOWN or flat_distance(g.body.position, t.position) > 0.9 do
                    continue
                end
                if t.kind == TH_COIN and g.bar < g.kit.bar_max do
                    t.gone = true
                    g.bar = math.min(g.bar + 1, g.kit.bar_max)
                    say(g.body.top(), "+1 COIN ({int(g.bar)})", MAX_GOLD)
                    sound_at(snd_coin_a if ap.chance(0.5) else snd_coin_b, t.position, 0.6)
                    coins(t.position + ap.Vec3(0, 0.4, 0), 5, 1.5)
                else if t.kind == TH_POTION and g.potion == 0 do
                    t.gone = true
                    g.potion = int(t.value)
                    say(g.body.top(), "{roster.POTION_NAMES[g.potion]} (R throw, G sell)", POTION_COLORS[g.potion])
                    sound_at(snd_splash, t.position, 0.5, 1.6)
                end
            end
        else if t.kind == TH_DECOY do
            if live and t.clock > 48 and gap < 1.7 do
                pop_decoy(t)
            end
        else if t.kind == TH_DOOR do
            update_door(t)
        else if t.kind == TH_COPY do
            if live and t.value > 0 and gap < 1.9 and t.clock > 60 do
                # It was not just a scarecrow.
                t.gone = true
                say(o.body.top() + ap.Vec3(0, 0.6, 0), "!!", ap.Color(255, 150, 40))
                sound_at(snd_ambush, t.position, 1.0, 0.7)
                sound_at(snd_growl, t.position, 0.9, 0.9)
                later(snd_slash, o.body.position, 2, 0.8, 0.8)
                wave_hurt(owner, o, 10, "", owner.kit.look.accent)
                wave_stun(o, 32)
                leave_ghost_at(owner, t.position + unit(flat(o.body.position - t.position)) * 0.9, heading_of(o.body.position - t.position))
                for i in 0..<24 do
                    spark(t.position + ap.Vec3(0, ap.random(0.3, 1.6), 0), unit(scatter(1)) * ap.random(3, 6), ap.Color(220, 190, 100), 0.9, 0.07, 5)
                end
            end
        else if t.kind == TH_LIGHT do
            pull_shots(t, owner)
            if ap.chance(0.3) do
                spark(t.position + scatter(0.3), scatter(0.4), owner.kit.look.accent, 0.4, 0.05, -0.3)
            end
        end
        if not t.gone do
            kept.push(t)
        end
    end
    things = kept
    # FLASQUE's coins (or, in the Great Work, potions) turn up around the floor.
    var alchemist = has_flasque()
    if alchemist >= 0 and phase == PHASE_FIGHT do
        coin_clock += 1
        var lab = own_super(fighters[alchemist], roster.MECH_FLASQUE)
        var kind = TH_POTION if lab else TH_COIN
        var lying = 0
        for t in things do
            if t.kind == kind do
                lying += 1
            end
        end
        if coin_clock >= (130 if lab else 150) and lying < (4 if lab else 3) do
            coin_clock = 0
            var spot = free_spot(1.2)
            var t = Thing(kind, alchemist, spot, -1, ticks)
            if lab do
                t.value = double(brew_choice(fighters[alchemist]))
                t.super_only = true
            end
            add_thing(t)
            sound_at(snd_coin_drop if not lab else snd_splash, spot, 0.3, 1.4)
        end
    end
end

# Which potion brews next: anything, but more often what the alchemist has switched on.
function brew_choice(Fighter f) returns int
    int[] pool = [1, 2, 3, 4]
    for i in 0..<4 do
        if f.produce[i] == 1 do
            pool.push(i + 1)
            pool.push(i + 1)
            pool.push(i + 1)
        end
    end
    return pool[pick_index(pool.length)]
end

function thing_expires(Thing t)
    if t.kind == TH_WALKER do
        explode(Shot(t.owner, walker_blast, t.position + ap.Vec3(0, 0.6, 0), ap.Vec3(0, 0, 0), 0.1))
    else if (t.kind == TH_TURRET or t.kind == TH_COIL or t.kind == TH_TRAP) and t.value > 0 do
        # Overclocked: it shakes itself to pieces.
        explode(Shot(t.owner, gadget_blast, t.position + ap.Vec3(0, 0.5, 0), ap.Vec3(0, 0, 0), 0.1))
    else if t.kind != TH_POOL and t.kind != TH_BURN do
        burst(t.position + ap.Vec3(0, 0.4, 0), 8, ap.Color(140, 130, 120), 2, 0.4, 0.08)
    end
end

# A ghost of a fighter's look at a spot (a scarecrow lunging).
function leave_ghost_at(Fighter f, ap.Vec3 at, double heading)
    var pose = puppet.make_pose(f.kit.look, puppet.ACT_ATTACK, roster.ANIM_POUNCE, 1.2, 0, 0, 0, 0)
    ghosts.push(Ghost(f.kit.look, pose, at, heading, 0.5, 0.5))
end

# MOTH's lights: shots of the other side bend in, and leave the light going back at them.
function pull_shots(Thing t, Fighter owner)
    for s in shots do
        if s.attack.skyfall or s.attack.shot == roster.SHOT_MINE do
            continue
        end
        var to = t.position - s.position
        var d = to.length()
        if d > 3.6 do
            continue
        end
        if s.owner != t.owner do
            if d < 0.6 do
                # Caught, and sent back.
                var foe = foes_of_side(t.owner)[0]
                s.owner = t.owner
                s.position = t.position
                s.velocity = unit(foe.body.center() - t.position) * math.max(s.velocity.length(), 14.0)
                s.life = math.max(s.life, 1.5)
                say(t.position + ap.Vec3(0, 0.4, 0), "RETURNED", owner.kit.look.accent)
                sound_at(snd_shimmer, t.position, 0.6, 1.4)
                rings.push(Ring(t.position, owner.kit.look.accent, 3, 0.2, true))
            else do
                var speed = s.velocity.length()
                s.velocity = unit(s.velocity + unit(to) * (speed * 0.12)) * speed
            end
        else if d < 3.0 do
            # Her own shots come out of the light homing.
            var foe = foes_of_side(t.owner)[0]
            var speed = s.velocity.length()
            s.velocity = unit(s.velocity + unit(foe.body.center() - s.position) * (speed * 0.06)) * speed
        end
    end
end

# --- Supers --------------------------------------------------------------------------------------
function announce_line(string words)
    announce = words
    announce_ticks = 200
    sound_at(snd_bell, cam_focus, 0.5, 1.5)
    later(snd_bell, cam_focus, 10, 0.45, 1.2)
end

# A super's place has just appeared, with `f` in it.
function wave_super_starts(Fighter f, roster.Maximum m)
    var o = foe_of(f)
    var k = mech(f)
    f.wave_clock = 0
    if k == roster.MECH_WARDEN do
        # The cell goes up around them; he is left outside it.
        var at = on_disc(o.body.position, CAGE_RADIUS + 1.6)
        cage_at = at
        var off = flat(o.body.position - at)
        if off.length() > CAGE_RADIUS - 0.6 do
            o.body.position = at
        end
        var out = flat(f.body.position - at)
        if out.length() < CAGE_RADIUS + 0.6 do
            var way = unit(out) if out.length() > 0.05 else ap.Vec3(0, 0, 1)
            f.body.position = on_disc(at + way * (CAGE_RADIUS + 1.2), 0.6)
        end
        sound_at(snd_lock, at, 1.0, 0.5)
        later(snd_heavy, at, 4, 0.9, 0.4)
    else if k == roster.MECH_ORACLE do
        # FATE'S REVISION: back to how she was eight seconds ago, if that was better.
        var then = f.history[0] if f.history.length > 0 else f.health
        if then > f.health do
            say(f.body.top() + ap.Vec3(0, 0.4, 0), "REWOUND +{int(then - f.health)}", f.kit.look.accent)
            f.health = math.min(then, f.max_health)
        end
        f.poison = 0
        f.slow = 0
        f.ailments = [0.0, 0.0, 0.0]
        sound_at(snd_rift, f.body.position, 0.8, 0.5)
        later(snd_shimmer, f.body.position, 8, 0.6, 0.6)
        for i in 0..<6 do
            leave_ghost(f, 0.3 + double(i) * 0.12)
        end
        draw_card(f)
    else if k == roster.MECH_UNDERTAKER do
        for i in 0..<6 do
            var spot = forward_of(double(i) * 60 + 30) * (ARENA - 2.5)
            var t = Thing(TH_GRAVE, f.id, flat(spot), -1, ticks, 0, double(i) * 60 + 210)
            t.super_only = true
            add_thing(t)
        end
    else if k == roster.MECH_HUNTER do
        # The trees grow up through the floor where nobody is standing.
        for i in 0..<16 do
            var spot = forward_of(h01(i, 300) * 360) * (2 + h01(i, 301) * (ARENA - 3))
            spot = flat(spot)
            var clear = true
            for g in everyone() do
                if flat_distance(g.body.position, spot) < 1.6 do
                    clear = false
                end
            end
            if clear do
                props.push(Prop(PROP_TREE, f.id, spot, 7, -1, ticks, h01(i, 302) * 360, true))
            end
        end
        world = build_world()
        f.golden_wait = int(ap.random(200, 600))
    else if k == roster.MECH_HAMMERHEAD do
        f.under = true
        sound_at(snd_splash, f.body.position, 1.0, 0.4)
    else if k == roster.MECH_FLASQUE do
        f.bar = 0
        f.produce = [0, 0, 0, 0]
        coins(f.body.center(), 20, 3)
        sound_at(snd_gold_sack, f.body.position, 0.7)
        coin_clock = 100
        for t in things do
            if t.kind == TH_COIN do
                t.gone = true
            end
        end
    else if k == roster.MECH_SCARECROW do
        for i in 0..<12 do
            var spot = flat(forward_of(h01(i, 310) * 360 + double(i) * 30) * (2.5 + h01(i, 311) * (ARENA - 3.5)))
            var t = Thing(TH_COPY, f.id, spot, -1, ticks, 1 if h01(i, 312) < 0.45 else 0, h01(i, 313) * 360)
            t.super_only = true
            add_thing(t)
        end
    else if k == roster.MECH_CONDUCTOR do
        train_cam = camera.position
        train_axis = unit(flat(o.body.position - f.body.position))
        if train_axis.length() < 0.5 do
            train_axis = ap.Vec3(0, 0, 1)
        end
        train_ride = 0
        train_brake = -1
        train_pulled = false
        train_ahead = 0
        train_clack = 0
        f.body.position = train_axis * -3.5
        o.body.position = train_axis * 3.5
        announce_line("ALL ABOARD. THIS IS THE LAST TRAIN. FARES ARE COLLECTED ON ARRIVAL.")
    else if k == roster.MECH_HOLLOW do
        # LAST STAND: the armor stops falling off on its own; 4 changes form, as often as wanted.
        set_shed_move(f)
        f.cooldowns[3] = 0
    else if k == roster.MECH_DEADBOLT do
        door_at = on_disc(o.body.position + unit(flat(o.body.position - f.body.position)) * 3.5, 1.6)
        door_clock = 0
        sound_at(snd_creak, door_at, 1.0, 0.4)
        later(snd_lock, door_at, 10, 0.9, 0.4)
    else if k == roster.MECH_RAVEN do
        for g in everyone() do
            g.aggro = 0
        end
    end
end

# Every tick of a super's place: `u` its owner.
function wave_super_tick(Fighter u, Fighter o, roster.Maximum m)
    var dt = 1.0 / 60
    var k = mech(u)
    u.wave_clock += 1
    var c = u.wave_clock
    if k == roster.MECH_DEATH do
        if c % 180 == 0 do
            # THE QUARANTINE: something new is going round the ward.
            add_ailment(u, o, (c // 180) % 3, 6)
        end
    else if k == roster.MECH_TINKER do
        if c % 210 == 60 do
            var spot = flat(forward_of(ap.random(0, 360)) * (ARENA - 1.5))
            var kind = TH_WALKER if (c // 210) % 2 == 0 else TH_TURRET
            var t = Thing(kind, u.id, spot, 8 * 60, ticks, 0, heading_of(o.body.position - spot))
            t.super_only = true
            add_thing(t)
            sound_at(snd_reload, spot, 0.7, 0.6)
            later(snd_lock, spot, 6, 0.6, 0.8)
            burst(spot + ap.Vec3(0, 0.5, 0), 14, m.glow, 3, 0.4, 0.08)
        end
    else if k == roster.MECH_UNDERTAKER do
        if c % 270 == 90 and o.coffin == 0 do
            var t = Thing(TH_HANDS, u.id, flat(o.body.position), -1, ticks)
            t.super_only = true
            add_thing(t)
            sound_at(snd_creak, o.body.position, 0.5, 0.5)
        end
        if o.coffin == -1 do
            # No air in there.
            o.health -= 2.6 * dt
            o.round_hurt += 2.6 * dt
            if c % 40 == 0 do
                sound_at(snd_thud, o.body.position, 0.3, 1.4)
            end
        end
    else if k == roster.MECH_HUNTER do
        # No music: wind through the leaves, and that is all.
        if c % 150 == 1 do
            snd_wind.play_at(cam_focus + ap.Vec3(ap.random(-8, 8), 3, ap.random(-8, 8)), 0.35, ap.random(0.8, 1.2), 6, 0)
        end
        if ap.chance(0.012) do
            sound_at(snd_cloth, forward_of(ap.random(0, 360)) * ap.random(6, 12), 0.25, ap.random(0.6, 0.9))
        end
        if ap.chance(0.3) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), ap.random(4, 9), ap.random(-10, 10)), ap.Vec3(ap.random(0.5, 1.5), -0.7, ap.random(-0.5, 0.5)),
                ap.Color(110, 130, 60) if ap.chance(0.6) else ap.Color(150, 110, 50), 4.0, 0.07, 0.1)
        end
    else if k == roster.MECH_HAMMERHEAD do
        tick_drag(o, u)
        if c % 8 == 0 do
            spark(ap.Vec3(u.body.position.x, 1.05, u.body.position.z) - forward_of(u.heading) * 0.5, ap.Vec3(0, 0.3, 0), ap.Color(200, 240, 255), 0.5, 0.06, 0)
        end
    else if k == roster.MECH_CONDUCTOR do
        train_ride += 1
        train_run += 0.55 * train_speed()
        if train_brake >= 0 do
            train_brake += 1
            if train_brake == TRAIN_BRAKE do
                # Standstill: the brakes let go their air.
                ap.stop(train_hum)
                train_hum = -1
                sound_at(snd_air_brake, cam_focus, 0.45, 1.0)
                sound_at(snd_thud, cam_focus - ap.Vec3(0, 1, 0), 0.35, 0.6)
            end
            if train_brake >= TRAIN_BRAKE + TRAIN_DWELL do
                end_own_super(u)
            end
        end
        if super_left(u) == TRAIN_BRAKE + TRAIN_DWELL + 90 and train_brake < 0 do
            announce_line("WE ARE APPROACHING OUR FINAL DESTINATION.")
        end
        if super_left(u) <= TRAIN_BRAKE + TRAIN_DWELL and train_brake < 0 do
            # Arriving on time: it pulls in and stops before the doors open.
            start_train_brake(0.7)
        end
        var speed = train_speed()
        if train_hum >= 0 do
            # The squeal drops as the wheels slow.
            ap.set_pitch(train_hum, 0.8 + 0.2 * speed)
        end
        # The wheels on the joints of the rails, two bogies a carriage: clack-clack, slower
        # as it brakes, and nothing at a standstill.
        train_clack += math.max(speed, 0.0) / 22
        if speed > 0.03 and train_clack >= 1 do
            train_clack -= 1
            var under = cam_focus - ap.Vec3(0, 1, 0)
            sound_at(snd_thud, under, 0.12 * (0.4 + 0.6 * speed), 0.8 + 0.3 * speed)
            later(snd_thud, under - train_axis * 2, 5, 0.08 * (0.4 + 0.6 * speed), 0.75 + 0.3 * speed)
        end
        # A faint rumble under the floor, and now and then the carriage creaking as it sways.
        if c % 30 == 0 and speed > 0.05 do
            snd_rumble.play_at(cam_focus - ap.Vec3(0, 1.2, 0), 0.07 * speed, ap.random(0.1, 0.13), 6, 0)
        end
        if ap.chance(0.006 * speed) do
            sound_at(snd_creak, cam_focus + train_axis * ap.random(-6, 6) + ap.Vec3(0, 1.2, 0), 0.08, ap.random(0.9, 1.3))
        end
    else if k == roster.MECH_MAESTRO do
        if u.round_ticks % BEAT == 0 do
            var down = (u.round_ticks // BEAT) % 4 == 0
            var a = symphony_note(down)
            var from = flat(o.body.position + forward_of(ap.random(0, 360)) * 7) + ap.Vec3(0, 2.5, 0)
            var s = Shot(u.id, a, from, unit(o.body.center() - from) * a.shot_speed, 2.0)
            shots.push(s)
            sound_at(snd_shimmer, from, 0.3 if not down else 0.5, 1.6 if not down else 1.0)
        end
    else if k == roster.MECH_DEADBOLT do
        door_clock += 1
        var pulling = door_clock % 180 > 110
        if pulling and o.state != STATE_DOWN and not wave_untouchable(o) do
            var way = unit(flat(door_at - o.body.position))
            o.knock = o.knock + way * 0.9
            if door_clock % 10 == 0 do
                sound_at(snd_wisp, door_at, 0.5, 0.5)
            end
            if ap.chance(0.5) do
                spark(o.body.center() + scatter(0.4), way * 6, m.glow, 0.25, 0.05, 0)
            end
        end
        if o.state != STATE_DOWN and flat_distance(o.body.position, door_at) < 1.3 and o.safe == 0 and not wave_untouchable(o) do
            wave_hurt(u, o, 10, "THE DOOR", m.glow)
            o.knock = unit(flat(o.body.position - door_at)) * 14
            wave_stun(o, 30)
            o.safe = 40
            u.bar = math.min(u.bar + 1, u.kit.bar_max)
            sound_at(snd_heavy, door_at, 0.8, 0.5)
        end
    else if k == roster.MECH_RAVEN do
        for g in everyone() do
            bad_omen(g, u)
        end
    end
    if fire_left > 0 and fire_owner == u.id do
        fire_left -= 1
        for g in everyone() do
            if g.state == STATE_DOWN or g.dive > 0 do
                continue
            end
            var rate = 1.2 if g.id == u.id else 2.4
            g.health -= rate * dt
            if g.id != u.id do
                g.round_hurt += rate * dt
            end
        end
        if ap.chance(0.8) do
            spark(cam_focus + ap.Vec3(ap.random(-10, 10), 0.1, ap.random(-10, 10)), ap.Vec3(ap.random(-0.3, 0.3), ap.random(1, 3), ap.random(-0.3, 0.3)),
                ap.Color(255, 150, 50) if ap.chance(0.6) else ap.Color(255, 220, 120), 0.6, 0.12, -1)
        end
    end
end

function symphony_note(bool down) returns roster.Attack
    var a = roster.fire("Symphony", 6 if down else 3, 1, 1, roster.SHOT_NOTE, 14, 16 if down else 10, 2, roster.ANIM_SHOOT)
    a.homing = 70
    a.blast = 1.4 if down else 0
    return a
end

# BAD OMEN: whoever presses too hard is mobbed.
function bad_omen(Fighter g, Fighter raven)
    var dt = 1.0 / 60
    if g.state == STATE_DOWN do
        return
    end
    var toward = foe_of(g)
    var closing = dot3(flat(g.body.velocity), unit(flat(toward.body.position - g.body.position)))
    if closing > 3 do
        g.aggro += 0.3 * dt
    end
    g.aggro = math.max(g.aggro - 0.3 * dt, 0.0)
    if g.id == raven.id do
        g.aggro = math.max(g.aggro - 0.15 * dt, 0.0)
    end
    if g.aggro > 1.0 do
        g.aggro -= 0.7
        say(g.body.top() + ap.Vec3(0, 0.5, 0), "THE RAVENS", raven.kit.look.accent)
        wave_hurt(raven, g, 6, "", raven.kit.look.accent)
        g.slow = math.max(g.slow, 1.0)
        sound_at(snd_ambush, g.body.position, 0.6, 1.3)
        later(snd_bite, g.body.position, 3, 0.5, 1.5)
        for i in 0..<16 do
            var from = g.body.top() + scatter(2) + ap.Vec3(0, 2, 0)
            streak(from, (g.body.center() - from) * 4, ap.Color(30, 28, 38), 0.3, 0.4, 0.07)
        end
    end
end

# A super's place is gone.
function wave_super_over(Fighter f, roster.Maximum m)
    var k = mech(f)
    var o = foe_of(f)
    Thing[] kept = []
    for t in things do
        if not t.super_only or t.owner != f.id do
            kept.push(t)
        end
    end
    things = kept
    Prop[] standing = []
    var felled = false
    for pr in props do
        if pr.kind == PROP_TREE and pr.owner == f.id do
            felled = true
            smoke(pr.position + ap.Vec3(0, 1, 0), 6, 0.6, 1.0)
        else do
            standing.push(pr)
        end
    end
    if felled do
        props = standing
        world = build_world()
    end
    if k == roster.MECH_HAMMERHEAD do
        f.under = false
        f.fade = 1
        for g in everyone() do
            if g.drag > 0 do
                # Let go before the air ran out: stunned, still bleeding.
                g.drag = 0
                wave_stun(g, 60)
                g.poison = math.min(g.poison + 3, roster.POISON_LIMIT)
                say(g.body.top(), "GASP", ap.WHITE)
                sound_at(snd_surface, g.body.position, 0.8, 0.9)
            end
        end
    else if k == roster.MECH_UNDERTAKER do
        for g in everyone() do
            if g.coffin != 0 do
                open_coffin(g)
            end
        end
    else if k == roster.MECH_CONDUCTOR do
        # The fare: so much a second of the ride, less if the brake was pulled.
        var seconds = double(train_ride) / 60
        var fine = seconds * 4.8 * (0.6 if train_pulled else 1.0)
        announce_line("FINAL DESTINATION. TICKETS, PLEASE.")
        for g in foes_of_side(f.id) do
            wave_hurt(f, g, fine, "FINED", f.kit.look.accent)
        end
        sound_at(snd_coin_drop, o.body.position, 0.8, 0.8)
        later(snd_lock, o.body.position, 4, 0.7, 2.0)
        ap.stop(train_hum)
        train_hum = -1
        train_ride = 0
        train_brake = -1
        train_pulled = false
    else if k == roster.MECH_HOLLOW do
        # The form it is in is kept, and the armor starts falling off again from now.
        f.form_ticks = 0
        set_shed_move(f)
    else if k == roster.MECH_MOTH do
        if f.dive > 0 do
            f.dive = DIVE_AIM
            update_dive(f, o)
        end
        fire_left = 0
    else if k == roster.MECH_HUNTER do
        f.fade = 1
    end
end

# CLOCKWORK's STOP THE CLOCK: whether `g` gets to move this tick.
function wave_steps(Fighter g) returns bool
    var c = wave_super_user(roster.MECH_CLOCKWORK)
    if c == null or max_cut > 0 do
        return true
    end
    var u = c as Fighter
    if g.id == u.id do
        return true
    end
    return ticks % mx(u).foe_slowmo == 0
end

# CLOCKWORK's wind: the pace runs this much faster than the one set.
function tick_time()
    if time_left > 0 do
        time_left -= 1
        if time_left == 0 do
            time_scale = 1
            sound_at(snd_lock, cam_focus, 0.5, 1.0)
        end
    end
end

# --- The CPU ---------------------------------------------------------------------------------------
# Whether a second-wave move makes sense for the CPU right now (KIND_WAVE moves and supers' G).
function wave_cpu_fits(Fighter f, Fighter o, roster.Attack a, double gap, bool seen) returns bool
    var sp = a.special
    if sp == roster.SP_RESHUFFLE do
        return f.card < 8
    else if sp == roster.SP_VERDICT do
        return f.round_hurt > 30 or super_left(f) < 120
    else if sp == roster.SP_TURRET or sp == roster.SP_COIL do
        return seen and gadget_count(f.id) < 3 and gap > 2.5
    else if sp == roster.SP_TRAP do
        return seen and gap < 5 and gadget_count(f.id) < 3
    else if sp == roster.SP_OVERCLOCK do
        return gadget_count(f.id) >= 2
    else if sp == roster.SP_GRAVE do
        return count_things(f.id, TH_GRAVE) < 3 and gap < 6
    else if sp == roster.SP_EXHUME do
        for t in things do
            if t.kind == TH_GRAVE and t.owner == f.id and flat_distance(t.position, o.body.position) < 2 do
                return true
            end
        end
        return false
    else if sp == roster.SP_GRAVEWALK do
        return count_things(f.id, TH_GRAVE) > 0 and gap > 6
    else if sp == roster.SP_COFFIN do
        return o.state == STATE_HURT and not o.stun_basic or super_left(f) < 200
    else if sp == roster.SP_POOL do
        return gap < 4 and not in_pool(f, f.id)
    else if sp == roster.SP_UNDERTOW do
        return in_pool(o, f.id) and gap > 2
    else if sp == roster.SP_DRAG_UNDER do
        return gap < 3.5
    else if sp == roster.SP_BUY do
        return f.potion == 0 and f.bar >= double(a.potion) and ap.chance(0.5)
    else if sp == roster.SP_SELL do
        return f.potion > 0 and (super_left(f) < 400 or ap.chance(0.3))
    else if sp == roster.SP_DECOY do
        return gap < 6 and count_things(f.id, TH_DECOY) < 3
    else if sp == roster.SP_IGNITE do
        for t in things do
            if t.kind == TH_DECOY and t.owner == f.id and flat_distance(t.position, o.body.position) < 2.4 do
                return true
            end
        end
        return false
    else if sp == roster.SP_SWAPCROW do
        return f.swap_cool == 0 and (gap > 6 or o.state == STATE_ATTACK) and ap.chance(0.2)
    else if sp == roster.SP_TRACK do
        return seen and not on_track(f) and gap > 3
    else if sp == roster.SP_BRAKE do
        return f.health < f.max_health * 0.25 and train_brake < 0
    else if sp == roster.SP_EXERCISE do
        return f.bar < f.kit.bar_max and gap > 7
    else if sp == roster.SP_WIND_UP do
        return time_left == 0 and gap < 4 and f.health > o.health
    else if sp == roster.SP_WIND_DOWN do
        return time_left == 0 and f.health < o.health
    else if sp == roster.SP_LIGHT do
        return count_things(f.id, TH_LIGHT) < 2 and (o.kit.ai_range > 3 or ap.chance(0.3))
    else if sp == roster.SP_FLARE do
        for t in things do
            if t.kind == TH_LIGHT and t.owner == f.id and flat_distance(t.position, o.body.position) < 2.6 do
                return true
            end
        end
        return false
    else if sp == roster.SP_DIVE do
        return f.dive == 0
    else if sp == roster.SP_SHED do
        # Only in LAST STAND: strip down to hit hard, and put it all back on when it gets bad.
        if not own_super(f, roster.MECH_HOLLOW) do
            return false
        end
        if f.arm == 3 do
            return f.health < f.max_health * 0.4 and ap.chance(0.05)
        end
        return f.health > f.max_health * 0.5 and ap.chance(0.03)
    else if sp == roster.SP_DOOR do
        # One to stand behind when they close in; a second far off to slip away through.
        var doors = count_things(f.id, TH_DOOR)
        return (doors == 0 and gap < 4) or (doors == 1 and gap > 5 and ap.chance(0.3))
    else if sp == roster.SP_LOCKOUT do
        return seen and o.last_skill >= 0 and o.locks[o.last_skill] == 0 and gap < 10
    else if sp == roster.SP_SLAM_DOOR do
        return flat_distance(o.body.position, door_at) < DOOR_REACH
    else if sp == roster.SP_NEVERMORE do
        var marked = 0
        for v in o.omens do
            if v > 0 do
                marked += 1
            end
        end
        return marked >= 2 or super_left(f) < 200
    else if sp == SP_DRINK do
        return false
    end
    return seen
end

# The CPU's plan, bent to what its mechanic wants.
function wave_cpu(Fighter f, Fighter o, Intent want)
    var k = mech(f)
    var gap = flat_distance(f.body.position, o.body.position)
    if f.minion do
        return
    end
    if k == roster.MECH_FLASQUE do
        if f.potion > 0 and o.state == STATE_ATTACK and gap < 3 and o.move.kind == roster.KIND_STRIKE and ap.chance(0.3) do
            want.block = true
            want.basic = false
        end
        if f.potion == 0 and gap > 3 and f.state == STATE_IDLE do
            # Off after the nearest coin (or potion).
            var best = 999.0
            var spot = f.body.position
            for t in things do
                if (t.kind == TH_COIN or t.kind == TH_POTION) and not t.gone do
                    var d = flat_distance(t.position, f.body.position)
                    if d < best do
                        best = d
                        spot = t.position
                    end
                end
            end
            if best < 8 and not want.basic and want.skill == 0 do
                want.wish = unit(flat(spot - f.body.position))
            end
        end
        if f.bar >= f.kit.bar_max and max_owner < 0 and max_cut == 0 and ap.chance(0.02) do
            want.ultimate = true
        end
    else if own_super(f, roster.MECH_HUNTER) do
        want.basic = false
        want.skill = 0
        want.ultimate = false
        # Its own countdown: wave_clock is the super's running count, going up every tick.
        f.golden_wait -= 1
        if f.golden_wait <= 0 and f.state == STATE_IDLE and o.fade > 0.5 do
            want.ultimate = true
        end
    else if own_super(f, roster.MECH_HAMMERHEAD) do
        want.wish = unit(flat(o.body.position - f.body.position))
        if gap < 4 and f.state == STATE_IDLE and ap.chance(0.05) do
            want.basic = true
        end
        if gap < 3 and o.drag == 0 and ap.chance(0.02) do
            want.ultimate = true
        end
    else if own_super(f, roster.MECH_WARDEN) do
        # Round and round the cell.
        var around = unit(flat(f.body.position - cage_at))
        var side = ap.Vec3(around.z, 0, -around.x)
        if gap > 2.6 do
            want.wish = unit(side * f.strafe - around * 0.3)
        end
    end
end

# --- Drawing -----------------------------------------------------------------------------------
function wave_alpha(Fighter f, double alpha) returns double
    # Sealed in a coffin, up in the sun, or dragged under the black tide: nothing of them shows.
    if f.coffin != 0 or (f.dive > 0 and f.body.position.y > 12) or f.drag > 0 do
        return 0
    end
    if f.under do
        return 0 if not (f.state == STATE_ATTACK and f.slot == SLOT_BASIC) else alpha
    end
    return alpha
end

function draw_wave_shot(Shot s, ap.Vec3 sp, ap.Color tint, double yaw)
    var kind = s.attack.shot
    if kind == roster.SHOT_VIAL do
        ap.draw(box, sp, ap.Color(70, 90, 70), ap.Vec3(s.age * 600, yaw, 0), ap.Vec3(0.12, 0.22, 0.12))
        ap.draw(box, sp + ap.Vec3(0, 0.02, 0), tint, ap.Vec3(s.age * 600, yaw, 0), ap.Vec3(0.09, 0.14, 0.09))
    else if kind == roster.SHOT_CARD do
        ap.draw(box, sp, ap.Color(245, 245, 250), ap.Vec3(0, yaw + s.age * 1500, 0), ap.Vec3(0.2, 0.01, 0.28))
        ap.draw(box, sp + ap.Vec3(0, 0.01, 0), tint, ap.Vec3(0, yaw + s.age * 1500, 0), ap.Vec3(0.08, 0.012, 0.12))
    else if kind == roster.SHOT_KEYBOLT do
        # An iron key loosed from the crossbow, flying straight: the bit first, the shank, the
        # ring of the bow trailing. No shaft, no fletching.
        var iron = ap.Color(150, 140, 120)
        var way = unit(s.velocity)
        ap.draw(box, sp, iron, ap.Vec3(0, yaw, 0), ap.Vec3(0.05, 0.05, 0.42))
        ap.draw(box, sp + way * 0.17 + ap.Vec3(0, -0.05, 0), iron, ap.Vec3(0, yaw, 0), ap.Vec3(0.04, 0.1, 0.08))
        ap.draw(box, sp - way * 0.25, tint, ap.Vec3(0, yaw, 0), ap.Vec3(0.04, 0.16, 0.16))
        ap.draw(box, sp - way * 0.25, ap.Color(20, 18, 16), ap.Vec3(0, yaw, 0), ap.Vec3(0.05, 0.08, 0.08))
    else if kind == roster.SHOT_ARROW do
        ap.draw(box, sp, ap.Color(140, 100, 60), ap.Vec3(0, yaw, 0), ap.Vec3(0.04, 0.04, 0.6))
        ap.draw(box, sp + unit(s.velocity) * 0.3, ap.Color(200, 200, 210), ap.Vec3(0, yaw, 0), ap.Vec3(0.07, 0.07, 0.1))
        ap.draw(box, sp - unit(s.velocity) * 0.26, tint.fade(0.8), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 0.02, 0.1))
    else if kind == roster.SHOT_NOTE do
        ap.draw(ball, sp, tint, ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.16, 0.2))
        ap.draw(box, sp + ap.Vec3(0.08, 0.18, 0), tint, ap.Vec3(0, 0, 0), ap.Vec3(0.03, 0.34, 0.03))
        ap.draw(box, sp + ap.Vec3(0.14, 0.32, 0), tint, ap.Vec3(0, 0, -30), ap.Vec3(0.12, 0.03, 0.03))
    else if kind == roster.SHOT_EMBER do
        ap.draw(ball, sp, ap.Color(255, 250, 220), ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.12, 0.12))
        ap.draw(ball, sp, tint.fade(0.4), ap.Vec3(0, 0, 0), ap.Vec3(0.34, 0.34, 0.34))
    else if kind == roster.SHOT_POTION do
        var c = POTION_COLORS[s.attack.potion] if s.attack.potion > 0 else POTION_COLORS[1 + int(s.age * 7) % 4]
        ap.draw(ball, sp, c, ap.Vec3(0, 0, 0), ap.Vec3(0.24, 0.24, 0.24))
        ap.draw(box, sp + ap.Vec3(0, 0.15, 0), ap.Color(150, 110, 70), ap.Vec3(0, 0, 0), ap.Vec3(0.06, 0.08, 0.06))
    else if kind == roster.SHOT_ANCHOR do
        ap.lighting(true)
        var metal = ap.Color(110, 80, 60)
        ap.draw(box, sp, metal, ap.Vec3(s.age * 400, yaw, 0), ap.Vec3(0.12, 0.8, 0.12))
        ap.draw(box, sp - ap.Vec3(0, 0.36, 0), metal, ap.Vec3(s.age * 400, yaw, 0), ap.Vec3(0.7, 0.12, 0.12))
        ap.lighting(false)
    else if kind == roster.SHOT_DUMBBELL do
        ap.lighting(true)
        ap.draw(box, sp, ap.Color(140, 140, 150), ap.Vec3(s.age * 700, yaw, 0), ap.Vec3(0.06, 0.7, 0.06))
        ap.draw(ball, sp + ap.Vec3(0, 0.3, 0), ap.Color(60, 60, 66), ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        ap.draw(ball, sp - ap.Vec3(0, 0.3, 0), ap.Color(60, 60, 66), ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        ap.lighting(false)
    else do
        ap.draw(ball, sp, tint, ap.Vec3(0, 0, 0), ap.Vec3(0.24, 0.24, 0.24))
    end
end

# A fighter's look as a stand-in: a decoy or a copy in the corn.
function draw_standin(Fighter owner, ap.Vec3 at, double yaw, double sway, double alpha)
    var pose = puppet.make_pose(owner.kit.look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, sway)
    puppet.draw(rig, owner.kit.look, pose, at, yaw, alpha)
end

function wave_draw()
    var t = draw_clock()
    var casting = ap.casting_shadows()
    for th in things do
        if th.gone do
            continue
        end
        var owner = fighters[th.owner]
        var tint = owner.kit.look.accent
        var at = th.position
        var metal = ap.Color(120, 110, 96)
        if th.kind == TH_TURRET do
            ap.draw(disc, at + ap.Vec3(0, 0.15, 0), metal.brightness(0.7), ap.Vec3(0, 0, 0), ap.Vec3(0.6, 0.3, 0.6))
            ap.draw(box, at + ap.Vec3(0, 0.55, 0), metal, ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.6, 0.12))
            ap.draw(box, at + ap.Vec3(0, 0.95, 0), metal.brightness(1.2), ap.Vec3(0, th.yaw, 0), ap.Vec3(0.32, 0.26, 0.5))
            ap.draw(box, at + ap.Vec3(0, 0.95, 0) + forward_of(th.yaw) * 0.38, ap.Color(50, 46, 40), ap.Vec3(0, th.yaw, 0), ap.Vec3(0.08, 0.08, 0.4))
            if not casting do
                glow_light(at + ap.Vec3(0, 1.1, 0) - forward_of(th.yaw) * 0.12, 0.08, tint)
            end
        else if th.kind == TH_TRAP do
            ap.draw(disc, at + ap.Vec3(0, 0.03, 0), metal.brightness(0.6), ap.Vec3(0, 0, 0), ap.Vec3(0.7, 0.05, 0.7))
            for k in 0..<8 do
                var a = double(k) * 45
                ap.draw(box, at + forward_of(a) * 0.32 + ap.Vec3(0, 0.1, 0), metal, ap.Vec3(0, a, 0), ap.Vec3(0.05, 0.16, 0.05))
            end
            if not casting and th.clock > 40 and (th.clock // 20) % 2 == 0 do
                glow_light(at + ap.Vec3(0, 0.08, 0), 0.07, tint)
            end
        else if th.kind == TH_COIL do
            ap.draw(disc, at + ap.Vec3(0, 0.1, 0), metal.brightness(0.6), ap.Vec3(0, 0, 0), ap.Vec3(0.5, 0.2, 0.5))
            for k in 0..<5 do
                ap.draw(disc, at + ap.Vec3(0, 0.3 + double(k) * 0.18, 0), ap.Color(190, 120, 60), ap.Vec3(0, 0, 0), ap.Vec3(0.32, 0.06, 0.32))
            end
            if not casting do
                glow_light(at + ap.Vec3(0, 1.3, 0), 0.24 + 0.05 * math.sin(t * 0.5), tint)
            end
        else if th.kind == TH_WALKER do
            var step = math.sin(t * 0.6) * 0.15
            ap.draw(box, at + ap.Vec3(0, 0.7, 0), metal, ap.Vec3(0, th.yaw, 0), ap.Vec3(0.6, 0.5, 0.6))
            ap.draw(box, at + ap.Vec3(0, 0.25, 0) + right_of(th.yaw) * 0.2 + forward_of(th.yaw) * step, metal.brightness(0.7), ap.Vec3(0, th.yaw, 0), ap.Vec3(0.1, 0.5, 0.1))
            ap.draw(box, at + ap.Vec3(0, 0.25, 0) - right_of(th.yaw) * 0.2 - forward_of(th.yaw) * step, metal.brightness(0.7), ap.Vec3(0, th.yaw, 0), ap.Vec3(0.1, 0.5, 0.1))
            if not casting do
                glow_light(at + ap.Vec3(0, 0.75, 0) + forward_of(th.yaw) * 0.31, 0.12, ap.Color(255, 60, 40) if (th.clock // 8) % 2 == 0 else tint)
            end
        else if th.kind == TH_GRAVE do
            var stone_color = ap.Color(120, 120, 126)
            var rise = math.min(double(th.clock) / 12, 1.0)
            ap.draw(box, at + ap.Vec3(0, 0.55 * rise, 0), stone_color, ap.Vec3(-4, th.yaw, 0), ap.Vec3(0.7, 1.1 * rise, 0.18))
            ap.draw(box, at + ap.Vec3(0, 1.1 * rise, 0), stone_color, ap.Vec3(-4, th.yaw, 90), ap.Vec3(0.18, 0.7, 0.7 * rise))
            ap.draw(box, at + ap.Vec3(0, 0.03, 0) + forward_of(th.yaw) * 0.6, ap.Color(60, 46, 36), ap.Vec3(0, th.yaw, 0), ap.Vec3(0.8, 0.06, 1.2))
            if not casting do
                glow_light(at + ap.Vec3(0, 0.7, 0) + forward_of(th.yaw) * 0.1, 0.06, tint)
            end
        else if th.kind == TH_HANDS do
            if not casting do
                var grow = double(th.clock) / 42
                ap.lighting(false)
                ap.draw(disc, at + ap.Vec3(0, 0.03, 0), tint.fade(0.3 + 0.3 * grow), ap.Vec3(0, 0, 0), ap.Vec3(1.4, 0.02, 1.4))
                for k in 0..<5 do
                    var a = double(k) * 72 + t
                    ap.draw(box, at + forward_of(a) * 0.6 + ap.Vec3(0, 0.3 * grow, 0), tint.fade(0.6), ap.Vec3(0, a, 0), ap.Vec3(0.1, 0.6 * grow, 0.1))
                end
                ap.lighting(true)
            end
        else if th.kind == TH_POOL do
            if not casting do
                ap.lighting(false)
                var shimmer = 0.32 + 0.06 * math.sin(t * 0.08 + at.x)
                ap.draw(disc, at + ap.Vec3(0, 0.04, 0), ap.Color(50, 130, 160).fade(shimmer), ap.Vec3(0, 0, 0), ap.Vec3(th.value, 0.02, th.value))
                ap.lighting(true)
            end
        else if th.kind == TH_COIN do
            var bob = 0.35 + 0.08 * math.sin(t * 0.08 + at.x)
            ap.draw(disc, at + ap.Vec3(0, bob, 0), ap.Color(255, 206, 70), ap.Vec3(90, t * 3, 0), ap.Vec3(0.3, 0.05, 0.3))
        else if th.kind == TH_POTION do
            var bob = 0.4 + 0.08 * math.sin(t * 0.08 + at.x)
            if not casting do
                glow_light(at + ap.Vec3(0, bob, 0), 0.26, POTION_COLORS[int(th.value)])
            end
            ap.draw(box, at + ap.Vec3(0, bob + 0.2, 0), ap.Color(150, 110, 70), ap.Vec3(0, 0, 0), ap.Vec3(0.08, 0.12, 0.08))
        else if th.kind == TH_DECOY do
            draw_standin(owner, at, th.yaw, 0.8, 1)
        else if th.kind == TH_DOOR do
            draw_locked_door(th, tint)
        else if th.kind == TH_COPY do
            draw_standin(owner, at, th.yaw, h01(int(at.x * 10), 7) * 6, 1)
        else if th.kind == TH_TRACK do
            draw_track(th)
        else if th.kind == TH_LIGHT do
            if not casting do
                var pulse = 0.3 + 0.05 * math.sin(t * 0.2)
                glow_light(at, pulse, ap.Color(255, 250, 220))
                glow_light(at, pulse * 3, tint.fade(0.18))
            end
        end
    end
    for g in everyone() do
        draw_wave_marks(g)
    end
    var hunter = wave_super_user(roster.MECH_HUNTER)
    if hunter != null and not casting do
        var h = hunter as Fighter
        if not h.cpu and h.state == STATE_ATTACK and h.move.special == roster.SP_GOLDEN do
            # The laser sight: only she sees it.
            var from = puppet.muzzle(h.kit.look, drawn_at(h), drawn_heading(h))
            var way = forward_of(drawn_heading(h))
            var far = 0.0
            if tree_group > 0 do
                world.enable(tree_group, false)
            end
            while far < 30 and not world.overlaps(from + way * (far + 0.3), 0.05) do
                far += 0.3
            end
            if tree_group > 0 do
                world.enable(tree_group, true)
            end
            ap.lighting(false)
            ap.draw(box, from + way * (far / 2), ap.Color(255, 40, 30).fade(0.6), ap.Vec3(0, drawn_heading(h), 0), ap.Vec3(0.02, 0.02, far))
            ap.draw(ball, from + way * far, ap.Color(255, 60, 40), ap.Vec3(0, 0, 0), ap.Vec3(0.12, 0.12, 0.12))
            ap.lighting(true)
        end
    end
end

function glow_light(ap.Vec3 at, double size, ap.Color color)
    ap.lighting(false)
    ap.draw(ball, at, color, ap.Vec3(0, 0, 0), ap.Vec3(size, size, size))
    ap.lighting(true)
end

function draw_track(Thing th)
    var from = th.position
    var to = th.aim
    var way = flat(to - from)
    var long = way.length()
    if long < 0.3 do
        return
    end
    var dir = unit(way)
    var yaw = heading_of(dir)
    var across = right_of(yaw)
    var fade = math.min(double(th.life) / 60, 1.0) if th.life > 0 else 1.0
    var wood = ap.Color(90, 64, 40).fade(fade)
    var steel = ap.Color(170, 170, 180).fade(fade)
    var n = int(long / 0.6)
    for k in 0..<n do
        ap.draw(box, from + dir * (double(k) * 0.6 + 0.3) + ap.Vec3(0, 0.03, 0), wood, ap.Vec3(0, yaw + 90, 0), ap.Vec3(1.2, 0.06, 0.2))
    end
    for side in [-1.0, 1.0] do
        ap.draw(box, from + way * 0.5 + across * (0.38 * side) + ap.Vec3(0, 0.08, 0), steel, ap.Vec3(0, yaw, 0), ap.Vec3(0.06, 0.06, long))
    end
end

# What hangs over a fighter: ailments, omens, locks, the chain, the coffin, the water.
function draw_wave_marks(Fighter g)
    if g.state == STATE_DOWN do
        return
    end
    var casting = ap.casting_shadows()
    var at = drawn_at(g)
    var top = at + ap.Vec3(0, g.body.height + 0.5, 0)
    if not casting do
        ap.lighting(false)
        var n = 0
        for k in 0..<3 do
            if g.ailments[k] > 0 do
                ap.draw(ball, top + right_of(cam_yaw) * (double(n) * 0.22 - 0.22), AIL_COLORS[k], ap.Vec3(0, 0, 0), ap.Vec3(0.14, 0.14, 0.14))
                n += 1
            end
        end
        for k in 0..<4 do
            if g.omens[k] > 0 do
                var spin = draw_clock() * 4 + double(k) * 90
                ap.draw(box, top + ap.Vec3(0, 0.25, 0) + forward_of(spin) * 0.35, ap.Color(30, 28, 40), ap.Vec3(0, spin, 0), ap.Vec3(0.05, 0.02, 0.28))
                ap.draw(box, top + ap.Vec3(0, 0.26, 0) + forward_of(spin) * 0.35, ap.Color(160, 120, 255), ap.Vec3(0, spin, 0), ap.Vec3(0.02, 0.02, 0.28))
            end
        end
        if g.necrosis > 0 do
            ap.draw(disc, at + ap.Vec3(0, 0.05, 0), ap.Color(90, 140, 100).fade(0.35), ap.Vec3(0, 0, 0), ap.Vec3(0.9, 0.02, 0.9))
        end
        if g.punched do
            ap.draw(box, top + ap.Vec3(0, 0.1, 0), ap.Color(255, 230, 160), ap.Vec3(0, cam_yaw, 0), ap.Vec3(0.3, 0.16, 0.02))
        end
        var locked = false
        for v in g.locks do
            locked = locked or v > 0
        end
        if locked do
            ap.draw(box, top + ap.Vec3(0, 0.45, 0), ap.Color(230, 200, 110), ap.Vec3(0, draw_clock() * 2, 0), ap.Vec3(0.2, 0.16, 0.08))
        end
        if mech(g) == roster.MECH_MAESTRO do
            # The beat, swelling round him.
            var off = double(beat_off(g)) / double(BEAT) / 2
            var r = 0.55 + 0.25 * (1 - off)
            for i in 0..<12 do
                var a = double(i) * 30
                ap.draw(box, at + forward_of(a) * r + ap.Vec3(0, 0.05, 0), g.kit.look.accent.fade(0.6 * (1 - off) + 0.1), ap.Vec3(0, a, 0), ap.Vec3(0.18, 0.02, 0.04))
            end
        end
        if mech(g) == roster.MECH_FLASQUE and not g.cpu do
            # The arrow under her feet, toward the nearest coin: hers alone.
            var best = 999.0
            var spot = at
            for th in things do
                if (th.kind == TH_COIN or th.kind == TH_POTION) and not th.gone do
                    var d = flat_distance(th.position, at)
                    if d < best do
                        best = d
                        spot = th.position
                    end
                end
            end
            if best < 999 and best > 1 do
                var yaw = heading_of(spot - at)
                ap.draw(box, at + forward_of(yaw) * 0.8 + ap.Vec3(0, 0.05, 0), MAX_GOLD.fade(0.8), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 0.02, 0.5))
                # The head: two barbs that meet at the tip and sweep back from it.
                var tip = at + forward_of(yaw) * 1.1 + ap.Vec3(0, 0.05, 0)
                for side in [-1.0, 1.0] do
                    var back = forward_of(yaw + 180 + side * 38)
                    ap.draw(box, tip + back * 0.14, MAX_GOLD.fade(0.8), ap.Vec3(0, yaw + side * 38, 0), ap.Vec3(0.1, 0.02, 0.3))
                end
            end
        end
        if mech(g) == roster.MECH_FLASQUE and g.potion > 0 do
            ap.draw(ball, puppet.muzzle(g.kit.look, at, drawn_heading(g)) + ap.Vec3(0, 0.1, 0), POTION_COLORS[g.potion], ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.2, 0.2))
        end
        if g.dive > 0 and g.dive >= DIVE_RISE and not g.cpu do
            var r = 3.2
            for i in 0..<24 do
                var a = double(i) * 15 + draw_clock() * 2
                ap.draw(box, g.dive_aim + forward_of(a) * r + ap.Vec3(0, 0.06, 0), g.kit.look.accent, ap.Vec3(0, a, 0), ap.Vec3(0.5, 0.03, 0.06))
            end
        end
        ap.lighting(true)
    end
    if g.chained > 0 do
        var anchor = g.anchor
        ap.draw(box, anchor + ap.Vec3(0, 0.25, 0), ap.Color(80, 76, 72), ap.Vec3(0, 0, 0), ap.Vec3(0.14, 0.5, 0.14))
        var hand = at + ap.Vec3(0, 0.9, 0)
        var span = hand - (anchor + ap.Vec3(0, 0.4, 0))
        var links = int(span.length() / 0.2)
        for k in 0..<links do
            var p = anchor + ap.Vec3(0, 0.4, 0) + span * (double(k) / double(math.max(links, 1)))
            p = p - ap.Vec3(0, math.sin(double(k) / double(math.max(links, 1)) * math.PI) * 0.3, 0)
            ap.draw(box, p, ap.Color(120, 118, 120), ap.Vec3(0, heading_of(span) + (90.0 if k % 2 == 0 else 0.0), 0), ap.Vec3(0.06, 0.04, 0.14))
        end
    end
    if g.coffin != 0 do
        var lid = ap.Color(70, 46, 30)
        var yaw = drawn_heading(g)
        ap.draw(box, at + ap.Vec3(0, 1.0, 0), lid, ap.Vec3(0, yaw, 0), ap.Vec3(0.9, 2.1, 0.6))
        ap.draw(box, at + ap.Vec3(0, 1.0, 0) + forward_of(yaw) * 0.31, lid.brightness(0.8), ap.Vec3(0, yaw, 0), ap.Vec3(0.8, 1.9, 0.04))
        ap.draw(box, at + ap.Vec3(0, 1.4, 0) + forward_of(yaw) * 0.34, ap.Color(180, 170, 150), ap.Vec3(0, yaw, 0), ap.Vec3(0.08, 0.5, 0.02))
        ap.draw(box, at + ap.Vec3(0, 1.5, 0) + forward_of(yaw) * 0.34, ap.Color(180, 170, 150), ap.Vec3(0, yaw, 0), ap.Vec3(0.3, 0.08, 0.02))
    end
    if g.under do
        # Only the fin shows above the black water.
        var yaw = drawn_heading(g)
        ap.draw(box, ap.Vec3(at.x, 1.25, at.z), ap.Color(70, 90, 100), ap.Vec3(0, yaw, 0), ap.Vec3(0.06, 0.5, 0.4))
        ap.draw(box, ap.Vec3(at.x, 1.5, at.z) - forward_of(yaw) * 0.1, ap.Color(70, 90, 100), ap.Vec3(0, yaw, 0), ap.Vec3(0.05, 0.2, 0.22))
    end
end

# CONDUCTOR's train starts braking: the squeal of the wheels, `loud` for how hard.
function start_train_brake(double loud)
    train_brake = 0
    ap.stop(train_hum)
    train_hum = snd_brake_squeal.play_at(cam_focus + ap.Vec3(0, -0.5, 0), 0.5 * loud, 1.0, 6, 0)
    snd_brake_squeal2.play_at(cam_focus - train_axis * 3, 0.35 * loud, ap.random(0.97, 1.03), 6, 0)
    later(snd_creak, cam_focus, 6, 0.5 * loud, 0.6)
end

# The places that move with the fight rather than the scenery: the cell, the door, the train.
function wave_set_pieces()
    var t = draw_clock()
    if wave_super(roster.MECH_WARDEN) do
        var bar = ap.Color(60, 60, 66)
        for i in 0..<36 do
            var a = double(i) * 10
            var at = cage_at + forward_of(a) * CAGE_RADIUS
            ap.draw(box, at + ap.Vec3(0, 1.6, 0), bar, ap.Vec3(0, a, 0), ap.Vec3(0.07, 3.2, 0.07))
        end
        for h in [0.1, 3.2] do
            for i in 0..<18 do
                var a = double(i) * 20
                ap.draw(box, cage_at + forward_of(a + 10) * CAGE_RADIUS + ap.Vec3(0, h, 0), bar, ap.Vec3(0, a + 100, 0), ap.Vec3(1.2, 0.1, 0.1))
            end
        end
        ap.draw(disc, cage_at + ap.Vec3(0, 3.3, 0), ap.Color(40, 40, 44), ap.Vec3(0, 0, 0), ap.Vec3(CAGE_RADIUS, 0.06, CAGE_RADIUS))
    end
    if wave_super(roster.MECH_DEADBOLT) do
        var yaw = heading_of(flat(cam_focus - door_at))
        var wood = ap.Color(60, 40, 30)
        var open = 0.5 + 0.4 * math.sin(t * 0.04)
        if door_clock % 180 > 110 do
            open = 1
        end
        ap.draw(box, door_at + ap.Vec3(0, 1.6, 0) - forward_of(yaw) * 0.1, ap.Color(30, 26, 24), ap.Vec3(0, yaw, 0), ap.Vec3(2.2, 3.4, 0.3))
        ap.lighting(false)
        ap.draw(box, door_at + ap.Vec3(0, 1.5, 0), ap.Color(255, 230, 160).fade(0.5 + 0.4 * open), ap.Vec3(0, yaw, 0), ap.Vec3(1.6, 3.0, 0.05))
        ap.lighting(true)
        ap.push_3d()
        ap.translate_3d(door_at - right_of(yaw) * 0.8 + ap.Vec3(0, 1.5, 0))
        ap.rotate_3d(yaw - 100 * open, ap.Vec3(0, 1, 0))
        ap.draw(box, right_of(0) * 0.8, wood, ap.Vec3(0, 0, 0), ap.Vec3(1.6, 3.0, 0.12))
        ap.draw(box, right_of(0) * 1.3 + ap.Vec3(0, 0, 0.1), ap.Color(200, 170, 90), ap.Vec3(0, 0, 0), ap.Vec3(0.14, 0.14, 0.1))
        ap.pop_3d()
    end
    if wave_super(roster.MECH_CONDUCTOR) do
        draw_carriage()
    end
end

# CONDUCTOR's FINAL DESTINATION: the inside of the last train, running through the night.
# Everything is laid out along `train_axis`: `along` meters down the carriage, `side` meters across
# (the walls stand at +-CAR_HALF), `y` up.
const double CAR_HALF = 1.85
const double CAR_ROOF = 3.3

function on_train() returns bool
    return wave_super(roster.MECH_CONDUCTOR) and max_cut == 0 and merge_owner < 0
end

# A box in the carriage's own frame.
function car_box(double along, double side, double y, double w, double h, double l, ap.Color color)
    var yaw = heading_of(train_axis)
    ap.draw(box, train_axis * along + right_of(yaw) * side + ap.Vec3(0, y, 0), color, ap.Vec3(0, yaw, 0), ap.Vec3(w, h, l))
end

function car_glow(double along, double side, double y, double w, double h, double l, ap.Color color)
    ap.lighting(false)
    car_box(along, side, y, w, h, l, color)
    ap.lighting(true)
end

function train_speed() returns double
    if train_brake < 0 do
        return 1.0
    end
    # Eased, so it comes in gently rather than stopping dead.
    var t = math.min(double(train_brake) / double(TRAIN_BRAKE), 1.0)
    return 1 - t * t * (3 - 2 * t)
end

# How far the outside has run past, in meters (it slows to a stop under the brake).
var train_run = 0.0

function draw_carriage()
    var t = draw_clock()
    var casting = ap.casting_shadows()
    var long = 2 * ARENA
    var wood = ap.Color(92, 56, 34)
    var dark_wood = ap.Color(58, 34, 22)
    var panel = ap.Color(118, 38, 34)
    var brass = ap.Color(210, 170, 80)
    var velvet = ap.Color(140, 30, 44)
    # The floor: boards, and a runner down the middle.
    car_box(0, 0, 0.01, 2 * CAR_HALF + 0.2, 0.04, long, dark_wood)
    for k in 0..<9 do
        car_box(0, -CAR_HALF + 0.2 + double(k) * 0.42, 0.035, 0.02, 0.02, long, ap.Color(40, 24, 16))
    end
    car_box(0, 0, 0.04, 1.1, 0.02, long, ap.Color(120, 24, 34))
    car_box(0, 0.5, 0.045, 0.06, 0.02, long, brass.brightness(0.7))
    car_box(0, -0.5, 0.045, 0.06, 0.02, long, brass.brightness(0.7))
    for side in [-1.0, 1.0] do
        var wall = CAR_HALF * side
        # Below the windows: wood, with a brass rail along the top.
        car_box(0, wall, 0.6, 0.12, 1.2, long, wood)
        car_box(0, wall - side * 0.07, 1.2, 0.06, 0.06, long, brass)
        car_box(0, wall - side * 0.07, 0.12, 0.04, 0.2, long, dark_wood)
        # Above them: the red panel, and the curve of the roof.
        car_box(0, wall, 2.85, 0.12, 0.9, long, panel)
        car_box(0, wall - side * 0.25, CAR_ROOF - 0.08, 0.5, 0.12, long, panel.brightness(0.8))
        car_box(0, wall - side * 0.07, 2.42, 0.06, 0.05, long, brass)
        # Window pillars, the seats between them, and the luggage rack above.
        for k in 0..<10 do
            var along = -ARENA + 1 + double(k) * 2.1
            car_box(along, wall, 1.8, 0.16, 1.2, 0.26, wood)
            car_box(along + 1.05, side * 1.38, 0.45, 0.62, 0.14, 0.9, velvet)
            car_box(along + 1.05, side * 1.62, 0.92, 0.14, 0.86, 0.9, velvet)
            car_box(along + 1.05, side * 1.62, 1.38, 0.18, 0.08, 0.92, brass.brightness(0.8))
            car_box(along + 1.05, side * 1.55, 0.2, 0.5, 0.4, 0.7, dark_wood)
            # A case or a hatbox on the rack, now and then.
            if h01(k, int(side) + 400) > 0.55 do
                car_box(along + 1.05 + (h01(k, 401) - 0.5) * 0.5, side * 1.45, 2.66, 0.36, 0.26, 0.5,
                    ap.Color(70, 52, 40) if h01(k, 402) > 0.5 else ap.Color(60, 70, 60))
            end
        end
        car_box(0, side * 1.45, 2.52, 0.5, 0.03, long, brass.brightness(0.6))
    end
    # The ceiling, its lamps, and the straps that sway with the ride.
    car_box(0, 0, CAR_ROOF, 2 * CAR_HALF + 0.2, 0.1, long + 0.2, ap.Color(80, 58, 44))
    car_box(0, 0, CAR_ROOF - 0.07, 0.5, 0.05, long, ap.Color(200, 180, 140))
    var sway = math.sin(t * 0.07) * 6 * train_speed()
    for k in 0..<6 do
        var along = -ARENA + 2 + double(k) * 3.6
        car_box(along, 0, CAR_ROOF - 0.12, 0.6, 0.06, 0.4, brass)
        if not casting do
            var flicker = 0.9 + 0.1 * math.sin(t * 0.9 + double(k) * 2.1)
            car_glow(along, 0, CAR_ROOF - 0.19, 0.44, 0.08, 0.3, ap.Color(255, 226, 160).brightness(flicker))
        end
        for side in [-1.0, 1.0] do
            # A hanging strap, swinging.
            var at = train_axis * (along + 1.8) + right_of(heading_of(train_axis)) * (0.75 * side) + ap.Vec3(0, CAR_ROOF - 0.35, 0)
            ap.draw(box, at, ap.Color(40, 30, 26), ap.Vec3(sway * side, heading_of(train_axis), 0), ap.Vec3(0.04, 0.5, 0.04))
            ap.draw(hoop, at - ap.Vec3(0, 0.3, 0), brass, ap.Vec3(sway * side, heading_of(train_axis) + 90, 90), ap.Vec3(0.12, 0.12, 0.12))
        end
    end
    # Each end: a wall with a door, its window lit by the next carriage.
    for e in [-1.0, 1.0] do
        var at = ARENA * e
        car_box(at, -1.2, 1.65, 1.3, 3.3, 0.14, panel.brightness(0.9))
        car_box(at, 1.2, 1.65, 1.3, 3.3, 0.14, panel.brightness(0.9))
        car_box(at, 0, 2.95, 1.1, 0.7, 0.14, panel.brightness(0.9))
        car_box(at + e * 0.03, 0, 1.3, 1.1, 2.6, 0.08, dark_wood)
        car_box(at - e * 0.05, 0.4, 1.2, 0.06, 0.06, 0.06, brass)
        if not casting do
            car_glow(at - e * 0.03, 0, 1.75, 0.6, 0.7, 0.03, ap.Color(255, 200, 120).fade(0.8))
        end
    end
    if casting do
        return
    end
    # Outside: the night running past the windows. `train_run` is how far the train has gone, so
    # nearer things stream by faster than far ones, and everything slows to a stop with the brake.
    var speed = train_speed()
    var run = train_run
    for side in [-1.0, 1.0] do
        car_box(0, side * 30, -0.6, 56, 0.1, 200, ap.Color(26, 24, 34))
        # The ballast beside the line, in streaks that stretch with the speed.
        for k in 0..<40 do
            var along = ((double(k) * 4.1 + h01(k, 409) * 3 - run) % 164.0 + 164.0) % 164.0 - 82.0
            car_box(along, side * (2.6 + h01(k, 410) * 4.5), -0.52, 0.25 + h01(k, 411) * 0.5, 0.04, 0.4 + speed * 2.6,
                ap.Color(64, 58, 70) if k % 3 == 0 else ap.Color(48, 44, 56))
        end
        # A second line beside this one: its rails, and its sleepers flicking past.
        car_box(0, side * 5.6, -0.48, 0.08, 0.08, 200, ap.Color(90, 90, 100))
        car_box(0, side * 6.8, -0.48, 0.08, 0.08, 200, ap.Color(90, 90, 100))
        for k in 0..<60 do
            var along = ((double(k) * 2.3 - run) % 138.0 + 138.0) % 138.0 - 69.0
            car_box(along, side * 6.2, -0.53, 1.9, 0.06, 0.3 + speed * 0.6, ap.Color(44, 34, 30))
        end
        # A fence close by, its posts whipping past.
        for k in 0..<36 do
            var along = ((double(k) * 2.5 - run) % 90.0 + 90.0) % 90.0 - 45.0
            car_box(along, side * 3.3, 0.1, 0.1, 1.4, 0.1 + speed * 0.25, ap.Color(46, 38, 34))
        end
        car_box(0, side * 3.3, 0.55, 0.04, 0.05, 90, ap.Color(46, 38, 34))
        # Telegraph poles and their wires.
        for k in 0..<8 do
            var along = ((double(k) * 18 + 7 * side - run) % 144.0 + 144.0) % 144.0 - 72.0
            car_box(along, side * 4.4, 2.5, 0.18, 6.2, 0.18, ap.Color(36, 28, 24))
            car_box(along, side * 4.4, 5.3, 1.2, 0.1, 0.1, ap.Color(36, 28, 24))
        end
        car_box(0, side * 4.4, 5.12, 0.03, 0.03, 200, ap.Color(40, 34, 40))
        # Lamps along the line: a pool of light that sweeps through the window as each goes by.
        for k in 0..<5 do
            var along = ((double(k) * 34 + 15 * side - run) % 170.0 + 170.0) % 170.0 - 85.0
            car_box(along, side * 5.0, 1.6, 0.12, 3.2, 0.12, ap.Color(40, 40, 46))
            car_glow(along, side * 4.8, 3.25, 0.4, 0.25, 0.4 + speed * 0.3, ap.Color(255, 220, 140))
            car_glow(along, side * 4.8, -0.5, 2.4, 0.04, 2.4 + speed * 2, ap.Color(120, 100, 70))
        end
        # Trees and hills, further out and slower.
        for k in 0..<14 do
            var along = ((double(k) * 15 + h01(k, 425) * 9 - run * 0.5) % 210.0 + 210.0) % 210.0 - 105.0
            var tall = 3 + h01(k, 426) * 4
            car_box(along, side * (11 + h01(k, 427) * 8), tall / 2 - 0.5, 1.8, tall, 1.8, ap.Color(24, 30, 32))
        end
        for k in 0..<10 do
            var along = ((double(k) * 26 - run * 0.12) % 260.0 + 260.0) % 260.0 - 130.0
            car_box(along, side * (45 + h01(k, 420) * 20), 2 + h01(k, 421) * 4, 24, 8 + h01(k, 422) * 10, 30, ap.Color(30, 30, 50))
            if h01(k, 423) > 0.4 do
                car_glow(along + 5, side * (32 + h01(k, 424) * 8), 1.2, 0.5, 0.4, 0.5, ap.Color(255, 200, 110).fade(0.85))
            end
        end
    end
    # The moon, keeping pace.
    ap.lighting(false)
    var moon = train_axis * 40 + right_of(heading_of(train_axis)) * -60 + ap.Vec3(0, 34, 0)
    ap.draw(ball, moon, ap.Color(240, 235, 210), ap.Vec3(0, 0, 0), ap.Vec3(8, 8, 8))
    ap.draw(ball, moon, ap.Color(240, 235, 210).fade(0.12), ap.Vec3(0, 0, 0), ap.Vec3(14, 14, 14))
    # Dust turning in the lamplight, inside the carriage only.
    for k in 0..<36 do
        var along = ((h01(k, 430) * long - t * 0.004 * (0.5 + h01(k, 431))) % long + long) % long - ARENA
        var side = (h01(k, 432) - 0.5) * 2 * (CAR_HALF - 0.3)
        var y = 0.4 + h01(k, 433) * 2.6 + math.sin(t * 0.01 + double(k)) * 0.15
        car_box(along, side, y, 0.03, 0.03, 0.03, ap.Color(255, 230, 180).fade(0.25 + 0.2 * math.sin(t * 0.03 + double(k))))
    end
    # The window glass, last of all: see-through things must come after what is seen through them.
    for side in [-1.0, 1.0] do
        car_box(0, CAR_HALF * side + side * 0.02, 1.8, 0.02, 1.15, long, ap.Color(70, 80, 120).fade(0.12))
    end
    ap.lighting(true)
end

# The HUD's extras: the card, the beat, the coins, the clock, the announcer.
function wave_overlay()
    for g in everyone() do
        if g.state == STATE_DOWN or g.minion do
            continue
        end
        var p = ap.project(drawn_at(g) + ap.Vec3(0, g.body.height + 0.95, 0))
        if mech(g) == roster.MECH_ORACLE do
            var n = g.card
            var w = 26.0
            ap.rect(p.x - w / 2, p.y - 18, w, 18, ap.Color(30, 20, 46).fade(0.85))
            ap.rect(p.x - w / 2, p.y - 18, w, 1, ap.Color(230, 190, 90))
            label_centered(NUMERALS[n], p.x, p.y - 13, 8, ap.Color(255, 230, 160) if n >= 11 else ap.Color(190, 170, 220))
        else if mech(g) == roster.MECH_STRONGMAN and g.state == STATE_ATTACK and g.charge > 0 do
            ap.rect(p.x - 16, p.y - 6, 32, 4, ap.BLACK.fade(0.7))
            ap.rect(p.x - 16, p.y - 6, 32 * g.charge, 4, g.kit.look.accent)
        else if mech(g) == roster.MECH_FLASQUE and g.potion > 0 do
            label_centered(roster.POTION_NAMES[g.potion], p.x, p.y - 10, 8, POTION_COLORS[g.potion])
        end
        if wave_super(roster.MECH_RAVEN) and g.aggro > 0.3 do
            ap.rect(p.x - 14, p.y + 2, 28, 3, ap.BLACK.fade(0.6))
            ap.rect(p.x - 14, p.y + 2, 28 * math.min(g.aggro, 1.0), 3, ap.Color(160, 120, 255))
        end
    end
    if time_left > 0 do
        var pct = int(time_scale * 100 + 0.5)
        label_centered("TIME {pct}%", VW / 2, 60, 8, ap.Color(120, 220, 255))
    end
    if wave_super(roster.MECH_CLOCKWORK) do
        label_centered("THE CLOCK HAS STOPPED", VW / 2, 60, 8, ap.Color(120, 220, 255))
    end
    if announce_ticks > 0 and screen == SCREEN_FIGHT do
        announce_ticks -= 1
        var a = math.min(double(announce_ticks) / 30, 1.0)
        var w = ap.measure(announce, 8).x + 30
        ap.rect(VW / 2 - w / 2, 252, w, 15, ap.BLACK.fade(0.7 * a))
        label_centered(announce, VW / 2, 256, 8, ap.Color(255, 220, 150).fade(a))
    end
end

# The sound and flash of a second-wave shot leaving the hand.
function wave_fire_fx(Fighter f, roster.Attack a, ap.Vec3 from, ap.Vec3 aim)
    var tint = f.kit.look.accent
    var kind = a.shot
    if kind == roster.SHOT_ARROW or kind == roster.SHOT_KEYBOLT do
        sound_at(snd_lock, from, 0.5, 1.5)
        sound_at(snd_rush, from, 0.4, 1.6)
        for i in 0..<4 do
            streak(from + aim * 0.3, unit(aim + scatter(0.1)) * 10, ap.Color(230, 220, 200), 0.08, 0.4, 0.02)
        end
    else if kind == roster.SHOT_CARD do
        sound_at(snd_card_fan, from, 0.5, ap.random(1.1, 1.4))
    else if kind == roster.SHOT_VIAL or kind == roster.SHOT_POTION do
        sound_at(snd_dash, from, 0.4, 1.3)
        later(snd_splash, from, 2, 0.2, 2.0)
    else if kind == roster.SHOT_NOTE do
        sound_at(snd_shimmer, from, 0.4, 1.2 + 0.1 * double(f.hits_done % 4))
        sound_at(snd_beam_file, from, 0.15, 2.4 + 0.2 * double(f.hits_done % 4))
    else if kind == roster.SHOT_EMBER do
        sound_at(snd_wisp, from, 0.4, 1.6)
    else if kind == roster.SHOT_ANCHOR or kind == roster.SHOT_DUMBBELL do
        sound_at(snd_dash, from, 0.6, 0.6)
        sound_at(snd_kiai, from, 0.5, 0.8)
    else do
        sound_at(snd_cast, from, 0.5)
    end
    for i in 0..<5 do
        streak(from, unit(aim + scatter(0.4)) * 4, tint, 0.14, 0.3)
    end
end

# HUNTER's forest: a trunk, roots, and a crown of leaves.
function draw_tree(Prop pr, double grown)
    var at = pr.position
    var h = pr.height * grown
    # A tree between the camera and either fighter is drawn faint, so it never hides the fight.
    var alpha = 1.0
    if not ap.casting_shadows() do
        var eye = flat(camera.position)
        for g in fighters do
            if g.state != STATE_DOWN and off_line(flat(at), eye, flat(g.body.position)) < 1.7 and
                    flat_distance(eye, at) < flat_distance(eye, g.body.position) + 0.5 do
                alpha = 0.22
            end
        end
    end
    if not ap.casting_shadows() and flat_distance(flat(camera.position), at) < 2.2 do
        # The camera is in among its branches: it is not drawn at all.
        alpha = 0.0
    end
    # Only the real pass moves the fade; the shadow pass draws it solid.
    var shown = 1.0
    if not ap.casting_shadows() do
        pr.fade = ap.approach(pr.fade, alpha, 0.08)
        shown = pr.fade
        if shown < 0.02 do
            return
        end
    end
    var bark = ap.Color(70, 52, 38).fade(shown)
    ap.draw(disc, at + ap.Vec3(0, h * 0.35, 0), bark, ap.Vec3(0, pr.yaw, 0), ap.Vec3(0.36, h * 0.7, 0.36))
    ap.draw(box, at + ap.Vec3(0, 0.1, 0), bark.brightness(0.8), ap.Vec3(0, pr.yaw, 0), ap.Vec3(1.0, 0.2, 0.16))
    ap.draw(box, at + ap.Vec3(0, 0.1, 0), bark.brightness(0.8), ap.Vec3(0, pr.yaw + 90, 0), ap.Vec3(0.9, 0.2, 0.16))
    for k in 0..<3 do
        var w = (2.8 - double(k) * 0.7) * grown
        ap.draw(rig.cone, at + ap.Vec3(0, h * (0.55 + 0.17 * double(k)), 0), ap.Color(36, 64 + k * 10, 38).fade(shown),
            ap.Vec3(0, pr.yaw, 0), ap.Vec3(w, h * 0.32, w))
    end
end

# --- The player and the CPU ----------------------------------------------------------------------

function player_intent() returns Intent
    var want = Intent()
    var a = cam_yaw * math.PI / 180
    var ahead = ap.Vec3(-math.sin(a), 0, -math.cos(a))
    var right = ap.Vec3(math.cos(a), 0, -math.sin(a))
    var input = ap.steer()
    want.wish = right * input.x - ahead * input.y
    want.basic = pad.buffered("basic", 10)
    for i in 1..<5 do
        if want.skill == 0 and pad.buffered("skill{i}", 10) do
            want.skill = i
        end
    end
    want.ultimate = pad.buffered("super", 10)
    want.dash = pad.buffered("dash", 6)
    want.block = pad.held("block")
    return want
end

# Whether a move makes sense for the CPU right now.
function cpu_fits(Fighter f, Fighter o, roster.Attack a, double gap, bool clear, bool facing, bool seen) returns bool
    var kit = f.kit
    var far = kit.ai_range > 3
    if a.kind == roster.KIND_CLOAK do
        return not f.cloaked and f.bar > kit.bar_max * 0.8 and gap > 3
    else if a.kind == roster.KIND_RELOAD do
        var left = pips(kit, f.bar)
        return left == 0 or (left <= 1 and gap > 5)
    else if a.kind == roster.KIND_FAN do
        return pips(kit, f.bar) >= 4 and clear and facing and gap < 9
    else if a.kind == roster.KIND_BUFF do
        if f.buff != roster.BUFF_NONE or not seen do
            return false
        end
        if a.buff == roster.BUFF_MIST do
            return gap < 3 and (f.health < f.max_health * 0.5 or o.state == STATE_ATTACK)
        else if a.buff == roster.BUFF_REGEN do
            return f.health < f.max_health * 0.7 and gap > 3
        else if a.buff == roster.BUFF_PARRY do
            return gap < 4
        end
        return gap < 6
    else if a.kind == roster.KIND_PORTAL do
        return seen and gap > 2 and gap < 8 and ap.chance(0.3)
    else if a.kind == roster.KIND_BLINK do
        return seen and ((far and gap < 2.5) or (not far and gap > 6))
    else if a.kind == roster.KIND_LOCK do
        # Keep a strong move; let a weak one go.
        var copied = kit.skills[0]
        var good = copied.damage * double(copied.hits) >= 12
        return good != f.copy_locked and ap.chance(0.2)
    else if a.kind == roster.KIND_SWAP do
        var range_now = kit.ai_range
        return ap.chance(0.04) or (gap > 6 and range_now < 3 and f.bar >= 2) or (gap < 2 and range_now > 3) or
            (range_now > 3 and f.bar < 1)
    else if a.kind == roster.KIND_RECALL do
        var out = 0
        for p in pickups do
            if p.owner == f.id do
                out += 1
            end
        end
        return out >= 3 or (out >= 1 and f.bar < 1)
    else if a.kind == roster.KIND_MIRROR do
        return seen and mirror_count(f.id) < 2 and gap < 9
    else if a.kind == roster.KIND_GLASS do
        return mirror_count(f.id) > 0 and o.state == STATE_ATTACK and gap < 3.5
    else if a.kind == roster.KIND_SHATTER do
        for mi in mirrors do
            if mi.owner == f.id and flat_distance(mirror_at(mi), o.body.position) < MIRROR_REACH do
                return true
            end
        end
        return false
    else if a.kind == roster.KIND_WALL do
        return seen and gap > 2.5 and gap < 5 and (o.kit.ai_range > 3 or ap.chance(0.3))
    else if a.kind == roster.KIND_SWITCH do
        return seen and gap > 3 and gap < 12 and ap.chance(0.3)
    else if a.kind == roster.KIND_WAVE do
        return wave_cpu_fits(f, o, a, gap, seen)
    else if a.kind == roster.KIND_QUIVER do
        return kit.quiver > 0 and (f.arrows == 0 or (f.arrows <= 2 and gap > 6))
    end
    if out_of_arrows(f, a) do
        return false
    end
    if a.need > f.bar do
        return false
    end
    if not seen do
        return false
    end
    if a.evade and a.damage <= 0 do
        return gap < 2.6 and (far or o.state == STATE_ATTACK)
    else if a.evade do
        return facing and gap > 2 and gap < 6
    else if a.on_trigger do
        # Spin when something is coming, or idly when a round is missing and there is room.
        var coming = o.state == STATE_ATTACK and o.frame < o.move.startup and o.move.kind == roster.KIND_STRIKE
        return (coming and gap < 9) or (f.bar < kit.bar_max and gap > 6 and ap.chance(0.25))
    else if a.counter do
        return o.state == STATE_ATTACK and o.move.shot == roster.SHOT_NONE and gap < 3
    else if a.beam > 0 do
        return clear and facing and gap < a.beam
    else if a.summon > 0 do
        return gap > 3
    else if a.skyfall do
        return gap > 2
    else if a.shot == roster.SHOT_MINE do
        return gap > 3
    else if a.lob do
        return gap > 3 and gap < 12
    else if a.shot != roster.SHOT_NONE do
        # A brawler with a quiver (HUNTER) looses its bolts point blank.
        return clear and facing and gap > (0.5 if kit.quiver > 0 else 2.5) and gap < 14
    else if a.teleport do
        return gap < 12
    else if a.radial do
        return gap < a.reach
    end
    return facing and gap < a.reach + a.lunge * 0.8
end

# What the CPU would do now: a slot, SLOT_BASIC, SLOT_SUPER, or -2 for nothing. In a combo
# only quick melee follow-ups count.
function cpu_pick(Fighter f, Fighter o, double gap, bool clear, bool facing, bool seen, bool combo) returns int
    var kit = f.kit
    if not encore_ready(f) and can_super(f) and not combo and seen do
        # Answering someone else's super (a merge, or a switch-off) is urgent.
        if ap.chance(LEVEL_SKILL[level] * (1.0 if max_owner >= 0 else 0.5)) do
            return SLOT_SUPER
        end
    end
    if encore_ready(f) and (combo or ap.chance(LEVEL_SKILL[level])) and
            cpu_fits(f, o, kit.ultimate, gap, clear, facing, seen) do
        return SLOT_SUPER
    end
    var first = int(ap.random(0, 3.999))
    for n in 0..<kit.skills.length do
        var i = (first + n) % kit.skills.length
        var a = kit.skills[i]
        if f.cooldowns[i] > 0 or not can_pay(f, a.cost) do
            continue
        end
        if f.minion and (a.kind != roster.KIND_STRIKE or a.inject) do
            # A clone only knows how to hit.
            continue
        end
        if kit.bankrupt > 0 and not mx(f).free_bar and f.bar < a.cost + 10 and ap.chance(0.7) do
            # Saving what little capital is left.
            continue
        end
        if combo and (a.kind != roster.KIND_STRIKE or a.shot != roster.SHOT_NONE or a.startup > 14 or a.evade or a.counter) do
            continue
        end
        if cpu_fits(f, o, a, gap, clear, facing, seen) and ap.chance(LEVEL_SKILL[level]) do
            return i
        end
    end
    if combo do
        return -2
    end
    var basic = kit.basics[0]
    if not can_pay(f, basic.cost) and kit.fallback.name != "" do
        basic = kit.fallback
    end
    if facing and can_pay(f, basic.cost) and not out_of_arrows(f, basic) do
        if basic.shot != roster.SHOT_NONE do
            if clear and gap < 14 do
                return SLOT_BASIC
            end
        else if gap < basic.reach + basic.lunge * 0.6 and (seen or ap.chance(0.3)) do
            return SLOT_BASIC
        end
    end
    return -2
end

function cpu_intent(Fighter f, Fighter o) returns Intent
    var want = cpu_plan(f, o)
    if cpu_mode == CPU_FIGHTS and o.state != STATE_DOWN do
        wave_cpu(f, o, want)
    end
    if not o.cpu and own_super(o, roster.MECH_HUNTER) and level <= 1 do
        # The player is hidden in HUNTER's WANTED DEAD: on EASY and NORMAL the CPU never finds
        # them, and only wanders the trees.
        want.basic = false
        want.skill = 0
        want.ultimate = false
        want.block = false
    end
    return want
end

function cpu_plan(Fighter f, Fighter o) returns Intent
    var want = Intent()
    if cpu_mode == CPU_STANDS or o.state == STATE_DOWN do
        return want
    end
    if cpu_mode == CPU_BLOCKS do
        want.block = true
        return want
    end
    var kit = f.kit
    var here = f.body.position
    var seen = o.fade > 0.5
    if seen do
        f.last_seen = target_of(f, o)
    end
    var to = flat(f.last_seen - here)
    var gap = to.length()
    var toward = unit(to)
    var across = ap.Vec3(toward.z, 0, -toward.x) * f.strafe
    var range = kit.ai_range
    if f.cloaked do
        range = 1.6
    end
    if kit.fallback.name != "" and not can_pay(f, kit.basics[0].cost) do
        # Out of ammunition: go in and use the gun as a club.
        range = 1.5
    end

    # Where to stand, reconsidered a few times a second.
    f.think -= 1
    if f.think <= 0 do
        f.think = 10 + int(ap.random(0, 16))
        if ap.chance(0.2) do
            f.strafe = -f.strafe
        end
        # Mirror copies: it goes after one of them, perhaps the wrong one.
        var copies = mirror_count(o.id)
        if copies == 0 do
            f.decoy = -1
        else if ap.chance(0.25) or f.decoy >= copies do
            f.decoy = pick_index(copies + 1) - 1
        end
        if not seen and gap < 1.2 do
            # Lost them: search.
            var guess = ap.random(0, 360)
            f.last_seen = forward_of(guess) * ap.random(0, ARENA - 2)
            f.plan = ap.Vec3(0, 0, 0)
        else if gap > range + 0.5 do
            f.plan = unit(toward + across * 0.35)
        else if gap < range - 1.3 and range > 3 do
            f.plan = unit(across * 0.7 - toward)
        else if ap.chance(0.6) do
            f.plan = across * 0.75
        else do
            f.plan = ap.Vec3(0, 0, 0)
        end
        # Stay off the edge.
        if flat(here + f.plan * 1.2).length() > ARENA - 0.8 do
            f.plan = unit(f.plan - unit(flat(here)) * 1.2)
        end
    end
    want.wish = f.plan

    # Seeing a blow coming: sometimes block, with a human's delay.
    if o.serial != f.seen_serial and o.state == STATE_ATTACK and seen do
        f.seen_serial = o.serial
        var threat = o.move.shot != roster.SHOT_NONE or gap < o.move.reach + o.move.lunge + 1
        var until = o.move.startup - o.frame
        # It takes a moment to react, so quick blows get through.
        var react = LEVEL_REACT[level] + int(ap.random(0, 9))
        var odds = LEVEL_BLOCK[level]
        if o.slot == SLOT_BASIC and o.spam > 0.2 do
            # They keep doing the same thing: it starts to see it coming.
            odds += LEVEL_READ[level]
            react = math.max(react - LEVEL_READ_SPEED[level] - int(o.spam * 6), 1)
        end
        if threat and react < until and ap.chance(odds) do
            f.block_wait = react
            f.block_hold = until + 16
            f.block_parry = ap.chance(LEVEL_PARRY[level])
            if f.block_parry do
                f.block_wait = math.max(until - 2 - int(ap.random(0, 5)), react)
            end
        end
    end
    if f.block_hold > 0 do
        f.block_hold -= 1
        if f.block_wait > 0 do
            f.block_wait -= 1
        else do
            want.block = true
            want.sloppy = not f.block_parry
            want.wish = ap.Vec3(0, 0, 0)
            return want
        end
    end

    # Someone limp: wait over them while they lie there (nothing lands), juggle them while they are up.
    if lying(o) and seen do
        want.wish = toward if gap > 2.6 else across * 0.4
        return want
    end
    if tumbling(o) and seen and o.juggles < JUGGLE_LIMIT and f.state == STATE_IDLE and
            (gap < kit.basics[0].reach + 1.0 or kit.basics[0].shot != roster.SHOT_NONE) and can_pay(f, kit.basics[0].cost) and
            not out_of_arrows(f, kit.basics[0]) do
        want.basic = true
        want.wish = toward
        return want
    end
    var clear = seen and world.sees(f.body.center(), o.body.center())
    var facing = ap.in_cone(here, forward_of(f.heading), f.last_seen, 50)
    # Mid-string and it landed: carry the combo on.
    if f.state == STATE_ATTACK do
        if f.connected and f.cpu_combo and seen do
            if f.slot == SLOT_BASIC and f.chain < kit.basics.length - 1 do
                want.basic = true
            else if f.slot == SLOT_BASIC or f.slot != SLOT_SUPER do
                var next = cpu_pick(f, o, gap, clear, facing, seen, true)
                if next == SLOT_SUPER do
                    want.ultimate = true
                else if next >= 0 and f.slot == SLOT_BASIC do
                    want.skill = next + 1
                end
            end
        end
        return want
    end
    f.cool -= 1
    if level > 0 and o.spam > 0.3 and gap < 3.5 do
        # Being mashed on wakes it up.
        f.cool -= 2
    end
    if kit.quiver > 0 and f.arrows == 0 and f.state == STATE_IDLE do
        # An empty quiver: get some room, then change it.
        var slot = -1
        for i, a in kit.skills do
            if a.kind == roster.KIND_QUIVER do
                slot = i
            end
        end
        if slot >= 0 and move_ready(f, slot) and (gap > 2.5 or not seen) do
            want.skill = slot + 1
            return want
        end
    end
    if f.cool > 0 or (f.state != STATE_IDLE and f.state != STATE_BLOCK) do
        return want
    end
    var pick = cpu_pick(f, o, gap, clear, facing, seen, false)
    if pick != -2 do
        if pick == SLOT_SUPER do
            want.ultimate = true
        else if pick == SLOT_BASIC do
            want.basic = true
        else do
            want.skill = pick + 1
            var a = kit.skills[pick]
            if a.kind == roster.KIND_BLINK or a.evade do
                # Footwork goes somewhere: in for a brawler, out and around for the rest.
                if a.damage > 0 or (range <= 3 and gap > 4) do
                    want.wish = toward
                else do
                    want.wish = unit(across * 0.6 - toward)
                end
            end
        end
        f.cool = LEVEL_WAIT[level] + int(ap.random(0, double(LEVEL_WAIT_MORE[level])))
        f.cpu_combo = ap.chance(LEVEL_COMBO[level])
        return want
    end
    # Closing in, or getting away, in a hurry.
    if f.dash_cooldown == 0 and seen and ap.chance(0.02) do
        if gap > range + 4 do
            want.wish = toward
            want.dash = true
        else if range > 3 and gap < 2.2 do
            want.wish = unit(across - toward)
            want.dash = true
        end
    end
    return want
end

# --- The fight screen ----------------------------------------------------------------------------

function end_round(string words)
    phase = PHASE_OVER
    phase_ticks = 0
    banner = words
    sound_at(snd_ko, cam_focus, 0.6)
end

# BOB's clones fight on their own, and dissolve when beaten.
# 2v2: the opponent `f` is paired with this round (0 their first, 1 their second). The fights
# pair off first-against-first and partner-against-partner, and swap every round; foe_of turns
# to the other opponent once the paired one is down.
function duo_aim(Fighter f) returns int
    var slot = 1 if f.partner else 0
    return slot if round % 2 == 1 else 1 - slot
end

# 2v2: a CPU sticks to the opponent it is paired with.
function think_aim(Fighter f)
    f.aim = duo_aim(f) if duo else 0
end

# BOB's clones fight on their own, and dissolve when beaten. 2v2 partners fight on like anyone
# else, and lie where they fall until the round is over.
function update_minions(bool fighting)
    Fighter[] alive = []
    for m in minions do
        var enemy = other(m)
        if m.partner do
            think_aim(m)
            enemy = foe_of(m)
        end
        var want = cpu_intent(m, enemy) if fighting and m.state != STATE_DOWN else Intent()
        step_fighter(m, enemy, want)
        if m.state != STATE_DOWN do
            for g in everyone() do
                if g != m and g.state != STATE_DOWN do
                    m.body.push_apart(world, g.body)
                end
            end
        end
        if m.partner do
            if m.state != STATE_DOWN and m.health <= 0 and fighting and not rise_again(m) do
                knock_down(m)
                say(m.body.top() + ap.Vec3(0, 0.3, 0), "DOWN", m.kit.look.accent)
                sound_at(snd_thud, m.body.position, 0.7, 0.7)
                smoke(m.body.position + ap.Vec3(0, 0.2, 0), 8, 0.5, 1.0)
            end
            alive.push(m)
            continue
        end
        if ap.chance(0.35) do
            spark(m.body.position + ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 1.8), ap.random(-0.4, 0.4)),
                ap.Vec3(0, ap.random(0.6, 1.4), 0), ap.Color(120, 255, 120), 0.5, 0.06, 0)
        end
        if m.health <= 0 or fighters[m.id].state == STATE_DOWN do
            minion_dies(m)
        else do
            alive.push(m)
        end
    end
    minions = alive
end

# PHOENIX FEATHER: once a round, the item puts its holder back on their feet in a burst of fire.
function phoenix(Fighter f) returns bool
    var share = st(f, items.E_REVIVE)
    if share <= 0 or f.item_revived do
        return false
    end
    f.item_revived = true
    f.health = f.max_health * math.min(share, 100.0) / 100
    f.shown_health = f.health
    f.poison = 0
    f.state = STATE_HURT
    f.stun = 50
    f.stun_total = 50
    f.safe = 80
    f.knock = ap.Vec3(0, 0, 0)
    var at = f.body.center()
    var fire = ap.Color(255, 150, 60)
    say(f.body.top() + ap.Vec3(0, 0.4, 0), "REBORN", fire)
    sound_at(snd_cast, at, 0.8, 0.8)
    later(snd_shimmer, at, 6, 0.6, 1.2)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), fire, 8, 0.5))
    rings.push(Ring(at, ap.Color(255, 220, 120), 5, 0.35, true))
    for i in 0..<30 do
        var around = forward_of(double(i) * 12)
        streak(f.body.position + around * 0.4, around * ap.random(1, 3) + ap.Vec3(0, ap.random(5, 9), 0),
            fire if i % 2 == 0 else ap.Color(255, 230, 140), 0.5, 0.6, 0.07)
    end
    return true
end

# DISMANTLE: the first time in a round he is put down, he gets back up.
function rise_again(Fighter f) returns bool
    if f.kit.revive <= 0 or f.revived do
        return phoenix(f)
    end
    f.revived = true
    f.health = f.max_health * f.kit.revive
    f.shown_health = f.health
    f.poison = 0
    f.state = STATE_HURT
    f.stun = 70
    f.stun_total = 70
    f.safe = 80
    f.knock = ap.Vec3(0, 0, 0)
    var at = f.body.center()
    say(f.body.top() + ap.Vec3(0, 0.4, 0), "RISES AGAIN", f.kit.look.accent)
    sound_at(snd_growl, at, 0.8, 0.6)
    later(snd_thud, at, 6, 0.7, 0.5)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 7, 0.5))
    for i in 0..<24 do
        spark(f.body.position + forward_of(double(i) * 15) * 0.5, ap.Vec3(0, ap.random(1, 3), 0), f.kit.look.accent, 0.8, 0.08, -0.5)
    end
    smoke(f.body.position + ap.Vec3(0, 0.2, 0), 12, 0.5, 1.2)
    return true
end

function update_fight()
    if ap.key_pressed(ap.KEY_F6) or ap.pad_pressed(ap.PAD_BACK) or (admin_open and back_pressed()) do
        if not paused do
            admin_open = not admin_open
            snd_move.play(0.5)
            pad.clear()
        end
        return
    end
    if admin_open do
        update_admin()
        return
    end
    if ap.key_pressed(ap.KEY_ESCAPE) or ap.pad_pressed(ap.PAD_START) do
        paused = not paused
        pause_cursor = 0
        snd_move.play(0.5)
        return
    end
    if paused do
        update_pause()
        return
    end
    if ap.key_pressed(ap.KEY_F3) do
        cpu_mode = (cpu_mode + 1) % 3
    end
    if ap.key_pressed(ap.KEY_F5) do
        level = (level + 1) % LEVEL_NAMES.length
    end
    if ap.key_pressed(ap.KEY_F4) do
        refill()
    end
    admin_tick()
    var player = fighters[0]
    var foe = fighters[1]
    if duo and (ap.key_pressed(ap.KEY_E) or ap.pad_pressed(ap.PAD_RIGHT_STICK)) and phase == PHASE_FIGHT do
        # Face the other opponent.
        player_aim = 1 - player_aim
        snd_move.play(0.5)
        var now = foe_of(player)
        rings.push(Ring(now.body.position + ap.Vec3(0, 0.08, 0), ap.Color(255, 120, 90), 4, 0.25))
    end
    think_aim(foe)
    update_camera()
    if ap.frozen() do
        return    # hitstop: the blow hangs for a moment, and input keeps buffering
    end
    if max_cut > 0 do
        update_cutscene()
        return
    end
    if phase == PHASE_DRAFT do
        step_fighter(player, foe, Intent())
        step_fighter(foe, player, Intent())
        update_minions(false)
        update_draft()
        update_effects()
        return
    end
    phase_ticks += 1
    super_ticks = math.max(super_ticks - 1, 0)
    if phase == PHASE_FIGHT do
        update_area()
    end
    var idle = Intent()
    var fighting = phase == PHASE_FIGHT
    var mine = player_intent() if fighting and player.state != STATE_DOWN else idle
    var theirs = cpu_intent(foe, foe_of(foe)) if fighting and foe.state != STATE_DOWN else idle
    if wave_steps(player) do
        step_fighter(player, foe_of(player), mine)
    end
    if wave_steps(foe) do
        step_fighter(foe, foe_of(foe), theirs)
    end
    tick_time()
    if player.state != STATE_DOWN and foe.state != STATE_DOWN do
        player.body.push_apart(world, foe.body)
    end
    update_minions(fighting)
    update_shots()
    update_things()
    update_pickups()
    update_props()
    update_mirrors()
    update_effects()
    if fighting do
        update_maximum()
    end

    if phase == PHASE_INTRO do
        if phase_ticks == 70 do
            banner = "FIGHT"
            snd_bell.play(0.5)
        end
        if phase_ticks >= 70 do
            phase = PHASE_FIGHT
            phase_ticks = 0
        end
    else if phase == PHASE_FIGHT do
        if phase_ticks > 45 and banner == "FIGHT" do
            banner = ""
        end
        if not admin_clock do
            # Real seconds: a tick of a slowed fight is more than 1/60 of one.
            clock_carry += fight_pace() / time_scale
            while clock_carry >= 1 do
                clock -= 1
                clock_carry -= 1
            end
        end
        for f in fighters do
            if f.state != STATE_DOWN and f.health <= 0 and not rise_again(f) do
                knock_down(f)
                if duo and side_standing(f.id) do
                    say(f.body.top() + ap.Vec3(0, 0.3, 0), "DOWN", f.kit.look.accent)
                    sound_at(snd_thud, f.body.position, 0.7, 0.7)
                    smoke(f.body.position + ap.Vec3(0, 0.2, 0), 8, 0.5, 1.0)
                end
            end
        end
        var out_player = not side_standing(0)
        var out_foe = not side_standing(1)
        if out_player or out_foe do
            if out_player and out_foe do
                end_round("DOUBLE K.O.")
            else do
                fighters[0 if out_foe else 1].wins += 1
                end_round("K.O.")
            end
        else if clock <= 0 do
            var share_player = side_share(0)
            var share_foe = side_share(1)
            if share_player != share_foe do
                fighters[0 if share_player > share_foe else 1].wins += 1
            end
            end_round("TIME")
        end
    else if phase_ticks > 190 do
        if player.wins >= wins_needed() or foe.wins >= wins_needed() do
            winner = 0 if player.wins > foe.wins else 1
            result_jingle = true
            go(SCREEN_RESULT)
        else do
            round += 1
            next_fighters()
            start_round()
        end
    end
end

# How much health a side has left, as a share of what it started with.
function side_share(int side) returns double
    var have = 0.0
    var most = 0.0
    for g in side_fighters(side) do
        have += math.max(g.health, 0.0)
        most += g.max_health
    end
    return have / math.max(most, 1.0)
end

function update_pause()
    if up_pressed() do
        pause_cursor = (pause_cursor + 5) % 6
        snd_move.play(0.5)
    end
    if down_pressed() do
        pause_cursor = (pause_cursor + 1) % 6
        snd_move.play(0.5)
    end
    if confirm_pressed() and pause_cursor == 3 do
        # The music, a quarter at a time down to off, then back to full.
        var steps = [1.0, 0.75, 0.5, 0.25, 0.0]
        var next = 0
        for i, v in steps do
            if math.abs(saved.music - v) < 0.01 do
                next = (i + 1) % steps.length
            end
        end
        saved.music = steps[next]
        save.store(saved)
        snd_move.play(0.5)
        return
    end
    if confirm_pressed() and pause_cursor == 4 do
        toggle_models()
        return
    end
    if confirm_pressed() do
        snd_pick.play(0.5)
        paused = false
        pad.clear()
        if pause_cursor == 1 do
            start_match()
        else if pause_cursor == 2 do
            open_select()
        else if pause_cursor == 5 do
            ap.quit()
        end
    end
end

# --- The admin panel (F6, or BACK on a gamepad): cheats for trying things out --------------------
# The fight holds still while it is open. W/S pick a row, A/D change its value, ENTER does it.
# Most rows act on the TARGET: your side, theirs, or both (in a 2v2, both fighters of a side).

const int ADMIN_TARGET = 0
const int ADMIN_FILL = 1
const int ADMIN_SUPER = 2
const int ADMIN_END = 3
const int ADMIN_HEAL = 4
const int ADMIN_COOL = 5
const int ADMIN_KO = 6
const int ADMIN_GOD = 7
const int ADMIN_ENDLESS = 8
const int ADMIN_FREE = 9
const int ADMIN_ITEM = 10
const int ADMIN_CLEAR = 11
const int ADMIN_CLOCK = 12
const int ADMIN_CPU = 13
const int ADMIN_LEVEL = 14
const int ADMIN_SPEED = 15
const string[] ADMIN_ROWS = ["TARGET", "FILL SUPER BAR", "CALL SUPER NOW", "END SUPERS IN FORCE", "HEAL", "RESET COOLDOWNS",
    "KNOCK OUT", "INFINITE HEALTH", "INFINITE SUPER BAR", "NO COOLDOWNS, FULL BAR", "GIVE ITEM", "CLEAR ITEMS",
    "FREEZE CLOCK", "CPU", "DIFFICULTY", "GAME SPEED"]
const string[] CPU_NAMES = ["FIGHTS", "STANDS", "BLOCKS"]

var admin_open = false
var admin_cursor = 0
var admin_target = 0                 # 0 your side, 1 theirs, 2 both
var admin_item = 0                   # the item GIVE ITEM hands over
bool[] admin_god = [false, false]    # per side: health kept full
bool[] admin_endless = [false, false]   # per side: super bar kept full
bool[] admin_free = [false, false]   # per side: no cooldowns, the bar kept full
var admin_clock = false              # the round clock stands still
var admin_note = ""                  # what the last action did
var admin_note_ticks = 0

function admin_sides() returns int[]
    return [0, 1] if admin_target == 2 else [admin_target]
end

function admin_say(string words)
    admin_note = words
    admin_note_ticks = 150
end

# A per-side switch as the target sees it.
function admin_flag(bool[] flags) returns string
    var on = 0
    for side in admin_sides() do
        if flags[side] do
            on += 1
        end
    end
    if on == 0 do
        return "OFF"
    end
    return "ON" if on == admin_sides().length else "MIXED"
end

function admin_flip(bool[] flags)
    var turn_on = admin_flag(flags) != "ON"
    for side in admin_sides() do
        flags[side] = turn_on
    end
end

# The value shown after a row's name, if it has one.
function admin_value(int row) returns string
    if row == ADMIN_TARGET do
        if admin_target == 2 do
            return "BOTH"
        end
        return "{"YOU" if admin_target == 0 else "THEM"} ({fighters[admin_target].kit.name})"
    else if row == ADMIN_GOD do
        return admin_flag(admin_god)
    else if row == ADMIN_ENDLESS do
        return admin_flag(admin_endless)
    else if row == ADMIN_FREE do
        return admin_flag(admin_free)
    else if row == ADMIN_ITEM do
        return item_defs[admin_item].name if item_defs.length > 0 else "(none)"
    else if row == ADMIN_CLOCK do
        return "ON" if admin_clock else "OFF"
    else if row == ADMIN_CPU do
        return CPU_NAMES[cpu_mode]
    else if row == ADMIN_LEVEL do
        return LEVEL_NAMES[level]
    else if row == ADMIN_SPEED do
        var pace = fight_pace()
        var tag = ""
        if math.abs(pace - FIGHT_PACE) < 0.001 do
            tag = " DEFAULT"
        else if math.abs(pace - 1.0) < 0.001 do
            tag = " ORIGINAL"
        end
        return "{int(100 / pace + 0.5)}%{tag}"
    end
    return ""
end

# Every tick of the fight: the switches that are on.
function admin_tick()
    if admin_note_ticks > 0 do
        admin_note_ticks -= 1
    end
    for side in 0..<2 do
        for g in side_fighters(side) do
            if g.state == STATE_DOWN do
                continue
            end
            if admin_god[side] do
                g.health = g.max_health
            end
            if admin_endless[side] and not g.partner do
                g.energy = roster.SUPER_MAX
            end
            if admin_free[side] do
                g.cooldowns = [0, 0, 0, 0]
                g.bar = g.kit.bar_max
            end
        end
    end
end

# CALL SUPER NOW for side `side`: whatever is in force ends first (TELEMAN's needs one in force).
# With BOTH, theirs merges into yours.
function admin_call_super()
    if phase != PHASE_FIGHT do
        admin_say("ONLY WHILE THE ROUND IS ON")
        return
    end
    if max_cut > 0 do
        admin_say("WAIT FOR THE CUTSCENE TO END")
        return
    end
    var first = fighters[admin_sides()[0]]
    if first.kit.maximum.jammer do
        if max_owner < 0 do
            admin_say("{first.kit.name}'S SUPER ONLY WORKS INSIDE ANOTHER")
            return
        end
    else if max_owner >= 0 do
        end_maximum()
    end
    first.energy = roster.SUPER_MAX
    begin_maximum(first)
    if admin_target == 2 do
        var second = fighters[1]
        second.energy = roster.SUPER_MAX
        if can_merge(second) do
            request_merge(second)
            admin_say("SUPER MERGE: {first.kit.name} + {second.kit.name}")
            return
        end
    end
    admin_say("{first.kit.name} CALLS THEIR SUPER")
end

function admin_apply(int row)
    var names = ""
    for side in admin_sides() do
        names = fighters[side].kit.name if names == "" else "{names} + {fighters[side].kit.name}"
    end
    if row == ADMIN_FILL do
        for side in admin_sides() do
            fighters[side].energy = roster.SUPER_MAX
        end
        admin_say("{names}: SUPER BAR FULL")
    else if row == ADMIN_SUPER do
        admin_call_super()
        if max_cut > 0 do
            admin_open = false    # to watch it
        end
    else if row == ADMIN_END do
        if max_owner < 0 and max_cut == 0 do
            admin_say("NO SUPER IS IN FORCE")
        else do
            end_maximum()
            admin_say("SUPERS ENDED")
        end
    else if row == ADMIN_HEAL do
        for side in admin_sides() do
            for g in side_fighters(side) do
                if g.state != STATE_DOWN do
                    g.health = g.max_health
                    g.bar = g.kit.bar_max
                    g.poison = 0
                    g.slow = 0
                end
            end
        end
        admin_say("{names}: HEALED")
    else if row == ADMIN_COOL do
        for side in admin_sides() do
            for g in side_fighters(side) do
                g.cooldowns = [0, 0, 0, 0]
            end
        end
        admin_say("{names}: COOLDOWNS RESET")
    else if row == ADMIN_KO do
        if phase != PHASE_FIGHT do
            admin_say("ONLY WHILE THE ROUND IS ON")
            return
        end
        for side in admin_sides() do
            admin_god[side] = false
            for g in side_fighters(side) do
                g.health = 0
            end
        end
        admin_open = false
        admin_say("{names}: KNOCKED OUT")
    else if row == ADMIN_GOD do
        admin_flip(admin_god)
        admin_say("{names}: INFINITE HEALTH {admin_flag(admin_god)}")
    else if row == ADMIN_ENDLESS do
        admin_flip(admin_endless)
        admin_say("{names}: INFINITE SUPER BAR {admin_flag(admin_endless)}")
    else if row == ADMIN_FREE do
        admin_flip(admin_free)
        admin_say("{names}: NO COOLDOWNS {admin_flag(admin_free)}")
    else if row == ADMIN_ITEM do
        if item_defs.length == 0 do
            return
        end
        for side in admin_sides() do
            side_items[side].push(admin_item)
            var f = fighters[side]
            say(f.body.top() + ap.Vec3(0, 0.3, 0), item_defs[admin_item].name, tier_color(item_defs[admin_item].tier))
        end
        # (Items that work at the start of a round, like extra health, wait for the next one.)
        admin_say("{names}: + {item_defs[admin_item].name}")
    else if row == ADMIN_CLEAR do
        for side in admin_sides() do
            side_items[side] = []
        end
        admin_say("{names}: ITEMS CLEARED")
    else if row == ADMIN_CLOCK do
        admin_clock = not admin_clock
        admin_say("CLOCK {"FROZEN" if admin_clock else "RUNNING"}")
    end
end

# A/D on a row with choices.
function admin_change(int row, int step)
    if row == ADMIN_TARGET do
        admin_target = (admin_target + step + 3) % 3
    else if row == ADMIN_ITEM and item_defs.length > 0 do
        admin_item = (admin_item + step + item_defs.length) % item_defs.length
    else if row == ADMIN_CPU do
        cpu_mode = (cpu_mode + step + 3) % 3
    else if row == ADMIN_LEVEL do
        level = (level + step + LEVEL_NAMES.length) % LEVEL_NAMES.length
    else if row == ADMIN_SPEED do
        # D faster, A slower; it stops at either end.
        var at = 0
        for i, pace in FIGHT_PACES do
            if math.abs(pace - fight_pace()) < math.abs(FIGHT_PACES[at] - fight_pace()) do
                at = i
            end
        end
        saved.pace = FIGHT_PACES[math.clamp(at + step, 0, FIGHT_PACES.length - 1)]
        save.store(saved)
        admin_say("GAME SPEED {admin_value(ADMIN_SPEED)}: {fight_rate()} TICKS A SECOND")
    else if row == ADMIN_GOD or row == ADMIN_ENDLESS or row == ADMIN_FREE or row == ADMIN_CLOCK do
        admin_apply(row)
    else do
        return
    end
    snd_move.play(0.4)
end

function update_admin()
    if admin_note_ticks > 0 do
        admin_note_ticks -= 1
    end
    if up_pressed() do
        admin_cursor = (admin_cursor + ADMIN_ROWS.length - 1) % ADMIN_ROWS.length
        snd_move.play(0.4)
    end
    if down_pressed() do
        admin_cursor = (admin_cursor + 1) % ADMIN_ROWS.length
        snd_move.play(0.4)
    end
    if left_pressed() do
        admin_change(admin_cursor, -1)
    end
    if right_pressed() do
        admin_change(admin_cursor, 1)
    end
    if ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_SPACE) or ap.pad_pressed(ap.PAD_SOUTH) do
        if admin_cursor == ADMIN_TARGET or admin_cursor == ADMIN_CPU or admin_cursor == ADMIN_LEVEL or admin_cursor == ADMIN_SPEED do
            admin_change(admin_cursor, 1)
        else do
            snd_pick.play(0.5)
            admin_apply(admin_cursor)
        end
        pad.clear()
    end
end

function draw_admin()
    var w = 320.0
    var row_h = 14.0
    var h = 58 + row_h * double(ADMIN_ROWS.length)
    var x = (VW - w) / 2
    var y = (VH - h) / 2 - 6
    ap.rect(0, 0, VW, VH, ap.BLACK.fade(0.45))
    ap.rect(x, y, w, h, ap.Color(10, 8, 18).fade(0.94))
    ap.rect(x, y, w, 2, ap.Color(255, 90, 90))
    ap.rect_lines(x, y, w, h, 1, ap.Color(255, 90, 90).fade(0.5))
    label("ADMIN", x + 10, y + 8, 16, ap.Color(255, 90, 90))
    label_right("THE FIGHT IS ON HOLD", x + w - 10, y + 12, 8, ap.Color(130, 126, 150))
    for i, name in ADMIN_ROWS do
        var ry = y + 32 + row_h * double(i)
        var chosen = i == admin_cursor
        if chosen do
            ap.rect(x + 4, ry - 3, w - 8, row_h, ap.Color(255, 90, 90).fade(0.18))
        end
        if i == ADMIN_GOD or i == ADMIN_CLOCK do
            ap.rect(x + 10, ry - 4, w - 20, 1, ap.Color(60, 56, 80))
        end
        label("> {name}" if chosen else "  {name}", x + 10, ry, 8, ap.WHITE if chosen else ap.Color(170, 165, 190))
        var value = admin_value(i)
        if value != "" do
            var tint = ap.Color(255, 206, 70)
            if value == "ON" do
                tint = ap.Color(120, 230, 120)
            else if value == "OFF" do
                tint = ap.Color(110, 106, 130)
            else if i == ADMIN_ITEM and item_defs.length > 0 do
                tint = tier_color(item_defs[admin_item].tier)
            end
            var shown = "< {value} >" if chosen and (i == ADMIN_TARGET or i == ADMIN_ITEM or i == ADMIN_CPU or i == ADMIN_LEVEL or i == ADMIN_SPEED) else value
            if shown.length > 30 do
                shown = "{shown[0..<28]}.."
            end
            label_right(shown, x + w - 10, ry, 8, tint)
        end
    end
    var foot = y + h - 20
    if admin_note_ticks > 0 do
        var note = admin_note if admin_note.length <= 44 else "{admin_note[0..<42]}.."
        label_centered(note, x + w / 2, foot, 8, ap.Color(120, 230, 120).fade(math.min(double(admin_note_ticks) / 30, 1.0)))
    else do
        label_centered("W S PICK   A D CHANGE   ENTER DO IT   F6 CLOSE", x + w / 2, foot, 8, ap.Color(110, 106, 130))
    end
end

# The camera stands behind the player, looking past them at the opponent.
function update_camera()
    if max_cut > 0 do
        cutscene_camera()
        return
    end
    var player = fighters[0]
    if duo and player.state == STATE_DOWN and has_partner(0) and partner_of(0).state != STATE_DOWN do
        # Down, but your ally fights on: the camera goes with them.
        player = partner_of(0)
    end
    var foe = foe_of(player)
    if foe.fade > 0.4 do
        # With mirror copies about, the camera does not give away which one is real.
        var middle = foe.body.position
        var count = 1.0
        for mi in mirrors do
            if mi.owner == foe.id do
                middle = middle + mirror_at(mi)
                count += 1
            end
        end
        cam_foe = cam_foe.lerp(middle * (1 / count), 0.2)
    end
    # Up in the sun (MOTH's dive), the camera stays on where she will come down.
    var here = player.body.position if player.dive == 0 else player.dive_aim
    var between = flat(here - cam_foe)
    # Swing round behind the player, gently when the two are close (circling at arm's length,
    # the line between them spins fast) and never faster than CAM_TURN a tick.
    var keen = math.clamp((between.length() - 0.6) / 2.4, 0.0, 1.0)
    if keen > 0 do
        var turn = wrap(heading_of(between) - cam_yaw) * 0.07 * keen
        cam_yaw = wrap(cam_yaw + math.clamp(turn, -CAM_TURN, CAM_TURN))
    end
    var focus = here * 0.62 + cam_foe * 0.38 + ap.Vec3(0, 1.15, 0)
    if on_train() do
        train_camera(here, focus)
        return
    end
    cam_focus = cam_focus.lerp(focus, 0.14)
    cam_distance = ap.lerp(cam_distance, math.clamp(3.3 + between.length() * 0.58, 4.3, 12.0), 0.08)
    # A pillar or wall behind: the camera rises to look over it rather than closing in. The
    # unseen wall round the disc does not count, since there is nothing there to see through.
    # It wants a clear line to the middle of the fight and to whoever it follows.
    # Trees are too tall to look over and too thin to hide much: the camera ignores them, and
    # one in the way is drawn see-through instead (see draw_tree).
    world.enable(rim_group, false)
    if tree_group > 0 do
        world.enable(tree_group, false)
    end
    var chest = here + ap.Vec3(0, 1.1, 0)
    var want_pitch = CAM_PITCH
    while want_pitch < CAM_PITCH_MAX do
        var at = ap.orbit(cam_focus, cam_yaw + 24, want_pitch, cam_distance).position
        if world.sweep(cam_focus, at, 0.3) >= 1 and world.sweep(at, chest, 0.1) >= 1 do
            break
        end
        want_pitch += 5
    end
    cam_pitch = ap.lerp(cam_pitch, want_pitch, 0.16 if want_pitch > cam_pitch else 0.05)
    var wanted = ap.orbit(cam_focus, cam_yaw + 24, cam_pitch, cam_distance)
    # Still blocked while rising, or too tall to see over: closer in, as little as it takes.
    var reach = world.sweep(cam_focus, wanted.position, 0.3)
    world.enable(rim_group, true)
    if tree_group > 0 do
        world.enable(tree_group, true)
    end
    # Eased in and out, so it glides rather than snapping in a single tick.
    var want_reach = math.max(reach, 0.15) if reach < 1 else 1.0
    cam_reach = ap.lerp(cam_reach, want_reach, 0.3 if want_reach < cam_reach else 0.06)
    if cam_reach < 0.999 do
        wanted = ap.Camera3D(cam_focus + (wanted.position - cam_focus) * cam_reach, cam_focus)
    end
    camera = wanted
end

# On the last train the camera stays inside the carriage: behind the player along the aisle,
# under the roof, looking down the carriage at the fight.
var train_cam = ap.Vec3(0, 2, 0)
var train_ahead = 0.0                # which way down the aisle the camera looks (0: not yet chosen)
function train_camera(ap.Vec3 here, ap.Vec3 focus)
    var axis = train_axis
    var across = right_of(heading_of(axis))
    # It turns round only once the foe is well past, not while the two squeeze by each other
    # (that flipped it back and forth every tick). Turning round is a cut: easing from one end
    # of the carriage to the other dragged the camera through both fighters.
    var lead = dot3(flat(cam_foe - here), axis)
    var cut = false
    if train_ahead == 0 do
        train_ahead = 1.0 if lead >= 0 else -1.0
    else if lead * train_ahead < -1.5 do
        train_ahead = -train_ahead
        cut = true
    end
    var ahead = train_ahead
    var want_focus = axis * dot3(flat(focus), axis) + across * math.clamp(dot3(flat(focus), across), -0.9, 0.9) + ap.Vec3(0, 1.25, 0)
    cam_focus = cam_focus.lerp(want_focus, 0.14)
    var gap = flat_distance(here, cam_foe)
    var back = math.clamp(2.6 + gap * 0.35, 3.0, 5.0)
    var along = math.clamp(dot3(flat(here), axis) - ahead * back, -(ARENA - 0.4), ARENA - 0.4)
    var side = math.clamp(dot3(flat(here), across) * 0.5, -0.9, 0.9)
    var want = axis * along + across * side + ap.Vec3(0, 2.3, 0)
    if cut do
        train_cam = want
        cam_focus = want_focus
    else do
        train_cam = train_cam.lerp(want, 0.12)
    end
    cam_yaw = heading_of(axis * -ahead)
    camera = ap.Camera3D(train_cam, cam_focus)
end

# --- Title, select, result -----------------------------------------------------------------------

function open_select()
    end_maximum()
    minions = []
    mirrors = []
    props = []
    pickups = []
    cursor = cast.length if randomized() else picks[0]
    picking = 0
    pick_step = 0
    go(SCREEN_SELECT)
end

# Fighters each side picks on the select screen: one (two in 2v2), or a whole team.
function side_size() returns int
    if lineup == LINE_TEAM do
        return team_size()
    end
    return 2 if duo else 1
end

# Whether `who` is already on side `side`'s team among the picks made so far.
function on_team(int side, int who) returns bool
    if not uses_teams() do
        return false
    end
    var size = side_size()
    var made = pick_step - side * size if picking == side else size
    for i in 0..<math.max(math.min(made, size), 0) do
        if teams[side][i] == who do
            return true
        end
    end
    return false
end

function grid_columns() returns int
    var cards = cast.length + 1
    if cards <= 10 do
        return 5
    end
    if cards <= 27 do
        return 9
    end
    if cards <= 30 do
        return 10
    end
    return 12
end

# --- The title: two doors ----------------------------------------------------------------------
# The whole screen is two great buttons, PURGATORY on the left and ARENA on the right, with the
# logo over both. The one you point at (mouse, or A/D and the arrows) springs out toward you.

var title_pick = -1                  # 0 PURGATORY, 1 ARENA, -1 neither yet
var title_pop = [0.0, 0.0]           # how far each has sprung out (springy, so it overshoots)
var title_pop_speed = [0.0, 0.0]
var title_mouse = ap.Vec2(-1, -1)

# The install prompt for PURGATORY's content.
const int INSTALL_NONE = 0
const int INSTALL_RUNNING = 2
const int INSTALL_FAILED = 3
const int INSTALL_RESTART = 4         # installed: the game restarts to build the mode in
var install_state = INSTALL_NONE
var install_pid = -1
var install_ticks = 0
var install_error = ""
const string INSTALL_LOG = fs.join(fs.temp_dir(), "playerversus_purgatory_install.log")

function title_seam() returns double
    return 320 + 46 * (title_pop[0] - title_pop[1])
end

function update_title()
    if select_world >= 0 do
        select_world = -1
        apply_area()
    end
    camera = ap.orbit(ap.Vec3(0, 1.4, 0), double(ticks) * 0.08, 12, 15)
    update_effects()
    for i in 0..<2 do
        var want = 1.0 if title_pick == i else 0.0
        title_pop_speed[i] = (title_pop_speed[i] + (want - title_pop[i]) * 0.16) * 0.72
        title_pop[i] += title_pop_speed[i]
    end
    update_install()
    var m = ap.mouse()
    if m.x != title_mouse.x or m.y != title_mouse.y do
        title_mouse = m
        if m.y > 0 and m.y < VH do
            var pick = 0 if m.x < title_seam() else 1
            if pick != title_pick do
                title_pick = pick
                snd_move.play(0.35, 0.9 + 0.2 * double(pick))
            end
        end
    end
    if left_pressed() and title_pick != 0 do
        title_pick = 0
        snd_move.play(0.35, 0.9)
    end
    if right_pressed() and title_pick != 1 do
        title_pick = 1
        snd_move.play(0.35, 1.1)
    end
    var chosen = ap.mouse_pressed(1) and title_pick >= 0
    if ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_SPACE) or ap.pad_pressed(ap.PAD_SOUTH) or ap.pad_pressed(ap.PAD_START) do
        if title_pick < 0 do
            title_pick = 1
        end
        chosen = true
    end
    if chosen do
        snd_pick.play(0.5)
        if title_pick == 1 and install_state != INSTALL_RESTART do
            open_select()
        else if title_pick == 0 and purgatory.INSTALLED do
            enter_purgatory()
        else if title_pick == 0 and (install_state == INSTALL_NONE or install_state == INSTALL_FAILED) do
            # Not installed (or out of date): the button itself is the prompt; choosing it installs.
            start_install()
        end
    end
    if ap.key_pressed(ap.KEY_ESCAPE) do
        ap.quit()
    end
end

# What the prompt runs: install PURGATORY (its code, which brings its two music packages), or
# update an install that does not match this game (see loader.fw).
function install_command() returns string[]
    if purgatory.STATUS == "outdated" do
        return ["pulley", "update", "--user", "-q", music.PURGATORY_PACKAGE]
    else if purgatory.STATUS == "newer" do
        return ["pulley", "update", "--user", "-q", "playerversus"]
    end
    return ["pulley", "pull", "-q", music.PURGATORY_DIST]
end

function update_install()
    install_ticks += 1
    if install_state == INSTALL_RUNNING do
        if install_pid < 0 do
            install_state = INSTALL_FAILED
            return
        end
        if not os.alive(install_pid) do
            var status = os.wait(install_pid)
            install_pid = -1
            music.setup()
            refresh_purgatory_tracks()
            if status == 0 and (music.purgatory_code(GAME_DIR) != "" or purgatory.STATUS != "missing") do
                install_state = INSTALL_RESTART
                install_ticks = 0
                snd_bell.play(0.5)
            else do
                install_state = INSTALL_FAILED
                var log = fs.read(INSTALL_LOG) if fs.exists(INSTALL_LOG) else ""
                install_error = "PULLEY COULD NOT INSTALL IT" if purgatory.STATUS == "missing" else "PULLEY COULD NOT UPDATE IT"
                for line in log.split("\n") do
                    if line.trim() != "" do
                        install_error = line.trim()
                    end
                end
                if status == 0 do
                    install_error = "INSTALLED, BUT NOT WHERE THE GAME LOOKS FOR IT"
                end
                snd_deny.play(0.6)
            end
        end
        return
    end
    if install_state == INSTALL_RESTART do
        # The mode's code is built into the game by the loader: start it again, and go.
        if install_ticks == 90 do
            var loader = fs.join(GAME_DIR, ".loader")
            try
                if fs.exists(loader) do
                    os.start([loader])
                else do
                    os.start(["flywheel", fs.join(GAME_DIR, "loader.fw")])
                end
                ap.quit()
            catch e
                install_error = "RESTART THE GAME TO PLAY PURGATORY"
            end
        end
        return
    end
end

function start_install()
    install_state = INSTALL_RUNNING
    install_ticks = 0
    install_error = ""
    try
        install_pid = os.start(install_command(), INSTALL_LOG)
    catch e
        install_pid = -1
        install_state = INSTALL_FAILED
        install_error = "PULLEY IS NOT INSTALLED (SEE PULLEY'S README)"
        snd_deny.play(0.6)
    end
end

function update_select()
    camera = ap.Camera3D(ap.Vec3(1.3, 1.5, 3.7), ap.Vec3(1.3, 1.0, 0))
    cam_focus = ap.Vec3(1.3, 1.0, 0)
    if item_menu do
        update_item_menu()
        update_effects()
        return
    end
    if mode_menu do
        update_mode_menu()
        update_effects()
        return
    end
    if ap.key_pressed(ap.KEY_TAB) or ap.pad_pressed(ap.PAD_BACK) do
        level = (level + 1) % LEVEL_NAMES.length
        snd_move.play(0.5)
        remember()
    end
    if ap.key_pressed(ap.KEY_I) or ap.pad_pressed(ap.PAD_WEST) do
        open_item_menu()
        return
    end
    var m = ap.mouse()
    if ap.key_pressed(ap.KEY_M) or ap.pad_pressed(ap.PAD_NORTH) or (ap.mouse_pressed() and mode_label_rect().contains(m)) do
        mode_menu = true
        mode_cursor = 0
        screen_ticks = 0
        snd_card_fan.play(0.5)
        return
    end
    if ap.mouse_pressed() and items_label_rect().contains(m) do
        open_item_menu()
        return
    end
    if ap.key_pressed(ap.KEY_V) or (ap.mouse_pressed() and models_label_rect().contains(m)) do
        toggle_models()
        return
    end
    update_hover()
    var cards = cast.length + 1          # the last card picks at random
    var columns = grid_columns()
    var before = cursor
    if left_pressed() do
        cursor = (cursor + cards - 1) % cards
    end
    if right_pressed() do
        cursor = (cursor + 1) % cards
    end
    if up_pressed() and cursor - columns >= 0 do
        cursor -= columns
    end
    if down_pressed() do
        cursor = math.min(cursor + columns, cards - 1)
    end
    # The mouse can pick a card too.
    var clicked_card = false
    for i in 0..<cards do
        if card_rect(i).contains(m) do
            if ap.mouse_delta().length() > 0.3 do
                cursor = i
            end
            if ap.mouse_pressed() do
                cursor = i
                clicked_card = true
            end
        end
    end
    if cursor != before do
        snd_move.play(0.5)
        screen_ticks = 0
        key_row = HOVER_NONE
    end
    show_select_world()
    if select_world >= 0 do
        scene_life(cast[select_world].maximum.scene)
    end
    update_effects()
    if randomized() do
        # Nobody picks: the cards are the pool they are dealt from. A fighter's card bans them
        # or lets them back in, P (or the right shoulder) steps through the presets, and the last
        # card deals and fights.
        if ap.key_pressed(ap.KEY_P) or ap.pad_pressed(ap.PAD_RIGHT_SHOULDER) or (ap.mouse_pressed() and pool_label_rect().contains(m)) do
            cycle_pool_preset()
            snd_card_fan.play(0.5)
            return
        end
        if (confirm_pressed() and not ap.key_pressed(ap.KEY_R)) or clicked_card do
            if cursor >= cast.length do
                snd_pick.play(0.5)
                start_match()
            else if toggle_ban(cursor) do
                snd_lock.play(0.5, 0.8 if is_banned(cursor) else 1.3)
            else do
                snd_deny.play(0.5)
            end
        end
        return
    end
    if (confirm_pressed() and not ap.key_pressed(ap.KEY_R)) or clicked_card do
        var size = side_size()
        var choice = cursor
        if choice >= cast.length do
            choice = int(ap.random(0, double(cast.length) - 0.001))
            while on_team(picking, choice) do
                choice = int(ap.random(0, double(cast.length) - 0.001))
            end
        end
        if on_team(picking, choice) do
            snd_deny.play(0.5)
            return
        end
        snd_pick.play(0.5)
        var slot = pick_step % size
        if uses_teams() do
            teams[picking][slot] = choice
        end
        if slot == 0 do
            picks[picking] = choice
        end
        pick_step += 1
        if pick_step >= size * 2 do
            start_match()
        else do
            if pick_step // size != picking do
                cursor = cast.length
            end
            picking = pick_step // size
            screen_ticks = 0
        end
    else if back_pressed() do
        snd_move.play(0.5)
        if pick_step > 0 do
            pick_step -= 1
            picking = pick_step // side_size()
            cursor = teams[picking][pick_step % side_size()] if uses_teams() else picks[picking]
        else do
            go(SCREEN_TITLE)
        end
    end
end

function update_result()
    var champion = fighters[winner]
    cam_focus = cam_focus.lerp(champion.body.position + ap.Vec3(0, 1.1, 0), 0.06)
    cam_distance = ap.lerp(cam_distance, 4.6, 0.05)
    camera = ap.orbit(cam_focus, champion.heading + 20 * math.sin(double(screen_ticks) * 0.01), 10, cam_distance)
    var idle = Intent()
    step_fighter(fighters[0], fighters[1], idle)
    step_fighter(fighters[1], fighters[0], idle)
    update_effects()
    if screen_ticks > 40 do
        if confirm_pressed() do
            snd_pick.play(0.5)
            start_match()
        else if back_pressed() do
            snd_move.play(0.5)
            open_select()
        end
    end
end

# What should be playing now: the menus have their own tracks, a fight its round's track, a super
# its owner's theme from the moment it goes off, and the item draft the shop tune.
function update_music()
    var want = ""
    var loop = true
    if screen == SCREEN_PURGATORY do
        want = purgatory.music_now()
    else if screen == SCREEN_TITLE do
        want = "title"
    else if screen == SCREEN_SELECT do
        want = "shop" if menu_open() else "select"
    else if screen == SCREEN_RESULT do
        if result_jingle and screen_ticks > 5 and music.finished() do
            result_jingle = false
        end
        if result_jingle do
            want = "victory" if winner == 0 else "defeat"
            loop = false
        else do
            want = "results"
        end
    else if max_cut > 0 and cut_kind == CUT_JAM do
        want = ""                    # OFF AIR: the set goes dead
    else if max_cut > 0 and cut_len - max_cut >= cut_hit do
        want = super_music(fighters[cut_user])
    else if max_cut > 0 do
        want = music.current()
    else if merge_owner >= 0 do
        want = super_music(fighters[merge_owner])
    else if max_owner >= 0 do
        want = super_music(fighters[max_owner])
    else if phase == PHASE_DRAFT do
        want = "shop"
    else do
        want = music.fight_track(match_seed, round, decider() or finale_round())
    end
    music.want(want, loop)
    music.set_volume(saved.music * (0.45 if paused else 1.0))
    music.update()
    # CLOCKWORK's wind runs the music with the fight.
    var speed = time_scale if screen == SCREEN_FIGHT else 1.0
    if speed != music_speed_now do
        music_speed_now = speed
        ap.music_speed(speed)
    end
end
var music_speed_now = 1.0

# A super's theme: its own, or the round's fight track while it has none yet; WANTED DEAD has none at all.
function super_music(Fighter f) returns string
    if f.kit.maximum.silent do
        return ""
    end
    var own = music.super_track(f.kit.name)
    if music.exists(own) do
        return own
    end
    return music.fight_track(match_seed, round, decider() or finale_round())
end

# --- Drawing between ticks: the game runs at 60 ticks a second, but a screen can show more frames
# than that (or a frame can land between two ticks). Fighters and the camera are drawn part of the
# way from where they were a tick ago to where they are now, so motion stays smooth.
var render_alpha = 1.0
var prev_camera = ap.Camera3D(ap.Vec3(0, 3, 9), ap.Vec3(0, 1, 0))

function remember_motion()
    prev_camera = camera
    for g in fighters do
        g.prev_pos = g.body.position
        g.prev_heading = g.heading
        g.prev_pose = g.pose
    end
    for m in minions do
        m.prev_pos = m.body.position
        m.prev_heading = m.heading
        m.prev_pose = m.pose
    end
    # Effects too: a slowed fight has frames between ticks (see FIGHT_PACE), and without this
    # they would stand still on those frames and jump on the next.
    for sh in shots do
        sh.prev = sh.position
        sh.seen = true
    end
    for sp in sparks do
        sp.prev = sp.position
        sp.prev_size = sp.size
        sp.seen = true
    end
    for r in rings do
        r.prev_radius = r.radius
    end
    for fl in floaters do
        fl.prev = fl.position
        fl.seen = true
    end
    for mi in mirrors do
        mi.prev = mirror_at(mi)
        mi.seen = true
    end
end

# Where something is drawn between two ticks: `prev` a tick ago, `now` this tick. Not smoothed
# before its first tick or across a jump (a portal, a new round). During hitstop the world holds
# still (prev is now), while the camera keeps moving smoothly.
function between(ap.Vec3 prev, ap.Vec3 now, bool seen) returns ap.Vec3
    if not seen or (now - prev).length() > 3 do
        return now
    end
    return prev.lerp(now, render_alpha)
end
# The tick count for drawing: between the last two ticks in a fight, so spinning and pulsing
# things turn smoothly on the frames between ticks.
function draw_clock() returns double
    if screen != SCREEN_FIGHT do
        return double(ticks)
    end
    return double(ticks) - 1 + render_alpha
end
function between_value(double prev, double now) returns double
    if prev < 0 do
        return now
    end
    return prev + (now - prev) * render_alpha
end

# A jump of more than a few meters in one tick (a teleport, a portal, a new round) is not smoothed.
function jumped(Fighter f) returns bool
    return (f.body.position - f.prev_pos).length() > 2.0
end
function drawn_at(Fighter f) returns ap.Vec3
    if jumped(f) do
        return f.body.position
    end
    return f.prev_pos.lerp(f.body.position, render_alpha)
end
function drawn_heading(Fighter f) returns double
    if jumped(f) do
        return f.heading
    end
    return f.prev_heading + wrap(f.heading - f.prev_heading) * render_alpha
end
function drawn_pose(Fighter f) returns puppet.Pose
    if jumped(f) do
        return f.pose
    end
    return puppet.blend(f.prev_pose, f.pose, render_alpha)
end
function drawn_camera() returns ap.Camera3D
    if (camera.position - prev_camera.position).length() > 3 do
        return camera
    end
    var c = camera
    return ap.Camera3D(prev_camera.position.lerp(c.position, render_alpha), prev_camera.target.lerp(c.target, render_alpha),
        c.up, c.fov, c.near, c.far)
end

function update()
    remember_motion()
    ticks += 1
    screen_ticks += 1
    pad.update()
    update_music()
    if ap.key_pressed(ap.KEY_F2) do
        pixel = 1 if pixel >= 4 else pixel * 2
        scene = ap.Canvas(VIEW_W // pixel, VIEW_H // pixel)
    end
    if screen == SCREEN_TITLE do
        update_title()
    else if screen == SCREEN_SELECT do
        update_select()
    else if screen == SCREEN_FIGHT do
        update_fight()
    else if screen == SCREEN_PURGATORY do
        purgatory.typed_text = typed_now     # for copying out cursed books
        purgatory.update()
        if purgatory.wants_leave() do
            leave_purgatory()
        end
    else do
        update_result()
    end
end

function enter_purgatory()
    purgatory.open()
    go(SCREEN_PURGATORY)
end
function leave_purgatory()
    purgatory.close()
    ap.shadows(true, 2048, 0.8)
    apply_area()
    title_pop = [0.0, 0.0]
    title_pick = -1
    go(SCREEN_TITLE)
end

# --- The mode list and the item menu (select screen) --------------------------------------------
# M opens the game mode toggles; I opens the item menu: switch items on and off, save and
# load builds of them, make new ones in the Simple editor (a condition and up to three effects),
# or write them in Flywheel in the Advanced editor (custom_items.fw), in the game or in Solenoid.

var mode_menu = false
var mode_cursor = 0                  # which row of the mode toggles

const int VIEW_LIST = 0
const int VIEW_BUILDS = 1
const int VIEW_SIMPLE = 2
const int VIEW_CODE = 3
const int VIEW_NAME = 4              # typing a name for a new build
var item_menu = false
var im_view = VIEW_LIST
var im_cursor = 0
var im_top = 0
var im_note = ""                     # a line of feedback at the bottom...
var im_note_ticks = 0
var im_note_color = ap.WHITE
var build_cursor = 0
var name_buffer = ""

# The Simple editor's item being made (or changed: `simple_index` >= 0).
var simple_draft = save.SimpleItem("NEW ITEM", "", items.W_ALWAYS, 0, [items.E_DAMAGE, -1, -1], [15.0, 0.0, 0.0])
var simple_index = -1
var simple_row = 0

# The Advanced editor: custom_items.fw.
var code = editor.open("")
var code_marks = [0]
var code_check_pid = -1              # a running `flywheel -c` of the file
var code_check_log = ""
var code_good = ""                   # the last text that checked out (restored if a save fails)
var code_seen = ""                   # what was on disk when last read, to notice outside edits
var solenoid_hint = false

function menu_open() returns bool
    return mode_menu or item_menu
end

function note(string words, ap.Color color = ap.Color(190, 186, 210))
    im_note = words
    im_note_color = color
    im_note_ticks = 360
end

function remember()
    saved.items_mode = items_mode
    saved.setup = 1
    saved.duo = duo
    saved.length = length_kind
    saved.best_of = best_of
    saved.lineup = lineup
    saved.team_of = team_of
    string[] out = []
    for i in 0..<cast.length do
        if is_banned(i) do
            out.push(cast[i].name)
        end
    end
    saved.banned = out
    saved.level = level
    save.store(saved)
end

function restore_settings()
    items_mode = math.clamp(saved.items_mode, 0, ITEM_MODE_NAMES.length - 1)
    if saved.setup == 0 do
        # A save from before the toggles: one of ten modes (five 1v1, then the same five 2v2).
        var old = saved.mode % 5
        duo = saved.mode >= 5
        length_kind = LEN_ENDLESS if old >= 3 else LEN_BEST
        best_of = 5 if old == 1 or old == 2 else 3
        lineup = LINE_TEAM if old == 2 else (LINE_RANDOM if old == 4 else LINE_ONE)
    else do
        duo = saved.duo
        length_kind = math.clamp(saved.length, LEN_SINGLE, LEN_ENDLESS)
        best_of = saved.best_of if BEST_OFS.contains(saved.best_of) else 3
        lineup = math.clamp(saved.lineup, LINE_ONE, LINE_RANDOM_TEAM)
        team_of = math.clamp(saved.team_of, TEAM_OF_MIN, TEAM_OF_MAX)
    end
    if not lineup_open(lineup) do
        lineup = LINE_ONE
    end
    fit_teams()
    level = math.clamp(saved.level, 0, LEVEL_NAMES.length - 1)
end
restore_settings()
load_bans()
puppet.style = puppet.STYLE_CLASSIC if saved.classic_models else puppet.STYLE_FACETED

# --- The mode toggles: a row each for PLAYERS, LENGTH and FIGHTERS, plus BEST OF under a best of
# and TEAM OF under an Endless random team. A/D or a click changes a row; it takes effect at once.
const int ROW_PLAYERS = 0
const int ROW_LENGTH = 1
const int ROW_BEST = 2
const int ROW_FIGHTERS = 3
const int ROW_TEAM_OF = 4
const double SETUP_TOP = 76
const ap.Color SETUP_TINT = ap.Color(170, 110, 255)

function setup_rows() returns int[]
    int[] rows = [ROW_PLAYERS, ROW_LENGTH]
    if length_kind == LEN_BEST do
        rows.push(ROW_BEST)
    end
    rows.push(ROW_FIGHTERS)
    if endless() and lineup == LINE_RANDOM_TEAM do
        rows.push(ROW_TEAM_OF)
    end
    return rows
end

function row_title(int row) returns string
    return ["PLAYERS", "LENGTH", "BEST OF", "FIGHTERS", "TEAM OF"][row]
end

function row_options(int row) returns string[]
    if row == ROW_PLAYERS do
        return ["1 V 1", "2 V 2  (YOU + CPU ALLY)"]
    else if row == ROW_LENGTH do
        return ["SINGLE", "BEST OF {best_of}", "ENDLESS"]
    else if row == ROW_BEST do
        string[] out = []
        for n in BEST_OFS do
            out.push("{n}")
        end
        return out
    else if row == ROW_FIGHTERS do
        return ["ONE EACH", "TEAM", "RANDOM", "RANDOM TEAM OF {team_of}" if endless() else "RANDOM TEAM"]
    end
    string[] sizes = []
    for n in TEAM_OF_MIN..TEAM_OF_MAX do
        sizes.push("{n}")
    end
    return sizes
end

# Which option of a row is the one in force.
function row_value(int row) returns int
    if row == ROW_PLAYERS do
        return 1 if duo else 0
    else if row == ROW_LENGTH do
        return length_kind
    else if row == ROW_BEST do
        return BEST_OFS.index_of(best_of)
    else if row == ROW_FIGHTERS do
        return lineup
    end
    return team_of - TEAM_OF_MIN
end

function option_open(int row, int k) returns bool
    return row != ROW_FIGHTERS or lineup_open(k)
end

function setup_row_y(int n) returns double
    return SETUP_TOP + 30 + double(n) * 22
end

function option_rect(int n, int k) returns ap.Rect
    var options = row_options(setup_rows()[n])
    var x = 186.0
    for i in 0..<k do
        x += ap.measure(options[i], 8).x + 16
    end
    return ap.Rect(x, setup_row_y(n), ap.measure(options[k], 8).x + 12, 16)
end

function setup_panel() returns ap.Rect
    return ap.Rect(100, SETUP_TOP, 440, 206)
end

# Sets option `k` of `row`. Choosing a length a fighters choice does not go with moves the fighters
# to the nearest that does (a team to one each, a random team to random).
function choose_option(int row, int k)
    if not option_open(row, k) do
        snd_deny.play(0.5)
        return
    end
    if row == ROW_PLAYERS do
        duo = k == 1
    else if row == ROW_LENGTH do
        length_kind = k
    else if row == ROW_BEST do
        best_of = BEST_OFS[k]
    else if row == ROW_FIGHTERS do
        lineup = k
    else do
        team_of = TEAM_OF_MIN + k
    end
    if not lineup_open(lineup) do
        lineup = LINE_RANDOM if lineup == LINE_RANDOM_TEAM else LINE_ONE
    end
    # Picks made for the old setup do not carry over.
    pick_step = 0
    picking = 0
    cursor = picks[0]
    fit_teams()
    remember()
    snd_pick.play(0.4)
end

# A/D: the next option along that can be chosen.
function step_option(int row, int dir)
    var count = row_options(row).length
    var k = row_value(row) + dir
    while k >= 0 and k < count and not option_open(row, k) do
        k += dir
    end
    if k >= 0 and k < count do
        choose_option(row, k)
    else do
        snd_deny.play(0.3)
    end
end

function update_mode_menu()
    var rows = setup_rows()
    mode_cursor = math.clamp(mode_cursor, 0, rows.length - 1)
    if up_pressed() do
        mode_cursor = (mode_cursor + rows.length - 1) % rows.length
        snd_move.play(0.4)
    end
    if down_pressed() do
        mode_cursor = (mode_cursor + 1) % rows.length
        snd_move.play(0.4)
    end
    if left_pressed() do
        step_option(rows[mode_cursor], -1)
        return
    end
    if right_pressed() do
        step_option(rows[mode_cursor], 1)
        return
    end
    var m = ap.mouse()
    for n, row in rows do
        for k in 0..<row_options(row).length do
            if option_rect(n, k).contains(m) do
                if ap.mouse_delta().length() > 0.3 and mode_cursor != n do
                    mode_cursor = n
                    snd_move.play(0.3)
                end
                if ap.mouse_pressed() do
                    mode_cursor = n
                    choose_option(row, k)
                    return
                end
            end
        end
    end
    var leave = ap.mouse_pressed() and not setup_panel().contains(m)
    if leave or ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_SPACE) or ap.key_pressed(ap.KEY_M) or
            ap.pad_pressed(ap.PAD_SOUTH) or back_pressed() do
        snd_move.play(0.4)
        mode_menu = false
    end
end

# What the setup chosen plays like, and why a greyed-out choice is greyed out.
function setup_notes() returns string[]
    var first = "Round after round: nobody ever takes the match."
    if length_kind == LEN_SINGLE do
        first = "One round takes the match."
    else if finale_slots() do
        first = "Fill your two slots, then take the finale in the middle."
    else if length_kind == LEN_BEST do
        first = "First to {wins_needed()} rounds takes the match."
    end
    var second = "Each side picks two: a fighter and an ally." if duo else "Each side picks its fighter."
    if lineup == LINE_TEAM do
        second = "Teams of {team_size()}: every round lost sends in the next."
        if duo do
            second = "Teams of {team_size()}, two in at a time: a lost round rotates."
        end
    else if lineup == LINE_RANDOM do
        second = "Nobody picks: all are dealt new fighters every round."
    else if lineup == LINE_RANDOM_TEAM do
        second = "Teams of {team_size()}, dealt at random: a lost round sends in the next."
        if endless() do
            second = "Teams of {team_size()}, dealt at random (repeats allowed), round and round."
        end
    end
    var third = ""
    var rows = setup_rows()
    if mode_cursor < rows.length and rows[mode_cursor] == ROW_FIGHTERS do
        if length_kind == LEN_SINGLE do
            third = "TEAM and RANDOM TEAM need more than one round."
        else if endless() do
            third = "TEAM needs a best of: in Endless, deal a random team instead."
        end
    end
    return [first, second, third]
end

function draw_mode_menu()
    var open = math.min(double(screen_ticks) / 8, 1.0)
    ap.rect(0, 0, VW, VH, ap.BLACK.fade(0.55 * open))
    var panel = setup_panel()
    var top = panel.y
    ap.rect(panel.x, panel.y, panel.w, panel.h, ap.Color(16, 14, 26).fade(0.97))
    ap.rect_lines(panel.x, panel.y, panel.w, panel.h, 1, MAX_GOLD.fade(0.7))
    label_centered("GAME MODE", 320, top + 6, 16, MAX_GOLD)
    for n, row in setup_rows() do
        var on_row = n == mode_cursor
        var y = setup_row_y(n)
        if on_row do
            ap.rect(panel.x + 4, y - 2, panel.w - 8, 20, SETUP_TINT.fade(0.12))
            ap.rect(panel.x + 4, y - 2, 2, 20, MAX_GOLD)
        end
        label(row_title(row), 114, y + 5, 8, MAX_GOLD if on_row else ap.Color(150, 145, 175))
        var value = row_value(row)
        for k, words in row_options(row) do
            var r = option_rect(n, k)
            var picked = k == value
            var can = option_open(row, k)
            ap.rect(r.x, r.y, r.w, r.h, SETUP_TINT.brightness(0.45) if picked else ap.Color(28, 24, 42).fade(0.9))
            if picked and on_row do
                ap.rect_lines(r.x - 1, r.y - 1, r.w + 2, r.h + 2, 1, MAX_GOLD)
            end
            var color = ap.WHITE if picked else (ap.Color(180, 176, 200) if can else ap.Color(70, 66, 88))
            label_centered(words, r.x + r.w / 2, r.y + 5, 8, color)
            if not can do
                ap.rect(r.x + 3, r.y + r.h / 2, r.w - 6, 1, ap.Color(70, 66, 88))
            end
        end
    end
    var notes = setup_notes()
    label_centered(notes[0], 320, top + 144, 8, ap.Color(200, 196, 220))
    label_centered(notes[1], 320, top + 156, 8, ap.Color(200, 196, 220))
    label_centered(notes[2], 320, top + 170, 8, ap.Color(130, 126, 150))
    label_centered("W/S  ROW    A/D / CLICK  CHANGE    M / ENTER / ESC  DONE", 320, top + 188, 8, ap.Color(150, 145, 175))
end

# --- The item menu.
function list_row(int i) returns ap.Rect
    return ap.Rect(20, 50 + double(i - im_top) * 11, 300, 11)
end
const int LIST_ROWS = 23

class MenuButton
    string key_name
    string words
    int action
end
const int ACT_ALL_ON = 0
const int ACT_ALL_OFF = 1
const int ACT_BUILDS = 2
const int ACT_NEW_SIMPLE = 3
const int ACT_EDIT_SIMPLE = 4
const int ACT_DELETE_SIMPLE = 5
const int ACT_ADVANCED = 6
const int ACT_SOLENOID = 7
const int ACT_WHO = 8
const int ACT_CLOSE = 9

function menu_buttons() returns MenuButton[]
    MenuButton[] out = [MenuButton("P", "WHO PICKS: {ITEM_MODE_NAMES[items_mode]}", ACT_WHO),
        MenuButton("Z", "ALL ON", ACT_ALL_ON), MenuButton("X", "ALL OFF", ACT_ALL_OFF),
        MenuButton("B", "BUILDS ({saved.builds.length})", ACT_BUILDS), MenuButton("N", "NEW SIMPLE ITEM", ACT_NEW_SIMPLE)]
    if im_cursor < item_defs.length and item_defs[im_cursor].source == items.SOURCE_SIMPLE do
        out.push(MenuButton("C", "CHANGE THIS ITEM", ACT_EDIT_SIMPLE))
        out.push(MenuButton("DEL", "DELETE THIS ITEM", ACT_DELETE_SIMPLE))
    end
    out.push(MenuButton("V", "ADVANCED EDITOR (FLYWHEEL)", ACT_ADVANCED))
    out.push(MenuButton("O", "OPEN IN SOLENOID", ACT_SOLENOID))
    out.push(MenuButton("ESC", "DONE", ACT_CLOSE))
    return out
end

function button_rect(int i) returns ap.Rect
    return ap.Rect(344, 170 + double(i) * 15, 280, 13)
end

function open_item_menu()
    item_menu = true
    im_view = VIEW_LIST
    im_cursor = math.clamp(im_cursor, 0, math.max(item_defs.length - 1, 0))
    snd_book.play(0.5)
    snd_pick.play(0.3)
end

function toggle_item(int index)
    var key = items.key_of(item_defs[index])
    if key in saved.off do
        string[] kept = []
        for k in saved.off do
            if k != key do
                kept.push(k)
            end
        end
        saved.off = kept
        snd_coin_a.play(0.4, 1.2)
    else do
        saved.off.push(key)
        snd_card.play(0.5, 0.9)
    end
    save.store(saved)
end

function set_all(bool on)
    string[] off = []
    if not on do
        for it in item_defs do
            off.push(items.key_of(it))
        end
    end
    saved.off = off
    save.store(saved)
    note("EVERY ITEM SWITCHED ON" if on else "EVERY ITEM SWITCHED OFF")
    snd_shuffle.play(0.5)
end

function count_on() returns int
    var n = 0
    for i in 0..<item_defs.length do
        if item_on(i) do
            n += 1
        end
    end
    return n
end

function do_action(int action)
    if action == ACT_ALL_ON do
        set_all(true)
    else if action == ACT_ALL_OFF do
        set_all(false)
    else if action == ACT_BUILDS do
        im_view = VIEW_BUILDS
        build_cursor = 0
        snd_book.play(0.5)
    else if action == ACT_NEW_SIMPLE do
        simple_draft = save.SimpleItem("MY ITEM", "", items.W_ALWAYS, 0, [items.E_DAMAGE, -1, -1], [15.0, 0.0, 0.0])
        simple_index = -1
        simple_row = 0
        im_view = VIEW_SIMPLE
        snd_book.play(0.5)
    else if action == ACT_EDIT_SIMPLE do
        var index = item_defs[im_cursor].id - 1000
        if index >= 0 and index < saved.simple.length do
            var s = saved.simple[index]
            int[] kinds = [-1, -1, -1]
            double[] amounts = [0.0, 0.0, 0.0]
            for k in 0..<math.min(s.kinds.length, 3) do
                kinds[k] = s.kinds[k]
                amounts[k] = s.amounts[k]
            end
            simple_draft = save.SimpleItem(s.name, s.flavor, s.condition, s.param, kinds, amounts)
            simple_index = index
            simple_row = 0
            im_view = VIEW_SIMPLE
            snd_book.play(0.5)
        end
    else if action == ACT_DELETE_SIMPLE do
        var index = item_defs[im_cursor].id - 1000
        if index >= 0 and index < saved.simple.length do
            var gone = saved.simple[index].name
            save.SimpleItem[] kept = []
            for i, s in saved.simple do
                if i != index do
                    kept.push(s)
                end
            end
            saved.simple = kept
            save.store(saved)
            gather_items()
            im_cursor = math.min(im_cursor, item_defs.length - 1)
            note("DELETED {gone}", ap.Color(255, 140, 120))
            snd_deny.play(0.5)
        end
    else if action == ACT_ADVANCED do
        open_code_editor()
    else if action == ACT_SOLENOID do
        open_in_solenoid()
    else if action == ACT_WHO do
        items_mode = (items_mode + 1) % ITEM_MODE_NAMES.length
        remember()
        snd_move.play(0.5)
    else if action == ACT_CLOSE do
        item_menu = false
        snd_book.play(0.4, 0.8)
    end
end

function update_item_menu()
    im_note_ticks = math.max(im_note_ticks - 1, 0)
    if im_view == VIEW_CODE do
        update_code_editor()
        return
    else if im_view == VIEW_SIMPLE do
        update_simple_editor()
        return
    else if im_view == VIEW_BUILDS do
        update_builds()
        return
    else if im_view == VIEW_NAME do
        update_name_prompt()
        return
    end
    var count = item_defs.length
    if count == 0 do
        return
    end
    if up_pressed() do
        im_cursor = (im_cursor + count - 1) % count
        snd_move.play(0.3)
    end
    if down_pressed() do
        im_cursor = (im_cursor + 1) % count
        snd_move.play(0.3)
    end
    if ap.key_pressed(ap.KEY_PAGE_UP) do
        im_cursor = math.max(im_cursor - LIST_ROWS, 0)
    end
    if ap.key_pressed(ap.KEY_PAGE_DOWN) do
        im_cursor = math.min(im_cursor + LIST_ROWS, count - 1)
    end
    var wheel = ap.wheel().y
    if wheel != 0 do
        im_top = math.clamp(im_top - int(wheel * 3), 0, math.max(count - LIST_ROWS, 0))
    end
    var m = ap.mouse()
    # Hovering a row shows it; clicking its box switches it.
    for i in im_top..<math.min(im_top + LIST_ROWS, count) do
        if list_row(i).contains(m) and ap.mouse_delta().length() > 0.3 do
            im_cursor = i
        end
    end
    if ap.mouse_pressed() do
        for i in im_top..<math.min(im_top + LIST_ROWS, count) do
            if list_row(i).contains(m) do
                im_cursor = i
                toggle_item(i)
            end
        end
        for i, b in menu_buttons() do
            if button_rect(i).contains(m) do
                do_action(b.action)
                return
            end
        end
    end
    if wheel == 0 do
        if im_cursor < im_top do
            im_top = im_cursor
        else if im_cursor >= im_top + LIST_ROWS do
            im_top = im_cursor - LIST_ROWS + 1
        end
    end
    if ap.key_pressed(ap.KEY_SPACE) or ap.key_pressed(ap.KEY_ENTER) or ap.pad_pressed(ap.PAD_SOUTH) do
        toggle_item(im_cursor)
    else if ap.key_pressed(ap.KEY_Z) do
        do_action(ACT_ALL_ON)
    else if ap.key_pressed(ap.KEY_X) do
        do_action(ACT_ALL_OFF)
    else if ap.key_pressed(ap.KEY_B) do
        do_action(ACT_BUILDS)
    else if ap.key_pressed(ap.KEY_N) do
        do_action(ACT_NEW_SIMPLE)
    else if ap.key_pressed(ap.KEY_C) and item_defs[im_cursor].source == items.SOURCE_SIMPLE do
        do_action(ACT_EDIT_SIMPLE)
    else if ap.key_pressed(ap.KEY_DELETE) and item_defs[im_cursor].source == items.SOURCE_SIMPLE do
        do_action(ACT_DELETE_SIMPLE)
    else if ap.key_pressed(ap.KEY_V) do
        do_action(ACT_ADVANCED)
    else if ap.key_pressed(ap.KEY_O) do
        do_action(ACT_SOLENOID)
    else if ap.key_pressed(ap.KEY_P) do
        do_action(ACT_WHO)
    else if ap.key_pressed(ap.KEY_I) or back_pressed() do
        do_action(ACT_CLOSE)
    end
end

function draw_item_menu()
    ap.rect(0, 0, VW, VH, ap.Color(8, 6, 14).fade(0.97))
    if im_view == VIEW_CODE do
        draw_code_editor()
        return
    else if im_view == VIEW_SIMPLE do
        draw_simple_editor()
        return
    end
    label("ITEMS", 16, 10, 24, MAX_GOLD)
    label("{count_on()} OF {item_defs.length} IN THE DRAFT", 120, 22, 8, ap.Color(170, 165, 190))
    var where = save.path()
    var home = save.env("HOME")
    if home != "" and where.starts_with(home) do
        where = "~{where[home.length..<where.length]}"
    end
    if where.length > 48 do
        where = "...{where[where.length - 45..<where.length]}"
    end
    label_right("SAVED IN {where}", 624, 22, 8, ap.Color(90, 86, 110))
    ap.rect(0, 40, VW, 1, MAX_GOLD.fade(0.3))
    if im_view == VIEW_BUILDS or im_view == VIEW_NAME do
        draw_builds()
        draw_menu_note()
        return
    end
    # The list.
    for i in im_top..<math.min(im_top + LIST_ROWS, item_defs.length) do
        var it = item_defs[i]
        var r = list_row(i)
        var chosen = i == im_cursor
        var on = item_on(i)
        if chosen do
            ap.rect(r.x - 2, r.y - 1, r.w + 4, r.h, ap.Color(46, 40, 70))
        end
        ap.rect_lines(r.x, r.y + 1, 8, 8, 1, ap.Color(150, 145, 175))
        if on do
            ap.rect(r.x + 2, r.y + 3, 4, 4, tier_color(it.tier))
        end
        label(it.name, r.x + 14, r.y + 1, 8, (ap.WHITE if chosen else ap.Color(200, 196, 220)) if on else ap.Color(100, 96, 118))
        var tag = ["", "SIMPLE", "FLYWHEEL"][it.source]
        if tag != "" do
            label_right(tag, r.x + r.w, r.y + 1, 8, ap.Color(255, 206, 110) if it.source == items.SOURCE_CODE else ap.Color(120, 200, 255))
        end
    end
    if item_defs.length > LIST_ROWS do
        var share = double(LIST_ROWS) / double(item_defs.length)
        ap.rect(324, 50 + 253 * double(im_top) / double(item_defs.length), 2, 253 * share, ap.Color(120, 110, 160))
    end
    # The one under the cursor.
    if im_cursor < item_defs.length do
        var it = item_defs[im_cursor]
        var x = 344.0
        var tint = tier_color(it.tier)
        label(it.name, x, 50, 16, tint)
        var tiers = ["COMMON", "RARE", "CURSED"]
        var kind = ["BUILT IN", "MADE IN THE SIMPLE EDITOR", "WRITTEN IN FLYWHEEL"][it.source]
        label("{tiers[it.tier]}  -  {kind}", x, 70, 8, ap.Color(150, 145, 175))
        for n, line in wrap_words(items.describe(it), 46) do
            label(line, x, 86 + double(n) * 10, 8, ap.WHITE)
        end
        for n, line in wrap_words(it.flavor, 46) do
            label(line, x, 120 + double(n) * 10, 8, ap.Color(140, 136, 160))
        end
        label("IN THE DRAFT" if item_on(im_cursor) else "LEFT OUT", x, 148, 8,
            ap.Color(150, 225, 120) if item_on(im_cursor) else ap.Color(255, 120, 110))
    end
    var m = ap.mouse()
    for i, b in menu_buttons() do
        var r = button_rect(i)
        var hover = r.contains(m)
        ap.rect(r.x, r.y, r.w, r.h, ap.Color(40, 34, 60) if hover else ap.Color(24, 20, 36))
        label(b.key_name, r.x + 4, r.y + 3, 8, MAX_GOLD)
        label(b.words, r.x + 34, r.y + 3, 8, ap.WHITE if hover else ap.Color(200, 196, 220))
    end
    label("W / S  MOVE     SPACE / CLICK  SWITCH ON OR OFF     WHEEL  SCROLL", 16, 346, 8, ap.Color(110, 106, 130))
    draw_menu_note()
end

function draw_menu_note()
    if im_note_ticks > 0 do
        var fade = math.min(double(im_note_ticks) / 30, 1.0)
        ap.rect(0, 318, VW, 16, ap.BLACK.fade(0.7 * fade))
        label_centered(im_note, 320, 322, 8, im_note_color.fade(fade))
    end
end

# --- Builds: named sets of switched-off items.
function update_name_prompt()
    for i in 0..<typed_now.length do
        var c = typed_now[i..i]
        if name_buffer.length < 22 do
            name_buffer = "{name_buffer}{c.upper()}"
        end
    end
    if ap.key_pressed(ap.KEY_BACKSPACE) and name_buffer.length > 0 do
        name_buffer = name_buffer[0..<name_buffer.length - 1]
    end
    if ap.key_pressed(ap.KEY_ENTER) and name_buffer.trim() != "" do
        var name = name_buffer.trim()
        save.Build[] kept = []
        for b in saved.builds do
            if b.name != name do
                kept.push(b)
            end
        end
        string[] off = []
        for k in saved.off do
            off.push(k)
        end
        kept.push(save.Build(name, off))
        saved.builds = kept
        save.store(saved)
        note("SAVED BUILD {name}", ap.Color(150, 225, 120))
        snd_gold_sack.play(0.5)
        im_view = VIEW_BUILDS
        build_cursor = saved.builds.length - 1
    else if ap.key_pressed(ap.KEY_ESCAPE) do
        im_view = VIEW_BUILDS
    end
end

function load_build(int index)
    var b = saved.builds[index]
    string[] off = []
    for k in b.off do
        off.push(k)
    end
    saved.off = off
    save.store(saved)
    note("LOADED BUILD {b.name}: {count_on()} ITEMS IN THE DRAFT", ap.Color(150, 225, 120))
    snd_shuffle.play(0.5)
end

function update_builds()
    var count = saved.builds.length + 1          # the last row saves a new one
    if up_pressed() do
        build_cursor = (build_cursor + count - 1) % count
        snd_move.play(0.3)
    end
    if down_pressed() do
        build_cursor = (build_cursor + 1) % count
        snd_move.play(0.3)
    end
    var m = ap.mouse()
    var clicked = -1
    for i in 0..<count do
        var r = ap.Rect(120, 60 + double(i) * 14, 400, 13)
        if r.contains(m) and ap.mouse_delta().length() > 0.3 do
            build_cursor = i
        end
        if r.contains(m) and ap.mouse_pressed() do
            clicked = i
        end
    end
    if clicked >= 0 or ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_SPACE) do
        var i = clicked if clicked >= 0 else build_cursor
        if i >= saved.builds.length do
            name_buffer = ""
            im_view = VIEW_NAME
        else do
            load_build(i)
        end
    else if (ap.key_pressed(ap.KEY_DELETE) or ap.key_pressed(ap.KEY_BACKSPACE)) and build_cursor < saved.builds.length do
        var gone = saved.builds[build_cursor].name
        save.Build[] kept = []
        for i, b in saved.builds do
            if i != build_cursor do
                kept.push(b)
            end
        end
        saved.builds = kept
        save.store(saved)
        note("DELETED BUILD {gone}", ap.Color(255, 140, 120))
        snd_deny.play(0.5)
    else if ap.key_pressed(ap.KEY_S) do
        name_buffer = ""
        im_view = VIEW_NAME
    else if ap.key_pressed(ap.KEY_B) or back_pressed() do
        im_view = VIEW_LIST
        snd_book.play(0.4, 0.8)
    end
end

function draw_builds()
    label_centered("BUILDS", 320, 46, 8, MAX_GOLD)
    var count = saved.builds.length + 1
    for i in 0..<count do
        var r = ap.Rect(120, 60 + double(i) * 14, 400, 13)
        var chosen = i == build_cursor
        ap.rect(r.x, r.y, r.w, r.h, ap.Color(46, 40, 70) if chosen else ap.Color(24, 20, 36))
        if i < saved.builds.length do
            var b = saved.builds[i]
            label(b.name, r.x + 6, r.y + 3, 8, ap.WHITE if chosen else ap.Color(200, 196, 220))
            label_right("{item_defs.length - b.off.length} ITEMS ON", r.x + r.w - 6, r.y + 3, 8, ap.Color(150, 145, 175))
        else do
            label("+ SAVE WHAT IS SWITCHED ON NOW AS A BUILD", r.x + 6, r.y + 3, 8, MAX_GOLD if chosen else ap.Color(200, 180, 120))
        end
    end
    if im_view == VIEW_NAME do
        ap.rect(170, 150, 300, 50, ap.Color(16, 14, 26))
        ap.rect_lines(170, 150, 300, 50, 1, MAX_GOLD)
        label_centered("NAME THE BUILD", 320, 158, 8, MAX_GOLD)
        var caret = "_" if (ticks // 25) % 2 == 0 else " "
        label_centered("{name_buffer}{caret}", 320, 174, 16, ap.WHITE)
        label_centered("ENTER  SAVE     ESC  CANCEL", 320, 210, 8, ap.Color(150, 145, 175))
    end
    label("W / S  MOVE     ENTER / CLICK  LOAD     DEL  DELETE     S  SAVE NEW     B / ESC  BACK", 16, 346, 8,
        ap.Color(110, 106, 130))
end

# --- The Simple editor: a name, a condition, up to three effects.
const int SIMPLE_ROWS = 10           # name, flavor, condition, its number, 3 x (effect, amount), save

function effect_step(int kind) returns double
    if kind == items.E_POISON or kind == items.E_SLOW or kind == items.E_REFUND do
        return 0.25
    else if kind == items.E_REGEN or kind == items.E_BAR_HIT or kind == items.E_SUPER_HIT or
            kind == items.E_HEAL_HIT or kind == items.E_STEAL or kind == items.E_PARRY_TIME or kind == items.E_LAUNCH do
        return 1
    else if kind == items.E_SHIELD or kind == items.E_PARRY_HEAL do
        return 5
    end
    return 5
end

function simple_item() returns items.ItemDef
    var it = items.ItemDef(0, simple_draft.name.upper(), simple_draft.flavor, simple_draft.condition, simple_draft.param)
    items.Effect[] list = []
    for k in 0..<3 do
        if simple_draft.kinds[k] >= 0 do
            list.push(items.Effect(simple_draft.kinds[k], simple_draft.amounts[k]))
        end
    end
    it.effects = list
    return it
end

function update_simple_editor()
    var rows = SIMPLE_ROWS
    if up_pressed_menu() do
        simple_row = (simple_row + rows - 1) % rows
        snd_move.play(0.3)
    end
    if down_pressed_menu() do
        simple_row = (simple_row + 1) % rows
        snd_move.play(0.3)
    end
    var m = ap.mouse()
    for i in 0..<rows do
        if simple_rect(i).contains(m) and ap.mouse_pressed() do
            simple_row = i
        end
    end
    var step = 0
    if ap.key_pressed(ap.KEY_LEFT) or (ap.mouse_pressed(ap.MOUSE_RIGHT) and simple_rect(simple_row).contains(m)) do
        step = -1
    end
    if ap.key_pressed(ap.KEY_RIGHT) or (ap.mouse_pressed() and simple_rect(simple_row).contains(m) and simple_row >= 2) do
        step = 1
    end
    var d = simple_draft
    if simple_row == 0 or simple_row == 1 do
        # Typing: the arrows and the letters W A S D are text here, so only Up/Down move.
        var words = d.name if simple_row == 0 else d.flavor
        var most = 18 if simple_row == 0 else 44
        for i in 0..<typed_now.length do
            var c = typed_now[i..i]
            if words.length < most do
                words = "{words}{c.upper() if simple_row == 0 else c}"
            end
        end
        if ap.key_pressed(ap.KEY_BACKSPACE) and words.length > 0 do
            words = words[0..<words.length - 1]
        end
        if simple_row == 0 do
            d.name = words
        else do
            d.flavor = words
        end
    else if simple_row == 2 and step != 0 do
        d.condition = (d.condition + step + items.CONDITION_COUNT) % items.CONDITION_COUNT
        d.param = items.condition_param(d.condition)
        snd_card.play(0.4)
    else if simple_row == 3 and step != 0 and items.takes_param(d.condition) do
        var c = d.condition
        var fine = c == items.W_CLOSE or c == items.W_FAR or c == items.W_AFTER_PARRY or c == items.W_AFTER_HURT or
            c == items.W_UNHURT
        var unit = 5.0
        if fine do
            unit = 0.5
        else if c == items.W_COMBO do
            unit = 1.0
        end
        d.param = math.clamp(d.param + unit * double(step), unit, 100.0)
        snd_move.play(0.3)
    else if simple_row >= 4 and simple_row <= 9 and simple_row != 9 and step != 0 do
        var k = (simple_row - 4) // 2
        if (simple_row - 4) % 2 == 0 do
            # The effect itself (or none).
            var kind = d.kinds[k] + step
            if kind < -1 do
                kind = items.EFFECT_COUNT - 1
            else if kind >= items.EFFECT_COUNT do
                kind = -1
            end
            d.kinds[k] = kind
            d.amounts[k] = effect_step(kind) * 3 if kind >= 0 else 0.0
            snd_card.play(0.4)
        else if d.kinds[k] >= 0 do
            d.amounts[k] = math.clamp(d.amounts[k] + effect_step(d.kinds[k]) * double(step), -90.0, 300.0)
            snd_move.play(0.3)
        end
    end
    var save_row = SIMPLE_ROWS - 1
    var pressed_save = (simple_row == save_row and (ap.key_pressed(ap.KEY_ENTER) or
        (ap.mouse_pressed() and simple_rect(save_row).contains(m))))
    if pressed_save do
        if d.name.trim() == "" do
            note("GIVE IT A NAME FIRST", ap.Color(255, 140, 120))
            snd_deny.play(0.5)
            return
        end
        int[] kinds = []
        double[] amounts = []
        for k in 0..<3 do
            if d.kinds[k] >= 0 do
                kinds.push(d.kinds[k])
                amounts.push(d.amounts[k])
            end
        end
        if kinds.length == 0 do
            note("ADD AT LEAST ONE EFFECT", ap.Color(255, 140, 120))
            snd_deny.play(0.5)
            return
        end
        var made = save.SimpleItem(d.name.trim().upper(), d.flavor.trim(), d.condition, d.param, kinds, amounts)
        if simple_index >= 0 and simple_index < saved.simple.length do
            saved.simple[simple_index] = made
        else do
            saved.simple.push(made)
        end
        save.store(saved)
        gather_items()
        for i, it in item_defs do
            if it.source == items.SOURCE_SIMPLE and it.name == made.name do
                im_cursor = i
            end
        end
        note("{made.name} IS IN THE DRAFT", ap.Color(150, 225, 120))
        snd_gold_sack.play(0.5)
        im_view = VIEW_LIST
    else if ap.key_pressed(ap.KEY_ESCAPE) do
        im_view = VIEW_LIST
        snd_book.play(0.4, 0.8)
    else if simple_row >= 2 and simple_row != save_row and ap.key_pressed(ap.KEY_ENTER) do
        simple_row += 1
    end
end

# Up and Down only (W and S are letters while typing a name).
function up_pressed_menu() returns bool
    return ap.key_pressed(ap.KEY_UP) or ap.pad_pressed(ap.PAD_UP) or (simple_row >= 2 and ap.key_pressed(ap.KEY_W))
end
function down_pressed_menu() returns bool
    return ap.key_pressed(ap.KEY_DOWN) or ap.pad_pressed(ap.PAD_DOWN) or (simple_row >= 2 and ap.key_pressed(ap.KEY_S))
end

function simple_rect(int row) returns ap.Rect
    return ap.Rect(110, 62 + double(row) * 20 + (8.0 if row >= 4 else 0.0) + (8.0 if row == 9 else 0.0), 420, 16)
end

function draw_simple_editor()
    label("SIMPLE EDITOR", 16, 10, 24, MAX_GOLD)
    label("A CONDITION AND UP TO THREE EFFECTS", 268, 22, 8, ap.Color(170, 165, 190))
    ap.rect(0, 40, VW, 1, MAX_GOLD.fade(0.3))
    var d = simple_draft
    string[] titles = ["NAME", "FLAVOR", "WORKS", "NUMBER", "EFFECT 1", "AMOUNT", "EFFECT 2", "AMOUNT", "EFFECT 3", ""]
    for row in 0..<SIMPLE_ROWS do
        var r = simple_rect(row)
        var chosen = row == simple_row
        ap.rect(r.x, r.y, r.w, r.h, ap.Color(46, 40, 70) if chosen else ap.Color(22, 18, 34))
        if chosen do
            ap.rect_lines(r.x - 1, r.y - 1, r.w + 2, r.h + 2, 1, MAX_GOLD)
        end
        label_right(titles[row], r.x - 8, r.y + 4, 8, ap.Color(150, 145, 175))
        var words = ""
        var dim = false
        var caret = "_" if chosen and (ticks // 25) % 2 == 0 else ""
        if row == 0 do
            words = "{d.name}{caret}"
        else if row == 1 do
            words = "{d.flavor}{caret}" if d.flavor != "" or chosen else "(a line about it, optional)"
            dim = d.flavor == "" and not chosen
        else if row == 2 do
            words = "< {items.CONDITION_NAMES[d.condition]} >"
        else if row == 3 do
            words = "< {items.number(d.param)} >" if items.takes_param(d.condition) else "-"
            dim = not items.takes_param(d.condition)
        else if row == 9 do
            words = "SAVE ITEM" if simple_index < 0 else "SAVE CHANGES"
        else do
            var k = (row - 4) // 2
            var kind = d.kinds[k]
            if (row - 4) % 2 == 0 do
                words = "< {items.EFFECT_NAMES[kind]} >" if kind >= 0 else "< NONE >"
                dim = kind < 0
            else do
                words = "< {items.number(d.amounts[k])} >" if kind >= 0 else "-"
                dim = kind < 0
            end
        end
        if row == 9 do
            label_centered(words, r.x + r.w / 2, r.y + 4, 8, MAX_GOLD if chosen else ap.Color(200, 180, 120))
        else do
            label(words, r.x + 8, r.y + 4, 8, ap.Color(110, 106, 130) if dim else ap.WHITE)
        end
    end
    # How it will read in the draft.
    var it = simple_item()
    ap.rect(110, 300, 420, 30, ap.Color(24, 20, 36))
    label("PREVIEW", 116, 304, 8, ap.Color(150, 145, 175))
    var lines = wrap_words("{it.name}: {items.describe(it)}", 66)
    for n, line in lines do
        label(line, 170, 304 + double(n) * 10, 8, ap.Color(120, 200, 255))
    end
    label("UP / DOWN  ROW     LEFT / RIGHT (OR CLICK)  CHANGE     TYPE  NAME     ENTER  SAVE     ESC  BACK", 16, 346, 8,
        ap.Color(110, 106, 130))
    draw_menu_note()
end

# --- The Advanced editor: custom_items.fw, checked by the compiler before it is kept.
function code_path() returns string
    return fs.join(GAME_DIR, "custom_items.fw")
end

function open_code_editor()
    var text = fs.read(code_path()) if fs.exists(code_path()) else ""
    code = editor.open(text)
    code_good = text
    code_seen = text
    code_marks = [0]
    im_view = VIEW_CODE
    snd_book.play(0.5)
    note("CTRL+S SAVES AND CHECKS IT. CTRL+O OPENS IT IN SOLENOID.", ap.Color(190, 186, 210))
end

function open_in_solenoid()
    if not fs.exists(code_path()) do
        note("NO custom_items.fw NEXT TO THE GAME", ap.Color(255, 140, 120))
        return
    end
    try
        os.start(["solenoid", "desktop", code_path()], fs.join(fs.temp_dir(), "playerversus-solenoid.log"))
        note("OPENING custom_items.fw IN SOLENOID...", ap.Color(150, 225, 120))
        snd_pick.play(0.5)
        solenoid_hint = true
    catch e
        note("SOLENOID IS NOT INSTALLED: pulley pull polymorphia.solenoid@wednesware.org", ap.Color(255, 140, 120))
        snd_deny.play(0.5)
    end
end

# Writes the editor's text, then has the compiler check it (in the background) through a small
# program that calls every hook the way the game does.
function save_code()
    if code_check_pid >= 0 do
        return
    end
    var text = editor.text_of(code)
    fs.write(code_path(), text)
    code_seen = text
    var dir = fs.join(fs.temp_dir(), "playerversus-check")
    fs.mkdir(dir)
    var probe = fs.join(dir, "probe.fw")
    var api_path = fs.join(GAME_DIR, "item_api.fw")
    var mine = code_path()
    fs.write(probe, "import \"{api_path}\" as api\nimport \"{mine}\" as custom\napi.Item[] list = custom.items()\n" +
        "var c = api.Ctx()\ncustom.tick(\"\", c)\ncustom.hit(\"\", c)\ncustom.hurt(\"\", c)\n")
    code_check_log = fs.join(dir, "check.log")
    if fs.exists(code_check_log) do
        fs.remove(code_check_log)
    end
    try
        code_check_pid = os.start(["flywheel", "-c", probe], code_check_log)
        note("CHECKING...", ap.Color(255, 206, 110))
    catch e
        code_check_pid = -1
        code_good = text
        code.dirty = false
        note("SAVED (THE flywheel COMMAND WAS NOT FOUND, SO IT WAS NOT CHECKED)", ap.Color(255, 206, 110))
    end
end

# The check has finished: keep the file, or put the last good one back and say what is wrong.
function finish_check()
    var status = os.wait(code_check_pid)
    code_check_pid = -1
    var log = fs.read(code_check_log) if fs.exists(code_check_log) else ""
    if status == 0 do
        code_good = editor.text_of(code)
        code.dirty = false
        code_marks = [0]
        var how = "IT IS LOADING NOW" if hot.enabled() else "RESTART THE GAME TO USE IT (OR RUN WITH --hot)"
        note("SAVED AND CHECKED. {how}", ap.Color(150, 225, 120))
        snd_gold_sack.play(0.5)
        return
    end
    # Broken: the game must still start next time, so the last good version goes back on disk and
    # this one is kept beside it.
    fs.write(code_path(), code_good)
    code_seen = code_good
    fs.write(fs.join(GAME_DIR, "custom_items.draft.fw"), editor.text_of(code))
    var first = ""
    for line in log.split("\n") do
        if first == "" and line.contains("error") do
            first = line
        end
    end
    code_marks = [0]
    var where = first.find("custom_items.fw:")
    if where >= 0 do
        var rest = first[where + 16..<first.length]
        var cut = rest.find(":")
        if cut > 0 do
            code_marks = [int(rest[0..<cut])]
        end
        first = "LINE {rest}"
    else if first.contains("error:") do
        first = first[first.find("error:")..<first.length]
    end
    if first == "" do
        first = "THE CHECK FAILED"
    end
    note("NOT SAVED: {first}", ap.Color(255, 120, 110))
    snd_deny.play(0.6)
end

function update_code_editor()
    if code_check_pid >= 0 and not os.alive(code_check_pid) do
        finish_check()
    end
    # Edited somewhere else (Solenoid): take it in, unless there are changes here to lose.
    if ticks % 45 == 0 and fs.exists(code_path()) do
        var disk = fs.read(code_path())
        if disk != code_seen and code_check_pid < 0 do
            code_seen = disk
            if not code.dirty do
                var row = code.row
                code = editor.open(disk)
                code.row = row
                code_good = disk
                note("RELOADED: custom_items.fw CHANGED ON DISK", ap.Color(120, 200, 255))
            else do
                note("custom_items.fw CHANGED ON DISK; SAVING HERE WILL OVERWRITE IT", ap.Color(255, 206, 110))
            end
        end
    end
    if editor.ctrl() and ap.key_pressed(ap.KEY_S) do
        save_code()
        return
    end
    if editor.ctrl() and ap.key_pressed(ap.KEY_O) do
        if code.dirty do
            save_code()
        end
        open_in_solenoid()
        return
    end
    var m = ap.mouse()
    if ap.mouse_pressed() do
        if code_button(0).contains(m) do
            save_code()
            return
        else if code_button(1).contains(m) do
            open_in_solenoid()
            return
        else if code_button(2).contains(m) do
            close_code_editor()
            return
        end
    end
    if ap.key_pressed(ap.KEY_ESCAPE) do
        close_code_editor()
        return
    end
    editor.update(code, typed_now, 12, 52, 616, 262)
end

function close_code_editor()
    if code.dirty do
        fs.write(fs.join(GAME_DIR, "custom_items.draft.fw"), editor.text_of(code))
        note("UNSAVED CHANGES WERE KEPT IN custom_items.draft.fw", ap.Color(255, 206, 110))
    end
    im_view = VIEW_LIST
    snd_book.play(0.4, 0.8)
end

function code_button(int i) returns ap.Rect
    return ap.Rect(300 + double(i) * 110, 10, 104, 16)
end

function draw_code_editor()
    label("ADVANCED EDITOR", 12, 8, 16, MAX_GOLD)
    label("custom_items.fw{" *" if code.dirty else ""}", 12, 28, 8, ap.Color(170, 165, 190))
    string[] words = ["CTRL+S  SAVE", "CTRL+O  SOLENOID", "ESC  CLOSE"]
    var m = ap.mouse()
    for i in 0..<3 do
        var r = code_button(i)
        var hover = r.contains(m)
        ap.rect(r.x, r.y, r.w, r.h, ap.Color(46, 40, 70) if hover else ap.Color(24, 20, 36))
        ap.rect_lines(r.x, r.y, r.w, r.h, 1, MAX_GOLD.fade(0.6) if hover else ap.Color(70, 64, 96))
        label_centered(words[i], r.x + r.w / 2, r.y + 4, 8, ap.WHITE if hover else ap.Color(200, 196, 220))
    end
    label_right("LINE {code.row + 1}  COL {code.col + 1}", 628, 40, 8, ap.Color(110, 106, 130))
    editor.draw(code, 12, 52, 616, 262, code_marks, code_check_pid < 0)
    label("Hooks: items(), tick(id, c), hit(id, c), hurt(id, c). Every field of c is listed in item_api.fw.", 12, 334,
        8, ap.Color(110, 106, 130))
    draw_menu_note()
end

# --- Drawing the 3D scene ------------------------------------------------------------------------

# What a fighter's body is trying to do this tick. What is drawn eases toward it (see step_fighter).
function target_pose(Fighter f) returns puppet.Pose
    var look = f.kit.look
    var time = double(ticks) / 60 + double(f.id) * 1.7
    if max_cut > 0 and not f.minion and (f.id == cut_user or cut_kind == CUT_MERGE) do
        # The maximum's own motion: a long wind-up, the moment it goes off, and a held finish.
        var t = double(cut_len - max_cut)
        var hit = double(math.max(cut_hit, 1))
        var at = t / hit if t < hit else 1 + math.min((t - hit) / 14, 1.0) + math.min(math.max(t - hit - 14, 0.0) / 80, 0.5)
        return puppet.make_pose(look, puppet.ACT_ATTACK, cut_anim if f.id == cut_user else cut_anim2, at, 1, f.cycle, 0, time, f.settle)
    end
    var action = puppet.ACT_IDLE
    var anim = 0
    var phase_at = 0.0
    var beat = 0
    if f.state == STATE_ATTACK do
        action = puppet.ACT_ATTACK
        anim = f.move.anim
        phase_at = attack_phase(f.move, f.move_hits, f.frame)
        beat = attack_beat(f.move, f.move_hits, f.frame)
        if f.move.anim == roster.ANIM_TWIRL do
            beat = 1 if f.empowered else 0
        end
        if f.move.anim == roster.ANIM_ROLL do
            var along = f.dash_way.x * math.sin(f.heading * math.PI / 180) + f.dash_way.z * math.cos(f.heading * math.PI / 180)
            beat = 1 if along < 0 else 0
        end
    else if f.state == STATE_BLOCK do
        action = puppet.ACT_BLOCK
    else if f.state == STATE_HURT and f.ragdolled do
        action = puppet.ACT_RAGDOLL
        beat = 1 if f.landed else 0
        phase_at = 1 - math.clamp(double(f.floor_ticks) / double(RISE_TICKS), 0.0, 1.0) if f.landed else double(f.ragdoll_age) / 60
    else if f.state == STATE_HURT do
        action = puppet.ACT_HURT if f.body.grounded or f.body.position.y < 0.2 else puppet.ACT_AIR
        beat = f.hurt_side
        phase_at = 1 - double(f.stun) / double(math.max(f.stun_total, 1))
    else if f.state == STATE_DOWN do
        action = puppet.ACT_DOWN
        phase_at = double(f.frame) / 26
    else if f.state == STATE_DASH do
        action = puppet.ACT_DASH
    else if f.state == STATE_RELOAD do
        action = puppet.ACT_RELOAD
    else if (phase == PHASE_OVER or screen == SCREEN_RESULT) and other(f).state == STATE_DOWN do
        action = puppet.ACT_WIN
        phase_at = math.min(double(phase_ticks if screen == SCREEN_FIGHT else 200) / 30, 1.0)
    end
    return puppet.make_pose(look, action, anim, phase_at, beat, f.cycle, f.moving, time, f.settle)
end

# One tick of `f`'s body toward the pose of what it is doing.
function spring_pose(Fighter f, double freq, double damping)
    var moved = puppet.follow(f.pose, f.pose_speed, target_pose(f), freq, damping)
    f.pose = moved[0]
    f.pose_speed = moved[1]
end

function fighter_pose(Fighter f) returns puppet.Pose
    return f.pose
end

# How solid a fighter looks: the player can always just make out their own shroud.
function fighter_alpha(Fighter f) returns double
    var solid = 0.4 if f.buff == roster.BUFF_MIST else 1.0
    if f.cpu do
        return wave_alpha(f, f.fade * solid)
    end
    return wave_alpha(f, (0.22 + 0.78 * f.fade) * solid)
end

function draw_arena()
    var casting = ap.casting_shadows()
    var gone = max_owner >= 0
    var riding = on_train()
    if not casting and not riding do
        ap.draw_material(floor_mesh, floor_look, ap.Vec3(0, 0, 0))
        ap.draw_material(disc_side, stone, ap.Vec3(0, -0.72, 0))
        if not gone do
            if crumble <= 0 or int(draw_clock() * 0.5) % 3 != 0 do
                ap.draw_many(box, rim_lamps, rim_look)
            end
            # The far slabs topple into the dark as the place comes apart.
            ap.push_3d()
            ap.translate_3d(ap.Vec3(0, -crumble * crumble * 30, 0))
            ap.draw_many(box, monoliths, monolith_look)
            ap.pop_3d()
        end
    end
    if not gone do
        for i, p in pillars do
            # Crumbling: they lean and sink into the floor.
            var lean = crumble * (24.0 if i % 2 == 0 else -18.0)
            var sink = crumble * crumble * (p.height + 1.5)
            var base = p.base - ap.Vec3(0, sink, 0)
            ap.draw_material(box, pillar_stone, base + ap.Vec3(0, p.height / 2, 0), ap.Vec3(lean, 0, lean * 0.5),
                ap.Vec3(1.1, p.height, 1.1))
            ap.draw_material(box, stone, base + ap.Vec3(0, 0.15, 0), ap.Vec3(0, 0, 0), ap.Vec3(1.4, 0.3, 1.4))
            if p.height > 4 do
                ap.draw_material(box, stone, base + ap.Vec3(0, p.height - 0.1, 0), ap.Vec3(lean, 0, lean * 0.5),
                    ap.Vec3(1.4, 0.3, 1.4))
            else do
                # Broken off.
                ap.draw_material(box, pillar_stone, base + ap.Vec3(0.12, p.height + 0.1, -0.1), ap.Vec3(14, 20, 8),
                    ap.Vec3(0.8, 0.4, 0.7))
            end
        end
    else if not casting do
        if merge_owner >= 0 do
            half_side = 1
            draw_scenery(max_def)
            half_side = -1
            draw_scenery(merge_def)
            half_side = 0
        else do
            draw_scenery(max_def)
        end
    end
    if not casting and not riding do
        # (On the train the dust stays inside the carriage: see draw_carriage.)
        ap.lighting(false)
        for i, s in souls do
            var glimmer = 0.25 + 0.2 * math.sin(draw_clock() * 0.03 + double(i))
            ap.draw(box, s + ap.Vec3(math.sin(draw_clock() * 0.01 + double(i)) * 0.3, 0, 0),
                mote_now.fade(glimmer), ap.Vec3(0, 0, 0), ap.Vec3(0.09, 0.09, 0.09))
        end
        ap.lighting(true)
    end
end

function draw_effects()
    if ap.casting_shadows() do
        return
    end
    ap.lighting(false)
    for w in wild_portals do
        var grown = math.min((draw_clock() - double(w.born)) / 20, 1.0) * math.min((double(w.born + WILD_LIFE) - draw_clock()) / 30, 1.0)
        var at = w.position + ap.Vec3(0, 1.0, 0)
        var spin = draw_clock() * 3.1
        ap.draw(hoop, at, wild_glow, ap.Vec3(90, spin, 0), ap.Vec3(grown, grown, grown * 1.25))
        ap.draw(ball, at, wild_glow.fade(0.25), ap.Vec3(0, spin, 0), ap.Vec3(1.3 * grown, 1.7 * grown, 0.08))
    end
    for s in shots do
        var sp = between(s.prev, s.position, s.seen)
        var kind = s.attack.shot
        var tint = fighters[s.owner].kit.look.accent
        var yaw = heading_of(s.velocity)
        if kind == roster.SHOT_BULLET do
            ap.draw(box, sp, ap.Color(255, 230, 150), ap.Vec3(0, yaw, 0), ap.Vec3(0.07, 0.07, 0.5))
        else if kind == roster.SHOT_ROCKET do
            ap.draw(box, sp, ap.Color(190, 195, 190), ap.Vec3(0, yaw, 0), ap.Vec3(0.2, 0.2, 0.6))
            ap.draw(box, sp - unit(s.velocity) * 0.36, ap.Color(255, 160, 60), ap.Vec3(0, yaw, 0),
                ap.Vec3(0.14, 0.14, 0.2))
        else if kind == roster.SHOT_BATS do
            for i in 0..<3 do
                var at = sp + forward_of(double(i) * 120 + s.age * 400) * 0.25 + ap.Vec3(0, math.sin(s.age * 14 + double(i)) * 0.15, 0)
                var flap = 0.1 + 0.16 * math.abs(math.sin(s.age * 30 + double(i)))
                ap.draw(box, at, ap.Color(36, 16, 30), ap.Vec3(0, yaw, 0), ap.Vec3(0.12 + flap * 2, 0.08, 0.12))
                ap.draw(box, at + ap.Vec3(0, 0.03, 0), tint, ap.Vec3(0, yaw, 0), ap.Vec3(0.08, 0.03, 0.14))
            end
        else if kind == roster.SHOT_WAVE do
            ap.draw(box, sp, ap.WHITE, ap.Vec3(0, yaw, 18), ap.Vec3(1.3, 0.05, 0.1))
            ap.draw(box, sp - unit(s.velocity) * 0.12, tint, ap.Vec3(0, yaw, 18), ap.Vec3(1.6, 0.1, 0.22))
            ap.draw(box, sp - unit(s.velocity) * 0.3, tint.fade(0.4), ap.Vec3(0, yaw, 18), ap.Vec3(1.3, 0.08, 0.3))
        else if kind == roster.SHOT_BOMB do
            ap.draw(box, sp, ap.Color(190, 50, 40), ap.Vec3(s.age * 700, yaw, 0), ap.Vec3(0.1, 0.1, 0.36))
            ap.draw(box, sp + ap.Vec3(0, 0.14, 0), ap.Color(255, 230, 140), ap.Vec3(0, 0, 0), ap.Vec3(0.06, 0.06, 0.06))
        else if kind == roster.SHOT_MINE do
            ap.draw(box, sp, ap.Color(70, 76, 70), ap.Vec3(0, 0, 0), ap.Vec3(0.42, 0.12, 0.42))
            if s.age > 0.8 and int(s.age * 2.5) % 2 == 0 do
                ap.draw(box, sp + ap.Vec3(0, 0.08, 0), tint, ap.Vec3(0, 0, 0), ap.Vec3(0.1, 0.06, 0.1))
            end
        else if kind == roster.SHOT_METEOR do
            var big = s.attack.blast * 0.3
            ap.draw(ball, sp, ap.Color(90, 60, 60), ap.Vec3(s.age * 200, s.age * 140, 0), ap.Vec3(big, big, big))
            ap.draw(ball, sp, ap.Color(255, 170, 70).fade(0.5), ap.Vec3(0, 0, 0), ap.Vec3(big * 1.4, big * 1.4, big * 1.4))
        else if kind == roster.SHOT_CAR do
            # A yellow cab, in something of a hurry.
            ap.draw(box, sp, ap.Color(250, 210, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.3, 0.6, 2.6))
            ap.draw(box, sp + ap.Vec3(0, 0.5, 0), ap.Color(250, 210, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.2, 0.5, 1.3))
            ap.draw(box, sp + ap.Vec3(0, 0.5, 0), ap.Color(30, 34, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.24, 0.34, 1.1))
            ap.draw(box, sp + ap.Vec3(0, 0.82, 0), ap.WHITE, ap.Vec3(0, yaw, 0), ap.Vec3(0.4, 0.14, 0.2))
            ap.draw(box, sp + ap.Vec3(0, -0.3, 0), ap.Color(24, 22, 28), ap.Vec3(0, yaw, 0), ap.Vec3(1.4, 0.4, 1.9))
            ap.draw(box, sp + unit(s.velocity) * 1.3, ap.Color(255, 250, 200), ap.Vec3(0, yaw, 0), ap.Vec3(1.0, 0.14, 0.06))
        else if kind == roster.SHOT_KNIFE do
            ap.draw(box, sp, ap.Color(225, 228, 236), ap.Vec3(s.age * 1400, yaw, 0), ap.Vec3(0.05, 0.1, 0.42))
        else if kind == roster.SHOT_FIST do
            ap.draw(box, sp, fighters[s.owner].kit.look.metal, ap.Vec3(0, yaw, 0), ap.Vec3(0.26, 0.26, 0.34))
            ap.draw(box, sp - unit(s.velocity) * 0.26, ap.Color(255, 170, 70), ap.Vec3(0, yaw, 0), ap.Vec3(0.16, 0.16, 0.2))
        else if kind == roster.SHOT_RING do
            ap.draw(ball, sp, tint.fade(0.35), ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        else if kind == roster.SHOT_ROCK do
            ap.lighting(true)
            var big = 0.55 + s.attack.blast * 0.15
            ap.draw(box, sp, ap.Color(116, 96, 78), ap.Vec3(s.age * 300, s.age * 200, s.age * 120), ap.Vec3(big, big * 0.8, big))
            ap.draw(box, sp + ap.Vec3(0, big * 0.35, 0), ap.Color(90, 120, 60), ap.Vec3(s.age * 300, s.age * 200, s.age * 120), ap.Vec3(big * 0.9, 0.08, big * 0.9))
            ap.lighting(false)
        else if kind == roster.SHOT_SPIKE do
            ap.lighting(true)
            for i in 0..<3 do
                var at = ap.Vec3(sp.x, 0, sp.z) - unit(flat(s.velocity)) * (double(i) * 0.5)
                var tall = 0.9 - double(i) * 0.25
                ap.draw(box, at + ap.Vec3(0, tall / 2, 0), ap.Color(120, 100, 80), ap.Vec3(10, yaw + double(i) * 30, 8), ap.Vec3(0.5, tall, 0.5))
            end
            ap.lighting(false)
        else if kind == roster.SHOT_COIN do
            ap.draw(disc, sp, ap.Color(255, 206, 70), ap.Vec3(90, yaw, s.age * 900), ap.Vec3(0.12, 0.03, 0.12))
        else if kind == roster.SHOT_FEATHER do
            ap.draw(box, sp, ap.Color(30, 28, 38), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 0.02, 0.4))
            ap.draw(box, sp, tint, ap.Vec3(0, yaw, 0), ap.Vec3(0.02, 0.03, 0.42))
        else if kind == roster.SHOT_VENOM do
            ap.draw(ball, sp, tint, ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        else if kind >= roster.SHOT_VIAL do
            draw_wave_shot(s, sp, tint, yaw)
        else do
            ap.draw(ball, sp, ap.WHITE, ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.2, 0.2))
            ap.draw(ball, sp, tint.fade(0.5), ap.Vec3(0, 0, 0), ap.Vec3(0.42, 0.42, 0.42))
        end
    end
    for b in beams do
        var left = b.life / b.span
        var v = b.to - b.from
        var mid = b.from + v * 0.5
        ap.push_3d()
        ap.translate_3d(mid)
        ap.rotate_3d(heading_of(v), ap.Vec3(0, 1, 0))
        ap.rotate_3d(-math.atan2(v.y, flat(v).length()) * 180 / math.PI, ap.Vec3(1, 0, 0))
        ap.draw(box, ap.Vec3(0, 0, 0), b.color.fade(0.5 * left), ap.Vec3(0, 0, 0), ap.Vec3(b.width * 2.4, b.width * 2.4, v.length()))
        ap.draw(box, ap.Vec3(0, 0, 0), ap.WHITE.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(b.width * left, b.width * left, v.length()))
        ap.pop_3d()
    end
    for p in portals do
        # The owner's newer door is their own color, the older one its warm twin.
        var newest = true
        var paired = false
        for q in portals do
            if q.owner == p.owner and q.born > p.born do
                newest = false
            end
            if q.owner == p.owner and q.born != p.born do
                paired = true
            end
        end
        var tint = fighters[p.owner].kit.look.accent if newest else ap.Color(255, 150, 60)
        var grown = math.min((draw_clock() - double(p.born)) / 14, 1.0)
        var at = p.position + ap.Vec3(0, 1.0, 0)
        var spin = draw_clock() * 2.5
        ap.draw(hoop, at, tint.fade(1.0 if paired else 0.45), ap.Vec3(90, spin, 0), ap.Vec3(grown, grown, grown * 1.25))
        ap.draw(ball, at, tint.fade(0.3 if paired else 0.12), ap.Vec3(0, spin, 0), ap.Vec3(1.3 * grown, 1.7 * grown, 0.08))
        if ap.chance(0.3) do
            var around = forward_of(ap.random(0, 360)) * 0.8
            spark(at + ap.Vec3(around.x, around.z, 0), ap.Vec3(-around.x, -around.z, 0) * 1.5, tint, 0.4, 0.05, 0)
        end
    end
    draw_trails()
    for m in marks do
        var left = math.min(m.life / m.span * 3, 1.0)
        ap.draw(disc, m.position, m.color.fade(m.strength * left), ap.Vec3(0, 0, 0), ap.Vec3(m.radius, 0.02, m.radius))
    end
    for s in sparks do
        var left = math.min(s.life / s.span * 1.6, 1.0)
        var sp = between(s.prev, s.position, s.seen)
        var size = s.size if not s.seen else between_value(s.prev_size, s.size)
        if s.stretch > 0 do
            var v = s.velocity
            ap.push_3d()
            ap.translate_3d(sp)
            ap.rotate_3d(heading_of(v), ap.Vec3(0, 1, 0))
            ap.rotate_3d(-math.atan2(v.y, flat(v).length()) * 180 / math.PI, ap.Vec3(1, 0, 0))
            ap.draw(box, ap.Vec3(0, 0, 0), s.color.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(size, size, s.stretch))
            ap.pop_3d()
        else do
            if s.grow > 0 do
                # Smoke: soft and round, thinning as it spreads.
                ap.draw(ball, sp, s.color.fade(left * 0.55), ap.Vec3(0, 0, 0), ap.Vec3(size, size, size))
            else do
                ap.draw(box, sp, s.color.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(size, size, size))
            end
        end
    end
    for r in rings do
        var left = r.life / r.span
        var radius = between_value(r.prev_radius, r.radius)
        if r.ball do
            ap.draw(ball, r.position, r.color.fade(left * 0.45), ap.Vec3(0, 0, 0),
                ap.Vec3(radius * 2, radius * 2, radius * 2))
        else do
            for i in 0..<28 do
                var around = double(i) * 360 / 28
                ap.draw(box, r.position + forward_of(around) * radius, r.color.fade(left), ap.Vec3(0, around, 0),
                    ap.Vec3(radius * 0.2, 0.06, 0.08))
            end
        end
    end
    ap.lighting(true)
end

# BOB's machines and CARBON's walls, and daggers lying where they fell.
function draw_props()
    for pr in props do
        var grown = math.min((draw_clock() - double(pr.born)) / 10, 1.0) if pr.born > 0 else 1.0
        if pr.life > 0 and pr.life < 20 do
            grown = double(pr.life) / 20
        end
        if pr.kind == PROP_TREE do
            draw_tree(pr, grown)
        else if pr.kind == PROP_WALL do
            var h = pr.height * grown
            var rock = ap.Color(116, 96, 78)
            ap.draw(box, pr.position + ap.Vec3(0, h / 2, 0), rock, ap.Vec3(3, pr.yaw, -2), ap.Vec3(1.2, h, 1.2))
            ap.draw(box, pr.position + ap.Vec3(0.15, h - 0.1, -0.1), rock.brightness(0.85), ap.Vec3(14, pr.yaw + 30, 10), ap.Vec3(0.9, 0.5, 0.8))
            ap.draw(box, pr.position + ap.Vec3(0, 0.2, 0), rock.brightness(0.7), ap.Vec3(0, pr.yaw + 15, 0), ap.Vec3(1.7, 0.4, 1.7))
        else do
            var metal = ap.Color(110, 116, 124)
            var at = pr.position
            var yaw = pr.yaw
            ap.draw(box, at + ap.Vec3(0, 0.15, 0), ap.Color(70, 74, 80), ap.Vec3(0, yaw, 0), ap.Vec3(1.4, 0.3, 1.1))
            ap.draw(box, at + ap.Vec3(0, 0.95, 0) - forward_of(yaw) * 0.2, metal, ap.Vec3(0, yaw, 0), ap.Vec3(1.2, 1.3, 0.6))
            ap.draw(disc, at + ap.Vec3(0, 1.75, 0) - forward_of(yaw) * 0.2, metal.brightness(0.8), ap.Vec3(0, 0, 0), ap.Vec3(0.5, 0.25, 0.5))
            ap.draw(box, at + ap.Vec3(0.5, 1.2, 0) + forward_of(yaw) * 0.2, ap.Color(60, 60, 64), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 1.4, 0.12))
            if not ap.casting_shadows() do
                ap.lighting(false)
                var bubble = 0.3 + 0.15 * math.sin(draw_clock() * 0.12 + double(pr.owner))
                ap.draw(disc, at + ap.Vec3(0, 0.95, 0) + forward_of(yaw) * 0.18, ap.Color(110, 255, 130).fade(0.45 + bubble),
                    ap.Vec3(0, 0, 0), ap.Vec3(0.36, 1.0, 0.36))
                ap.draw(box, at + ap.Vec3(0, 1.45, 0) + forward_of(yaw) * 0.12, ap.Color(120, 255, 120), ap.Vec3(0, yaw, 0), ap.Vec3(0.6, 0.08, 0.04))
                ap.lighting(true)
            end
        end
    end
    for p in pickups do
        ap.draw(box, p.position + ap.Vec3(0, 0.16, 0), fighters[p.owner].kit.look.metal, ap.Vec3(32, p.yaw, 0), ap.Vec3(0.04, 0.34, 0.07))
        ap.draw(box, p.position + ap.Vec3(0, 0.33, 0) - forward_of(p.yaw) * 0.1, fighters[p.owner].kit.look.trim, ap.Vec3(32, p.yaw, 0), ap.Vec3(0.06, 0.1, 0.06))
        if not ap.casting_shadows() and (ticks + int(p.yaw)) % 70 < 5 do
            ap.lighting(false)
            ap.draw(box, p.position + ap.Vec3(0, 0.3, 0), ap.WHITE, ap.Vec3(45, 45, 0), ap.Vec3(0.12, 0.12, 0.12))
            ap.lighting(true)
        end
    end
end

# The green glow that marks a clone; in a 2v2, a ring under everyone in their side's color.
function draw_auras()
    ap.lighting(false)
    if duo do
        for g in everyone() do
            if g.state == STATE_DOWN do
                continue
            end
            var tint = side_color(g.id)
            var turn = draw_clock() * (1.5 if g.id == 0 else -1.5)
            for i in 0..<20 do
                var around = double(i) * 18 + turn
                ap.draw(box, drawn_at(g) + forward_of(around) * 0.62 + ap.Vec3(0, 0.04, 0), tint.fade(0.55 if i % 2 == 0 else 0.25),
                    ap.Vec3(0, around, 0), ap.Vec3(0.16, 0.03, 0.05))
            end
        end
    end
    var green = ap.Color(110, 255, 120)
    for m in minions do
        if m.partner do
            continue
        end
        var pulse = 0.12 + 0.05 * math.sin(draw_clock() * 0.15)
        var look = m.kit.look
        ap.draw(ball, drawn_at(m) + ap.Vec3(0, m.body.height / 2, 0), green.fade(pulse * fighter_alpha(m)), ap.Vec3(0, 0, 0),
            ap.Vec3(1.3 * look.bulk, 2.2 * look.tall, 1.3 * look.bulk))
        for i in 0..<16 do
            var around = double(i) * 22.5 + draw_clock() * 2
            ap.draw(box, drawn_at(m) + forward_of(around) * 0.6 + ap.Vec3(0, 0.04, 0), green.fade(0.7), ap.Vec3(0, around, 0),
                ap.Vec3(0.14, 0.03, 0.05))
        end
    end
    ap.lighting(true)
end

function draw_fight_scene()
    draw_arena()
    for f in fighters do
        puppet.draw(rig, f.kit.look, drawn_pose(f), drawn_at(f), drawn_heading(f), fighter_alpha(f))
    end
    for mi in mirrors do
        # A copy does whatever its owner does, as solid as they are.
        var owner = mirror_owner(mi)
        var grown = math.min((draw_clock() - double(mi.born)) / 10, 1.0) * math.min(double(mi.life) / 30, 1.0)
        puppet.draw(rig, owner.kit.look, drawn_pose(owner), between(mi.prev, mirror_at(mi), mi.seen), drawn_heading(owner) + mi.angle,
            fighter_alpha(owner) * grown)
    end
    for m in minions do
        puppet.draw(rig, m.kit.look, drawn_pose(m), drawn_at(m), drawn_heading(m), fighter_alpha(m))
    end
    draw_props()
    wave_draw()
    wave_set_pieces()
    if not ap.casting_shadows() do
        draw_auras()
        for g in ghosts do
            puppet.draw(rig, g.look, g.pose, g.position, g.heading, 0.45 * g.life / g.span)
        end
    end
    draw_effects()
    if merge_owner >= 0 and not ap.casting_shadows() do
        # See-through, so it goes on after everything it could hide.
        draw_seam()
    end
    if ap.debugging() and not ap.casting_shadows() do
        world.draw_debug(ap.Color(60, 200, 120))
        for f in fighters do
            var reach = f.move.reach if f.state == STATE_ATTACK else f.kit.basics[0].reach
            var here = f.body.position + ap.Vec3(0, 1, 0)
            ap.debug_line_3d(here, here + forward_of(f.heading) * reach, ap.YELLOW)
            ap.box_lines(f.body.position - ap.Vec3(f.body.radius, 0, f.body.radius),
                f.body.position + ap.Vec3(f.body.radius, f.body.height, f.body.radius),
                ap.RED if f.state == STATE_ATTACK else ap.CYAN)
        end
    end
end

# The fighter shown on the select screen, standing in their own stance.
function preview_kit() returns roster.Character
    if cursor < cast.length do
        return cast[cursor]
    end
    return cast[(ticks // 9) % cast.length]
end

# Which fighter's super place the select screen stands in (-1: the Purgatory).
var select_world = -1
function show_select_world()
    var want = cursor if cursor < cast.length else -1
    if want == select_world do
        return
    end
    select_world = want
    if want >= 0 do
        apply_max_look(cast[want].maximum)
    else do
        apply_area()
    end
end

function draw_select_scene()
    if select_world >= 0 do
        if not ap.casting_shadows() do
            ap.draw_material(floor_mesh, floor_look, ap.Vec3(0, 0, 0))
            ap.draw_material(disc_side, stone, ap.Vec3(0, -0.72, 0))
            draw_scenery(cast[select_world].maximum)
        end
    else do
        draw_arena()
    end
    var kit = preview_kit()
    var time = double(ticks) / 60
    var pose = puppet.make_pose(kit.look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, time)
    puppet.draw(rig, kit.look, pose, ap.Vec3(0, 0, 0), 18 + 22 * math.sin(time * 0.5), 1)
end

function draw_title_scene()
    draw_arena()
end

function set_lights()
    if screen == SCREEN_PURGATORY do
        purgatory.set_lights()
        return
    end
    for i in 0..<8 do
        ap.light_off(i)
    end
    ap.light(6, ap.Vec3(0, 5, 0), lamp_now, 16)
    if screen == SCREEN_SELECT do
        var tint = preview_kit().look.accent
        ap.light(0, ap.Vec3(1.2, 2.2, 2.4), tint.lerp(ap.WHITE, 0.5), 8)
        ap.light(1, ap.Vec3(-2.4, 1.6, -1.5), ap.Color(200, 190, 255), 6)
        return
    end
    if screen == SCREEN_TITLE do
        return
    end
    for f in fighters do
        if fighter_alpha(f) > 0.3 and mirror_count(f.id) == 0 do
            ap.light(f.id, f.body.position + ap.Vec3(0, 2.6, 0) - forward_of(f.heading) * 0.4,
                f.kit.look.accent.lerp(ap.WHITE, 0.5).brightness(0.5), 6)
        end
    end
    var slot = 2
    for s in shots do
        if slot < 6 and s.attack.shot != roster.SHOT_BULLET and s.attack.shot != roster.SHOT_MINE do
            ap.light(slot, s.position, fighters[s.owner].kit.look.accent, 5)
            slot += 1
        end
    end
    for r in rings do
        if slot < 6 and r.ball do
            ap.light(slot, r.position, r.color, 4 + r.radius * 2)
            slot += 1
        end
    end
end

# --- The HUD -------------------------------------------------------------------------------------

function label(string words, double x, double y, double size, ap.Color color)
    ap.text(words, x + size / 8, y + size / 8, size, ap.BLACK.fade(double(color.a) / 255 * 0.8))
    ap.text(words, x, y, size, color)
end
function label_centered(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x / 2, y, size, color)
end
function label_right(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x, y, size, color)
end

# A bar that fills from the left, or from the right when `mirrored`.
function meter(double x, double y, double w, double h, double share, ap.Color color, bool mirrored)
    var filled = w * math.clamp(share, 0.0, 1.0)
    ap.rect(x + w - filled if mirrored else x, y, filled, h, color)
end

function draw_bar_icon(int icon, double x, double y, ap.Color tint, double charge)
    var cx = x + 6
    var cy = y + 6
    ap.circle(cx, cy, 6, ap.BLACK.fade(0.75))
    ap.circle_lines(cx, cy, 5.5, 1, tint.fade(0.75))
    if icon == roster.ICON_DROP do
        ap.circle(cx, y + 4, 2, tint)
        ap.line(cx - 2, y + 5, cx, y + 10, 1.5, tint)
        ap.line(cx + 2, y + 5, cx, y + 10, 1.5, tint)
    else if icon == roster.ICON_BOLT do
        ap.line(x + 7, y + 1, x + 4, y + 6, 2, tint)
        ap.line(x + 4, y + 6, x + 7, y + 6, 2, tint)
        ap.line(x + 7, y + 6, x + 5, y + 11, 2, tint)
    else if icon == roster.ICON_FANG do
        ap.line(x + 3, y + 3, x + 5, y + 10, 2, tint)
        ap.line(x + 9, y + 3, x + 7, y + 10, 2, tint)
        ap.line(x + 2, y + 3, x + 10, y + 3, 1, tint)
    else if icon == roster.ICON_EYE do
        ap.ellipse(cx, cy, 4.5, 3, tint)
        ap.circle(cx, cy, 1.5, ap.BLACK)
        ap.circle(cx, cy, 0.7, ap.WHITE)
    else if icon == roster.ICON_WHEEL do
        ap.circle_lines(cx, cy, 4.5, 1.5, tint)
        ap.circle(cx, cy, 1.2, tint)
        ap.circle(cx, y + 2.5, 0.7, tint)
        ap.circle(x + 9, y + 4.5, 0.7, tint)
        ap.circle(x + 9, y + 7.5, 0.7, tint)
        ap.circle(cx, y + 9.5, 0.7, tint)
        ap.circle(x + 3, y + 7.5, 0.7, tint)
        ap.circle(x + 3, y + 4.5, 0.7, tint)
    else if icon == roster.ICON_SWIRL do
        ap.arc(cx, cy, 4, 25, 300, 1.5, tint)
        ap.circle(x + 8, y + 3, 1, tint)
    else if icon == roster.ICON_ROCKETS do
        for i in 0..<3 do
            var rx = x + 2 + double(i) * 3
            ap.rect(rx, y + 4, 2, 5, tint)
            ap.line(rx, y + 4, rx + 1, y + 2, 1, tint)
            ap.line(rx + 2, y + 9, rx + 1, y + 11, 1, tint)
        end
    else if icon == roster.ICON_HOOD do
        ap.arc(cx, y + 7, 4, 195, 345, 1.5, tint)
        ap.line(x + 3, y + 5, x + 6, y + 1, 1.5, tint)
        ap.line(x + 9, y + 5, x + 6, y + 1, 1.5, tint)
        ap.circle(cx, y + 6, 1.5, tint)
    else if icon == roster.ICON_STAR do
        ap.line(cx, y + 1, cx, y + 11, 1.5, tint)
        ap.line(x + 1, cy, x + 11, cy, 1.5, tint)
        ap.line(x + 2, y + 2, x + 10, y + 10, 1.5, tint)
        ap.line(x + 10, y + 2, x + 2, y + 10, 1.5, tint)
        ap.circle(cx, cy, 1.5, ap.WHITE)
    else if icon == roster.ICON_SIGNAL do
        ap.rect(x + 2, y + 8, 2, 3, tint.fade(0.45))
        ap.rect(x + 5, y + 6, 2, 5, tint.fade(0.65))
        ap.rect(x + 8, y + 3, 2, 8, tint)
    else if icon == roster.ICON_SHELLS do
        for i in 0..<3 do
            var sx = x + 2 + double(i) * 3
            ap.rect(sx, y + 4, 2, 6, tint)
            ap.rect(sx, y + 3, 2, 1, ap.WHITE)
        end
    else if icon == roster.ICON_KNIFE do
        ap.line(x + 2, y + 9, x + 9, y + 2, 2, tint)
        ap.line(x + 2, y + 8, x + 5, y + 11, 1.5, tint)
        ap.line(x + 7, y + 4, x + 10, y + 7, 1, ap.WHITE)
    else if icon == roster.ICON_ATOM do
        ap.circle_lines(cx, cy, 4.5, 1, tint)
        ap.line(x + 3, y + 3, x + 9, y + 9, 1, tint)
        ap.line(x + 9, y + 3, x + 3, y + 9, 1, tint)
        ap.circle(cx, cy, 1, ap.WHITE)
    else if icon == roster.ICON_PAW do
        ap.ellipse(cx, y + 8, 3, 2, tint)
        ap.circle(x + 3, y + 4, 1.3, tint)
        ap.circle(x + 5, y + 2.5, 1.3, tint)
        ap.circle(x + 8, y + 2.5, 1.3, tint)
        ap.circle(x + 10, y + 4, 1.3, tint)
    else if icon == roster.ICON_BATTERY do
        ap.rect_lines(x + 2, y + 3, 8, 7, 1, tint)
        ap.rect(x + 4, y + 2, 4, 1, tint)
        ap.rect(x + 3, y + 4, 6 * math.clamp(charge, 0.0, 1.0), 5, tint)
    else if icon == roster.ICON_WING do
        ap.triangle(ap.Vec2(x + 6, y + 8), ap.Vec2(x + 1, y + 2), ap.Vec2(x + 2, y + 10), tint)
        ap.triangle(ap.Vec2(x + 6, y + 8), ap.Vec2(x + 11, y + 2), ap.Vec2(x + 10, y + 10), tint)
    else if icon == roster.ICON_ROCK do
        ap.triangle(ap.Vec2(x + 2, y + 10), ap.Vec2(x + 5, y + 3), ap.Vec2(x + 10, y + 10), tint)
        ap.rect(x + 6, y + 6, 3, 4, tint.brightness(0.7))
    else if icon == roster.ICON_COIN do
        var coins = int(math.clamp(charge, 0.0, 1.0) * 4 + 0.99)
        for i in 0..<coins do
            ap.rect(x + 3, y + 9 - double(i) * 2, 6, 1.5, tint)
        end
    else if icon == roster.ICON_MIRROR do
        ap.rect_lines(x + 3, y + 2, 6, 8, 1, tint)
        ap.line(x + 4, y + 7, x + 7, y + 3, 1, ap.WHITE)
    else if icon == roster.ICON_FLASK do
        ap.rect(x + 5, y + 1, 2, 4, tint)
        ap.triangle(ap.Vec2(x + 3, y + 10), ap.Vec2(x + 6, y + 4), ap.Vec2(x + 9, y + 10), tint)
    else if icon == roster.ICON_TV do
        ap.rect_lines(x + 2, y + 4, 8, 6, 1, tint)
        ap.line(x + 6, y + 4, x + 4, y + 1, 1, tint)
        ap.line(x + 6, y + 4, x + 8, y + 1, 1, tint)
    else if icon == roster.ICON_BLADES do
        ap.line(x + 3, y + 10, x + 9, y + 2, 1.5, tint)
        ap.line(x + 3, y + 2, x + 9, y + 10, 1.5, tint)
    else if icon == roster.ICON_SKULL do
        ap.circle(cx, y + 5, 3.5, tint)
        ap.rect(x + 4, y + 7, 4, 3, tint)
        ap.rect(x + 4, y + 4, 1.5, 1.5, ap.BLACK)
        ap.rect(x + 6.5, y + 4, 1.5, 1.5, ap.BLACK)
    else if icon == roster.ICON_LEAF do
        ap.triangle(ap.Vec2(cx, y + 1), ap.Vec2(x + 2, y + 9), ap.Vec2(x + 10, y + 9), tint)
        ap.line(cx, y + 9, cx, y + 11, 1.5, tint)
    else if icon == roster.ICON_SUN do
        ap.circle(cx, cy, 2.5, tint)
        ap.circle_lines(cx, cy, 3.5, 1, tint)
        ap.line(cx, y + 0.5, cx, y + 1.5, 1, tint)
        ap.line(cx, y + 10.5, cx, y + 11.5, 1, tint)
        ap.line(x + 0.5, cy, x + 1.5, cy, 1, tint)
        ap.line(x + 10.5, cy, x + 11.5, cy, 1, tint)
    else if icon == roster.ICON_CARD do
        ap.rect(x + 3, y + 2, 6, 8, tint)
        ap.rect(x + 4, y + 3, 4, 6, ap.BLACK.fade(0.7))
        ap.circle(cx, cy, 1.2, tint)
    else if icon == roster.ICON_CHAIN do
        ap.circle_lines(x + 4, y + 4, 2, 1, tint)
        ap.circle_lines(cx, cy, 2, 1, tint)
        ap.circle_lines(x + 8, y + 8, 2, 1, tint)
    else if icon == roster.ICON_GEAR do
        ap.circle(cx, cy, 3, tint)
        for k in 0..<6 do
            var a = double(k) * math.PI / 3 + charge * 3
            ap.line(cx + math.cos(a) * 3, cy + math.sin(a) * 3, cx + math.cos(a) * 4.8, cy + math.sin(a) * 4.8, 1.5, tint)
        end
        ap.circle(cx, cy, 1, ap.BLACK)
    else if icon == roster.ICON_GRAVE do
        ap.rect(x + 3.5, y + 4, 5, 6, tint)
        ap.circle(cx, y + 4, 2.5, tint)
        ap.line(cx, y + 5, cx, y + 8, 1, ap.BLACK)
        ap.line(cx - 1.2, y + 6, cx + 1.2, y + 6, 1, ap.BLACK)
    else if icon == roster.ICON_KEY do
        ap.circle_lines(x + 4, cy, 2, 1, tint)
        ap.line(x + 6, cy, x + 10, cy, 1.5, tint)
        ap.line(x + 9, cy, x + 9, cy + 2, 1, tint)
    else if icon == roster.ICON_NOTE do
        ap.circle(x + 4.5, y + 8.5, 2, tint)
        ap.line(x + 6.3, y + 8.5, x + 6.3, y + 2, 1.2, tint)
        ap.line(x + 6.3, y + 2, x + 9, y + 3.5, 1.2, tint)
    else if icon == roster.ICON_TICKET do
        ap.rect(x + 2, y + 4, 8, 4.5, tint)
        ap.circle(x + 5, cy + 0.2, 1, ap.BLACK)
        ap.circle(x + 7.5, cy + 0.2, 1, ap.BLACK)
    else if icon == roster.ICON_DUMBBELL do
        ap.line(x + 3, cy, x + 9, cy, 1.5, tint)
        ap.rect(x + 1.5, y + 3.5, 2.5, 5, tint)
        ap.rect(x + 8, y + 3.5, 2.5, 5, tint)
    else if icon == roster.ICON_SHIELD do
        ap.triangle(ap.Vec2(x + 2.5, y + 3), ap.Vec2(x + 9.5, y + 3), ap.Vec2(cx, y + 11), tint)
        ap.rect(x + 2.5, y + 2, 7, 2, tint)
        if charge < 0.67 do
            ap.line(cx, y + 3, cx - 1, y + 7, 1, ap.BLACK)
        end
    end
end

function draw_fighter_hud(Fighter f)
    var kit = f.kit
    var look = kit.look
    var mirrored = f.id == 1
    var x = 364.0 if mirrored else 16.0
    var w = 260.0
    # Health, with the part just lost fading behind it.
    ap.rect(x - 2, 12, w + 4, 16, ap.BLACK.fade(0.75))
    ap.rect(x, 14, w, 12, ap.Color(44, 22, 34))
    meter(x, 14, w, 12, f.shown_health / f.max_health, ap.Color(200, 60, 70), mirrored)
    var healthy = ap.Color(120, 220, 110) if f.poison <= 0 else ap.Color(150, 210, 60)
    if f.health / f.max_health < 0.3 do
        healthy = ap.Color(240, 190, 70)
    end
    meter(x, 14, w, 12, f.health / f.max_health, healthy, mirrored)
    meter(x, 14, w, 3, f.health / f.max_health, ap.WHITE.fade(0.25), mirrored)
    ap.rect_lines(x - 1, 13, w + 2, 14, 1, look.accent)
    var name = kit.name if not mirrored else "{kit.name} (CPU)"
    if mirrored do
        label_right(name, x + w, 32, 16, look.accent)
    else do
        label(name, x, 32, 16, look.accent)
    end
    # Rounds won.
    if finale_slots() do
        # Two side slots, filled from the outside in toward the finale in the middle.
        for i in 0..<2 do
            var px = 274.0 + double(i) * 12 if not mirrored else 358.0 - double(i) * 12
            ap.rect(px, 30, 8, 8, ap.BLACK.fade(0.7))
            ap.rect(px + 1, 31, 6, 6, look.accent if i < f.wins else ap.Color(50, 46, 66))
        end
    else if endless() do
        if mirrored do
            label("WINS {f.wins}", 346, 30, 8, look.accent)
        else do
            label_right("WINS {f.wins}", 294, 30, 8, look.accent)
        end
    else do
        for i in 0..<wins_needed() do
            var px = 286.0 - double(i) * 12 if not mirrored else 346.0 + double(i) * 12
            ap.rect(px, 30, 8, 8, ap.BLACK.fade(0.7))
            ap.rect(px + 1, 31, 6, 6, look.accent if i < f.wins else ap.Color(50, 46, 66))
        end
    end
    # The special bar.
    var bw = 132.0
    var bx = x + w - bw if mirrored else x
    var by = 52.0
    if kit.bar_pips do
        var count = int(kit.bar_max)
        var have = pips(kit, f.bar)
        for i in 0..<count do
            var px = bx + bw - 14 - double(i) * 16 if mirrored else bx + double(i) * 16
            ap.rect(px, by - 1, 14, 9, ap.BLACK.fade(0.75))
            ap.rect(px + 1, by, 12, 7, look.accent if i < have else ap.Color(44, 40, 58))
        end
        if f.state == STATE_RELOAD and kit.reload_all do
            meter(bx, by + 10, bw, 2, double(f.frame) / double(roster.SPEEDLOAD_TICKS), ap.WHITE, mirrored)
        else if f.state == STATE_RELOAD do
            meter(bx, by + 10, bw, 2, double(f.frame % roster.RELOAD_TICKS) / double(roster.RELOAD_TICKS), ap.WHITE, mirrored)
        else if kit.bar_regen > 0 and have < count do
            meter(bx, by + 10, bw, 2, f.bar - double(have), look.accent.fade(0.7), mirrored)
        end
    else do
        ap.rect(bx - 1, by - 1, bw + 2, 9, ap.BLACK.fade(0.75))
        ap.rect(bx, by, bw, 7, ap.Color(34, 30, 48))
        meter(bx, by, bw, 7, f.bar / kit.bar_max, look.accent, mirrored)
        # Where each skill's need falls on the bar (HUNTER's STUDY).
        for a in kit.skills do
            if a.need > 0 and a.need < kit.bar_max do
                var at = a.need / kit.bar_max
                var tx = bx + bw * (1 - at) if mirrored else bx + bw * at
                ap.rect(tx - 0.5, by - 1, 1, 9, ap.WHITE.fade(0.8 if f.bar >= a.need else 0.35))
            end
        end
    end
    var used_w = double(int(kit.bar_max)) * 16 - 2 if kit.bar_pips else bw
    var icon_x = x - 14 if not mirrored else x + w + 2
    draw_bar_icon(kit.bar_icon, icon_x, by - 3, look.accent, f.bar / kit.bar_max)
    var bar_name = "{kit.bar_name} FREE" if mx(f).free_bar else kit.bar_name
    if mirrored do
        label_right(bar_name, x + w - used_w - 6, by, 8, look.accent)
    else do
        label(bar_name, x + used_w + 6, by, 8, look.accent)
    end
    if kit.quiver > 0 do
        # The quiver, after the bar's name: one arrow a notch.
        var name_w = ap.measure(bar_name, 8).x
        var qx = x + w - used_w - 6 - name_w - 8 - double(kit.quiver) * 7 if mirrored else x + used_w + 6 + name_w + 8
        for i in 0..<kit.quiver do
            var k = kit.quiver - 1 - i if mirrored else i
            var px = qx + double(i) * 7
            var lit = k < f.arrows
            var tint = look.accent if lit else ap.Color(70, 62, 80)
            ap.rect(px, by - 1, 6, 9, ap.BLACK.fade(0.75))
            ap.rect(px + 2, by + 2, 2, 5, tint)
            ap.rect(px + 1, by, 4, 2, tint)
        end
        if f.arrows == 0 do
            var ex = qx - 4 if mirrored else qx + double(kit.quiver) * 7 + 4
            if mirrored do
                label_right("NO ARROW", ex, by, 8, ap.Color(255, 120, 90))
            else do
                label("NO ARROW", ex, by, 8, ap.Color(255, 120, 90))
            end
        end
    end
    # The super bar, small; the player's is also drawn large at the bottom. FLASQUE has none.
    var full = f.energy >= roster.SUPER_MAX
    if kit.mech != roster.MECH_FLASQUE do
        ap.rect(bx - 1, by + 13, bw + 2, 5, ap.BLACK.fade(0.75))
        ap.rect(bx, by + 14, bw, 3, ap.Color(50, 18, 24))
        meter(bx, by + 14, bw, 3, f.energy / roster.SUPER_MAX, ap.Color(255, 70, 70) if full else ap.Color(190, 40, 50), mirrored)
    end
    # How close their basic attacks are to setting the opponent free.
    var sx = bx + bw - 60 if mirrored else bx
    var hot = ap.Color(255, 120, 90) if f.spam > 0.7 else ap.Color(200, 190, 120)
    ap.rect(sx - 1, by + 20, 62, 5, ap.BLACK.fade(0.75))
    ap.rect(sx, by + 21, 60, 3, ap.Color(40, 36, 30))
    meter(sx, by + 21, 60, 3, f.spam, hot, mirrored)
    if mirrored do
        label_right("SPAM", sx - 5, by + 19, 8, hot.fade(0.4 + 0.6 * f.spam))
    else do
        label("SPAM", sx + 65, by + 19, 8, hot.fade(0.4 + 0.6 * f.spam))
    end
    # What is wrong, or right, with them.
    var status = ""
    var status_color = ap.WHITE
    if f.slow > 0 do
        status = "SLOWED"
        status_color = ap.Color(150, 200, 240)
    end
    if f.buff == roster.BUFF_MIST do
        status = "MIST"
        status_color = look.accent
    else if f.buff == roster.BUFF_HASTE do
        status = "SECOND WIND {int(f.buff_time) + 1}"
        status_color = look.accent
    else if f.buff == roster.BUFF_REGEN do
        status = "MENDING {int(f.buff_time) + 1}"
        status_color = ap.Color(120, 240, 130)
    else if f.buff == roster.BUFF_POWER do
        status = "LOADED"
        status_color = look.accent
    else if f.buff == roster.BUFF_PARRY do
        status = "STILL WATER {int(f.buff_time) + 1}"
        status_color = look.accent
    else if f.buff == roster.BUFF_GUARD do
        status = "BRACED {int(f.buff_time) + 1}"
        status_color = look.accent
    end
    if f.poison > 0 do
        status = "{other(f).kit.dot_name} {int(f.poison) + 1}"
        status_color = ap.Color(150, 240, 80)
    end
    if f.cloaked do
        status = "UNSEEN"
        status_color = look.accent
    end
    if f.state == STATE_RELOAD do
        status = "RELOADING"
        status_color = ap.LIGHT_GRAY
    end
    if mx(f).vanish do
        status = "VANISHED"
        status_color = look.accent
    end
    if status == "" and kit.revive > 0 and not f.revived and phase == PHASE_FIGHT do
        status = "UNDEAD"
        status_color = look.accent
    end
    if f.broke_ticks > 0 do
        status = "BANKRUPT {(f.broke_ticks + 59) // 60}"
        status_color = ap.Color(255, 90, 80)
    end
    if status == "" and kit.arsenal.length > 0 do
        status = kit.arsenal[f.arm].name
        status_color = look.metal
    end
    if status == "" and kit.copycat do
        status = "LOCKED: {kit.skills[0].name.upper()}" if f.copy_locked else "NEXT SKILL IS COPIED"
        status_color = look.accent if f.copy_locked else ap.Color(170, 165, 190)
    end
    if status == "" and kit.lab do
        if f.clone_cool > 0 do
            status = "MACHINE COOLING {(f.clone_cool + 59) // 60}"
            status_color = ap.Color(170, 165, 190)
        else do
            status = "DOSES {f.injects}/{1 if mx(f).labs else kit.inject_need}"
            status_color = look.accent
        end
    end
    if status == "" and own_mirrors(f) > 0 and not f.cpu do
        status = "{own_mirrors(f)} COPIES"
        status_color = look.accent
    end
    if status == "" and behind(f) > 0 and phase != PHASE_OVER do
        status = "UNDERDOG +{int(UNDERDOG_DAMAGE * 100) * behind(f)}%"
        status_color = look.accent
    end
    if status != "" do
        if mirrored do
            label_right(status, x + w, 82, 8, status_color)
        else do
            label(status, x, 82, 8, status_color)
        end
    end
    # The combo they are landing.
    if f.combo_show > 0 and f.combo >= 2 do
        var fade = math.min(double(f.combo_show) / 20, 1.0)
        var count = "{f.combo} HITS"
        var total = "{int(f.combo_damage + 0.5)} DAMAGE"
        if mirrored do
            label_right(count, x + w, 96, 16, look.accent.fade(fade))
            label_right(total, x + w, 114, 8, ap.WHITE.fade(fade))
        else do
            label(count, x, 96, 16, look.accent.fade(fade))
            label(total, x, 114, 8, ap.WHITE.fade(fade))
        end
    end
end

# The player's moves along the bottom: the four skills with their cooldowns, and the super bar.
function draw_moves_hud(Fighter f)
    var kit = f.kit
    var look = kit.look
    var dim = ap.Color(120, 116, 140)
    var dash = "Q Dash" if f.dash_cooldown == 0 else "Q ...."
    var r_move = kit.fallback.name if kit.fallback.name != "" and not can_pay(f, kit.basics[0].cost) else kit.basics[0].name
    label("R {r_move}    F Block    {dash}", 16, 304, 8, ap.Color(170, 165, 190))
    for i, a in kit.skills do
        var x = 16.0 + double(i) * 110
        var y = 315.0
        var w = 106.0
        var cooling = f.cooldowns[i] > 0
        var paid = f.bar + 0.001 >= a.cost and f.bar + 0.001 >= a.need and f.locks[i] == 0 and not out_of_arrows(f, a)
        if a.kind == roster.KIND_QUIVER do
            paid = f.arrows < kit.quiver
        else if a.kind == roster.KIND_RELOAD do
            paid = f.bar < kit.bar_max
        else if a.kind == roster.KIND_CLOAK and f.cloaked do
            paid = true
        end
        var ready = paid and not cooling
        ap.rect(x, y, w, 17, ap.BLACK.fade(0.7))
        ap.rect(x, y, 15, 17, look.accent if ready else ap.Color(44, 40, 58))
        if f.locks[i] > 0 do
            ap.rect(x + 15, y, w - 15, 17, ap.Color(230, 200, 110).fade(0.18))
            label_centered("{(f.locks[i] + 59) // 60}", x + 8, y + 5, 8, ap.Color(230, 200, 110))
        else if cooling do
            # The box refills as the skill comes back.
            var left = double(f.cooldowns[i]) / double(math.max(a.cooldown, 1))
            ap.rect(x + 15, y, (w - 15) * (1 - left), 17, look.accent.fade(0.16))
            label_centered("{(f.cooldowns[i] + 59) // 60}", x + 8, y + 5, 8, ap.WHITE)
        else do
            label_centered("{i + 1}", x + 8, y + 5, 8, ap.BLACK if ready else dim)
        end
        label(a.name, x + 19, y + 5, 8, ap.WHITE if ready else dim)
        if ready do
            ap.rect(x, y + 16, w, 1, look.accent)
        end
    end
    # The super (FLASQUE's is a purse of coins, not a bar that fills).
    var full = f.energy >= roster.SUPER_MAX
    var red = ap.Color(255, 70, 70) if full else ap.Color(190, 40, 50)
    if kit.mech == roster.MECH_FLASQUE and not in_super(f) do
        full = f.bar >= kit.bar_max
        red = MAX_GOLD if full else MAX_GOLD.brightness(0.6)
        ap.rect(16, 336, 15, 12, red if full else ap.Color(60, 50, 28))
        label_centered("G", 24, 338, 8, ap.WHITE if full else dim)
        ap.rect(33, 336, 204, 12, ap.BLACK.fade(0.75))
        var pips = int(kit.bar_max)
        var pw = 200 / kit.bar_max
        for k in 0..<pips do
            ap.rect(35 + double(k) * pw, 338, pw - 2, 8, red if double(k) < f.bar else ap.Color(50, 44, 24))
        end
        label("G  {kit.maximum.name}: {int(f.bar)}/{pips} COINS", 243, 338, 8, MAX_GOLD if full else dim)
        return
    end
    ap.rect(16, 336, 15, 12, red if full else ap.Color(60, 22, 28))
    label_centered("G", 24, 338, 8, ap.WHITE if full else dim)
    ap.rect(33, 336, 204, 12, ap.BLACK.fade(0.75))
    ap.rect(35, 338, 200, 8, ap.Color(50, 18, 24))
    ap.rect(35, 338, 200 * f.energy / roster.SUPER_MAX, 8, red)
    ap.rect(35, 338, 200 * f.energy / roster.SUPER_MAX, 2, ap.WHITE.fade(0.25))
    if in_super(f) do
        # Your super is on: the bar is its time, and G is the old super move until used.
        var m = mx(f)
        var left = super_left(f)
        ap.rect(35, 338, 200, 8, ap.Color(50, 18, 24))
        ap.rect(35, 338, 200 * double(left) / (m.seconds * 60), 8, m.glow)
        var word = "G  {kit.ultimate.name}" if not f.encore_used else "{m.name}  {(left + 59) // 60}s"
        label(word, 243, 338, 8, ap.WHITE)
    else if kit.mech == roster.MECH_FLASQUE do
        label("G  {kit.maximum.name}: {int(f.bar)}/{int(kit.bar_max)} COINS", 243, 338, 8, MAX_GOLD if f.bar >= kit.bar_max else dim)
    else if full and kit.maximum.jammer do
        if can_super(f) do
            label("G  SWITCH OFF THEIR SUPER", 243, 338, 8, MAX_GOLD)
        else do
            label("SUPER  ONLY IN THEIR SUPER", 243, 338, 8, dim)
        end
    else if full and merge_owner >= 0 do
        label("SUPER  WAIT", 243, 338, 8, dim)
    else if full and max_owner >= 0 do
        label("SUPER  WAIT", 243, 338, 8, dim)
    else if kit.maximum.jammer and not full do
        label("SUPER  {int(f.energy)}%  (THEIR SUPER ONLY)", 243, 338, 8, dim)
    else do
        label("SUPER  {kit.maximum.name}" if full else "SUPER  {int(f.energy)}%", 243, 338, 8, ap.WHITE if full else dim)
    end
end

function side_color(int side) returns ap.Color
    return ap.Color(150, 120, 255) if side == 0 else ap.Color(255, 110, 90)
end

# 2v2: the partners' health over their heads, and a marker over whoever the player is facing.
function draw_duo_hud()
    for g in everyone() do
        var at = g.screen
        if at.x < -50 or g.state == STATE_DOWN do
            continue
        end
        var tint = side_color(g.id)
        if g.partner do
            ap.rect(at.x - 22, at.y - 1, 44, 6, ap.BLACK.fade(0.75))
            ap.rect(at.x - 21, at.y, 42 * math.clamp(g.shown_health / g.max_health, 0.0, 1.0), 4, ap.Color(200, 60, 70))
            ap.rect(at.x - 21, at.y, 42 * math.clamp(g.health / g.max_health, 0.0, 1.0), 4, tint)
            var tag = "ALLY" if g.id == 0 else "CPU"
            label_centered("{g.kit.name} ({tag})", at.x, at.y - 10, 8, tint)
        else if g.id == 0 do
            label_centered("YOU", at.x, at.y - 2, 8, tint.fade(0.8))
        end
    end
    var target = foe_of(fighters[0])
    if target.state != STATE_DOWN and fighters[0].state != STATE_DOWN do
        var at = target.screen
        var bob = 2 * math.sin(draw_clock() * 0.15)
        var y = at.y - (22.0 if target.partner else 10.0) + bob
        ap.triangle(ap.Vec2(at.x - 5, y - 6), ap.Vec2(at.x + 5, y - 6), ap.Vec2(at.x, y), MAX_GOLD)
    end
    # Who is still up, beside each side's name at the top.
    for side in 0..<2 do
        var g = partner_of(side)
        if g == fighters[side] do
            continue
        end
        var main = fighters[side]
        var name = main.kit.name if side == 0 else "{main.kit.name} (CPU)"
        var words = "+ {g.kit.name}" if g.state != STATE_DOWN else "+ {g.kit.name} (DOWN)"
        var color = side_color(side) if g.state != STATE_DOWN else ap.Color(110, 106, 130)
        if side == 0 do
            label(words, 16 + ap.measure(name, 16).x + 8, 37, 8, color)
        else do
            label_right(words, 624 - ap.measure(name, 16).x - 8, 37, 8, color)
        end
    end
    label_centered("E  SWITCH TARGET", 320, 56, 8, ap.Color(150, 145, 175).fade(0.6))
end

# The mouse over a skill box at the bottom shows the same numbers as the select screen.
function draw_fight_tooltip(Fighter f)
    var m = ap.mouse()
    var was = hover_row
    hover_row = HOVER_NONE
    for i in 0..<f.kit.skills.length do
        if ap.Rect(16.0 + double(i) * 110, 315, 106, 17).contains(m) do
            hover_row = i
        end
    end
    if ap.Rect(16, 336, 220, 12).contains(m) do
        hover_row = HOVER_MAX
    end
    if ap.Rect(16, 302, 120, 11).contains(m) do
        hover_row = SLOT_BASIC
    end
    hover_ticks = hover_ticks + 1 if hover_row == was else 0
    if hover_row != HOVER_NONE do
        draw_tooltip_for(f.kit)
    end
end

function draw_fight_hud()
    if max_cut > 0 do
        # The cutscene has the screen to itself.
        draw_maximum_hud()
        return
    end
    for f in fighters do
        draw_fighter_hud(f)
    end
    wave_overlay()
    var seconds = (clock + 59) // 60
    if finale_slots() do
        # The finale slot under the clock: gold-rimmed, pulsing while it is up for grabs,
        # and filled with the winner's colour once taken.
        var taker = -1
        for f in fighters do
            if f.wins >= 3 do
                taker = f.id
            end
        end
        var rim = ap.Color(255, 206, 70)
        if finale_round() and taker < 0 do
            rim = rim.fade(0.55 + 0.45 * math.sin(draw_clock() * 0.15))
        end
        ap.rect(314, 32, 12, 12, ap.BLACK.fade(0.8))
        ap.rect_lines(314, 32, 12, 12, 1, rim)
        ap.rect(316, 34, 8, 8, fighters[taker].kit.look.accent if taker >= 0 else ap.Color(50, 46, 66))
    end
    var box = 36.0 if seconds < 100 else 50.0
    ap.rect(320 - box / 2, 10, box, 22, ap.BLACK.fade(0.75))
    label_centered("{seconds}", 320, 13, 16, ap.WHITE if seconds > 10 else ap.Color(240, 190, 70))
    # Where the arena is, named as it changes.
    if area_blend < AREA_SHIFT do
        var shown = math.sin(double(area_blend) / double(AREA_SHIFT) * math.PI)
        label_centered(area_title(), 320, 44, 8, area_glow().fade(shown))
    else do
        label_centered(area_title(), 320, 44, 8, area_glow().fade(0.45))
    end
    for m in minions do
        if m.partner do
            continue
        end
        # A clone's health, over its head.
        ap.rect(m.screen.x - 16, m.screen.y - 1, 32, 5, ap.BLACK.fade(0.7))
        ap.rect(m.screen.x - 15, m.screen.y, 30 * math.clamp(m.health / m.max_health, 0.0, 1.0), 3, ap.Color(120, 255, 120))
    end
    if duo do
        draw_duo_hud()
    end
    for f in floaters do
        var fade = math.min(f.life * 2.5, 1.0)
        label_centered(f.words, f.screen.x, f.screen.y, 8, f.color.fade(fade))
    end
    if banner != "" do
        var fade = math.min(double(phase_ticks) / 14, 1.0)
        if phase == PHASE_FIGHT do
            fade = math.clamp(double(45 - phase_ticks) / 14, 0.0, 1.0)
        end
        ap.rect(0, 150, VW, 46, ap.BLACK.fade(0.5 * fade))
        label_centered(banner, 320, 158, 32, ap.WHITE.fade(fade))
        if phase == PHASE_INTRO and banner_sub != "" do
            label_centered(banner_sub, 320, 204, 8, banner_sub_color.fade(fade))
        end
        if phase == PHASE_OVER and banner != "DOUBLE K.O." and phase_ticks > 50 do
            var lead = fighters[0] if fighters[0].wins > fighters[1].wins or fighters[1].state == STATE_DOWN else fighters[1]
            if banner == "K.O." do
                label_centered("{lead.kit.name} TAKES THE ROUND", 320, 204, 8, lead.kit.look.accent)
            end
        end
    end
    draw_moves_hud(fighters[0])
    draw_fight_tooltip(fighters[0])
    draw_maximum_hud()
    if phase == PHASE_DRAFT do
        draw_draft_hud()
    end
    if super_ticks > 0 do
        # A super is called by name, across the screen.
        var show = math.min(double(super_ticks) / 12, 1.0) * math.min(double(80 - super_ticks) / 5, 1.0)
        ap.rect(0, 126, VW, 24, ap.BLACK.fade(0.55 * show))
        ap.rect(0, 126, VW, 1, ap.Color(240, 50, 60).fade(show))
        ap.rect(0, 149, VW, 1, ap.Color(240, 50, 60).fade(show))
        label_centered(super_name.upper(), 320, 130, 16, super_tint.fade(show))
    end
    var cpu = "FIGHTS"
    if cpu_mode == CPU_STANDS do
        cpu = "STANDS"
    else if cpu_mode == CPU_BLOCKS do
        cpu = "BLOCKS"
    end
    label_right("F1 DEBUG F2 {pixel}X F3 CPU {cpu} F4 REFILL F5 {LEVEL_NAMES[level]} F6 ADMIN", 624, 304, 8, ap.Color(110, 106, 130))
    if ap.debugging() do
        for f in fighters do
            ap.debug_text("{f.kit.name}: state {f.state} frame {f.frame} hp {int(f.health)} bar {int(f.bar)} fade {int(f.fade * 100)}")
        end
        ap.debug_text("shots {shots.length} sparks {sparks.length} phase {phase} cpu {cpu}")
        ap.debug_inputs("player", pad, 6)
    end
    if admin_open do
        draw_admin()
    end
    if paused do
        ap.rect(0, 0, VW, VH, ap.BLACK.fade(0.6))
        label_centered("PAUSED", 320, 96, 32, ap.WHITE)
        var music_words = "MUSIC: OFF" if saved.music < 0.01 else "MUSIC: {int(saved.music * 100)}%"
        var items = ["RESUME", "RESTART MATCH", "CHARACTER SELECT", music_words, "MODELS: {puppet.STYLE_NAMES[puppet.style]}", "QUIT"]
        for i, item in items do
            var chosen = i == pause_cursor
            label_centered("> {item} <" if chosen else item, 320, 136 + double(i) * 20, 16,
                ap.WHITE if chosen else ap.Color(130, 126, 150))
        end
        label_centered("WASD move    R attack (again to chain)    1 2 3 4 skills    G super    F block (tap to parry)    Q dash",
            320, 256, 8, ap.Color(170, 165, 190))
        label_centered("A hit can be cancelled: attack into a skill, a skill into the super", 320, 268, 8,
            ap.Color(170, 165, 190))
        for side in 0..<2 do
            var words = held_items(side)
            if words != "" do
                label_centered("{"YOUR" if side == 0 else "THEIR"} ITEMS: {words}", 320, 308 + double(side) * 10, 8, fighters[side].kit.look.accent)
            end
        end
        label_centered("Super bar full when they call theirs? G during their cutscene merges the two places", 320, 296, 8,
            ap.Color(255, 206, 70))
        label_centered("Gamepad: stick, X attack, Y / B / d-pad left / right skills, LB super, RB block, A dash", 320, 282, 8,
            ap.Color(130, 126, 150))
    end
end

function draw_title_hud()
    var rise = math.min(double(screen_ticks) / 50, 1.0)
    var seam = title_seam()
    var t = double(ticks)
    # ARENA: the arena itself behind a violet glass, its sigil turning, light from above.
    var q = title_pop[1]
    ap.clip(ap.Rect(seam - 30, 0, VW - seam + 30, VH))
    ap.rect(seam - 30, 0, VW - seam + 30, VH, ap.Color(40, 16, 80, int(150 - 60 * q)))
    ap.gradient(seam - 30, 0, VW - seam + 30, VH, ap.Color(170, 110, 255, int(40 + 40 * q)), ap.Color(20, 8, 40, 160))
    var cx = 470 + 30 * q
    var cy = 200.0
    for k in 0..<4 do
        var r = 40 + double(k) * 34 + 6 * math.sin(t * 0.03 + double(k))
        ap.circle_lines(cx, cy, r, 1, ap.Color(190, 150, 255, int(70 + 40 * q)))
    end
    for k in 0..<8 do
        var a = t * 0.01 + double(k) * math.PI / 4
        ap.line(cx + math.cos(a) * 40, cy + math.sin(a) * 40, cx + math.cos(a) * 142, cy + math.sin(a) * 142, 1, ap.Color(190, 150, 255, int(50 + 50 * q)))
    end
    for k in 0..<5 do
        var x = seam + 30 + double(k) * 70 + math.sin(t * 0.007 + double(k)) * 20
        ap.triangle(ap.Vec2(x, 0), ap.Vec2(x + 30, 0), ap.Vec2(x + 70, VH), ap.Color(220, 190, 255, int(16 + 20 * q)))
    end
    var ascale = 1 + 0.22 * q
    var aw = ap.measure("ARENA", 32).x
    ap.push()
    ap.translate(610 - aw * ascale - 20 * q, 252 - 14 * q)
    ap.scale(ascale, ascale)
    label("ARENA", 4, 4, 32, ap.Color(0, 0, 0, int(160 * q)))
    label("ARENA", 0, 0, 32, ap.Color(200, 160, 255).lerp(ap.WHITE, 0.2 * q))
    label_right("1V1 OR 2V2, PVP OR CPU", aw - 2, 40, 8, ap.Color(220, 210, 240).fade(0.5 + 0.5 * q))
    label_right("44 FIGHTERS", aw - 2, 52, 8, ap.Color(200, 170, 255).fade(0.4 + 0.6 * q))
    ap.pop()
    ap.unclip()
    # PURGATORY: the dark, brick showing only where a light wanders, embers, a red scarf.
    var p = title_pop[0]
    var lean = 26.0
    ap.polygon([ap.Vec2(0, 0), ap.Vec2(seam + lean, 0), ap.Vec2(seam - lean, VH), ap.Vec2(0, VH)], ap.Color(4, 3, 6))
    ap.clip(ap.Rect(0, 0, seam + lean, VH))
    for band in 0..<10 do
        var y0 = VH * 0.45 + double(band) * VH * 0.055
        var edge = seam + lean - 2 * lean * (y0 + VH * 0.0275) / VH
        ap.rect(0, y0, edge, VH * 0.055 + 1, ap.Color(70, 10, 18, int((150 + 80 * p) * double(band + 1) / 10)))
    end
    var lamp_x = seam * 0.45 + math.sin(t * 0.011) * seam * 0.25
    var lamp_y = 230 + math.cos(t * 0.017) * 40
    if title_pick == 0 do
        lamp_x = ap.lerp(lamp_x, title_mouse.x, 0.7)
        lamp_y = ap.lerp(lamp_y, title_mouse.y, 0.7)
    end
    var glow = 90 + 60 * p
    for row in 0..<24 do
        for col in 0..<12 do
            var bx = double(col) * 32 - (16.0 if row % 2 == 1 else 0.0)
            var by = double(row) * 16
            var d = math.sqrt((bx + 15 - lamp_x) * (bx + 15 - lamp_x) + (by + 7 - lamp_y) * (by + 7 - lamp_y))
            var lit = math.clamp(1 - d / glow, 0.0, 1.0)
            if lit > 0 and bx + 30 < seam + lean - 2 * lean * (by + 14) / VH do
                var shade = 0.55 + 0.45 * math.abs(math.sin(double(row * 12 + col) * 1.7))
                ap.rect(bx + 1, by + 1, 30, 14, ap.Color(int(120 * shade), int(70 * shade), int(62 * shade), int(255 * lit * lit)))
            end
        end
    end
    for k in 0..<26 do
        var life = (t * (0.6 + 0.05 * double(k % 5)) + double(k) * 37) % 360
        var ex = (double(k) * 53 + math.sin(life * 0.03 + double(k)) * 14) % math.max(seam - lean, 1.0)
        var ey = VH - life
        ap.rect(ex, ey, 2, 2, ap.Color(255, 120 + (k % 3) * 40, 60, int(200 * (1 - life / 360))))
    end
    # The scarf: a red ribbon streaming across.
    ap.Vec2[] top = []
    for k in 0..<22 do
        var x = -10 + double(k) * (seam + 4) / 21
        var wave = math.sin(t * 0.05 - double(k) * 0.45) * (10 + double(k) * 0.9) * (1 + 0.5 * p)
        top.push(ap.Vec2(x, 300 - double(k) * 3.2 + wave))
    end
    for k in 0..<(top.length - 1) do
        var a = top[k]
        var b = top[k + 1]
        var thick = 9 - double(k) * 0.25
        var c = ap.Color(170 + (k % 2) * 25, 30, 44)
        ap.triangle(a, b, ap.Vec2(b.x, b.y + thick), c)
        ap.triangle(a, ap.Vec2(b.x, b.y + thick), ap.Vec2(a.x, a.y + thick + 0.25), c)
    end
    var pscale = 1 + 0.22 * p
    ap.push()
    ap.translate(30 + 20 * p, 252 - 14 * p)
    ap.scale(pscale, pscale)
    label("PURGATORY", 4, 4, 32, ap.Color(0, 0, 0, int(160 * p)))
    label("PURGATORY", 0, 0, 32, ap.Color(230, 60, 70).lerp(ap.WHITE, 0.15 * p))
    label("SINGLE-PLAYER: 44 LEVELS", 2, 40, 8, ap.Color(210, 190, 200).fade(0.5 + 0.5 * p))
    label("EXPLORE, FIGHT, LEARN SKILLS", 2, 52, 8, ap.Color(255, 150, 140).fade(0.4 + 0.6 * p))
    ap.pop()
    if not purgatory.INSTALLED do
        # Not installed: the whole door is darkened, and its install prompt is right on it.
        ap.polygon([ap.Vec2(0, 0), ap.Vec2(seam + lean, 0), ap.Vec2(seam - lean, VH), ap.Vec2(0, VH)], ap.Color(0, 0, 0, 170))
        draw_install(seam - 22, p)
    end
    ap.unclip()
    # The seam: a slanted bright edge between the two.
    ap.triangle(ap.Vec2(seam - 2 + lean, 0), ap.Vec2(seam + 2 + lean, 0), ap.Vec2(seam + 2 - lean, VH), ap.Color(255, 230, 240, 200))
    ap.triangle(ap.Vec2(seam - 2 + lean, 0), ap.Vec2(seam + 2 - lean, VH), ap.Vec2(seam - 2 - lean, VH), ap.Color(255, 230, 240, 200))
    # The one not chosen sinks back.
    if title_pick == 0 do
        ap.polygon([ap.Vec2(seam + lean, 0), ap.Vec2(VW, 0), ap.Vec2(VW, VH), ap.Vec2(seam - lean, VH)], ap.Color(0, 0, 0, int(90 * p)))
    else if title_pick == 1 do
        ap.polygon([ap.Vec2(0, 0), ap.Vec2(seam + lean, 0), ap.Vec2(seam - lean, VH), ap.Vec2(0, VH)], ap.Color(0, 0, 0, int(90 * q)))
    end
    # The logo over both.
    label_centered("PLAYER", 320, 46, 48, ap.WHITE.fade(rise))
    label_centered("VERSUS", 320, 96, 48, ap.Color(170, 110, 255).fade(rise))
    label_centered("TESTING PROTOTYPE", 320, 156, 8, ap.Color(170, 165, 195).fade(rise))
    label_centered("ESC QUITS", 320, 344, 8, ap.Color(120, 116, 140))
    if GAME_VERSION != "" do
        label("VERSION {GAME_VERSION}", 12, 344, 8, ap.Color(120, 116, 140))
    end
    if title_pick < 0 do
        label_centered("POINT AT ONE (OR A / D) AND CLICK (OR ENTER)", 320, 326, 8, ap.Color(200, 195, 215).fade(0.4 + 0.3 * math.sin(t * 0.05)))
    end
end

# PURGATORY's install prompt, drawn on its own (darkened) door: what it is, and what clicking does.
function draw_install(double width, double p)
    var cx = width / 2
    var t = double(ticks)
    var head = ap.Color(255, 210, 200)
    var soft = ap.Color(200, 190, 210)
    var warm = ap.Color(255, 220, 160)
    label_centered("NOT INSTALLED" if purgatory.STATUS == "missing" else ("NEEDS AN UPDATE" if purgatory.STATUS == "outdated" else "NEEDS A NEWER GAME"), cx, 168, 16, head)
    if install_state == INSTALL_RESTART do
        label_centered("INSTALLED", cx, 194, 16, ap.WHITE)
        label_centered(install_error if install_error != "" else "RESTARTING THE GAME...", cx, 216, 8, soft)
        return
    end
    if install_state == INSTALL_RUNNING do
        var dots = ".".repeat(1 + (install_ticks // 20) % 3)
        label_centered("INSTALLING{dots}" if purgatory.STATUS == "missing" else "UPDATING{dots}", cx, 196, 8, ap.WHITE)
        ap.rect(cx - 90, 212, 180, 4, ap.Color(40, 30, 40))
        var x = (double(install_ticks) * 3) % 220 - 40
        ap.rect(cx - 90 + math.max(x, 0.0), 212, math.min(40.0, 180 - math.max(x, 0.0)), 4, ap.Color(230, 70, 80))
        return
    end
    if install_state == INSTALL_FAILED do
        var err = install_error if install_error.length < 40 else install_error[0..<40]
        label_centered("IT DID NOT INSTALL" if purgatory.STATUS == "missing" else "IT DID NOT UPDATE", cx, 192, 8, ap.Color(255, 120, 110))
        label_centered(err, cx, 204, 8, ap.Color(200, 180, 190))
    else if purgatory.STATUS == "outdated" do
        label_centered("Made for an older version of the game.", cx, 192, 8, soft)
        label_centered("Updating gets its newest code and music.", cx, 204, 8, warm)
    else if purgatory.STATUS == "newer" do
        label_centered("It needs a newer game than {GAME_VERSION}.", cx, 192, 8, soft)
        label_centered("Updating gets the newest game.", cx, 204, 8, warm)
    else do
        label_centered("A separate download, about 10 MB:", cx, 188, 8, soft)
        label_centered("its CODE, built into the game,", cx, 198, 8, warm)
        label_centered("and 16 human-made CC0 tracks.", cx, 208, 8, soft)
    end
    # The button: brighter while the door is pointed at.
    var words = ("TRY AGAIN" if install_state == INSTALL_FAILED else ("INSTALL AND RESTART" if purgatory.STATUS == "missing" else "UPDATE AND RESTART"))
    var bw = 170.0
    var on = title_pick == 0
    var pulse = 0.5 + 0.5 * math.sin(t * 0.12)
    var r = ap.Rect(cx - bw / 2, 220, bw, 18)
    ap.rect(r.x, r.y, r.w, r.h, ap.Color(200, 50, 60, int(150 + 80 * pulse)) if on else ap.Color(40, 30, 44, 220))
    ap.rect_lines(r.x, r.y, r.w, r.h, 1, ap.Color(255, 140, 140) if on else ap.Color(110, 90, 110))
    label_centered(words, cx, r.y + 5, 8, ap.WHITE if on else ap.Color(190, 180, 200))
end

# A small bust for a select card.
function draw_portrait(roster.Look look, double x, double y, double w, double h)
    ap.gradient(x, y, w, h, look.accent.brightness(0.28), ap.Color(14, 12, 24))
    var cx = x + w / 2
    var base = y + h
    var wide = math.min(26 * look.bulk, w - 4)
    ap.rect(cx - wide / 2, base - 14, wide, 14, look.body)
    ap.rect(cx - wide / 2, base - 14, wide, 2, look.trim)
    if look.cape do
        ap.rect(cx - 15 * look.bulk, base - 13, 4, 13, look.cape_color)
        ap.rect(cx + 15 * look.bulk - 4, base - 13, 4, 13, look.cape_color)
    end
    ap.rect(cx - 6, base - 26, 12, 12, look.skin)
    if look.head == roster.HEAD_MASK do
        ap.rect(cx - 4, base - 21, 8, 1, look.eyes)
    else do
        ap.rect(cx - 4, base - 21, 2, 2, look.eyes)
        ap.rect(cx + 2, base - 21, 2, 2, look.eyes)
    end
    var h_kind = look.head
    if h_kind == roster.HEAD_SLICK do
        ap.rect(cx - 6, base - 27, 12, 3, look.legs)
        ap.rect(cx - 9, base - 20, 3, 8, look.cape_color)
        ap.rect(cx + 6, base - 20, 3, 8, look.cape_color)
    else if h_kind == roster.HEAD_BAND do
        ap.rect(cx - 6, base - 27, 12, 2, look.legs)
        ap.rect(cx - 7, base - 25, 14, 2, look.accent)
    else if h_kind == roster.HEAD_COBRA do
        ap.rect(cx - 12, base - 29, 6, 17, look.body)
        ap.rect(cx + 6, base - 29, 6, 17, look.body)
        ap.rect(cx - 6, base - 29, 12, 3, look.body)
    else if h_kind == roster.HEAD_PLUME do
        ap.rect(cx - 11, base - 27, 22, 2, look.body)
        ap.rect(cx - 6, base - 31, 12, 4, look.body)
        ap.rect(cx + 5, base - 35, 3, 7, look.accent)
    else if h_kind == roster.HEAD_COWBOY do
        ap.rect(cx - 12, base - 27, 24, 2, look.body.brightness(0.7))
        ap.rect(cx - 6, base - 32, 12, 5, look.body.brightness(0.7))
        ap.rect(cx - 6, base - 18, 12, 4, look.trim)
    else if h_kind == roster.HEAD_MASK do
        ap.rect(cx - 7, base - 15, 14, 3, look.trim)
    else if h_kind == roster.HEAD_HELMET do
        ap.rect(cx - 7, base - 29, 14, 6, look.metal)
    else if h_kind == roster.HEAD_HOOD do
        ap.rect(cx - 8, base - 29, 16, 4, look.cape_color)
        ap.rect(cx - 8, base - 29, 3, 16, look.cape_color)
        ap.rect(cx + 5, base - 29, 3, 16, look.cape_color)
    else if h_kind == roster.HEAD_WIZARD do
        ap.rect(cx - 11, base - 27, 22, 2, look.body)
        ap.triangle(ap.Vec2(cx - 6, base - 27), ap.Vec2(cx + 6, base - 27), ap.Vec2(cx + 1, base - 39), look.body)
        ap.rect(cx - 3, base - 17, 6, 6, ap.Color(235, 235, 240))
    else if h_kind == roster.HEAD_HEADSET do
        ap.rect(cx - 7, base - 29, 14, 4, look.accent)
        ap.rect(cx - 8, base - 26, 2, 9, look.accent)
        ap.rect(cx + 6, base - 26, 2, 9, look.accent)
        ap.rect(cx - 8, base - 22, 2, 5, look.legs)
        ap.rect(cx - 8, base - 17, 6, 1, look.legs)
    else if h_kind == roster.HEAD_CAP do
        ap.rect(cx - 6, base - 29, 12, 4, look.trim)
        ap.rect(cx - 8, base - 25, 16, 2, look.trim)
    else if h_kind == roster.HEAD_BEANIE do
        ap.rect(cx - 6, base - 29, 12, 5, look.trim)
        ap.rect(cx - 6, base - 18, 12, 4, look.legs)
    else if h_kind == roster.HEAD_HAZMAT do
        ap.rect(cx - 8, base - 29, 16, 16, look.body)
        ap.rect(cx - 5, base - 24, 10, 6, look.eyes)
    else if h_kind == roster.HEAD_CAT do
        ap.rect(cx - 6, base - 30, 4, 4, look.body)
        ap.rect(cx + 2, base - 30, 4, 4, look.body)
        ap.rect(cx - 3, base - 18, 6, 3, look.trim)
    else if h_kind == roster.HEAD_ROBOT do
        ap.rect(cx - 7, base - 27, 14, 14, look.metal)
        ap.rect(cx - 5, base - 23, 10, 4, look.legs)
        ap.rect(cx - 4, base - 22, 3, 2, look.eyes)
        ap.rect(cx + 1, base - 22, 3, 2, look.eyes)
        ap.rect(cx + 3, base - 33, 1, 6, look.metal)
        ap.rect(cx + 2, base - 35, 3, 2, look.accent)
    else if h_kind == roster.HEAD_VISOR do
        ap.rect(cx - 7, base - 28, 14, 15, look.body)
        ap.rect(cx - 6, base - 23, 12, 2, look.eyes)
    else if h_kind == roster.HEAD_TV do
        ap.rect(cx - 10, base - 29, 20, 16, look.legs.brightness(0.8))
        ap.rect(cx - 8, base - 27, 16, 12, look.accent.brightness(0.55))
        ap.rect(cx - 5, base - 23, 2, 2, look.eyes)
        ap.rect(cx + 3, base - 23, 2, 2, look.eyes)
        ap.line(cx - 2, base - 29, cx - 7, base - 37, 1, look.metal)
        ap.line(cx + 2, base - 29, cx + 7, base - 37, 1, look.metal)
    else if h_kind == roster.HEAD_TOPHAT do
        ap.rect(cx - 10, base - 27, 20, 2, look.legs)
        ap.rect(cx - 6, base - 37, 12, 10, look.legs)
        ap.rect(cx - 6, base - 29, 12, 2, look.trim)
        ap.circle_lines(cx - 3, base - 20, 2, 1, look.trim)
    else if h_kind == roster.HEAD_GOGGLES do
        ap.rect(cx - 9, base - 29, 18, 4, ap.Color(236, 236, 240))
        ap.rect(cx - 10, base - 25, 3, 7, ap.Color(236, 236, 240))
        ap.rect(cx + 7, base - 25, 3, 7, ap.Color(236, 236, 240))
        ap.rect(cx - 5, base - 27, 4, 3, look.accent)
        ap.rect(cx + 1, base - 27, 4, 3, look.accent)
    else if h_kind == roster.HEAD_MIRROR do
        ap.rect(cx - 7, base - 27, 14, 14, look.trim)
        ap.rect(cx - 5, base - 25, 10, 10, look.accent.brightness(0.8))
        ap.rect(cx - 4, base - 24, 2, 4, ap.WHITE)
    else if h_kind == roster.HEAD_PONYTAIL do
        ap.rect(cx - 6, base - 28, 12, 3, ap.Color(46, 30, 22))
        ap.rect(cx + 5, base - 30, 3, 12, ap.Color(46, 30, 22))
        ap.rect(cx - 6, base - 25, 12, 1, look.metal)
    else if h_kind == roster.HEAD_VEIL do
        ap.rect(cx - 8, base - 28, 16, 3, look.cape_color)
        ap.rect(cx - 8, base - 26, 3, 14, look.cape_color)
        ap.rect(cx + 5, base - 26, 3, 14, look.cape_color)
    else if h_kind == roster.HEAD_STITCHED do
        ap.rect(cx - 6, base - 27, 12, 1, look.legs)
        ap.rect(cx - 1, base - 27, 1, 5, look.legs)
        ap.rect(cx - 4, base - 16, 8, 3, look.skin.brightness(0.7))
        ap.rect(cx - 3, base - 16, 6, 1, ap.Color(30, 20, 20))
    else if h_kind == roster.HEAD_TOPKNOT do
        ap.rect(cx - 6, base - 28, 12, 3, ap.Color(30, 24, 22))
        ap.rect(cx - 2, base - 32, 4, 4, ap.Color(30, 24, 22))
        ap.rect(cx - 7, base - 25, 14, 2, look.trim)
    else if h_kind == roster.HEAD_CREST do
        ap.rect(cx - 7, base - 29, 14, 5, look.metal)
        ap.rect(cx - 7, base - 25, 2, 9, look.metal)
        ap.rect(cx + 5, base - 25, 2, 9, look.metal)
        ap.rect(cx - 1, base - 33, 3, 4, look.accent)
    end
    if look.wings do
        ap.triangle(ap.Vec2(cx - 9, base - 12), ap.Vec2(cx - 22, base - 30), ap.Vec2(cx - 20, base - 8), look.wing_color.brightness(1.6))
        ap.triangle(ap.Vec2(cx + 9, base - 12), ap.Vec2(cx + 22, base - 30), ap.Vec2(cx + 20, base - 8), look.wing_color.brightness(1.6))
    end
end

function draw_stat(string name, double share, double x, double y, ap.Color color)
    label(name, x, y, 8, ap.Color(150, 145, 175))
    for i in 0..<10 do
        var lit = double(i) < math.clamp(share, 0.0, 1.0) * 10 - 0.5
        ap.rect(x + 54 + double(i) * 9, y, 7, 7, color if lit else ap.Color(36, 32, 50))
    end
end

# Where select card `i` sits.
function card_rect(int i) returns ap.Rect
    var columns = grid_columns()
    var cards = cast.length + 1
    var rows = (cards + columns - 1) // columns
    var gap = 5.0 if rows <= 3 else 3.0
    var cw = (364.0 - gap * double(columns - 1)) / double(columns)
    var ch = 52.0 if rows <= 2 else (38.0 if rows <= 3 else 29.0)
    return ap.Rect(262.0 + double(i % columns) * (cw + gap), 36.0 + double(i // columns) * (ch + gap), cw, ch)
end

function mode_label_rect() returns ap.Rect
    var words = "M  MODE: {mode_title()}  v"
    return ap.Rect(14, 300, ap.measure(words, 8).x + 4, 11)
end
function pool_words() returns string
    return "P  POOL: {pool_name()} ({pool_size()}/{cast.length})  v"
end
function pool_label_rect() returns ap.Rect
    var words = pool_words()
    var w = ap.measure(words, 8).x + 4
    return ap.Rect(624 - w, 11, w, 11)
end
# The models setting: the faceted style or the classic boxes. Only how this machine draws the
# fighters; the fight is the same.
function models_words() returns string
    return "V  MODELS: {puppet.STYLE_NAMES[puppet.style]}"
end
function models_label_rect() returns ap.Rect
    var w = ap.measure(models_words(), 8).x + 4
    return ap.Rect(626 - w, 344, w, 11)
end
function toggle_models()
    puppet.style = puppet.STYLE_FACETED if puppet.style == puppet.STYLE_CLASSIC else puppet.STYLE_CLASSIC
    saved.classic_models = puppet.style == puppet.STYLE_CLASSIC
    save.store(saved)
    icons_ready = false
    snd_move.play(0.5)
end
function items_label_rect() returns ap.Rect
    var words = "I  ITEMS ({count_on()}/{item_defs.length}): {ITEM_MODE_NAMES[items_mode]}"
    return ap.Rect(14, 312, ap.measure(words, 8).x + 4, 11)
end

# --- Icons: every fighter's head and shoulders, rendered in 3D once into a small canvas.
const int ICON_SIZE = 96
ap.Canvas[] icons = []
var icons_ready = false
var icon_kit = 0                     # the fighter being drawn by draw_icon_scene

function draw_icon_scene()
    var kit = cast[icon_kit]
    var look = kit.look
    var pose = puppet.make_pose(look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, 0.6 + double(icon_kit) * 0.37)
    pose.head_turn = -12
    puppet.draw(rig, look, pose, ap.Vec3(0, -look.hover, 0), 24, 1)
end

# Renders the icons (once; the one under the cursor again every frame so it breathes).
function render_icons()
    if icons.length == 0 do
        for i in 0..<cast.length do
            icons.push(ap.Canvas(ICON_SIZE, ICON_SIZE))
        end
    end
    for i in 0..<cast.length do
        var live = screen == SCREEN_SELECT and i == cursor
        if icons_ready and not live do
            continue
        end
        icon_kit = i
        var look = cast[i].look
        var tall = look.tall
        var head = 1.62 * tall + look.hover * 0.0
        ap.draw_to(icons[i])
        ap.clear(ap.TRANSPARENT)
        for k in 0..<8 do
            ap.light_off(k)
        end
        ap.light(0, ap.Vec3(1.4, head + 0.8, 2.2), look.accent.lerp(ap.WHITE, 0.6), 7)
        ap.light(1, ap.Vec3(-1.8, head + 0.2, -0.4), look.accent, 5)
        ap.light(2, ap.Vec3(0, head - 0.4, 2.6), ap.Color(150, 140, 190), 5)
        var t = double(ticks) / 60 if live else 0.0
        var eye = ap.Vec3(0.55 + 0.08 * math.sin(t * 1.3), head + 0.08, 1.75 * math.max(look.bulk, 1.0))
        var cam = ap.Camera3D(eye, ap.Vec3(0, head - 0.12, 0))
        cam.fov = 34
        ap.begin_3d(cam)
        draw_icon_scene()
        ap.end_3d()
    end
    icons_ready = true
end

# A card's picture: the rendered bust over the fighter's colors, or the old flat one.
function draw_icon(int i, double x, double y, double w, double h, bool chosen)
    var look = cast[i].look
    ap.gradient(x, y, w, h, look.accent.brightness(0.38 if chosen else 0.26), ap.Color(12, 10, 22))
    # A soft halo behind the head.
    ap.circle(x + w / 2, y + h * 0.42, w * 0.36, look.accent.fade(0.16 if chosen else 0.08))
    if i < icons.length and icons_ready do
        # The square render, cut to the card's shape.
        var side = math.max(w, h)
        var crop = double(ICON_SIZE) * math.min(w, h) / side
        var ox = (double(ICON_SIZE) - (double(ICON_SIZE) * w / side)) / 2
        var oy = (double(ICON_SIZE) - (double(ICON_SIZE) * h / side)) / 2
        ap.sprite_part(icons[i].texture, ap.Rect(ox, oy, double(ICON_SIZE) * w / side, double(ICON_SIZE) * h / side),
            ap.Rect(x, y, w, h))
    else do
        draw_portrait(look, x, y, w, h)
    end
    ap.gradient(x, y + h - 8, w, 8, ap.Color(12, 10, 22).fade(0), ap.Color(12, 10, 22).fade(0.8))
end

# --- Hover help: the numbers behind a move, or a bar, or the passive.
const int HOVER_NONE = -9
const int HOVER_PASSIVE = -5
const int HOVER_BAR = -4
const int HOVER_MAX = -3
const int HOVER_ULT = -2
var hover_row = HOVER_NONE
var hover_ticks = 0
var key_row = HOVER_NONE   # a row chosen with its own key (1-4, G), held until the mouse takes over

# The rows of the move list, top to bottom: the chain, four skills, the super place, the move.
function move_rows() returns int[]
    return [SLOT_BASIC, 0, 1, 2, 3, HOVER_MAX, HOVER_ULT]
end
function move_row_rect(int n) returns ap.Rect
    return ap.Rect(256, select_moves_y() + 11 * double(n) - 2, 372, 11)
end
function select_info_y() returns double
    var columns = grid_columns()
    var cards = cast.length + 1
    var rows = (cards + columns - 1) // columns
    var last = card_rect(cards - 1)
    return last.y + last.h + 7
end
function select_moves_y() returns double
    return select_info_y() + 98
end
function passive_rect() returns ap.Rect
    return ap.Rect(256, select_info_y() + 24, 372, 29)
end
function bar_rect() returns ap.Rect
    return ap.Rect(420, select_info_y() + 54, 208, 40)
end

function update_hover()
    var m = ap.mouse()
    var was = hover_row
    hover_row = HOVER_NONE
    if cursor < cast.length do
        for n, slot in move_rows() do
            if move_row_rect(n).contains(m) do
                hover_row = slot
            end
        end
        if passive_rect().contains(m) do
            hover_row = HOVER_PASSIVE
        end
        if bar_rect().contains(m) do
            hover_row = HOVER_BAR
        end
        # A move's own key shows that move; G again flips between the super and the move inside it.
        var keys = [ap.KEY_1, ap.KEY_2, ap.KEY_3, ap.KEY_4]
        for k, key in keys do
            if ap.key_pressed(key) and k < cast[cursor].skills.length do
                key_row = HOVER_NONE if key_row == k else k
            end
        end
        if ap.key_pressed(ap.KEY_G) do
            key_row = HOVER_ULT if key_row == HOVER_MAX else HOVER_MAX
        end
        if ap.key_pressed(ap.KEY_B) do
            key_row = HOVER_NONE if key_row == HOVER_BAR else HOVER_BAR
        end
        if ap.key_pressed(ap.KEY_R) do
            key_row = HOVER_NONE if key_row == SLOT_BASIC else SLOT_BASIC
        end
        if hover_row != HOVER_NONE and ap.mouse_delta().length() > 0.3 do
            key_row = HOVER_NONE
        end
        if key_row != HOVER_NONE do
            hover_row = key_row
        end
    else do
        key_row = HOVER_NONE
    end
    hover_ticks = hover_ticks + 1 if hover_row == was else 0
end

function secs(int ticks_long) returns string
    return "{items.number(double(ticks_long) / 60)}s"
end

# Everything worth knowing about a move, a line at a time.
function attack_facts(roster.Character kit, roster.Attack a, int slot) returns string[]
    string[] out = []
    var bar = kit.bar_name.lower()
    if a.kind == roster.KIND_QUIVER do
        out.push("TAKES  {secs(a.startup)}; a hit stops it")
    end
    if a.kind == roster.KIND_STRIKE or a.damage > 0 do
        if a.damage > 0 do
            var total = a.damage * double(a.hits) + a.finish
            if a.kind == roster.KIND_FAN do
                out.push("DAMAGE  {items.number(a.damage)} per bullet left in the {bar}")
            else if a.hits > 1 do
                var last = " + {items.number(a.finish)} on the last" if a.finish > 0 else ""
                out.push("DAMAGE  {items.number(a.damage)} x {a.hits} hits{last} = {items.number(total)}")
            else do
                out.push("DAMAGE  {items.number(total)}")
            end
            if a.volley > 1 do
                out.push("SHOTS  {a.volley} at once, {items.number(a.spread)} degrees apart")
            end
        end
        if a.stun > 0 and a.damage > 0 do
            out.push("STUN  {secs(a.stun)}    KNOCKBACK  {items.number(a.push)}{" (pulls in)" if a.push < 0 else ""}")
        end
        var speed = "STARTUP  {secs(a.startup)}    RECOVERY  {secs(a.recovery)}"
        out.push(speed)
        if a.beam > 0 do
            out.push("RANGE  an instant beam, {items.number(a.beam)} m")
        else if a.shot != roster.SHOT_NONE do
            var how = "lobbed" if a.lob else ("from the sky" if a.skyfall else ("laid as a mine" if a.shot == roster.SHOT_MINE else "fired"))
            out.push("RANGE  {how}, {items.number(a.shot_speed)} m/s for {items.number(a.shot_life)}s")
            if kit.quiver > 0 and a.shot == roster.SHOT_ARROW do
                out.push("ARROW  shoots the nocked arrow; without one it cannot fire")
            end
        else if a.radial do
            out.push("REACH  {items.number(a.reach)} m all around")
        else if a.reach > 0 do
            var step = ", lunges {items.number(a.lunge)} m" if a.lunge > 0 else ""
            out.push("REACH  {items.number(a.reach)} m, {int(a.arc)} degree arc{step}")
        end
    end
    if a.blast > 0 do
        out.push("BLAST  {items.number(a.blast)} m radius")
    end
    if a.homing > 0 do
        out.push("HOMING  turns {int(a.homing)} degrees a second")
    end
    if a.cost > 0 do
        out.push("COST  {items.number(a.cost)} {bar}{" per hit" if a.per_hit else ""}")
    end
    if a.gain > 0 do
        out.push("GAINS  {items.number(a.gain)} {bar} when it lands")
    end
    if a.restock > 0 do
        out.push("RESTOCKS  {items.number(a.restock)} {bar}")
    end
    if a.cooldown > 0 do
        out.push("COOLDOWN  {secs(a.cooldown)}")
    end
    if a.poison > 0 do
        out.push("POISON  {items.number(a.poison)}s ({items.number(roster.POISON_DPS)} health a second)")
    end
    if a.slow > 0 do
        out.push("SLOW  {items.number(a.slow)}s at half speed")
    end
    if a.heal > 0 do
        out.push("HEALS  {items.number(a.heal)} when it lands")
    end
    if a.ragdoll > 0 and a.launch > 0 do
        out.push("RAGDOLL  up into the air, limp; down {items.number(double(a.ragdoll) / 60)}s once they land")
    else if a.ragdoll > 0 do
        out.push("RAGDOLL  knocked off their feet; down {items.number(double(a.ragdoll) / 60)}s")
    else if a.launch > 0 do
        out.push("LAUNCH  throws them up for a juggle")
    end
    if a.kind == roster.KIND_WALL do
        out.push("RAGDOLLS  rising under one, flying or lying, throws it high")
    end
    if a.steal > 0 do
        out.push("STEALS  {items.number(a.steal)} of their super bar")
    end
    if a.pool > 0 do
        out.push("POOL  leaves a puddle for {items.number(a.pool)}s")
    end
    if a.unblockable do
        out.push("UNBLOCKABLE  only a parry stops it")
    end
    if a.counter do
        out.push("COUNTER  hit while winding up, it parries and hits back x{items.number(roster.COUNTER_BONUS)}")
    end
    if a.evade do
        out.push("EVASIVE  cannot be hit while it winds up")
    end
    if a.sturdy do
        out.push("STURDY  cannot be staggered out of it")
    end
    if a.teleport do
        out.push("TELEPORTS  behind them just before it strikes")
    end
    if a.shroud do
        out.push("SHROUD  you vanish as it goes off")
    end
    if a.inject do
        out.push("DOSE  {kit.inject_need} of them make a clone fight for you")
    end
    if a.crater do
        out.push("CRATER  tears the chunk out of the floor")
    end
    if a.recoil > 0 do
        out.push("RECOIL  throws you back")
    end
    if a.kind == roster.KIND_BUFF do
        string[] buffs = ["", "MIST: untouchable and faster", "SECOND WIND: faster, bar refills quicker",
            "BRACED: far less damage, no stagger", "MENDING: heals {items.number(a.heal)} a second",
            "LOADED: the next shot hits far harder", "STILL WATER: every block parries"]
        out.push("BUFF  {buffs[math.clamp(a.buff, 0, 6)]} for {items.number(a.buff_time)}s")
    else if a.kind == roster.KIND_BLINK do
        out.push("BLINK  {items.number(a.blink)} m the way you steer")
    else if a.kind == roster.KIND_CLOAK do
        out.push("CLOAK  invisible while the {bar} lasts; drains {items.number(kit.bar_drain)} a second")
    else if a.kind == roster.KIND_RELOAD do
        out.push("RELOAD  {"every round at once" if kit.reload_all else "one round at a time"}")
    end
    if slot == SLOT_SUPER do
        out.push("Use it inside your own super, once.")
    end
    return out
end

# The facts about a super's place.
function maximum_facts(roster.Maximum m) returns string[]
    string[] out = ["PLACE  {m.place}, for {items.number(m.seconds)}s", "CALL  G with the super bar full"]
    if m.foe_dps > 0 do
        out.push("DRAINS  {items.number(m.foe_dps)} health a second from them{", you drink " + items.number(m.drain * 100) + "%" if m.drain > 0 else ""}")
    end
    if m.foe_poison > 0 do
        out.push("POISONS  them continuously")
    end
    if m.foe_slow do
        out.push("SLOWS  them the whole time")
    end
    if m.foe_vulnerable != 1 do
        out.push("THEY TAKE  {items.number(m.foe_vulnerable * 100)}% damage")
    end
    if m.power != 1 do
        out.push("YOUR DAMAGE  {items.number(m.power * 100)}%")
    end
    if m.armor != 1 do
        out.push("DAMAGE TAKEN  {items.number(m.armor * 100)}%")
    end
    if m.speed != 1 do
        out.push("SPEED  {items.number(m.speed * 100)}%")
    end
    if m.regen > 0 do
        out.push("REGENERATE  {items.number(m.regen)} a second")
    end
    if m.cool_rate > 1 do
        out.push("COOLDOWNS  {m.cool_rate}x as fast")
    end
    if m.bar_regen > 0 do
        out.push("BAR  +{items.number(m.bar_regen)} a second")
    end
    if m.free_bar do
        out.push("FREE  moves cost nothing")
    end
    if m.perfect_guard do
        out.push("GUARD  every block is a parry")
    end
    if m.parry_heal > 0 do
        out.push("PARRIES  heal {items.number(m.parry_heal)}")
    end
    if m.strike.name != "" do
        out.push("BARRAGE  {m.strike.name.lower()} every {items.number(m.strike_every)}s ({items.number(m.strike.damage)} damage)")
    end
    if m.portals do
        out.push("PORTALS  wild doors open everywhere")
    end
    if m.vanish do
        out.push("VANISH  they cannot see you at all")
    end
    if m.randomize do
        out.push("WILD  every move is a random one from the game")
    end
    if m.clones > 0 do
        out.push("DECOYS  {m.clones} mirror copies at all times")
    end
    if m.labs do
        out.push("LAB  more machines; every dose makes a clone")
    end
    if m.jammer do
        out.push("ONLY  inside their super: switches it off")
    end
    return out
end

# "THE QUARANTINE" as "The Quarantine".
function title_case(string words) returns string
    var out = ""
    var start = true
    for k in 0..<words.length do
        var c = words[k..<k + 1]
        out = out + (c.upper() if start else c.lower())
        start = c == " "
    end
    return out
end

# What plays during a fighter's super, by name.
function music_line(roster.Character kit) returns string
    if kit.maximum.silent do
        return "MUSIC  none: only the wind"
    end
    if music.exists(music.super_track(kit.name)) do
        return "MUSIC  {title_case(kit.maximum.name)} theme"
    end
    return "MUSIC  the round's fight track (no theme yet)"
end

function hover_lines(roster.Character kit) returns string[]
    if hover_row == HOVER_PASSIVE do
        string[] lines = ["PASSIVE"]
        for line in wrap_words(kit.blurb, 50) do
            lines.push(line)
        end
        lines.push("HEALTH  {int(kit.health)}    SPEED  {items.number(kit.speed)} m/s")
        if kit.armor != 1 do
            lines.push("ARMOR  takes {int(kit.armor * 100)}% damage")
        end
        if kit.lifesteal > 0 do
            lines.push("LIFESTEAL  {int(kit.lifesteal * 100)}% of damage dealt")
        end
        if kit.poise do
            lines.push("POISE  light hits do not stagger")
        end
        if kit.machine do
            lines.push("MACHINE  cannot be poisoned or slowed")
        end
        if kit.greed != 1 do
            lines.push("GREED  x{items.number(kit.greed)} damage")
        end
        if kit.backstab > 1 do
            lines.push("BACKSTAB  x{items.number(kit.backstab)} from behind")
        end
        if kit.revive > 0 do
            lines.push("UNDEAD  gets up once a round at {int(kit.revive * 100)}%")
        end
        return lines
    else if hover_row == HOVER_BAR do
        string[] lines = [kit.bar_name, kit.bar_note, "MAX  {items.number(kit.bar_max)}    START  {items.number(kit.bar_start)}"]
        if kit.bar_regen > 0 do
            lines.push("REFILLS  {items.number(kit.bar_regen)} a second")
        end
        if kit.parry_gain > 0 do
            lines.push("PARRY  +{items.number(kit.parry_gain)}")
        end
        if kit.bankrupt > 0 do
            lines.push("BANKRUPT  at zero: stunned {secs(kit.bankrupt)}, then bailed out")
        end
        if kit.mech == roster.MECH_HUNTER do
            lines.push("WATCHING  +{items.number(STUDY_WATCH)} a second    HITS  +{items.number(STUDY_HIT)}")
            lines.push("WHEN HIT  -{items.number(STUDY_LOST)}: he loses track of them")
        end
        if kit.quiver > 0 do
            lines.push("ARROW  one at a time: each bolt skill shoots it, then pull another")
        end
        return lines
    else if hover_row == HOVER_MAX do
        string[] lines = ["{kit.maximum.name}  (SUPER)", kit.maximum.note]
        for line in maximum_facts(kit.maximum) do
            lines.push(line)
        end
        lines.push(music_line(kit))
        return lines
    end
    var a = kit.ultimate
    var title = "{kit.ultimate.name}  (THE MOVE INSIDE THE SUPER)"
    if hover_row == SLOT_BASIC do
        a = kit.basics[0]
        string[] lines = ["BASIC CHAIN  (R, AGAIN TO GO ON)"]
        for n, b in kit.basics do
            var dmg = b.damage * double(b.hits) + b.finish
            var cost = "  cost {items.number(b.cost)}" if b.cost > 0 else ""
            lines.push("{n + 1}. {b.name}: {items.number(dmg)} dmg, stun {secs(b.stun)}, reach {items.number(b.reach)} m{cost}")
        end
        if kit.fallback.name != "" do
            lines.push("EMPTY: {kit.fallback.name}, {items.number(kit.fallback.damage)} dmg")
        end
        if kit.quiver > 0 and kit.basics[0].shot == roster.SHOT_ARROW do
            lines.push("Each bolt takes an arrow from the quiver ({kit.quiver}); empty, change it.")
        end
        lines.push("Basic hits do x{items.number(BASIC_SCALE)}, less as SPAM fills; full, it knocks them away.")
        lines.push("A ragdoll in the air is juggled; the third hit throws it clear.")
        return lines
    else if hover_row >= 0 and hover_row < kit.skills.length do
        a = kit.skills[hover_row]
        title = "{hover_row + 1}  {a.name.upper()}"
    end
    string[] lines = [title]
    if a.note != "" do
        lines.push(a.note)
    end
    for line in attack_facts(kit, a, SLOT_SUPER if hover_row == HOVER_ULT else hover_row) do
        lines.push(line)
    end
    return lines
end

function draw_tooltip(roster.Character kit)
    if hover_row == HOVER_NONE or cursor >= cast.length do
        return
    end
    draw_tooltip_for(kit)
end

function draw_tooltip_for(roster.Character kit)
    var lines = hover_lines(kit)
    var w = 0.0
    for line in lines do
        w = math.max(w, ap.measure(line, 8).x)
    end
    w += 16
    var h = double(lines.length) * 10 + 10
    var m = ap.mouse()
    # Chosen by key: beside its row, not wherever the mouse happens to be.
    if key_row == HOVER_BAR and hover_row == HOVER_BAR do
        var r = bar_rect()
        m = ap.Vec2(r.x, r.y + r.h / 2)
    end
    if key_row != HOVER_NONE and key_row == hover_row do
        for n, slot in move_rows() do
            if slot == key_row do
                var r = move_row_rect(n)
                m = ap.Vec2(r.x, r.y + r.h / 2)
            end
        end
    end
    var x = math.clamp(m.x - w - 10, 4.0, VW - w - 4)
    var y = math.clamp(m.y - h / 2, 4.0, VH - h - 4)
    var show = math.min(double(hover_ticks) / 6, 1.0)
    ap.rect(x + 2, y + 2, w, h, ap.BLACK.fade(0.5 * show))
    ap.rect(x, y, w, h, ap.Color(16, 14, 26).fade(0.96 * show))
    ap.rect_lines(x, y, w, h, 1, kit.look.accent.fade(show))
    for n, line in lines do
        var color = ap.Color(200, 196, 220)
        if n == 0 do
            color = kit.look.accent
        else do
            # "LABEL  rest": the label in gold.
            var cut = line.find("  ")
            if cut > 0 and line[0..<cut].upper() == line[0..<cut] do
                label(line[0..<cut], x + 8, y + 6 + double(n) * 10, 8, MAX_GOLD.fade(show))
                label(line[cut..<line.length], x + 8 + ap.measure(line[0..<cut], 8).x, y + 6 + double(n) * 10, 8, color.fade(show))
                continue
            end
        end
        label(line, x + 8, y + 6 + double(n) * 10, 8, color.fade(show))
    end
end

function draw_select_hud()
    var columns = grid_columns()
    var cards = cast.length + 1
    var tint = ap.Color(170, 110, 255) if picking == 0 else ap.Color(255, 120, 90)
    ap.gradient_across(0, 0, VW, 30, ap.BLACK.fade(0.8), ap.BLACK.fade(0.3))
    var size = side_size()
    var slot = pick_step % size
    if randomized() do
        label("BAN FIGHTERS", 16, 8, 16, tint)
        var r = pool_label_rect()
        var hot = r.contains(ap.mouse())
        if hot do
            ap.rect(r.x - 2, r.y - 2, r.w + 4, r.h + 4, MAX_GOLD.fade(0.2))
        end
        label(pool_words(), r.x, r.y, 8, ap.WHITE if hot else MAX_GOLD)
    else if uses_teams() do
        var heading = ""
        if lineup == LINE_TEAM do
            heading = "{"CHOOSE YOUR TEAM" if picking == 0 else "CHOOSE THEIR TEAM"} {slot + 1}/{size}"
        else if picking == 0 do
            heading = "CHOOSE YOUR FIGHTER" if slot == 0 else "CHOOSE YOUR ALLY"
        else do
            heading = "CHOOSE THEIR FIGHTERS {slot + 1}/2"
        end
        label(heading, 16, 8, 16, tint)
        # The team so far, in fighting order.
        var x = 624.0
        var count = slot if picking == 0 else size
        var side = 0
        if picking == 1 and slot > 0 do
            count = slot
            side = 1
        end
        var i = count - 1
        while i >= 0 do
            var kit = cast[teams[side][i]]
            label_right(kit.name, x, 12, 8, kit.look.accent)
            x -= double(kit.name.length) * 8 + 10
            i -= 1
        end
        if count > 0 do
            label_right("YOU:" if side == 0 else "THEM:", x, 12, 8, ap.Color(150, 145, 175))
        end
    else do
        label("CHOOSE YOUR FIGHTER" if picking == 0 else "CHOOSE YOUR OPPONENT", 16, 8, 16, tint)
        if picking == 1 do
            label_right("YOU: {cast[picks[0]].name}", 624, 12, 8, cast[picks[0]].look.accent)
        end
    end
    for i in 0..<cards do
        var r = card_rect(i)
        var x = r.x
        var y = r.y
        var cw = r.w
        var ch = r.h
        var chosen = i == cursor
        var lift = 0.0
        if chosen do
            lift = -1.5 * math.min(double(screen_ticks) / 6, 1.0)
        end
        y += lift
        ap.rect(x - 1, y - 1, cw + 2, ch + 2, ap.BLACK.fade(0.8))
        if i < cast.length do
            var kit = cast[i]
            draw_icon(i, x, y, cw, ch - 10, chosen)
            ap.rect(x, y + ch - 10, cw, 10, ap.Color(18, 16, 30))
            ap.rect(x, y + ch - 10, cw, 1, kit.look.accent if chosen else kit.look.accent.brightness(0.4))
            var name = kit.name if ap.measure(kit.name, 8).x <= cw - 2 else kit.name[0..<math.max(int((cw - 2) / 6), 3)]
            label_centered(name, x + cw / 2, y + ch - 9, 8, ap.WHITE if chosen else ap.Color(150, 145, 175))
            if uses_teams() do
                # Numbered badges on the team being picked; P1 marks on the player's team after.
                for k in 0..<size do
                    var placed = k < pick_step - picking * size
                    if picking == 0 and placed and teams[0][k] == i do
                        ap.rect(x + 2, y + 2, 9, 9, tint)
                        ap.text("{k + 1}", x + 3, y + 3, 8, ap.WHITE)
                    else if picking == 1 and placed and teams[1][k] == i do
                        ap.rect(x + cw - 11, y + 2, 9, 9, tint)
                        ap.text("{k + 1}", x + cw - 10, y + 3, 8, ap.WHITE)
                    end
                    if picking == 1 and teams[0][k] == i do
                        ap.rect(x + 2, y + 2, 14, 9, ap.Color(170, 110, 255))
                        ap.text("P1", x + 3, y + 3, 8, ap.WHITE)
                    end
                end
            else if picking == 1 and i == picks[0] and not randomized() do
                ap.rect(x + 2, y + 2, 14, 9, ap.Color(170, 110, 255))
                ap.text("P1", x + 3, y + 3, 8, ap.WHITE)
            end
            if randomized() and is_banned(i) do
                # Out of the pool: dimmed and struck through.
                ap.rect(x, y, cw, ch, ap.BLACK.fade(0.62))
                ap.line(x + 3, y + 3, x + cw - 3, y + ch - 13, 2, ap.Color(220, 60, 60).fade(0.85))
                ap.line(x + cw - 3, y + 3, x + 3, y + ch - 13, 2, ap.Color(220, 60, 60).fade(0.85))
            end
        else if randomized() do
            ap.gradient(x, y, cw, ch, MAX_GOLD.brightness(0.45), ap.Color(30, 22, 10))
            label_centered("{pool_size()}", x + cw / 2, y + ch / 2 - 14, 16, ap.WHITE if chosen else MAX_GOLD)
            label_centered("FIGHT", x + cw / 2, y + ch - 9, 8, ap.WHITE if chosen else ap.Color(230, 210, 160))
        else do
            ap.gradient(x, y, cw, ch, ap.Color(40, 36, 58), ap.Color(14, 12, 24))
            label_centered("?", x + cw / 2, y + ch / 2 - 14, 24, ap.WHITE if chosen else ap.Color(110, 106, 130))
            label_centered("RANDOM" if cw >= 50 else "RND", x + cw / 2, y + ch - 9, 8, ap.WHITE if chosen else ap.Color(150, 145, 175))
        end
        if chosen do
            var pulse = 0.7 + 0.3 * math.sin(double(ticks) * 0.12)
            ap.rect_lines(x - 2, y - 2, cw + 4, ch + 4, 2, tint.fade(pulse))
        end
    end

    # Everything about the fighter under the cursor.
    var left = 262.0
    var py = select_info_y()
    ap.rect(left - 6, py - 4, 376, 348 - py, ap.BLACK.fade(0.6))
    if cursor >= cast.length and randomized() do
        label("DEAL AND FIGHT", left, py, 24, MAX_GOLD)
        label("{pool_size()} of {cast.length} fighters in the pool ({pool_name()}).", left, py + 30, 8, ap.Color(190, 186, 210))
        label("Pick a fighter's card to ban them or let them back in.", left, py + 42, 8, ap.Color(190, 186, 210))
        label("P or the right shoulder: CLASSIC, EXPANDED, SECOND WAVE, FULL.", left, py + 54, 8, ap.Color(190, 186, 210))
    else if cursor >= cast.length do
        label("RANDOM", left, py, 24, ap.WHITE)
        label("Let the Purgatory decide.", left, py + 30, 8, ap.Color(190, 186, 210))
    else do
        var kit = cast[cursor]
        var look = kit.look
        label(kit.name, left, py, 24, look.accent)
        label(kit.title, left + ap.measure(kit.name, 24).x + 10, py + 14, 8, ap.Color(190, 186, 210))
        label(kit.style.upper(), 624 - ap.measure(kit.style.upper(), 8).x, py + 2, 8, look.accent)
        var bio = wrap_words(kit.bio, 61)
        for n, line in bio do
            if n < 3 do
                label(line, left, py + 25 + double(n) * 9, 8, ap.Color(214, 210, 232) if hover_row != HOVER_PASSIVE else ap.WHITE)
            end
        end
        var sy = py + 56
        draw_stat("HEALTH", roster.rate_health(kit), left, sy, ap.Color(120, 220, 110))
        draw_stat("SPEED", roster.rate_speed(kit), left, sy + 9, ap.Color(120, 190, 255))
        draw_stat("POWER", roster.rate_power(kit), left, sy + 18, ap.Color(255, 120, 90))
        draw_stat("RANGE", roster.rate_range(kit), left, sy + 27, ap.Color(250, 210, 90))
        var mx = left + 162
        var bar_hot = hover_row == HOVER_BAR
        ap.rect(mx, sy, 7, 7, look.accent)
        label(kit.bar_name, mx + 12, sy, 8, ap.WHITE if bar_hot else look.accent)
        label(kit.bar_note, mx, sy + 10, 8, ap.WHITE if bar_hot else ap.Color(150, 145, 175))
        var passive_hot = hover_row == HOVER_PASSIVE
        label("? HOVER, OR PRESS R/1-4/G/B,", mx, sy + 22, 8, ap.Color(110, 106, 130))
        label("  FOR THE NUMBERS BEHIND IT", mx, sy + 31, 8, ap.Color(110, 106, 130))
        # The moves: the chain, four skills with their cooldowns, the super.
        var my = select_moves_y()
        var grey = ap.Color(150, 145, 175)
        for n, slot_kind in move_rows() do
            var r = move_row_rect(n)
            if hover_row == slot_kind do
                ap.rect(r.x, r.y, r.w, r.h, look.accent.fade(0.18))
                ap.rect(r.x, r.y, 2, r.h, look.accent)
            end
        end
        var chain = ""
        for n, a in kit.basics do
            chain = a.name if n == 0 else "{chain} > {a.name}"
        end
        label("R", left, my, 8, look.accent)
        label(chain, left + 14, my, 8, ap.WHITE)
        for n, a in kit.skills do
            var y = my + 11 * double(n + 1)
            label("{n + 1}", left, y, 8, look.accent)
            label(a.name, left + 14, y, 8, ap.WHITE)
            var wait = "{a.cooldown // 60}s" if a.cooldown >= 60 else "-"
            label(wait, left + 106, y, 8, look.accent)
            label(a.note, left + 130, y, 8, grey)
        end
        label("G", left, my + 55, 8, ap.Color(255, 90, 90))
        label(kit.maximum.name, left + 14, my + 55, 8, MAX_GOLD)
        label(kit.maximum.note, left + 130, my + 55, 8, grey)
        label("G", left, my + 66, 8, ap.Color(255, 90, 90))
        label(kit.ultimate.name, left + 14, my + 66, 8, ap.WHITE)
        label(kit.ultimate.note, left + 130, my + 66, 8, grey)
    end
    label("WASD / CLICK  MOVE   ENTER  {"BAN / FIGHT" if randomized() else "PICK"}   ESC  BACK", 16, 346, 8, ap.Color(110, 106, 130))
    var vr = models_label_rect()
    var models_hot = vr.contains(ap.mouse())
    if models_hot do
        ap.rect(vr.x, vr.y, vr.w, vr.h, ap.Color(60, 50, 20).fade(0.8))
    end
    label(models_words(), vr.x + 2, vr.y + 2, 8, ap.Color(255, 206, 70) if models_hot else ap.Color(150, 145, 175))
    var hard = [ap.Color(120, 220, 110), ap.Color(250, 210, 90), ap.Color(255, 110, 90)]
    label("TAB  CPU DIFFICULTY: {LEVEL_NAMES[level]}", 16, 326, 8, hard[level])
    var m = ap.mouse()
    var mr = mode_label_rect()
    var mode_hot = mr.contains(m)
    if mode_hot do
        ap.rect(mr.x, mr.y, mr.w, mr.h, ap.Color(60, 50, 20).fade(0.8))
    end
    label("M  MODE: {mode_title()}  v", mr.x + 2, mr.y + 2, 8,
        ap.Color(255, 206, 70) if not plain_setup() or mode_hot else ap.Color(170, 165, 190))
    var ir = items_label_rect()
    var items_hot = ir.contains(m)
    if items_hot do
        ap.rect(ir.x, ir.y, ir.w, ir.h, ap.Color(30, 60, 30).fade(0.8))
    end
    label("I  ITEMS ({count_on()}/{item_defs.length}): {ITEM_MODE_NAMES[items_mode]}", ir.x + 2, ir.y + 2, 8,
        ap.Color(110, 106, 130) if items_mode == ITEMS_OFF and not items_hot else ap.Color(150, 225, 120))
    if cursor < cast.length and not menu_open() do
        draw_tooltip(cast[cursor])
    end
    if mode_menu do
        draw_mode_menu()
    end
    if item_menu do
        draw_item_menu()
    end
end

function draw_result_hud()
    var champion = fighters[winner]
    var fade = math.min(double(screen_ticks) / 30, 1.0)
    ap.gradient(0, 0, VW, 110, ap.BLACK.fade(0.8 * fade), ap.BLACK.fade(0))
    ap.gradient(0, 250, VW, 110, ap.BLACK.fade(0), ap.BLACK.fade(0.85 * fade))
    label_centered("{champion.kit.name} WINS", 320, 28, 32, champion.kit.look.accent.fade(fade))
    label_centered("YOU TAKE THE MATCH" if winner == 0 else "THE PURGATORY KEEPS YOU", 320, 68, 8,
        ap.Color(190, 186, 210).fade(fade))
    label_centered("{fighters[0].wins} - {fighters[1].wins}", 320, 284, 16, ap.WHITE.fade(fade))
    label_centered("ENTER  REMATCH        ESC  CHARACTER SELECT", 320, 320, 8, ap.Color(170, 165, 190).fade(fade))
end

# --- A frame -------------------------------------------------------------------------------------

# How much color the 3D scene is drained of (PHANTOM's wood).
function mono_now() returns double
    if screen == SCREEN_SELECT do
        return 1.0 if select_world >= 0 and cast[select_world].maximum.mono else 0.0
    end
    if screen == SCREEN_TITLE or max_owner < 0 do
        return 0
    end
    if merge_owner >= 0 do
        return 0.5 if max_def.mono or merge_def.mono else 0.0
    end
    return 1.0 if max_def.mono else 0.0
end

function render()
    var sw = scene_w()
    var sh = scene_h()
    if screen == SCREEN_SELECT do
        render_icons()
    end
    render_closeups()
    ap.draw_to(scene)
    ap.clear(sky_now)
    set_lights()
    ap.listen_from(camera)
    render_alpha = ap.alpha()
    if screen == SCREEN_PURGATORY do
        ap.clear(purgatory.sky())
        set_lights()
        ap.scene_3d(purgatory.camera, purgatory.draw_scene, 16)
        purgatory.after_scene(sw, sh)
    else if screen == SCREEN_TITLE do
        ap.scene_3d(camera, draw_title_scene, 16)
    else if screen == SCREEN_SELECT do
        ap.scene_3d(camera, draw_select_scene, 8)
    else do
        ap.scene_3d(drawn_camera(), draw_fight_scene, 16)
        # Where the floating numbers sit on the HUD, while the camera is still set.
        for f in floaters do
            var at = ap.project(between(f.prev, f.position, f.seen))
            f.screen = ap.Vec2(at.x * double(VIEW_W) / sw, at.y * double(VIEW_H) / sh)
        end
        for m in minions do
            var at = ap.project(drawn_at(m) + (m.body.top() - m.body.position) + ap.Vec3(0, 0.35, 0))
            m.screen = ap.Vec2(at.x * double(VIEW_W) / sw, at.y * double(VIEW_H) / sh)
        end
        for f in fighters do
            var at = ap.project(drawn_at(f) + (f.body.top() - f.body.position) + ap.Vec3(0, 0.35, 0))
            f.screen = ap.Vec2(at.x * double(VIEW_W) / sw, at.y * double(VIEW_H) / sh)
        end
    end

    ap.draw_to(post)
    ap.clear(ap.BLACK)
    filter.set_vec2("u_grid", ap.Vec2(sw, sh))
    filter.set("u_levels", 28)
    filter.set("u_mono", mono_now())
    ap.use_shader(filter)
    ap.sprite_part(scene.texture, ap.Rect(0, 0, sw, sh), ap.Rect(0, 0, double(VIEW_W), double(VIEW_H)))
    ap.no_shader()
    if screen == SCREEN_TITLE do
        draw_title_hud()
    else if screen == SCREEN_PURGATORY do
        purgatory.draw_hud()
    else if screen == SCREEN_SELECT do
        draw_select_hud()
    else if screen == SCREEN_FIGHT do
        draw_fight_hud()
    else do
        draw_result_hud()
    end

    ap.draw_to_window()
    ap.clear(ap.BLACK)
    ap.sprite(post.texture, 0, 0)
end

# Started from the loading screen (./play): the file to create once this window is up, so the
# loading screen can close; "" when started any other way.
function loader_ready_path() returns string
    try
        return os.env("PVS_READY")
    catch e
        return ""
    end
end
var ready_path = loader_ready_path()
if ready_path != "" do
    # The loading screen showed the title already: no fade in again.
    screen_ticks = 60
end

while ap.frame() do
    # Text typed is read once, by the next tick, however many ticks the frame runs. A frame that
    # runs none (the display faster than the ticks) keeps it for the next frame, not losing it.
    typed_now = typed_now + ap.typed()
    if hot.enabled() and ap.frame_count() % 60 == 0 and screen != SCREEN_FIGHT do
        # Running with --hot: custom_items.fw may have changed under us.
        gather_items()
    end
    while ap.tick(fight_rate() if screen == SCREEN_FIGHT else 60) do
        update()
        typed_now = ""
    end
    render()
    if ready_path != "" do
        try
            fs.write(ready_path, "")
        catch e
        end
        ready_path = ""
    end
end
ap.close()
