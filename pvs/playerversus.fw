# PLAYER VERSUS: a testing prototype. One arena in the Purgatory, a character select, and
# a fight against the CPU.
#
#     pulley run start        (or: flywheel playerversus.fw)
#     flywheel --build playerversus.fw -O3 -o playerversus
#
#     W A S D    move (W is toward the opponent)      R  basic attack: press again to chain
#     F          block; tap just before a hit to parry  1 2 3 4  skills, each on a cooldown
#     Q          dash                                   G  super, when the red bar is full
#     E          (2v2) switch which opponent you face   ESC  pause
#     F6         admin panel: fill or call supers, heal, knock out, items, infinite health...
# On the select screen: M opens the list of game modes, I the item menu, TAB the CPU difficulty;
# the mouse over a move shows its numbers.
#
# A basic attack that lands can be cancelled into a skill, and a skill that lands into the
# super: that is a combo. Each hit of a combo does a little less and stuns a little shorter.
#     F1 debug   F2 pixel size (1x, 2x, 4x)   F3 what the CPU does   F4 refill health and bars
#     F5 CPU difficulty
#
# The fighters are in roster.fw, their bodies and poses in puppet.fw, the items in items.fw (and
# the players' own in custom_items.fw), the soundtrack in music.fw. The 3D scene is drawn small and
# scaled up through a dithering shader: the pixel filter. There is no screen shake and nothing
# flashes.
import aperture as ap
import math
import fs
import os
import hot
import "roster.fw" as roster
import "puppet.fw" as puppet
import "music.fw" as music
import "items.fw" as items
import "save.fw" as save
import "editor.fw" as editor
import "item_api.fw" as api
import "custom_items.fw" as custom
import "purgatory_mode.fw" as purgatory   # PURGATORY, or its stub (see loader.fw)

const int VIEW_W = 640               # the HUD's resolution; the window scales it up
const int VIEW_H = 360
const double VW = 640
const double VH = 360
const double ARENA = 10.5            # the radius fighters can walk to
# How a match is set up: three toggles in the mode menu (M on the select screen).
# PLAYERS: 1v1, or 2v2 (`duo`). LENGTH: a single round, best of N (first to (N+1)/2; best of 5 is
# played as five slots, two each side and the finale in the middle), or endless (nobody ever takes
# the match). FIGHTERS: one each; a team (every round lost sends in the next); random (everyone is
# dealt a new fighter every round); or a random team (a team dealt instead of picked; in Endless
# it is as big as you like and may hold the same fighter twice).
const int LEN_SINGLE = 0
const int LEN_BEST = 1
const int LEN_ENDLESS = 2
const int LINE_ONE = 0
const int LINE_TEAM = 1
const int LINE_RANDOM = 2
const int LINE_RANDOM_TEAM = 3
const int[] BEST_OFS = [3, 5, 7, 9]
const int TEAM_OF_MIN = 2            # an Endless random team's size, from...
const int TEAM_OF_MAX = 6            # ...to
# Items: before every round both sides, only the side behind on rounds, or nobody picks one of two.
const int ITEMS_ON = 0
const int ITEMS_LOSING = 1
const int ITEMS_OFF = 2
const string[] ITEM_MODE_NAMES = ["ENABLED", "LOSING ONLY", "DISABLED"]
# The deciding round of a best of 5 (two rounds each) is fought on double health.
const double DECIDER_HEALTH = 2.0
# Whoever is behind on rounds gets a little help for each round they are behind.
const double UNDERDOG_DAMAGE = 0.06  # more damage dealt
const double UNDERDOG_GUARD = 0.05   # less damage taken
const double UNDERDOG_SUPER = 0.3    # faster super bar
# The pace of a fight. Everything in it is worked out in ticks of 1/60 of a second (frame data,
# stun, movement, cutscenes), and the fight runs FIGHT_PACE times slower than that: at
# fight_rate() ticks a real second instead of 60. 1.0 is the old pace; 1.35 is 35% slower. The
# round clock still counts real seconds. Menus always run at 60. FIGHT_PACE is the default; the
# admin panel's GAME SPEED changes it, and the save file remembers the choice.
const double FIGHT_PACE = 1.35
const double[] FIGHT_PACES = [2.0, 1.75, 1.5, 1.35, 1.2, 1.1, 1.0, 0.85, 0.7]   # GAME SPEED, slowest first
const int MAX_CUT_TICKS = 170        # the maximum's cutscene: nobody moves or can be hurt
const int MAX_HIT = 90               # ...when it goes off and the arena starts to crumble...
const int MAX_SWAP = 140             # ...and when the new place takes over
const int CUT_SUPER = 0              # what a cutscene is for: one fighter's super...
const int CUT_MERGE = 1              # ...a second super inside the first: the two places merge...
const int CUT_JAM = 2                # ...or TELEMAN switching someone's super off
const int MERGE_TICKS = 260          # longer than a super: both faces get their moment
const int JAM_TICKS = 64
const int JAM_CLICK = 12             # the set is switched off...
const int JAM_DARK = 32              # ...and is dark: the super is over
const double SUPER_FOE_GAIN = 2      # the super bar fills this much faster inside someone else's super
const double MINION_HEALTH = 0.25    # a clone has this share of the real fighter's health...
const double MINION_POWER = 0.3      # ...and hits this much as hard
const int MIRROR_REFORM = 150        # ticks between new copies in the HALL OF MIRRORS
const double MIRROR_REACH = 2.6      # how close SHATTER must find the opponent to a copy
const int WALL_TICKS = 8 * 60        # how long an EARTH WALL stands
const int WILD_LIFE = 30 * 60        # how long a wild portal stays open
const int MAX_TICKS = 30 * 60        # how long a super's place lasts before the arena comes back
const ap.Color MAX_GOLD = ap.Color(255, 206, 70)
# 2v2: you and a CPU ally against two CPUs. A side is out when both of its fighters are down.
const double DUO_HEALTH = 0.8        # everyone's health in a 2v2, so four-way fights do not drag
const int ROUND_SECONDS = 180
const int PARRY_TICKS = 9            # a block this fresh is a parry
const double DASH_SPEED = 13
const int DASH_TICKS = 10
const int DASH_COOLDOWN = 38

const int SCREEN_TITLE = 0
const int SCREEN_SELECT = 1
const int SCREEN_FIGHT = 2
const int SCREEN_RESULT = 3
const int SCREEN_PURGATORY = 4       # the second mode (purgatory.fw)

