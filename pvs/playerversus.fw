# PLAYER VERSUS: a testing prototype. One arena in the Purgatory, a character select, and
# a fight against the CPU.
#
#     pulley run start        (or: flywheel playerversus.fw)
#     flywheel --build playerversus.fw -O3 -o playerversus
#
#     W A S D    move (W is toward the opponent)      R  basic attack: press again to chain
#     F          block; tap just before a hit to parry  1 2 3 4  skills, each on a cooldown
#     Q          dash                                   G  super, when the red bar is full
#     ESC        pause                                  TAB (on the select screen) CPU difficulty
#
# A basic attack that lands can be cancelled into a skill, and a skill that lands into the
# super: that is a combo. Each hit of a combo does a little less and stuns a little shorter.
#     F1 debug   F2 pixel size (1x, 2x, 4x)   F3 what the CPU does   F4 refill health and bars
#     F5 CPU difficulty
#
# The fighters are in roster.fw, their bodies and poses in puppet.fw. The 3D scene is drawn
# small and scaled up through a dithering shader: the pixel filter. There is no screen shake
# and nothing flashes.
import aperture as ap
import math
import "roster.fw" as roster
import "puppet.fw" as puppet

const int VIEW_W = 640               # the HUD's resolution; the window scales it up
const int VIEW_H = 360
const double VW = 640
const double VH = 360
const double ARENA = 10.5            # the radius fighters can walk to
const int ROUNDS_TO_WIN = 2          # in the classic mode
# Match modes. CLASSIC: first to 2 rounds. FINALE: five slots, two on each side and the finale in the
# middle; fill your two, then win once more to take the middle and the match (3 to 5 rounds).
const int MODE_CLASSIC = 0
const int MODE_FINALE = 1
# SHOWDOWN: played like FINALE, but each side picks a team of three, and every round lost sends in
# the next fighter of the team (rounds lost 0, 1, 2 fight as picks 1, 2, 3).
const int MODE_SHOWDOWN = 2
# ENDLESS: round after round, nobody ever takes the match. RANDOM ENDLESS: the same, but both sides
# are dealt a new random fighter every round.
const int MODE_ENDLESS = 3
const int MODE_RANDOM = 4
# Items: before every round both sides, only the side behind on rounds, or nobody picks one of two.
const int ITEMS_ON = 0
const int ITEMS_LOSING = 1
const int ITEMS_OFF = 2
const string[] ITEM_MODE_NAMES = ["ENABLED", "LOSING ONLY", "DISABLED"]
const int TEAM_SIZE = 3
# The deciding round (two rounds each in FINALE or SHOWDOWN) is fought on double health.
const double DECIDER_HEALTH = 2.0
# Whoever is behind on rounds gets a little help for each round they are behind.
const double UNDERDOG_DAMAGE = 0.06  # more damage dealt
const double UNDERDOG_GUARD = 0.05   # less damage taken
const double UNDERDOG_SUPER = 0.3    # faster super bar
const int MAX_CUT_TICKS = 170        # the maximum's cutscene: nobody moves or can be hurt
const int MAX_HIT = 90               # ...when it goes off and the arena starts to crumble...
const int MAX_SWAP = 140             # ...and when the new place takes over
const int CUT_SUPER = 0              # what a cutscene is for: one fighter's super...
const int CUT_MERGE = 1              # ...a second super inside the first: the two places merge...
const int CUT_JAM = 2                # ...or TELEMAN switching someone's super off
const int MERGE_TICKS = 200
const int JAM_TICKS = 64
const int JAM_CLICK = 12             # the set is switched off...
const int JAM_DARK = 32              # ...and is dark: the super is over
const double SUPER_FOE_GAIN = 2      # the super bar fills this much faster inside someone else's super
const double MINION_HEALTH = 0.25    # a clone has this share of the real fighter's health...
const double MINION_POWER = 0.3      # ...and hits this much as hard
const int MIRROR_REFORM = 150        # ticks between new copies in the HALL OF MIRRORS
const double MIRROR_REACH = 2.6      # how close SHATTER must find the opponent to a copy
const int WALL_TICKS = 8 * 60        # how long an EARTH WALL stands
const int WILD_LIFE = 30 * 60        # how long a wild portal stays open
const int MAX_TICKS = 30 * 60        # how long a super's place lasts before the arena comes back
const ap.Color MAX_GOLD = ap.Color(255, 206, 70)
const string[] MODE_NAMES = ["BEST OF 3", "BEST OF 5", "SHOWDOWN (TEAMS OF 3)", "ENDLESS", "RANDOMIZED ENDLESS"]
const int ROUND_SECONDS = 99
const int PARRY_TICKS = 9            # a block this fresh is a parry
const double DASH_SPEED = 13
const int DASH_TICKS = 10
const int DASH_COOLDOWN = 38

const int SCREEN_TITLE = 0
const int SCREEN_SELECT = 1
const int SCREEN_FIGHT = 2
const int SCREEN_RESULT = 3

const int STATE_IDLE = 0
const int STATE_ATTACK = 1
const int STATE_BLOCK = 2
const int STATE_HURT = 3
const int STATE_DOWN = 4
const int STATE_DASH = 5
const int STATE_RELOAD = 6

const int PHASE_INTRO = 0
const int PHASE_FIGHT = 1
const int PHASE_OVER = 2
const int PHASE_DRAFT = 3            # before the intro: picking items

const int SLOT_BASIC = -1            # which of a fighter's moves: the basic chain, skills 0..3,
const int SLOT_SUPER = 4             # or the super
const double LOB_GRAVITY = 18
const int COMBO_GRACE = 40           # ticks without being hit before a combo on them is over
const int COMBO_LIMIT = 7            # the move in a row that makes the victim break free
const double BASIC_SCALE = 0.9       # what a basic attack's damage is multiplied by
const double SPAM_PER_HIT = 0.17     # how much of the SPAM bar one landed basic attack fills...
const double SPAM_SECONDS = 10       # ...and how long a full bar takes to drain away
const double SPAM_STALE = 0.5        # share of a basic attack's damage lost with the bar full
const int SPAM_STUN = 50             # ticks the spammer is left open when the bar fills
const int BLOCKED_STUN = 16          # ticks a blocked basic attack leaves its user staggered
const double[] LEVEL_READ = [0.2, 0.5, 0.45]    # extra chance the CPU blocks someone mashing basics
const int[] LEVEL_READ_SPEED = [3, 8, 9]         # ticks sooner it reacts to them

# How good the CPU is. Each list is EASY, NORMAL, HARD.
const string[] LEVEL_NAMES = ["EASY", "NORMAL", "HARD"]
const int[] LEVEL_WAIT = [75, 42, 20]            # ticks it rests between actions, at least...
const int[] LEVEL_WAIT_MORE = [70, 50, 36]       # ...and up to this many more
const int[] LEVEL_REACT = [17, 11, 7]            # ticks before it can react to a move, at least
const double[] LEVEL_BLOCK = [0.15, 0.35, 0.55]  # how often it blocks what it sees coming
const double[] LEVEL_PARRY = [0.0, 0.1, 0.25]    # how many of those blocks are timed parries
const double[] LEVEL_COMBO = [0.15, 0.45, 0.75]  # how often it follows a hit up
const double[] LEVEL_SKILL = [0.2, 0.35, 0.5]    # how readily it uses a skill that fits
const double[] LEVEL_DAMAGE = [0.7, 0.85, 1.0]   # what its hits are worth

const int CPU_FIGHTS = 0
const int CPU_STANDS = 1
const int CPU_BLOCKS = 2

class Fighter
    int id
    roster.Character kit
    ap.Body body
    roster.Attack move               # the attack being performed
    bool cpu = false
    double heading = 0               # degrees around y; 0 faces +z
    double health = 100
    double shown_health = 100        # trails behind health on the HUD
    double bar = 0
    int state = STATE_IDLE
    int frame = 0                    # ticks in this state
    int move_hits = 1
    int hits_done = 0
    int serial = 0                   # counts attacks, so the CPU reacts to each once
    int stun = 0
    int stun_total = 1
    int block_age = 0
    double poison = 0                # seconds left
    bool cloaked = false
    bool ambush = false              # the attack began unseen
    double fade = 1                  # 1 visible to 0 unseen
    int dash_cooldown = 0
    ap.Vec3 dash_way = ap.Vec3(0, 0, 1)
    ap.Vec3 knock = ap.Vec3(0, 0, 0)
    double cycle = 0
    double moving = 0
    double settle = 1                # 0..1 back in their own idle stance
    puppet.Pose pose = puppet.Pose() # how they stand right now, eased toward what they are doing
    int slot = SLOT_BASIC            # which move `move` is
    int chain = 0                    # how far along the basic chain
    bool connected = false           # the move has touched the opponent, so it can be cancelled
    bool blocked = false             # the move was blocked: the chain stops there
    bool empowered = false           # a counter that was set off
    int[] cooldowns = [0, 0, 0, 0]   # ticks until each skill is ready
    double energy = 0                # the super bar; kept from round to round
    int taken = 0                    # hits taken without a chance to recover: the combo on them
    int combo = 0                    # the combo they are dealing, for the HUD...
    double combo_damage = 0
    int combo_show = 0               # ...and the ticks it stays up
    int hurt_side = 0
    int buff = 0
    double buff_time = 0
    double slow = 0                  # seconds left at half speed
    ap.Vec3 wish = ap.Vec3(0, 0, 0)  # where the stick points
    bool cpu_combo = true            # the CPU means to follow this hit up
    double buff_rate = 0             # health a second from a mending buff
    int warp_cool = 0                # ticks before a portal will take them again
    int pressure = 0                 # separate moves that have hit them without a real break
    int hit_serial = -1              # the attacker's move that hit them last
    int since_hit = 999              # ticks since they were last hit
    int safe = 0                     # ticks they cannot be hit: just broken free
    double spam = 0                  # 0..1: basic attacks landed lately; full, and the opponent breaks free
    int wins = 0
    int pick = 0                     # the cast index this fighter was built from
    double max_health = 100          # the kit's health, doubled in a deciding round
    bool encore_used = false         # the old super move, once during your own super
    bool minion = false              # a clone fighting for someone else (BOB): id is their side
    double power_scale = 1           # damage dealt is multiplied by this
    bool copy_locked = false         # CAT: skill 1 stays as it is
    roster.Attack[] kept_basics = [] # CAT: its own moves, put away while its super randomizes them
    roster.Attack[] kept_skills = []
    roster.Attack kept_ultimate = roster.Attack("")
    int arm = 0                      # COMBATANT: which weapon of the arsenal is in hand
    int[] arm_cools = []             # ...and the cooldowns of the skills of the ones put away
    int broke_ticks = 0              # MONOPOLIST: ticks of bankruptcy left
    int injects = 0                  # BOB: doses landed toward the next clone
    int clone_cool = 0               # BOB: ticks before the machine can make another clone
    bool revived = false             # DISMANTLE: has already got back up this round
    int decoy = -1                   # which of the opponent's mirror copies they are going after (-1: the real one)
    ap.Vec2 screen = ap.Vec2(-100, -100)  # where a clone's health bar goes on the HUD
    # What the CPU is thinking.
    int think = 0
    int cool = 30
    ap.Vec3 plan = ap.Vec3(0, 0, 0)
    double strafe = 1
    int seen_serial = 0
    int block_wait = 0
    int block_hold = 0
    bool block_parry = false
    ap.Vec3 last_seen = ap.Vec3(0, 0, 0)
end

# What a fighter wants to do this tick, from the keyboard or from the CPU.
class Intent
    ap.Vec3 wish = ap.Vec3(0, 0, 0)  # where to walk, in the world
    bool basic = false
    int skill = 0                    # 1..4, or 0 for none
    bool ultimate = false
    bool block = false
    bool sloppy = false              # a block too clumsy to count as a parry
    bool dash = false
end

class Shot
    int owner
    roster.Attack attack
    ap.Vec3 position
    ap.Vec3 velocity
    double life = 2.5
    double bonus = 0                 # extra damage: the last shot of a volley
    double scale = 1                 # damage multiplier: a loaded shot
    bool warped = false              # has been through a portal
    double age = 0
end

# A patch of floor that hurts whoever the owner is fighting.
class Hazard
    int owner
    ap.Vec3 position
    double radius
    double life
end

# One end of a pair of doors. A fighter's two newest connect.
class Portal
    int owner
    ap.Vec3 position
    int born
end

# A ray of light that hit the moment it was fired, fading.
class Beam
    ap.Vec3 from
    ap.Vec3 to
    ap.Color color
    double width = 0.12
    double life = 0.16
    double span = 0.16
end

# A place the arena can become: the same stones under a different sky.
class Area
    string name
    ap.Color sky
    ap.Color ambient
    ap.Color sun
    ap.Color lamp                    # the light hanging over the middle
    ap.Color stone
    ap.Color pillar
    ap.Color far                     # the slabs out in the dark
    ap.Color rim
    ap.Color glow
    ap.Color floor                   # a tint over the painted floor
    ap.Color mote                    # what drifts in the air...
    double drift                     # ...and how fast it rises (or falls)
end

class Spark
    ap.Vec3 position
    ap.Vec3 velocity
    ap.Color color
    double life = 0.5
    double span = 0.5
    double size = 0.08
    double gravity = 6
    double stretch = 0               # over 0: a streak this long, drawn along its travel
end

class Ring
    ap.Vec3 position
    ap.Color color
    double grow = 8                  # meters a second
    double span = 0.4
    bool ball = false                # a swelling sphere instead of a ring on the ground
    double radius = 0.2
    double life = 0.4
end

# A fading copy of a fighter left behind by a very fast move.
class Ghost
    roster.Look look
    puppet.Pose pose
    ap.Vec3 position
    double heading
    double life = 0.3
    double span = 0.3
end

# Something left on the floor for a while: a scorch, a puddle of venom.
class Mark
    ap.Vec3 position
    ap.Color color
    double radius
    double life
    double span
    double strength = 0.6
    bool bubbles = false
end

# A sound that plays a few ticks from now.
class Cue
    ap.Sound sound
    ap.Vec3 position
    int wait
    double volume = 0.5
    double pitch = 1
end

class Floater
    ap.Vec3 position
    string words
    ap.Color color
    double life = 0.9
    ap.Vec2 screen = ap.Vec2(-100, -100)
end

class Pillar
    ap.Vec3 base
    double height
end

# A dagger lying on the floor, waiting to be picked up by whoever threw it (COMBATANT).
class Pickup
    int owner
    ap.Vec3 position
    double yaw
end

# Something standing on the arena floor that fighters and shots run into.
const int PROP_WALL = 0              # CARBON's earth wall
const int PROP_MACHINE = 1           # BOB's cloning machine
class Prop
    int kind
    int owner
    ap.Vec3 position
    double height
    int life                         # ticks left; -1 for the whole round
    int born
    double yaw = 0
    bool super_only = false          # put up by a super, taken down with it
end
Prop[] props = []

# A mirrored copy of a fighter (MIRRORMAN): it stands where they would be if the arena were turned
# `angle` degrees around their opponent, does whatever they do, and breaks when touched.
class Mirror
    int owner
    double angle
    int life
    int born
end

# --- Window, canvases, the pixel filter ------------------------------------------------------

ap.open("PLAYER VERSUS", 1280, 720, ap.RESIZABLE)
ap.virtual_size(VIEW_W, VIEW_H)
ap.shaking(false)

var pixel = 1                        # the 3D scene is drawn this many times smaller (F2)
var scene = ap.Canvas(VIEW_W // pixel, VIEW_H // pixel)
var post = ap.Canvas(VIEW_W, VIEW_H)
var filter = ap.Shader("uniform vec2 u_grid; uniform float u_levels; uniform float u_mono; float b2(vec2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); } float b4(vec2 a) { return b2(0.5 * a) * 0.25 + b2(a); } vec4 effect(vec4 color, sampler2D image, vec2 uv) { vec2 cell = floor(uv * u_grid); vec2 at = (cell + 0.5) / u_grid; vec3 c = texture(image, at).rgb; c = mix(c, vec3(dot(c, vec3(0.3, 0.59, 0.11))), u_mono); vec2 v = at - 0.5; c *= 1.0 - dot(v, v) * 0.7; c = floor(c * u_levels + 0.5 + (b4(cell) - 0.5) * 0.6) / u_levels; return vec4(c, 1.0) * color; }")

function scene_w() returns double
    return double(VIEW_W // pixel)
end
function scene_h() returns double
    return double(VIEW_H // pixel)
end

# --- The arena ---------------------------------------------------------------------------------

const ap.Color VOID_COLOR = ap.Color(7, 6, 14)
ap.shadows(true, 2048, 0.8)
ap.ambient(ap.Color(74, 72, 110))
ap.sun(ap.Vec3(-0.35, -1, -0.3), ap.Color(190, 196, 240))
ap.fog(VOID_COLOR, 16, 58)

var rig = puppet.make_rig()
var box = rig.box
var ball = rig.ball
var disc_side = ap.cylinder(ARENA + 1, 1.4, 40)
var disc = ap.cylinder(1, 1, 24)
var hoop = ap.torus(0.8, 0.07, 20, 8)
var floor_mesh = ap.plane((ARENA + 1) * 2, (ARENA + 1) * 2)

# The floor: rings of stone slabs around a sigil, painted here and cut to a circle.
function paint_floor(int x, int y) returns ap.Color
    var dx = (double(x) - 255.5) / 256
    var dy = (double(y) - 255.5) / 256
    var r = math.sqrt(dx * dx + dy * dy)
    if r > 1 do
        return ap.TRANSPARENT
    end
    var turn = (math.atan2(dy, dx) + math.PI) / (2 * math.PI)
    var band = int(r / 0.125)
    var slabs = 5 + band * 5
    var along = turn * double(slabs) + double(band) * 0.37
    var slab = int(along)
    var shade = double((band * 73 + slab * 151) % 17) / 17
    var across = r / 0.125 - double(band)
    var edge = along - double(slab)
    var base = ap.Color(52, 48, 70).lerp(ap.Color(74, 68, 96), shade)
    if across < 0.07 or edge * 6.283 * r / double(slabs) < 0.008 do
        base = ap.Color(24, 22, 36)
    end
    if r > 0.93 do
        base = ap.Color(96, 86, 130) if r < 0.965 else ap.Color(40, 36, 58)
    end
    if r < 0.125 do
        base = ap.Color(40, 34, 62)
        if r > 0.085 and r < 0.105 do
            base = ap.Color(150, 110, 230)
        end
        if math.abs(dx) < 0.012 or math.abs(dy) < 0.012 do
            base = ap.Color(150, 110, 230)
        end
    end
    return base
end
var floor_look = ap.Material(ap.WHITE, 0, 0.9, ap.make_texture(512, 512, paint_floor))
floor_look.cutoff(0.5)
var stone = ap.Material(ap.Color(46, 42, 62), 0, 0.95)
var pillar_stone = ap.Material(ap.Color(70, 66, 92), 0, 0.9)
var monolith_look = ap.Material(ap.Color(34, 30, 54), 0, 1)
var rim_look = ap.Material(ap.Color(60, 40, 110), 0, 0.5)
rim_look.glow(ap.Color(140, 90, 255), 1.6)

Pillar[] pillars = [
    Pillar(ap.Vec3(7.2, 0, 3.4), 4.6),
    Pillar(ap.Vec3(-7.6, 0, 2.2), 2.1),
    Pillar(ap.Vec3(-4.4, 0, -6.8), 4.6),
    Pillar(ap.Vec3(5.2, 0, -6.2), 3.2),
    Pillar(ap.Vec3(0.6, 0, 8.4), 1.3)
]

# Slabs standing far out in the dark, drawn with one call.
ap.Mat4[] monoliths = []
while monoliths.length < 70 do
    var angle = ap.random(0, 360)
    var far = ap.random(20, 52)
    var tall = ap.random(4, 22)
    monoliths.push(ap.transform(ap.Vec3(math.sin(angle) * far, tall / 2 - ap.random(3, 9), math.cos(angle) * far),
        ap.Vec3(ap.random(-6, 6), ap.random(0, 90), ap.random(-6, 6)), ap.Vec3(ap.random(1.5, 5), tall, ap.random(1.5, 5))))
end
ap.Mat4[] rim_lamps = []
for i in 0..<40 do
    var around = double(i) * 9
    rim_lamps.push(ap.transform(forward_of(around) * (ARENA + 0.72) + ap.Vec3(0, 0.05, 0), ap.Vec3(0, around, 0),
        ap.Vec3(0.9, 0.1, 0.16)))
end

# Souls drifting up out of the dark around the arena.
ap.Vec3[] souls = []
while souls.length < 46 do
    var around = ap.random(0, 6.283)
    var out = ap.random(3, 26)
    souls.push(ap.Vec3(math.sin(around) * out, ap.random(-2, 12), math.cos(around) * out))
end

var pillars_up = true                # false once a maximum has brought them down
function prop_half(Prop pr) returns double
    return 0.6 if pr.kind == PROP_WALL else 0.65
end
function build_world() returns ap.World
    var w = ap.World()
    w.add_box(ap.Vec3(-40, -2, -40), ap.Vec3(40, 0, 40))
    # A wall nobody can see keeps fighters on the disc.
    var wall = w.group()
    for i in 0..<32 do
        var around = double(i) * 360 / 32
        w.add_cube(forward_of(around) * (ARENA + 0.5) + ap.Vec3(0, 4, 0),
            ap.Vec3(2 * math.PI * (ARENA + 1) / 32 + 0.3, 8, 1), ap.Vec3(0, around, 0), wall)
    end
    if pillars_up do
        for p in pillars do
            w.add_box(p.base - ap.Vec3(0.55, 0, 0.55), p.base + ap.Vec3(0.55, p.height, 0.55))
        end
    end
    for pr in props do
        var half = prop_half(pr)
        w.add_box(pr.position - ap.Vec3(half, 0, half), pr.position + ap.Vec3(half, pr.height, half))
    end
    return w
end
var world = build_world()

# --- The arena shifts ---------------------------------------------------------------------------
# Every so often the Purgatory becomes somewhere else: the light, the stone and the air change
# over a few seconds, while the floor plan stays the same.

const int AREA_TICKS = 30 * 60       # fighting time spent in each area
const int AREA_SHIFT = 240           # ticks a change takes
Area[] areas = [
    Area("THE PURGATORY", ap.Color(7, 6, 14), ap.Color(74, 72, 110), ap.Color(190, 196, 240), ap.Color(110, 80, 200),
        ap.Color(46, 42, 62), ap.Color(70, 66, 92), ap.Color(34, 30, 54), ap.Color(60, 40, 110), ap.Color(140, 90, 255),
        ap.WHITE, ap.Color(170, 150, 255), 0.35),
    Area("THE FURNACE", ap.Color(22, 6, 4), ap.Color(112, 62, 52), ap.Color(255, 176, 124), ap.Color(255, 110, 40),
        ap.Color(62, 34, 30), ap.Color(98, 58, 48), ap.Color(54, 20, 16), ap.Color(120, 40, 20), ap.Color(255, 120, 40),
        ap.Color(255, 186, 164), ap.Color(255, 150, 60), 1.5),
    Area("THE FROZEN DEEP", ap.Color(6, 13, 24), ap.Color(82, 102, 132), ap.Color(200, 230, 255), ap.Color(90, 170, 255),
        ap.Color(60, 76, 96), ap.Color(122, 152, 182), ap.Color(40, 60, 84), ap.Color(60, 110, 150), ap.Color(120, 220, 255),
        ap.Color(188, 224, 255), ap.Color(236, 246, 255), -1.1),
    Area("THE OVERGROWTH", ap.Color(5, 13, 8), ap.Color(72, 102, 72), ap.Color(222, 240, 172), ap.Color(120, 230, 110),
        ap.Color(40, 56, 40), ap.Color(72, 98, 62), ap.Color(24, 44, 30), ap.Color(50, 110, 50), ap.Color(140, 255, 110),
        ap.Color(200, 255, 190), ap.Color(190, 255, 140), 0.2)
]
var area_from = 0
var area_to = 0
var area_blend = AREA_SHIFT          # ticks into the change; AREA_SHIFT when settled
var area_clock = 0
var sky_now = areas[0].sky
var lamp_now = areas[0].lamp
var mote_now = areas[0].mote
var drift_now = areas[0].drift

# Sets the light and the stone to wherever between two areas the arena is.
function apply_area()
    var a = areas[area_from]
    var b = areas[area_to]
    var t = puppet.smooth(double(area_blend) / double(AREA_SHIFT))
    sky_now = a.sky.lerp(b.sky, t)
    lamp_now = a.lamp.lerp(b.lamp, t)
    mote_now = a.mote.lerp(b.mote, t)
    drift_now = a.drift + (b.drift - a.drift) * t
    ap.ambient(a.ambient.lerp(b.ambient, t))
    ap.sun(ap.Vec3(-0.35, -1, -0.3), a.sun.lerp(b.sun, t))
    ap.fog(sky_now, 16, 58)
    stone.color(a.stone.lerp(b.stone, t))
    pillar_stone.color(a.pillar.lerp(b.pillar, t))
    monolith_look.color(a.far.lerp(b.far, t))
    rim_look.color(a.rim.lerp(b.rim, t))
    rim_look.glow(a.glow.lerp(b.glow, t), 1.6)
    floor_look.color(a.floor.lerp(b.floor, t))
end

function set_area(int index)
    area_from = index
    area_to = index
    area_blend = AREA_SHIFT
    area_clock = 0
    apply_area()
end

# Counts fighting time, and moves the arena on when an area has had its turn.
function update_area()
    if max_owner >= 0 do
        return
    end
    if area_blend < AREA_SHIFT do
        area_blend += 1
        apply_area()
        if area_blend >= AREA_SHIFT do
            area_from = area_to
        end
        return
    end
    area_clock += 1
    if area_clock >= AREA_TICKS do
        area_clock = 0
        area_to = (area_from + 1) % areas.length
        area_blend = 0
        sound_at(snd_bell, cam_focus, 0.4, 0.7)
        later(snd_wisp, cam_focus, 10, 0.4, 0.6)
    end
end

