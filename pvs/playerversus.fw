# --- Small helpers -----------------------------------------------------------------------------

# An angle between -180 and 180 degrees.
function wrap(double angle) returns double
    var r = (angle + 540) % 360
    if r < 0 do
        r += 360
    end
    return r - 180
end
function forward_of(double heading) returns ap.Vec3
    var a = heading * math.PI / 180
    return ap.Vec3(math.sin(a), 0, math.cos(a))
end
function heading_of(ap.Vec3 way) returns double
    return math.atan2(way.x, way.z) * 180 / math.PI
end
function flat(ap.Vec3 v) returns ap.Vec3
    return ap.Vec3(v.x, 0, v.z)
end
function flat_distance(ap.Vec3 a, ap.Vec3 b) returns double
    return flat(a - b).length()
end
function unit(ap.Vec3 v) returns ap.Vec3
    if v.length() < 0.0001 do
        return ap.Vec3(0, 0, 0)
    end
    return v.normalized()
end
function other(Fighter f) returns Fighter
    return fighters[1 - f.id]
end
function pips(roster.Character kit, double bar) returns int
    return int(bar + 0.001) if kit.bar_pips else int(bar)
end

function left_pressed() returns bool
    return ap.key_pressed(ap.KEY_A) or ap.key_pressed(ap.KEY_LEFT) or ap.pad_pressed(ap.PAD_LEFT)
end
function right_pressed() returns bool
    return ap.key_pressed(ap.KEY_D) or ap.key_pressed(ap.KEY_RIGHT) or ap.pad_pressed(ap.PAD_RIGHT)
end
function up_pressed() returns bool
    return ap.key_pressed(ap.KEY_W) or ap.key_pressed(ap.KEY_UP) or ap.pad_pressed(ap.PAD_UP)
end
function down_pressed() returns bool
    return ap.key_pressed(ap.KEY_S) or ap.key_pressed(ap.KEY_DOWN) or ap.pad_pressed(ap.PAD_DOWN)
end
function confirm_pressed() returns bool
    return ap.key_pressed(ap.KEY_ENTER) or ap.key_pressed(ap.KEY_R) or ap.key_pressed(ap.KEY_SPACE) or
        ap.pad_pressed(ap.PAD_SOUTH) or ap.pad_pressed(ap.PAD_START)
end
function back_pressed() returns bool
    return ap.key_pressed(ap.KEY_ESCAPE) or ap.key_pressed(ap.KEY_BACKSPACE) or ap.pad_pressed(ap.PAD_EAST)
end

function go(int to)
    screen = to
    screen_ticks = 0
end

# --- Effects -----------------------------------------------------------------------------------

function spark(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double size, double gravity)
    if sparks.length < 900 do
        sparks.push(Spark(at, velocity, color, life, life, size, gravity))
    end
end
function burst(ap.Vec3 at, int count, ap.Color color, double speed, double life = 0.45, double size = 0.08)
    for i in 0..<count do
        var way = unit(ap.Vec3(ap.random(-1, 1), ap.random(-0.4, 1), ap.random(-1, 1)))
        spark(at, way * (speed * ap.random(0.35, 1)), color, life * ap.random(0.6, 1), size, 7)
    end
end
function say(ap.Vec3 at, string words, ap.Color color)
    floaters.push(Floater(at + ap.Vec3(ap.random(-0.2, 0.2), 0.3, 0), words, color))
end
function sound_at(ap.Sound sound, ap.Vec3 at, double volume = 0.6, double pitch = 1)
    sound.play_at(at + ap.Vec3(0, 1, 0), volume, pitch * ap.random(0.94, 1.06), 6, 0)
end

function blade_weapon(int weapon) returns bool
    return weapon == roster.WEAPON_DAGGER or weapon == roster.WEAPON_RAPIER or
        weapon == roster.WEAPON_KATANA or weapon == roster.WEAPON_CROOK or
        weapon == roster.WEAPON_STAFF or weapon == roster.WEAPON_SABER
end

function weapon_swing_sound(Fighter f) returns ap.Sound
    if blade_weapon(f.kit.look.weapon) do
        if f.serial % 3 == 0 do
            return snd_blade_swing1
        else if f.serial % 3 == 1 do
            return snd_blade_swing2
        end
        return snd_blade_swing3
    else if f.kit.look.weapon == roster.WEAPON_FISTS or f.kit.look.weapon == roster.WEAPON_CLAWS or
            f.kit.look.weapon == roster.WEAPON_CANNON do
        if f.serial % 2 == 0 do
            return snd_swing_file1
        end
        return snd_swing_file2
    end
    return snd_swing
end

function weapon_fire_sound(Fighter f) returns ap.Sound
    var weapon = f.kit.look.weapon
    if weapon == roster.WEAPON_REVOLVER do
        return snd_revolver1 if f.hits_done % 2 == 0 else snd_revolver2
    else if weapon == roster.WEAPON_SHOTGUN do
        return snd_shotgun1 if f.hits_done % 2 == 0 else snd_shotgun2
    else if weapon == roster.WEAPON_GUN do
        if f.hits_done % 3 == 0 do
            return snd_pistol1
        else if f.hits_done % 3 == 1 do
            return snd_pistol2
        end
        return snd_pistol3
    else if weapon == roster.WEAPON_DEVICE or weapon == roster.WEAPON_SABER do
        return snd_zap_file if weapon == roster.WEAPON_DEVICE else snd_beam_file
    end
    return snd_shot
end

function weapon_hit_sound(Fighter f, bool heavy, bool melee) returns ap.Sound
    if melee and blade_weapon(f.kit.look.weapon) do
        if f.hits_done % 3 == 0 do
            return snd_blade_hit1
        else if f.hits_done % 3 == 1 do
            return snd_blade_hit2
        end
        return snd_blade_hit3
    else if melee and (f.kit.look.weapon == roster.WEAPON_FISTS or
            f.kit.look.weapon == roster.WEAPON_CLAWS or f.kit.look.weapon == roster.WEAPON_CANNON) do
        if f.hits_done % 3 == 0 do
            return snd_punch1
        else if f.hits_done % 3 == 1 do
            return snd_punch2
        end
        return snd_punch3
    end
    return snd_heavy if heavy else snd_hit
end

# A thin line of light flying along its own length.
function streak(ap.Vec3 at, ap.Vec3 velocity, ap.Color color, double life, double length, double size = 0.05)
    if sparks.length < 900 do
        sparks.push(Spark(at, velocity, color, life, life, size, 0, length))
    end
end
function scatter(double amount) returns ap.Vec3
    return ap.Vec3(ap.random(-amount, amount), ap.random(-amount, amount), ap.random(-amount, amount))
end
# Sparks drawn in toward a point from `from` meters away.
function gather(ap.Vec3 to, int count, ap.Color color, double from, double life = 0.22, double size = 0.07)
    for i in 0..<count do
        var way = unit(scatter(1))
        spark(to + way * from, way * (-from / life), color, life, size, 0)
    end
end
function smoke(ap.Vec3 at, int count, double spread, double life = 0.9)
    for i in 0..<count do
        var shade = int(ap.random(70, 130))
        spark(at + scatter(spread), ap.Vec3(ap.random(-0.5, 0.5), ap.random(0.4, 1.4), ap.random(-0.5, 0.5)),
            ap.Color(shade, shade, shade + 12), life * ap.random(0.6, 1), 0.14, -0.4)
    end
end
function stain(ap.Vec3 at, ap.Color color, double radius, double life, double strength, bool bubbles = false)
    if flat(at).length() < ARENA + 0.5 and marks.length < 12 do
        marks.push(Mark(ap.Vec3(at.x, 0.03, at.z), color, radius, life, life, strength, bubbles))
    end
end
function later(ap.Sound sound, ap.Vec3 at, int wait, double volume = 0.5, double pitch = 1)
    cues.push(Cue(sound, at, wait, volume, pitch))
end
function leave_ghost(Fighter f, double life)
    if f.cpu and mx(f).vanish do
        return
    end
    ghosts.push(Ghost(f.kit.look, fighter_pose(f), f.body.position, f.heading, life, life))
end
# The right-hand side of a fighter facing `heading`.
function right_of(double heading) returns ap.Vec3
    var a = heading * math.PI / 180
    return ap.Vec3(-math.cos(a), 0, math.sin(a))
end

function update_effects()
    var dt = 1.0 / 60
    Ghost[] lingering = []
    for g in ghosts do
        g.life -= dt
        if g.life > 0 do
            lingering.push(g)
        end
    end
    ghosts = lingering
    Mark[] staying = []
    for m in marks do
        m.life -= dt
        if m.bubbles and ap.chance(0.18) do
            spark(m.position + ap.Vec3(ap.random(-0.6, 0.6) * m.radius, 0.03, ap.random(-0.6, 0.6) * m.radius),
                ap.Vec3(0, ap.random(0.4, 1.0), 0), m.color, 0.5, 0.06, 0)
        end
        if m.life > 0 do
            staying.push(m)
        end
    end
    marks = staying
    Cue[] waiting = []
    for c in cues do
        c.wait -= 1
        if c.wait <= 0 do
            sound_at(c.sound, c.position, c.volume, c.pitch)
        else do
            waiting.push(c)
        end
    end
    cues = waiting
    Spark[] alive = []
    for s in sparks do
        s.life -= dt
        if s.life > 0 do
            s.velocity = s.velocity - ap.Vec3(0, s.gravity * dt, 0)
            s.position = s.position + s.velocity * dt
            if s.position.y < 0.03 and s.gravity > 0 and flat(s.position).length() < ARENA + 1 do
                s.position = ap.Vec3(s.position.x, 0.03, s.position.z)
                s.velocity = ap.Vec3(s.velocity.x * 0.6, 0, s.velocity.z * 0.6)
            end
            alive.push(s)
        end
    end
    sparks = alive
    Ring[] growing = []
    for r in rings do
        r.life -= dt
        r.radius += r.grow * dt
        if r.life > 0 do
            growing.push(r)
        end
    end
    rings = growing
    Floater[] rising = []
    for f in floaters do
        f.life -= dt
        f.position = f.position + ap.Vec3(0, 0.9 * dt, 0)
        if f.life > 0 do
            rising.push(f)
        end
    end
    floaters = rising
    for i in 0..<souls.length do
        var s = souls[i]
        var y = s.y + drift_now * dt
        if y > 12 do
            y = -2
        else if y < -2 do
            y = 12
        end
        souls[i] = ap.Vec3(s.x, y, s.z)
    end
end

# --- A match -----------------------------------------------------------------------------------

function new_fighter(int id, int pick) returns Fighter
    # Their own copy of the fighter, since a copycat rewrites its moves.
    var kit = roster.build()[pick]
    var body = ap.Body(ap.Vec3(0, 0, 3.5 if id == 0 else -3.5))
    body.radius = 0.36 * kit.look.bulk
    body.height = 1.8 * kit.look.tall
    var f = Fighter(id, kit, body, kit.basics[0])
    f.cooldowns = [0, 0, 0, 0]
    f.pose = puppet.Pose()
    f.cpu = id == 1
    f.pick = pick
    f.max_health = kit.health
    return f
end

function start_match()
    if mode == MODE_SHOWDOWN do
        picks = [teams[0][0], teams[1][0]]
    end
    fighters = [new_fighter(0, picks[0]), new_fighter(1, picks[1])]
    side_items = [[], []]
    select_world = -1
    set_area(0)
    round = 1
    paused = false
    banner_sub = ""
    start_round()
    go(SCREEN_FIGHT)
end

# --- Items ---------------------------------------------------------------------------------------

# How many of item `kind` this fighter's side holds. Clones get none.
function item_count(Fighter f, int kind) returns int
    if f.minion or f.id >= side_items.length do
        return 0
    end
    var n = 0
    for k in side_items[f.id] do
        if k == kind do
            n += 1
        end
    end
    return n
end

# `base` once for every item of `kind` held: 0.9 per IRON SKIN, say.
function stacked(Fighter f, int kind, double each) returns double
    var r = 1.0
    for i in 0..<item_count(f, kind) do
        r *= each
    end
    return r
end

function item_named(int kind) returns roster.Item
    for it in item_list do
        if it.kind == kind do
            return it
        end
    end
    return item_list[0]
end

# Before the intro: whoever the item option allows is offered two items and picks one.
function begin_draft()
    drafting = [false, false]
    if items_mode == ITEMS_ON do
        drafting = [true, true]
    else if items_mode == ITEMS_LOSING and fighters[0].wins != fighters[1].wins do
        drafting[0 if fighters[0].wins < fighters[1].wins else 1] = true
    end
    if not drafting[0] and not drafting[1] do
        return
    end
    for i in 0..<2 do
        var a = pick_index(item_list.length)
        var b = pick_index(item_list.length - 1)
        if b >= a do
            b += 1
        end
        offers[i] = [item_list[a].kind, item_list[b].kind]
    end
    draft_cursor = 0
    draft_ticks = 0
    phase = PHASE_DRAFT
end

function take_item(int side, int choice)
    var kind = offers[side][choice]
    side_items[side].push(kind)
    drafting[side] = false
    var f = fighters[side]
    say(f.body.top() + ap.Vec3(0, 0.3, 0), item_named(kind).name, f.kit.look.accent)
    sound_at(snd_shimmer, f.body.position, 0.6, 1.2)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 5, 0.4))
end

function update_draft()
    draft_ticks += 1
    for i in 0..<2 do
        if drafting[i] and fighters[i].cpu and draft_ticks > 45 + i * 15 do
            take_item(i, pick_index(2))
        end
    end
    if drafting[0] and not fighters[0].cpu do
        if left_pressed() or right_pressed() do
            draft_cursor = 1 - draft_cursor
            snd_move.play(0.5)
        end
        if draft_ticks > 15 and confirm_pressed() do
            snd_pick.play(0.5)
            take_item(0, draft_cursor)
        end
    end
    if not drafting[0] and not drafting[1] do
        if draft_ticks < 1000 do
            draft_ticks = 1000
        end
        if draft_ticks > 1030 do
            # Picks made: health comes up to whatever the hearts now give, and the round begins.
            for f in fighters do
                f.max_health = f.kit.health * (DECIDER_HEALTH if decider() else 1.0) *
                    (1 + 0.35 * double(item_count(f, roster.ITEM_HEART)))
                f.health = f.max_health
                f.shown_health = f.max_health
            end
            phase = PHASE_INTRO
            phase_ticks = 0
            pad.clear()
        end
    end
end

function draw_draft_hud()
    var title = "ROUND {round}: CHOOSE AN ITEM"
    if not drafting[0] and drafting[1] do
        title = "{fighters[1].kit.name} CHOOSES AN ITEM"
    else if not drafting[0] and not drafting[1] do
        title = "ITEMS CHOSEN"
    end
    ap.rect(0, 96, VW, 150, ap.BLACK.fade(0.6))
    label_centered(title, 320, 104, 16, MAX_GOLD)
    if drafting[0] and not fighters[0].cpu do
        for k in 0..<2 do
            var it = item_named(offers[0][k])
            var x = 96.0 + double(k) * 236
            var chosen = k == draft_cursor
            ap.rect(x, 132, 212, 74, ap.Color(24, 20, 36).fade(0.95))
            ap.rect_lines(x, 132, 212, 74, 2 if chosen else 1, MAX_GOLD if chosen else ap.Color(90, 86, 110))
            label_centered(it.name, x + 106, 144, 16 if chosen else 8, ap.WHITE if chosen else ap.Color(170, 165, 190))
            var lines = wrap_words(it.note, 30)
            for n, line in lines do
                label_centered(line, x + 106, 166 + double(n) * 11, 8, ap.Color(200, 196, 220))
            end
        end
        label_centered("A / D  CHOOSE      R / ENTER  TAKE IT", 320, 220, 8, ap.Color(170, 165, 190))
    else do
        label_centered("Waiting..." if drafting[1] else "", 320, 160, 8, ap.Color(170, 165, 190))
    end
    # What each side holds so far.
    for side in 0..<2 do
        var words = held_items(side)
        if words != "" do
            if side == 0 do
                label(words, 16, 232, 8, fighters[0].kit.look.accent)
            else do
                label_right(words, 624, 232, 8, fighters[1].kit.look.accent)
            end
        end
    end
end

# `words` broken into lines of at most `width` characters, at the spaces.
function wrap_words(string words, int width) returns string[]
    string[] lines = []
    var line = ""
    for word in words.split(" ") do
        if line != "" and line.length + 1 + word.length > width do
            lines.push(line)
            line = word
        else do
            line = word if line == "" else "{line} {word}"
        end
    end
    if line != "" do
        lines.push(line)
    end
    return lines
end

# A side's items, as a short list ("IRON SKIN x2, MOSS").
function held_items(int side) returns string
    var words = ""
    for it in item_list do
        var n = 0
        for kind in side_items[side] do
            if kind == it.kind do
                n += 1
            end
        end
        if n > 0 do
            var one = it.name if n == 1 else "{it.name} x{n}"
            words = one if words == "" else "{words}, {one}"
        end
    end
    return words
end

function start_round()
    end_maximum()
    # Items last one round: last round's are gone before anything is worked out from them.
    side_items = [[], []]
    minions = []
    pickups = []
    props = []
    mirrors = []
    for f in fighters do
        var kit = f.kit
        f.body.position = ap.Vec3(0, 0, 3.5 if f.id == 0 else -3.5)
        f.body.velocity = ap.Vec3(0, 0, 0)
        f.heading = 180 if f.id == 0 else 0
        f.max_health = kit.health * (DECIDER_HEALTH if decider() else 1.0) * (1 + 0.35 * double(item_count(f, roster.ITEM_HEART)))
        f.health = f.max_health
        f.shown_health = f.max_health
        f.bar = kit.bar_start
        f.state = STATE_IDLE
        f.frame = 0
        f.stun = 0
        f.poison = 0
        f.cloaked = false
        f.ambush = false
        f.fade = 1
        f.dash_cooldown = 0
        f.knock = ap.Vec3(0, 0, 0)
        f.moving = 0
        f.cool = 40
        f.think = 0
        f.block_hold = 0
        f.last_seen = ap.Vec3(0, 0, -3.5 if f.id == 0 else 3.5)
        f.cooldowns = [0, 0, 0, 0]
        f.slot = SLOT_BASIC
        f.chain = 0
        f.taken = 0
        f.combo_show = 0
        f.buff = roster.BUFF_NONE
        f.slow = 0
        f.warp_cool = 0
        f.pressure = 0
        f.spam = 0
        f.since_hit = 999
        f.safe = 0
        f.settle = 1
        f.broke_ticks = 0
        f.revived = false
        f.injects = 0
        f.clone_cool = 0
        f.decoy = -1
        f.encore_used = false
        prepare_kit(f)
        if kit.lab do
            # The machine stands just behind them.
            var spot = f.body.position - forward_of(f.heading) * 2.4
            props.push(Prop(PROP_MACHINE, f.id, ap.Vec3(spot.x, 0, spot.z), 1.9, -1, 0, f.heading))
        end
        f.pose = target_pose(f)
    end
    world = build_world()
    shots = []
    rings = []
    floaters = []
    ghosts = []
    marks = []
    cues = []
    hazards = []
    portals = []
    beams = []
    super_ticks = 0
    phase = PHASE_INTRO
    phase_ticks = 0
    clock = ROUND_SECONDS * 60
    banner = "FINALE" if finale_round() else "ROUND {round}"
    begin_draft()
    if decider() do
        banner_sub = "DOUBLE HEALTH" if banner_sub == "" else "{banner_sub}  -  DOUBLE HEALTH"
        banner_sub_color = MAX_GOLD
    end
    cam_yaw = 0
    cam_foe = fighters[1].body.position
    pad.clear()
end

function refill()
    for f in fighters do
        if f.state != STATE_DOWN do
            f.health = f.max_health
            f.bar = f.kit.bar_max
            f.poison = 0
            f.slow = 0
            f.energy = roster.SUPER_MAX
            f.cooldowns = [0, 0, 0, 0]
        end
    end
end

# --- Attacks -----------------------------------------------------------------------------------

function attack_length(roster.Attack a, int hits) returns int
    return a.startup + (hits - 1) * a.interval + a.recovery
end
# Where in the move an attack is: 0..1 winding up, 1..2 striking, 2..3 recovering.
function attack_phase(roster.Attack a, int hits, int frame) returns double
    if frame < a.startup do
        return double(frame) / double(a.startup)
    end
    var into = frame - a.startup
    var striking = (hits - 1) * a.interval + 7
    if into < striking do
        if hits > 1 and into < hits * a.interval do
            return 1 + double(into % a.interval) / double(a.interval)
        end
        return 1 + math.min(double(into - (hits - 1) * a.interval) / 7, 0.99)
    end
    return 2 + math.min(double(into - striking) / double(math.max(a.recovery - 7, 1)), 0.99)
end
function attack_beat(roster.Attack a, int hits, int frame) returns int
    if frame < a.startup do
        return 0
    end
    return math.min((frame - a.startup) // a.interval, hits - 1)
end

function set_cloak(Fighter f, bool on)
    if f.cloaked == on do
        return
    end
    f.cloaked = on
    if not on do
        # The shroud needs a moment before it can be pulled back on.
        for i, a in f.kit.skills do
            if a.kind == roster.KIND_CLOAK do
                f.cooldowns[i] = a.cooldown
            end
        end
    end
    var here = f.body.position
    var tint = f.kit.look.accent
    sound_at(snd_cloak, here, 0.5, 1.0 if on else 1.5)
    if on do
        later(snd_wisp, here, 5, 0.4)
        smoke(f.body.center(), 8, 0.4, 0.9)
    else do
        later(snd_wisp, here, 2, 0.3, 1.6)
    end
    # The shroud winds up around the body going in, and unwinds outward coming off.
    for i in 0..<30 do
        var around = double(i) * 42
        var out = forward_of(around)
        var spin = forward_of(around + 90) * 1.8
        var rise = ap.Vec3(0, 0.9, 0) if on else out * 1.6
        spark(here + out * 0.55 + ap.Vec3(0, double(i) / 29 * 1.8 * f.kit.look.tall, 0), spin + rise,
            tint if i % 3 != 0 else ap.Color(120, 126, 124), ap.random(0.45, 0.85), 0.09, -0.4)
    end
    rings.push(Ring(here + ap.Vec3(0, 0.08, 0), tint, 4 if on else 7, 0.3))
end

function chest_of(Fighter f) returns ap.Vec3
    return f.body.position + ap.Vec3(0, 1.25 * f.kit.look.tall, 0)
end

# A skill is called on: its own sound, and a first sign of what is coming.
function skill_begins(Fighter f, roster.Attack a)
    var fx = a.fx
    var here = f.body.position
    var tint = f.kit.look.accent
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    if fx == roster.FX_FEAST do
        sound_at(snd_growl, here, 0.6)
        rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 4, 0.3))
    else if fx == roster.FX_RUSH do
        sound_at(snd_kiai, here, 0.5)
        burst(here + ap.Vec3(0, 0.1, 0), 8, ap.Color(150, 145, 170), 2.5, 0.35, 0.09)
    else if fx == roster.FX_SPIT do
        sound_at(snd_hiss, here, 0.6)
    else if fx == roster.FX_FLECHE do
        sound_at(snd_shing, here, 0.5)
        for i in 0..<8 do
            streak(hand + forward_of(f.heading) * 0.8, unit(scatter(1)) * 2.5, ap.WHITE, 0.2, 0.3)
        end
    else if fx == roster.FX_FAN do
        sound_at(snd_reload, here, 0.5, 1.7)
    else if fx == roster.FX_FLASH do
        sound_at(snd_rift, here, 0.6)
    else if fx == roster.FX_ROCKET do
        sound_at(snd_lock, here, 0.4)
        later(snd_lock, here, 7, 0.4, 1.25)
    else if fx == roster.FX_NOVA do
        sound_at(snd_charge, here, 0.6)
    else if fx == roster.FX_BOLT do
        sound_at(snd_charge, here, 0.35, 1.8)
    else if fx == roster.FX_CHAIN do
        sound_at(snd_lock, here, 0.5, 0.6)
    end
end

# Every tick of a skill's wind-up: power visibly gathering.
function skill_gathers(Fighter f, roster.Attack a)
    var fx = a.fx
    if fx == roster.FX_NONE do
        return
    end
    var here = f.body.position
    var tint = f.kit.look.accent
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    var t = double(f.frame) / double(a.startup)
    if fx == roster.FX_FEAST do
        gather(chest_of(f), 2, ap.Color(220, 30, 60), 1.3)
    else if fx == roster.FX_RUSH do
        for i in 0..<2 do
            var around = forward_of(ap.random(0, 360)) * 0.5
            streak(here + around + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(3, 5), 0), tint, 0.25, 0.35)
        end
    else if fx == roster.FX_SPIT do
        var mouth = here + ap.Vec3(0, 1.55 * f.kit.look.tall, 0) + forward_of(f.heading) * 0.3
        spark(mouth + scatter(0.15), ap.Vec3(0, -0.5, 0), tint, 0.35, 0.06, 5)
        gather(mouth, 1, tint, 0.6, 0.16, 0.05)
    else if fx == roster.FX_FLECHE do
        gather(hand + forward_of(f.heading) * 0.8, 2, tint, 0.9, 0.16, 0.05)
    else if fx == roster.FX_FLASH do
        gather(chest_of(f), 3, ap.Color(70, 34, 130), 1.1, 0.16, 0.09)
    else if fx == roster.FX_ROCKET do
        var pod = here + ap.Vec3(0, 1.75 * f.kit.look.tall, 0) + right_of(f.heading) * 0.42
        spark(pod + forward_of(f.heading) * 0.4, scatter(0.5) + ap.Vec3(0, 0.6, 0), tint, 0.25, 0.06, 0)
    else if fx == roster.FX_NOVA do
        # A circle of runes closing in on the caster.
        var radius = a.reach * (1 - 0.7 * t)
        for i in 0..<8 do
            var around = double(i) * 45 + double(f.frame) * 11
            spark(here + forward_of(around) * radius + ap.Vec3(0, 0.08, 0), ap.Vec3(0, 0.9, 0), tint, 0.14, 0.1, 0)
        end
        gather(f.body.top() + ap.Vec3(0, 0.4, 0), 2, ap.WHITE, 1.0)
    else if fx == roster.FX_BOLT do
        gather(hand, 2, tint, 0.7, 0.14, 0.05)
    end
end

# What a skill's melee strike looks and sounds like, whether or not it lands.
function skill_strikes(Fighter f, roster.Attack a)
    var fx = a.fx
    var here = f.body.position
    var tint = f.kit.look.accent
    var forward = forward_of(f.heading)
    var right = right_of(f.heading)
    var hand = puppet.muzzle(f.kit.look, here, f.heading)
    if fx == roster.FX_CHAIN do
        # Links flung out to the end of the reach, or whirled around.
        var hand = chest_of(f) - right * 0.3
        sound_at(snd_dash, here, 0.5, 0.7)
        later(snd_lock, here, 3, 0.5, 1.3)
        if a.radial do
            for i in 0..<24 do
                var around = double(i) * 15 + double(f.hits_done) * 40
                spark(here + forward_of(around) * (a.reach * 0.9) + ap.Vec3(0, 0.9, 0), forward_of(around + 90) * 6,
                    f.kit.look.metal, 0.16, 0.09, 0)
            end
        else do
            for i in 0..<18 do
                var at = hand.lerp(here + forward * a.reach + ap.Vec3(0, 1.0, 0), double(i) / 17)
                spark(at, ap.Vec3(0, 0, 0), f.kit.look.metal if i % 2 == 0 else f.kit.look.metal.brightness(0.6), 0.25, 0.09, 0)
            end
        end
        return
    end
    if fx == roster.FX_RUSH do
        var beat = f.hits_done
        var fist = chest_of(f) + forward * 1.15 + right * (0.25 if beat % 2 == 1 else -0.25) +
            ap.Vec3(0, ap.random(-0.15, 0.2), 0)
        rings.push(Ring(fist, tint, 1.8, 0.12, true))
        for i in 0..<4 do
            streak(fist - forward * 0.7 + scatter(0.15), forward * 9, tint, 0.1, 0.5)
        end
        sound_at(snd_rush, fist, 0.5, 0.85 + 0.09 * double(beat))
        if beat == f.move_hits do
            rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 9, 0.3))
            sound_at(snd_thud, here, 0.6, 1.4)
        end
    else if fx == roster.FX_FEAST do
        # Two rows of fangs snapping shut.
        sound_at(snd_bite, here, 0.7)
        var bite = chest_of(f) + forward * 1.0 + ap.Vec3(0, 0.25, 0)
        for i in 0..<6 do
            var across = right * ((double(i) - 2.5) * 0.11)
            streak(bite + across + ap.Vec3(0, 0.45, 0), ap.Vec3(0, -5, 0), ap.WHITE, 0.1, 0.3, 0.06)
            streak(bite + across - ap.Vec3(0, 0.45, 0), ap.Vec3(0, 5, 0), ap.WHITE, 0.1, 0.3, 0.06)
        end
    else if fx == roster.FX_FLECHE do
        sound_at(snd_slash, here, 0.6, 1.2)
        for i in 0..<12 do
            streak(hand + forward * (double(i) * 0.25) + scatter(0.06), forward * ap.random(8, 14),
                tint if i % 2 == 0 else ap.WHITE, 0.14, 0.7)
        end
    else if fx == roster.FX_FLASH do
        # One wide rising cut, and the dark it tears open.
        sound_at(snd_slash, here, 0.7, 0.8)
        later(snd_shing, here, 5, 0.35, 0.8)
        for i in 0..<22 do
            var along = double(i) / 21
            var around = f.heading + 170 * (along - 0.5)
            var at = here + forward_of(around) * (a.reach * 0.85) + ap.Vec3(0, 0.7 + 0.9 * along, 0)
            streak(at, forward_of(around - 90) * 5 + ap.Vec3(0, 1.5, 0), tint if i % 2 == 0 else ap.WHITE, 0.22, 0.6, 0.07)
        end
        rings.push(Ring(chest_of(f) + forward * 1.2, ap.Color(70, 34, 130), 6, 0.2, true))
    else if fx == roster.FX_NOVA do
        sound_at(snd_thud, here, 0.7)
        later(snd_shimmer, here, 8, 0.4)
        later(snd_shimmer, here, 16, 0.25, 0.75)
        rings.push(Ring(here + ap.Vec3(0, 0.12, 0), ap.WHITE, a.reach / 0.5, 0.5))
        for i in 0..<20 do
            var out = forward_of(double(i) * 18)
            streak(here + out * (a.reach * 0.5) + ap.Vec3(0, 0.1, 0), out * 2 + ap.Vec3(0, ap.random(5, 9), 0),
                tint, 0.3, 0.6, 0.06)
        end
        for i in 0..<24 do
            spark(f.body.center(), forward_of(double(i) * 15) * ap.random(6, 9) + ap.Vec3(0, ap.random(-0.5, 1.5), 0),
                ap.WHITE if i % 2 == 0 else tint, 0.4, 0.09, 2)
        end
    end
end

# A skill lands cleanly on `o` at `at`.
function skill_lands(Fighter f, Fighter o, roster.Attack a, ap.Vec3 at, ap.Vec3 origin)
    var fx = a.fx
    var tint = f.kit.look.accent
    var away = unit(flat(o.body.position - origin))
    if fx == roster.FX_FEAST do
        # Blood streaming back to the one who bit.
        for i in 0..<18 do
            var life = ap.random(0.25, 0.5)
            var from = at + scatter(0.25)
            spark(from, (chest_of(f) - from) * (1 / life), ap.Color(210, 20, 44), life, 0.08, 0)
        end
        rings.push(Ring(at, tint, 4, 0.2, true))
    else if fx == roster.FX_RUSH do
        burst(at, 4, ap.WHITE, 5, 0.2, 0.06)
        if f.hits_done == f.move_hits do
            rings.push(Ring(at, tint, 7, 0.25, true))
            sound_at(snd_heavy, at, 0.6, 0.8)
        end
    else if fx == roster.FX_SPIT do
        burst(at, 16, tint, 4, 0.5, 0.08)
    else if fx == roster.FX_FLECHE do
        # Run clean through.
        sound_at(snd_shing, at, 0.5, 1.3)
        for i in 0..<12 do
            streak(at + scatter(0.1), (away + scatter(0.2)) * ap.random(6, 12), ap.WHITE, 0.18, 0.6)
        end
        rings.push(Ring(at, tint, 5, 0.18, true))
    else if fx == roster.FX_FLASH do
        for i in 0..<10 do
            streak(at + ap.Vec3(0, -0.8 + double(i) * 0.16, 0) + scatter(0.05), ap.Vec3(0, 3, 0) + away * 2, tint,
                0.25, 0.5, 0.06)
        end
        rings.push(Ring(at, ap.Color(70, 34, 130), 5, 0.22, true))
        later(snd_thud, at, 3, 0.5, 1.6)
    else if fx == roster.FX_NOVA do
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 6, ap.WHITE, 0.2, 0.5)
        end
        sound_at(snd_shimmer, at, 0.4, 1.5)
    else if fx == roster.FX_BOLT do
        rings.push(Ring(at, tint, 5, 0.18, true))
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 5, tint if i % 2 == 0 else ap.WHITE, 0.18, 0.4)
        end
        sound_at(snd_shimmer, at, 0.4, 1.3)
    end
end

# --- What the newer fighters do -------------------------------------------------------------------

var skill_pool = roster.move_pool(cast)
var ultimate_pool = roster.ultimate_pool(cast)
var chain_pool = roster.chain_pool(cast)
var recall_hit = roster.hit("Recall", 4, 1, 1, 0, 0, 0, 12, -3, roster.ANIM_FOCUS)

function dot3(ap.Vec3 a, ap.Vec3 b) returns double
    return a.x * b.x + a.y * b.y + a.z * b.z
end

# How far `p` is from the segment `a`..`b`.
function off_line(ap.Vec3 p, ap.Vec3 a, ap.Vec3 b) returns double
    var ab = b - a
    var long = dot3(ab, ab)
    if long < 0.0001 do
        return (p - a).length()
    end
    var t = math.clamp(dot3(p - a, ab) / long, 0.0, 1.0)
    return (p - (a + ab * t)).length()
end

function pick_index(int count) returns int
    return math.min(int(ap.random(0, double(count))), count - 1)
end

# Whether the special bar covers `cost`. A fighter who goes bankrupt can always spend what is left.
function can_pay(Fighter f, double cost) returns bool
    return mx(f).free_bar or f.bar + 0.001 >= cost or (f.kit.bankrupt > 0 and f.bar > 0.001)
end

function pay(Fighter f, double cost)
    if not mx(f).free_bar do
        f.bar = math.max(f.bar - cost, 0.0)
    end
end

# CAT: a move from anyone in the game, priced in mischief.
function random_skill() returns roster.Attack
    return roster.adapt(skill_pool[pick_index(skill_pool.length)], 20)
end

# CAT in its super: someone's whole basic chain, borrowed.
function random_chain(Fighter f)
    var chain = chain_pool[pick_index(chain_pool.length)]
    roster.Attack[] moves = []
    for a in chain do
        moves.push(roster.adapt(a, 0))
    end
    f.kit.basics = moves
end

# CAT's super: every move it has becomes a random one. Its own are put away until it is over.
function randomize_moves(Fighter f)
    if f.kept_skills.length == 0 do
        f.kept_basics = f.kit.basics
        roster.Attack[] kept = []
        for a in f.kit.skills do
            kept.push(a)
        end
        f.kept_skills = kept
        f.kept_ultimate = f.kit.ultimate
    end
    random_chain(f)
    roster.Attack[] wild = []
    for i in 0..<4 do
        wild.push(random_skill())
    end
    f.kit.skills = wild
    f.kit.ultimate = roster.adapt(ultimate_pool[pick_index(ultimate_pool.length)], 0)
    say(f.body.top() + ap.Vec3(0, 0.3, 0), "EVERYTHING IS RANDOM", f.kit.look.accent)
end

function restore_moves(Fighter f)
    if f.kept_skills.length == 0 do
        return
    end
    f.kit.basics = f.kept_basics
    f.kit.skills = f.kept_skills
    f.kit.ultimate = f.kept_ultimate
    f.kept_skills = []
end

# After a skill is used: a random one is dealt in its place.
function reshuffle(Fighter f, int slot)
    if mx(f).randomize or (f.kit.copycat and slot == 3) do
        f.kit.skills[slot] = random_skill()
    end
end

# CAT is hit: unless it has locked it, skill 1 becomes that move.
function copy_move(Fighter o, Fighter f, roster.Attack a)
    if not o.kit.copycat or o.copy_locked or not roster.portable(a) do
        return
    end
    var mine = o.kit.skills[0] if o.kept_skills.length == 0 else o.kept_skills[0]
    if mine.name == a.name do
        return
    end
    var b = roster.adapt(a, 20)
    b.note = "Copied from {f.kit.name}"
    if o.kept_skills.length > 0 do
        o.kept_skills[0] = b
    else do
        o.kit.skills[0] = b
    end
    say(o.body.top() + ap.Vec3(0, 0.55, 0), "COPIED {a.name.upper()}", o.kit.look.accent)
end

function toggle_lock(Fighter f)
    f.copy_locked = not f.copy_locked
    f.kit.skills[1].name = "Unlock" if f.copy_locked else "Lock"
    say(f.body.top(), "LOCKED" if f.copy_locked else "UNLOCKED", f.kit.look.accent)
    sound_at(snd_lock, f.body.position, 0.6, 1.4 if f.copy_locked else 1.0)
    rings.push(Ring(f.body.center(), f.kit.look.accent, 3, 0.2, true))
end

# COMBATANT: a weapon of the arsenal in hand. The skills of the one put away keep cooling down.
function equip(Fighter f, int index)
    var kit = f.kit
    if kit.arsenal.length == 0 do
        return
    end
    if f.arm_cools.length < kit.arsenal.length * 3 do
        f.arm_cools = []
        for i in 0..<kit.arsenal.length * 3 do
            f.arm_cools.push(0)
        end
    end
    for i in 0..<3 do
        f.arm_cools[f.arm * 3 + i] = f.cooldowns[i]
    end
    var arm = kit.arsenal[index]
    for i in 0..<3 do
        f.cooldowns[i] = f.arm_cools[index * 3 + i]
        kit.skills[i] = arm.skills[i]
    end
    f.arm = index
    kit.basics = arm.basics
    kit.fallback = arm.fallback
    kit.ai_range = arm.ai_range
    kit.look.weapon = arm.weapon
end

function swap_weapon(Fighter f)
    var kit = f.kit
    if kit.arsenal.length == 0 do
        return
    end
    var next = (f.arm + 1) % kit.arsenal.length
    equip(f, next)
    var hand = puppet.muzzle(kit.look, f.body.position, f.heading)
    say(f.body.top(), kit.arsenal[next].name, kit.look.accent)
    sound_at(snd_shing if next != 1 else snd_swing, hand, 0.5, 1.2)
    later(snd_lock, hand, 4, 0.4, 0.9)
    for i in 0..<8 do
        streak(hand, unit(scatter(1)) * 3, kit.look.metal, 0.15, 0.3)
    end
end

# A thrown dagger comes to rest on the floor, to be picked up again.
function drop_dagger(Shot s, ap.Vec3 at)
    var owner = fighters[s.owner]
    if s.attack.shot != roster.SHOT_KNIFE or owner.kit.arsenal.length == 0 or pickups.length >= 14 do
        return
    end
    var spot = flat(at)
    if spot.length() > ARENA - 0.6 do
        spot = unit(spot) * (ARENA - 0.6)
    end
    pickups.push(Pickup(s.owner, ap.Vec3(spot.x, 0, spot.z), heading_of(s.velocity)))
end

function update_pickups()
    Pickup[] lying = []
    for p in pickups do
        var g = fighters[p.owner]
        if g.state != STATE_DOWN and g.bar < g.kit.bar_max and flat_distance(g.body.position, p.position) < 1.0 do
            g.bar = math.min(g.bar + 1, g.kit.bar_max)
            sound_at(snd_reload, p.position, 0.4, 1.4)
            say(g.body.top(), "+1", g.kit.look.accent)
        else do
            lying.push(p)
        end
    end
    pickups = lying
end

# Every dagger lying about flies back to the hand, cutting whoever is in the way.
function recall_daggers(Fighter f, Fighter o)
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    var count = 0
    Pickup[] lying = []
    for p in pickups do
        if p.owner != f.id do
            lying.push(p)
            continue
        end
        count += 1
        var from = p.position + ap.Vec3(0, 0.3, 0)
        for i in 0..<4 do
            streak(from.lerp(hand, double(i) / 4), unit(hand - from) * 16, f.kit.look.metal, 0.18, 0.5)
        end
        if o.state != STATE_DOWN and off_line(o.body.center(), from, hand) < 0.7 do
            apply_hit(f, o, recall_hit, 1, from, false)
        end
    end
    pickups = lying
    if count == 0 do
        deny(f, "NO DAGGERS OUT")
        return
    end
    f.bar = math.min(f.bar + double(count), f.kit.bar_max)
    say(f.body.top(), "+{count}", f.kit.look.accent)
    sound_at(snd_dash, hand, 0.5, 1.5)
    later(snd_reload, hand, 6, 0.5, 1.2)
end

# --- MIRRORMAN's copies.

function mirror_count(int owner) returns int
    var n = 0
    for mi in mirrors do
        if mi.owner == owner do
            n += 1
        end
    end
    return n
end

# Where a copy stands: its owner's place, turned `angle` degrees around their opponent.
function mirror_spot(Fighter f, double angle) returns ap.Vec3
    var o = other(f)
    var rel = flat(f.body.position - o.body.position)
    var a = angle * math.PI / 180
    var turned = ap.Vec3(rel.x * math.cos(a) + rel.z * math.sin(a), 0, -rel.x * math.sin(a) + rel.z * math.cos(a))
    var spot = flat(o.body.position) + turned
    if spot.length() > ARENA - 0.5 do
        spot = unit(spot) * (ARENA - 0.5)
    end
    return ap.Vec3(spot.x, f.body.position.y, spot.z)
end

function mirror_at(Mirror mi) returns ap.Vec3
    return mirror_spot(fighters[mi.owner], mi.angle)
end

function add_mirror(Fighter f, double angle, int life)
    if mirror_count(f.id) >= 4 do
        # The oldest one gives way.
        Mirror[] kept = []
        var dropped = false
        for mi in mirrors do
            if not dropped and mi.owner == f.id do
                dropped = true
            else do
                kept.push(mi)
            end
        end
        mirrors = kept
    end
    mirrors.push(Mirror(f.id, angle, life, ticks))
    var at = mirror_spot(f, angle) + ap.Vec3(0, 1, 0)
    rings.push(Ring(at, f.kit.look.accent, 4, 0.25, true))
    for i in 0..<10 do
        spark(at + scatter(0.6), scatter(1.5), ap.WHITE if i % 2 == 0 else f.kit.look.accent, 0.4, 0.07, 0)
    end
    sound_at(snd_shimmer, at, 0.5, 1.4)
end

function make_mirrors(Fighter f, Fighter o, roster.Attack a)
    for k in 0..<a.volley do
        var angle = 360.0 * double(k + 1) / double(a.volley + 1) + ap.random(-20, 20)
        add_mirror(f, angle, int(a.shot_life * 60))
    end
    sound_at(snd_flash, f.body.position, 0.5, 1.5)
end

# A copy is touched and breaks.
function shatter_mirror(Mirror gone)
    var owner = fighters[gone.owner]
    var at = mirror_at(gone) + ap.Vec3(0, 1, 0)
    Mirror[] kept = []
    for mi in mirrors do
        if mi != gone do
            kept.push(mi)
        end
    end
    mirrors = kept
    say(at + ap.Vec3(0, 0.8, 0), "SHATTER", ap.Color(200, 240, 255))
    sound_at(snd_parry, at, 0.6, 1.8)
    later(snd_shimmer, at, 3, 0.5, 1.6)
    for i in 0..<20 do
        streak(at + scatter(0.4), unit(scatter(1)) * ap.random(3, 7), ap.WHITE if i % 2 == 0 else owner.kit.look.accent, 0.3, 0.25, 0.05)
    end
end

# The copy of side `owner` that a blow or a shot at `at` touches, if any.
function mirror_touched(int owner, ap.Vec3 at, double size) returns Mirror
    for mi in mirrors do
        if mi.owner == owner and ticks - mi.born > 6 do
            var spot = mirror_at(mi)
            if flat_distance(spot, at) < 0.4 + size and at.y > spot.y - 0.1 and at.y < spot.y + 2.0 do
                return mi
            end
        end
    end
    return Mirror(-1, 0, 0, 0)
end

# A melee blow of `f` breaks any of the opponent's copies it sweeps through.
function break_mirrors(Fighter f, int owner, roster.Attack a)
    var forward = forward_of(f.heading)
    Mirror[] hit_ones = []
    for mi in mirrors do
        if mi.owner == owner do
            var spot = mirror_at(mi)
            if flat_distance(f.body.position, spot) <= a.reach + 0.4 and (a.radial or ap.in_cone(f.body.position, forward, spot, a.arc)) do
                hit_ones.push(mi)
            end
        end
    end
    for mi in hit_ones do
        shatter_mirror(mi)
    end
end

# Trade places with one of the copies: the copy stands where you were.
function glass_swap(Fighter f, Fighter o, roster.Attack a)
    Mirror[] mine = []
    for mi in mirrors do
        if mi.owner == f.id do
            mine.push(mi)
        end
    end
    if mine.length == 0 do
        blink(f, o, a.blink)
        return
    end
    var mi = mine[pick_index(mine.length)]
    var spot = mirror_at(mi)
    if world.overlaps(ap.Vec3(spot.x, 1, spot.z), 0.4) do
        blink(f, o, a.blink)
        return
    end
    var from = f.body.center()
    f.body.position = ap.Vec3(spot.x, f.body.position.y, spot.z)
    mi.angle = -mi.angle
    f.heading = f.heading - mi.angle
    f.knock = ap.Vec3(0, 0, 0)
    sound_at(snd_shimmer, from, 0.6, 1.8)
    sound_at(snd_flash, spot, 0.5, 1.6)
    for i in 0..<12 do
        spark(from + scatter(0.5), scatter(1), f.kit.look.accent, 0.3, 0.06, 0)
        spark(f.body.center() + scatter(0.5), scatter(1), ap.WHITE, 0.3, 0.06, 0)
    end
    if o.cpu do
        o.decoy = pick_index(mine.length + 1) - 1
    end
end

# Every copy bursts; whoever stands near one is cut by the shards.
function shatter_mirrors(Fighter f, Fighter o, roster.Attack a)
    Mirror[] mine = []
    for mi in mirrors do
        if mi.owner == f.id do
            mine.push(mi)
        end
    end
    if mine.length == 0 do
        deny(f, "NO COPIES")
        return
    end
    for mi in mine do
        var spot = mirror_at(mi)
        if o.state != STATE_DOWN and flat_distance(spot, o.body.position) < MIRROR_REACH do
            apply_hit(f, o, a, 1, spot, false)
        end
        for m in minions do
            if m.id == o.id and flat_distance(spot, m.body.position) < MIRROR_REACH do
                apply_hit(f, m, a, 1, spot, false)
            end
        end
        rings.push(Ring(spot + ap.Vec3(0, 0.1, 0), f.kit.look.accent, MIRROR_REACH / 0.3, 0.3))
        shatter_mirror(mi)
    end
    sound_at(snd_boom, f.body.position, 0.4, 1.8)
end

function update_mirrors()
    Mirror[] kept = []
    for mi in mirrors do
        mi.life -= 1
        var owner = fighters[mi.owner]
        if mi.life > 0 and owner.state != STATE_DOWN do
            kept.push(mi)
        else if mi.life <= 0 do
            var at = mirror_at(mi) + ap.Vec3(0, 1, 0)
            for i in 0..<8 do
                spark(at + scatter(0.5), scatter(0.8), owner.kit.look.accent, 0.3, 0.06, 0)
            end
        end
    end
    mirrors = kept
end

# In the HALL OF MIRRORS the copies never run out.
function keep_mirrors(Fighter u, Fighter o, int count)
    for mi in mirrors do
        if mi.owner == u.id do
            mi.life = math.max(mi.life, 90)
        end
    end
    mirror_clock -= 1
    if mirror_clock <= 0 and mirror_count(u.id) < count and u.state != STATE_DOWN do
        mirror_clock = MIRROR_REFORM
        add_mirror(u, ap.random(40, 320), 90)
    end
end

# Where `f` thinks the opponent is: the real one, or a copy they have been fooled by.
function target_of(Fighter f, Fighter o) returns ap.Vec3
    if mirrors.length == 0 or mirror_count(o.id) == 0 do
        return o.body.position
    end
    if not f.cpu do
        # The player goes after whichever one is in front of them.
        var best = o.body.position
        var off = math.abs(wrap(heading_of(o.body.position - f.body.position) - f.heading))
        for mi in mirrors do
            if mi.owner == o.id do
                var spot = mirror_at(mi)
                var turn = math.abs(wrap(heading_of(spot - f.body.position) - f.heading))
                if turn < off do
                    off = turn
                    best = spot
                end
            end
        end
        return best
    end
    if f.decoy >= 0 do
        var k = 0
        for mi in mirrors do
            if mi.owner == o.id do
                if k == f.decoy do
                    return mirror_at(mi)
                end
                k += 1
            end
        end
    end
    return o.body.position
end

# --- BOB's machines and clones; CARBON's walls.

function add_prop(Prop pr)
    props.push(pr)
    world = build_world()
end

function update_props()
    Prop[] standing = []
    var changed = false
    for pr in props do
        if pr.life > 0 do
            pr.life -= 1
        end
        if pr.life == 0 do
            changed = true
            for i in 0..<14 do
                spark(pr.position + ap.Vec3(ap.random(-0.6, 0.6), ap.random(0, pr.height), ap.random(-0.6, 0.6)),
                    ap.Vec3(ap.random(-1, 1), ap.random(0, 2), ap.random(-1, 1)), ap.Color(116, 96, 78), 1.0, 0.18, 9)
            end
            sound_at(snd_thud, pr.position, 0.5, 0.7)
        else do
            standing.push(pr)
        end
    end
    if changed do
        props = standing
        world = build_world()
    end
end

# A pillar of stone bursts out of the floor a few steps ahead. Anyone standing there goes up with it.
function raise_wall(Fighter f, Fighter o, roster.Attack a)
    var forward = forward_of(f.heading)
    var spot = flat(f.body.position) + forward * a.blink
    if spot.length() > ARENA - 1 do
        spot = unit(spot) * (ARENA - 1)
    end
    Prop[] kept = []
    var walls = 0
    var i = props.length - 1
    while i >= 0 do
        var pr = props[i]
        if pr.kind == PROP_WALL and pr.owner == f.id do
            walls += 1
        end
        i -= 1
    end
    if walls >= 3 do
        # The oldest crumbles to make room.
        var dropped = false
        for pr in props do
            if not dropped and pr.kind == PROP_WALL and pr.owner == f.id do
                dropped = true
            else do
                kept.push(pr)
            end
        end
        props = kept
    end
    Fighter[] near = [o]
    for m in minions do
        if m.id == o.id do
            near.push(m)
        end
    end
    for g in near do
        if g.state != STATE_DOWN and flat_distance(spot, g.body.position) < 1.1 do
            var away = unit(flat(g.body.position - spot))
            if away.length() < 0.5 do
                away = forward
            end
            g.body.position = ap.Vec3(spot.x + away.x * 1.2, g.body.position.y, spot.z + away.z * 1.2)
            apply_hit(f, g, a, 1, spot, false)
        end
    end
    add_prop(Prop(PROP_WALL, f.id, ap.Vec3(spot.x, 0, spot.z), 3.2, WALL_TICKS, ticks, f.heading))
    var at = ap.Vec3(spot.x, 0.1, spot.z)
    sound_at(snd_boom, at, 0.7, 0.6)
    sound_at(snd_thud, at, 0.8, 0.5)
    rings.push(Ring(at, f.kit.look.accent, 6, 0.3))
    burst(at, 24, ap.Color(130, 108, 86), 6, 0.6, 0.14)
    smoke(at, 10, 0.6, 1.2)
    stain(spot, ap.Color(30, 22, 16), 1.4, 8, 0.6)
end

# CARBON's chunk comes out of the floor in front of her.
function tear_ground(Fighter f)
    var at = f.body.position + forward_of(f.heading) * 0.8
    stain(at, ap.Color(26, 20, 14), 0.8, 6, 0.7)
    burst(at + ap.Vec3(0, 0.1, 0), 14, ap.Color(130, 108, 86), 4, 0.5, 0.12)
    sound_at(snd_thud, at, 0.7, 0.8)
end

# TELEMAN: change the channel, and the two of them are where the other was.
function switch_places(Fighter f, Fighter o)
    if o.state == STATE_DOWN do
        return
    end
    var mine = f.body.position
    var theirs = o.body.position
    leave_ghost(f, 0.3)
    leave_ghost(o, 0.3)
    f.body.position = ap.Vec3(theirs.x, mine.y, theirs.z)
    o.body.position = ap.Vec3(mine.x, theirs.y, mine.z)
    f.heading = heading_of(o.body.position - f.body.position)
    f.knock = ap.Vec3(0, 0, 0)
    o.knock = ap.Vec3(0, 0, 0)
    if o.state != STATE_HURT and o.safe == 0 do
        # A moment to work out which way is which.
        o.state = STATE_HURT
        o.stun = 20
        o.stun_total = 20
    end
    for g in [f, o] do
        for i in 0..<14 do
            var grey = int(ap.random(110, 250))
            spark(g.body.center() + scatter(0.5), scatter(1.4), ap.Color(grey, grey, grey), 0.35, 0.08, 0)
        end
        rings.push(Ring(g.body.position + ap.Vec3(0, 0.08, 0), f.kit.look.accent, 5, 0.25))
    end
    sound_at(snd_lock, mine, 0.6, 1.6)
    sound_at(snd_flash, theirs, 0.6, 1.4)
    say(o.body.top(), "CHANGED CHANNEL", f.kit.look.accent)
end

function minion_count(int side) returns int
    var n = 0
    for m in minions do
        if m.id == side do
            n += 1
        end
    end
    return n
end

# BOB's machine makes a weak copy of the one he has been dosing, to fight on his side.
function spawn_minion(Fighter f, Fighter o)
    Prop[] machines = []
    for pr in props do
        if pr.kind == PROP_MACHINE and pr.owner == f.id do
            machines.push(pr)
        end
    end
    var spot = f.body.position - forward_of(f.heading) * 1.2
    if machines.length > 0 do
        var pr = machines[pick_index(machines.length)]
        spot = pr.position + forward_of(pr.yaw) * 1.3
    end
    var m = new_fighter(f.id, o.pick)
    m.minion = true
    m.cpu = true
    m.power_scale = MINION_POWER
    m.max_health = m.kit.health * MINION_HEALTH
    m.health = m.max_health
    m.shown_health = m.max_health
    m.bar = m.kit.bar_start
    m.body.position = ap.Vec3(spot.x, 0, spot.z)
    m.heading = heading_of(o.body.position - spot)
    m.cool = 30
    m.safe = 20
    prepare_kit(m)
    m.pose = target_pose(m)
    minions.push(m)
    var green = ap.Color(120, 255, 120)
    var at = m.body.center()
    burst(at, 30, green, 5, 0.6, 0.1)
    rings.push(Ring(m.body.position + ap.Vec3(0, 0.1, 0), green, 6, 0.4))
    rings.push(Ring(at, green, 4, 0.3, true))
    sound_at(snd_charge, at, 0.7, 0.8)
    later(snd_splash, at, 6, 0.6, 0.8)
    say(m.body.top() + ap.Vec3(0, 0.3, 0), "CLONE OF {o.kit.name}", green)
end

# A dose lands: enough of them and the machine makes a clone.
function count_dose(Fighter f, Fighter o)
    if o.minion do
        return
    end
    var labs = mx(f).labs
    var need = 1 if labs else f.kit.inject_need
    var limit = 2 if labs else 1
    f.injects = math.min(f.injects + 1, need)
    if f.injects < need do
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "DOSE {f.injects}/{need}", f.kit.look.accent)
        return
    end
    if minion_count(f.id) >= limit do
        say(f.body.top(), "ONE CLONE AT A TIME" if limit == 1 else "CLONE LIMIT", ap.GRAY)
    else if f.clone_cool > 0 and not labs do
        say(f.body.top(), "MACHINE COOLING {(f.clone_cool + 59) // 60}s", ap.GRAY)
    else do
        f.injects = 0
        spawn_minion(f, o)
    end
end

function minion_dies(Fighter m)
    var green = ap.Color(120, 255, 120)
    var at = m.body.center()
    burst(at, 26, green, 4, 0.6, 0.1)
    smoke(at, 10, 0.5, 1.0)
    sound_at(snd_splash, at, 0.7, 0.6)
    sound_at(snd_hiss, at, 0.5, 0.8)
    say(m.body.top(), "DISSOLVED", green)
    var owner = fighters[m.id]
    owner.clone_cool = int(owner.kit.clone_cool * 60)
end

# A fighter's moves set up for a new round (or a new clone).
function prepare_kit(Fighter f)
    restore_moves(f)
    if f.kit.arsenal.length > 0 do
        f.arm_cools = []
        f.arm = 0
        equip(f, 0)
    end
    if f.kit.copycat do
        f.copy_locked = false
        f.kit.skills[1].name = "Lock"
        f.kit.skills[3] = random_skill()
    end
end

# Begins a move if the bar allows. True when the button press was used up.
function begin_attack(Fighter f, roster.Attack a, int hits)
    f.state = STATE_ATTACK
    f.frame = 0
    f.move = a
    f.move_hits = hits
    f.hits_done = 0
    f.serial += 1
    f.ambush = f.cloaked
    f.connected = false
    f.blocked = false
    f.empowered = false
    if not a.per_hit do
        pay(f, a.cost)
    end
    if a.evade do
        f.dash_way = unit(flat(f.wish)) if f.wish.length() > 0.2 else forward_of(f.heading) * -1.0
        sound_at(snd_dash, f.body.position, 0.4, 0.8)
        if a.buff == roster.BUFF_POWER do
            # Thrown clear by a blast at their own feet.
            var feet = f.body.position + ap.Vec3(0, 0.2, 0)
            sound_at(snd_boom, feet, 0.6, 1.5)
            sound_at(snd_shot, feet, 0.6, 0.6)
            burst(feet, 16, ap.Color(255, 190, 110), 5, 0.4, 0.1)
            smoke(feet, 8, 0.4, 0.8)
            rings.push(Ring(feet, f.kit.look.accent, 6, 0.25))
        end
    end
    sound_at(weapon_swing_sound(f), f.body.position, 0.35, 0.8 if a.startup > 14 else 1.2)
    skill_begins(f, a)
end

function deny(Fighter f, string words)
    sound_at(snd_deny, f.body.position, 0.4)
    say(f.body.top(), words, ap.GRAY)
end

# Whether skill `slot` is off cooldown and paid for.
function move_ready(Fighter f, int slot) returns bool
    var a = f.kit.skills[slot]
    return f.cooldowns[slot] == 0 and can_pay(f, a.cost) and a.kind != roster.KIND_RELOAD
end

# Round wins that take the match in the current mode.
function wins_needed() returns int
    if mode == MODE_ENDLESS or mode == MODE_RANDOM do
        return 1000000
    end
    return ROUNDS_TO_WIN if mode == MODE_CLASSIC else 3
end

# Whether the five-slot round display (two each side and the finale) is in use.
function finale_slots() returns bool
    return mode == MODE_FINALE or mode == MODE_SHOWDOWN
end

# Whether this round can decide a Finale match: someone's two side slots are full.
function finale_round() returns bool
    return finale_slots() and (fighters[0].wins >= 2 or fighters[1].wins >= 2)
end

# SHOWDOWN: anyone who lost a round hands over to the next fighter of their team. Round wins and
# the super bar go with the side, not the fighter.
function next_fighters()
    banner_sub = ""
    if mode == MODE_RANDOM do
        # A fresh pair, dealt at random; wins and the super bar stay with the side.
        for i in 0..<2 do
            var f = fighters[i]
            var g = new_fighter(i, pick_index(cast.length))
            g.wins = f.wins
            g.energy = f.energy
            fighters[i] = g
        end
        banner_sub = "{fighters[0].kit.name}  VS  {fighters[1].kit.name}"
        banner_sub_color = MAX_GOLD
        return
    end
    if mode != MODE_SHOWDOWN do
        return
    end
    var changed = false
    for i in 0..<2 do
        var f = fighters[i]
        # Rounds this side has lost are the rounds the other side has won.
        var want = teams[i][math.min(fighters[1 - i].wins, TEAM_SIZE - 1)]
        if want != f.pick do
            var g = new_fighter(i, want)
            g.wins = f.wins
            g.energy = f.energy
            fighters[i] = g
            changed = true
            banner_sub = "{g.kit.name} STEPS IN"
            banner_sub_color = g.kit.look.accent
        end
    end
end

# --- Maximums ------------------------------------------------------------------------------------

class WildPortal
    ap.Vec3 position
    int born
end

var max_owner = -1                   # who set off the maximum in force (-1: none)
var max_def = roster.Maximum()       # ...which one...
var max_left = 0                     # ...and the ticks it has left
var merge_owner = -1                 # who set off a second super inside it, merging the two (-1: none)
var merge_def = roster.Maximum()
var merge_left = 0
var half_dir = ap.Vec3(0, 0, 1)      # in a merge the first place is on this side of the seam...
var half_side = 0                    # ...and while one half is drawn: 1 the first, -1 the second, 0 both
var no_max = roster.Maximum()        # does nothing: what everyone else has
var max_cut = 0                      # ticks left of a cutscene
var cut_kind = CUT_SUPER
var cut_len = MAX_CUT_TICKS
var cut_hit = MAX_HIT
var cut_swap = MAX_SWAP
var cut_user = 0
var cut_def = roster.Maximum()
var cut_def2 = roster.Maximum()      # a merge: the place that was already there
var cut_anim = roster.ANIM_FOCUS
var cut_anim2 = roster.ANIM_FOCUS
var cut_title = ""
var cut_yaw = 0.0
var crumble = 0.0                    # 0..1: how far the old arena has come down (or has yet to rise)
var return_flash = 0                 # the white-out as the arena comes back
double[] strike_clocks = [0.0, 0.0]  # for the first place in force and the merged one
var wild_clock = 0.0
var wild_glow = ap.WHITE
WildPortal[] wild_portals = []
var mirror_clock = 0
var merge_pending = -1               # who has asked to merge into the super whose cutscene is on (-1: nobody)

# The deciding round of a FINALE or SHOWDOWN match: two rounds each.
function decider() returns bool
    return finale_slots() and fighters.length == 2 and fighters[0].wins == 2 and fighters[1].wins == 2
end

# Rounds this fighter is behind by.
function behind(Fighter f) returns int
    # Capped, so an ENDLESS match does not snowball the other way.
    return math.min(math.max(other(f).wins - f.wins, 0), 2)
end

# How much faster the super bar fills for whoever is behind.
function catch_up(Fighter f) returns double
    return 1 + UNDERDOG_SUPER * double(behind(f))
end

# Whether this fighter's own super is in force.
function in_super(Fighter f) returns bool
    return not f.minion and (max_owner == f.id or merge_owner == f.id)
end

# How fast a fighter's super bar fills: not at all inside their own super, faster inside someone
# else's, faster when behind on rounds, and never for a clone.
function gain(Fighter f) returns double
    if f.minion or in_super(f) do
        return 0
    end
    var rate = catch_up(f) * (1 + 0.6 * double(item_count(f, roster.ITEM_CHARGER)))
    if max_owner >= 0 do
        rate *= SUPER_FOE_GAIN
    end
    return rate
end

# The maximum working for this fighter, or one that does nothing.
function mx(Fighter f) returns roster.Maximum
    if f.minion do
        return no_max
    end
    if max_owner == f.id do
        return max_def
    end
    if merge_owner == f.id do
        return merge_def
    end
    return no_max
end

# Ticks this fighter's own super has left.
function super_left(Fighter f) returns int
    return merge_left if merge_owner == f.id else max_left
end

# Inside your own super, with the old super move still to use.
function encore_ready(Fighter f) returns bool
    return in_super(f) and max_cut == 0 and not f.encore_used
end

# Whether G does something for this fighter right now: a super, a merge, a switch-off, or the move.
function can_super(Fighter f) returns bool
    if f.minion or max_cut > 0 do
        return false
    end
    if encore_ready(f) do
        return true
    end
    if f.energy < roster.SUPER_MAX or in_super(f) do
        return false
    end
    if f.kit.maximum.jammer do
        return max_owner >= 0 and merge_owner < 0
    end
    # A merge only happens during the other one's cutscene (see update_cutscene).
    return max_owner < 0
end

# Whether `f` could merge their super into the one whose cutscene is playing.
function can_merge(Fighter f) returns bool
    return cut_kind == CUT_SUPER and max_cut > 0 and cut_user != f.id and merge_pending < 0 and not f.minion and
        f.energy >= roster.SUPER_MAX and not f.kit.maximum.jammer
end

# A second super is called during the first's cutscene: it merges as soon as the first place appears.
function request_merge(Fighter f)
    merge_pending = f.id
    f.energy = 0
    say(f.body.top() + ap.Vec3(0, 0.3, 0), "MERGE", f.kit.look.accent)
    sound_at(snd_bell, f.body.position, 0.8, 0.5)
    sound_at(snd_rift, f.body.position, 0.7, 0.6)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), f.kit.maximum.glow, 8, 0.5))
end

# Starts a cutscene of `kind`, `length` ticks long, for `f`.
function begin_cut(Fighter f, int kind, int length)
    var o = other(f)
    cut_kind = kind
    cut_len = length
    cut_hit = length * MAX_HIT // MAX_CUT_TICKS
    cut_swap = length * MAX_SWAP // MAX_CUT_TICKS
    cut_user = f.id
    max_cut = length
    cut_yaw = f.heading + 25
    f.energy = 0
    f.state = STATE_IDLE
    f.frame = 0
    o.knock = ap.Vec3(0, 0, 0)
    banner = ""
    pad.clear()
end

function begin_maximum(Fighter f)
    var own = f.kit.maximum
    if own.jammer do
        begin_jam(f)
        return
    end
    begin_cut(f, CUT_SUPER, own.cut_ticks)
    merge_pending = -1
    cut_title = own.name
    cut_def = own
    cut_anim = own.anim
    f.encore_used = false
    sound_at(snd_bell, f.body.position, 0.8, 0.4)
    sound_at(snd_charge, f.body.position, 0.7, 0.5)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), MAX_GOLD, 6, 0.5))
    if own.cut_ticks < MAX_CUT_TICKS do
        # A fast one: it is on before anyone can react.
        sound_at(snd_flash, f.body.position, 0.7, 0.7)
    end
end

# A super called inside someone else's: the two places tear into each other and merge.
function begin_merge(Fighter f)
    var first = fighters[max_owner]
    begin_cut(f, CUT_MERGE, MERGE_TICKS)
    cut_title = "DIMENSIONS COLLIDE"
    cut_def = f.kit.maximum
    cut_def2 = max_def
    cut_anim = cut_def.anim
    cut_anim2 = first.kit.maximum.anim
    f.encore_used = false
    first.state = STATE_IDLE
    first.frame = 0
    var mid = (f.body.center() + first.body.center()) * 0.5
    sound_at(snd_bell, mid, 0.8, 0.35)
    later(snd_bell, mid, 8, 0.7, 0.5)
    sound_at(snd_charge, f.body.position, 0.7, 0.5)
    sound_at(snd_charge, first.body.position, 0.7, 0.6)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), cut_def.glow, 6, 0.5))
    rings.push(Ring(first.body.position + ap.Vec3(0, 0.1, 0), cut_def2.glow, 6, 0.5))
end

# TELEMAN's super: only inside someone else's, which it switches off like a television.
function begin_jam(Fighter f)
    begin_cut(f, CUT_JAM, JAM_TICKS)
    cut_title = f.kit.maximum.name
    cut_def = max_def
    cut_anim = f.kit.maximum.anim
    sound_at(snd_lock, f.body.position, 0.8, 0.8)
    later(snd_zap_file, f.body.position, 4, 0.6, 0.7)
end

# The cutscene: the wind-up, the moment it goes off, the arena coming down, the new place.
function update_cutscene()
    var t = cut_len - max_cut
    max_cut -= 1
    var f = fighters[cut_user]
    var o = other(f)
    f.pose = puppet.blend(f.pose, target_pose(f), 0.3)
    o.pose = puppet.blend(o.pose, target_pose(o), 0.3)
    if cut_kind == CUT_JAM do
        update_jam(f, o, t)
        update_effects()
        return
    end
    if can_merge(o) do
        # G during the other one's cutscene: the two supers merge. The CPU does it on NORMAL and HARD.
        var wants = pad.buffered("super", 10) if not o.cpu else (cpu_mode == CPU_FIGHTS and level >= 1 and t >= LEVEL_REACT[level])
        if wants do
            if not o.cpu do
                pad.consume("super")
            end
            request_merge(o)
        end
    end
    if merge_pending >= 0 and t >= cut_swap do
        # The first place is up; the second tears straight into it.
        var second = fighters[merge_pending]
        merge_pending = -1
        if t == cut_swap do
            swap_to_maximum(f)
        end
        f.safe = math.max(f.safe, 30)
        begin_merge(second)
        update_effects()
        return
    end
    var merging = cut_kind == CUT_MERGE
    var center = f.body.center()
    if merging do
        center = (f.body.center() + o.body.center()) * 0.5
    end
    var tint = f.kit.look.accent
    if t < cut_hit do
        if t % 2 == 0 do
            gather(f.body.center(), 3, cut_def.glow if t % 4 == 0 else tint, 1.8, 0.3, 0.07)
            if merging do
                gather(o.body.center(), 3, cut_def2.glow if t % 4 == 0 else o.kit.look.accent, 1.8, 0.3, 0.07)
                # The two powers reach for each other.
                var along = ap.random(0, 1)
                spark(f.body.center().lerp(o.body.center(), along) + scatter(0.2), scatter(0.6),
                    cut_def.glow if along < 0.5 else cut_def2.glow, 0.3, 0.08, 0)
            end
        end
        if t % 18 == 0 do
            sound_at(snd_charge, center, 0.4, 0.6 + double(t) / double(math.max(cut_hit, 1)))
        end
    end
    if t == cut_hit do
        sound_at(snd_ko, center, 0.8, 0.8)
        sound_at(snd_boom, center, 0.8, 0.6)
        later(snd_thud, center, 6, 0.8, 0.5)
        burst(center, 50, cut_def.glow, 9, 0.7, 0.12)
        burst(center, 30, tint, 6, 0.6, 0.1)
        rings.push(Ring(flat(center) + ap.Vec3(0, 0.1, 0), cut_def.glow, 14, 0.6))
        rings.push(Ring(center, ap.WHITE, 10, 0.4, true))
        if merging do
            burst(center, 50, cut_def2.glow, 9, 0.7, 0.12)
            rings.push(Ring(flat(center) + ap.Vec3(0, 0.1, 0), cut_def2.glow, 10, 0.6))
            later(snd_ko, center, 10, 0.7, 0.6)
        end
    end
    if t >= cut_hit and t < cut_swap do
        if merging do
            # A seam tears open across the world, each side bleeding into the other.
            var way = unit(flat(o.body.position - f.body.position))
            var across = ap.Vec3(way.z, 0, -way.x)
            for i in 0..<3 do
                var at = across * ap.random(-14, 14) + ap.Vec3(0, ap.random(0, 7), 0)
                streak(at, way * ap.random(-3, 3) + ap.Vec3(0, ap.random(-2, 4), 0), cut_def.glow if i % 2 == 0 else cut_def2.glow,
                    0.4, 0.8, 0.07)
            end
            if t % 8 == 0 do
                sound_at(snd_rift, center + across * ap.random(-6, 6), 0.5, ap.random(0.5, 0.8))
            end
        else do
            crumble = double(t - cut_hit) / double(math.max(cut_swap - cut_hit, 1))
            # Stone coming off the pillars, dust off the floor's edge.
            for pl in pillars do
                if ap.chance(0.5) do
                    spark(pl.base + ap.Vec3(ap.random(-0.6, 0.6), ap.random(0, pl.height), ap.random(-0.6, 0.6)),
                        ap.Vec3(ap.random(-1, 1), ap.random(0, 2), ap.random(-1, 1)), ap.Color(90, 86, 110), 1.2, 0.2, 9)
                end
            end
            if ap.chance(0.6) do
                var edge = forward_of(ap.random(0, 360)) * (ARENA + 0.8)
                spark(edge, ap.Vec3(0, ap.random(1, 3), 0), ap.Color(110, 100, 130), 1.0, 0.25, 6)
            end
            if t % 10 == 0 do
                sound_at(snd_thud, ap.Vec3(ap.random(-8, 8), 0, ap.random(-8, 8)), 0.6, ap.random(0.4, 0.7))
                sound_at(snd_boom, center, 0.3, 0.4)
            end
        end
    end
    if t == cut_swap do
        if merging do
            swap_to_merge(f)
        else do
            swap_to_maximum(f)
        end
    end
    if max_cut == 0 do
        f.safe = math.max(f.safe, 30)
        o.safe = math.max(o.safe, 30)
        say(f.body.top(), cut_def.place, cut_def.glow)
    end
    update_effects()
end

# TELEMAN aims the remote: click, the picture collapses to a dot, and the super is gone.
function update_jam(Fighter f, Fighter o, int t)
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    if t < JAM_CLICK do
        for i in 0..<3 do
            var grey = int(ap.random(120, 250))
            spark(hand + scatter(0.25), scatter(1.2), ap.Color(grey, grey, grey), 0.25, 0.07, 0)
        end
    end
    if t == JAM_CLICK do
        sound_at(snd_lock, hand, 0.8, 1.7)
        sound_at(snd_zap_file, cam_focus, 0.7, 0.5)
        later(snd_charge, cam_focus, 2, 0.6, 2.4)
        for i in 0..<12 do
            streak(hand, unit(o.body.center() - hand + scatter(0.3)) * 14, f.kit.look.accent, 0.2, 0.6)
        end
    end
    if t == JAM_DARK do
        var a = f.kit.ultimate
        super_over(fighters[max_owner], max_def)
        restore_arena(max_def.glow)
        return_flash = 0
        # Back on the air, they are left reeling.
        var damage = a.damage * o.kit.armor * f.kit.greed * (1 - UNDERDOG_GUARD * double(behind(o)))
        o.health -= damage
        o.state = STATE_HURT
        o.stun = a.stun
        o.stun_total = a.stun
        o.knock = ap.Vec3(0, 0, 0)
        o.safe = 0
        o.since_hit = 0
        o.taken = 1
        o.encore_used = true
        if o.cloaked do
            set_cloak(o, false)
        end
        say(o.body.top() + ap.Vec3(0, 0.3, 0), "SWITCHED OFF", f.kit.look.accent)
        say(o.body.top(), "{int(damage + 0.5)}", ap.Color(255, 235, 200))
        sound_at(snd_ko, o.body.position, 0.8, 1.2)
        sound_at(snd_heavy, o.body.position, 0.8, 0.7)
        for i in 0..<30 do
            var grey = int(ap.random(120, 255))
            spark(o.body.center() + scatter(0.6), scatter(4), ap.Color(grey, grey, grey), 0.6, 0.09, 2)
        end
        rings.push(Ring(o.body.position + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 9, 0.4))
    end
    if max_cut == 0 do
        f.safe = math.max(f.safe, 20)
    end
end

function cutscene_camera()
    var f = fighters[cut_user]
    var t = double(cut_len - max_cut)
    var close = math.min(t / double(math.max(cut_hit, 1)), 1.0)
    var wide = math.clamp((t - double(cut_hit)) / 40, 0.0, 1.0)
    var focus = f.body.center() + ap.Vec3(0, 0.25, 0)
    var dist = 4.4 - 1.4 * close + 9 * puppet.smooth(wide)
    var pitch = 8 + 22 * puppet.smooth(wide)
    if cut_kind == CUT_MERGE do
        # Both of them, and the tear between.
        var o = other(f)
        focus = (f.body.center() + o.body.center()) * 0.5 + ap.Vec3(0, 0.25, 0)
        var apart = flat_distance(f.body.position, o.body.position)
        dist = 3.5 + apart * 0.7 - 1.0 * close + 7 * puppet.smooth(wide)
        cut_yaw = heading_of(o.body.position - f.body.position) + 90
    else if cut_kind == CUT_JAM do
        # Over the remote's shoulder, at whoever is being switched off.
        var o = other(f)
        focus = f.body.center().lerp(o.body.center(), 0.6) + ap.Vec3(0, 0.3, 0)
        dist = 4.5 + flat_distance(f.body.position, o.body.position) * 0.5
        pitch = 12
        cut_yaw = heading_of(o.body.position - f.body.position) + 160
    end
    if t >= double(cut_hit) and t < double(cut_hit + 14) and cut_kind != CUT_JAM do
        focus = focus + scatter(0.18 * (1 - (t - double(cut_hit)) / 14))
    end
    camera = ap.orbit(focus, cut_yaw + t * 0.5, pitch, dist)
    cam_focus = focus
    cam_distance = dist
    cam_yaw = cut_yaw + t * 0.5 - 24
end

# The old arena is gone: the user's place takes over.
function swap_to_maximum(Fighter f)
    max_owner = f.id
    max_def = cut_def
    crumble = 0
    pillars_up = false
    world = build_world()
    apply_max_look(max_def)
    strike_clocks = [0.0, 0.0]
    wild_clock = 2.5
    wild_portals = []
    max_left = int(max_def.seconds * 60)
    super_starts(f, max_def)
end

# Two places at once: each fills the half of the world on its owner's side of the seam.
function swap_to_merge(Fighter f)
    var first = fighters[max_owner]
    merge_owner = f.id
    merge_def = cut_def
    merge_left = int(merge_def.seconds * 60)
    half_dir = unit(flat(first.body.position - f.body.position))
    if half_dir.length() < 0.5 do
        half_dir = ap.Vec3(0, 0, 1)
    end
    strike_clocks[1] = 0
    apply_merge_look()
    super_starts(f, merge_def)
end

# What a super sets up the moment its place appears.
function super_starts(Fighter f, roster.Maximum m)
    if m.randomize do
        randomize_moves(f)
    end
    if m.labs do
        # More machines along the edge of the lab.
        for k in 0..<2 do
            var around = heading_of(f.body.position) + (120.0 if k == 0 else -120.0)
            var spot = forward_of(around) * (ARENA - 1.6)
            add_prop(Prop(PROP_MACHINE, f.id, ap.Vec3(spot.x, 0, spot.z), 1.9, -1, ticks, around + 180, true))
        end
    end
    if m.clones > 0 do
        # The maze fills with copies at once.
        mirror_clock = MIRROR_REFORM
        for k in 0..<m.clones - mirror_count(f.id) do
            add_mirror(f, 360.0 * double(k + 1) / double(m.clones + 1), 90)
        end
    end
end

# A super's place is gone: whatever it changed about its owner goes back.
function super_over(Fighter f, roster.Maximum m)
    if m.randomize do
        restore_moves(f)
    end
    if m.clones > 0 do
        for mi in mirrors do
            if mi.owner == f.id do
                mi.life = math.min(mi.life, 30)
            end
        end
    end
    if m.labs do
        Prop[] kept = []
        for pr in props do
            if not (pr.super_only and pr.owner == f.id) do
                kept.push(pr)
            else do
                burst(pr.position + ap.Vec3(0, 1, 0), 16, m.glow, 4, 0.5, 0.1)
            end
        end
        props = kept
        world = build_world()
    end
end

# Time is up for the first place in force.
function finish_maximum()
    super_over(fighters[max_owner], max_def)
    if merge_owner >= 0 do
        # The merge comes apart, and the second place takes the whole arena.
        max_owner = merge_owner
        max_def = merge_def
        max_left = merge_left
        merge_owner = -1
        strike_clocks[0] = strike_clocks[1]
        apply_max_look(max_def)
        return_flash = 16
        sound_at(snd_boom, cam_focus, 0.6, 0.7)
        return
    end
    restore_arena(max_def.glow)
end

# Time is up for the second, merged place: the first has the arena to itself again.
function end_merge()
    super_over(fighters[merge_owner], merge_def)
    merge_owner = -1
    apply_max_look(max_def)
    return_flash = 16
    sound_at(snd_boom, cam_focus, 0.6, 0.7)
end

# The arena pulls itself back together around the fighters.
function restore_arena(ap.Color glow)
    max_owner = -1
    merge_owner = -1
    wild_portals = []
    for f in fighters do
        for pl in pillars do
            var off = flat(f.body.position - pl.base)
            if off.length() < 1.1 do
                var away = unit(off) if off.length() > 0.05 else ap.Vec3(1, 0, 0)
                f.body.position = ap.Vec3(pl.base.x + away.x * 1.2, f.body.position.y, pl.base.z + away.z * 1.2)
            end
        end
    end
    pillars_up = true
    world = build_world()
    crumble = 1
    return_flash = 24
    apply_area()
    sound_at(snd_boom, cam_focus, 0.6, 0.5)
    sound_at(snd_bell, cam_focus, 0.5, 0.6)
    for pl in pillars do
        burst(pl.base + ap.Vec3(0, 0.3, 0), 8, glow, 3, 0.5, 0.1)
    end
end

# Back to the Purgatory, standing: at the start of every round.
function end_maximum()
    max_cut = 0
    merge_pending = -1
    return_flash = 0
    if merge_owner >= 0 and merge_owner < fighters.length do
        super_over(fighters[merge_owner], merge_def)
    end
    if max_owner >= 0 and max_owner < fighters.length do
        super_over(fighters[max_owner], max_def)
    end
    merge_owner = -1
    if max_owner >= 0 or not pillars_up or crumble > 0 do
        max_owner = -1
        crumble = 0
        pillars_up = true
        world = build_world()
        apply_area()
    end
    wild_portals = []
end

function apply_max_look(roster.Maximum m)
    sky_now = m.sky
    lamp_now = m.glow
    mote_now = m.mote
    drift_now = m.drift
    ap.ambient(m.ambient)
    ap.sun(ap.Vec3(-0.35, -1, -0.3), m.sun)
    ap.fog(m.sky, m.fog_near, m.fog_far)
    stone.color(m.ground)
    pillar_stone.color(m.ground)
    monolith_look.color(m.ground)
    rim_look.color(m.glow.brightness(0.4))
    rim_look.glow(m.glow, 1.6)
    floor_look.color(m.floor)
end

# Half of each: the light, the air and the stone of two places at once.
function apply_merge_look()
    var a = max_def
    var b = merge_def
    sky_now = a.sky.lerp(b.sky, 0.5)
    lamp_now = a.glow.lerp(b.glow, 0.5)
    mote_now = a.mote.lerp(b.mote, 0.5)
    drift_now = (a.drift + b.drift) / 2
    ap.ambient(a.ambient.lerp(b.ambient, 0.5))
    ap.sun(ap.Vec3(-0.35, -1, -0.3), a.sun.lerp(b.sun, 0.5))
    ap.fog(sky_now, (a.fog_near + b.fog_near) / 2, (a.fog_far + b.fog_far) / 2)
    stone.color(a.ground.lerp(b.ground, 0.5))
    pillar_stone.color(a.ground.lerp(b.ground, 0.5))
    monolith_look.color(a.ground.lerp(b.ground, 0.5))
    rim_look.color(a.glow.lerp(b.glow, 0.5).brightness(0.4))
    rim_look.glow(a.glow.lerp(b.glow, 0.5), 1.6)
    floor_look.color(a.floor.lerp(b.floor, 0.5))
end

function area_title() returns string
    if merge_owner >= 0 do
        return "{max_def.place} + {merge_def.place}"
    end
    return max_def.place if max_owner >= 0 else areas[area_to].name
end

function area_glow() returns ap.Color
    return max_def.glow if max_owner >= 0 else areas[area_to].glow
end

# What the places in force keep doing.
function update_maximum()
    if max_owner < 0 do
        # After a super, the pillars rise back out of the floor.
        if crumble > 0 and max_cut == 0 do
            crumble = math.max(crumble - 1.0 / 50, 0.0)
        end
        return_flash = math.max(return_flash - 1, 0)
        return
    end
    return_flash = math.max(return_flash - 1, 0)
    max_left -= 1
    if merge_owner >= 0 do
        merge_left -= 1
        if merge_left <= 0 do
            end_merge()
        end
    end
    if max_left <= 0 do
        finish_maximum()
        if max_owner < 0 do
            return
        end
    end
    scene_life(max_def.scene)
    if merge_owner >= 0 do
        scene_life(merge_def.scene)
        # The seam keeps sparking.
        var across = ap.Vec3(half_dir.z, 0, -half_dir.x)
        spark(across * ap.random(-ARENA, ARENA) + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(1, 3), 0),
            max_def.glow if ap.chance(0.5) else merge_def.glow, 0.8, 0.07, -0.5)
    end
    run_maximum(fighters[max_owner], max_def, 0)
    if merge_owner >= 0 do
        run_maximum(fighters[merge_owner], merge_def, 1)
    end
end

# One place's effects, for its owner `u`.
function run_maximum(Fighter u, roster.Maximum m, int k)
    var o = other(u)
    var dt = 1.0 / 60
    if m.portals do
        update_wild(u, m)
    end
    if m.clones > 0 do
        keep_mirrors(u, o, m.clones)
    end
    if u.state == STATE_DOWN or o.state == STATE_DOWN do
        return
    end
    if m.foe_dps > 0 do
        o.health -= m.foe_dps * dt
        u.health = math.min(u.health + m.foe_dps * m.drain * dt, u.max_health)
        if ap.chance(0.15) do
            spark(o.body.center() + scatter(0.4), ap.Vec3(0, ap.random(0.4, 1.2), 0), m.glow, 0.5, 0.06, 0)
        end
    end
    if m.foe_poison > 0 and not o.kit.machine do
        o.poison = math.min(o.poison + m.foe_poison * dt, roster.POISON_LIMIT)
    end
    if m.foe_slow and not o.kit.machine do
        o.slow = math.max(o.slow, 0.15)
    end
    if m.regen > 0 do
        u.health = math.min(u.health + m.regen * dt, u.max_health)
        if ap.chance(0.2) do
            spark(u.body.center() + scatter(0.4), ap.Vec3(0, ap.random(0.6, 1.4), 0), ap.Color(120, 240, 130), 0.5, 0.07, 0)
        end
    end
    if m.bar_regen > 0 do
        u.bar = math.min(u.bar + m.bar_regen * dt, u.kit.bar_max)
    end
    if m.strike.name != "" and m.strike_every > 0 do
        strike_clocks[k] += dt
        if strike_clocks[k] >= m.strike_every do
            strike_clocks[k] = 0
            send_strike(u, o, m)
        end
    end
end

# A shell, a star, a sunbeam from the sky, or a cab along the ground, at the foe.
function send_strike(Fighter u, Fighter o, roster.Maximum m)
    var a = m.strike
    if m.strike_ground do
        var way = forward_of(ap.random(0, 360))
        var start = flat(o.body.position) - way * 9
        if start.length() > ARENA - 1.2 do
            start = unit(start) * (ARENA - 1.2)
        end
        shots.push(Shot(u.id, a, ap.Vec3(start.x, 0.7, start.z), unit(flat(o.body.position - start)) * a.shot_speed, a.shot_life))
        sound_at(snd_kiai, start, 0.5, 1.4)
        later(snd_launch, start, 4, 0.5, 0.7)
        return
    end
    var target = flat(o.body.position) + ap.Vec3(ap.random(-1.6, 1.6), 0, ap.random(-1.6, 1.6))
    if target.length() > ARENA - 0.8 do
        target = unit(target) * (ARENA - 0.8)
    end
    shots.push(Shot(u.id, a, target + ap.Vec3(0, 14, 0), ap.Vec3(0, -a.shot_speed, 0), a.shot_life))
    stain(target, m.glow, a.blast, 14 / a.shot_speed + 0.15, 0.3)
    sound_at(snd_launch, target, 0.4, 1.3)
end

# Wild portals: they open here and there, lead into any other, and close after a while.
function update_wild(Fighter u, roster.Maximum m)
    var dt = 1.0 / 60
    wild_glow = m.glow
    wild_clock += dt
    WildPortal[] kept = []
    for w in wild_portals do
        if ticks - w.born < WILD_LIFE do
            kept.push(w)
        end
    end
    wild_portals = kept
    if wild_clock >= 3.5 and wild_portals.length < 6 do
        wild_clock = 0
        var spot = forward_of(ap.random(0, 360)) * ap.random(2, ARENA - 1.5)
        wild_portals.push(WildPortal(ap.Vec3(spot.x, 0, spot.z), ticks))
        var at = spot + ap.Vec3(0, 1, 0)
        sound_at(snd_rift, at, 0.5, 1.2)
        rings.push(Ring(at, wild_glow, 4, 0.25, true))
    end
    if wild_portals.length < 2 do
        return
    end
    for g in fighters do
        if g.warp_cool > 0 or g.state == STATE_DOWN do
            continue
        end
        for i, w in wild_portals do
            if ticks - w.born < 20 or flat_distance(g.body.position, w.position) > 0.8 or g.body.position.y > 1.6 do
                continue
            end
            var j = int(ap.random(0, double(wild_portals.length - 1) - 0.001))
            if j >= i do
                j += 1
            end
            var there = wild_portals[j]
            var going = unit(flat(g.body.velocity))
            if going.length() < 0.5 do
                going = forward_of(g.heading)
            end
            var out = there.position + going * 1.0
            if flat(out).length() > ARENA - 0.6 or world.overlaps(out + ap.Vec3(0, 1, 0), 0.5) do
                out = there.position
            end
            leave_ghost(g, 0.3)
            burst(g.body.center(), 12, wild_glow, 4, 0.35, 0.08)
            g.body.position = ap.Vec3(out.x, g.body.position.y, out.z)
            g.warp_cool = 55
            sound_at(snd_flash, there.position, 0.6, 1.1)
            rings.push(Ring(there.position + ap.Vec3(0, 1, 0), wild_glow, 5, 0.2, true))
            break
        end
    end
end

# --- Maximum scenery: each place is built out of boxes, columns, balls and rings around the disc.

# A steady 0..1 for item `i` (so a layout stays put from frame to frame).
function h01(int i, int salt) returns double
    var x = math.sin(double(i) * 12.9898 + double(salt) * 78.233) * 43758.5453
    return x - math.floor(x)
end

# In a merge each place is drawn only on its own side of the seam.
function keep(ap.Vec3 at) returns bool
    if half_side == 0 do
        return true
    end
    var d = at.x * half_dir.x + at.z * half_dir.z
    return d >= 0 if half_side > 0 else d < 0
end

function sd(ap.Mesh mesh, ap.Vec3 at, ap.Color color, ap.Vec3 rotation, ap.Vec3 size)
    if keep(at) do
        ap.draw(mesh, at, color, rotation, size)
    end
end

function sb(ap.Vec3 at, ap.Vec3 size, ap.Color color, double yaw = 0, double tilt = 0)
    sd(box, at, color, ap.Vec3(tilt, yaw, 0), size)
end

function column(ap.Vec3 base, double radius, double height, ap.Color color)
    sd(disc, base + ap.Vec3(0, height / 2, 0), color, ap.Vec3(0, 0, 0), ap.Vec3(radius, height, radius))
end

function ground_plane(ap.Color color)
    if half_side == 0 do
        ap.draw(box, ap.Vec3(0, -0.53, 0), color, ap.Vec3(0, 0, 0), ap.Vec3(260, 1, 260))
    else do
        ap.draw(box, half_dir * (65.0 * double(half_side)) + ap.Vec3(0, -0.53, 0), color,
            ap.Vec3(0, heading_of(half_dir), 0), ap.Vec3(260, 1, 130))
    end
end

# Glowing things: drawn without light so they shine in any dark.
function glow_box(ap.Vec3 at, ap.Vec3 size, ap.Color color, double yaw = 0)
    ap.lighting(false)
    sd(box, at, color, ap.Vec3(0, yaw, 0), size)
    ap.lighting(true)
end

function glow_ball(ap.Vec3 at, double size, ap.Color color)
    ap.lighting(false)
    sd(ball, at, color, ap.Vec3(0, 0, 0), ap.Vec3(size, size, size))
    ap.lighting(true)
end

# The line where two merged places meet.
function draw_seam()
    var yaw = heading_of(half_dir) + 90
    var pulse = 0.5 + 0.3 * math.sin(double(ticks) * 0.1)
    var both = max_def.glow.lerp(merge_def.glow, 0.5)
    ap.lighting(false)
    ap.draw(box, ap.Vec3(0, 0.04, 0), both, ap.Vec3(0, yaw, 0), ap.Vec3(0.1, 0.03, 2 * ARENA + 2))
    ap.draw(box, ap.Vec3(0, 10, 0), ap.WHITE.fade(0.05 * pulse + 0.03), ap.Vec3(0, yaw, 0), ap.Vec3(0.05, 20, 180))
    ap.draw(box, ap.Vec3(0, 10, 0), both.fade(0.08 * pulse), ap.Vec3(0, yaw, 0), ap.Vec3(0.5, 20, 180))
    ap.lighting(true)
end

function draw_scenery(roster.Maximum m)
    var scene = m.scene
    var t = double(ticks)
    if scene == roster.SCENE_CASTLE do
        ground_plane(ap.Color(34, 28, 32))
        var wall = ap.Color(70, 62, 70)
        for i in 0..<12 do
            var a = double(i) * 30
            var at = forward_of(a) * 24
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(4, 18, 4), wall)
            for k in 0..<4 do
                var c = forward_of(double(k) * 90 + 45) * 1.6
                sb(at + ap.Vec3(c.x, 18.6, c.z), ap.Vec3(0.9, 1.2, 0.9), wall)
            end
            sb(forward_of(a + 15) * 23.6 + ap.Vec3(0, 5, 0), ap.Vec3(12.5, 10, 1.5), ap.Color(58, 50, 58), a + 105)
            sb(forward_of(a + 15) * 22.7 + ap.Vec3(0, 6, 0), ap.Vec3(1.6, 5, 0.1), ap.Color(150, 20, 30), a + 105)
            glow_box(at - forward_of(a) * 2.05 + ap.Vec3(0, 12, 0), ap.Vec3(0.5, 0.8, 0.1), ap.Color(255, 160, 80), a + 90)
        end
        glow_ball(forward_of(200) * 52 + ap.Vec3(0, 26, 0), 15, ap.Color(220, 40, 50))
        glow_ball(forward_of(200) * 52 + ap.Vec3(0, 26, 0), 19, ap.Color(220, 40, 50).fade(0.25))
    else if scene == roster.SCENE_RING do
        ground_plane(ap.Color(20, 20, 28))
        var c = 11.3
        for k in 0..<4 do
            var sx = c if k % 2 == 0 else -c
            var sz = c if k < 2 else -c
            sb(ap.Vec3(sx, 1.0, sz), ap.Vec3(0.4, 2.0, 0.4), ap.Color(200, 200, 210))
            sb(ap.Vec3(sx, 2.05, sz), ap.Vec3(0.5, 0.15, 0.5), ap.Color(220, 40, 40) if k % 2 == 0 else ap.Color(40, 80, 220))
        end
        var ropes = [ap.Color(220, 40, 40), ap.Color(240, 240, 240), ap.Color(40, 80, 220)]
        for h in 0..<3 do
            var y = 0.6 + double(h) * 0.42
            sb(ap.Vec3(0, y, c), ap.Vec3(c * 2, 0.07, 0.07), ropes[h])
            sb(ap.Vec3(0, y, -c), ap.Vec3(c * 2, 0.07, 0.07), ropes[h])
            sb(ap.Vec3(c, y, 0), ap.Vec3(0.07, 0.07, c * 2), ropes[h])
            sb(ap.Vec3(-c, y, 0), ap.Vec3(0.07, 0.07, c * 2), ropes[h])
        end
        var shirts = [ap.Color(160, 40, 40), ap.Color(40, 70, 150), ap.Color(200, 180, 60), ap.Color(60, 120, 60), ap.Color(180, 180, 190)]
        for i in 0..<180 do
            var a = h01(i, 1) * 360
            var d = 15.5 + h01(i, 2) * 14
            var at = forward_of(a) * d
            var hop = math.max(math.sin(t * 0.15 + double(i)), 0.0) * 0.25
            sb(at + ap.Vec3(0, (d - 15) * 0.55 + 0.6 + hop, 0), ap.Vec3(0.55, 1.2, 0.45), shirts[i % 5], a)
            if h01(i + ticks // 5, 3) > 0.985 do
                glow_box(at + ap.Vec3(0, (d - 15) * 0.55 + 1.4, 0), ap.Vec3(0.3, 0.3, 0.3), ap.WHITE)
            end
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + 45) * 19
            sb(at + ap.Vec3(0, 8, 0), ap.Vec3(0.5, 16, 0.5), ap.Color(60, 60, 70))
            glow_box(at + ap.Vec3(0, 16, 0) - forward_of(double(k) * 90 + 45) * 0.5, ap.Vec3(1.4, 0.8, 0.8), ap.Color(255, 250, 220))
        end
    else if scene == roster.SCENE_SWAMP do
        sd(disc, ap.Vec3(0, -0.15, 0), ap.Color(40, 56, 36), ap.Vec3(0, 0, 0), ap.Vec3(90, 0.1, 90))
        for i in 0..<34 do
            var a = h01(i, 4) * 360
            var at = forward_of(a) * (13.5 + h01(i, 5) * 28)
            var tall = 5 + h01(i, 6) * 7
            var lean = (h01(i, 7) - 0.5) * 16
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(0.6, tall, 0.6), ap.Color(54, 44, 34), a, lean)
            sb(at + ap.Vec3(0, tall * 0.7, 0), ap.Vec3(3, 0.25, 0.25), ap.Color(50, 40, 32), a + 40, 25)
            sb(at + ap.Vec3(0, tall * 0.85, 0), ap.Vec3(2.2, 0.2, 0.2), ap.Color(50, 40, 32), a - 50, -20)
            sb(at + ap.Vec3(0.4, tall * 0.6, 0), ap.Vec3(0.12, 2.2, 0.12), ap.Color(90, 120, 60))
        end
        for i in 0..<30 do
            var at = forward_of(h01(i, 8) * 360) * (12 + h01(i, 9) * 16)
            sd(disc, at + ap.Vec3(0, -0.05, 0), ap.Color(70, 120, 50), ap.Vec3(0, 0, 0), ap.Vec3(0.6, 0.03, 0.6))
        end
    else if scene == roster.SCENE_HALL do
        ground_plane(ap.Color(150, 140, 130))
        for i in 0..<16 do
            var a = double(i) * 22.5
            var at = forward_of(a) * 16
            column(at, 0.9, 13, ap.Color(225, 220, 210))
            sb(at + ap.Vec3(0, 13.2, 0), ap.Vec3(2.4, 0.5, 2.4), ap.Color(235, 230, 220))
            sb(at + ap.Vec3(0, 0.25, 0), ap.Vec3(2.2, 0.5, 2.2), ap.Color(200, 195, 185))
            sb(forward_of(a + 11.25) * 16.5 + ap.Vec3(0, 8, 0), ap.Vec3(2.2, 7, 0.1), ap.Color(130, 20, 40), a + 101.25)
        end
        sb(ap.Vec3(0, 14, 0), ap.Vec3(40, 0.6, 40), ap.Color(70, 50, 36))
        for k in 0..<3 do
            var at = forward_of(double(k) * 120 + 30) * 7 + ap.Vec3(0, 10.5, 0)
            sd(hoop, at, ap.Color(220, 180, 90), ap.Vec3(0, t * 0.2, 0), ap.Vec3(2.2, 2.2, 2.2))
            sb(at + ap.Vec3(0, 1.7, 0), ap.Vec3(0.05, 3.4, 0.05), ap.Color(120, 100, 60))
            for c in 0..<8 do
                glow_ball(at + forward_of(double(c) * 45) * 1.75 + ap.Vec3(0, 0.2, 0), 0.22, ap.Color(255, 220, 140))
            end
        end
    else if scene == roster.SCENE_TOWN do
        ground_plane(ap.Color(170, 130, 85))
        var woods = [ap.Color(120, 80, 50), ap.Color(150, 110, 70), ap.Color(100, 70, 50), ap.Color(160, 130, 90)]
        for side in 0..<2 do
            var sx = 17.0 if side == 0 else -17.0
            var face = -1.0 if side == 0 else 1.0
            for k in 0..<7 do
                var z = -33 + double(k) * 11
                var h = 6 + h01(k + side * 10, 10) * 5
                sb(ap.Vec3(sx, h / 2, z), ap.Vec3(6, h, 9.5), woods[(k + side) % 4])
                sb(ap.Vec3(sx + face * 3.05, h + 1.2, z), ap.Vec3(0.3, 2.4, 9.5), woods[(k + side + 1) % 4])
                sb(ap.Vec3(sx + face * 4.2, 3.2, z), ap.Vec3(2.4, 0.2, 9.5), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 5.3, 1.6, z - 4.5), ap.Vec3(0.2, 3.2, 0.2), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 5.3, 1.6, z + 4.5), ap.Vec3(0.2, 3.2, 0.2), ap.Color(90, 60, 40))
                sb(ap.Vec3(sx + face * 3.1, h - 1, z), ap.Vec3(0.15, 1, 5), ap.Color(230, 210, 170))
            end
        end
        for i in 0..<10 do
            var at = forward_of(double(i) * 36 + 10) * 70
            sb(at + ap.Vec3(0, 7, 0), ap.Vec3(20, 14 + h01(i, 11) * 10, 16), ap.Color(180, 100, 60), double(i) * 36)
        end
        for i in 0..<3 do
            var x = -30 + (t * 0.06 + double(i) * 21) % 60
            var at = ap.Vec3(x, 0.45, -6 + double(i) * 6)
            sd(ball, at, ap.Color(150, 120, 70), ap.Vec3(t * 4, 0, t * 3), ap.Vec3(0.9, 0.9, 0.9))
        end
    else if scene == roster.SCENE_ABYSS do
        ap.lighting(false)
        for i in 0..<60 do
            var a = h01(i, 12) * 360 + t * (0.05 + h01(i, 13) * 0.1)
            var at = forward_of(a) * (13 + h01(i, 14) * 20) + ap.Vec3(0, -6 + h01(i, 15) * 18, 0)
            sd(box, at, ap.WHITE.fade(0.5 + 0.3 * math.sin(t * 0.05 + double(i))), ap.Vec3(t * 0.3 + double(i), a, 20),
                ap.Vec3(0.08, 0.6 + h01(i, 16), 0.08))
        end
        ap.lighting(true)
    else if scene == roster.SCENE_TRENCHES do
        ground_plane(ap.Color(70, 58, 44))
        for row in 0..<2 do
            for i in 0..<52 do
                var a = double(i) * 360 / 52 + double(row) * 3.5
                var at = forward_of(a) * 12.6
                sb(at + ap.Vec3(0, 0.25 + double(row) * 0.45, 0), ap.Vec3(1.5, 0.45, 0.8), ap.Color(150, 130, 90), a + 90)
            end
        end
        for i in 0..<26 do
            var a = double(i) * 360 / 26
            var at = forward_of(a) * 16
            sb(at + ap.Vec3(0, 0.7, 0), ap.Vec3(0.12, 1.4, 0.12), ap.Color(70, 60, 50), a, 12)
            sb(forward_of(a + 7) * 16 + ap.Vec3(0, 1.0, 0), ap.Vec3(3.8, 0.04, 0.04), ap.Color(110, 110, 110), a + 97)
            sb(forward_of(a + 7) * 16 + ap.Vec3(0, 0.6, 0), ap.Vec3(3.8, 0.04, 0.04), ap.Color(110, 110, 110), a + 97)
        end
        for i in 0..<22 do
            var at = forward_of(h01(i, 17) * 360) * (15 + h01(i, 18) * 30)
            sd(disc, at + ap.Vec3(0, 0.01, 0), ap.Color(40, 32, 26), ap.Vec3(0, 0, 0), ap.Vec3(1.5 + h01(i, 19) * 2, 0.02, 1.5 + h01(i, 19) * 2))
        end
        for i in 0..<8 do
            var at = forward_of(h01(i, 20) * 360) * (20 + h01(i, 21) * 20)
            sb(at + ap.Vec3(0, 3, 0), ap.Vec3(0.5, 6, 0.5), ap.Color(40, 34, 28), 0, (h01(i, 22) - 0.5) * 30)
        end
        if int(t) % 50 < 3 do
            glow_box(forward_of(h01(ticks // 50, 23) * 360) * 60 + ap.Vec3(0, 2, 0), ap.Vec3(8, 3, 1), ap.Color(255, 180, 80))
        end
    else if scene == roster.SCENE_GRAVEYARD do
        ground_plane(ap.Color(36, 44, 38))
        for i in 0..<64 do
            var a = h01(i, 24) * 360
            var at = forward_of(a) * (12.5 + h01(i, 25) * 18)
            var tilt = (h01(i, 26) - 0.5) * 18
            if i % 4 == 0 do
                sb(at + ap.Vec3(0, 0.9, 0), ap.Vec3(0.18, 1.8, 0.18), ap.Color(120, 125, 130), a, tilt)
                sb(at + ap.Vec3(0, 1.3, 0), ap.Vec3(0.9, 0.16, 0.16), ap.Color(120, 125, 130), a, tilt)
            else do
                sb(at + ap.Vec3(0, 0.55, 0), ap.Vec3(0.8, 1.1, 0.22), ap.Color(110, 115, 115), a, tilt)
            end
        end
        for i in 0..<60 do
            var a = double(i) * 6
            sb(forward_of(a) * 32 + ap.Vec3(0, 1.1, 0), ap.Vec3(0.08, 2.2, 0.08), ap.Color(30, 30, 34))
        end
        sb(ap.Vec3(0, 3, -26), ap.Vec3(7, 6, 6), ap.Color(90, 92, 96))
        sb(ap.Vec3(0, 6.6, -26), ap.Vec3(8, 1.2, 7), ap.Color(70, 72, 76))
        glow_box(ap.Vec3(0, 2, -22.9), ap.Vec3(1.4, 2.6, 0.1), ap.Color(120, 170, 255))
    else if scene == roster.SCENE_TOWER do
        column(ap.Vec3(0, -40, 0), ARENA + 1.2, 39.3, ap.Color(70, 68, 96))
        for i in 0..<24 do
            var a = double(i) * 15
            if i % 2 == 0 do
                sb(forward_of(a) * (ARENA + 0.9) + ap.Vec3(0, 0.5, 0), ap.Vec3(1.6, 1.0, 0.7), ap.Color(90, 88, 120), a + 90)
            end
        end
        ap.lighting(false)
        for i in 0..<200 do
            var az = h01(i, 27) * 360
            var el = (8 + h01(i, 28) * 75) * math.PI / 180
            var at = forward_of(az) * (60 * math.cos(el)) + ap.Vec3(0, 60 * math.sin(el), 0)
            var twinkle = 0.5 + 0.5 * math.sin(t * 0.08 + double(i) * 1.7)
            sd(box, at, ap.Color(255, 250, 220).fade(0.4 + 0.6 * twinkle), ap.Vec3(0, 0, 0), ap.Vec3(0.25, 0.25, 0.25))
        end
        ap.lighting(true)
        for i in 0..<5 do
            var at = forward_of(double(i) * 72 + 20) * 45
            column(at + ap.Vec3(0, -40, 0), 3, 45, ap.Color(60, 58, 86))
            sb(at + ap.Vec3(0, 7, 0), ap.Vec3(5, 4, 5), ap.Color(70, 50, 110), 45)
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + t * 0.3) * 13 + ap.Vec3(0, 3 + math.sin(t * 0.03 + double(k)) * 0.5, 0)
            glow_box(at, ap.Vec3(0.4, 0.9, 0.4), m.glow, t)
        end
    else if scene == roster.SCENE_CITY do
        ground_plane(ap.Color(30, 30, 36))
        for i in 0..<32 do
            var a = double(i) * 360 / 32 + h01(i, 29) * 6
            var d = 24 + h01(i, 30) * 20
            var w = 6 + h01(i, 31) * 6
            var h = 16 + h01(i, 32) * 46
            var at = forward_of(a) * d
            sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(w, h, w), ap.Color(34, 34, 48), a)
            var face = at - forward_of(a) * (w / 2 + 0.06)
            var rows = int(h / 3)
            for r in 0..<rows do
                if h01(i * 40 + r, 33) > 0.35 do
                    glow_box(face + ap.Vec3(0, 1.5 + double(r) * 3, 0), ap.Vec3(w * 0.8, 0.9, 0.05), ap.Color(255, 220, 140).fade(0.5 + h01(i * 40 + r, 34) * 0.5), a + 90)
                end
            end
            if i % 5 == 0 do
                glow_box(face + ap.Vec3(0, 8, 0) - forward_of(a) * 0.1, ap.Vec3(w * 0.6, 1.6, 0.05), ap.Color(255, 60, 200) if i % 10 == 0 else ap.Color(60, 230, 255), a + 90)
            end
        end
        for i in 0..<10 do
            var at = forward_of(double(i) * 36) * 13.5
            sb(at + ap.Vec3(0, 2.5, 0), ap.Vec3(0.14, 5, 0.14), ap.Color(40, 40, 46))
            glow_box(at + ap.Vec3(0, 5, 0), ap.Vec3(0.5, 0.25, 0.5), ap.Color(255, 230, 160))
        end
    else if scene == roster.SCENE_WAREHOUSE do
        ground_plane(ap.Color(60, 58, 56))
        var wall = ap.Color(70, 66, 64)
        sb(ap.Vec3(0, 7, 20), ap.Vec3(40, 14, 1), wall)
        sb(ap.Vec3(0, 7, -20), ap.Vec3(40, 14, 1), wall)
        sb(ap.Vec3(20, 7, 0), ap.Vec3(1, 14, 40), wall)
        sb(ap.Vec3(-20, 7, 0), ap.Vec3(1, 14, 40), wall)
        for k in 0..<6 do
            sb(ap.Vec3(-15 + double(k) * 6, 13, 0), ap.Vec3(0.5, 0.7, 40), ap.Color(50, 48, 46))
        end
        for i in 0..<26 do
            var at = forward_of(h01(i, 35) * 360) * (12.6 + h01(i, 36) * 5)
            var stack = 1 + int(h01(i, 37) * 3)
            for k in 0..<stack do
                sb(at + ap.Vec3(0, 0.75 + double(k) * 1.5, 0), ap.Vec3(1.5, 1.5, 1.5), ap.Color(140, 100, 60), h01(i, 38) * 90 + double(k) * 10)
            end
        end
        var siren = 0.5 + 0.5 * math.sin(t * 0.25)
        for k in 0..<4 do
            var at = forward_of(double(k) * 90) * 19.3 + ap.Vec3(0, 10, 0)
            glow_box(at, ap.Vec3(1, 0.6, 1), ap.Color(255, 30, 20).fade(0.3 + 0.7 * siren))
        end
    else if scene == roster.SCENE_ALLEY do
        ground_plane(ap.Color(26, 28, 32))
        for side in 0..<2 do
            var sx = 12.6 if side == 0 else -12.6
            var face = -1.0 if side == 0 else 1.0
            sb(ap.Vec3(sx, 9, 0), ap.Vec3(1.2, 18, 90), ap.Color(90, 50, 44))
            for k in 0..<8 do
                var z = -35 + double(k) * 10
                sb(ap.Vec3(sx + face * 1.2, 5 + double(k % 3) * 3, z), ap.Vec3(1.4, 0.12, 4), ap.Color(40, 40, 44))
                if h01(k + side * 8, 39) > 0.5 do
                    glow_box(ap.Vec3(sx + face * 0.62, 8 + double(k % 2) * 4, z + 2), ap.Vec3(0.05, 1.6, 1.2), ap.Color(255, 210, 130))
                end
            end
            sb(ap.Vec3(sx + face * 1.6, 0.7, -6 + double(side) * 10), ap.Vec3(1.6, 1.4, 2.6), ap.Color(40, 80, 50))
            sb(ap.Vec3(sx + face * 0.9, 3, 4 - double(side) * 9), ap.Vec3(0.12, 6, 0.12), ap.Color(40, 40, 46))
            glow_box(ap.Vec3(sx + face * 1.6, 5.8, 4 - double(side) * 9), ap.Vec3(0.6, 0.3, 0.6), m.glow)
        end
        for i in 0..<12 do
            var at = ap.Vec3((h01(i, 40) - 0.5) * 18, 0.015, (h01(i, 41) - 0.5) * 60)
            sd(disc, at, ap.Color(70, 80, 100), ap.Vec3(0, 0, 0), ap.Vec3(0.8 + h01(i, 42), 0.02, 0.6 + h01(i, 43)))
        end
    else if scene == roster.SCENE_REACTOR do
        ground_plane(ap.Color(76, 70, 62))
        for k in 0..<3 do
            var at = forward_of(double(k) * 50 + 150) * 42
            for s in 0..<9 do
                var u = double(s) / 8
                var r = 5.2 + 9 * (u - 0.65) * (u - 0.65)
                column(at + ap.Vec3(0, double(s) * 3, 0), r, 3.05, ap.Color(170, 160, 150))
            end
        end
        sb(ap.Vec3(14, 6, -30), ap.Vec3(16, 12, 12), ap.Color(110, 104, 96))
        sb(ap.Vec3(10, 12.5, -26), ap.Vec3(7, 1.5, 5), ap.Color(90, 84, 78), 20, 25)
        sb(ap.Vec3(18, 11.5, -32), ap.Vec3(6, 1.2, 6), ap.Color(90, 84, 78), -15, -30)
        glow_box(ap.Vec3(14, 9, -24), ap.Vec3(5, 4, 0.2), ap.Color(150, 255, 80).fade(0.6 + 0.3 * math.sin(t * 0.1)))
        for i in 0..<18 do
            var at = forward_of(h01(i, 44) * 360) * (12.5 + h01(i, 45) * 8)
            column(at, 0.4, 1.0, ap.Color(220, 190, 40))
            sd(disc, at + ap.Vec3(0, 1.01, 0), ap.Color(40, 40, 40), ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.02, 0.2))
        end
        for i in 0..<40 do
            var a = double(i) * 9
            sb(forward_of(a) * 22 + ap.Vec3(0, 1.2, 0), ap.Vec3(0.1, 2.4, 0.1), ap.Color(90, 90, 90), 0, (h01(i, 46) - 0.5) * 20)
        end
    else if scene == roster.SCENE_FACTORY do
        ground_plane(ap.Color(54, 52, 50))
        for k in 0..<5 do
            var a = double(k) * 72 + 20
            var at = forward_of(a) * 20 + ap.Vec3(0, 6, 0)
            var spin = t * (0.6 if k % 2 == 0 else -0.8)
            sd(hoop, at, ap.Color(120, 110, 100), ap.Vec3(90, a, spin), ap.Vec3(6, 6, 18))
            for c in 0..<8 do
                var tooth = forward_of(double(c) * 45 + spin) * 4.9
                sb(at + ap.Vec3(tooth.x * math.cos(a * math.PI / 180), tooth.z, -tooth.x * math.sin(a * math.PI / 180)),
                    ap.Vec3(0.8, 0.8, 0.8), ap.Color(110, 100, 90), a)
            end
        end
        for k in 0..<4 do
            var at = forward_of(double(k) * 90 + 45) * 34
            column(at, 1.6, 30, ap.Color(90, 70, 60))
        end
        for k in 0..<2 do
            var z = 14.0 if k == 0 else -14.0
            sb(ap.Vec3(0, 0.6, z), ap.Vec3(30, 1.2, 2), ap.Color(40, 40, 44))
            for c in 0..<5 do
                var x = -15 + (t * 0.04 + double(c) * 6) % 30
                sb(ap.Vec3(x if k == 0 else -x, 1.6, z), ap.Vec3(1, 0.8, 1), ap.Color(150, 110, 60))
            end
        end
        glow_box(ap.Vec3(-17, 2, 0), ap.Vec3(1, 3, 5), ap.Color(255, 140, 30).fade(0.7 + 0.3 * math.sin(t * 0.3)), 90)
    else if scene == roster.SCENE_SUN do
        glow_ball(forward_of(170) * 60 + ap.Vec3(0, 4, 0), 44, ap.Color(255, 250, 220))
        glow_ball(forward_of(170) * 60 + ap.Vec3(0, 4, 0), 54, ap.Color(255, 200, 80).fade(0.35))
        ap.lighting(false)
        for k in 0..<4 do
            sd(hoop, forward_of(170) * 58 + ap.Vec3(0, 4, 0), ap.Color(255, 160, 40).fade(0.6), ap.Vec3(90, 0, t * 0.4 + double(k) * 45), ap.Vec3(32, 32, 32))
        end
        sd(disc, ap.Vec3(0, -30, 0), ap.Color(255, 230, 160), ap.Vec3(0, 0, 0), ap.Vec3(140, 0.1, 140))
        ap.lighting(true)
        column(ap.Vec3(0, -12, 0), ARENA + 1.1, 11.3, ap.Color(220, 180, 110))
        for k in 0..<6 do
            var at = forward_of(double(k) * 60 + t * 0.2) * 15 + ap.Vec3(0, 3 + math.sin(t * 0.04 + double(k)) * 1.2, 0)
            sd(hoop, at, ap.Color(255, 210, 90), ap.Vec3(t * 0.5 + double(k) * 30, t * 0.3, 0), ap.Vec3(1.6, 1.6, 1.6))
        end
    else if scene == roster.SCENE_CANYON do
        ground_plane(ap.Color(170, 90, 55))
        for i in 0..<18 do
            var a = double(i) * 20 + h01(i, 47) * 10
            var at = forward_of(a) * (32 + h01(i, 48) * 34)
            var w = 8 + h01(i, 49) * 10
            var h = 10 + h01(i, 50) * 22
            sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(w, h, w * 0.8), ap.Color(180, 90, 60), a)
            sb(at + ap.Vec3(0, h * 0.3, 0), ap.Vec3(w * 1.05, 1.2, w * 0.85), ap.Color(150, 70, 50), a)
            sb(at + ap.Vec3(0, h + 0.4, 0), ap.Vec3(w * 0.9, 0.8, w * 0.7), ap.Color(200, 130, 80), a)
        end
        for i in 0..<10 do
            var at = forward_of(h01(i, 51) * 360) * (16 + h01(i, 52) * 12)
            sb(at + ap.Vec3(0, 3, 0), ap.Vec3(1.2, 6 + h01(i, 53) * 4, 1.2), ap.Color(160, 80, 50), h01(i, 54) * 90, 4)
        end
        for k in 0..<4 do
            var a = t * 0.35 + double(k) * 90
            var at = forward_of(a) * (18 + double(k) * 3) + ap.Vec3(0, 16 + double(k) * 2, 0)
            var flap = math.sin(t * 0.3 + double(k)) * 25
            sb(at, ap.Vec3(0.3, 0.25, 1.0), ap.Color(70, 50, 40), a + 90)
            sd(box, at, ap.Color(60, 44, 36), ap.Vec3(0, a + 90, flap), ap.Vec3(2.6, 0.06, 0.5))
        end
    else if scene == roster.SCENE_BOX do
        # Inside a cardboard box the size of a house, with the toys.
        ground_plane(ap.Color(168, 126, 82))
        var card = ap.Color(196, 150, 96)
        for k in 0..<4 do
            var a = double(k) * 90
            var at = forward_of(a) * 24
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(48, 18, 1), card, a)
            sb(at + forward_of(a) * 2.4 + ap.Vec3(0, 19.4, 0), ap.Vec3(48, 0.6, 6), card.brightness(0.85), a, -35)
            sb(at - forward_of(a) * 0.55 + ap.Vec3(0, 9, 0), ap.Vec3(1.6, 18, 0.05), ap.Color(214, 196, 150), a)
            sb(at - forward_of(a) * 0.56 + ap.Vec3(0, 6, 0), ap.Vec3(6, 0.15, 0.04), ap.Color(70, 50, 34), a)
        end
        var yarns = [ap.Color(220, 60, 70), ap.Color(70, 110, 220), ap.Color(90, 190, 90), ap.Color(240, 200, 60), ap.Color(200, 90, 200)]
        for i in 0..<5 do
            var a = h01(i, 60) * 360
            var at = forward_of(a) * (14 + h01(i, 61) * 6)
            var big = 2.4 + h01(i, 62) * 2
            sd(ball, at + ap.Vec3(0, big / 2, 0), yarns[i], ap.Vec3(t * 0.1, double(i) * 40, 0), ap.Vec3(big, big, big))
            sb(at + forward_of(a + 30) * (big / 2 + 2) + ap.Vec3(0, 0.05, 0), ap.Vec3(0.08, 0.08, 4), yarns[i], a + 30)
        end
        var mouse = forward_of(200) * 16
        sd(ball, mouse + ap.Vec3(0, 0.8, 0), ap.Color(150, 150, 160), ap.Vec3(0, 200, 0), ap.Vec3(2.4, 1.6, 3.2))
        sd(ball, mouse + ap.Vec3(0.8, 1.6, -0.8), ap.Color(230, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(0.8, 0.8, 0.2))
        sd(ball, mouse + ap.Vec3(-0.8, 1.6, -0.8), ap.Color(230, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(0.8, 0.8, 0.2))
        sb(mouse + forward_of(200) * -2.4 + ap.Vec3(0, 0.1, 0), ap.Vec3(0.12, 0.12, 2.4), ap.Color(230, 160, 170), 200)
        for k in 0..<3 do
            var at = forward_of(double(k) * 120 + 70) * 18
            column(at, 0.8, 8, ap.Color(210, 190, 140))
            sb(at + ap.Vec3(0, 8.1, 0), ap.Vec3(3, 0.3, 3), ap.Color(170, 120, 160))
        end
    else if scene == roster.SCENE_COLOSSEUM do
        # Sand, and tier on tier of arches, every seat taken.
        ground_plane(ap.Color(206, 180, 130))
        var rock = ap.Color(200, 178, 140)
        for tier in 0..<3 do
            var r = 19.0 + double(tier) * 4
            var y0 = double(tier) * 6
            for i in 0..<28 do
                var a = double(i) * 360 / 28
                var at = forward_of(a) * r
                sb(at + ap.Vec3(0, y0 + 3, 0), ap.Vec3(1.1, 6, 1.6), rock.brightness(1 - 0.08 * double(tier)), a)
                sb(forward_of(a + 6.4) * r + ap.Vec3(0, y0 + 5.6, 0), ap.Vec3(3.4, 0.8, 1.6), rock.brightness(0.9), a + 90)
                if tier > 0 do
                    var shirt = h01(i + tier * 30, 64)
                    sb(forward_of(a + 6.4) * (r - 1.2) + ap.Vec3(0, y0 + 0.6, 0), ap.Vec3(2.6, 1.0, 0.5),
                        ap.Color(int(120 + 100 * shirt), int(80 + 60 * h01(i, 65)), int(70 + 80 * h01(i, 66))), a + 90)
                end
            end
        end
        for k in 0..<8 do
            var a = double(k) * 45 + 22
            sb(forward_of(a) * 18.8 + ap.Vec3(0, 3.5, 0), ap.Vec3(1.4, 4, 0.06), m.glow, a)
        end
    else if scene == roster.SCENE_FOREST do
        # Black trees in a grey fog, and a white moon.
        ground_plane(ap.Color(34, 34, 36))
        for i in 0..<70 do
            var a = h01(i, 70) * 360
            var at = forward_of(a) * (12.5 + h01(i, 71) * 34)
            var tall = 10 + h01(i, 72) * 14
            var thick = 0.4 + h01(i, 73) * 0.5
            var lean = (h01(i, 74) - 0.5) * 8
            var bark = ap.Color(58, 58, 62).brightness(0.8 + 0.4 * h01(i, 75))
            sb(at + ap.Vec3(0, tall / 2, 0), ap.Vec3(thick, tall, thick), bark, a, lean)
            sb(at + ap.Vec3(0, tall * 0.62, 0), ap.Vec3(3.2, 0.18, 0.18), bark, a + 50, 30)
            sb(at + ap.Vec3(0, tall * 0.8, 0), ap.Vec3(2.4, 0.14, 0.14), bark, a - 40, -24)
        end
        for i in 0..<26 do
            var at = forward_of(h01(i, 76) * 360) * (12 + h01(i, 77) * 14)
            sd(disc, at + ap.Vec3(0, 0.01, 0), ap.Color(44, 44, 46), ap.Vec3(0, 0, 0), ap.Vec3(0.5 + h01(i, 78), 0.02, 0.4 + h01(i, 79)))
        end
        glow_ball(forward_of(160) * 64 + ap.Vec3(0, 30, 0), 9, ap.Color(230, 230, 236))
        glow_ball(forward_of(160) * 64 + ap.Vec3(0, 30, 0), 13, ap.Color(230, 230, 236).fade(0.2))
    else if scene == roster.SCENE_QUARRY do
        # Torn-open ground in terraces, rocks hanging in the air, the heat showing through.
        ground_plane(ap.Color(84, 64, 48))
        for k in 0..<3 do
            for i in 0..<20 do
                var a = double(i) * 18 + double(k) * 6
                var at = forward_of(a) * (18 + double(k) * 6)
                var h = 4 + double(k) * 8
                sb(at + ap.Vec3(0, h / 2, 0), ap.Vec3(7, h, 5), ap.Color(110 - k * 12, 86 - k * 10, 66 - k * 8), a)
            end
        end
        for i in 0..<14 do
            var a = h01(i, 80) * 360 + t * (0.04 + h01(i, 81) * 0.06)
            var at = forward_of(a) * (14 + h01(i, 82) * 12) + ap.Vec3(0, 4 + h01(i, 83) * 10 + math.sin(t * 0.02 + double(i)) * 0.6, 0)
            var big = 1.5 + h01(i, 84) * 2.5
            sd(box, at, ap.Color(104, 82, 64), ap.Vec3(t * 0.3 + double(i) * 20, t * 0.2, double(i) * 7), ap.Vec3(big, big * 0.8, big * 1.1))
        end
        for i in 0..<12 do
            var at = forward_of(h01(i, 85) * 360) * (12 + h01(i, 86) * 10)
            glow_box(at + ap.Vec3(0, 0.0, 0), ap.Vec3(0.25, 0.04, 3 + h01(i, 87) * 3),
                ap.Color(255, 120, 40).fade(0.6 + 0.3 * math.sin(t * 0.05 + double(i))), h01(i, 88) * 180)
        end
    else if scene == roster.SCENE_BANK do
        # A trading floor in marble and gold, the boards ticking over.
        ground_plane(ap.Color(130, 120, 106))
        for i in 0..<14 do
            var a = double(i) * 360 / 14
            var at = forward_of(a) * 17
            column(at, 0.8, 14, ap.Color(232, 228, 218))
            sb(at + ap.Vec3(0, 14.1, 0), ap.Vec3(2.2, 0.4, 2.2), ap.Color(240, 236, 226))
            sb(at + ap.Vec3(0, 0.2, 0), ap.Vec3(2.2, 0.4, 2.2), ap.Color(210, 200, 186))
        end
        sb(ap.Vec3(0, 14.6, 0), ap.Vec3(40, 0.6, 40), ap.Color(60, 44, 30))
        for k in 0..<4 do
            var a = double(k) * 90 + 45
            var at = forward_of(a) * 21
            sb(at + ap.Vec3(0, 9, 0), ap.Vec3(10, 3.4, 0.3), ap.Color(20, 20, 24), a)
            for r in 0..<3 do
                var up = h01(r + k * 3 + ticks // 40, 89) > 0.45
                glow_box(at - forward_of(a) * 0.2 + ap.Vec3(0, 8 + double(r) * 0.9, 0),
                    ap.Vec3(9 * (0.3 + 0.7 * h01(r + k * 5 + ticks // 40, 90)), 0.4, 0.05),
                    ap.Color(110, 230, 110) if up else ap.Color(240, 80, 70), a)
            end
        end
        for i in 0..<16 do
            var at = forward_of(h01(i, 91) * 360) * (12.5 + h01(i, 92) * 6)
            var h = 0.5 + h01(i, 93) * 1.5
            column(at, 0.6 + h * 0.4, h, ap.Color(232, 190, 60))
        end
        sd(disc, forward_of(180) * 23 + ap.Vec3(0, 5, 0), ap.Color(150, 150, 160), ap.Vec3(90, 0, 0), ap.Vec3(4.5, 0.6, 4.5))
    else if scene == roster.SCENE_MIRRORS do
        # Panels of glass at every angle, each with a little light caught in it.
        ground_plane(ap.Color(60, 70, 84))
        for i in 0..<40 do
            var a = h01(i, 94) * 360
            var at = forward_of(a) * (12.5 + h01(i, 95) * 18) + ap.Vec3(0, 3.1, 0)
            var yaw = a + 90 + (h01(i, 96) - 0.5) * 60
            sb(at, ap.Vec3(3.2, 6.2, 0.15), ap.Color(120, 130, 142), yaw)
            glow_box(at - forward_of(yaw) * 0.09, ap.Vec3(2.9, 5.9, 0.04),
                ap.Color(170, 220, 255).fade(0.22 + 0.12 * math.sin(t * 0.03 + double(i))), yaw)
            if h01(i + ticks // 20, 97) > 0.9 do
                glow_box(at - forward_of(yaw) * 0.12 + ap.Vec3(ap.random(-1, 1), ap.random(-2, 2), 0),
                    ap.Vec3(0.2, 0.2, 0.02), ap.WHITE, yaw)
            end
        end
    else if scene == roster.SCENE_LAB do
        # Tanks of green with something growing in each, and coils that spit.
        ground_plane(ap.Color(54, 62, 58))
        for i in 0..<10 do
            var a = double(i) * 36 + 10
            var at = forward_of(a) * 15
            column(at, 1.3, 0.4, ap.Color(90, 96, 100))
            column(at + ap.Vec3(0, 4.8, 0), 1.3, 0.4, ap.Color(90, 96, 100))
            sb(at + ap.Vec3(0, 2.6, 0), ap.Vec3(0.5, 1.6, 0.3), ap.Color(20, 40, 24), a + 180)
            ap.lighting(false)
            sd(disc, at + ap.Vec3(0, 2.6, 0), ap.Color(90, 255, 120).fade(0.3), ap.Vec3(0, 0, 0), ap.Vec3(1.1, 4.4, 1.1))
            ap.lighting(true)
        end
        for k in 0..<3 do
            var a = double(k) * 120 + 60
            var at = forward_of(a) * 22
            column(at, 0.6, 7, ap.Color(80, 80, 90))
            glow_ball(at + ap.Vec3(0, 7.5, 0), 1.2, ap.Color(180, 255, 200))
            if (ticks + k * 17) % 40 < 4 do
                glow_box(at + ap.Vec3(0, 7.5, 0) - forward_of(a) * 2, ap.Vec3(0.08, 0.08, 4), ap.Color(220, 255, 230), a)
            end
        end
        for i in 0..<6 do
            var a = double(i) * 60 + 30
            var at = forward_of(a) * 18.5
            sb(at + ap.Vec3(0, 0.6, 0), ap.Vec3(2.4, 1.2, 1.2), ap.Color(70, 74, 80), a)
            glow_box(at - forward_of(a) * 0.62 + ap.Vec3(0, 1.0, 0), ap.Vec3(1.6, 0.5, 0.04), ap.Color(120, 255, 140).fade(0.7), a)
        end
    else if scene == roster.SCENE_PIT do
        # A pit of bones under hanging chains and hooks.
        ground_plane(ap.Color(56, 42, 34))
        for k in 0..<3 do
            var r = 15.0 + double(k) * 5
            for i in 0..<24 do
                var a = double(i) * 15 + double(k) * 7
                sb(forward_of(a) * r + ap.Vec3(0, 2 + double(k) * 3, 0), ap.Vec3(5, 4 + double(k) * 6, 3), ap.Color(76 - k * 8, 58 - k * 6, 46 - k * 5), a)
            end
        end
        for i in 0..<40 do
            var at = forward_of(h01(i, 110) * 360) * (12.5 + h01(i, 111) * 6)
            var bone = ap.Color(214, 204, 176)
            sb(at + ap.Vec3(0, 0.1, 0), ap.Vec3(0.12, 0.12, 0.9), bone, h01(i, 112) * 180)
            if i % 5 == 0 do
                sd(ball, at + ap.Vec3(0.3, 0.2, 0), bone, ap.Vec3(0, h01(i, 113) * 360, 0), ap.Vec3(0.4, 0.36, 0.44))
            end
        end
        for i in 0..<12 do
            var a = double(i) * 30 + 10
            var at = forward_of(a) * (13 + h01(i, 114) * 4)
            var long = 6 + h01(i, 115) * 6
            var sway = math.sin(t * 0.02 + double(i)) * 4
            sb(at + ap.Vec3(0, 20 - long / 2, 0), ap.Vec3(0.12, long, 0.12), ap.Color(90, 88, 86), a, sway)
            sb(at + ap.Vec3(0, 20 - long, 0), ap.Vec3(0.1, 0.5, 0.35), ap.Color(110, 108, 104), a, sway)
        end
        for i in 0..<6 do
            var at = forward_of(double(i) * 60 + 20) * 16
            glow_ball(at + ap.Vec3(0, 0.4, 0), 0.6, m.glow.fade(0.5 + 0.3 * math.sin(t * 0.06 + double(i))))
        end
    else if scene == roster.SCENE_GROVE do
        # Tall spruces, snow on the ground, paper lanterns and a still pond.
        ground_plane(ap.Color(200, 214, 210))
        for i in 0..<60 do
            var a = h01(i, 120) * 360
            var at = forward_of(a) * (13 + h01(i, 121) * 30)
            var tall = 8 + h01(i, 122) * 10
            column(at, 0.3, tall * 0.3, ap.Color(80, 56, 40))
            for k in 0..<3 do
                var w = (1.0 - double(k) * 0.25) * tall * 0.28
                sd(rig.cone, at + ap.Vec3(0, tall * (0.3 + 0.22 * double(k)) + tall * 0.12, 0), ap.Color(40, 76 + k * 8, 52),
                    ap.Vec3(0, 0, 0), ap.Vec3(w, tall * 0.3, w))
            end
            sd(rig.cone, at + ap.Vec3(0, tall * 0.98, 0), ap.Color(236, 242, 240), ap.Vec3(0, 0, 0), ap.Vec3(tall * 0.07, tall * 0.08, tall * 0.07))
        end
        sd(disc, forward_of(150) * 18 + ap.Vec3(0, 0.02, 0), ap.Color(120, 160, 170), ap.Vec3(0, 0, 0), ap.Vec3(5, 0.04, 3.5))
        for k in 0..<8 do
            var at = forward_of(double(k) * 45 + 22) * 12.6
            sb(at + ap.Vec3(0, 0.9, 0), ap.Vec3(0.12, 1.8, 0.12), ap.Color(70, 50, 36))
            glow_box(at + ap.Vec3(0, 2.0, 0), ap.Vec3(0.4, 0.5, 0.4), ap.Color(255, 200, 120).fade(0.8 + 0.2 * math.sin(t * 0.05 + double(k))))
        end
    else if scene == roster.SCENE_STUDIO do
        # A wall of television sets, every one of them showing snow.
        ground_plane(ap.Color(30, 30, 36))
        for i in 0..<18 do
            var a = double(i) * 20
            var at = forward_of(a) * 20
            for r in 0..<4 do
                var y = 1 + double(r) * 1.9
                sb(at + ap.Vec3(0, y, 0), ap.Vec3(3.2, 1.7, 1.2), ap.Color(50, 50, 56), a)
                var noise = h01(i * 7 + r + ticks // 4, 98)
                var grey = int(90 + 140 * noise)
                var screen_color = ap.Color(grey, grey, grey)
                if h01(i + r * 18, 99) > 0.8 do
                    screen_color = m.glow.brightness(0.6 + 0.4 * noise)
                end
                glow_box(at - forward_of(a) * 0.62 + ap.Vec3(0, y, 0), ap.Vec3(2.6, 1.3, 0.05), screen_color, a)
            end
        end
        for k in 0..<3 do
            var a = double(k) * 120
            sb(forward_of(a) * 13 + ap.Vec3(0, 12, 0), ap.Vec3(26, 0.4, 0.4), ap.Color(60, 60, 64), a + 90)
            glow_box(forward_of(a) * 13 + ap.Vec3(0, 11.6, 0), ap.Vec3(0.6, 0.4, 0.6), ap.Color(255, 250, 230))
        end
    end
end

# The living part of a place: steam, smoke, sparks and rain.
function scene_life(int scene)
    if scene == roster.SCENE_REACTOR do
        if ap.chance(0.6) do
            var k = int(ap.random(0, 2.999))
            var top = forward_of(double(k) * 50 + 150) * 42 + ap.Vec3(ap.random(-3, 3), 27, ap.random(-3, 3))
            spark(top, ap.Vec3(ap.random(-0.5, 0.5), ap.random(2, 4), ap.random(-0.5, 0.5)), ap.Color(230, 225, 220), 3.0, 1.6, -0.2)
        end
    else if scene == roster.SCENE_TRENCHES do
        if ap.chance(0.4) do
            var at = forward_of(ap.random(0, 360)) * ap.random(18, 40)
            spark(at, ap.Vec3(0, ap.random(1, 2.5), 0), ap.Color(90, 86, 80), 3.0, 1.4, -0.1)
        end
    else if scene == roster.SCENE_FACTORY do
        if ap.chance(0.5) do
            var at = forward_of(ap.random(0, 360)) * ap.random(13, 18) + ap.Vec3(0, ap.random(1, 4), 0)
            for i in 0..<4 do
                spark(at, ap.Vec3(ap.random(-3, 3), ap.random(1, 4), ap.random(-3, 3)), ap.Color(255, 200, 80), 0.5, 0.06, 9)
            end
        end
    else if scene == roster.SCENE_ALLEY do
        for i in 0..<3 do
            var at = cam_focus + ap.Vec3(ap.random(-9, 9), 9, ap.random(-9, 9))
            streak(at, ap.Vec3(0, -18, 0), ap.Color(170, 190, 230), 0.5, 0.5, 0.025)
        end
    else if scene == roster.SCENE_SUN do
        if ap.chance(0.3) do
            spark(forward_of(ap.random(0, 360)) * ap.random(11, 14), ap.Vec3(0, ap.random(1, 3), 0), ap.Color(255, 230, 140), 1.2, 0.12, -0.5)
        end
    else if scene == roster.SCENE_GROVE do
        if ap.chance(0.6) do
            var at = cam_focus + ap.Vec3(ap.random(-12, 12), 9, ap.random(-12, 12))
            spark(at, ap.Vec3(ap.random(-0.3, 0.3), -1.2, ap.random(-0.3, 0.3)), ap.Color(250, 252, 255), 6.0, 0.06, 0)
        end
    else if scene == roster.SCENE_PIT do
        if ap.chance(0.2) do
            spark(forward_of(ap.random(0, 360)) * ap.random(12, 18), ap.Vec3(0, ap.random(0.5, 1), 0), ap.Color(150, 200, 90), 2.0, 0.08, -0.2)
        end
    else if scene == roster.SCENE_FOREST do
        if ap.chance(0.3) do
            var at = forward_of(ap.random(0, 360)) * ap.random(8, 20) + ap.Vec3(0, ap.random(4, 9), 0)
            spark(at, ap.Vec3(ap.random(-0.4, 0.4), -0.6, ap.random(-0.4, 0.4)), ap.Color(70, 70, 72), 4.0, 0.1, 0.1)
        end
    else if scene == roster.SCENE_LAB do
        if ap.chance(0.5) do
            var at = forward_of(double(int(ap.random(0, 9.99))) * 36 + 10) * 15 + ap.Vec3(ap.random(-0.5, 0.5), 0.6, ap.random(-0.5, 0.5))
            spark(at, ap.Vec3(0, ap.random(1, 2), 0), ap.Color(160, 255, 170), 1.8, 0.08, -0.2)
        end
    else if scene == roster.SCENE_QUARRY do
        if ap.chance(0.3) do
            spark(forward_of(ap.random(0, 360)) * ap.random(12, 22), ap.Vec3(0, ap.random(1, 2), 0), ap.Color(255, 140, 50), 1.2, 0.07, -0.3)
        end
    end
end

function draw_maximum_hud()
    if max_cut > 0 do
        var t = double(cut_len - max_cut)
        if cut_kind == CUT_JAM do
            draw_jam_hud(t)
            return
        end
        var bars = 44 * math.min(math.min(t / 12, 1.0), double(max_cut) / 12)
        ap.rect(0, 0, VW, bars, ap.BLACK)
        ap.rect(0, VH - bars, VW, bars, ap.BLACK)
        var f = fighters[cut_user]
        var show = math.clamp((t - 16) / 14, 0.0, 1.0) * math.min(double(max_cut) / 20, 1.0)
        if cut_len < 100 do
            show = math.clamp(t / 8, 0.0, 1.0) * math.min(double(max_cut) / 10, 1.0)
        end
        label_centered(cut_title, 320, 62, 32, MAX_GOLD.fade(show))
        var player = fighters[0]
        if can_merge(player) and not player.cpu do
            var pulse = 0.6 + 0.4 * math.sin(double(ticks) * 0.3)
            label_centered("G  MERGE YOUR SUPER INTO THEIRS", 320, VH - 30, 8, MAX_GOLD.fade(pulse))
        else if merge_pending >= 0 do
            label_centered("{fighters[merge_pending].kit.name} MERGES", 320, VH - 30, 8, fighters[merge_pending].kit.look.accent)
        end
        if cut_kind == CUT_MERGE do
            var o = other(f)
            var names = "{o.kit.name}  +  {f.kit.name}"
            var x = 320 - ap.measure(names, 8).x / 2
            label(o.kit.name, x, 100, 8, o.kit.look.accent.fade(show))
            label("+", x + ap.measure("{o.kit.name}  ", 8).x, 100, 8, ap.WHITE.fade(show))
            label(f.kit.name, x + ap.measure("{o.kit.name}  +  ", 8).x, 100, 8, f.kit.look.accent.fade(show))
            if t > double(cut_swap) do
                label_centered("{cut_def2.place} + {cut_def.place}", 320, 260, 16, cut_def.glow.lerp(cut_def2.glow, 0.5).fade(show))
            end
        else do
            label_centered("{f.kit.name}'S SUPER", 320, 100, 8, f.kit.look.accent.fade(show))
            if t > double(cut_swap) do
                label_centered(cut_def.place, 320, 260, 16, cut_def.glow.fade(show))
            end
        end
        var flash = math.max(1 - math.abs(t - double(cut_hit)) / 8, 0.0) * 0.7
        flash = math.max(flash, math.max(1 - math.abs(t - double(cut_swap)) / 16, 0.0))
        if flash > 0 do
            ap.rect(0, 0, VW, VH, ap.WHITE.fade(flash))
        end
        return
    end
    if max_owner >= 0 do
        # How long the places in force have left.
        var left = double(max_left) / (max_def.seconds * 60)
        var y = 55.0
        ap.rect(259, y, 122, 4, ap.BLACK.fade(0.7))
        ap.rect(260, y + 1, 120 * left, 2, max_def.glow)
        if merge_owner >= 0 do
            ap.rect(259, y + 5, 122, 4, ap.BLACK.fade(0.7))
            ap.rect(260, y + 6, 120 * double(merge_left) / (merge_def.seconds * 60), 2, merge_def.glow)
        end
    end
    if return_flash > 0 do
        ap.rect(0, 0, VW, VH, ap.WHITE.fade(double(return_flash) / 24))
    end
end

# TELEMAN switches it off: the picture squeezes to a line, then a dot, then comes back.
function draw_jam_hud(double t)
    var f = fighters[cut_user]
    var mid = VH / 2
    if t < double(JAM_CLICK) do
        var show = math.clamp(t / 6, 0.0, 1.0)
        label_centered(cut_title, 320, 62, 32, f.kit.look.accent.fade(show))
        label_centered("{f.kit.name} CHANGES THE CHANNEL", 320, 100, 8, ap.WHITE.fade(show))
        return
    end
    if t < double(JAM_DARK) do
        var p = (t - double(JAM_CLICK)) / double(JAM_DARK - JAM_CLICK)
        if p < 0.6 do
            var h = math.max(VH * (1 - p / 0.6), 2.0)
            ap.rect(0, 0, VW, mid - h / 2, ap.BLACK)
            ap.rect(0, mid + h / 2, VW, VH - mid - h / 2, ap.BLACK)
            ap.rect(0, mid - h / 2, VW, h, ap.WHITE.fade(0.5 * p / 0.6))
        else do
            var w = math.max(VW * (1 - (p - 0.6) / 0.4), 3.0)
            ap.rect(0, 0, VW, VH, ap.BLACK)
            ap.rect(320 - w / 2, mid - 1, w, 2, ap.WHITE)
        end
        return
    end
    var back = (t - double(JAM_DARK)) / double(JAM_TICKS - JAM_DARK)
    if back < 0.3 do
        ap.rect(0, 0, VW, VH, ap.BLACK)
        ap.circle(320, mid, 3 * (1 - back / 0.3), ap.WHITE)
        label_centered("OFF AIR", 320, mid + 20, 16, f.kit.look.accent.fade(1 - back / 0.3))
        return
    end
    var h = VH * (back - 0.3) / 0.7
    ap.rect(0, 0, VW, mid - h / 2, ap.BLACK)
    ap.rect(0, mid + h / 2, VW, VH - mid - h / 2, ap.BLACK)
end

# Tries to begin a move: the basic chain at `chain`, a skill, or the super. True if something began.
function start_move(Fighter f, Fighter o, int slot, int chain = 0) returns bool
    var kit = f.kit
    var a = kit.ultimate
    if slot == SLOT_SUPER do
        if encore_ready(f) do
            # Inside your own super, G is the old super move, once.
            f.encore_used = true
        else if f.minion do
            return false
        else if max_cut > 0 or in_super(f) or merge_owner >= 0 do
            deny(f, "A SUPER IS ON")
            return false
        else if max_owner >= 0 and not kit.maximum.jammer do
            deny(f, "MERGE IN THEIR CUTSCENE")
            return false
        else if f.energy < roster.SUPER_MAX do
            deny(f, "SUPER NOT READY")
            return false
        else if kit.maximum.jammer and max_owner < 0 do
            deny(f, "ONLY IN THEIR SUPER")
            return false
        else do
            # Their own, a merge with the one already on, or a switch-off.
            begin_maximum(f)
            return true
        end
    else if slot == SLOT_BASIC do
        if chain == 0 and mx(f).randomize do
            random_chain(f)
        end
        a = kit.basics[chain]
        if not can_pay(f, a.cost) do
            if kit.fallback.name == "" do
                deny(f, "NO {kit.bar_name}")
                return false
            end
            a = kit.fallback
        end
    else do
        a = kit.skills[slot]
        if a.kind == roster.KIND_CLOAK and f.cloaked do
            set_cloak(f, false)
            return true
        end
        if f.cooldowns[slot] > 0 do
            deny(f, "{(f.cooldowns[slot] + 59) // 60}s")
            return false
        end
        if a.kind == roster.KIND_RELOAD do
            if f.bar >= kit.bar_max do
                return false
            end
            f.cooldowns[slot] = a.cooldown
            begin_reload(f)
            return true
        end
        if a.kind == roster.KIND_FAN and pips(kit, f.bar) < 1 do
            deny(f, "NO {kit.bar_name}")
            return false
        end
        if not can_pay(f, a.cost) do
            deny(f, "NO {kit.bar_name}")
            return false
        end
        f.cooldowns[slot] = int(double(a.cooldown) * stacked(f, roster.ITEM_HOURGLASS, 0.65))
    end
    var hits = a.hits
    if a.kind == roster.KIND_FAN do
        hits = pips(kit, f.bar)
    end
    begin_attack(f, a, hits)
    f.slot = slot
    f.chain = chain
    if slot == SLOT_SUPER do
        super_begins(f, a)
    else if slot >= 0 do
        reshuffle(f, slot)
    end
    return true
end

# A super is called: everything holds its breath for a moment.
function super_begins(Fighter f, roster.Attack a)
    var here = f.body.position
    var red = ap.Color(240, 50, 60)
    super_name = a.name
    super_ticks = 80
    super_tint = f.kit.look.accent
    sound_at(snd_bell, here, 0.7, 0.5)
    sound_at(snd_charge, here, 0.7, 0.6)
    later(snd_thud, here, 6, 0.6, 1.2)
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), red, 7, 0.45))
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 4, 0.45))
    for i in 0..<24 do
        var out = forward_of(double(i) * 15) * ap.random(0.4, 0.9)
        streak(here + out + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(4, 9), 0), red if i % 2 == 0 else f.kit.look.accent,
            0.4, 0.7, 0.06)
    end
    ap.hitstop(14)
end

function give_buff(Fighter f, roster.Attack a)
    var here = f.body.position
    var tint = f.kit.look.accent
    f.buff = a.buff
    f.buff_time = a.buff_time
    f.buff_rate = a.heal
    say(f.body.top(), a.name.upper(), tint)
    rings.push(Ring(here + ap.Vec3(0, 0.1, 0), tint, 6, 0.3))
    if a.buff == roster.BUFF_MIST do
        sound_at(snd_cloak, here, 0.6, 1.3)
        smoke(f.body.center(), 12, 0.5, 0.9)
    else if a.buff == roster.BUFF_REGEN do
        sound_at(snd_heal, here, 0.6)
        later(snd_heal, here, 8, 0.5, 1.3)
    else if a.buff == roster.BUFF_HASTE do
        sound_at(snd_kiai, here, 0.6, 1.3)
        later(snd_charge, here, 3, 0.4, 1.5)
        for i in 0..<16 do
            streak(here + forward_of(double(i) * 22) * 0.6, ap.Vec3(0, ap.random(4, 8), 0), tint, 0.3, 0.6)
        end
    else do
        sound_at(snd_thud, here, 0.7, 1.3)
        sound_at(snd_block, here, 0.6, 0.6)
        rings.push(Ring(f.body.center(), f.kit.look.metal, 3, 0.25, true))
    end
end

# A buff shows for as long as it lasts.
function buff_trail(Fighter f)
    var here = f.body.position
    var tint = f.kit.look.accent
    if f.buff == roster.BUFF_MIST do
        spark(f.body.center() + scatter(0.5), ap.Vec3(0, ap.random(0.2, 0.9), 0),
            tint if ap.chance(0.3) else ap.Color(150, 150, 165), 0.5, 0.11, -0.3)
    else if f.buff == roster.BUFF_HASTE do
        if ap.chance(0.5) do
            streak(here + forward_of(ap.random(0, 360)) * 0.45 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, ap.random(3, 5), 0), tint, 0.25, 0.4)
        end
    else if f.buff == roster.BUFF_REGEN do
        f.health = math.min(f.health + f.buff_rate / 60, f.max_health)
        if ap.chance(0.4) do
            spark(f.body.center() + scatter(0.45), ap.Vec3(0, ap.random(0.8, 1.6), 0), ap.Color(120, 240, 130), 0.5, 0.08, 0)
        end
    else if f.buff == roster.BUFF_POWER do
        if ap.chance(0.5) do
            spark(puppet.muzzle(f.kit.look, here, f.heading) + scatter(0.15), ap.Vec3(0, ap.random(0.5, 1.2), 0), tint, 0.3, 0.07, 0)
        end
    else if f.buff == roster.BUFF_PARRY do
        # Still water: a slow ring of leaves around her.
        var turn = double(ticks) * 4
        spark(f.body.center() + forward_of(turn) * 0.8, ap.Vec3(0, -0.2, 0), tint, 0.3, 0.07, 0)
    else if f.buff == roster.BUFF_GUARD do
        var around = double(ticks) * 9
        spark(f.body.center() + forward_of(around) * 0.75, ap.Vec3(0, 0.2, 0), f.kit.look.metal, 0.25, 0.09, 0)
        spark(f.body.center() + forward_of(around + 180) * 0.75, ap.Vec3(0, 0.2, 0), tint, 0.25, 0.09, 0)
    end
end

# An instant step `far` meters the way the stick points, or straight away from the opponent.
function blink(Fighter f, Fighter o, double far)
    var body = f.body
    var from = body.center()
    var tint = f.kit.look.accent
    var way = unit(flat(f.wish))
    if f.wish.length() < 0.2 do
        way = unit(flat(body.position - o.body.position))
    end
    var reach = far
    var spot = body.position
    while reach > 0.5 do
        var there = body.position + way * reach
        there = ap.Vec3(there.x, 0, there.z)
        if flat(there).length() < ARENA - 0.6 and not world.overlaps(there + ap.Vec3(0, 1, 0), 0.5) and
                flat_distance(there, o.body.position) > 0.9 do
            spot = there
            break
        end
        reach -= 0.5
    end
    sound_at(snd_flash, from, 0.6, 1.2)
    later(snd_rift, spot, 2, 0.4, 1.8)
    leave_ghost(f, 0.4)
    gather(from, 12, tint, 1.1, 0.2, 0.09)
    rings.push(Ring(from, tint, 5, 0.2, true))
    rings.push(Ring(spot + ap.Vec3(0, 0.08, 0), tint, 6, 0.25))
    for i in 0..<10 do
        streak(spot + forward_of(double(i) * 36) * 0.5, ap.Vec3(0, ap.random(4, 7), 0), tint, 0.2, 0.5)
    end
    body.position = spot
    f.knock = ap.Vec3(0, 0, 0)
    if o.fade > 0.5 do
        f.heading = heading_of(o.body.position - spot)
    end
end

# Puts a move's shots in the air: one, a spread, a lob, a mine at the feet, or something from the sky.
function fire_shots(Fighter f, Fighter o, roster.Attack a, ap.Vec3 from, ap.Vec3 aim, double bonus, double boost = 1)
    var seen = o.fade > 0.5 and o.state != STATE_DOWN
    var target = target_of(f, o) if seen else f.body.position + forward_of(f.heading) * 6
    var power = boost * f.power_scale
    target = ap.Vec3(target.x, 0, target.z)
    if a.skyfall do
        if f.move_hits > 1 and f.hits_done > 1 do
            # The rest of a salvo falls around the first.
            target = target + ap.Vec3(ap.random(-2.4, 2.4), 0, ap.random(-2.4, 2.4))
        end
        var s = Shot(f.id, a, target + ap.Vec3(0, 14, 0), ap.Vec3(0, -a.shot_speed, 0), a.shot_life)
        s.bonus = bonus
        s.scale = power
        shots.push(s)
        # A shadow of what is coming, so there is a chance to run.
        stain(target, f.kit.look.accent, a.blast, 14 / a.shot_speed + 0.15, 0.3)
        return
    end
    if a.shot == roster.SHOT_MINE do
        var mine = Shot(f.id, a, f.body.position + forward_of(f.heading) * 0.9 + ap.Vec3(0, 0.1, 0), ap.Vec3(0, 0, 0), a.shot_life)
        mine.scale = power
        shots.push(mine)
        return
    end
    if a.summon > 0 do
        # It comes from behind the caller and drives straight at them.
        var way = unit(flat(target - f.body.position))
        if way.length() < 0.5 do
            way = forward_of(f.heading)
        end
        var start = f.body.position - way * a.summon
        if flat(start).length() > ARENA - 1.2 do
            start = unit(flat(start)) * (ARENA - 1.2)
        end
        var car = Shot(f.id, a, ap.Vec3(start.x, 0.7, start.z), unit(flat(target - start)) * a.shot_speed, a.shot_life)
        car.scale = power
        shots.push(car)
        return
    end
    if a.lob do
        var to = target - from
        var t = math.clamp(flat(to).length() / a.shot_speed, 0.45, 1.1)
        var thrown = Shot(f.id, a, from, ap.Vec3(to.x / t, to.y / t + 0.5 * LOB_GRAVITY * t, to.z / t), a.shot_life)
        thrown.scale = power
        shots.push(thrown)
        return
    end
    for i in 0..<a.volley do
        var off = (double(i) - double(a.volley - 1) / 2) * a.spread
        var way = aim
        if off != 0 do
            way = forward_of(heading_of(aim) + off) * flat(aim).length() + ap.Vec3(0, aim.y, 0)
        end
        var s = Shot(f.id, a, from, way * a.shot_speed, a.shot_life)
        s.bonus = bonus
        s.scale = power
        shots.push(s)
    end
end

# A ray: it reaches as far as `beam` or the first thing in the way, and whoever it crosses is hit at once.
# How far along a ray from `from` going `way` it passes within `radius` of `center`; -1 if it misses.
function beam_along(ap.Vec3 from, ap.Vec3 way, ap.Vec3 center, double radius, double far) returns double
    var to = center - from
    var along = dot3(to, way)
    var off = (to - way * along).length()
    if along > 0 and along < far + 0.4 and off < radius + 0.4 do
        return along
    end
    return -1
end

function fire_beam(Fighter f, Fighter o, roster.Attack a, double bonus)
    var tint = f.kit.look.accent
    var from = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    var way = forward_of(f.heading)
    var seen = o.fade > 0.5 and o.state != STATE_DOWN
    var spot = target_of(f, o)
    if seen and ap.in_cone(f.body.position, way, spot, 70) do
        way = unit(spot + ap.Vec3(0, o.body.height * 0.5, 0) - from)
    end
    # How far the light gets before stone stops it.
    var far = 0.0
    while far < a.beam and not world.overlaps(from + way * (far + 0.4), 0.05) do
        far += 0.4
    end
    # The first thing it crosses: the opponent, one of their clones, or a mirror copy.
    var best = far
    var hit_kind = 0
    var hit_minion = o
    var hit_mirror = Mirror(-1, 0, 0, 0)
    if o.state != STATE_DOWN do
        var d = beam_along(from, way, o.body.center(), o.body.radius, far)
        if d >= 0 do
            best = d
            hit_kind = 1
        end
    end
    for m in minions do
        if m.id == o.id and m != f do
            var d = beam_along(from, way, m.body.center(), m.body.radius, far)
            if d >= 0 and d < best do
                best = d
                hit_kind = 2
                hit_minion = m
            end
        end
    end
    for mi in mirrors do
        if mi.owner == o.id do
            var d = beam_along(from, way, mirror_at(mi) + ap.Vec3(0, 0.9, 0), 0.36, far)
            if d >= 0 and d < best do
                best = d
                hit_kind = 3
                hit_mirror = mi
            end
        end
    end
    var finish = from + way * best
    var wide = 0.08 + a.damage * 0.012
    beams.push(Beam(from, finish, tint, wide, 0.14, 0.14))
    sound_at(weapon_fire_sound(f), from, 0.4 if f.move_hits > 1 else 0.6, 1.0)
    # The energy-beam layers; a revolver's shot is only the gunshot.
    if f.hits_done == 1 and f.kit.look.weapon != roster.WEAPON_REVOLVER do
        sound_at(snd_slash, from, 0.6, 1.4)
        later(snd_charge, from, 1, 0.4, 2.2)
    end
    for i in 0..<5 do
        streak(finish, unit(scatter(1)) * ap.random(3, 7), tint if i % 2 == 0 else ap.WHITE, 0.16, 0.35)
    end
    if hit_kind == 1 do
        apply_hit(f, o, a, 1, from, false, bonus)
    else if hit_kind == 2 do
        apply_hit(f, hit_minion, a, 1, from, false, bonus)
    else if hit_kind == 3 do
        shatter_mirror(hit_mirror)
    else do
        burst(finish, 4, tint, 2, 0.3, 0.06)
    end
end

# One end of a pair of doors, a few steps ahead. A third replaces the oldest.
function open_portal(Fighter f, roster.Attack a)
    var way = forward_of(f.heading)
    var reach = a.blink
    var spot = f.body.position + way * reach
    while reach > 1 and (flat(spot).length() > ARENA - 1 or world.overlaps(spot + ap.Vec3(0, 1, 0), 0.6)) do
        reach -= 0.5
        spot = f.body.position + way * reach
    end
    Portal[] mine = []
    Portal[] kept = []
    for p in portals do
        if p.owner == f.id do
            mine.push(p)
        else do
            kept.push(p)
        end
    end
    if mine.length >= 2 do
        mine = [mine[1]]
    end
    for p in mine do
        kept.push(p)
    end
    kept.push(Portal(f.id, ap.Vec3(spot.x, 0, spot.z), ticks))
    portals = kept
    var at = spot + ap.Vec3(0, 1, 0)
    sound_at(snd_rift, at, 0.6, 1.4)
    later(snd_wisp, at, 4, 0.4, 1.4)
    rings.push(Ring(at, f.kit.look.accent, 4, 0.25, true))
    gather(at, 14, f.kit.look.accent, 1.2, 0.25, 0.08)
end

# What going through someone else's portal does to you: a burn no block stops, and a dose.
function portal_burn() returns roster.Attack
    var a = roster.hit("Portal", 8, 1, 1, 0, 0, 0, 16, 0, roster.ANIM_FOCUS)
    a.unblockable = true
    a.poison = 2
    return a
end
var portal_hit = portal_burn()

# Anyone, and anything flying, that enters one of a pair comes out of the other.
function update_portals()
    for owner in 0..<2 do
        Portal[] pair = []
        for p in portals do
            if p.owner == owner do
                pair.push(p)
            end
        end
        if pair.length < 2 do
            continue
        end
        for side in 0..<2 do
            var here = pair[side]
            var there = pair[1 - side]
            for g in fighters do
                if g.warp_cool > 0 or g.state == STATE_DOWN or ticks - here.born < 20 do
                    continue
                end
                if flat_distance(g.body.position, here.position) < 0.8 and g.body.position.y < 1.6 do
                    # Out the other side, still going the same way.
                    var going = unit(flat(g.body.velocity))
                    if going.length() < 0.5 do
                        going = forward_of(g.heading)
                    end
                    var out = there.position + going * 1.0
                    if flat(out).length() > ARENA - 0.6 or world.overlaps(out + ap.Vec3(0, 1, 0), 0.5) do
                        out = there.position
                    end
                    leave_ghost(g, 0.3)
                    burst(g.body.center(), 12, fighters[owner].kit.look.accent, 4, 0.35, 0.08)
                    g.body.position = ap.Vec3(out.x, g.body.position.y, out.z)
                    g.warp_cool = 55
                    sound_at(snd_flash, there.position, 0.6, 1.3)
                    rings.push(Ring(there.position + ap.Vec3(0, 1, 0), fighters[owner].kit.look.accent, 5, 0.2, true))
                    burst(g.body.center(), 12, ap.WHITE, 4, 0.35, 0.08)
                    if g.id != owner do
                        # The doors are tuned to their maker: anyone else comes out scorched,
                        # still flying the way they were thrown.
                        var thrown = g.knock
                        apply_hit(fighters[owner], g, portal_hit, 1, there.position - going, false)
                        g.knock = thrown
                        sound_at(snd_splash, there.position, 0.5, 1.7)
                        for i in 0..<10 do
                            streak(g.body.center(), unit(scatter(1)) * 5, fighters[owner].kit.look.accent, 0.2, 0.4)
                        end
                    end
                end
            end
            for sh in shots do
                var at = here.position + ap.Vec3(0, 1, 0)
                if not sh.warped and sh.attack.shot != roster.SHOT_MINE and not sh.attack.skyfall and
                        (sh.position - at).length() < 0.9 do
                    sh.warped = true
                    sh.position = there.position + ap.Vec3(0, sh.position.y, 0) + unit(flat(sh.velocity)) * 0.9
                    sound_at(snd_flash, there.position, 0.3, 1.8)
                end
            end
        end
    end
end

function begin_reload(Fighter f)
    f.state = STATE_RELOAD
    f.frame = 0
    sound_at(snd_reload, f.body.position, 0.5)
    # The spent casings drop out.
    var hand = puppet.muzzle(f.kit.look, f.body.position, f.heading)
    for i in 0..<5 do
        spark(hand + scatter(0.08), ap.Vec3(ap.random(-0.8, 0.8), ap.random(0.2, 1.2), ap.random(-0.8, 0.8)),
            ap.Color(230, 190, 90), 1.0, 0.05, 9)
        later(snd_casing, hand, 22 + i * 3, 0.22, ap.random(0.85, 1.25))
    end
end

# A move's strike: a melee check, or a shot leaving the hand.
function strike(Fighter f, Fighter o)
    var a = f.move
    var look = f.kit.look
    if a.kind == roster.KIND_BUFF do
        give_buff(f, a)
        return
    else if a.kind == roster.KIND_BLINK do
        blink(f, o, a.blink)
        return
    else if a.kind == roster.KIND_CLOAK do
        set_cloak(f, true)
        return
    else if a.kind == roster.KIND_PORTAL do
        open_portal(f, a)
        return
    else if a.kind == roster.KIND_LOCK do
        toggle_lock(f)
        return
    else if a.kind == roster.KIND_SWAP do
        swap_weapon(f)
        return
    else if a.kind == roster.KIND_RECALL do
        recall_daggers(f, o)
        return
    else if a.kind == roster.KIND_MIRROR do
        make_mirrors(f, o, a)
        return
    else if a.kind == roster.KIND_GLASS do
        glass_swap(f, o, a)
        return
    else if a.kind == roster.KIND_SHATTER do
        shatter_mirrors(f, o, a)
        return
    else if a.kind == roster.KIND_WALL do
        raise_wall(f, o, a)
        return
    else if a.kind == roster.KIND_SWITCH do
        switch_places(f, o)
        return
    end
    if a.per_hit and not mx(f).free_bar do
        if f.bar + 0.001 < a.cost do
            return
        end
        f.bar -= a.cost
    end
    if a.on_trigger and not f.empowered do
        # Nobody took the bait: the spin ends with a round slid in.
        if a.restock > 0 and f.bar < f.kit.bar_max do
            f.bar = math.min(f.bar + a.restock, f.kit.bar_max)
            say(f.body.top(), "+{int(a.restock)}", look.accent)
            sound_at(snd_reload, f.body.position, 0.5, 1.2)
        end
        return
    end
    if f.cloaked do
        set_cloak(f, false)
    end
    if a.restock > 0 and not a.on_trigger do
        f.bar = math.min(f.bar + a.restock, f.kit.bar_max)
    end
    if a.buff != roster.BUFF_NONE do
        f.buff = a.buff
        f.buff_time = a.buff_time
        if a.buff == roster.BUFF_POWER do
            say(f.body.top(), "LOADED", f.kit.look.accent)
        end
    end
    var bonus = a.finish if f.hits_done == f.move_hits else 0.0
    var forward = forward_of(f.heading)
    if a.recoil > 0 do
        f.knock = forward * -a.recoil
    end
    if a.beam > 0 do
        fire_beam(f, o, a, bonus)
        return
    end
    if a.shot != roster.SHOT_NONE do
        var from = puppet.muzzle(look, f.body.position, f.heading)
        var aim = forward
        if o.fade > 0.5 and o.state != STATE_DOWN do
            var spot = target_of(f, o)
            var to = spot + ap.Vec3(0, o.body.height * 0.5, 0) - from
            # Only as far off the facing as an arm could point.
            if ap.in_cone(f.body.position, forward, spot, 70) do
                aim = unit(to)
            end
        end
        if a.crater do
            tear_ground(f)
        end
        if a.shot == roster.SHOT_BULLET and f.move_hits > 1 do
            aim = unit(aim + ap.Vec3(ap.random(-0.05, 0.05), ap.random(-0.02, 0.02), ap.random(-0.05, 0.05)))
        else if a.shot == roster.SHOT_ROCKET and f.move_hits > 1 do
            aim = unit(aim + ap.Vec3(ap.random(-0.14, 0.14), ap.random(-0.02, 0.05), ap.random(-0.14, 0.14)))
        end
        var boost = 1.0
        if f.buff == roster.BUFF_POWER do
            # The loaded shot goes off.
            boost = 1.8
            f.buff = roster.BUFF_NONE
            say(f.body.top(), "LOADED SHOT", look.accent)
            rings.push(Ring(from, look.accent, 3, 0.2, true))
            sound_at(snd_boom, from, 0.5, 1.8)
        end
        fire_shots(f, o, a, from, aim, bonus, boost)
        if a.shot == roster.SHOT_BULLET do
            # Muzzle fire, a curl of smoke, and the casing spinning away. Fanned shots climb in pitch.
            sound_at(weapon_fire_sound(f), from, 0.6, 0.9 + 0.05 * double(f.hits_done) if f.move_hits > 1 else 1.0)
            burst(from, 5, ap.Color(255, 220, 140), 3, 0.15, 0.06)
            for i in 0..<5 do
                streak(from, unit(aim + scatter(0.25)) * ap.random(6, 10), ap.Color(255, 230, 150), 0.08, 0.35)
            end
            smoke(from, 2, 0.05, 0.6)
            spark(from - aim * 0.2, right_of(f.heading) * ap.random(1.2, 2) + ap.Vec3(0, ap.random(2, 3), 0),
                ap.Color(230, 190, 90), 1.0, 0.05, 9)
            later(snd_casing, from, 26, 0.22, ap.random(0.85, 1.25))
        else if a.shot == roster.SHOT_ROCKET do
            # The launch kicks smoke and flame out behind.
            sound_at(snd_shot, from, 0.7, 0.45)
            sound_at(snd_launch, from, 0.7)
            burst(from, 10, ap.Color(200, 200, 200), 2.5, 0.5, 0.1)
            for i in 0..<12 do
                spark(from - aim * 0.5 + scatter(0.15), aim * -ap.random(2, 5) + ap.Vec3(0, ap.random(0, 1), 0),
                    ap.Color(120, 120, 132), 0.7, 0.13, -0.5)
            end
            for i in 0..<6 do
                streak(from - aim * 0.4, (aim * -1.0 + scatter(0.3)) * 6, ap.Color(255, 170, 70), 0.12, 0.4)
            end
            rings.push(Ring(f.body.position + ap.Vec3(0, 0.08, 0), ap.Color(130, 130, 140), 5, 0.3))
        else if a.shot == roster.SHOT_CAR do
            # Somebody leans on the horn.
            sound_at(snd_kiai, f.body.position, 0.6, 1.4)
            later(snd_kiai, f.body.position, 9, 0.6, 1.4)
            later(snd_launch, f.body.position, 4, 0.5, 0.7)
        else if a.shot == roster.SHOT_KNIFE do
            sound_at(weapon_swing_sound(f), from, 0.5, 1.6)
        else if a.shot == roster.SHOT_FIST do
            sound_at(snd_launch, from, 0.6, 1.3)
            sound_at(snd_heavy, from, 0.5, 1.2)
            burst(from, 8, look.accent, 3, 0.3, 0.08)
        else if a.shot == roster.SHOT_RING do
            for i in 0..<4 do
                later(snd_lock, o.body.position, 2 + i * 6, 0.5, 1.5 if i % 2 == 0 else 1.9)
            end
        else if a.shot == roster.SHOT_BATS do
            sound_at(snd_wisp, from, 0.5, 1.9)
            sound_at(snd_hiss, from, 0.3, 0.6)
            burst(from, 10, ap.Color(40, 20, 34), 3, 0.4, 0.09)
        else if a.shot == roster.SHOT_WAVE do
            sound_at(snd_slash, from, 0.6, 0.9)
            later(snd_shing, from, 3, 0.3, 0.7)
            for i in 0..<8 do
                streak(from + scatter(0.3), aim * ap.random(5, 9), look.accent, 0.15, 0.5)
            end
        else if a.shot == roster.SHOT_BOMB do
            sound_at(snd_dash, from, 0.5, 0.7)
            later(snd_hiss, from, 2, 0.4, 1.2)
        else if a.shot == roster.SHOT_MINE do
            sound_at(snd_reload, from, 0.6, 0.6)
            later(snd_lock, from, 10, 0.4, 0.8)
            rings.push(Ring(f.body.position + forward * 0.9 + ap.Vec3(0, 0.08, 0), look.accent, 3, 0.25))
        else if a.shot == roster.SHOT_METEOR do
            sound_at(snd_thud, from, 0.6, 0.7)
            later(snd_launch, f.body.position, 12, 0.7, 0.5)
            for i in 0..<16 do
                streak(f.body.top() + scatter(0.3), ap.Vec3(ap.random(-1, 1), ap.random(9, 14), ap.random(-1, 1)), look.accent, 0.35, 0.8, 0.06)
            end
        else if a.shot == roster.SHOT_VENOM do
            sound_at(snd_spit, from, 0.6)
            sound_at(snd_splash, from, 0.3, 1.6)
            for i in 0..<8 do
                spark(from, (aim + scatter(0.35)) * ap.random(2, 5), look.accent, 0.3, 0.06, 6)
            end
        else do
            sound_at(snd_cast, from, 0.5)
            later(snd_shimmer, from, 4, 0.3)
            for i in 0..<10 do
                streak(from, unit(scatter(1)) * 4, look.accent, 0.16, 0.3)
            end
            rings.push(Ring(from, look.accent, 1.6, 0.15, true))
        end
        return
    end
    if a.damage <= 0 and a.reach <= 0 do
        # Nothing but footwork.
        burst(f.body.position + ap.Vec3(0, 0.1, 0), 6, ap.Color(120, 115, 140), 2, 0.35, 0.09)
        return
    end
    # The sweep of the blow, shown as a fan of sparks.
    var sweep = math.min(a.arc, 150.0)
    if a.radial do
        rings.push(Ring(f.body.position + ap.Vec3(0, 0.15, 0), look.accent, a.reach / 0.3, 0.3))
        rings.push(Ring(f.body.center(), look.accent, a.reach / 0.35, 0.35, true))
        sound_at(snd_boom, f.body.position, 0.6, 1.6)
    else do
        for i in 0..<9 do
            var around = f.heading + sweep * (double(i) / 8 - 0.5)
            var at = f.body.position + forward_of(around) * (a.reach * 0.82) + ap.Vec3(0, 1.0 + 0.5 * double(i) / 8, 0)
            spark(at, forward_of(around) * 1.5, look.accent, 0.16, 0.07, 0)
        end
    end
    skill_strikes(f, a)
    # Clones on their side and mirror copies are in the way too.
    for m in minions do
        if m.id == o.id and m != f and m.state != STATE_DOWN and
                flat_distance(f.body.position, m.body.position) <= a.reach + m.body.radius and
                (a.radial or ap.in_cone(f.body.position, forward, m.body.position, a.arc)) do
            apply_hit(f, m, a, 1, f.body.position, true, bonus)
        end
    end
    break_mirrors(f, o.id, a)
    if o.state == STATE_DOWN do
        return
    end
    var gap = flat_distance(f.body.position, o.body.position)
    var level = math.abs(f.body.position.y - o.body.position.y) < 1.6
    if gap <= a.reach + o.body.radius and level and
            (a.radial or ap.in_cone(f.body.position, forward, o.body.position, a.arc)) do
        apply_hit(f, o, a, 1, f.body.position, true, bonus)
    end
    if a.shroud do
        set_cloak(f, true)
    end
end

# Damage, blocking, parries, and everything a landed hit sets off.
# Nobody can be kept in a combo forever: after enough moves in a row the victim bursts free,
# cannot be hit for a moment, and the attacker is thrown back.
function combo_break(Fighter o, Fighter f)
    var at = o.body.center()
    o.state = STATE_IDLE
    o.frame = 0
    o.stun = 0
    o.safe = 50
    o.pressure = 0
    o.taken = 0
    o.since_hit = COMBO_GRACE
    o.knock = ap.Vec3(0, 0, 0)
    f.knock = unit(flat(f.body.position - o.body.position)) * 11
    say(o.body.top() + ap.Vec3(0, 0.3, 0), "BREAK FREE", ap.WHITE)
    sound_at(snd_parry, at, 0.7, 0.7)
    sound_at(snd_thud, at, 0.6, 1.5)
    rings.push(Ring(o.body.position + ap.Vec3(0, 0.1, 0), ap.WHITE, 8, 0.3))
    rings.push(Ring(at, ap.WHITE, 5, 0.2, true))
    for i in 0..<14 do
        streak(at, unit(scatter(1)) * 7, ap.WHITE, 0.2, 0.5)
    end
end

function is_basic(Fighter f, roster.Attack a) returns bool
    for b in f.kit.basics do
        if b == a do
            return true
        end
    end
    return a == f.kit.fallback
end

function apply_hit(Fighter f, Fighter o, roster.Attack a, double scale, ap.Vec3 origin, bool melee, double bonus = 0)
    if o.state == STATE_DOWN or phase != PHASE_FIGHT do
        return
    end
    var look = f.kit.look
    var at = o.body.center() + unit(flat(origin - o.body.position)) * 0.3
    # Some things simply cannot be hit.
    var slipping = o.state == STATE_ATTACK and o.move.evade and o.frame < o.move.startup + 4
    if o.buff == roster.BUFF_MIST or slipping or o.safe > 0 do
        say(o.body.top(), "MISS", ap.GRAY)
        burst(at, 4, ap.Color(150, 150, 165), 2, 0.3, 0.07)
        return
    end
    var damage = (a.damage + bonus) * scale * f.kit.greed * f.power_scale * (1 + 0.25 * double(item_count(f, roster.ITEM_WHETSTONE)))
    var basic = is_basic(f, a)
    if o.cpu do
        # Whatever hit them, they know where the real one is now.
        o.decoy = -1
    end
    if basic do
        # The more they have been leaned on lately, the less they do.
        damage *= BASIC_SCALE * (1 - SPAM_STALE * f.spam)
    end
    if f.cpu do
        damage *= LEVEL_DAMAGE[level]
    end
    if f.ambush do
        f.ambush = false
        var behind = not ap.in_cone(o.body.position, forward_of(o.heading), f.body.position, 200)
        damage *= roster.AMBUSH_BONUS if behind else roster.CLOAK_BONUS
        say(o.body.top(), "AMBUSH" if behind else "UNSEEN", look.accent)
        sound_at(snd_ambush, at, 0.6, 1.0 if behind else 1.3)
        rings.push(Ring(at, look.accent, 6, 0.22, true))
        for i in 0..<10 do
            streak(at, unit(scatter(1)) * 5, look.accent, 0.2, 0.45)
        end
    end
    if f.empowered and melee do
        damage *= roster.COUNTER_BONUS
        say(o.body.top(), "COUNTER", look.accent)
        rings.push(Ring(at, ap.WHITE, 6, 0.2, true))
    end
    if o.poison > 0 do
        damage *= f.kit.toxic_bonus
    end
    if melee and f.kit.backstab > 1 and not ap.in_cone(o.body.position, forward_of(o.heading), f.body.position, 200) do
        damage *= f.kit.backstab
        say(o.body.top(), "BACKSTAB", look.accent)
    end
    var guarding = o.state == STATE_BLOCK and
        ap.in_cone(o.body.position, forward_of(o.heading), origin, 170)
    var waiting = o.state == STATE_ATTACK and o.move.counter and o.frame < o.move.startup and not o.empowered
    if waiting or (guarding and (o.block_age <= PARRY_TICKS or mx(o).perfect_guard or o.buff == roster.BUFF_PARRY)) do
        # A parry: nothing lands, and a melee attacker is left open.
        sound_at(snd_parry, at, 0.7)
        burst(at, 14, ap.WHITE, 4, 0.35, 0.07)
        rings.push(Ring(at, ap.WHITE, 5, 0.2, true))
        say(o.body.top(), "PARRY", ap.WHITE)
        o.bar = math.min(o.bar + o.kit.parry_gain, o.kit.bar_max)
        o.energy = math.min(o.energy + 3 * gain(o), roster.SUPER_MAX)
        if mx(o).parry_heal > 0 do
            o.health = math.min(o.health + mx(o).parry_heal, o.max_health)
            say(o.body.top() + ap.Vec3(0, 0.3, 0), "+{int(mx(o).parry_heal)}", ap.Color(120, 240, 130))
        end
        if melee do
            f.state = STATE_HURT
            f.stun = 46
            f.stun_total = 46
            f.knock = unit(flat(f.body.position - o.body.position)) * 5
        end
        if waiting do
            # The wait is over: straight into the answer.
            o.empowered = true
            o.frame = o.move.startup - 5
            o.heading = heading_of(f.body.position - o.body.position)
        end
        ap.hitstop(8)
        return
    end
    if guarding and a.unblockable do
        guarding = false
        say(o.body.top(), "GUARD BROKEN", ap.Color(255, 120, 90))
        sound_at(snd_block, at, 0.7, 0.5)
        burst(at, 10, ap.LIGHT_GRAY, 4, 0.3, 0.07)
    end
    var stun = a.stun
    var push = a.push
    if guarding do
        damage *= 0.2
        stun = 0
        push *= 0.5
    else do
        # A combo: each hit on someone who has not recovered does less and stuns shorter.
        # It lasts until they have gone a moment without being hit, so standing over someone
        # and hitting them the instant they recover is still the same combo.
        var helpless = o.state == STATE_HURT or o.since_hit < COMBO_GRACE
        o.taken = o.taken + 1 if helpless else 1
        if not helpless do
            o.pressure = 0
        end
        if f.serial != o.hit_serial or o.pressure == 0 do
            o.hit_serial = f.serial
            o.pressure += 1
        end
        o.since_hit = 0
        if o.taken > 2 do
            damage *= math.max(0.4, 1 - 0.1 * double(o.taken - 2))
        end
        stun = int(double(stun) * math.max(0.35, 1 - 0.07 * double(o.taken - 1)) * (1 + 0.35 * double(item_count(f, roster.ITEM_ANVIL))))
    end
    damage *= o.kit.armor * stacked(o, roster.ITEM_IRON, 0.75)
    if o.buff == roster.BUFF_GUARD do
        damage *= 0.45
    end
    # Whoever is behind on rounds hits a little harder and takes a little less.
    damage *= (1 + UNDERDOG_DAMAGE * double(behind(f))) * (1 - UNDERDOG_GUARD * double(behind(o)))
    damage *= mx(f).power * mx(f).foe_vulnerable * mx(o).armor
    o.health -= damage
    o.knock = unit(flat(o.body.position - origin)) * push
    f.connected = true
    f.energy = math.min(f.energy + damage * roster.SUPER_PER_DEALT * gain(f), roster.SUPER_MAX)
    o.energy = math.min(o.energy + damage * roster.SUPER_PER_TAKEN * gain(o), roster.SUPER_MAX)
    copy_move(o, f, a)
    say(o.body.top(), "{int(damage + 0.5)}", ap.GRAY if guarding else ap.Color(255, 235, 200))
    if guarding do
        sound_at(snd_block, at, 0.6)
        burst(at, 6, ap.LIGHT_GRAY, 2.5, 0.25, 0.06)
        if basic and melee do
            # A blocked basic attack goes no further: the chain stops and the blocker has the next move.
            f.blocked = true
            f.knock = unit(flat(f.body.position - o.body.position)) * 2.5
            f.state = STATE_HURT
            f.stun = BLOCKED_STUN
            f.stun_total = BLOCKED_STUN
            f.spam = math.min(f.spam + SPAM_PER_HIT * 0.5, 0.99)
            if o.cpu do
                o.cool = math.min(o.cool, 4)
                o.block_hold = math.min(o.block_hold, 10)
            end
        end
    else do
        var unmoved = (o.kit.poise and stun < 20) or o.buff == roster.BUFF_GUARD or
            (o.state == STATE_ATTACK and o.move.sturdy)
        if unmoved do
            stun = 0
        end
        if stun > 0 do
            if a.launch > 0 do
                # Off the ground: they cannot act until they land.
                o.body.velocity = ap.Vec3(o.body.velocity.x, a.launch, o.body.velocity.z)
                stun = math.max(stun, 40)
            else if not o.body.grounded and o.state == STATE_HURT do
                # Each hit in the air keeps them up a little longer.
                o.body.velocity = ap.Vec3(o.body.velocity.x, math.max(o.body.velocity.y, 3.6), o.body.velocity.z)
            end
            o.state = STATE_HURT
            o.stun = stun
            o.stun_total = stun
            o.hurt_side = o.taken % 2
        end
        if o.cloaked do
            set_cloak(o, false)
        end
        if a.poison > 0 and not o.kit.machine do
            o.poison = math.min(o.poison + a.poison, roster.POISON_LIMIT)
        end
        if a.slow > 0 and not o.kit.machine do
            o.slow = math.max(o.slow, a.slow)
        end
        var back = damage * (f.kit.lifesteal + 0.15 * double(item_count(f, roster.ITEM_FANG))) + a.heal
        var thorns = item_count(o, roster.ITEM_THORNS)
        if thorns > 0 and melee and f.state != STATE_DOWN do
            f.health = math.max(f.health - damage * 0.35 * double(thorns), 1.0)
        end
        if back > 0 and f.state != STATE_DOWN do
            f.health = math.min(f.health + back, f.max_health)
            for i in 0..<int(4 + back / 2) do
                spark(f.body.center() + ap.Vec3(ap.random(-0.4, 0.4), ap.random(-0.6, 0.4), ap.random(-0.4, 0.4)),
                    ap.Vec3(0, ap.random(0.8, 1.8), 0), ap.Color(255, 60, 90), ap.random(0.4, 0.8), 0.07, 0)
            end
            if a.heal > 0 do
                sound_at(snd_heal, f.body.position, 0.5)
                say(f.body.top(), "+{int(back + 0.5)}", ap.Color(255, 90, 110))
            end
        end
        f.bar = math.min(f.bar + a.gain, f.kit.bar_max)
        # PHANTOM drinks the super bar out of whatever she touches.
        var steal = a.steal + f.kit.super_steal
        if steal > 0 and not f.minion and not o.minion do
            var take = math.min(o.energy, steal)
            o.energy -= take
            f.energy = math.min(f.energy + (0.0 if in_super(f) else take), roster.SUPER_MAX)
            if a.steal > 0 and take > 0.5 do
                say(o.body.top() + ap.Vec3(0, 0.3, 0), "-{int(take + 0.5)} SUPER", look.accent)
                for i in 0..<10 do
                    var life = ap.random(0.25, 0.45)
                    var from = o.body.center() + scatter(0.3)
                    spark(from, (f.body.center() - from) * (1 / life), ap.Color(240, 60, 70), life, 0.07, 0)
                end
            end
        end
        if a.inject and not f.minion and f.kit.lab do
            count_dose(f, o)
        end
        # The count the attacker sees.
        if o.taken <= 1 do
            f.combo_damage = 0
        end
        f.combo = o.taken
        f.combo_damage += damage
        f.combo_show = 110
        var heavy = damage >= 10
        sound_at(weapon_hit_sound(f, heavy, melee), at, 0.7, 1.0 + 0.04 * double(math.min(o.taken - 1, 8)))
        burst(at, int(6 + damage), look.accent, 3 + damage * 0.25, 0.4, 0.08)
        if a.launch > 0 and stun > 0 do
            for i in 0..<8 do
                streak(o.body.position + forward_of(double(i) * 45) * 0.4, ap.Vec3(0, ap.random(5, 9), 0), look.accent, 0.25, 0.6)
            end
        end
        skill_lands(f, o, a, at, origin)
        ap.hitstop(int(math.clamp(2 + damage / 3, 3.0, 9.0)))
        if basic do
            # Too many basic attacks landed too quickly, and the opponent is let out.
            f.spam += SPAM_PER_HIT / double(a.volley)
        end
        if (o.pressure >= COMBO_LIMIT or f.spam >= 1) and o.health > 0 do
            var spammed = f.spam >= 1
            combo_break(o, f)
            if spammed do
                # Mashing has a price: the attacker is the one left open.
                f.spam = 0
                say(f.body.top(), "SPAM", ap.Color(255, 120, 90))
                f.state = STATE_HURT
                f.stun = SPAM_STUN
                f.stun_total = SPAM_STUN
                if o.cpu do
                    o.cool = 0
                end
            end
        end
    end
end

function explode(Shot s)
    var a = s.attack
    var owner = fighters[s.owner]
    var tint = owner.kit.look.accent
    rings.push(Ring(s.position, tint, a.blast / 0.3, 0.3, true))
    rings.push(Ring(ap.Vec3(s.position.x, 0.1, s.position.z), tint, a.blast / 0.4, 0.4))
    burst(s.position, 30, ap.Color(255, 200, 110), 7, 0.6, 0.12)
    burst(s.position, 14, ap.Color(90, 90, 100), 3, 1.0, 0.16)
    sound_at(snd_boom, s.position, 0.9)
    # Fire, flying rubble, a column of smoke, and a scorch that stays on the floor.
    sound_at(snd_thud, s.position, 0.9)
    later(snd_boom, s.position, 7, 0.4, 0.5)
    rings.push(Ring(s.position, ap.Color(255, 226, 170), a.blast * 2.2, 0.16, true))
    for i in 0..<16 do
        streak(s.position, unit(scatter(1)) * ap.random(6, 11), ap.Color(255, 170, 70), 0.18, 0.6, 0.07)
    end
    for i in 0..<10 do
        spark(s.position, unit(scatter(1) + ap.Vec3(0, 1, 0)) * ap.random(4, 8), ap.Color(50, 46, 60), 1.2, 0.13, 12)
    end
    smoke(s.position + ap.Vec3(0, 0.3, 0), 14, 0.5, 1.6)
    if s.position.y < 1.6 do
        stain(s.position, ap.Color(6, 5, 10), a.blast * 0.7, 7, 0.7)
    end
    var o = other(owner)
    var gap = (o.body.center() - s.position).length()
    if gap < a.blast + o.body.radius do
        apply_hit(owner, o, a, (1.0 if gap < 1.1 else 0.6) * s.scale, s.position, false, s.bonus)
    end
    for m in minions do
        if m.id == o.id and (m.body.center() - s.position).length() < a.blast + m.body.radius do
            apply_hit(owner, m, a, 0.8 * s.scale, s.position, false, s.bonus)
        end
    end
    Mirror[] caught = []
    for mi in mirrors do
        if mi.owner == o.id and flat_distance(mirror_at(mi), s.position) < a.blast + 0.4 do
            caught.push(mi)
        end
    end
    for mi in caught do
        shatter_mirror(mi)
    end
    if a.shot == roster.SHOT_ROCK do
        # Stone, not fire: it breaks apart.
        for i in 0..<10 do
            spark(s.position, unit(scatter(1) + ap.Vec3(0, 1, 0)) * ap.random(3, 7), ap.Color(130, 108, 86), 1.0, 0.18, 12)
        end
    end
end

function update_shots()
    var dt = 1.0 / 60
    Shot[] flying = []
    for s in shots do
        var a = s.attack
        var owner = fighters[s.owner]
        var o = other(owner)
        var tint = owner.kit.look.accent
        var kind = a.shot
        s.age += dt
        s.life -= dt
        if kind == roster.SHOT_MINE do
            # It sits and waits for a foot.
            var near = o.state != STATE_DOWN and s.age > 0.8 and o.body.position.y < 1.2 and
                flat_distance(s.position, o.body.position) < 1.3
            if near do
                sound_at(snd_lock, s.position, 0.6, 1.6)
                explode(s)
            else if s.life <= 0 do
                burst(s.position, 6, ap.Color(120, 120, 130), 2, 0.4, 0.08)
            else do
                flying.push(s)
            end
            continue
        end
        if a.lob do
            s.velocity = s.velocity - ap.Vec3(0, LOB_GRAVITY * dt, 0)
        end
        if kind == roster.SHOT_SPIKE do
            # It runs along the floor, whatever it was aimed at.
            s.position = ap.Vec3(s.position.x, 0.35, s.position.z)
            s.velocity = unit(flat(s.velocity)) * a.shot_speed
        end
        if a.homing > 0 and o.fade > 0.5 and o.state != STATE_DOWN do
            var speed = s.velocity.length()
            var way = unit(s.velocity)
            var want = unit(o.body.center() - s.position)
            var along = math.clamp(way.x * want.x + way.y * want.y + way.z * want.z, -1.0, 1.0)
            var off = math.acos(along) * 180 / math.PI
            if off > 0.5 do
                s.velocity = unit(way + (want - way) * math.min(a.homing * dt / off, 1.0)) * speed
            end
        end
        var size = 0.18
        if kind == roster.SHOT_WAVE do
            size = 0.6
        else if kind == roster.SHOT_BATS do
            size = 0.4
        else if kind == roster.SHOT_METEOR do
            size = 0.7
        else if kind == roster.SHOT_CAR do
            size = 0.9
        else if kind == roster.SHOT_FIST or kind == roster.SHOT_RING do
            size = 0.32
        else if kind == roster.SHOT_ROCK do
            size = 0.45
        else if kind == roster.SHOT_SPIKE do
            size = 0.55
        end
        var steps = int(s.velocity.length() * dt / 0.22) + 1
        var done = false
        for k in 0..<steps do
            s.position = s.position + s.velocity * (dt / double(steps))
            var gap = flat_distance(s.position, o.body.position)
            var touching = o.state != STATE_DOWN and gap < o.body.radius + size and
                s.position.y > o.body.position.y - 0.1 - size and s.position.y < o.body.position.y + o.body.height + 0.1 + size
            # A clone on their side, or a mirror copy, can be in the way.
            var clone = o
            for m in minions do
                if m.id == o.id and not touching and clone == o and m.state != STATE_DOWN and
                        flat_distance(s.position, m.body.position) < m.body.radius + size and
                        s.position.y > m.body.position.y - 0.1 - size and s.position.y < m.body.position.y + m.body.height + 0.1 + size do
                    clone = m
                end
            end
            var glass = mirror_touched(o.id, s.position, size)
            var copy_hit = glass.owner >= 0 and not touching and clone == o
            if touching or clone != o or copy_hit or world.overlaps(s.position, 0.1) do
                if copy_hit do
                    shatter_mirror(glass)
                end
                drop_dagger(s, o.body.position if touching else (clone.body.position if clone != o else s.position))
                if a.blast > 0 do
                    explode(s)
                else do
                    if touching do
                        apply_hit(owner, o, a, s.scale, s.position - unit(s.velocity) * 0.6, false, s.bonus)
                    else if clone != o do
                        apply_hit(owner, clone, a, s.scale, s.position - unit(s.velocity) * 0.6, false, s.bonus)
                    end
                    burst(s.position, 6, tint, 2.5, 0.3, 0.07)
                    if kind == roster.SHOT_VENOM do
                        # It splashes, and what is left pools on the floor.
                        sound_at(snd_splash, s.position, 0.6)
                        burst(s.position, 10, tint, 3.5, 0.5, 0.07)
                        if a.pool > 0 do
                            var floor = ap.Vec3(s.position.x, 0, s.position.z)
                            hazards.push(Hazard(s.owner, floor, 1.7, a.pool))
                            stain(floor, tint, 1.7, a.pool, 0.5, true)
                        else do
                            stain(s.position, tint, 0.9, 4.5, 0.45, true)
                        end
                    else if kind == roster.SHOT_BULLET and not touching do
                        sound_at(snd_ricochet, s.position, 0.35, ap.random(0.8, 1.3))
                        for j in 0..<4 do
                            streak(s.position, unit(scatter(1) - unit(s.velocity)) * 5, ap.Color(255, 230, 150), 0.12, 0.3)
                        end
                    else if kind == roster.SHOT_CAR do
                        sound_at(snd_boom, s.position, 0.7, 1.2)
                        sound_at(snd_heavy, s.position, 0.7, 0.7)
                        burst(s.position, 16, ap.Color(250, 220, 70), 6, 0.6, 0.12)
                        smoke(s.position, 8, 0.5, 0.9)
                    else if kind == roster.SHOT_FIST do
                        sound_at(snd_heavy, s.position, 0.6, 0.9)
                        rings.push(Ring(s.position, tint, 5, 0.18, true))
                    else if kind == roster.SHOT_BATS do
                        sound_at(snd_bite, s.position, 0.4, 1.4)
                        burst(s.position, 10, ap.Color(40, 20, 34), 3, 0.4, 0.09)
                    else if kind == roster.SHOT_WAVE do
                        sound_at(snd_slash, s.position, 0.5, 1.2)
                        for j in 0..<8 do
                            streak(s.position, unit(scatter(1)) * 6, tint if j % 2 == 0 else ap.WHITE, 0.16, 0.5)
                        end
                    end
                end
                done = true
                break
            end
        end
        if not done and s.life <= 0 do
            drop_dagger(s, s.position)
        end
        if done or s.life <= 0 do
            continue
        end
        # What each kind trails behind it.
        if kind == roster.SHOT_ROCKET do
            spark(s.position, ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 0.6), ap.random(-0.4, 0.4)),
                ap.Color(255, 170, 70) if ap.chance(0.5) else ap.Color(120, 120, 130), 0.45, 0.11, -0.6)
        else if kind == roster.SHOT_VENOM do
            if not a.lob do
                s.velocity = s.velocity - ap.Vec3(0, 3 * dt, 0)
            end
            if ap.chance(0.4) do
                spark(s.position, ap.Vec3(0, -0.5, 0), tint, 0.4, 0.06, 4)
            end
        else if kind == roster.SHOT_BOLT do
            spark(s.position, scatter(0.5), tint, 0.3, 0.06, 0)
        else if kind == roster.SHOT_BATS do
            spark(s.position + scatter(0.3), scatter(0.6), ap.Color(60, 24, 44) if ap.chance(0.7) else tint, 0.3, 0.07, 0)
        else if kind == roster.SHOT_WAVE do
            spark(s.position + scatter(0.4), scatter(0.4), tint, 0.25, 0.07, 0)
        else if kind == roster.SHOT_BOMB do
            spark(s.position + ap.Vec3(0, 0.15, 0), scatter(0.8) + ap.Vec3(0, 1, 0), ap.Color(255, 220, 120), 0.2, 0.05, 2)
        else if kind == roster.SHOT_CAR do
            spark(s.position - unit(s.velocity) * 0.9 + ap.Vec3(0, -0.5, 0), scatter(0.6) + ap.Vec3(0, 0.6, 0), ap.Color(120, 116, 130), 0.5, 0.13, -0.3)
        else if kind == roster.SHOT_FIST do
            spark(s.position - unit(s.velocity) * 0.3, scatter(0.5), ap.Color(255, 170, 70) if ap.chance(0.5) else tint, 0.25, 0.08, 0)
        else if kind == roster.SHOT_RING do
            if ap.chance(0.5) do
                spark(s.position + scatter(0.2), scatter(0.4), tint, 0.2, 0.05, 0)
            end
        else if kind == roster.SHOT_ROCK do
            if ap.chance(0.5) do
                spark(s.position + scatter(0.2), scatter(0.4) - ap.Vec3(0, 1, 0), ap.Color(120, 100, 80), 0.4, 0.08, 6)
            end
        else if kind == roster.SHOT_SPIKE do
            # The ridge tears the floor up as it goes.
            spark(ap.Vec3(s.position.x, 0.05, s.position.z) + scatter(0.3), ap.Vec3(0, ap.random(2, 4), 0), ap.Color(130, 108, 86), 0.5, 0.12, 9)
            if ap.chance(0.3) do
                stain(s.position, ap.Color(30, 22, 16), 0.5, 3, 0.5)
            end
        else if kind == roster.SHOT_FEATHER do
            if ap.chance(0.3) do
                spark(s.position, scatter(0.3), tint, 0.25, 0.04, 0)
            end
        else if kind == roster.SHOT_COIN do
            if ap.chance(0.3) do
                spark(s.position, scatter(0.3), ap.Color(255, 230, 120), 0.2, 0.04, 0)
            end
        else if kind == roster.SHOT_METEOR do
            for j in 0..<3 do
                spark(s.position + scatter(0.4), scatter(1) + ap.Vec3(0, 3, 0),
                    ap.Color(255, 170, 70) if j > 0 else ap.Color(90, 90, 100), 0.5, 0.14, -0.5)
            end
        end
        flying.push(s)
    end
    shots = flying
    # Pools on the floor work on whoever stands in them.
    Hazard[] lying = []
    for h in hazards do
        h.life -= dt
        var foe = other(fighters[h.owner])
        if foe.state != STATE_DOWN and not foe.kit.machine and foe.body.position.y < 0.5 and flat_distance(h.position, foe.body.position) < h.radius do
            foe.poison = math.max(foe.poison, 2.0)
            foe.slow = math.max(foe.slow, 0.5)
        end
        if h.life > 0 do
            lying.push(h)
        end
    end
    hazards = lying
    update_portals()
    Beam[] lit = []
    for b in beams do
        b.life -= dt
        if b.life > 0 do
            lit.push(b)
        end
    end
    beams = lit
end

# --- A fighter's tick ----------------------------------------------------------------------------

function knock_down(Fighter f)
    f.state = STATE_DOWN
    f.frame = 0
    f.health = 0
    f.poison = 0
    if f.cloaked do
        set_cloak(f, false)
    end
end

# How fast a fighter walks right now.
function pace_of(Fighter f) returns double
    var pace = f.kit.speed * mx(f).speed * (1 + 0.2 * double(item_count(f, roster.ITEM_BOOTS)))
    if f.slow > 0 do
        pace *= 0.55
    end
    if f.buff == roster.BUFF_HASTE do
        pace *= 1.35
    else if f.buff == roster.BUFF_MIST do
        pace *= 1.5
    end
    return pace
end

# A move that has finished striking can turn into the next: the chain, a skill, the super.
function cancel_into(Fighter f, Fighter o, Intent want)
    var kit = f.kit
    if f.slot == SLOT_BASIC and want.basic and f.chain < kit.basics.length - 1 and not f.blocked do
        used(f, "basic")
        start_move(f, o, SLOT_BASIC, f.chain + 1)
        return
    end
    if not f.connected do
        return
    end
    if want.ultimate and f.slot != SLOT_SUPER and can_super(f) do
        used(f, "super")
        start_move(f, o, SLOT_SUPER)
    else if want.skill > 0 and f.slot == SLOT_BASIC and move_ready(f, want.skill - 1) do
        used(f, "skill{want.skill}")
        start_move(f, o, want.skill - 1)
    end
end

# MONOPOLIST: out of capital, he is stuck until the bailout comes through.
function bankruptcy(Fighter f)
    var kit = f.kit
    if f.broke_ticks > 0 do
        f.broke_ticks -= 1
        f.state = STATE_HURT
        f.stun = math.max(f.stun, 2)
        f.stun_total = kit.bankrupt
        if ap.chance(0.25) do
            spark(f.body.top() + scatter(0.4), ap.Vec3(0, -1, 0), ap.Color(255, 206, 70), 0.6, 0.06, 4)
        end
        if f.broke_ticks == 0 do
            f.bar = kit.bar_max
            say(f.body.top(), "BAILOUT", kit.look.accent)
            sound_at(snd_casing, f.body.position, 0.6, 0.8)
            later(snd_casing, f.body.position, 4, 0.5, 1.1)
        end
    else if f.bar <= 0.001 and f.state != STATE_ATTACK and f.state != STATE_HURT and not mx(f).free_bar do
        f.broke_ticks = kit.bankrupt
        f.state = STATE_HURT
        f.stun = kit.bankrupt
        f.stun_total = kit.bankrupt
        f.knock = ap.Vec3(0, 0, 0)
        say(f.body.top() + ap.Vec3(0, 0.3, 0), "BANKRUPT", ap.Color(255, 90, 80))
        sound_at(snd_deny, f.body.position, 0.7, 0.6)
        sound_at(snd_thud, f.body.position, 0.6, 0.6)
        for i in 0..<16 do
            spark(f.body.center(), unit(scatter(1) + ap.Vec3(0, 1, 0)) * 4, ap.Color(255, 206, 70), 0.8, 0.07, 9)
        end
    end
end

function step_fighter(Fighter f, Fighter o, Intent want)
    var dt = 1.0 / 60
    var kit = f.kit
    var body = f.body
    var forward = forward_of(f.heading)
    f.wish = want.wish

    if f.state != STATE_DOWN and phase == PHASE_FIGHT do
        # The special bar, and the super bar that fills on its own.
        if f.cloaked do
            f.bar -= kit.bar_drain * dt
            if f.bar <= 0 do
                f.bar = 0
                set_cloak(f, false)
            end
        else do
            f.bar = math.min(f.bar + kit.bar_regen * dt * (2.5 if f.buff == roster.BUFF_HASTE else 1.0) *
                (1 + 0.75 * double(item_count(f, roster.ITEM_BATTERY))), kit.bar_max)
        end
        f.energy = math.min(f.energy + roster.SUPER_PER_SECOND * dt * gain(f), roster.SUPER_MAX)
        if kit.bankrupt > 0 do
            bankruptcy(f)
        end
        # Poison.
        if f.poison > 0 do
            f.poison -= dt
            f.health -= roster.POISON_DPS * dt
            if ap.chance(0.12) do
                spark(body.center() + ap.Vec3(ap.random(-0.3, 0.3), ap.random(-0.4, 0.6), ap.random(-0.3, 0.3)),
                    ap.Vec3(0, ap.random(0.5, 1.2), 0), ap.Color(130, 240, 60), 0.6, 0.07, 0)
            end
        end
        if f.buff != roster.BUFF_NONE do
            f.buff_time -= dt
            buff_trail(f)
            if f.buff_time <= 0 do
                f.buff = roster.BUFF_NONE
            end
        end
        f.slow = math.max(f.slow - dt, 0.0)
        for i in 0..<f.cooldowns.length do
            f.cooldowns[i] = math.max(f.cooldowns[i] - mx(f).cool_rate, 0)
        end
        for i in 0..<f.arm_cools.length do
            if i // 3 != f.arm do
                f.arm_cools[i] = math.max(f.arm_cools[i] - mx(f).cool_rate, 0)
            end
        end
        f.clone_cool = math.max(f.clone_cool - 1, 0)
        var moss = item_count(f, roster.ITEM_MOSS)
        if moss > 0 and f.since_hit > 120 and f.health < f.max_health do
            f.health = math.min(f.health + 5 * double(moss) * dt, f.max_health)
            if ap.chance(0.1) do
                spark(f.body.position + ap.Vec3(ap.random(-0.4, 0.4), 0.1, ap.random(-0.4, 0.4)), ap.Vec3(0, 0.8, 0),
                    ap.Color(120, 220, 110), 0.6, 0.06, 0)
            end
        end
    end
    f.combo_show = math.max(f.combo_show - 1, 0)
    var vanished = mx(f).vanish and max_cut == 0
    f.fade = ap.approach(f.fade, 0.0 if f.cloaked or vanished else 1.0, 0.2 if vanished else 0.07)
    if f.cloaked and not f.cpu and ap.chance(0.25) do
        # Wisps only the one wearing the shroud can see.
        spark(body.position + ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 1.6), ap.random(-0.4, 0.4)),
            ap.Vec3(0, ap.random(0.3, 0.8), 0), kit.look.accent, 0.5, 0.05, 0)
    end
    f.shown_health = ap.approach(f.shown_health, f.health, 0.35)
    f.dash_cooldown = math.max(f.dash_cooldown - 1, 0)
    f.warp_cool = math.max(f.warp_cool - 1, 0)
    f.safe = math.max(f.safe - 1, 0)
    f.spam = math.max(f.spam - 1.0 / (60 * SPAM_SECONDS), 0.0)
    f.since_hit = math.min(f.since_hit + 1, 999)
    if f.buff == roster.BUFF_PARRY and f.cpu and f.state == STATE_IDLE and o.state == STATE_ATTACK and
            flat_distance(f.body.position, o.body.position) < 4 do
        # Still water: the CPU holds its guard and lets them come.
        want.block = true
    end
    if f.since_hit == COMBO_GRACE do
        f.taken = 0
        f.pressure = 0
    end
    f.settle = ap.approach(f.settle, 1.0 if f.state == STATE_IDLE or f.state == STATE_ATTACK else 0.0, 0.1)

    # Turning: toward the opponent when they can be seen, else the way of travel.
    var can_see = o.fade > 0.5 and o.state != STATE_DOWN
    var look_at = target_of(f, o)
    if not f.cpu and mirror_count(o.id) > 0 do
        # Which one is real is up to the player: they face where they steer.
        can_see = false
    end
    var turn = 0.0
    if f.state == STATE_IDLE or f.state == STATE_BLOCK or f.state == STATE_RELOAD do
        turn = 14
    else if f.state == STATE_ATTACK and f.frame < f.move.startup and not f.move.evade do
        turn = 6
    else if f.state == STATE_ATTACK and f.move_hits > 1 do
        turn = 3
    end
    if turn > 0 do
        var facing = f.heading
        if can_see do
            facing = heading_of(look_at - body.position)
        else if want.wish.length() > 0.2 do
            facing = heading_of(want.wish)
        end
        var off = wrap(facing - f.heading)
        f.heading = wrap(f.heading + math.clamp(off, -turn, turn))
        forward = forward_of(f.heading)
    end

    var walk = ap.Vec3(0, 0, 0)
    var pace = pace_of(f)
    f.frame += 1
    if f.state == STATE_HURT do
        f.stun -= 1
        if f.stun <= 0 and (body.grounded or body.position.y < 0.05) do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_RELOAD and kit.reload_all do
        walk = want.wish * (pace * 0.5)
        # A speed loader: every round drops in together at the end, or none do if a hit interrupts.
        if f.frame >= roster.SPEEDLOAD_TICKS do
            f.bar = kit.bar_max
            sound_at(snd_reload, body.position, 0.6, 0.7)
            later(snd_lock, body.position, 4, 0.5, 1.3)
            say(body.top(), "LOADED", kit.look.accent)
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_RELOAD do
        walk = want.wish * (pace * 0.5)
        # One bullet at a time: whatever is in before a hit interrupts stays in.
        if f.frame % roster.RELOAD_TICKS == 0 do
            f.bar = math.min(double(pips(kit, f.bar)) + 1, kit.bar_max)
            sound_at(snd_reload, body.position, 0.4, 0.8 + f.bar * 0.08)
        end
        if f.bar >= kit.bar_max do
            sound_at(snd_reload, body.position, 0.5, 0.6)
            later(snd_reload, body.position, 5, 0.5, 1.4)
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_DASH do
        walk = f.dash_way * DASH_SPEED
        if f.frame >= DASH_TICKS do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_ATTACK do
        var a = f.move
        var last = a.startup + (f.move_hits - 1) * a.interval
        if a.evade do
            # Footwork: out of the way while the move winds up, and nothing can touch it.
            if f.frame <= a.startup do
                walk = f.dash_way * (a.lunge / double(a.startup) * 60)
                if f.frame % 3 == 0 do
                    leave_ghost(f, 0.22)
                end
            end
        else if a.lunge > 0 do
            # Stepping in with the blow, but never through the opponent.
            var begins = math.max(a.startup - 7, 0)
            if f.frame > begins and f.frame <= last do
                var room = flat_distance(body.position, o.body.position) - body.radius - o.body.radius
                if room > 0.35 or o.state == STATE_DOWN do
                    walk = forward * (a.lunge / double(last - begins) * 60)
                end
            end
        end
        if f.frame < a.startup do
            skill_gathers(f, a)
            if a.beam > 0 do
                gather(puppet.muzzle(kit.look, body.position, f.heading), 2, kit.look.accent, 0.8, 0.14, 0.05)
            end
        end
        if (a.fx == roster.FX_FLECHE or a.sturdy or a.lunge >= 4.5 or f.slot == SLOT_SUPER) and walk.length() > 0.1 and f.frame % 3 == 0 and not a.evade do
            leave_ghost(f, 0.25)
        end
        if a.teleport and f.frame == math.max(a.startup - 6, 1) and o.state != STATE_DOWN do
            flash_step(f, o)
        end
        if f.hits_done < f.move_hits and f.frame == a.startup + f.hits_done * a.interval do
            f.hits_done += 1
            strike(f, o)
        end
        if f.state == STATE_ATTACK and f.hits_done >= f.move_hits and f.frame >= last + 3 and phase == PHASE_FIGHT do
            cancel_into(f, o, want)
        end
        if f.state == STATE_ATTACK and f.move == a and f.frame >= attack_length(a, f.move_hits) do
            f.state = STATE_IDLE
            f.frame = 0
        end
    else if f.state == STATE_IDLE or f.state == STATE_BLOCK do
        if want.block do
            if f.state != STATE_BLOCK do
                f.state = STATE_BLOCK
                f.block_age = PARRY_TICKS + 1 if want.sloppy else 0
            else do
                f.block_age += 1
            end
        else do
            f.state = STATE_IDLE
        end
        if want.dash and f.dash_cooldown == 0 do
            used(f, "dash")
            f.state = STATE_DASH
            f.frame = 0
            f.dash_cooldown = int(double(DASH_COOLDOWN) * stacked(f, roster.ITEM_FEATHER, 0.25))
            f.dash_way = unit(want.wish) if want.wish.length() > 0.2 else forward * -1.0
            sound_at(snd_dash, body.position, 0.4)
            burst(body.position + ap.Vec3(0, 0.1, 0), 6, ap.Color(120, 115, 140), 2, 0.35, 0.09)
        else if want.ultimate do
            used(f, "super")
            start_move(f, o, SLOT_SUPER)
        else if want.skill > 0 do
            used(f, "skill{want.skill}")
            start_move(f, o, want.skill - 1)
        else if want.basic do
            used(f, "basic")
            start_move(f, o, SLOT_BASIC, 0)
        else do
            walk = want.wish * (pace * (0.35 if f.state == STATE_BLOCK else 1.0))
        end
    end

    # Moving: what the fighter means to do, plus what a hit pushed into them.
    body.velocity = ap.Vec3(walk.x + f.knock.x, body.velocity.y, walk.z + f.knock.z)
    body.update(world, 24)
    f.knock = f.knock * 0.86
    var speed = walk.length()
    f.moving = ap.approach(f.moving, 1.0 if speed > 0.5 and f.state != STATE_DASH and f.state != STATE_ATTACK else 0.0, 0.12)
    var before = f.cycle
    f.cycle += speed * dt * 2.3
    # Footsteps come from where the feet are, so an unseen fighter can still be heard.
    if int(f.cycle / math.PI) != int(before / math.PI) and f.state != STATE_ATTACK do
        sound_at(snd_step, body.position, 0.22 if f.cloaked else 0.12)
        if f.cloaked and f.cpu and not vanished do
            burst(body.position + ap.Vec3(0, 0.05, 0), 2, ap.Color(110, 105, 130), 0.8, 0.5, 0.07)
        end
    end
    # The body eases toward what it is doing, so nothing snaps from one pose to the next.
    var quick = f.state == STATE_ATTACK or f.state == STATE_HURT or f.state == STATE_DASH
    f.pose = puppet.blend(f.pose, target_pose(f), 0.6 if quick else 0.3)
end

# The button press behind an action has been spent.
function used(Fighter f, string button)
    if not f.cpu do
        pad.consume(button)
    end
end

# Void's step: gone from here, behind the opponent an instant later.
function flash_step(Fighter f, Fighter o)
    var body = f.body
    var from = body.center()
    var behind = o.body.position - forward_of(o.heading) * 1.5
    var spot = ap.Vec3(behind.x, 0, behind.z)
    if flat(spot).length() > ARENA - 0.6 or world.overlaps(spot + ap.Vec3(0, 1, 0), 0.5) do
        spot = o.body.position + unit(flat(body.position - o.body.position)) * 1.5
        if world.overlaps(spot + ap.Vec3(0, 1, 0), 0.5) do
            return
        end
    end
    sound_at(snd_flash, from, 0.6)
    # What is left behind: an afterimage, and the dark closing over it.
    leave_ghost(f, 0.45)
    gather(from, 14, ap.Color(70, 34, 130), 1.2, 0.2, 0.1)
    rings.push(Ring(from, ap.Color(70, 34, 130), 5, 0.22, true))
    rings.push(Ring(spot + ap.Vec3(0, 0.08, 0), f.kit.look.accent, 6, 0.25))
    for i in 0..<10 do
        streak(spot + forward_of(double(i) * 36) * 0.5, ap.Vec3(0, ap.random(4, 7), 0), f.kit.look.accent, 0.2, 0.5)
    end
    later(snd_rift, spot, 2, 0.4, 1.8)
    for i in 0..<16 do
        var along = from.lerp(spot + ap.Vec3(0, 0.9, 0), double(i) / 15)
        spark(along + ap.Vec3(ap.random(-0.2, 0.2), ap.random(-0.5, 0.5), ap.random(-0.2, 0.2)),
            ap.Vec3(0, ap.random(0, 0.6), 0), f.kit.look.accent, ap.random(0.25, 0.5), 0.1, 0)
    end
    body.position = spot
    f.heading = heading_of(o.body.position - spot)
    f.knock = ap.Vec3(0, 0, 0)
end

# --- The player and the CPU ----------------------------------------------------------------------

function player_intent() returns Intent
    var want = Intent()
    var a = cam_yaw * math.PI / 180
    var ahead = ap.Vec3(-math.sin(a), 0, -math.cos(a))
    var right = ap.Vec3(math.cos(a), 0, -math.sin(a))
    var input = ap.steer()
    want.wish = right * input.x - ahead * input.y
    want.basic = pad.buffered("basic", 10)
    for i in 1..<5 do
        if want.skill == 0 and pad.buffered("skill{i}", 10) do
            want.skill = i
        end
    end
    want.ultimate = pad.buffered("super", 10)
    want.dash = pad.buffered("dash", 6)
    want.block = pad.held("block")
    return want
end

# Whether a move makes sense for the CPU right now.
function cpu_fits(Fighter f, Fighter o, roster.Attack a, double gap, bool clear, bool facing, bool seen) returns bool
    var kit = f.kit
    var far = kit.ai_range > 3
    if a.kind == roster.KIND_CLOAK do
        return not f.cloaked and f.bar > kit.bar_max * 0.8 and gap > 3
    else if a.kind == roster.KIND_RELOAD do
        var left = pips(kit, f.bar)
        return left == 0 or (left <= 1 and gap > 5)
    else if a.kind == roster.KIND_FAN do
        return pips(kit, f.bar) >= 4 and clear and facing and gap < 9
    else if a.kind == roster.KIND_BUFF do
        if f.buff != roster.BUFF_NONE or not seen do
            return false
        end
        if a.buff == roster.BUFF_MIST do
            return gap < 3 and (f.health < f.max_health * 0.5 or o.state == STATE_ATTACK)
        else if a.buff == roster.BUFF_REGEN do
            return f.health < f.max_health * 0.7 and gap > 3
        else if a.buff == roster.BUFF_PARRY do
            return gap < 4
        end
        return gap < 6
    else if a.kind == roster.KIND_PORTAL do
        return seen and gap > 2 and gap < 8 and ap.chance(0.3)
    else if a.kind == roster.KIND_BLINK do
        return seen and ((far and gap < 2.5) or (not far and gap > 6))
    else if a.kind == roster.KIND_LOCK do
        # Keep a strong move; let a weak one go.
        var copied = kit.skills[0]
        var good = copied.damage * double(copied.hits) >= 12
        return good != f.copy_locked and ap.chance(0.2)
    else if a.kind == roster.KIND_SWAP do
        var range_now = kit.ai_range
        return ap.chance(0.04) or (gap > 6 and range_now < 3 and f.bar >= 2) or (gap < 2 and range_now > 3) or
            (range_now > 3 and f.bar < 1)
    else if a.kind == roster.KIND_RECALL do
        var out = 0
        for p in pickups do
            if p.owner == f.id do
                out += 1
            end
        end
        return out >= 3 or (out >= 1 and f.bar < 1)
    else if a.kind == roster.KIND_MIRROR do
        return seen and mirror_count(f.id) < 2 and gap < 9
    else if a.kind == roster.KIND_GLASS do
        return mirror_count(f.id) > 0 and o.state == STATE_ATTACK and gap < 3.5
    else if a.kind == roster.KIND_SHATTER do
        for mi in mirrors do
            if mi.owner == f.id and flat_distance(mirror_at(mi), o.body.position) < MIRROR_REACH do
                return true
            end
        end
        return false
    else if a.kind == roster.KIND_WALL do
        return seen and gap > 2.5 and gap < 5 and (o.kit.ai_range > 3 or ap.chance(0.3))
    else if a.kind == roster.KIND_SWITCH do
        return seen and gap > 3 and gap < 12 and ap.chance(0.3)
    end
    if not seen do
        return false
    end
    if a.evade and a.damage <= 0 do
        return gap < 2.6 and (far or o.state == STATE_ATTACK)
    else if a.evade do
        return facing and gap > 2 and gap < 6
    else if a.on_trigger do
        # Spin when something is coming, or idly when a round is missing and there is room.
        var coming = o.state == STATE_ATTACK and o.frame < o.move.startup and o.move.kind == roster.KIND_STRIKE
        return (coming and gap < 9) or (f.bar < kit.bar_max and gap > 6 and ap.chance(0.25))
    else if a.counter do
        return o.state == STATE_ATTACK and o.move.shot == roster.SHOT_NONE and gap < 3
    else if a.beam > 0 do
        return clear and facing and gap < a.beam
    else if a.summon > 0 do
        return gap > 3
    else if a.skyfall do
        return gap > 2
    else if a.shot == roster.SHOT_MINE do
        return gap > 3
    else if a.lob do
        return gap > 3 and gap < 12
    else if a.shot != roster.SHOT_NONE do
        return clear and facing and gap > 2.5 and gap < 14
    else if a.teleport do
        return gap < 12
    else if a.radial do
        return gap < a.reach
    end
    return facing and gap < a.reach + a.lunge * 0.8
end

# What the CPU would do now: a slot, SLOT_BASIC, SLOT_SUPER, or -2 for nothing. In a combo
# only quick melee follow-ups count.
function cpu_pick(Fighter f, Fighter o, double gap, bool clear, bool facing, bool seen, bool combo) returns int
    var kit = f.kit
    if not encore_ready(f) and can_super(f) and not combo and seen do
        # Answering someone else's super (a merge, or a switch-off) is urgent.
        if ap.chance(LEVEL_SKILL[level] * (1.0 if max_owner >= 0 else 0.5)) do
            return SLOT_SUPER
        end
    end
    if encore_ready(f) and (combo or ap.chance(LEVEL_SKILL[level])) and
            cpu_fits(f, o, kit.ultimate, gap, clear, facing, seen) do
        return SLOT_SUPER
    end
    var first = int(ap.random(0, 3.999))
    for n in 0..<kit.skills.length do
        var i = (first + n) % kit.skills.length
        var a = kit.skills[i]
        if f.cooldowns[i] > 0 or not can_pay(f, a.cost) do
            continue
        end
        if f.minion and (a.kind != roster.KIND_STRIKE or a.inject) do
            # A clone only knows how to hit.
            continue
        end
        if kit.bankrupt > 0 and not mx(f).free_bar and f.bar < a.cost + 10 and ap.chance(0.7) do
            # Saving what little capital is left.
            continue
        end
        if combo and (a.kind != roster.KIND_STRIKE or a.shot != roster.SHOT_NONE or a.startup > 14 or a.evade or a.counter) do
            continue
        end
        if cpu_fits(f, o, a, gap, clear, facing, seen) and ap.chance(LEVEL_SKILL[level]) do
            return i
        end
    end
    if combo do
        return -2
    end
    var basic = kit.basics[0]
    if not can_pay(f, basic.cost) and kit.fallback.name != "" do
        basic = kit.fallback
    end
    if facing and can_pay(f, basic.cost) do
        if basic.shot != roster.SHOT_NONE do
            if clear and gap < 14 do
                return SLOT_BASIC
            end
        else if gap < basic.reach + basic.lunge * 0.6 and (seen or ap.chance(0.3)) do
            return SLOT_BASIC
        end
    end
    return -2
end

function cpu_intent(Fighter f, Fighter o) returns Intent
    var want = Intent()
    if cpu_mode == CPU_STANDS or o.state == STATE_DOWN do
        return want
    end
    if cpu_mode == CPU_BLOCKS do
        want.block = true
        return want
    end
    var kit = f.kit
    var here = f.body.position
    var seen = o.fade > 0.5
    if seen do
        f.last_seen = target_of(f, o)
    end
    var to = flat(f.last_seen - here)
    var gap = to.length()
    var toward = unit(to)
    var across = ap.Vec3(toward.z, 0, -toward.x) * f.strafe
    var range = kit.ai_range
    if f.cloaked do
        range = 1.6
    end
    if kit.fallback.name != "" and not can_pay(f, kit.basics[0].cost) do
        # Out of ammunition: go in and use the gun as a club.
        range = 1.5
    end

    # Where to stand, reconsidered a few times a second.
    f.think -= 1
    if f.think <= 0 do
        f.think = 10 + int(ap.random(0, 16))
        if ap.chance(0.2) do
            f.strafe = -f.strafe
        end
        # Mirror copies: it goes after one of them, perhaps the wrong one.
        var copies = mirror_count(o.id)
        if copies == 0 do
            f.decoy = -1
        else if ap.chance(0.25) or f.decoy >= copies do
            f.decoy = pick_index(copies + 1) - 1
        end
        if not seen and gap < 1.2 do
            # Lost them: search.
            var guess = ap.random(0, 360)
            f.last_seen = forward_of(guess) * ap.random(0, ARENA - 2)
            f.plan = ap.Vec3(0, 0, 0)
        else if gap > range + 0.5 do
            f.plan = unit(toward + across * 0.35)
        else if gap < range - 1.3 and range > 3 do
            f.plan = unit(across * 0.7 - toward)
        else if ap.chance(0.6) do
            f.plan = across * 0.75
        else do
            f.plan = ap.Vec3(0, 0, 0)
        end
        # Stay off the edge.
        if flat(here + f.plan * 1.2).length() > ARENA - 0.8 do
            f.plan = unit(f.plan - unit(flat(here)) * 1.2)
        end
    end
    want.wish = f.plan

    # Seeing a blow coming: sometimes block, with a human's delay.
    if o.serial != f.seen_serial and o.state == STATE_ATTACK and seen do
        f.seen_serial = o.serial
        var threat = o.move.shot != roster.SHOT_NONE or gap < o.move.reach + o.move.lunge + 1
        var until = o.move.startup - o.frame
        # It takes a moment to react, so quick blows get through.
        var react = LEVEL_REACT[level] + int(ap.random(0, 9))
        var odds = LEVEL_BLOCK[level]
        if o.slot == SLOT_BASIC and o.spam > 0.2 do
            # They keep doing the same thing: it starts to see it coming.
            odds += LEVEL_READ[level]
            react = math.max(react - LEVEL_READ_SPEED[level] - int(o.spam * 6), 1)
        end
        if threat and react < until and ap.chance(odds) do
            f.block_wait = react
            f.block_hold = until + 16
            f.block_parry = ap.chance(LEVEL_PARRY[level])
            if f.block_parry do
                f.block_wait = math.max(until - 2 - int(ap.random(0, 5)), react)
            end
        end
    end
    if f.block_hold > 0 do
        f.block_hold -= 1
        if f.block_wait > 0 do
            f.block_wait -= 1
        else do
            want.block = true
            want.sloppy = not f.block_parry
            want.wish = ap.Vec3(0, 0, 0)
            return want
        end
    end

    var clear = seen and world.sees(f.body.center(), o.body.center())
    var facing = ap.in_cone(here, forward_of(f.heading), f.last_seen, 50)
    # Mid-string and it landed: carry the combo on.
    if f.state == STATE_ATTACK do
        if f.connected and f.cpu_combo and seen do
            if f.slot == SLOT_BASIC and f.chain < kit.basics.length - 1 do
                want.basic = true
            else if f.slot == SLOT_BASIC or f.slot != SLOT_SUPER do
                var next = cpu_pick(f, o, gap, clear, facing, seen, true)
                if next == SLOT_SUPER do
                    want.ultimate = true
                else if next >= 0 and f.slot == SLOT_BASIC do
                    want.skill = next + 1
                end
            end
        end
        return want
    end
    f.cool -= 1
    if level > 0 and o.spam > 0.3 and gap < 3.5 do
        # Being mashed on wakes it up.
        f.cool -= 2
    end
    if f.cool > 0 or (f.state != STATE_IDLE and f.state != STATE_BLOCK) do
        return want
    end
    var pick = cpu_pick(f, o, gap, clear, facing, seen, false)
    if pick != -2 do
        if pick == SLOT_SUPER do
            want.ultimate = true
        else if pick == SLOT_BASIC do
            want.basic = true
        else do
            want.skill = pick + 1
            var a = kit.skills[pick]
            if a.kind == roster.KIND_BLINK or a.evade do
                # Footwork goes somewhere: in for a brawler, out and around for the rest.
                if a.damage > 0 or (range <= 3 and gap > 4) do
                    want.wish = toward
                else do
                    want.wish = unit(across * 0.6 - toward)
                end
            end
        end
        f.cool = LEVEL_WAIT[level] + int(ap.random(0, double(LEVEL_WAIT_MORE[level])))
        f.cpu_combo = ap.chance(LEVEL_COMBO[level])
        return want
    end
    # Closing in, or getting away, in a hurry.
    if f.dash_cooldown == 0 and seen and ap.chance(0.02) do
        if gap > range + 4 do
            want.wish = toward
            want.dash = true
        else if range > 3 and gap < 2.2 do
            want.wish = unit(across - toward)
            want.dash = true
        end
    end
    return want
end

# --- The fight screen ----------------------------------------------------------------------------

function end_round(string words)
    phase = PHASE_OVER
    phase_ticks = 0
    banner = words
    sound_at(snd_ko, cam_focus, 0.6)
end

# BOB's clones fight on their own, and dissolve when beaten.
function update_minions(bool fighting)
    Fighter[] alive = []
    for m in minions do
        var enemy = other(m)
        var want = cpu_intent(m, enemy) if fighting else Intent()
        step_fighter(m, enemy, want)
        m.body.push_apart(world, enemy.body)
        m.body.push_apart(world, fighters[m.id].body)
        if ap.chance(0.35) do
            spark(m.body.position + ap.Vec3(ap.random(-0.4, 0.4), ap.random(0, 1.8), ap.random(-0.4, 0.4)),
                ap.Vec3(0, ap.random(0.6, 1.4), 0), ap.Color(120, 255, 120), 0.5, 0.06, 0)
        end
        if m.health <= 0 or fighters[m.id].state == STATE_DOWN do
            minion_dies(m)
        else do
            alive.push(m)
        end
    end
    minions = alive
end

# DISMANTLE: the first time in a round he is put down, he gets back up.
function rise_again(Fighter f) returns bool
    if f.kit.revive <= 0 or f.revived do
        return false
    end
    f.revived = true
    f.health = f.max_health * f.kit.revive
    f.shown_health = f.health
    f.poison = 0
    f.state = STATE_HURT
    f.stun = 70
    f.stun_total = 70
    f.safe = 80
    f.knock = ap.Vec3(0, 0, 0)
    var at = f.body.center()
    say(f.body.top() + ap.Vec3(0, 0.4, 0), "RISES AGAIN", f.kit.look.accent)
    sound_at(snd_growl, at, 0.8, 0.6)
    later(snd_thud, at, 6, 0.7, 0.5)
    rings.push(Ring(f.body.position + ap.Vec3(0, 0.1, 0), f.kit.look.accent, 7, 0.5))
    for i in 0..<24 do
        spark(f.body.position + forward_of(double(i) * 15) * 0.5, ap.Vec3(0, ap.random(1, 3), 0), f.kit.look.accent, 0.8, 0.08, -0.5)
    end
    smoke(f.body.position + ap.Vec3(0, 0.2, 0), 12, 0.5, 1.2)
    return true
end

function update_fight()
    if ap.key_pressed(ap.KEY_ESCAPE) or ap.pad_pressed(ap.PAD_START) do
        paused = not paused
        pause_cursor = 0
        snd_move.play(0.5)
        return
    end
    if paused do
        update_pause()
        return
    end
    if ap.key_pressed(ap.KEY_F3) do
        cpu_mode = (cpu_mode + 1) % 3
    end
    if ap.key_pressed(ap.KEY_F5) do
        level = (level + 1) % LEVEL_NAMES.length
    end
    if ap.key_pressed(ap.KEY_F4) do
        refill()
    end
    var player = fighters[0]
    var foe = fighters[1]
    update_camera()
    if ap.frozen() do
        return    # hitstop: the blow hangs for a moment, and input keeps buffering
    end
    if max_cut > 0 do
        update_cutscene()
        return
    end
    if phase == PHASE_DRAFT do
        step_fighter(player, foe, Intent())
        step_fighter(foe, player, Intent())
        update_draft()
        update_effects()
        return
    end
    phase_ticks += 1
    super_ticks = math.max(super_ticks - 1, 0)
    if phase == PHASE_FIGHT do
        update_area()
    end
    var idle = Intent()
    var fighting = phase == PHASE_FIGHT
    var mine = player_intent() if fighting else idle
    var theirs = cpu_intent(foe, player) if fighting else idle
    step_fighter(player, foe, mine)
    step_fighter(foe, player, theirs)
    player.body.push_apart(world, foe.body)
    update_minions(fighting)
    update_shots()
    update_pickups()
    update_props()
    update_mirrors()
    update_effects()
    if fighting do
        update_maximum()
    end

    if phase == PHASE_INTRO do
        if phase_ticks == 70 do
            banner = "FIGHT"
            snd_bell.play(0.5)
        end
        if phase_ticks >= 70 do
            phase = PHASE_FIGHT
            phase_ticks = 0
        end
    else if phase == PHASE_FIGHT do
        if phase_ticks > 45 and banner == "FIGHT" do
            banner = ""
        end
        clock -= 1
        var down_player = player.health <= 0 and not rise_again(player)
        var down_foe = foe.health <= 0 and not rise_again(foe)
        if down_player or down_foe do
            if down_player do
                knock_down(player)
            end
            if down_foe do
                knock_down(foe)
            end
            if down_player and down_foe do
                end_round("DOUBLE K.O.")
            else do
                fighters[0 if down_foe else 1].wins += 1
                end_round("K.O.")
            end
        else if clock <= 0 do
            var share_player = player.health / player.max_health
            var share_foe = foe.health / foe.max_health
            if share_player != share_foe do
                fighters[0 if share_player > share_foe else 1].wins += 1
            end
            end_round("TIME")
        end
    else if phase_ticks > 190 do
        if player.wins >= wins_needed() or foe.wins >= wins_needed() do
            winner = 0 if player.wins > foe.wins else 1
            go(SCREEN_RESULT)
        else do
            round += 1
            next_fighters()
            start_round()
        end
    end
end

function update_pause()
    if up_pressed() do
        pause_cursor = (pause_cursor + 3) % 4
        snd_move.play(0.5)
    end
    if down_pressed() do
        pause_cursor = (pause_cursor + 1) % 4
        snd_move.play(0.5)
    end
    if confirm_pressed() do
        snd_pick.play(0.5)
        paused = false
        pad.clear()
        if pause_cursor == 1 do
            start_match()
        else if pause_cursor == 2 do
            open_select()
        else if pause_cursor == 3 do
            ap.quit()
        end
    end
end

# The camera stands behind the player, looking past them at the opponent.
function update_camera()
    if max_cut > 0 do
        cutscene_camera()
        return
    end
    var player = fighters[0]
    var foe = fighters[1]
    if foe.fade > 0.4 do
        # With mirror copies about, the camera does not give away which one is real.
        var middle = foe.body.position
        var count = 1.0
        for mi in mirrors do
            if mi.owner == foe.id do
                middle = middle + mirror_at(mi)
                count += 1
            end
        end
        cam_foe = cam_foe.lerp(middle * (1 / count), 0.2)
    end
    var between = flat(player.body.position - cam_foe)
    if between.length() > 0.6 do
        cam_yaw = wrap(cam_yaw + wrap(heading_of(between) - cam_yaw) * 0.07)
    end
    var focus = player.body.position * 0.62 + cam_foe * 0.38 + ap.Vec3(0, 1.15, 0)
    cam_focus = cam_focus.lerp(focus, 0.14)
    cam_distance = ap.lerp(cam_distance, math.clamp(3.3 + between.length() * 0.58, 4.3, 12.0), 0.08)
    var wanted = ap.orbit(cam_focus, cam_yaw + 24, 17, cam_distance)
    # Not through a pillar.
    var reach = world.sweep(cam_focus, wanted.position, 0.3)
    if reach < 1 do
        wanted = ap.Camera3D(cam_focus + (wanted.position - cam_focus) * math.max(reach, 0.15), cam_focus)
    end
    camera = wanted
end

# --- Title, select, result -----------------------------------------------------------------------

function open_select()
    end_maximum()
    minions = []
    mirrors = []
    props = []
    pickups = []
    cursor = picks[0]
    picking = 0
    pick_step = 0
    go(SCREEN_SELECT)
end

# Fighters each side picks on the select screen: one, or a team in SHOWDOWN.
function side_size() returns int
    return TEAM_SIZE if mode == MODE_SHOWDOWN else 1
end

# Whether `who` is already on side `side`'s team among the picks made so far.
function on_team(int side, int who) returns bool
    if mode != MODE_SHOWDOWN do
        return false
    end
    var made = pick_step - side * TEAM_SIZE if picking == side else TEAM_SIZE
    for i in 0..<math.max(math.min(made, TEAM_SIZE), 0) do
        if teams[side][i] == who do
            return true
        end
    end
    return false
end

function grid_columns() returns int
    var cards = cast.length + 1
    if cards <= 10 do
        return 5
    end
    if cards <= 27 do
        return 9
    end
    return 10
end

function update_title()
    if select_world >= 0 do
        select_world = -1
        apply_area()
    end
    camera = ap.orbit(ap.Vec3(0, 1.4, 0), double(ticks) * 0.08, 12, 15)
    update_effects()
    if confirm_pressed() do
        snd_pick.play(0.5)
        open_select()
    end
    if ap.key_pressed(ap.KEY_ESCAPE) do
        ap.quit()
    end
end

function update_select()
    if ap.key_pressed(ap.KEY_TAB) or ap.pad_pressed(ap.PAD_BACK) do
        level = (level + 1) % LEVEL_NAMES.length
        snd_move.play(0.5)
    end
    if ap.key_pressed(ap.KEY_I) or ap.pad_pressed(ap.PAD_WEST) do
        items_mode = (items_mode + 1) % ITEM_MODE_NAMES.length
        snd_move.play(0.5)
    end
    if ap.key_pressed(ap.KEY_M) or ap.pad_pressed(ap.PAD_NORTH) do
        mode = (mode + 1) % MODE_NAMES.length
        snd_move.play(0.5)
        # Picks made for the old mode do not carry over.
        if pick_step > 0 do
            pick_step = 0
            picking = 0
            cursor = picks[0]
        end
    end
    var cards = cast.length + 1          # the last card picks at random
    var columns = grid_columns()
    var before = cursor
    if left_pressed() do
        cursor = (cursor + cards - 1) % cards
    end
    if right_pressed() do
        cursor = (cursor + 1) % cards
    end
    if up_pressed() and cursor - columns >= 0 do
        cursor -= columns
    end
    if down_pressed() do
        cursor = math.min(cursor + columns, cards - 1)
    end
    if cursor != before do
        snd_move.play(0.5)
        screen_ticks = 0
    end
    camera = ap.Camera3D(ap.Vec3(1.3, 1.5, 3.7), ap.Vec3(1.3, 1.0, 0))
    cam_focus = ap.Vec3(1.3, 1.0, 0)
    show_select_world()
    if select_world >= 0 do
        scene_life(cast[select_world].maximum.scene)
    end
    update_effects()
    if confirm_pressed() do
        var size = side_size()
        var choice = cursor
        if choice >= cast.length do
            choice = int(ap.random(0, double(cast.length) - 0.001))
            while on_team(picking, choice) do
                choice = int(ap.random(0, double(cast.length) - 0.001))
            end
        end
        if on_team(picking, choice) do
            snd_deny.play(0.5)
            return
        end
        snd_pick.play(0.5)
        var slot = pick_step % size
        if mode == MODE_SHOWDOWN do
            teams[picking][slot] = choice
        end
        if slot == 0 do
            picks[picking] = choice
        end
        pick_step += 1
        if pick_step >= size * 2 do
            start_match()
        else do
            if pick_step // size != picking do
                cursor = cast.length
            end
            picking = pick_step // size
            screen_ticks = 0
        end
    else if back_pressed() do
        snd_move.play(0.5)
        if pick_step > 0 do
            pick_step -= 1
            picking = pick_step // side_size()
            cursor = teams[picking][pick_step % side_size()] if mode == MODE_SHOWDOWN else picks[picking]
        else do
            go(SCREEN_TITLE)
        end
    end
end

function update_result()
    var champion = fighters[winner]
    cam_focus = cam_focus.lerp(champion.body.position + ap.Vec3(0, 1.1, 0), 0.06)
    cam_distance = ap.lerp(cam_distance, 4.6, 0.05)
    camera = ap.orbit(cam_focus, champion.heading + 20 * math.sin(double(screen_ticks) * 0.01), 10, cam_distance)
    var idle = Intent()
    step_fighter(fighters[0], fighters[1], idle)
    step_fighter(fighters[1], fighters[0], idle)
    update_effects()
    if screen_ticks > 40 do
        if confirm_pressed() do
            snd_pick.play(0.5)
            start_match()
        else if back_pressed() do
            snd_move.play(0.5)
            open_select()
        end
    end
end

function update()
    ticks += 1
    screen_ticks += 1
    pad.update()
    if ap.key_pressed(ap.KEY_F2) do
        pixel = 1 if pixel >= 4 else pixel * 2
        scene = ap.Canvas(VIEW_W // pixel, VIEW_H // pixel)
    end
    if screen == SCREEN_TITLE do
        update_title()
    else if screen == SCREEN_SELECT do
        update_select()
    else if screen == SCREEN_FIGHT do
        update_fight()
    else do
        update_result()
    end
end

# --- Drawing the 3D scene ------------------------------------------------------------------------

# What a fighter's body is trying to do this tick. What is drawn eases toward it (see step_fighter).
function target_pose(Fighter f) returns puppet.Pose
    var look = f.kit.look
    var time = double(ticks) / 60 + double(f.id) * 1.7
    if max_cut > 0 and not f.minion and (f.id == cut_user or cut_kind == CUT_MERGE) do
        # The maximum's own motion: a long wind-up, the moment it goes off, and a held finish.
        var t = double(cut_len - max_cut)
        var hit = double(math.max(cut_hit, 1))
        var at = t / hit if t < hit else 1 + math.min((t - hit) / 14, 1.0) + math.min(math.max(t - hit - 14, 0.0) / 80, 0.5)
        return puppet.make_pose(look, puppet.ACT_ATTACK, cut_anim if f.id == cut_user else cut_anim2, at, 1, f.cycle, 0, time, f.settle)
    end
    var action = puppet.ACT_IDLE
    var anim = 0
    var phase_at = 0.0
    var beat = 0
    if f.state == STATE_ATTACK do
        action = puppet.ACT_ATTACK
        anim = f.move.anim
        phase_at = attack_phase(f.move, f.move_hits, f.frame)
        beat = attack_beat(f.move, f.move_hits, f.frame)
        if f.move.anim == roster.ANIM_TWIRL do
            beat = 1 if f.empowered else 0
        end
        if f.move.anim == roster.ANIM_ROLL do
            var along = f.dash_way.x * math.sin(f.heading * math.PI / 180) + f.dash_way.z * math.cos(f.heading * math.PI / 180)
            beat = 1 if along < 0 else 0
        end
    else if f.state == STATE_BLOCK do
        action = puppet.ACT_BLOCK
    else if f.state == STATE_HURT do
        action = puppet.ACT_HURT if f.body.grounded or f.body.position.y < 0.2 else puppet.ACT_AIR
        beat = f.hurt_side
        phase_at = 1 - double(f.stun) / double(math.max(f.stun_total, 1))
    else if f.state == STATE_DOWN do
        action = puppet.ACT_DOWN
        phase_at = double(f.frame) / 26
    else if f.state == STATE_DASH do
        action = puppet.ACT_DASH
    else if f.state == STATE_RELOAD do
        action = puppet.ACT_RELOAD
    else if (phase == PHASE_OVER or screen == SCREEN_RESULT) and other(f).state == STATE_DOWN do
        action = puppet.ACT_WIN
        phase_at = math.min(double(phase_ticks if screen == SCREEN_FIGHT else 200) / 30, 1.0)
    end
    return puppet.make_pose(look, action, anim, phase_at, beat, f.cycle, f.moving, time, f.settle)
end

function fighter_pose(Fighter f) returns puppet.Pose
    return f.pose
end

# How solid a fighter looks: the player can always just make out their own shroud.
function fighter_alpha(Fighter f) returns double
    var solid = 0.4 if f.buff == roster.BUFF_MIST else 1.0
    if f.cpu do
        return f.fade * solid
    end
    return (0.22 + 0.78 * f.fade) * solid
end

function draw_arena()
    var casting = ap.casting_shadows()
    var gone = max_owner >= 0
    if not casting do
        ap.draw_material(floor_mesh, floor_look, ap.Vec3(0, 0, 0))
        ap.draw_material(disc_side, stone, ap.Vec3(0, -0.72, 0))
        if not gone do
            if crumble <= 0 or int(double(ticks) * 0.5) % 3 != 0 do
                ap.draw_many(box, rim_lamps, rim_look)
            end
            # The far slabs topple into the dark as the place comes apart.
            ap.push_3d()
            ap.translate_3d(ap.Vec3(0, -crumble * crumble * 30, 0))
            ap.draw_many(box, monoliths, monolith_look)
            ap.pop_3d()
        end
    end
    if not gone do
        for i, p in pillars do
            # Crumbling: they lean and sink into the floor.
            var lean = crumble * (24.0 if i % 2 == 0 else -18.0)
            var sink = crumble * crumble * (p.height + 1.5)
            var base = p.base - ap.Vec3(0, sink, 0)
            ap.draw_material(box, pillar_stone, base + ap.Vec3(0, p.height / 2, 0), ap.Vec3(lean, 0, lean * 0.5),
                ap.Vec3(1.1, p.height, 1.1))
            ap.draw_material(box, stone, base + ap.Vec3(0, 0.15, 0), ap.Vec3(0, 0, 0), ap.Vec3(1.4, 0.3, 1.4))
            if p.height > 4 do
                ap.draw_material(box, stone, base + ap.Vec3(0, p.height - 0.1, 0), ap.Vec3(lean, 0, lean * 0.5),
                    ap.Vec3(1.4, 0.3, 1.4))
            else do
                # Broken off.
                ap.draw_material(box, pillar_stone, base + ap.Vec3(0.12, p.height + 0.1, -0.1), ap.Vec3(14, 20, 8),
                    ap.Vec3(0.8, 0.4, 0.7))
            end
        end
    else if not casting do
        if merge_owner >= 0 do
            half_side = 1
            draw_scenery(max_def)
            half_side = -1
            draw_scenery(merge_def)
            half_side = 0
        else do
            draw_scenery(max_def)
        end
    end
    if not casting do
        ap.lighting(false)
        for i, s in souls do
            var glimmer = 0.25 + 0.2 * math.sin(double(ticks) * 0.03 + double(i))
            ap.draw(box, s + ap.Vec3(math.sin(double(ticks) * 0.01 + double(i)) * 0.3, 0, 0),
                mote_now.fade(glimmer), ap.Vec3(0, 0, 0), ap.Vec3(0.09, 0.09, 0.09))
        end
        ap.lighting(true)
    end
end

function draw_effects()
    if ap.casting_shadows() do
        return
    end
    ap.lighting(false)
    for w in wild_portals do
        var grown = math.min(double(ticks - w.born) / 20, 1.0) * math.min(double(w.born + WILD_LIFE - ticks) / 30, 1.0)
        var at = w.position + ap.Vec3(0, 1.0, 0)
        var spin = double(ticks) * 3.1
        ap.draw(hoop, at, wild_glow, ap.Vec3(90, spin, 0), ap.Vec3(grown, grown, grown * 1.25))
        ap.draw(ball, at, wild_glow.fade(0.25), ap.Vec3(0, spin, 0), ap.Vec3(1.3 * grown, 1.7 * grown, 0.08))
    end
    for s in shots do
        var kind = s.attack.shot
        var tint = fighters[s.owner].kit.look.accent
        var yaw = heading_of(s.velocity)
        if kind == roster.SHOT_BULLET do
            ap.draw(box, s.position, ap.Color(255, 230, 150), ap.Vec3(0, yaw, 0), ap.Vec3(0.07, 0.07, 0.5))
        else if kind == roster.SHOT_ROCKET do
            ap.draw(box, s.position, ap.Color(190, 195, 190), ap.Vec3(0, yaw, 0), ap.Vec3(0.2, 0.2, 0.6))
            ap.draw(box, s.position - unit(s.velocity) * 0.36, ap.Color(255, 160, 60), ap.Vec3(0, yaw, 0),
                ap.Vec3(0.14, 0.14, 0.2))
        else if kind == roster.SHOT_BATS do
            for i in 0..<3 do
                var at = s.position + forward_of(double(i) * 120 + s.age * 400) * 0.25 + ap.Vec3(0, math.sin(s.age * 14 + double(i)) * 0.15, 0)
                var flap = 0.1 + 0.16 * math.abs(math.sin(s.age * 30 + double(i)))
                ap.draw(box, at, ap.Color(36, 16, 30), ap.Vec3(0, yaw, 0), ap.Vec3(0.12 + flap * 2, 0.08, 0.12))
                ap.draw(box, at + ap.Vec3(0, 0.03, 0), tint, ap.Vec3(0, yaw, 0), ap.Vec3(0.08, 0.03, 0.14))
            end
        else if kind == roster.SHOT_WAVE do
            ap.draw(box, s.position, ap.WHITE, ap.Vec3(0, yaw, 18), ap.Vec3(1.3, 0.05, 0.1))
            ap.draw(box, s.position - unit(s.velocity) * 0.12, tint, ap.Vec3(0, yaw, 18), ap.Vec3(1.6, 0.1, 0.22))
            ap.draw(box, s.position - unit(s.velocity) * 0.3, tint.fade(0.4), ap.Vec3(0, yaw, 18), ap.Vec3(1.3, 0.08, 0.3))
        else if kind == roster.SHOT_BOMB do
            ap.draw(box, s.position, ap.Color(190, 50, 40), ap.Vec3(s.age * 700, yaw, 0), ap.Vec3(0.1, 0.1, 0.36))
            ap.draw(box, s.position + ap.Vec3(0, 0.14, 0), ap.Color(255, 230, 140), ap.Vec3(0, 0, 0), ap.Vec3(0.06, 0.06, 0.06))
        else if kind == roster.SHOT_MINE do
            ap.draw(box, s.position, ap.Color(70, 76, 70), ap.Vec3(0, 0, 0), ap.Vec3(0.42, 0.12, 0.42))
            if s.age > 0.8 and int(s.age * 2.5) % 2 == 0 do
                ap.draw(box, s.position + ap.Vec3(0, 0.08, 0), tint, ap.Vec3(0, 0, 0), ap.Vec3(0.1, 0.06, 0.1))
            end
        else if kind == roster.SHOT_METEOR do
            var big = s.attack.blast * 0.3
            ap.draw(ball, s.position, ap.Color(90, 60, 60), ap.Vec3(s.age * 200, s.age * 140, 0), ap.Vec3(big, big, big))
            ap.draw(ball, s.position, ap.Color(255, 170, 70).fade(0.5), ap.Vec3(0, 0, 0), ap.Vec3(big * 1.4, big * 1.4, big * 1.4))
        else if kind == roster.SHOT_CAR do
            # A yellow cab, in something of a hurry.
            ap.draw(box, s.position, ap.Color(250, 210, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.3, 0.6, 2.6))
            ap.draw(box, s.position + ap.Vec3(0, 0.5, 0), ap.Color(250, 210, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.2, 0.5, 1.3))
            ap.draw(box, s.position + ap.Vec3(0, 0.5, 0), ap.Color(30, 34, 50), ap.Vec3(0, yaw, 0), ap.Vec3(1.24, 0.34, 1.1))
            ap.draw(box, s.position + ap.Vec3(0, 0.82, 0), ap.WHITE, ap.Vec3(0, yaw, 0), ap.Vec3(0.4, 0.14, 0.2))
            ap.draw(box, s.position + ap.Vec3(0, -0.3, 0), ap.Color(24, 22, 28), ap.Vec3(0, yaw, 0), ap.Vec3(1.4, 0.4, 1.9))
            ap.draw(box, s.position + unit(s.velocity) * 1.3, ap.Color(255, 250, 200), ap.Vec3(0, yaw, 0), ap.Vec3(1.0, 0.14, 0.06))
        else if kind == roster.SHOT_KNIFE do
            ap.draw(box, s.position, ap.Color(225, 228, 236), ap.Vec3(s.age * 1400, yaw, 0), ap.Vec3(0.05, 0.1, 0.42))
        else if kind == roster.SHOT_FIST do
            ap.draw(box, s.position, fighters[s.owner].kit.look.metal, ap.Vec3(0, yaw, 0), ap.Vec3(0.26, 0.26, 0.34))
            ap.draw(box, s.position - unit(s.velocity) * 0.26, ap.Color(255, 170, 70), ap.Vec3(0, yaw, 0), ap.Vec3(0.16, 0.16, 0.2))
        else if kind == roster.SHOT_RING do
            ap.draw(ball, s.position, tint.fade(0.35), ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        else if kind == roster.SHOT_ROCK do
            ap.lighting(true)
            var big = 0.55 + s.attack.blast * 0.15
            ap.draw(box, s.position, ap.Color(116, 96, 78), ap.Vec3(s.age * 300, s.age * 200, s.age * 120), ap.Vec3(big, big * 0.8, big))
            ap.draw(box, s.position + ap.Vec3(0, big * 0.35, 0), ap.Color(90, 120, 60), ap.Vec3(s.age * 300, s.age * 200, s.age * 120), ap.Vec3(big * 0.9, 0.08, big * 0.9))
            ap.lighting(false)
        else if kind == roster.SHOT_SPIKE do
            ap.lighting(true)
            for i in 0..<3 do
                var at = ap.Vec3(s.position.x, 0, s.position.z) - unit(flat(s.velocity)) * (double(i) * 0.5)
                var tall = 0.9 - double(i) * 0.25
                ap.draw(box, at + ap.Vec3(0, tall / 2, 0), ap.Color(120, 100, 80), ap.Vec3(10, yaw + double(i) * 30, 8), ap.Vec3(0.5, tall, 0.5))
            end
            ap.lighting(false)
        else if kind == roster.SHOT_COIN do
            ap.draw(disc, s.position, ap.Color(255, 206, 70), ap.Vec3(90, yaw, s.age * 900), ap.Vec3(0.12, 0.03, 0.12))
        else if kind == roster.SHOT_FEATHER do
            ap.draw(box, s.position, ap.Color(30, 28, 38), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 0.02, 0.4))
            ap.draw(box, s.position, tint, ap.Vec3(0, yaw, 0), ap.Vec3(0.02, 0.03, 0.42))
        else if kind == roster.SHOT_VENOM do
            ap.draw(ball, s.position, tint, ap.Vec3(0, 0, 0), ap.Vec3(0.3, 0.3, 0.3))
        else do
            ap.draw(ball, s.position, ap.WHITE, ap.Vec3(0, 0, 0), ap.Vec3(0.2, 0.2, 0.2))
            ap.draw(ball, s.position, tint.fade(0.5), ap.Vec3(0, 0, 0), ap.Vec3(0.42, 0.42, 0.42))
        end
    end
    for b in beams do
        var left = b.life / b.span
        var v = b.to - b.from
        var mid = b.from + v * 0.5
        ap.push_3d()
        ap.translate_3d(mid)
        ap.rotate_3d(heading_of(v), ap.Vec3(0, 1, 0))
        ap.rotate_3d(-math.atan2(v.y, flat(v).length()) * 180 / math.PI, ap.Vec3(1, 0, 0))
        ap.draw(box, ap.Vec3(0, 0, 0), b.color.fade(0.5 * left), ap.Vec3(0, 0, 0), ap.Vec3(b.width * 2.4, b.width * 2.4, v.length()))
        ap.draw(box, ap.Vec3(0, 0, 0), ap.WHITE.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(b.width * left, b.width * left, v.length()))
        ap.pop_3d()
    end
    for p in portals do
        # The owner's newer door is their own color, the older one its warm twin.
        var newest = true
        var paired = false
        for q in portals do
            if q.owner == p.owner and q.born > p.born do
                newest = false
            end
            if q.owner == p.owner and q.born != p.born do
                paired = true
            end
        end
        var tint = fighters[p.owner].kit.look.accent if newest else ap.Color(255, 150, 60)
        var grown = math.min(double(ticks - p.born) / 14, 1.0)
        var at = p.position + ap.Vec3(0, 1.0, 0)
        var spin = double(ticks) * 2.5
        ap.draw(hoop, at, tint.fade(1.0 if paired else 0.45), ap.Vec3(90, spin, 0), ap.Vec3(grown, grown, grown * 1.25))
        ap.draw(ball, at, tint.fade(0.3 if paired else 0.12), ap.Vec3(0, spin, 0), ap.Vec3(1.3 * grown, 1.7 * grown, 0.08))
        if ap.chance(0.3) do
            var around = forward_of(ap.random(0, 360)) * 0.8
            spark(at + ap.Vec3(around.x, around.z, 0), ap.Vec3(-around.x, -around.z, 0) * 1.5, tint, 0.4, 0.05, 0)
        end
    end
    for m in marks do
        var left = math.min(m.life / m.span * 3, 1.0)
        ap.draw(disc, m.position, m.color.fade(m.strength * left), ap.Vec3(0, 0, 0), ap.Vec3(m.radius, 0.02, m.radius))
    end
    for s in sparks do
        var left = math.min(s.life / s.span * 1.6, 1.0)
        if s.stretch > 0 do
            var v = s.velocity
            ap.push_3d()
            ap.translate_3d(s.position)
            ap.rotate_3d(heading_of(v), ap.Vec3(0, 1, 0))
            ap.rotate_3d(-math.atan2(v.y, flat(v).length()) * 180 / math.PI, ap.Vec3(1, 0, 0))
            ap.draw(box, ap.Vec3(0, 0, 0), s.color.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(s.size, s.size, s.stretch))
            ap.pop_3d()
        else do
            ap.draw(box, s.position, s.color.fade(left), ap.Vec3(0, 0, 0), ap.Vec3(s.size, s.size, s.size))
        end
    end
    for r in rings do
        var left = r.life / r.span
        if r.ball do
            ap.draw(ball, r.position, r.color.fade(left * 0.45), ap.Vec3(0, 0, 0),
                ap.Vec3(r.radius * 2, r.radius * 2, r.radius * 2))
        else do
            for i in 0..<28 do
                var around = double(i) * 360 / 28
                ap.draw(box, r.position + forward_of(around) * r.radius, r.color.fade(left), ap.Vec3(0, around, 0),
                    ap.Vec3(r.radius * 0.2, 0.06, 0.08))
            end
        end
    end
    ap.lighting(true)
end

# BOB's machines and CARBON's walls, and daggers lying where they fell.
function draw_props()
    for pr in props do
        var grown = math.min(double(ticks - pr.born) / 10, 1.0) if pr.born > 0 else 1.0
        if pr.life > 0 and pr.life < 20 do
            grown = double(pr.life) / 20
        end
        if pr.kind == PROP_WALL do
            var h = pr.height * grown
            var rock = ap.Color(116, 96, 78)
            ap.draw(box, pr.position + ap.Vec3(0, h / 2, 0), rock, ap.Vec3(3, pr.yaw, -2), ap.Vec3(1.2, h, 1.2))
            ap.draw(box, pr.position + ap.Vec3(0.15, h - 0.1, -0.1), rock.brightness(0.85), ap.Vec3(14, pr.yaw + 30, 10), ap.Vec3(0.9, 0.5, 0.8))
            ap.draw(box, pr.position + ap.Vec3(0, 0.2, 0), rock.brightness(0.7), ap.Vec3(0, pr.yaw + 15, 0), ap.Vec3(1.7, 0.4, 1.7))
        else do
            var metal = ap.Color(110, 116, 124)
            var at = pr.position
            var yaw = pr.yaw
            ap.draw(box, at + ap.Vec3(0, 0.15, 0), ap.Color(70, 74, 80), ap.Vec3(0, yaw, 0), ap.Vec3(1.4, 0.3, 1.1))
            ap.draw(box, at + ap.Vec3(0, 0.95, 0) - forward_of(yaw) * 0.2, metal, ap.Vec3(0, yaw, 0), ap.Vec3(1.2, 1.3, 0.6))
            ap.draw(disc, at + ap.Vec3(0, 1.75, 0) - forward_of(yaw) * 0.2, metal.brightness(0.8), ap.Vec3(0, 0, 0), ap.Vec3(0.5, 0.25, 0.5))
            ap.draw(box, at + ap.Vec3(0.5, 1.2, 0) + forward_of(yaw) * 0.2, ap.Color(60, 60, 64), ap.Vec3(0, yaw, 0), ap.Vec3(0.12, 1.4, 0.12))
            if not ap.casting_shadows() do
                ap.lighting(false)
                var bubble = 0.3 + 0.15 * math.sin(double(ticks) * 0.12 + double(pr.owner))
                ap.draw(disc, at + ap.Vec3(0, 0.95, 0) + forward_of(yaw) * 0.18, ap.Color(110, 255, 130).fade(0.45 + bubble),
                    ap.Vec3(0, 0, 0), ap.Vec3(0.36, 1.0, 0.36))
                ap.draw(box, at + ap.Vec3(0, 1.45, 0) + forward_of(yaw) * 0.12, ap.Color(120, 255, 120), ap.Vec3(0, yaw, 0), ap.Vec3(0.6, 0.08, 0.04))
                ap.lighting(true)
            end
        end
    end
    for p in pickups do
        ap.draw(box, p.position + ap.Vec3(0, 0.16, 0), fighters[p.owner].kit.look.metal, ap.Vec3(32, p.yaw, 0), ap.Vec3(0.04, 0.34, 0.07))
        ap.draw(box, p.position + ap.Vec3(0, 0.33, 0) - forward_of(p.yaw) * 0.1, fighters[p.owner].kit.look.trim, ap.Vec3(32, p.yaw, 0), ap.Vec3(0.06, 0.1, 0.06))
        if not ap.casting_shadows() and (ticks + int(p.yaw)) % 70 < 5 do
            ap.lighting(false)
            ap.draw(box, p.position + ap.Vec3(0, 0.3, 0), ap.WHITE, ap.Vec3(45, 45, 0), ap.Vec3(0.12, 0.12, 0.12))
            ap.lighting(true)
        end
    end
end

# The green glow that marks a clone.
function draw_auras()
    ap.lighting(false)
    var green = ap.Color(110, 255, 120)
    for m in minions do
        var pulse = 0.12 + 0.05 * math.sin(double(ticks) * 0.15)
        var look = m.kit.look
        ap.draw(ball, m.body.center(), green.fade(pulse * fighter_alpha(m)), ap.Vec3(0, 0, 0),
            ap.Vec3(1.3 * look.bulk, 2.2 * look.tall, 1.3 * look.bulk))
        for i in 0..<16 do
            var around = double(i) * 22.5 + double(ticks) * 2
            ap.draw(box, m.body.position + forward_of(around) * 0.6 + ap.Vec3(0, 0.04, 0), green.fade(0.7), ap.Vec3(0, around, 0),
                ap.Vec3(0.14, 0.03, 0.05))
        end
    end
    ap.lighting(true)
end

function draw_fight_scene()
    draw_arena()
    for f in fighters do
        puppet.draw(rig, f.kit.look, fighter_pose(f), f.body.position, f.heading, fighter_alpha(f))
    end
    for mi in mirrors do
        # A copy does whatever its owner does, as solid as they are.
        var owner = fighters[mi.owner]
        var grown = math.min(double(ticks - mi.born) / 10, 1.0) * math.min(double(mi.life) / 30, 1.0)
        puppet.draw(rig, owner.kit.look, owner.pose, mirror_at(mi), owner.heading + mi.angle, fighter_alpha(owner) * grown)
    end
    for m in minions do
        puppet.draw(rig, m.kit.look, m.pose, m.body.position, m.heading, fighter_alpha(m))
    end
    draw_props()
    if not ap.casting_shadows() do
        draw_auras()
        for g in ghosts do
            puppet.draw(rig, g.look, g.pose, g.position, g.heading, 0.45 * g.life / g.span)
        end
    end
    draw_effects()
    if merge_owner >= 0 and not ap.casting_shadows() do
        # See-through, so it goes on after everything it could hide.
        draw_seam()
    end
    if ap.debugging() and not ap.casting_shadows() do
        world.draw_debug(ap.Color(60, 200, 120))
        for f in fighters do
            var reach = f.move.reach if f.state == STATE_ATTACK else f.kit.basics[0].reach
            var here = f.body.position + ap.Vec3(0, 1, 0)
            ap.debug_line_3d(here, here + forward_of(f.heading) * reach, ap.YELLOW)
            ap.box_lines(f.body.position - ap.Vec3(f.body.radius, 0, f.body.radius),
                f.body.position + ap.Vec3(f.body.radius, f.body.height, f.body.radius),
                ap.RED if f.state == STATE_ATTACK else ap.CYAN)
        end
    end
end

# The fighter shown on the select screen, standing in their own stance.
function preview_kit() returns roster.Character
    if cursor < cast.length do
        return cast[cursor]
    end
    return cast[(ticks // 9) % cast.length]
end

# Which fighter's super place the select screen stands in (-1: the Purgatory).
var select_world = -1
function show_select_world()
    var want = cursor if cursor < cast.length else -1
    if want == select_world do
        return
    end
    select_world = want
    if want >= 0 do
        apply_max_look(cast[want].maximum)
    else do
        apply_area()
    end
end

function draw_select_scene()
    if select_world >= 0 do
        if not ap.casting_shadows() do
            ap.draw_material(floor_mesh, floor_look, ap.Vec3(0, 0, 0))
            ap.draw_material(disc_side, stone, ap.Vec3(0, -0.72, 0))
            draw_scenery(cast[select_world].maximum)
        end
    else do
        draw_arena()
    end
    var kit = preview_kit()
    var time = double(ticks) / 60
    var pose = puppet.make_pose(kit.look, puppet.ACT_IDLE, 0, 0, 0, 0, 0, time)
    puppet.draw(rig, kit.look, pose, ap.Vec3(0, 0, 0), 18 + 22 * math.sin(time * 0.5), 1)
end

function draw_title_scene()
    draw_arena()
end

function set_lights()
    for i in 0..<8 do
        ap.light_off(i)
    end
    ap.light(6, ap.Vec3(0, 5, 0), lamp_now, 16)
    if screen == SCREEN_SELECT do
        var tint = preview_kit().look.accent
        ap.light(0, ap.Vec3(1.2, 2.2, 2.4), tint.lerp(ap.WHITE, 0.5), 8)
        ap.light(1, ap.Vec3(-2.4, 1.6, -1.5), ap.Color(200, 190, 255), 6)
        return
    end
    if screen == SCREEN_TITLE do
        return
    end
    for f in fighters do
        if fighter_alpha(f) > 0.3 and mirror_count(f.id) == 0 do
            ap.light(f.id, f.body.position + ap.Vec3(0, 2.6, 0) - forward_of(f.heading) * 0.4,
                f.kit.look.accent.lerp(ap.WHITE, 0.5).brightness(0.5), 6)
        end
    end
    var slot = 2
    for s in shots do
        if slot < 6 and s.attack.shot != roster.SHOT_BULLET and s.attack.shot != roster.SHOT_MINE do
            ap.light(slot, s.position, fighters[s.owner].kit.look.accent, 5)
            slot += 1
        end
    end
    for r in rings do
        if slot < 6 and r.ball do
            ap.light(slot, r.position, r.color, 4 + r.radius * 2)
            slot += 1
        end
    end
end

# --- The HUD -------------------------------------------------------------------------------------

function label(string words, double x, double y, double size, ap.Color color)
    ap.text(words, x + size / 8, y + size / 8, size, ap.BLACK.fade(double(color.a) / 255 * 0.8))
    ap.text(words, x, y, size, color)
end
function label_centered(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x / 2, y, size, color)
end
function label_right(string words, double x, double y, double size, ap.Color color)
    label(words, x - ap.measure(words, size).x, y, size, color)
end

# A bar that fills from the left, or from the right when `mirrored`.
function meter(double x, double y, double w, double h, double share, ap.Color color, bool mirrored)
    var filled = w * math.clamp(share, 0.0, 1.0)
    ap.rect(x + w - filled if mirrored else x, y, filled, h, color)
end

function draw_bar_icon(int icon, double x, double y, ap.Color tint, double charge)
    var cx = x + 6
    var cy = y + 6
    ap.circle(cx, cy, 6, ap.BLACK.fade(0.75))
    ap.circle_lines(cx, cy, 5.5, 1, tint.fade(0.75))
    if icon == roster.ICON_DROP do
        ap.circle(cx, y + 4, 2, tint)
        ap.line(cx - 2, y + 5, cx, y + 10, 1.5, tint)
        ap.line(cx + 2, y + 5, cx, y + 10, 1.5, tint)
    else if icon == roster.ICON_BOLT do
        ap.line(x + 7, y + 1, x + 4, y + 6, 2, tint)
        ap.line(x + 4, y + 6, x + 7, y + 6, 2, tint)
        ap.line(x + 7, y + 6, x + 5, y + 11, 2, tint)
    else if icon == roster.ICON_FANG do
        ap.line(x + 3, y + 3, x + 5, y + 10, 2, tint)
        ap.line(x + 9, y + 3, x + 7, y + 10, 2, tint)
        ap.line(x + 2, y + 3, x + 10, y + 3, 1, tint)
    else if icon == roster.ICON_EYE do
        ap.ellipse(cx, cy, 4.5, 3, tint)
        ap.circle(cx, cy, 1.5, ap.BLACK)
        ap.circle(cx, cy, 0.7, ap.WHITE)
    else if icon == roster.ICON_WHEEL do
        ap.circle_lines(cx, cy, 4.5, 1.5, tint)
        ap.circle(cx, cy, 1.2, tint)
        ap.circle(cx, y + 2.5, 0.7, tint)
        ap.circle(x + 9, y + 4.5, 0.7, tint)
        ap.circle(x + 9, y + 7.5, 0.7, tint)
        ap.circle(cx, y + 9.5, 0.7, tint)
        ap.circle(x + 3, y + 7.5, 0.7, tint)
        ap.circle(x + 3, y + 4.5, 0.7, tint)
    else if icon == roster.ICON_SWIRL do
        ap.arc(cx, cy, 4, 25, 300, 1.5, tint)
        ap.circle(x + 8, y + 3, 1, tint)
    else if icon == roster.ICON_ROCKETS do
        for i in 0..<3 do
            var rx = x + 2 + double(i) * 3
            ap.rect(rx, y + 4, 2, 5, tint)
            ap.line(rx, y + 4, rx + 1, y + 2, 1, tint)
            ap.line(rx + 2, y + 9, rx + 1, y + 11, 1, tint)
        end
    else if icon == roster.ICON_HOOD do
        ap.arc(cx, y + 7, 4, 195, 345, 1.5, tint)
        ap.line(x + 3, y + 5, x + 6, y + 1, 1.5, tint)
        ap.line(x + 9, y + 5, x + 6, y + 1, 1.5, tint)
        ap.circle(cx, y + 6, 1.5, tint)
    else if icon == roster.ICON_STAR do
        ap.line(cx, y + 1, cx, y + 11, 1.5, tint)
        ap.line(x + 1, cy, x + 11, cy, 1.5, tint)
        ap.line(x + 2, y + 2, x + 10, y + 10, 1.5, tint)
        ap.line(x + 10, y + 2, x + 2, y + 10, 1.5, tint)
        ap.circle(cx, cy, 1.5, ap.WHITE)
    else if icon == roster.ICON_SIGNAL do
        ap.rect(x + 2, y + 8, 2, 3, tint.fade(0.45))
        ap.rect(x + 5, y + 6, 2, 5, tint.fade(0.65))
        ap.rect(x + 8, y + 3, 2, 8, tint)
    else if icon == roster.ICON_SHELLS do
        for i in 0..<3 do
            var sx = x + 2 + double(i) * 3
            ap.rect(sx, y + 4, 2, 6, tint)
            ap.rect(sx, y + 3, 2, 1, ap.WHITE)
        end
    else if icon == roster.ICON_KNIFE do
        ap.line(x + 2, y + 9, x + 9, y + 2, 2, tint)
        ap.line(x + 2, y + 8, x + 5, y + 11, 1.5, tint)
        ap.line(x + 7, y + 4, x + 10, y + 7, 1, ap.WHITE)
    else if icon == roster.ICON_ATOM do
        ap.circle_lines(cx, cy, 4.5, 1, tint)
        ap.line(x + 3, y + 3, x + 9, y + 9, 1, tint)
        ap.line(x + 9, y + 3, x + 3, y + 9, 1, tint)
        ap.circle(cx, cy, 1, ap.WHITE)
    else if icon == roster.ICON_PAW do
        ap.ellipse(cx, y + 8, 3, 2, tint)
        ap.circle(x + 3, y + 4, 1.3, tint)
        ap.circle(x + 5, y + 2.5, 1.3, tint)
        ap.circle(x + 8, y + 2.5, 1.3, tint)
        ap.circle(x + 10, y + 4, 1.3, tint)
    else if icon == roster.ICON_BATTERY do
        ap.rect_lines(x + 2, y + 3, 8, 7, 1, tint)
        ap.rect(x + 4, y + 2, 4, 1, tint)
        ap.rect(x + 3, y + 4, 6 * math.clamp(charge, 0.0, 1.0), 5, tint)
    else if icon == roster.ICON_WING do
        ap.triangle(ap.Vec2(x + 6, y + 8), ap.Vec2(x + 1, y + 2), ap.Vec2(x + 2, y + 10), tint)
        ap.triangle(ap.Vec2(x + 6, y + 8), ap.Vec2(x + 11, y + 2), ap.Vec2(x + 10, y + 10), tint)
    else if icon == roster.ICON_ROCK do
        ap.triangle(ap.Vec2(x + 2, y + 10), ap.Vec2(x + 5, y + 3), ap.Vec2(x + 10, y + 10), tint)
        ap.rect(x + 6, y + 6, 3, 4, tint.brightness(0.7))
    else if icon == roster.ICON_COIN do
        var coins = int(math.clamp(charge, 0.0, 1.0) * 4 + 0.99)
        for i in 0..<coins do
            ap.rect(x + 3, y + 9 - double(i) * 2, 6, 1.5, tint)
        end
    else if icon == roster.ICON_MIRROR do
        ap.rect_lines(x + 3, y + 2, 6, 8, 1, tint)
        ap.line(x + 4, y + 7, x + 7, y + 3, 1, ap.WHITE)
    else if icon == roster.ICON_FLASK do
        ap.rect(x + 5, y + 1, 2, 4, tint)
        ap.triangle(ap.Vec2(x + 3, y + 10), ap.Vec2(x + 6, y + 4), ap.Vec2(x + 9, y + 10), tint)
    else if icon == roster.ICON_TV do
        ap.rect_lines(x + 2, y + 4, 8, 6, 1, tint)
        ap.line(x + 6, y + 4, x + 4, y + 1, 1, tint)
        ap.line(x + 6, y + 4, x + 8, y + 1, 1, tint)
    else if icon == roster.ICON_BLADES do
        ap.line(x + 3, y + 10, x + 9, y + 2, 1.5, tint)
        ap.line(x + 3, y + 2, x + 9, y + 10, 1.5, tint)
    else if icon == roster.ICON_SKULL do
        ap.circle(cx, y + 5, 3.5, tint)
        ap.rect(x + 4, y + 7, 4, 3, tint)
        ap.rect(x + 4, y + 4, 1.5, 1.5, ap.BLACK)
        ap.rect(x + 6.5, y + 4, 1.5, 1.5, ap.BLACK)
    else if icon == roster.ICON_LEAF do
        ap.triangle(ap.Vec2(cx, y + 1), ap.Vec2(x + 2, y + 9), ap.Vec2(x + 10, y + 9), tint)
        ap.line(cx, y + 9, cx, y + 11, 1.5, tint)
    else if icon == roster.ICON_SUN do
        ap.circle(cx, cy, 2.5, tint)
        ap.circle_lines(cx, cy, 3.5, 1, tint)
        ap.line(cx, y + 0.5, cx, y + 1.5, 1, tint)
        ap.line(cx, y + 10.5, cx, y + 11.5, 1, tint)
        ap.line(x + 0.5, cy, x + 1.5, cy, 1, tint)
        ap.line(x + 10.5, cy, x + 11.5, cy, 1, tint)
    end
end

function draw_fighter_hud(Fighter f)
    var kit = f.kit
    var look = kit.look
    var mirrored = f.id == 1
    var x = 364.0 if mirrored else 16.0
    var w = 260.0
    # Health, with the part just lost fading behind it.
    ap.rect(x - 2, 12, w + 4, 16, ap.BLACK.fade(0.75))
    ap.rect(x, 14, w, 12, ap.Color(44, 22, 34))
    meter(x, 14, w, 12, f.shown_health / f.max_health, ap.Color(200, 60, 70), mirrored)
    var healthy = ap.Color(120, 220, 110) if f.poison <= 0 else ap.Color(150, 210, 60)
    if f.health / f.max_health < 0.3 do
        healthy = ap.Color(240, 190, 70)
    end
    meter(x, 14, w, 12, f.health / f.max_health, healthy, mirrored)
    meter(x, 14, w, 3, f.health / f.max_health, ap.WHITE.fade(0.25), mirrored)
    ap.rect_lines(x - 1, 13, w + 2, 14, 1, look.accent)
    var name = kit.name if not mirrored else "{kit.name} (CPU)"
    if mirrored do
        label_right(name, x + w, 32, 16, look.accent)
    else do
        label(name, x, 32, 16, look.accent)
    end
    # Rounds won.
    if finale_slots() do
        # Two side slots, filled from the outside in toward the finale in the middle.
        for i in 0..<2 do
            var px = 274.0 + double(i) * 12 if not mirrored else 358.0 - double(i) * 12
            ap.rect(px, 30, 8, 8, ap.BLACK.fade(0.7))
            ap.rect(px + 1, 31, 6, 6, look.accent if i < f.wins else ap.Color(50, 46, 66))
        end
    else if mode == MODE_ENDLESS or mode == MODE_RANDOM do
        if mirrored do
            label("WINS {f.wins}", 346, 30, 8, look.accent)
        else do
            label_right("WINS {f.wins}", 294, 30, 8, look.accent)
        end
    else do
        for i in 0..<ROUNDS_TO_WIN do
            var px = 286.0 - double(i) * 12 if not mirrored else 346.0 + double(i) * 12
            ap.rect(px, 30, 8, 8, ap.BLACK.fade(0.7))
            ap.rect(px + 1, 31, 6, 6, look.accent if i < f.wins else ap.Color(50, 46, 66))
        end
    end
    # The special bar.
    var bw = 132.0
    var bx = x + w - bw if mirrored else x
    var by = 52.0
    if kit.bar_pips do
        var count = int(kit.bar_max)
        var have = pips(kit, f.bar)
        for i in 0..<count do
            var px = bx + bw - 14 - double(i) * 16 if mirrored else bx + double(i) * 16
            ap.rect(px, by - 1, 14, 9, ap.BLACK.fade(0.75))
            ap.rect(px + 1, by, 12, 7, look.accent if i < have else ap.Color(44, 40, 58))
        end
        if f.state == STATE_RELOAD and kit.reload_all do
            meter(bx, by + 10, bw, 2, double(f.frame) / double(roster.SPEEDLOAD_TICKS), ap.WHITE, mirrored)
        else if f.state == STATE_RELOAD do
            meter(bx, by + 10, bw, 2, double(f.frame % roster.RELOAD_TICKS) / double(roster.RELOAD_TICKS), ap.WHITE, mirrored)
        else if kit.bar_regen > 0 and have < count do
            meter(bx, by + 10, bw, 2, f.bar - double(have), look.accent.fade(0.7), mirrored)
        end
    else do
        ap.rect(bx - 1, by - 1, bw + 2, 9, ap.BLACK.fade(0.75))
        ap.rect(bx, by, bw, 7, ap.Color(34, 30, 48))
        meter(bx, by, bw, 7, f.bar / kit.bar_max, look.accent, mirrored)
    end
    var used_w = double(int(kit.bar_max)) * 16 - 2 if kit.bar_pips else bw
    var icon_x = x - 14 if not mirrored else x + w + 2
    draw_bar_icon(kit.bar_icon, icon_x, by - 3, look.accent, f.bar / kit.bar_max)
    var bar_name = "{kit.bar_name} FREE" if mx(f).free_bar else kit.bar_name
    if mirrored do
        label_right(bar_name, x + w - used_w - 6, by, 8, look.accent)
    else do
        label(bar_name, x + used_w + 6, by, 8, look.accent)
    end
    # The super bar, small; the player's is also drawn large at the bottom.
    var full = f.energy >= roster.SUPER_MAX
    ap.rect(bx - 1, by + 13, bw + 2, 5, ap.BLACK.fade(0.75))
    ap.rect(bx, by + 14, bw, 3, ap.Color(50, 18, 24))
    meter(bx, by + 14, bw, 3, f.energy / roster.SUPER_MAX, ap.Color(255, 70, 70) if full else ap.Color(190, 40, 50), mirrored)
    # How close their basic attacks are to setting the opponent free.
    var sx = bx + bw - 60 if mirrored else bx
    var hot = ap.Color(255, 120, 90) if f.spam > 0.7 else ap.Color(200, 190, 120)
    ap.rect(sx - 1, by + 20, 62, 5, ap.BLACK.fade(0.75))
    ap.rect(sx, by + 21, 60, 3, ap.Color(40, 36, 30))
    meter(sx, by + 21, 60, 3, f.spam, hot, mirrored)
    if mirrored do
        label_right("SPAM", sx - 5, by + 19, 8, hot.fade(0.4 + 0.6 * f.spam))
    else do
        label("SPAM", sx + 65, by + 19, 8, hot.fade(0.4 + 0.6 * f.spam))
    end
    # What is wrong, or right, with them.
    var status = ""
    var status_color = ap.WHITE
    if f.slow > 0 do
        status = "SLOWED"
        status_color = ap.Color(150, 200, 240)
    end
    if f.buff == roster.BUFF_MIST do
        status = "MIST"
        status_color = look.accent
    else if f.buff == roster.BUFF_HASTE do
        status = "SECOND WIND {int(f.buff_time) + 1}"
        status_color = look.accent
    else if f.buff == roster.BUFF_REGEN do
        status = "MENDING {int(f.buff_time) + 1}"
        status_color = ap.Color(120, 240, 130)
    else if f.buff == roster.BUFF_POWER do
        status = "LOADED"
        status_color = look.accent
    else if f.buff == roster.BUFF_PARRY do
        status = "STILL WATER {int(f.buff_time) + 1}"
        status_color = look.accent
    else if f.buff == roster.BUFF_GUARD do
        status = "BRACED {int(f.buff_time) + 1}"
        status_color = look.accent
    end
    if f.poison > 0 do
        status = "{other(f).kit.dot_name} {int(f.poison) + 1}"
        status_color = ap.Color(150, 240, 80)
    end
    if f.cloaked do
        status = "UNSEEN"
        status_color = look.accent
    end
    if f.state == STATE_RELOAD do
        status = "RELOADING"
        status_color = ap.LIGHT_GRAY
    end
    if mx(f).vanish do
        status = "VANISHED"
        status_color = look.accent
    end
    if status == "" and kit.revive > 0 and not f.revived and phase == PHASE_FIGHT do
        status = "UNDEAD"
        status_color = look.accent
    end
    if f.broke_ticks > 0 do
        status = "BANKRUPT {(f.broke_ticks + 59) // 60}"
        status_color = ap.Color(255, 90, 80)
    end
    if status == "" and kit.arsenal.length > 0 do
        status = kit.arsenal[f.arm].name
        status_color = look.metal
    end
    if status == "" and kit.copycat do
        status = "LOCKED: {kit.skills[0].name.upper()}" if f.copy_locked else "NEXT HIT IS COPIED"
        status_color = look.accent if f.copy_locked else ap.Color(170, 165, 190)
    end
    if status == "" and kit.lab do
        if f.clone_cool > 0 do
            status = "MACHINE COOLING {(f.clone_cool + 59) // 60}"
            status_color = ap.Color(170, 165, 190)
        else do
            status = "DOSES {f.injects}/{1 if mx(f).labs else kit.inject_need}"
            status_color = look.accent
        end
    end
    if status == "" and mirror_count(f.id) > 0 and not f.cpu do
        status = "{mirror_count(f.id)} COPIES"
        status_color = look.accent
    end
    if status == "" and behind(f) > 0 and phase != PHASE_OVER do
        status = "UNDERDOG +{int(UNDERDOG_DAMAGE * 100) * behind(f)}%"
        status_color = look.accent
    end
    if status != "" do
        if mirrored do
            label_right(status, x + w, 82, 8, status_color)
        else do
            label(status, x, 82, 8, status_color)
        end
    end
    # The combo they are landing.
    if f.combo_show > 0 and f.combo >= 2 do
        var fade = math.min(double(f.combo_show) / 20, 1.0)
        var count = "{f.combo} HITS"
        var total = "{int(f.combo_damage + 0.5)} DAMAGE"
        if mirrored do
            label_right(count, x + w, 96, 16, look.accent.fade(fade))
            label_right(total, x + w, 114, 8, ap.WHITE.fade(fade))
        else do
            label(count, x, 96, 16, look.accent.fade(fade))
            label(total, x, 114, 8, ap.WHITE.fade(fade))
        end
    end
end

# The player's moves along the bottom: the four skills with their cooldowns, and the super bar.
function draw_moves_hud(Fighter f)
    var kit = f.kit
    var look = kit.look
    var dim = ap.Color(120, 116, 140)
    var dash = "Q Dash" if f.dash_cooldown == 0 else "Q ...."
    label("R {kit.basics[0].name}    F Block    {dash}", 16, 304, 8, ap.Color(170, 165, 190))
    for i, a in kit.skills do
        var x = 16.0 + double(i) * 110
        var y = 315.0
        var w = 106.0
        var cooling = f.cooldowns[i] > 0
        var paid = f.bar + 0.001 >= a.cost
        if a.kind == roster.KIND_RELOAD do
            paid = f.bar < kit.bar_max
        else if a.kind == roster.KIND_CLOAK and f.cloaked do
            paid = true
        end
        var ready = paid and not cooling
        ap.rect(x, y, w, 17, ap.BLACK.fade(0.7))
        ap.rect(x, y, 15, 17, look.accent if ready else ap.Color(44, 40, 58))
        if cooling do
            # The box refills as the skill comes back.
            var left = double(f.cooldowns[i]) / double(math.max(a.cooldown, 1))
            ap.rect(x + 15, y, (w - 15) * (1 - left), 17, look.accent.fade(0.16))
            label_centered("{(f.cooldowns[i] + 59) // 60}", x + 8, y + 5, 8, ap.WHITE)
        else do
            label_centered("{i + 1}", x + 8, y + 5, 8, ap.BLACK if ready else dim)
        end
        label(a.name, x + 19, y + 5, 8, ap.WHITE if ready else dim)
        if ready do
            ap.rect(x, y + 16, w, 1, look.accent)
        end
    end
    # The super.
    var full = f.energy >= roster.SUPER_MAX
    var red = ap.Color(255, 70, 70) if full else ap.Color(190, 40, 50)
    ap.rect(16, 336, 15, 12, red if full else ap.Color(60, 22, 28))
    label_centered("G", 24, 338, 8, ap.WHITE if full else dim)
    ap.rect(33, 336, 204, 12, ap.BLACK.fade(0.75))
    ap.rect(35, 338, 200, 8, ap.Color(50, 18, 24))
    ap.rect(35, 338, 200 * f.energy / roster.SUPER_MAX, 8, red)
    ap.rect(35, 338, 200 * f.energy / roster.SUPER_MAX, 2, ap.WHITE.fade(0.25))
    if in_super(f) do
        # Your super is on: the bar is its time, and G is the old super move until used.
        var m = mx(f)
        var left = super_left(f)
        ap.rect(35, 338, 200, 8, ap.Color(50, 18, 24))
        ap.rect(35, 338, 200 * double(left) / (m.seconds * 60), 8, m.glow)
        var word = "G  {kit.ultimate.name}" if not f.encore_used else "{m.name}  {(left + 59) // 60}s"
        label(word, 243, 338, 8, ap.WHITE)
    else if full and kit.maximum.jammer do
        if can_super(f) do
            label("G  SWITCH OFF THEIR SUPER", 243, 338, 8, MAX_GOLD)
        else do
            label("SUPER  ONLY IN THEIR SUPER", 243, 338, 8, dim)
        end
    else if full and merge_owner >= 0 do
        label("SUPER  WAIT", 243, 338, 8, dim)
    else if full and max_owner >= 0 do
        label("SUPER  WAIT", 243, 338, 8, dim)
    else if kit.maximum.jammer and not full do
        label("SUPER  {int(f.energy)}%  (THEIR SUPER ONLY)", 243, 338, 8, dim)
    else do
        label("SUPER  {kit.maximum.name}" if full else "SUPER  {int(f.energy)}%", 243, 338, 8, ap.WHITE if full else dim)
    end
end

function draw_fight_hud()
    if max_cut > 0 do
        # The cutscene has the screen to itself.
        draw_maximum_hud()
        return
    end
    for f in fighters do
        draw_fighter_hud(f)
    end
    var seconds = (clock + 59) // 60
    if finale_slots() do
        # The finale slot under the clock: gold-rimmed, pulsing while it is up for grabs,
        # and filled with the winner's colour once taken.
        var taker = -1
        for f in fighters do
            if f.wins >= 3 do
                taker = f.id
            end
        end
        var rim = ap.Color(255, 206, 70)
        if finale_round() and taker < 0 do
            rim = rim.fade(0.55 + 0.45 * math.sin(double(ticks) * 0.15))
        end
        ap.rect(314, 32, 12, 12, ap.BLACK.fade(0.8))
        ap.rect_lines(314, 32, 12, 12, 1, rim)
        ap.rect(316, 34, 8, 8, fighters[taker].kit.look.accent if taker >= 0 else ap.Color(50, 46, 66))
    end
    ap.rect(302, 10, 36, 22, ap.BLACK.fade(0.75))
    label_centered("{seconds}", 320, 13, 16, ap.WHITE if seconds > 10 else ap.Color(240, 190, 70))
    # Where the arena is, named as it changes.
    if area_blend < AREA_SHIFT do
        var shown = math.sin(double(area_blend) / double(AREA_SHIFT) * math.PI)
        label_centered(area_title(), 320, 44, 8, area_glow().fade(shown))
    else do
        label_centered(area_title(), 320, 44, 8, area_glow().fade(0.45))
    end
    for m in minions do
        # A clone's health, over its head.
        ap.rect(m.screen.x - 16, m.screen.y - 1, 32, 5, ap.BLACK.fade(0.7))
        ap.rect(m.screen.x - 15, m.screen.y, 30 * math.clamp(m.health / m.max_health, 0.0, 1.0), 3, ap.Color(120, 255, 120))
    end
    for f in floaters do
        var fade = math.min(f.life * 2.5, 1.0)
        label_centered(f.words, f.screen.x, f.screen.y, 8, f.color.fade(fade))
    end
    if banner != "" do
        var fade = math.min(double(phase_ticks) / 14, 1.0)
        if phase == PHASE_FIGHT do
            fade = math.clamp(double(45 - phase_ticks) / 14, 0.0, 1.0)
        end
        ap.rect(0, 150, VW, 46, ap.BLACK.fade(0.5 * fade))
        label_centered(banner, 320, 158, 32, ap.WHITE.fade(fade))
        if phase == PHASE_INTRO and banner_sub != "" do
            label_centered(banner_sub, 320, 204, 8, banner_sub_color.fade(fade))
        end
        if phase == PHASE_OVER and banner != "DOUBLE K.O." and phase_ticks > 50 do
            var lead = fighters[0] if fighters[0].wins > fighters[1].wins or fighters[1].state == STATE_DOWN else fighters[1]
            if banner == "K.O." do
                label_centered("{lead.kit.name} TAKES THE ROUND", 320, 204, 8, lead.kit.look.accent)
            end
        end
    end
    draw_moves_hud(fighters[0])
    draw_maximum_hud()
    if phase == PHASE_DRAFT do
        draw_draft_hud()
    end
    if super_ticks > 0 do
        # A super is called by name, across the screen.
        var show = math.min(double(super_ticks) / 12, 1.0) * math.min(double(80 - super_ticks) / 5, 1.0)
        ap.rect(0, 126, VW, 24, ap.BLACK.fade(0.55 * show))
        ap.rect(0, 126, VW, 1, ap.Color(240, 50, 60).fade(show))
        ap.rect(0, 149, VW, 1, ap.Color(240, 50, 60).fade(show))
        label_centered(super_name.upper(), 320, 130, 16, super_tint.fade(show))
    end
    var cpu = "FIGHTS"
    if cpu_mode == CPU_STANDS do
        cpu = "STANDS"
    else if cpu_mode == CPU_BLOCKS do
        cpu = "BLOCKS"
    end
    label_right("F1 DEBUG  F2 PIXELS {pixel}X  F3 CPU {cpu}  F4 REFILL  F5 {LEVEL_NAMES[level]}", 624, 304, 8, ap.Color(110, 106, 130))
    if ap.debugging() do
        for f in fighters do
            ap.debug_text("{f.kit.name}: state {f.state} frame {f.frame} hp {int(f.health)} bar {int(f.bar)} fade {int(f.fade * 100)}")
        end
        ap.debug_text("shots {shots.length} sparks {sparks.length} phase {phase} cpu {cpu}")
        ap.debug_inputs("player", pad, 6)
    end
    if paused do
        ap.rect(0, 0, VW, VH, ap.BLACK.fade(0.6))
        label_centered("PAUSED", 320, 96, 32, ap.WHITE)
        var items = ["RESUME", "RESTART MATCH", "CHARACTER SELECT", "QUIT"]
        for i, item in items do
            var chosen = i == pause_cursor
            label_centered("> {item} <" if chosen else item, 320, 150 + double(i) * 22, 16,
                ap.WHITE if chosen else ap.Color(130, 126, 150))
        end
        label_centered("WASD move    R attack (again to chain)    1 2 3 4 skills    G super    F block (tap to parry)    Q dash",
            320, 256, 8, ap.Color(170, 165, 190))
        label_centered("A hit can be cancelled: attack into a skill, a skill into the super", 320, 268, 8,
            ap.Color(170, 165, 190))
        for side in 0..<2 do
            var words = held_items(side)
            if words != "" do
                label_centered("{"YOUR" if side == 0 else "THEIR"} ITEMS: {words}", 320, 308 + double(side) * 10, 8, fighters[side].kit.look.accent)
            end
        end
        label_centered("Super bar full when they call theirs? G during their cutscene merges the two places", 320, 296, 8,
            ap.Color(255, 206, 70))
        label_centered("Gamepad: stick, X attack, Y / B / d-pad left / right skills, LB super, RB block, A dash", 320, 282, 8,
            ap.Color(130, 126, 150))
    end
end

function draw_title_hud()
    ap.rect(0, 0, VW, VH, ap.BLACK.fade(0.25))
    var rise = math.min(double(screen_ticks) / 50, 1.0)
    label_centered("PLAYER", 320, 92, 48, ap.WHITE.fade(rise))
    label_centered("VERSUS", 320, 142, 48, ap.Color(170, 110, 255).fade(rise))
    ap.rect(196, 196, 248 * rise, 2, ap.Color(170, 110, 255).fade(rise))
    label_centered("TESTING PROTOTYPE", 320, 206, 8, ap.Color(150, 145, 175).fade(rise))
    var breathe = 0.55 + 0.35 * math.sin(double(ticks) * 0.05)
    label_centered("PRESS ENTER", 320, 268, 16, ap.WHITE.fade(breathe * rise))
    label_centered("ESC QUITS", 320, 340, 8, ap.Color(110, 106, 130))
end

# A small bust for a select card.
function draw_portrait(roster.Look look, double x, double y, double w, double h)
    ap.gradient(x, y, w, h, look.accent.brightness(0.28), ap.Color(14, 12, 24))
    var cx = x + w / 2
    var base = y + h
    var wide = math.min(26 * look.bulk, w - 4)
    ap.rect(cx - wide / 2, base - 14, wide, 14, look.body)
    ap.rect(cx - wide / 2, base - 14, wide, 2, look.trim)
    if look.cape do
        ap.rect(cx - 15 * look.bulk, base - 13, 4, 13, look.cape_color)
        ap.rect(cx + 15 * look.bulk - 4, base - 13, 4, 13, look.cape_color)
    end
    ap.rect(cx - 6, base - 26, 12, 12, look.skin)
    if look.head == roster.HEAD_MASK do
        ap.rect(cx - 4, base - 21, 8, 1, look.eyes)
    else do
        ap.rect(cx - 4, base - 21, 2, 2, look.eyes)
        ap.rect(cx + 2, base - 21, 2, 2, look.eyes)
    end
    var h_kind = look.head
    if h_kind == roster.HEAD_SLICK do
        ap.rect(cx - 6, base - 27, 12, 3, look.legs)
        ap.rect(cx - 9, base - 20, 3, 8, look.cape_color)
        ap.rect(cx + 6, base - 20, 3, 8, look.cape_color)
    else if h_kind == roster.HEAD_BAND do
        ap.rect(cx - 6, base - 27, 12, 2, look.legs)
        ap.rect(cx - 7, base - 25, 14, 2, look.accent)
    else if h_kind == roster.HEAD_COBRA do
        ap.rect(cx - 12, base - 29, 6, 17, look.body)
        ap.rect(cx + 6, base - 29, 6, 17, look.body)
        ap.rect(cx - 6, base - 29, 12, 3, look.body)
    else if h_kind == roster.HEAD_PLUME do
        ap.rect(cx - 11, base - 27, 22, 2, look.body)
        ap.rect(cx - 6, base - 31, 12, 4, look.body)
        ap.rect(cx + 5, base - 35, 3, 7, look.accent)
    else if h_kind == roster.HEAD_COWBOY do
        ap.rect(cx - 12, base - 27, 24, 2, look.body.brightness(0.7))
        ap.rect(cx - 6, base - 32, 12, 5, look.body.brightness(0.7))
        ap.rect(cx - 6, base - 18, 12, 4, look.trim)
    else if h_kind == roster.HEAD_MASK do
        ap.rect(cx - 7, base - 15, 14, 3, look.trim)
    else if h_kind == roster.HEAD_HELMET do
        ap.rect(cx - 7, base - 29, 14, 6, look.metal)
    else if h_kind == roster.HEAD_HOOD do
        ap.rect(cx - 8, base - 29, 16, 4, look.cape_color)
        ap.rect(cx - 8, base - 29, 3, 16, look.cape_color)
        ap.rect(cx + 5, base - 29, 3, 16, look.cape_color)
    else if h_kind == roster.HEAD_WIZARD do
        ap.rect(cx - 11, base - 27, 22, 2, look.body)
        ap.triangle(ap.Vec2(cx - 6, base - 27), ap.Vec2(cx + 6, base - 27), ap.Vec2(cx + 1, base - 39), look.body)
        ap.rect(cx - 3, base - 17, 6, 6, ap.Color(235, 235, 240))
    else if h_kind == roster.HEAD_HEADSET do
        ap.rect(cx - 7, base - 29, 14, 4, look.accent)
        ap.rect(cx - 8, base - 26, 2, 9, look.accent)
        ap.rect(cx + 6, base - 26, 2, 9, look.accent)
        ap.rect(cx - 8, base - 22, 2, 5, look.legs)
        ap.rect(cx - 8, base - 17, 6, 1, look.legs)
    else if h_kind == roster.HEAD_CAP do
        ap.rect(cx - 6, base - 29, 12, 4, look.trim)
        ap.rect(cx - 8, base - 25, 16, 2, look.trim)
    else if h_kind == roster.HEAD_BEANIE do
        ap.rect(cx - 6, base - 29, 12, 5, look.trim)
        ap.rect(cx - 6, base - 18, 12, 4, look.legs)
    else if h_kind == roster.HEAD_HAZMAT do
        ap.rect(cx - 8, base - 29, 16, 16, look.body)
        ap.rect(cx - 5, base - 24, 10, 6, look.eyes)
    else if h_kind == roster.HEAD_CAT do
        ap.rect(cx - 6, base - 30, 4, 4, look.body)
        ap.rect(cx + 2, base - 30, 4, 4, look.body)
        ap.rect(cx - 3, base - 18, 6, 3, look.trim)
    else if h_kind == roster.HEAD_ROBOT do
        ap.rect(cx - 7, base - 27, 14, 14, look.metal)
        ap.rect(cx - 5, base - 23, 10, 4, look.legs)
        ap.rect(cx - 4, base - 22, 3, 2, look.eyes)
        ap.rect(cx + 1, base - 22, 3, 2, look.eyes)
        ap.rect(cx + 3, base - 33, 1, 6, look.metal)
        ap.rect(cx + 2, base - 35, 3, 2, look.accent)
    else if h_kind == roster.HEAD_VISOR do
        ap.rect(cx - 7, base - 28, 14, 15, look.body)
        ap.rect(cx - 6, base - 23, 12, 2, look.eyes)
    else if h_kind == roster.HEAD_TV do
        ap.rect(cx - 10, base - 29, 20, 16, look.legs.brightness(0.8))
        ap.rect(cx - 8, base - 27, 16, 12, look.accent.brightness(0.55))
        ap.rect(cx - 5, base - 23, 2, 2, look.eyes)
        ap.rect(cx + 3, base - 23, 2, 2, look.eyes)
        ap.line(cx - 2, base - 29, cx - 7, base - 37, 1, look.metal)
        ap.line(cx + 2, base - 29, cx + 7, base - 37, 1, look.metal)
    else if h_kind == roster.HEAD_TOPHAT do
        ap.rect(cx - 10, base - 27, 20, 2, look.legs)
        ap.rect(cx - 6, base - 37, 12, 10, look.legs)
        ap.rect(cx - 6, base - 29, 12, 2, look.trim)
        ap.circle_lines(cx - 3, base - 20, 2, 1, look.trim)
    else if h_kind == roster.HEAD_GOGGLES do
        ap.rect(cx - 9, base - 29, 18, 4, ap.Color(236, 236, 240))
        ap.rect(cx - 10, base - 25, 3, 7, ap.Color(236, 236, 240))
        ap.rect(cx + 7, base - 25, 3, 7, ap.Color(236, 236, 240))
        ap.rect(cx - 5, base - 27, 4, 3, look.accent)
        ap.rect(cx + 1, base - 27, 4, 3, look.accent)
    else if h_kind == roster.HEAD_MIRROR do
        ap.rect(cx - 7, base - 27, 14, 14, look.trim)
        ap.rect(cx - 5, base - 25, 10, 10, look.accent.brightness(0.8))
        ap.rect(cx - 4, base - 24, 2, 4, ap.WHITE)
    else if h_kind == roster.HEAD_PONYTAIL do
        ap.rect(cx - 6, base - 28, 12, 3, ap.Color(46, 30, 22))
        ap.rect(cx + 5, base - 30, 3, 12, ap.Color(46, 30, 22))
        ap.rect(cx - 6, base - 25, 12, 1, look.metal)
    else if h_kind == roster.HEAD_VEIL do
        ap.rect(cx - 8, base - 28, 16, 3, look.cape_color)
        ap.rect(cx - 8, base - 26, 3, 14, look.cape_color)
        ap.rect(cx + 5, base - 26, 3, 14, look.cape_color)
    else if h_kind == roster.HEAD_STITCHED do
        ap.rect(cx - 6, base - 27, 12, 1, look.legs)
        ap.rect(cx - 1, base - 27, 1, 5, look.legs)
        ap.rect(cx - 4, base - 16, 8, 3, look.skin.brightness(0.7))
        ap.rect(cx - 3, base - 16, 6, 1, ap.Color(30, 20, 20))
    else if h_kind == roster.HEAD_TOPKNOT do
        ap.rect(cx - 6, base - 28, 12, 3, ap.Color(30, 24, 22))
        ap.rect(cx - 2, base - 32, 4, 4, ap.Color(30, 24, 22))
        ap.rect(cx - 7, base - 25, 14, 2, look.trim)
    else if h_kind == roster.HEAD_CREST do
        ap.rect(cx - 7, base - 29, 14, 5, look.metal)
        ap.rect(cx - 7, base - 25, 2, 9, look.metal)
        ap.rect(cx + 5, base - 25, 2, 9, look.metal)
        ap.rect(cx - 1, base - 33, 3, 4, look.accent)
    end
    if look.wings do
        ap.triangle(ap.Vec2(cx - 9, base - 12), ap.Vec2(cx - 22, base - 30), ap.Vec2(cx - 20, base - 8), look.wing_color.brightness(1.6))
        ap.triangle(ap.Vec2(cx + 9, base - 12), ap.Vec2(cx + 22, base - 30), ap.Vec2(cx + 20, base - 8), look.wing_color.brightness(1.6))
    end
end

function draw_stat(string name, double share, double x, double y, ap.Color color)
    label(name, x, y, 8, ap.Color(150, 145, 175))
    for i in 0..<10 do
        var lit = double(i) < math.clamp(share, 0.0, 1.0) * 10 - 0.5
        ap.rect(x + 54 + double(i) * 9, y, 7, 7, color if lit else ap.Color(36, 32, 50))
    end
end

function draw_select_hud()
    var columns = grid_columns()
    var cards = cast.length + 1
    var rows = (cards + columns - 1) // columns
    var left = 262.0
    var top = 42.0
    var gap = 5.0
    var cw = (364.0 - gap * double(columns - 1)) / double(columns)
    var ch = 52.0 if rows <= 2 else 30.0
    var tint = ap.Color(170, 110, 255) if picking == 0 else ap.Color(255, 120, 90)
    ap.gradient_across(0, 0, VW, 30, ap.BLACK.fade(0.8), ap.BLACK.fade(0.3))
    if mode == MODE_SHOWDOWN do
        var slot = pick_step % TEAM_SIZE
        label("{"CHOOSE YOUR TEAM" if picking == 0 else "CHOOSE THEIR TEAM"} {slot + 1}/{TEAM_SIZE}", 16, 8, 16, tint)
        # The team so far, in fighting order.
        var x = 624.0
        var count = slot if picking == 0 else TEAM_SIZE
        var side = 0
        if picking == 1 and slot > 0 do
            count = slot
            side = 1
        end
        var i = count - 1
        while i >= 0 do
            var kit = cast[teams[side][i]]
            label_right(kit.name, x, 12, 8, kit.look.accent)
            x -= double(kit.name.length) * 8 + 10
            i -= 1
        end
        if count > 0 do
            label_right("YOU:" if side == 0 else "THEM:", x, 12, 8, ap.Color(150, 145, 175))
        end
    else do
        label("CHOOSE YOUR FIGHTER" if picking == 0 else "CHOOSE YOUR OPPONENT", 16, 8, 16, tint)
        if picking == 1 do
            label_right("YOU: {cast[picks[0]].name}", 624, 12, 8, cast[picks[0]].look.accent)
        end
    end
    for i in 0..<cards do
        var x = left + double(i % columns) * (cw + gap)
        var y = top + double(i // columns) * (ch + gap)
        var chosen = i == cursor
        ap.rect(x - 1, y - 1, cw + 2, ch + 2, ap.BLACK.fade(0.8))
        if i < cast.length do
            var kit = cast[i]
            draw_portrait(kit.look, x, y, cw, ch - 11)
            ap.rect(x, y + ch - 11, cw, 11, ap.Color(18, 16, 30))
            if cw >= 56 do
                label_centered(kit.name, x + cw / 2, y + ch - 9, 8, ap.WHITE if chosen else ap.Color(150, 145, 175))
            else do
                ap.rect(x + 3, y + ch - 7, cw - 6, 3, kit.look.accent if chosen else kit.look.accent.brightness(0.45))
            end
            if mode == MODE_SHOWDOWN do
                # Numbered badges on the team being picked; P1 marks on the player's team after.
                for k in 0..<TEAM_SIZE do
                    var placed = k < pick_step - picking * TEAM_SIZE
                    if picking == 0 and placed and teams[0][k] == i do
                        ap.rect(x + 2, y + 2, 9, 9, tint)
                        ap.text("{k + 1}", x + 3, y + 3, 8, ap.WHITE)
                    else if picking == 1 and placed and teams[1][k] == i do
                        ap.rect(x + cw - 11, y + 2, 9, 9, tint)
                        ap.text("{k + 1}", x + cw - 10, y + 3, 8, ap.WHITE)
                    end
                    if picking == 1 and teams[0][k] == i do
                        ap.rect(x + 2, y + 2, 14, 9, ap.Color(170, 110, 255))
                        ap.text("P1", x + 3, y + 3, 8, ap.WHITE)
                    end
                end
            else if picking == 1 and i == picks[0] do
                ap.rect(x + 2, y + 2, 14, 9, ap.Color(170, 110, 255))
                ap.text("P1", x + 3, y + 3, 8, ap.WHITE)
            end
        else do
            ap.gradient(x, y, cw, ch, ap.Color(40, 36, 58), ap.Color(14, 12, 24))
            label_centered("?", x + cw / 2, y + ch / 2 - 14, 24, ap.WHITE if chosen else ap.Color(110, 106, 130))
            if cw >= 56 do
                label_centered("RANDOM", x + cw / 2, y + ch - 9, 8, ap.WHITE if chosen else ap.Color(150, 145, 175))
            end
        end
        if chosen do
            ap.rect_lines(x - 2, y - 2, cw + 4, ch + 4, 2, tint)
        end
    end

    # Everything about the fighter under the cursor.
    var py = top + double(rows) * (ch + gap) + 8
    ap.rect(left - 6, py - 4, 376, 348 - py, ap.BLACK.fade(0.55))
    if cursor >= cast.length do
        label("RANDOM", left, py, 24, ap.WHITE)
        label("Let the Purgatory decide.", left, py + 30, 8, ap.Color(190, 186, 210))
    else do
        var kit = cast[cursor]
        var look = kit.look
        label(kit.name, left, py, 24, look.accent)
        label(kit.title, left + ap.measure(kit.name, 24).x + 10, py + 14, 8, ap.Color(190, 186, 210))
        label(kit.blurb, left, py + 30, 8, ap.Color(190, 186, 210))
        label(kit.style.upper(), 624 - ap.measure(kit.style.upper(), 8).x, py + 2, 8, look.accent)
        var sy = py + 44
        draw_stat("HEALTH", roster.rate_health(kit), left, sy, ap.Color(120, 220, 110))
        draw_stat("SPEED", roster.rate_speed(kit), left, sy + 11, ap.Color(120, 190, 255))
        draw_stat("POWER", roster.rate_power(kit), left, sy + 22, ap.Color(255, 120, 90))
        draw_stat("RANGE", roster.rate_range(kit), left, sy + 33, ap.Color(250, 210, 90))
        var mx = left + 160
        ap.rect(mx, sy, 7, 7, look.accent)
        label(kit.bar_name, mx + 12, sy, 8, look.accent)
        label(kit.bar_note, mx, sy + 11, 8, ap.Color(150, 145, 175))
        ap.rect(mx, sy + 26, 7, 7, ap.Color(230, 50, 60))
        label("SUPER", mx + 12, sy + 26, 8, ap.Color(255, 90, 90))
        var g_line = "G: only works inside their super" if kit.maximum.jammer else "G: the super. G in it: the move"
        label(g_line, mx, sy + 37, 8, ap.Color(150, 145, 175))
        # The moves: the chain, four skills with their cooldowns, the super.
        var my = sy + 52
        var grey = ap.Color(150, 145, 175)
        var chain = ""
        for n, a in kit.basics do
            chain = a.name if n == 0 else "{chain} > {a.name}"
        end
        label("R", left, my, 8, look.accent)
        label(chain, left + 14, my, 8, ap.WHITE)
        for n, a in kit.skills do
            var y = my + 11 * double(n + 1)
            label("{n + 1}", left, y, 8, look.accent)
            label(a.name, left + 14, y, 8, ap.WHITE)
            var wait = "{a.cooldown // 60}s" if a.cooldown >= 60 else "-"
            label(wait, left + 106, y, 8, look.accent)
            label(a.note, left + 130, y, 8, grey)
        end
        label("G", left, my + 55, 8, ap.Color(255, 90, 90))
        label(kit.maximum.name, left + 14, my + 55, 8, MAX_GOLD)
        label(kit.maximum.note, left + 130, my + 55, 8, grey)
        label("G", left, my + 66, 8, ap.Color(255, 90, 90))
        label(kit.ultimate.name, left + 14, my + 66, 8, ap.WHITE)
        label(kit.ultimate.note, left + 130, my + 66, 8, grey)
    end
    label("A / D / W / S  MOVE     R / ENTER  PICK     ESC  BACK", 16, 346, 8, ap.Color(110, 106, 130))
    var hard = [ap.Color(120, 220, 110), ap.Color(250, 210, 90), ap.Color(255, 110, 90)]
    label_right("TAB  CPU DIFFICULTY: {LEVEL_NAMES[level]}", 624, 346, 8, hard[level])
    label_right("M  MODE: {MODE_NAMES[mode]}", 624, 336, 8, ap.Color(255, 206, 70) if mode != MODE_CLASSIC else ap.Color(170, 165, 190))
    label_right("I  ITEMS: {ITEM_MODE_NAMES[items_mode]}", 624, 326, 8,
        ap.Color(110, 106, 130) if items_mode == ITEMS_OFF else ap.Color(150, 225, 120))
end

function draw_result_hud()
    var champion = fighters[winner]
    var fade = math.min(double(screen_ticks) / 30, 1.0)
    ap.gradient(0, 0, VW, 110, ap.BLACK.fade(0.8 * fade), ap.BLACK.fade(0))
    ap.gradient(0, 250, VW, 110, ap.BLACK.fade(0), ap.BLACK.fade(0.85 * fade))
    label_centered("{champion.kit.name} WINS", 320, 28, 32, champion.kit.look.accent.fade(fade))
    label_centered("YOU TAKE THE MATCH" if winner == 0 else "THE PURGATORY KEEPS YOU", 320, 68, 8,
        ap.Color(190, 186, 210).fade(fade))
    label_centered("{fighters[0].wins} - {fighters[1].wins}", 320, 284, 16, ap.WHITE.fade(fade))
    label_centered("ENTER  REMATCH        ESC  CHARACTER SELECT", 320, 320, 8, ap.Color(170, 165, 190).fade(fade))
end

# --- A frame -------------------------------------------------------------------------------------

# How much color the 3D scene is drained of (PHANTOM's wood).
function mono_now() returns double
    if screen == SCREEN_SELECT do
        return 1.0 if select_world >= 0 and cast[select_world].maximum.mono else 0.0
    end
    if screen == SCREEN_TITLE or max_owner < 0 do
        return 0
    end
    if merge_owner >= 0 do
        return 0.5 if max_def.mono or merge_def.mono else 0.0
    end
    return 1.0 if max_def.mono else 0.0
end

function render()
    var sw = scene_w()
    var sh = scene_h()
    ap.draw_to(scene)
    ap.clear(sky_now)
    set_lights()
    ap.listen_from(camera)
    if screen == SCREEN_TITLE do
        ap.scene_3d(camera, draw_title_scene, 16)
    else if screen == SCREEN_SELECT do
        ap.scene_3d(camera, draw_select_scene, 8)
    else do
        ap.scene_3d(camera, draw_fight_scene, 16)
        # Where the floating numbers sit on the HUD, while the camera is still set.
        for f in floaters do
            var at = ap.project(f.position)
            f.screen = ap.Vec2(at.x * double(VIEW_W) / sw, at.y * double(VIEW_H) / sh)
        end
        for m in minions do
            var at = ap.project(m.body.top() + ap.Vec3(0, 0.35, 0))
            m.screen = ap.Vec2(at.x * double(VIEW_W) / sw, at.y * double(VIEW_H) / sh)
        end
    end

    ap.draw_to(post)
    ap.clear(ap.BLACK)
    filter.set_vec2("u_grid", ap.Vec2(sw, sh))
    filter.set("u_levels", 28)
    filter.set("u_mono", mono_now())
    ap.use_shader(filter)
    ap.sprite_part(scene.texture, ap.Rect(0, 0, sw, sh), ap.Rect(0, 0, double(VIEW_W), double(VIEW_H)))
    ap.no_shader()
    if screen == SCREEN_TITLE do
        draw_title_hud()
    else if screen == SCREEN_SELECT do
        draw_select_hud()
    else if screen == SCREEN_FIGHT do
        draw_fight_hud()
    else do
        draw_result_hud()
    end

    ap.draw_to_window()
    ap.clear(ap.BLACK)
    ap.sprite(post.texture, 0, 0)
end

while ap.frame() do
    while ap.tick(60) do
        update()
    end
    render()
end
ap.close()
