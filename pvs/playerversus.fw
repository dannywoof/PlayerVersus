# The tracks PURGATORY may ask for that are really there (looked up again after an install).
function refresh_purgatory_tracks()
    string[] names = ["purgatory_menu", "purgatory_threshold", "purgatory_dojo", "purgatory_finale", "purgatory_satan",
        "purgatory_meadow", "title", "shop", "finale_1", "finale_2"]
    for k in 1..<5 do
        names.push("purgatory_explore_{k}")
        names.push("purgatory_combat_{k}")
        names.push("purgatory_boss_{k}")
    end
    for k in 1..<10 do
        names.push("fight_{k}")
    end
    for c in cast do
        names.push(music.super_track(c.name))
    end
    string[] there = []
    for n in names do
        if music.exists(n) do
            there.push(n)
        end
    end
    purgatory.known_tracks = there
end
refresh_purgatory_tracks()
