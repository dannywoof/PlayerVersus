# How much slower than 60 ticks a second fights run (see FIGHT_PACE), and the tick rate that gives.
function fight_pace() returns double
    return saved.pace if saved.pace > 0 else FIGHT_PACE
end
function fight_rate() returns int
    return int(60 * time_scale / fight_pace() + 0.5)
end

# The freeze when a blow lands, `ticks` long at the original pace: it lasts as long in real time
# whatever the game speed, since a longer freeze reads as lag rather than weight.
function hitstop(int ticks)
    ap.hitstop(math.max(int(double(ticks) / fight_pace() + 0.5), 1))
end
